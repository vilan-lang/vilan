// The browser entry (`[entry.client]`, target `browser`). It builds a view and
// mounts it into the `<div id="app">` of `src/app.html`, which the server
// serves. Nothing here reaches a node-only module, so it compiles for the
// browser.
//
// `count.map(..)` derives a reactive source and `bind_text` keeps the text in
// step with it; the i-string renders the number by host coercion.
//
// The `const` style chain is evaluated at build time into dist/client.css,
// which src/server.vl serves and src/app.html links.
//
// `Signal`, `view` and `View` are ambient: `prelude = "std::web"` in
// vilan.toml puts them in scope with no import, along with the MODULES `style`
// and `ui` — which is why the chain below writes `style::Display::Flex` and
// the mount writes `ui::mount_root`. The prelude carries the module, not its
// members, so you qualify; import a member explicitly wherever you would
// rather write it bare, since an explicit import always beats the prelude.
// `Style` is imported for exactly that reason: a TYPE is written bare.

import std::style::Style;
import pkg::shared::greeting;

fun card_style(): Style {
	style::style()
		.display(style::Display::Flex)
		.flex_direction(style::FlexDirection::Column)
		.gap(style::space(3))
		.padding(style::space(4))
		.background(style::Color::gray(100))
		.radius(style::space(2))
}

fun main() {
	let card = const card_style();
	let _root = ui::mount_root("app", || {
		let count = Signal::new(0);
		view("main")
			.styled(card)
			.child(view("h1").text(greeting()))
			.child(view("p").bind_text(count.map(|n| i"clicked {n} times")))
			.child(view("button").text("click me").on("click", || count.set_with(|n| n + 1)))
	});
}
