// The entry. `fun main` runs on start — there is no `main()` call at the
// bottom of the file. `print` needs no import — it is one of the seven names
// `prelude = "std::prelude"` puts in scope (vilan.toml); everything outside
// the prelude is imported explicitly.

import pkg::greeting::greeting;

fun main() {
	print(greeting("world"));
}
