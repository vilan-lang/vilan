// The entry. A component is an ordinary function returning a `View`, so an app
// is just composition: build the view and mount it into a node from
// `index.html`.
//
// `ui` is a module the `std::web` prelude puts in scope (vilan.toml), so
// `ui::mount_root` needs no import. The prelude carries the module and not the
// member on purpose: `mount_root` exists only on the browser layer, and
// qualifying it keeps a node build's error at the call rather than at an
// import you never wrote.

import pkg::counter::counter;

fun main() {
	// The returned root owns everything the component binds; holding it (or, as
	// here, letting it live for the page's lifetime) keeps the UI alive.
	let _root = ui::mount_root("app", || counter());
}
