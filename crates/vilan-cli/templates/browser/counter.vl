// A module beside the entry, reached as `pkg::counter`.
//
// State is a `Signal`. `count.map(..)` derives a NEW reactive value whose
// dependency is structural — known when it is built, not discovered by running
// it — and `bind_text` takes that derived source, so the text updates itself.
// (The i-string renders the number directly, by host coercion.)

import std::reactive::Signal;
import std::ui::{ View, view };

fun counter(): View {
	let count = Signal::new(0);

	view("section").child(view("h1").text("hello from Vilan")).child(view("p").bind_text(count.map(|n| i"clicked {n} times"))).child(view("button").text("click me").on("click", || count.set_with(|n| n + 1)))
}
