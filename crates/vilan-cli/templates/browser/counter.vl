// A module beside the entry, reached as `pkg::counter`.
//
// State is a signal. `Signal::new(0)` hands back a `SignalCell` — `Signal` is
// the writable TRAIT (`set`/`set_with`), `SignalCell` the canonical cell that
// implements it, and a component that wants any signal bounds on the trait.
// `count.map(..)` derives a NEW reactive value whose
// dependency is structural — known when it is built, not discovered by running
// it — and `bind_text` takes that derived source, so the text updates itself.
// (The i-string renders the number directly, by host coercion.)
//
// Styling is `std::style`: a `Style` is built inside `const`, so the compiler
// evaluates the chain at build time and writes real CSS into `app.css` beside
// the bundle. `.styled(..)` only puts the generated class names on the element
// — `index.html` links the sidecar.
//
// `Signal`, `SignalCell`, `view` and `View` are ambient: `prelude = "std::web"` in
// vilan.toml puts them in scope with no import, along with the MODULES `style`
// and `ui` — which is why the chain below writes `style::Display::Flex` and
// imports nothing for it. The prelude carries the module, not its members, so
// you qualify; import a member explicitly wherever you would rather write it
// bare, since an explicit import always beats the prelude. `Style` is imported
// for exactly that reason: a TYPE is written bare, not qualified.

import std::style::Style;

fun card_style(): Style {
	style::style()
		.display(style::Display::Flex)
		.flex_direction(style::FlexDirection::Column)
		.gap(style::space(3))
		.padding(style::space(4))
		.background(style::Color::gray(100))
		.radius(style::space(2))
}

fun counter(): View {
	let count = Signal::new(0);
	let card = const card_style();

	view("section")
		.styled(card)
		.child(view("h1").text("hello from Vilan"))
		.child(view("p").bind_text(count.map(|n| i"clicked {n} times")))
		.child(view("button").text("click me").on("click", || count.set_with(|n| n + 1)))
}
