// A module beside the entry, reached as `pkg::counter`.
//
// The view is written as markup: `<section …>…</section>` is element syntax,
// which lowers to the `view("section")` method chain it stands for. A quoted
// string is a text child, `{expr}` is a hole that holds any child value, a
// dotted link in the head (`.styled(card)`) is a chain call on the element, and
// `on:click(..)` is its event.
//
// State is a signal. `Signal::new(0)` hands back a `SignalCell` — `Signal` is
// the writable TRAIT (`set`/`set_with`), `SignalCell` the canonical cell that
// implements it, and a component that wants any signal bounds on the trait.
// `count.derive(..)` derives a NEW reactive value — a pipe whose dependency is
// structural, known when it is built, not discovered by running it — and the
// hole holding it keeps the text in step. (The i-string renders the number
// directly, by host coercion; a hole takes text, not a number.)
//
// Styling is `std::web::style`: a `Style` is built inside `const`, so the compiler
// evaluates the chain at build time and writes real CSS into `app.css` beside
// the bundle. `.styled(..)` only puts the generated class names on the element
// — `index.html` links the sidecar.
//
// `Signal`, `SignalCell`, `view` and `View` are ambient: `prelude = "std::web::prelude"` in
// vilan.toml puts them in scope with no import, along with the MODULES `style`
// and `ui` — which is why the style chain below writes `style::Display::Flex` and
// imports nothing for it. The prelude carries the module, not its members, so
// you qualify, in type position (`style::Style`) exactly as in value position;
// import a member explicitly wherever you would rather write it bare, since an
// explicit import always beats the prelude.

export *;

fun card_style(): style::Style {
	style::style()
		.display(style::Display::Flex)
		.flex_direction(style::FlexDirection::Column)
		.gap(style::space(3))
		.padding(style::space(4))
		.background(style::Color::gray(100))
		.radius(style::space(2))
}

fun counter(): View {
	let count = Signal::new(0);
	let card = const card_style();

	<section .styled(card)>
		<h1>"hello from Vilan"</h1>
		<p>{count.derive(|n| i"clicked {n} times")}</p>
		<button on:click(|| count.set_with(|n| n + 1))>"click me"</button>
	</section>
}
