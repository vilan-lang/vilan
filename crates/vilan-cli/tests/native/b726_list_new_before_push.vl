// B726: `List<T>::new()` read before its first push — `merged.pop()` on an
// empty list. The emitted `Vec::new()` left the element type to a push that
// had not been seen yet (rustc E0282); the `let` is now annotated, as one
// initialized with `[]` always was - spelled by its path or by a written
// annotation.
import std::io::print;

fun merge_ranges(ranges: List<(usize, usize)>): List<(usize, usize)> {
	mut merged = List<(usize, usize)>::new();
	for range in ranges {
		match merged.pop() {
			Some(let last) => {
				if range.0 <= last.1 {
					merged.push((last.0, last.1.max(range.1)));
				} else {
					merged.push(last);
					merged.push(range);
				}
			},
			None => merged.push(range),
		}
	}
	merged
}

fun main() {
	print(merge_ranges([(0usize, 2usize), (1usize, 4usize), (6usize, 7usize)]).len());
	let empty: List<str> = List::new();
	print(empty.len());
	mut names: List<str> = List::new();
	print(names.pop().is_none());
	names.push("x");
	print(names.len());
}
