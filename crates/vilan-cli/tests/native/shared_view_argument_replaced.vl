// F129's residue: a later argument that REPLACES the copied place (assigns
// the field, or the captured binding, whole) rather than writing it in place.
// The JS argument is the object the place held when it was evaluated, so the
// replacement is not seen there; the native copy, taken last, sees it.
import std::io::print;
import std::shared::Shared;

struct Bag {
	items: List<i32>,
}

struct Words {
	items: List<str>,
}

impl Words {
	fun measured(&self, extra: i32): usize {
		self.items.len() + extra.as_usize()
	}
}

fun replace(cell: Shared<Bag>): i32 {
	cell.write().items = [7, 7, 7];
	0
}

fun sized(items: List<i32>, value: i32): usize {
	items.len() + value.as_usize()
}

fun main() {
	let cell = Shared::new(Bag { items = [] });
	print(sized(cell.read().items, replace(cell)));
	mut words = Words { items = ["a"] };
	let swap = || {
		words = Words { items = ["x", "y", "z"] };
		0
	};
	print(words.measured(swap()));
}
