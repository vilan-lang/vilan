// F135 (R-a, door (1)): a later argument that REPLACES the read's place whole
// (assigns the field) is not seen by the callee on either backend: spec §6.7's
// `read()` copies where it is evaluated, which is the object the place held
// then on JS and the native copy taken where the argument stands.
import std::io::print;
import std::shared::Shared;

struct Bag {
	items: List<i32>,
}

fun replace(cell: Shared<Bag>): i32 {
	cell.write().items = [7, 7, 7];
	0
}

fun sized(items: List<i32>, value: i32): usize {
	items.len() + value.as_usize()
}

fun main() {
	let cell = Shared::new(Bag { items = [] });
	print(sized(cell.read().items, replace(cell)));
}
