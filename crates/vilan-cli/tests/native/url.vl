// M181: `std::url`'s percent-encoding pair prints the same bytes on both
// backends — `encodeURIComponent` and the total decoder on node, the
// hand-written `vilan_rt::url` natively. Each line is one input, its encoding,
// and its decoding, bracketed so an empty answer shows.
import std::url::{ percent_decode, percent_encode };

fun main() {
	let inputs = [
		"",
		"plain-ASCII_text.0123",
		"two words",
		"unreserved !~*'()",
		"reserved ;/?:@&=+$,#[]%\"<>\\^`{|}",
		"café",
		"日本語",
		"emoji 😀",
		"hello%20world",
		"caf%C3%A9",
		"caf%c3%a9",
		"%F0%9F%98%80",
		"100%",
		"%",
		"%2",
		"%G1",
		"%zz%20",
		"%FF",
		"%41%FF",
		"%41%FF then %41",
		"%C3",
		"%C3x%A9",
		"%C0%80",
		"%ED%A0%80",
		"%F4%90%80%80",
		"a%2Fb%3Fc%3Dd",
	];

	for input in inputs {
		print(i"[{input}] encode=[{percent_encode(input)}] decode=[{percent_decode(input)}]");
	}

	// Round trips: decoding what was encoded answers the text.
	mut kept = 0;
	for input in inputs {
		if percent_decode(percent_encode(input)) == input {
			kept += 1;
		}
	}
	print(i"round trips {kept} of {inputs.len()}");
}
