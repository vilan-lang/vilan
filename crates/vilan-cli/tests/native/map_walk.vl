// A138 S1: a `HashMapCell` under a seeded random walk of every write it has —
// insert, overwrite, remove (held and absent), update, get_or_insert, edit,
// reconcile_to, set, clear — checked after EVERY step against a plain
// `HashMap` written the same way: the cell's map, the map a consumer rebuilds
// by replaying the ops it drained, and what each watched key's handle says
// and how often it woke.
import std::hash_map::HashMap;
import std::option::Option::{ self, None, Some };
import std::reactive::{ DeltaSource, HashMapCell, MapOp, Source, Subscription };
import std::shared::Shared;

mut seed = 4242;

fun next(bound: i32): i32 {
	seed = (seed * 75 + 74) % 65537;
	seed % bound
}

fun replay(mirror: &mut HashMap<i32, i32>, ops: List<MapOp<i32, i32>>) {
	for op in ops {
		match op {
			MapOp::Put(let key, let _was, let now) => mirror.insert(key, now),
			MapOp::Delete(let key, let _gone) => mirror.remove(key),
			MapOp::Reset(let map) => {
				mirror = map;
			},
		}
	}
}

fun main() {
	let cell: HashMapCell<i32, i32> = HashMapCell::new();
	mut oracle: HashMap<i32, i32> = HashMap::new();
	mut mirror: HashMap<i32, i32> = HashMap::new();
	let cursor = cell.cursor();
	// Keys 0..4 are watched; each records how many times it woke and what it read.
	let wakes: Shared<List<i32>> = Shared::new([0, 0, 0, 0]);
	let seen: Shared<List<Option<i32>>> = Shared::new([None, None, None, None]);
	mut handles: List<Subscription> = [];
	mut watched = 0;
	for watched < 4 {
		let index = watched.as_usize();
		handles.push(cell.at(watched).on_change(|value| {
			wakes.write()[index] = wakes.read()[index] + 1;
			seen.write()[index] = value;
		}));
		watched += 1;
	}
	mut failures = 0;
	mut step = 0;
	for step < 500 {
		let choice = next(10);
		let key = next(8);
		let value = next(100);
		let before = oracle;
		let woke_before = wakes.read();
		// The watched keys this step names whatever their values do: an insert
		// wakes its key even when the value is the same (a cell never compares).
		mut named: List<i32> = [];
		mut everything = false;
		if choice <= 2 {
			cell.insert(key, value);
			oracle.insert(key, value);
			named.push(key);
		} else if choice == 3 {
			cell.remove(key);
			oracle.remove(key);
		} else if choice == 4 {
			if oracle.contains_key(key) {
				let was = oracle.get(key).unwrap_or(0);
				oracle.insert(key, was + 1);
			}
			cell.update(key, |&mut held| held += 1);
		} else if choice == 5 {
			if !oracle.contains_key(key) {
				oracle.insert(key, value);
			}
			let _answer = cell.get_or_insert(key, || value);
		} else if choice == 6 {
			let other = next(8);
			cell.edit(|&mut map| {
				map.insert(key, value);
				map.remove(other);
				map.insert(other + 1, value + 1);
			});
			oracle.insert(key, value);
			if oracle.contains_key(other) {
				named.push(other);
			}
			oracle.remove(other);
			oracle.insert(other + 1, value + 1);
			named.push(key);
			named.push(other + 1);
		} else if choice == 7 {
			mut target: HashMap<i32, i32> = HashMap::new();
			for entry in oracle.entries() {
				if entry.0 != key {
					target.insert(entry.0, entry.1);
				}
			}
			target.insert(next(8), value);
			cell.reconcile_to(target);
			// The order rule: a held key keeps its place, an arriving one goes to
			// the end in the target's order.
			for held in before.keys() {
				if !target.contains_key(held) {
					oracle.remove(held);
				}
			}
			for entry in target.entries() {
				oracle.insert(entry.0, entry.1);
			}
		} else if choice == 8 && next(4) == 0 {
			let fresh = [(1, 10), (5, 50), (2, 20)].to_map();
			cell.set(fresh);
			oracle = fresh;
			everything = true;
		} else if choice == 9 && next(4) == 0 {
			everything = oracle.len() > 0;
			cell.clear();
			oracle = HashMap::new();
		}
		replay(&mut mirror, cell.since(cursor));
		let whole: HashMap<i32, i32> = Source::get(cell);
		if whole != oracle {
			failures += 1;
		}
		if mirror != oracle {
			failures += 1;
		}
		if whole.keys() != oracle.keys() {
			failures += 1;
		}
		if cell.len() != oracle.len() {
			failures += 1;
		}
		mut index = 0;
		for index < 4 {
			let watched_key = index.as_i32();
			if cell.at(watched_key).get() != oracle.get(watched_key) {
				failures += 1;
			}
			// Exactly one wake for a key the step named or changed, or for every
			// key under a Reset; none for any other.
			let changed = before.get(watched_key) != oracle.get(watched_key);
			let expected = if everything || changed || named.contains(watched_key) { 1 } else { 0 };
			if wakes.read()[index] - woke_before[index] != expected {
				failures += 1;
			}
			index += 1;
		}
		step += 1;
	}
	// Every watched key's handle read what the map holds at its last wake.
	mut index = 0;
	for index < 4 {
		if wakes.read()[index] > 0 && seen.read()[index] != oracle.get(index.as_i32()) {
			failures += 1;
		}
		index += 1;
	}
	print(i"failures {failures}");
	print(i"watched {cell.watched()}");
	for handle in handles {
		handle.dispose();
	}
	print(i"watched {cell.watched()}");
	print(wakes.read());
}
