// B705: a mutating call whose other arguments READ its receiver —
// `next.insert(next.position(..).unwrap_or(next.len()), x)`. The lowering
// takes `&mut receiver` first and Rust's two-phase borrow covers only a
// method's autoref, so the reads met the live borrow (E0502). The insert,
// a map insert keyed off its own length, a removal at an index the list
// computes, a struct field's list, and a user function handed a written
// `&mut xs` beside `xs.len()` (F35 hoisted only a loaned receiver).
import std::{ hash_map::HashMap, io::print };

struct Holder {
	items: List<i32>,
}

fun grow(xs: &mut List<i32>, n: usize) {
	xs.push(n.as_i32());
}

fun main() {
	mut next = [1, 3, 5];
	next.insert(next.position(|each| *each > 2).unwrap_or(next.len()), 2);
	next.insert(next.position(|each| *each > 9).unwrap_or(next.len()), 9);
	print(next.len());
	print(next[1]);
	print(next[4]);
	mut sizes = HashMap<str, usize>::new();
	sizes.insert("a", sizes.len());
	sizes.insert("b", sizes.len());
	print(sizes.get("b").unwrap_or(99));
	mut holder = Holder { items = [4, 5, 6] };
	holder.items.insert(holder.items.len() - 1, holder.items[0]);
	print(holder.items.len());
	print(holder.items[2]);
	next.remove(next.len() - 1);
	print(next.len());
	mut xs = [1];
	grow(&mut xs, xs.len());
	print(xs[1]);
}
