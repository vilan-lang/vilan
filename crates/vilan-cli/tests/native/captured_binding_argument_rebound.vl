// F138 (R-a, door (1): JS follows spec §6.9): an argument rooted at a
// captured `mut` binding — a `&self` receiver, a `&` view, a by-value place
// JS hands on by reference, a `&mut` receiver, an intrinsic's receiver — is
// read after the call's later arguments when they run code, on both
// backends. A later argument that RE-BINDS the binding whole (or one of the
// fields on the argument's path) is therefore seen by the callee: the JS
// argument had been the object the binding held when it was evaluated, and
// the native view had been taken last. The earlier arguments still run first,
// and the controls — a scalar by value, an `&Option` beside a closure that
// writes it (a copy taken in order) — read where they stand.
//
// F143: a MODULE-LEVEL `mut` binding is a place every function shares, so any
// call a later argument makes can reach it — it follows the same order on
// both backends (by value, `&`, a `&self` and a `&mut` receiver, a reading
// intrinsic's receiver; a re-bind and an in-place write), natively a copy out
// of its `thread_local!` cell taken after the later arguments. A `&` of it
// waits whatever its type (`&Option`); a scalar by value is the control.
import std::hash_set::HashSet;
import std::io::print;

trait Sized {
	fun measured(&self, extra: i32): usize;
}

struct Words {
	items: List<str>,
}

impl Words with Sized {
	fun measured(&self, extra: i32): usize {
		self.items.len() + extra.as_usize()
	}
}

struct Log {
	items: List<i32>,
	set: HashSet<i32>,
	name: str,
	count: i32,
	maybe: Option<i32>,
}

impl Log {
	fun bump(&mut self, by: i32) {
		self.count += by;
	}
}

fun has(items: List<i32>, value: i32): bool {
	items.contains(value)
}

fun lent(items: &List<i32>, value: i32): bool {
	items.contains(value)
}

fun size(words: Words, extra: i32): usize {
	words.items.len() + extra.as_usize()
}

fun generic_measure<T: Sized>(value: &T, extra: i32): usize {
	value.measured(extra)
}

fun counted(count: i32, value: i32): i32 {
	count + value
}

fun maybe_of(maybe: &Option<i32>, value: i32): Option<i32> {
	*maybe
}

fun note(text: str): i32 {
	print(text);
	0
}

fun traced(first: i32, items: List<i32>, value: i32): usize {
	items.len() + first.as_usize()
}

fun fresh(): Log {
	Log { items = [], set = HashSet::new(), name = "old", count = 0, maybe = None }
}

fun count_of(count: &i32, value: i32): i32 {
	*count
}

mut module_items: List<i32> = [];
mut module_words = Words { items = ["a"] };
mut module_log = fresh();

fun grow_items(): i32 {
	module_items.push(9);
	9
}

fun reset_items(): i32 {
	module_items = [9];
	9
}

fun swap_words(): i32 {
	module_words = Words { items = ["x", "y", "z"] };
	0
}

fun rebind_log(): i32 {
	module_log = Log {
		items = [9],
		set = HashSet::new(),
		name = "new9",
		count = 1,
		maybe = Some(1),
	};
	9
}

fun refill(): List<i32> {
	module_items = [9];
	[1]
}

fun both(items: &mut List<i32>, more: &List<i32>) {
	items.push(more.len().as_i32());
}

fun write_log(): i32 {
	module_log.items.push(9);
	module_log.count = 5;
	module_log.maybe = Some(3);
	9
}

fun main() {
	mut words = Words { items = ["a"] };
	let swap = || {
		words = Words { items = ["x", "y", "z"] };
		0
	};
	print(words.measured(swap()));
	words = Words { items = ["a"] };
	print(size(words, swap()));
	words = Words { items = ["a"] };
	print(size(words, {
		words = Words { items = ["x", "y"] };
		0
	}));
	words = Words { items = ["a"] };
	print(generic_measure(&words, swap()));
	mut object: dyn Sized = Words { items = ["a"] };
	let replace = || {
		object = Words { items = ["x", "y", "z"] };
		0
	};
	print(object.measured(replace()));
	mut log = fresh();
	let rep = || {
		log = Log { items = [9], set = HashSet::new(), name = "new9", count = 1, maybe = Some(1) };
		log.set.insert(9);
		9
	};
	print(has(log.items, rep()));
	log = fresh();
	print(lent(&log.items, rep()));
	log = fresh();
	print(log.items.contains(rep()));
	log = fresh();
	print(log.set.contains(rep()));
	log = fresh();
	print(log.name.contains({
		rep();
		"9"
	}));
	log = fresh();
	print(log.items.get(rep().as_usize() - 9));
	log = fresh();
	print(traced(note("first"), log.items, {
		note("second");
		rep()
	}));
	log = fresh();
	log.items.push({
		log = fresh();
		9
	});
	print(log.items.len());
	log = fresh();
	log.bump({
		log = fresh();
		9
	});
	print(log.count);
	log = fresh();
	print(counted(log.count, rep()));
	log = fresh();
	print(maybe_of(&log.maybe, rep()));
	log = fresh();
	print(maybe_of(&log.maybe, {
		log.maybe = Some(2);
		0
	}));
	print(has(module_items, grow_items()));
	module_items = [];
	print(has(module_items, reset_items()));
	module_items = [];
	print(lent(&module_items, grow_items()));
	module_items = [];
	print(lent(&module_items, reset_items()));
	module_items = [];
	module_items.push(reset_items());
	print(module_items.len());
	print(module_words.measured(swap_words()));
	module_words = Words { items = ["a"] };
	print(generic_measure(&module_words, swap_words()));
	print(has(module_log.items, rebind_log()));
	module_log = fresh();
	print(has(module_log.items, write_log()));
	module_log = fresh();
	print(module_log.name.contains({
		rebind_log();
		"9"
	}));
	module_log = fresh();
	module_log.bump({
		module_log = fresh();
		9
	});
	print(module_log.count);
	module_log = fresh();
	print(count_of(&module_log.count, write_log()));
	module_log = fresh();
	print(maybe_of(&module_log.maybe, write_log()));
	module_log = fresh();
	print(counted(module_log.count, write_log()));
	module_items = [];
	both(&mut module_items, &refill());
	print(module_items.len());
}
