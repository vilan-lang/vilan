// B639's boundary: a later argument writing a DISJOINT place of the lent
// place's root, another binding, or a captured root (F138's) compiles and
// answers the same on both backends.
import std::io::print;

struct Log {
	items: List<i32>,
	count: i32,
}

fun fresh(): Log {
	Log { items = [], count = 0 }
}

fun main() {
	mut log = fresh();
	log.items.push({
		log.count = 2;
		9
	});
	print(log.items.len());
	print(log.count);
	mut other = fresh();
	log.items.push({
		other.items.push(1);
		3
	});
	print(log.items.len());
	mut captured = fresh();
	let peek = || captured.items.len();
	captured.items.push({
		captured.items.push(1);
		9
	});
	print(captured.items.len());
	print(peek());
}
