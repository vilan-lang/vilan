// B626: a module-level scalar read ONLY through a view - a `const let`, a
// `let`, a `mut` written through `&mut`, a read inside a closure - is declared
// on JS (it was shaken out: `ReferenceError`) and answers as natively.
import std::io::print;

const let LIMIT = 40;
let LOOSE = 50;
mut COUNTER = 7;
let LATER = 60;

fun read(value: &i32): i32 {
	*value + 1
}

fun bump(value: &mut i32) {
	value += 1;
}

fun main() {
	print(read(&LIMIT));
	print(read(&LOOSE));
	bump(&mut COUNTER);
	print(read(&COUNTER));
	let later = || read(&LATER);
	print(later());
}
