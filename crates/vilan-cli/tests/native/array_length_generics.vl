// array-lengths.md S3: `<const N>` on a function and a struct, bound from an
// argument, a directed literal, the expected type and an explicit number.
import std::io::print;

fun total<const N>(values: [i32; N]): i32 {
	mut sum = 0;
	for value in values {
		sum = sum + value;
	}
	sum
}

fun zeros<const N>(): [i32; N] {
	[0; N]
}

fun count<T, const N>(values: [T; N]): usize {
	N
}

enum Slots<const N> {
	Full([i32; N]),
	Empty,
}

fun filled<const N>(slots: Slots<N>): usize {
	match slots {
		Slots::Full(let values) => values.len(),
		Slots::Empty => 0,
	}
}

struct Ring<T, const N> {
	slots: [T; N],
	at: usize,
}

impl Ring<type T, const N> {
	fun capacity(self): usize {
		N
	}

	fun current(self): T {
		self.slots[self.at]
	}
}

fun main() {
	let row: [i32; 3] = [1, 2, 3];
	print(total(row));
	print(total([10, 20]));
	let four: [i32; 4] = zeros();
	print(four.len());
	print(zeros<2>().len());
	let five: [str; 5] = ["a", "b", "c", "d", "e"];
	print(count(five));
	print(count([true, false]));
	let slots: [i32; 3] = [7, 8, 9];
	let ring = Ring { slots, at = 1 };
	let literal_ring = Ring { slots = ["p", "q", "r", "s"], at = 3 };
	print(literal_ring.capacity());
	print(literal_ring.current());
	print(ring.capacity());
	print(ring.current());
	let words: Ring<str, 2> = Ring { slots = ["x", "y"], at = 0 };
	print(words.capacity());
	print(words.current());
	let full: Slots<3> = Slots::Full([4, 5, 6]);
	print(filled(full));
	let empty: Slots<2> = Slots::Empty;
	print(filled(empty));
}

main();
