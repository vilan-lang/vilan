// M190: `resized` refuses a RESULT over 50,000,000 pixels with an `Err` naming
// both sizes, as `decode` refuses an upload over the limit, on both backends —
// while a `Contain` into a box far past the limit whose result is small is fine.
import std::bytes::Bytes;
import std::image::{ Fit, Image };
import std::io::panic;

fun main() {
	let picture = match Image::from_rgba(4, 3, Bytes::alloc(48)) {
		Ok(let picture) => picture,
		Err(let reason) => panic(reason),
	};
	match picture.resized(100000, 1, Fit::Contain) {
		Ok(let contained) => print(i"{contained.width()} x {contained.height()}"),
		Err(let reason) => print(reason),
	}
	match picture.resized(100000, 100000, Fit::Fill) {
		Ok(let huge) => print(i"unreachable {huge.width()}"),
		Err(let reason) => print(reason),
	}
}
