// F163: `Request::peer_address` — the native differential binds this server to
// each of three hosts (the test rewrites the `host` line) and compares the peer
// address the handler answers with node's.

import std::http::{ Request, Response, Server };
import std::io::print;

fun main() {
	Server::builder()
		.port(0)
		.host("127.0.0.1")
		.on_request(|request| answer(request))
		.on_start(|server| print(i"vilan-test-port={server.port()}"))
		.build()
		.start();
}

fun answer(request: Request): Response {
	let peer = match request.peer_address() {
		Some(let address) => i"peer={address}",
		None => "no peer",
	};
	Response::builder().body(peer).build()
}
