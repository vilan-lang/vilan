// B538: a tuple assignment target holding an element (`(list[0], x)`), a
// nested tuple (`((x, y), z)`), a tuple-typed binding (`(p, z)`) or a
// tuple-typed position (`(t.0, z)`) assigns each place. JS emitted a
// destructuring pattern with an `__at` read or a `...spread` in it, which
// threw at load; natively a tuple-typed binding was read as a value
// (`(p).clone()`), which is no place (rustc E0070). A tuple of plain bindings
// keeps the destructuring swap it always had.
import std::io::print;

struct Holder {
	a: i32,
}

fun main() {
	mut list = [10, 20];
	mut x = 1;
	mut y = 2;
	mut z = 3;
	(list[0], x) = (1, 2);
	print(i"element: {list[0]} {x}");
	((x, y), z) = ((4, 5), 6);
	print(i"nested: {x} {y} {z}");
	mut p = (0, 0);
	(p, z) = ((7, 8), 9);
	print(i"tuple-typed binding: {p.0} {p.1} {z}");
	mut t = ((0, 0), 0);
	(t.0, z) = ((11, 12), 13);
	print(i"tuple-typed position: {t.0.0} {t.0.1} {z}");
	mut holder = Holder { a = 0 };
	(holder.a, list[1]) = (21, 22);
	print(i"field and element: {holder.a} {list[1]}");
	(x, y) = (y, x);
	print(i"swap: {x} {y}");
}
