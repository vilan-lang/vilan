/target
.vscode
.claude
*.out

# Build artifacts emitted by the examples. Examples check in NO emitted output:
# multi-entry projects write `dist/`, single-entry ones write the bundle (and its
# stylesheet, and — for a browser leg — its build manifest) beside the source.
vilan/examples/**/dist/
vilan/examples/**/*.js
vilan/examples/**/*.mjs
vilan/examples/**/*.css
vilan/examples/**/*.chunks.json

# The benchmark bundle (`vilan run vilan/benchmarks` writes it beside the source).
vilan/benchmarks/src/main.mjs

# Every package's BUILD directory, wherever one sits beside checked-in sources.
# `dist/` holds emitted artifacts, the build hooks' stamp file, and — under
# `dist/.cache/` since N63 — every on-disk cache the compiler keeps, so any
# `vilan check` run inside the tree creates one even though it emits nothing.
# ONE line rather than the two compile-perf-29 added for `vilan/benchmarks/` and
# `vilan/test/`: the next package the suite compiles in place would have wanted a
# third, and nothing named `dist` is tracked anywhere in this repository.
dist/
vilan/docs/book/

# What a corpus program's BUILD writes beside the corpus sources (N83). The
# byte gate stages into a work directory and dirties nothing, but regenerating
# a golden is `vilan build vilan/test/<program>.vl` IN PLACE (`AGENTS.md` §2),
# and `estate.vl` and `asset_bundle.vl` reach `std::asset` — so the bundled
# assets and the build's record of them land here, and `git add -A` after a
# regeneration swept all four into a commit. `corpus.rs`'s
# `every_asset_a_corpus_build_emits_beside_the_sources_is_gitignored` asks
# `git check-ignore` about each one, so a new bundled asset reds until this
# list names it. The sources these are copied FROM live in
# `vilan/test/estate-static/`, which is tracked and untouched by any of these.
/vilan/test/.vilan-bundled
/vilan/test/icons/
/vilan/test/logo.*.svg
/vilan/test/robots.txt

# The union-suite log every integration writes beside the tree (three
# tracked-by-accident incidents in one day; the hygiene gate caught two).
suite.log
