// The monadic join (backlog A4) — `switch(|inner| inner)` over a source of
// sources: follow whichever inner signal the outer currently holds. A DYNAMIC
// dependency: switching the outer detaches the replaced inner (its later sets must
// not leak through) and follows the new inner from its current value.
import std::io::print;
import std::reactive::Signal;

fun main() {
	let first = Signal::new(1);
	let second = Signal::new(10);
	let outer = Signal::new(first);
	let joined = outer.switch(|inner| inner).memo();
	print(joined.get());
	first.set(2);
	print(joined.get());
	outer.set(second);
	print(joined.get());
	first.set(99);
	print(joined.get());
	second.set(11);
	print(joined.get());

	// The sealed join is itself a source: derived work stacks on it.
	let doubled = joined.derive(|value| value * 2).memo();
	second.set(21);
	print(doubled.get());
}

main();
