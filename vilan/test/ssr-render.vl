import std::io::print;
import std::reactive::Signal;
import std::ui::{ View, render, view };

// Server-side rendering (proposal/ssr.md, A7): on `@process`, `std::ui` builds
// an HTML string tree and `render` serializes it. The component below is the
// same shape a browser client would `mount` — the layer system gives each leg
// its own `std::ui`, so the component code is unannotated and identical.

[derive(PartialEq)]
enum Page {
	Home,
	About,
}

fun app(title: Signal<str>, todos: Signal<List<str>>, page: Signal<Page>): View {
	let heading = view("h1").bind_text(title);
	let list = view("ul").bind_each(todos, |todo| todo, |todo| view("li").text(todo));
	let nav = view("nav").swap(page, |current| match current {
		Page::Home => view("a").attr("href", "/").text("Home"),
		Page::About => view("a").attr("href", "/about").text("About & friends"),
	});
	view("main").attr("id", "app").child(heading).child(list).child(nav)
}

fun main() {
	let title = Signal::new("Tasks <live>");
	let todos: Signal<List<str>> = Signal::new(["alpha", "beta & gamma"]);
	let page = Signal::new(Page::About);
	// The bindings read once — the value at render time is the value served.
	print(render(app(title, todos, page)));

	// A hostile string renders inert: escaped as text, never markup.
	print(render(view("p").text("<script>alert(\"&\")</script>")));

	// A void element renders without a closing tag; its attribute value escapes.
	print(render(view("img").attr("src", "/logo.png").attr("alt", "a & b")));

	// An svg root carries its namespace (B37) — seeded first, so a component's
	// own attributes follow it; descendants inherit and need none.
	print(render(view("svg").attr("viewBox", "0 0 24 24").child(view("path").attr("d", "M5 12h14"))));

	// Mixed content (element-syntax S1): text children — plain and
	// signal-read-once — interleave with elements as real siblings, in written
	// order, each text arm escaped. A `Signal<str>` attribute reads once too.
	let name = Signal::new("world & <you>");
	let mixed = view("p")
		.attr("data-live", Signal::new("a \"quoted\" & value"))
		.child("Take ")
		.child(view("code").text("vilan upgrade"))
		.child(" & enjoy. ")
		.child(name);
	print(render(mixed));

	// A `List<View>` fills one child position, in order.
	let pair: List<View> = [view("i").text("a"), view("b").text("b")];
	print(render(view("p").child(pair)));

	// `.text` still REPLACES children (the DOM's textContent), text nodes
	// included.
	print(render(view("p").child("gone").text("kept")));
}
main();
