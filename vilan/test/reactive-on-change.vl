// `Flow::on_change` / `Flow::effect_on_change` (backlog A43) over a root, and a
// custom `Source` (A142 R29): a source writes its read and its no-payload attach,
// `get` and `on_settle`, and every consumer arrives through `Flow`.
//
// Four claims:
//   1. `on_change` skips the first call and fires on every change after it;
//      `sub` beside it still fires immediately (they observe one signal).
//   2. `effect_on_change` is the owner-registered form: it dies with the scope.
//   3. `Source::attach_observer`'s DEFAULT serves a custom `Source` that
//      implements only `get`/`on_settle` — `sub` attaches and then makes EXACTLY
//      ONE call.
//   4. A custom source is a `Flow`, so it derives like a cell does, and the pipe
//      is sealed where it is read as well as subscribed to.
import std::io::print;
import std::reactive::{
	Disposable,
	Signal,
	SignalCell,
	Source,
	Subscriber,
	Subscription,
	comp,
	owner_scope,
};

/// A `Source` of one's own: `get` and `on_settle`, nothing else. `sub`, `effect`,
/// `effect_on_change` and `derive` all arrive through `Flow`.
struct Stored<T> {
	inner: SignalCell<T>,
}

impl Stored<type T> with Source<T> {
	fun get(self): T {
		self.inner.get()
	}

	[must_use]
	fun on_settle(self, subscriber: Subscriber): Subscription {
		self.inner.on_settle(subscriber)
	}
}

fun main() {
	let count: SignalCell<i32> = Signal::new(1);
	// The eager member fires NOW with the current value.
	let eager = count.sub(|value| print(i"sub {value}"));
	// The lazy one does not: nothing is printed until `count` changes.
	let quiet = count.on_change(|value| print(i"on_change {value}"));
	print("attached");
	count.set(2);
	eager.dispose();
	quiet.dispose();
	// Both handles are disposed: this change reaches nobody.
	count.set(3);

	// The owner-registered form, and its disposal.
	let (_built, scope) = comp(|| {
		count.effect_on_change(|value| print(i"effect_on_change {value}"));
	});
	count.set(4);
	scope.dispose();
	count.set(5);

	// The trait default over a custom `Source`: `Stored` writes only `get` and
	// `on_settle`, and `sub` is that attach PLUS one call with the current value —
	// the eager contract, built by addition. The emitted body is the whole of it:
	// no wrapper cell, no swallowed call, no branch riding every later
	// notification.
	// witness: if (immediately) { observer(
	// witness-absent: seeded
	let stored = Stored { inner = Signal::new(10) };
	let eagerly = stored.sub(|value| print(i"eager {value}"));
	stored.inner.set(11);
	eagerly.dispose();

	// And the lazy one on the same custom source.
	let watched = stored.on_change(|value| print(i"stored {value}"));
	stored.inner.set(12);
	watched.dispose();

	// A custom source is a `Flow`, so it derives off `Stored`; the pipe is read
	// AND subscribed to, so it is sealed — under an owner, which releases the
	// seal's registration on the source.
	let (labelled, sealed) = comp(|| stored.derive(|value| i"n={value}").memo());
	print(labelled.get());
	let shown = labelled.sub(|value| print(i"label {value}"));
	stored.inner.set(13);
	shown.dispose();
	sealed.dispose();
}

main();
