// `Source::on_change` / `Source::effect_on_change` (backlog A43) and the A49
// INVERSION: `on_change` is the trait's subscription REQUIREMENT and `sub` is
// the eager form derived from it — attach lazily, then make one call with the
// value the source already holds. Nothing is swallowed anywhere.
//
// Four claims:
//   1. `on_change` skips the first call and fires on every change after it;
//      `sub` beside it still fires immediately (they observe one signal).
//   2. `effect_on_change` is the owner-registered form: it dies with the scope.
//   3. The trait's DEFAULT `sub` serves a custom `Source` that implements only
//      `get`/`on_change` — it attaches and then makes EXACTLY ONE call.
//   4. `map` is a `Source` member now (reactive-traits.md Q5's widening rode
//      in on `on_change`), so a custom source derives like a cell does.
import std::io::print;
import std::reactive::{ Disposable, Signal, SignalCell, Source, Subscription, comp, owner_scope };

/// A `Source` of one's own: `get` and `on_change`, nothing else. `sub`,
/// `effect`, `effect_on_change` and `map` all arrive as trait defaults.
struct Stored<T> {
	inner: SignalCell<T>,
}

impl Stored<type T> with Source<T> {
	fun get(self): T {
		self.inner.get()
	}

	[must_use]
	fun on_change(self, observer: |T| void): Subscription {
		self.inner.on_change(observer)
	}
}

fun main() {
	let count: SignalCell<i32> = Signal::new(1);
	// The eager member fires NOW with the current value.
	let eager = count.sub(|value| print(i"sub {value}"));
	// The lazy one does not: nothing is printed until `count` changes.
	let lazy = count.on_change(|value| print(i"on_change {value}"));
	print("attached");
	count.set(2);
	eager.dispose();
	lazy.dispose();
	// Both handles are disposed: this change reaches nobody.
	count.set(3);

	// The owner-registered form, and its disposal.
	let (_built, scope) = comp(|| {
		count.effect_on_change(|value| print(i"effect_on_change {value}"));
	});
	count.set(4);
	scope.dispose();
	count.set(5);

	// The trait default over a custom `Source`: `Stored` writes only `get` and
	// `on_change`, and the default `sub` is that attach PLUS one call with the
	// current value — the eager contract, built by addition. The emitted body
	// is the whole of it: no wrapper cell, no swallowed call, no branch riding
	// every later notification.
	// witness: const subscription = $F(self, observer); observer($G(self)); return subscription;
	// witness-absent: seeded
	let stored = Stored { inner = Signal::new(10) };
	let eagerly = stored.sub(|value| print(i"eager {value}"));
	stored.inner.set(11);
	eagerly.dispose();

	// And the lazy one on the same custom source: the impl's own member.
	let watched = stored.on_change(|value| print(i"stored {value}"));
	stored.inner.set(12);
	watched.dispose();

	// Q5's widening: `map` is a `Source` member, so it derives off `Stored`.
	let labelled = stored.map(|value| i"n={value}");
	print(labelled.get());
	let shown = labelled.sub(|value| print(i"label {value}"));
	stored.inner.set(13);
	shown.dispose();
}

main();
