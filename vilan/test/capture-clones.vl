// B53 (rule 1): pattern captures of aggregate elements copy — with two
// elisions, across BOTH pattern-compilation paths, this golden pins the shapes
// in BYTES.
//
// `total_width` is the read-only walker (immutable AGGREGATE capture,
// readonly-rooted subject, never a value seam): its capture binds WITHOUT
// `__clone`, the share elision that keeps recursive renderers linear.
// `guarded_width` walks the same way through a GUARDED leg — which compiles by
// the alias path, where captures are substituted at each reference rather than
// declared — and shares there too.
//
// `first_or` RETURNS its capture (the value seam), so it binds WITH `__clone`:
// the copy that keeps a returned payload from aliasing the caller's option (the
// `unwrap` leak). `first_or_guarded` is its guarded twin, and its `__clone`
// sits INSIDE the leg body, after the guard — a guard that rejects copies
// nothing. `grow_first` copies through an `is` test, the third shape: a real
// binding beside the subject temp.
//
// `sum_over` keeps the scalar case honest — an `i32` capture is not a cloneable
// aggregate at all, so it never reaches the elisions.
//
// B54 note: the `fallback` legs of `first_or`/`first_or_guarded` also copy now,
// and for a reason that is NOT about captures — `fallback` is a by-value
// parameter the function hands back, which rule 1's return clause copies
// (proposal/element-clones.md §3). B53 closed that leak for captures only.
//
// B81 adds the VIEWED subject, where the alias path's deferred read is not a
// snapshot at all. `step` is it: `&mut self` is written through IN PLACE, so
// both captures become real declarations beside the subject temp — the `i32`
// one included, which owes no copy but does owe a READ, and so appears here
// bare where every other declaration in this file carries `__clone`.
// `viewed_guarded` is the guarded twin, whose guard reads a materialized
// capture and therefore takes B59's prelude shape. `width` is the line the
// rule stops at: nothing can be written through a `&` view, so its captures
// keep their accessors and the share elision with them — an over-widening to
// every view turns exactly this function's bytes red.
//
// B88 adds the OWNED place, where the same seam is reached by a COMPONENT
// write rather than by a view. The three functions below are one contrast,
// and reading them together is the whole rule. `place_component` writes
// `cell.1`, which mutates the very array the subject temp aliases, so both
// captures become real declarations — `weight` bare, since an `i32` owes no
// copy but does owe a READ. `place_rebound` is the identical function with
// `cell = (..)` instead: a whole-binding assignment REBINDS, leaving the temp
// a faithful snapshot, so `weight` keeps its accessor and only `cells` (which
// owes B53's copy) is declared. The one line of difference between the two is
// the rule. `place_guarded` is the guarded twin, whose guard reads the
// materialized `weight` and so takes B59's prelude shape on the place path
// exactly as `viewed_guarded` does on the viewed one.
//
// B97 adds the third subject spelling, a `borrows` CALL, which collected no
// candidates at all before — so BOTH rules were missing and the bytes said so
// (`const $x = slot(h); … $x[0]`, no `__clone` anywhere). `called_component`
// is the twin of `place_component` with `h.slot()` in place of `cell`: same
// two payload shapes, same component write, so the same two declarations —
// `cells` with `__clone`, `weight` bare. `called_readonly` is why the rule is
// not `returns_mut_view`: a `&` projection cannot be written THROUGH, but its
// receiver can be written under its own name, and the temp aliases the
// receiver's storage either way. `owned_call` is the line the widening stops
// at — a call returning an OWNED value produces storage of its own, so its
// captures bind with no copy and no declaration, and admitting it would take
// back B53 §2's elision.
import std::io::print;
import std::option::Option::{ self, Some, None };

enum Feed {
	Ready(List<str>, i32),
	Done,
}

impl Feed {
	fun step(&mut self): str {
		if self is Feed::Ready(let items, let at) {
			self = Feed::Ready(items, at + 1);
			ret items[at];
		}
		"-"
	}

	fun width(&self): i32 {
		if self is Feed::Ready(let items, let at) {
			ret items.len() + at;
		}
		0
	}
}

fun viewed_guarded(pair: &mut (List<i32>, i32)): i32 {
	match pair {
		(let cells, let weight) if weight > 0 => {
			pair.1 = 9;
			cells.len() + weight
		}
		_ => 0,
	}
}

fun place_component(): i32 {
	mut cell = ([1, 2], 3);
	if cell is (let cells, let weight) {
		cell.1 = 9;
		ret cells.len() + weight;
	}
	0
}

fun place_rebound(): i32 {
	mut cell = ([1, 2], 3);
	if cell is (let cells, let weight) {
		cell = ([4], 5);
		ret cells.len() + weight;
	}
	0
}

fun place_guarded(): i32 {
	mut cell = ([1, 2], 3);
	match cell {
		(let cells, let weight) if weight > 0 => {
			cell.1 = 9;
			cells.len() + weight
		}
		_ => 0,
	}
}

fun sum_over(entries: List<(i32, i32)>): i32 {
	mut total = 0;
	for entry in entries {
		match entry {
			(let a, let b) => {
				total = total + a + b;
			}
		}
	}
	total
}

fun total_width(rows: List<(List<i32>, i32)>): i32 {
	mut total = 0;
	for row in rows {
		match row {
			(let cells, let weight) => {
				total = total + cells.len() * weight;
			}
		}
	}
	total
}

fun guarded_width(rows: List<(List<i32>, i32)>): i32 {
	mut total = 0;
	for row in rows {
		match row {
			(let cells, let weight) if weight > 1 => {
				total = total + cells.len();
			}
			_ => {}
		}
	}
	total
}

fun first_or(held: Option<List<i32>>, fallback: List<i32>): List<i32> {
	match held {
		Some(let inner) => inner,
		None => fallback,
	}
}

fun first_or_guarded(held: Option<List<i32>>, limit: i32, fallback: List<i32>): List<i32> {
	match held {
		Some(let inner) if limit > 0 => inner,
		_ => fallback,
	}
}

fun grow_first(pair: (List<i32>, i32)): i32 {
	if pair is (mut cells, let weight) {
		cells.push(weight);
		ret cells.len();
	}
	0
}

struct Cell { pair: (List<i32>, i32) }

impl Cell {
	fun slot(&mut self): &mut (List<i32>, i32) borrows self { &mut self.pair }
	fun peek(&self): &(List<i32>, i32) borrows self { &self.pair }
}

fun called_component(): i32 {
	mut cell = Cell { pair = ([1, 2], 3) };
	if cell.slot() is (let cells, let weight) {
		cell.pair.1 = 9;
		ret cells.len() + weight;
	}
	0
}

fun called_readonly(): i32 {
	mut cell = Cell { pair = ([1, 2], 3) };
	if cell.peek() is (let cells, let weight) {
		cell.pair.1 = 9;
		ret cells.len() + weight;
	}
	0
}

fun fresh_pair(): (List<i32>, i32) {
	([1, 2], 3)
}

fun owned_call(): i32 {
	if fresh_pair() is (let cells, let weight) {
		ret cells.len() + weight;
	}
	0
}

fun main() {
	mut entries = List::new();
	entries.push((1, 2));
	entries.push((10, 20));
	print(sum_over(entries));
	mut rows = List::new();
	rows.push(([1, 2], 3));
	rows.push(([4], 1));
	print(total_width(rows));
	print(guarded_width(rows));
	let held: Option<List<i32>> = Some([1, 2]);
	mut got = first_or(held, List::new());
	got.push(9);
	print(got.len());
	mut guarded = first_or_guarded(held, 1, List::new());
	guarded.push(9);
	print(guarded.len());
	match held {
		Some(let inner) => print(inner.len()),
		None => print(0),
	}
	let pair = ([1, 2], 3);
	print(grow_first(pair));
	print(pair.0.len());
	mut feed = Feed::Ready(["a", "b", "c"], 0);
	print(feed.step());
	print(feed.step());
	print(feed.width());
	mut viewed = ([1, 2], 3);
	print(viewed_guarded(&mut viewed));
	print(viewed.1);
	print(place_component());
	print(place_rebound());
	print(place_guarded());
	print(called_component());
	print(called_readonly());
	print(owned_call());
}
