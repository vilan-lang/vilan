// Deterministic destruction (destruction.md §5/§6, C4 S3): `Option.take`/`replace`,
// the `drop<T>(own)` sink, `own`-parameter drops, the conditional-teardown idiom,
// the resource match-move, and B62's pattern-capture teardown (a leg / destructure
// capture that is NOT moved onward owns the payload and drops at its scope end) —
// every teardown prints so the ORDER is visible.
// Synchronous + host-free, so the interpreter equivalence gate checks it against
// `node` too (exercising the new `__option_take`/`__option_replace` helper arms).
import std::print;
import std::option::Option::{ self, Some, None };
import std::drop::{ Drop, drop };

resource struct Res {
	tag: str,
}
impl Res with Drop {
	fun drop(&mut self) {
		print(i"drop {self.tag}");
	}
}

resource enum Holder {
	Full(Res),
	Empty,
}

resource enum Couple {
	Two(Res, Res),
	Neither,
}

// `take`/`replace` on data: they are ordinary std surface, useful for data too.
fun data_take_replace() {
	mut a = Some(5);
	let taken = a.take();
	print(i"take-data taken={taken.unwrap_or(0)} left_none={a.is_none()}");
	mut b = Some(1);
	let old = b.replace(2);
	print(i"replace-data old={old.unwrap_or(0)} now={b.unwrap_or(0)}");
}

// `take` moves a resource payload into its new owner, which drops it at ITS scope
// end; the emptied slot (`None`) drops nothing.
fun take_resource() {
	mut opt: Option<Res> = Some(Res { tag = "taken" });
	{
		let moved = opt.take();
		print("take-res in-block");
	}
	print("take-res after-block");
}

// The conditional-teardown idiom (destruction.md §6), both arms.
fun conditional_teardown() {
	mut full: Option<Res> = Some(Res { tag = "cond" });
	match full.take() {
		Some(let c) => drop(c),
		None => {}
	}
	print("cond after-some");
	mut empty: Option<Res> = None;
	match empty.take() {
		Some(let c) => drop(c),
		None => print("cond none-arm"),
	}
}

// An `own` resource parameter not moved out drops at the callee's scope end.
fun sink(own r: Res) {
	print(i"sink {r.tag}");
}

// An `own` parameter moved out on every path (returned) drops NOWHERE in the
// callee — the caller owns and drops it once.
fun passthrough(own r: Res): Res {
	print("passthrough");
	r
}

// Matching a resource by value consumes it; the capture is the move, and moving
// the payload out of the arm hands it to a new owner whose drop is visible.
fun match_move() {
	let holder = Holder::Full(Res { tag = "held" });
	let extracted = match holder {
		Holder::Full(let inner) => inner,
		Holder::Empty => Res { tag = "default" },
	};
	print(i"match extracted {extracted.tag}");
	drop(extracted);
}

// B62: a capture that is NOT moved onward owns the payload, so it drops at the
// leg's end — the leg body lowers to its own `try`/`finally`. The `None` leg
// captures nothing and stays a bare branch.
fun match_leg_drop() {
	let held: Option<Res> = Some(Res { tag = "leg" });
	match held {
		Some(let r) => print(i"leg {r.tag}"),
		None => print("leg none"),
	}
	print("leg after");
}

// Two captures in one leg drop in reverse declaration order, and a leg that is
// never taken destroys nothing.
fun match_leg_pair() {
	let both = Couple::Two(Res { tag = "left" }, Res { tag = "right" });
	match both {
		Couple::Two(let first, let second) => print(i"pair {first.tag} {second.tag}"),
		Couple::Neither => print("pair none"),
	}
	print("pair after");
}

// A GUARDED leg binds no locals — its captures are accessors into the subject —
// so the teardown destroys through the accessor, and only once the guard has
// ACCEPTED. Called both ways: an accepting guard drops in its own leg, and a
// rejecting one destroys nothing and leaves the payload for the next leg.
fun match_leg_guard(want: str) {
	let held: Option<Res> = Some(Res { tag = "kept" });
	match held {
		Some(let r) if r.tag == want => print(i"guard-yes {r.tag}"),
		Some(let r) => print(i"guard-no {r.tag}"),
		None => print("guard none"),
	}
	print("guard after");
}

// The same enrollment in the `let`-pattern position: the destructure consumes
// the tuple, so the capture drops at the enclosing scope's end like any `let`.
fun destructure_drop() {
	let pair = (Res { tag = "destructured" }, 3);
	let (r, n) = pair;
	print(i"destructure {r.tag} {n}");
	print("destructure after");
}

fun main() {
	data_take_replace();
	print("--");
	take_resource();
	print("--");
	conditional_teardown();
	print("--");
	sink(Res { tag = "sunk" });
	print("sink returned");
	let back = passthrough(Res { tag = "through" });
	print("passthrough returned");
	drop(back);
	print("--");
	// B68 (affine-moves.md §9.4): the sink's argument is `own`, so an UNBOUND
	// value — a call result — is owned by the `drop` expression and destroyed
	// there, exactly as the `let`-then-`drop` above destroys `back`.
	drop(passthrough(Res { tag = "unbound" }));
	print("unbound dropped");
	print("--");
	match_move();
	print("--");
	match_leg_drop();
	print("--");
	match_leg_pair();
	print("--");
	match_leg_guard("kept");
	print("--");
	match_leg_guard("other");
	print("--");
	destructure_drop();
	print("--");
	let db = Res { tag = "immediate" };
	print("before drop");
	drop(db);
	print("after drop");
}
