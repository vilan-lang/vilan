import std::io::print;

fun main() {
	// N136 (R-g door (a)): `print` formats a NUMBER by the language's own
	// conversion — `String(x)` on JS, the one an i-string and the native
	// backend's `vilan_rt::js_number` use — so negative zero prints "0" on
	// both backends, where node's `console.log` (a `util.inspect` special
	// case) wrote "-0". In the default native differential suite.
	print(0f * -1f);
	let zero = 0;
	print(zero * -1);
	print(-zero);
}
