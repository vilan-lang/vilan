import std::io::print;
import std::style::{ Color, Length, Style, space, style };

// The `css` block (proposal/css-block.md): CSS-shaped sugar over the `style()`
// chain, lowered before analysis. There is no third emission channel and no
// new emitter code — `Style::rule` is still the one chokepoint — so every
// class name below is a content hash of the same slot key and declaration a
// chain would have produced, and the golden beside this file is the proof in
// bytes.

// The one rule: an undotted `property(value);` is a declaration and lowers to
// `.raw(property, value)`; a dotted `.name { … }` is a condition combinator
// and lowers to `.name(style() … )`. The dot is the whole disambiguator, so
// the grammar never consults `Style`'s method list.
//
// Every block in this file is written in the CANONICAL order `vilan fmt`
// produces (S3): properties in Tailwind's category sequence, then the
// conditions in the axis order the selector nests them. `style_chain_order.rs`
// holds the file to it in both spellings.
fun card(): Style {
	css {
		display: flex;
		flex-direction: column;
		gap: {space(4)};
		padding: {space(4)};
		background-color: {Color::gray(50)};
		border-radius: {Length::px(8)};
		.md {
			padding: {space(6)};
		}
		.hover {
			background-color: {Color::gray(100)};
		}
	}
}

// The SAME style as a chain. Both spellings emit byte-identical CSS and
// byte-identical JS — the block builds exactly the node shapes a written chain
// parses to — so this pair adds no line to the golden at all: every class it
// mints is one `card()` already minted.
fun card_as_a_chain(): Style {
	style()
		.raw("display", "flex")
		.raw("flex-direction", "column")
		.raw("gap", space(4))
		.raw("padding", space(4))
		.raw("background-color", Color::gray(50))
		.raw("border-radius", Length::px(8))
		.md(style().raw("padding", space(6)))
		.hover(style().raw("background-color", Color::gray(100)))
}

// Values are ORDINARY VILAN EXPRESSIONS (A101). One argument passes through
// untouched, so a `Length` or a `Color` keeps its `:root` line; several are
// ONE value joined by a single space, each through `piece`, which is CSS's own
// value-list rule and keeps `raw`'s arity at two.
//
// The order here is the sorter's, and it shows both of its rules: the five
// ranked declarations sort into category order, and the two the table cannot
// rank — a property no `Style` method writes, and a custom property — are
// BARRIERS that hold their index absolutely.
fun values(): Style {
	css {
		// What CSS can say and vilan cannot is a string, and a string is a
		// value like any other: commas, parens and quotes inside it are its
		// own bytes.
		grid-template-columns: repeat(3, 1fr);
		width: 50%;
		max-width: 37px;
		// A dimension is a TYPED constructor now (`pct`, `px`, `rem`); a
		// value with no unit of its own is the string it reads as.
		line-height: 1.5;
		background-image: url("tile.png");
		// A value whose parts are GLUED is ONE argument, built by hand: an
		// i-string with each part through `piece`, which renders it and
		// carries its token. Spaced parts are N arguments instead.
		transition-duration: {150}ms;
		// A custom property is span-adjacency, nothing new: `--brand-ink` is
		// five tokens the parser joins and the desugar slices — and it is a
		// CALL HEAD like any other property (R12).
		--brand-ink: {Color::gray(900)};
	}
}

// A dotted head is name-blind (css-block.md §5.3), so `.on(<set>) { … }` is a
// head like any other: it lowers to `.on(<set>, style() … )` with no new
// lowering rule, and the constructors are ambient inside a block so it needs no
// import. The SET has no order — the canonicaliser puts the tokens in the one a
// selector is written in — while the nesting sugar below it still has exactly
// one legal order, media outermost. The formatter sorts both: sibling
// conditions by axis, and the values inside a head by the same axis order.
fun conditions(): Style {
	css {
		color: {Color::gray(900)};
		.md {
			.on(within(attribute("data-theme").eq("dark")) + attribute("data-open").eq("true") + hover()) {
				color: {Color::gray(50)};
			}
		}
		.on(within(attribute("data-theme").eq("dark"))) {
			color: {Color::gray(50)};
			.hover {
				color: {Color::gray(100)};
			}
		}
		.children {
			margin-top: {space(2)};
		}
		.divide {
			margin-top: {space(4)};
		}
	}
}

fun main() {
	let block = const card();
	let chain = const card_as_a_chain();
	// The two spellings resolve the SAME slots to the same classes.
	print(block.class_list());
	print(chain.class_list());
	print(const values().class_list());
	print(const conditions().class_list());
	// A block is an ordinary expression: `+` still combines, and last wins.
	let wider = const css { padding: {space(6)}; };
	print((block + wider).class_list());
}
main();
