// `const asset::bundle` — the const channel's output direction for whole files
// (kolt.local 029). The call tells the build to carry `asset_bundle_note.txt`
// into the output directory and folds to the url the copy answers on, so the
// emitted JS holds a plain string and no runtime call survives.
import std::asset::bundle;
import std::io::print;

let note = const bundle("asset_bundle_note.txt");

fun main() {
	print(note);
}

main();
