import std::print;
import std::style::{ Color, Display, Gradient, Length, RadialExtent, Style, space, style };

// Typed atomic styles (proposal/ui-styling.md): construction inside `const`
// via the builder chain; atomic rules and theme vars flow through the asset
// channel into the style.css golden beside this one. Selection and merging
// (`+`, `class_list`) are ordinary runtime code over already-emitted rules.

fun card_style(): Style {
	style()
		.display(Display::Flex)
		.padding(space(4))
		.background(Color::gray(50))
		.hover(style().background(Color::gray(100)))
}

fun main() {
	let card = const card_style();
	let active = const style().padding(space(6));
	print(card.class_list());
	print((card + active).class_list());

	// Arbitrary values mint their own atomic class — the escape, not the norm.
	let wide = const style().width(Length::px(37));
	print(wide.class_list());

	// Two breakpoints on ONE property: the golden pins the ascending
	// min-width emission order (B35) — sm before lg, so the widest matching
	// breakpoint wins the wide-viewport cascade tie.
	let responsive = const style().sm(style().padding(space(2))).lg(style().padding(space(3)));
	print(responsive.class_list());

	// Conditions stack outside-in, media > dark > pseudo. The golden pins the
	// composed selectors in bytes: the dark ancestor and the pseudo suffix in
	// ONE rule, and the whole thing inside a media block. Note the leading
	// byte — a composed dark rule still starts with ':', which is what keeps
	// it in the same cascade band as every other dark rule (B35).
	let themed = const style()
		.dark(style().background(Color::gray(900)))
		.dark(style().hover(style().background(Color::gray(700))))
		.md(style().dark(style().hover(style().background(Color::gray(50)))));
	print(themed.class_list());

	// The value types (ui-styling.md §0bis.3). A translucent token renders as
	// a RELATIVE colour, so `var(--gray-900)` survives into the declaration
	// and its `:root` line still emits — the golden is where that is proven in
	// bytes. Every line this block adds is an ADDITION: the rules above keep
	// the exact class names they had before the value types existed.
	let translucent = const style()
		.background(Color::rgba(27, 6, 13, 0.9))
		.color(Color::gray(900).alpha(0.08));
	print(translucent.class_list());

	// A gradient is `background-image`, a different slot from `background` —
	// both survive on one style. Stops carry their colours' `:root` lines.
	let painted = const style()
		.background(Color::gray(50))
		.background_gradient(Gradient::linear(90.0)
			.stop(Color::blue(600), 0.0)
			.stop(Color::transparent(), 100.0))
		.hover(style().background_gradient(Gradient::radial(RadialExtent::ClosestSide)
			.stop(Color::rgba(178, 48, 86, 0.5), 0.0)
			.stop(Color::transparent(), 100.0)));
	print(painted.class_list());

	// `border_none()` fills the SAME slot the shorthand does, so the cleared
	// style carries ONE border class — the golden shows both declarations, and
	// the class list shows the override.
	let framed = const style()
		.display(Display::InlineFlex)
		.border_top(Length::px(1), Color::gray(300))
		.padding_top(space(2))
		.margin_left(Length::auto());
	print(framed.class_list());
	print(const style().border(Length::px(1), Color::gray(300)).border_none().class_list());

	// The remainder's value surfaces (ui-styling.md §0bis.5). `zero()` is a bare
	// `0`, not `0px`; `css()` is verbatim where `calc()` wraps — the golden is
	// where that pair is proven in bytes. Additions again: nothing above moves.
	let zeroed = const style()
		.inset(Length::zero())
		.min_width(Length::zero())
		.left(Length::css("clamp(120px, 30%, 185px)"))
		.max_width(Length::calc("100% - 2rem"));
	print(zeroed.class_list());

	// `Color::var` is `Length::var`'s counterpart: the value is `var(--accent)`
	// verbatim and NO `:root` line emits — the app owns the declaration. The
	// golden shows `.alpha()` composing over it through the relative-colour
	// form, the same as over a ramp token.
	let accented = const style()
		.background(Color::var("--accent"))
		.border_color(Color::var("--accent").alpha(0.5));
	print(accented.class_list());

	// `oklch` is the perceptual literal: number-form lightness, space-joined
	// components, the hue a bare degree count. `.alpha()` composes through
	// the relative form, the same as over every other colour.
	let perceptual = const style()
		.background(Color::oklch(0.62, 0.19, 313.0))
		.color(Color::oklch(0.97, 0.02, 340.0).alpha(0.8));
	print(perceptual.class_list());

	// `size` writes the SAME two slots `width` and `height` write — the class
	// list shows two classes for one call, and a later `height` narrows the
	// square by the ordinary last-wins rule (three calls, two classes).
	let squared = const style().size(Length::rem(1.0));
	print(squared.class_list());
	print(const style().size(Length::rem(1.0)).height(Length::rem(2.0)).class_list());

	// The attribute condition selects on the element ITSELF, where dark's
	// hardcoded ancestor is the one ancestor form. The golden pins the
	// composed selectors in bytes: the bare suffix, the suffix before a
	// pseudo-class, under the dark ancestor, and the full
	// media(dark(attribute(pseudo(..)))) stack — attribute rules start with
	// '.', so they stay in the base cascade band (B35).
	let disclosed = const style()
		.attribute("data-open", "true", style().display(Display::Flex))
		.attribute("data-open", "true", style().hover(style().background(Color::gray(100))))
		.dark(style().attribute("data-open", "true", style().background(Color::gray(800))))
		.md(style().dark(style().attribute("data-open", "true", style().hover(style().color(Color::gray(50))))));
	print(disclosed.class_list());

	// Two methods per slot, deliberately: `background_image` writes the slot
	// `background_gradient` writes, and `line_height_length` the slot
	// `line_height` writes. So each pair OVERRIDES rather than racing — the
	// class list shows one class per slot even though two methods wrote it.
	let tiled = const style()
		.background_image("url(tile.png)")
		.background_size("120px 120px")
		.line_height(1.5)
		.line_height_length(Length::px(24));
	print(tiled.class_list());
}
main();
