import std::reactive::{ Source, SignalCell, Subscription };

// `dyn Trait` (A124 R3): one type whatever it holds. A field, a list element,
// a parameter and a binding each take any value whose type implements the
// trait, and a call through one reads the member out of the object's table.
// The coercion is explicit: a value becomes an object only where the
// position's type says `dyn`.

trait Named {
	fun name(self): str;
}

trait Shape with Named {
	fun area(self): i32;
	fun describe(self, prefix: str): str;
}

struct Square { side: i32 }
struct Rect { w: i32, h: i32 }

impl Square with Named { fun name(self): str { "square" } }
impl Square with Shape {
	fun area(self): i32 { self.side * self.side }
	fun describe(self, prefix: str): str { i"{prefix}{self.name()} {self.side}" }
}
impl Rect with Named { fun name(self): str { "rect" } }
impl Rect with Shape {
	fun area(self): i32 { self.w * self.h }
	fun describe(self, prefix: str): str { i"{prefix}{self.name()} {self.w}x{self.h}" }
}

// A blanket over the bound reaches the object with `S` bound to it, and so
// does a generic function: neither is a table slot.
impl type S: Shape { fun doubled_area(self): i32 { self.area() * 2 } }
fun largest<S: Shape>(shapes: List<S>): i32 {
	mut best = 0;
	for shape in shapes {
		if shape.area() > best { best = shape.area(); }
	}
	best
}

// A heterogeneous collection behind a struct FIELD — the position B184's
// hidden generic used to fill, where one list of two node types was refused.
struct Slot { shape: dyn Shape }

// A cold pipeline node over an erased upstream: it owns no value, pulls through
// `get`, and registers downstream through its upstream's `on_change`.
struct Offset { up: dyn Source<i32>, by: i32 }
impl Offset with Source<i32> {
	fun get(self): i32 { self.up.get() + self.by }
	fun on_change(self, observer: |i32| void): Subscription {
		let by = self.by;
		self.up.on_change(|n| observer(n + by))
	}
}

fun total(shapes: List<dyn Shape>): i32 {
	mut sum = 0;
	for shape in shapes { sum = sum + shape.area(); }
	sum
}

fun main() {
	let slots: List<Slot> = [ Slot { shape = Square { side = 3 } }, Slot { shape = Rect { w = 2, h = 5 } } ];
	for slot in slots {
		print(slot.shape.describe("- "));
		print(i"{slot.shape.name()} {slot.shape.area()} {slot.shape.doubled_area()}");
	}
	let shapes: List<dyn Shape> = [ Rect { w = 4, h = 4 }, Square { side = 2 } ];
	print(total(shapes));
	print(largest(shapes));
	print(slots[0]);

	let root = SignalCell::new(1);
	let sources: List<dyn Source<i32>> = [ root, Offset { up = root, by = 100 } ];
	let watch = sources[1].on_change(|n| print(i"offset saw {n}"));
	root.set(5);
	for source in sources { print(source.get()); }
	watch.dispose();
}
