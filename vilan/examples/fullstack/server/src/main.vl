// The server — a Node program. It serves the client leg's build and an HTML
// shell on every other path. It shares `common::greeting` with the client.
//
// Nothing here names an artifact. `build_of("client")` reads the leg's build
// manifest — the bundle, its stylesheet if it has one, and whatever ROUTE
// CHUNKS the build wrote (proposal/bundle-splitting.md §3) — and `serve_build`
// installs one route per file it names. So adding, renaming or removing a route
// arm needs no server change, and neither does turning `split` on: the routes
// appear because the manifest changed, not because this file did.

import std::build::require_build;
import std::http::{ Request, Response, Server };
import std::print;
import common::greeting;

async fun main() {
	let build = require_build("client");

	let server = Server::builder()
		.port(3000)
		.serve_build(build)
		.on_request(|request| {
			match request.path() {
				// An API route the client calls with `fetch`. Its body uses the
				// same shared `greeting` the client does.
				"/api/hello" => Response::builder().set_header("Content-Type", "text/plain").body(greeting("the API")).build(),
				_ => Response::builder().set_header("Content-Type", "text/html").body(page()).build(),
			}
		})
		.on_start(|server| {
			print(greeting("server"));
			print(server.url());
		})
		.build();

	server.start();
}

fun page(): str {
	i"<!doctype html><html><head><meta charset=\"utf-8\"><title>Vilan full-stack</title></head><body><div id=\"app\"></div><script type=\"module\" src=\"/client.js\"></script></body></html>"
}
