// A documentation page laid out by `std::ui` in a GPU-drawn window: a header
// row, a sidebar column, and a content column with wrapped paragraphs, a picture
// card whose badge is anchored to its corner, and a caption beside it. Nothing
// here is positioned by hand — every box comes from the elements' gap, padding,
// grow, align and anchor — and nothing reacts to input (`ui-counter` and
// `ui-list` do). A second, smaller screen shows icons in rows beside text
// (`--icons`): in the text's colour and size, at sizes of their own, coloured,
// filled, and inside a button.
//
// Resize the window: the header and the body follow its width, the paragraphs
// wrap again, and the sidebar keeps its 200 dp.
//
// Built from element tags (`<row gap(dp(20))>..</row>`), which lower to the
// builder calls (`row().gap(dp(20)).child(..)`) — `paragraph` is written that
// way, and either spelling builds the same element.
//
// Modes, for the end-to-end test:
//
//   --rects <width> <height> <scale> --font <ttf>
//                           lay the screen out at that size and scale with the
//                           given font, and print every element's box in device
//                           pixels, one line each, in paint order
//   --smoke                 open the window, draw one frame with the screen laid
//                           out at the window's size, print the root's box and
//                           close
//   --golden <png> --font <ttf>
//                           draw the screen offscreen with a software adapter and
//                           the given font at 100% and 150%, and compare each
//                           with its PNG (one per channel of tolerance); with
//                           VILAN_REGENERATE_GFX_GOLDENS set, write them instead
//   --golden-rule           print how the golden comparison judges made-up images
//                           (the icon goldens' allowance, tracker N201)
//   --icons                 with --rects or --golden: the icon screen instead, at
//                           its own size (--rects prints what an assistive tool
//                           is told of it after its boxes)

import std::bytes::Bytes;
import std::fs::{ read_bytes, write_bytes };
import std::gfx::{
	Border,
	Color,
	Edges,
	FillRule,
	FontFamily,
	Frame,
	Offscreen,
	PathPaint,
	Size,
	Texture,
	Window,
	dp,
	register_font,
};
import std::image::{ Format, Image };
import std::io::print;
import std::process::{ args, env, exit };
import std::range::Range;
import std::ui::{
	Align,
	Anchor,
	DropShadow,
	Element,
	Fit,
	Icon,
	Justify,
	Role,
	Style,
	column,
	draw,
	icon,
	image,
	layout,
	mount,
	row,
	stack,
	style,
	text,
};

/// The screen's text colour, and the header's background.
fun ink(): Color {
	Color::rgb(33, 36, 46)
}

/// The screen's one accent colour.
fun accent(): Color {
	Color::rgb(45, 95, 230)
}

/// A 160 x 100 picture drawn by the program: a diagonal gradient with a grid,
/// so a stretch, a crop or a misplaced texture shows in the golden image.
fun picture(): Texture {
	let width = 160;
	let height = 100;
	let pixels = Bytes::alloc((width * height * 4).as_usize());
	for y in Range::new(0, height) {
		for x in Range::new(0, width) {
			let index = ((y * width + x) * 4).as_usize();
			let line = x % 20 == 0 || y % 20 == 0;
			pixels.set(index, if line { 255 } else { 40 + x });
			pixels.set(index + 1, if line { 255 } else { 90 + y });
			pixels.set(index + 2, if line { 255 } else { 200 });
			pixels.set(index + 3, 255);
		}
	}
	match Texture::from_rgba(width.as_u32(), height.as_u32(), pixels) {
		Ok(let texture) => texture,
		Err(let reason) => {
			print(i"picture: {reason}");
			exit(2);
			Texture::from_rgba(1, 1, Bytes::alloc(4)).unwrap()
		},
	}
}

fun header(): Element {
	let link = style().text_color(Color::rgb(200, 210, 255));
	// An empty row that grows: the links sit at the right end.
	<row
		padding_x(dp(24))
		padding_y(dp(14))
		gap(dp(20))
		align(Align::Center)
		style(style().background(ink()).text_color(Color::white()))
		label("header")
	>
		<text style(style().text_size(dp(20)).weight(700)) role(Role::Heading) label("brand")>
			"vilan"
		</text>
		<row grow(1.0) label("spacer") />
		<text style(link) role(Role::Link) label("guide")>"Guide"</text>
		<text style(link) role(Role::Link) label("library")>"Library"</text>
		<text style(link) role(Role::Link) label("examples")>"Examples"</text>
	</row>.element()
}

fun sidebar(): Element {
	let entry = |name: str, current: bool| {
		let look = if current {
			style().background(Color::rgb(225, 232, 255)).text_color(accent()).radius(dp(6))
		} else {
			style()
		};
		<text padding_x(dp(10)) padding_y(dp(6)) style(look) role(Role::ListItem)>{name}</text>
	};
	let edge = Border {
		widths = Edges { top = dp(0), right = dp(1), bottom = dp(0), left = dp(0) },
		color = Color::rgb(220, 220, 228),
	};
	// `shrink(0.0)`: the content beside it wants more than the window has, and
	// a row takes the shortfall from every child that may shrink.
	<column
		width(dp(200))
		shrink(0.0)
		padding(dp(16))
		gap(dp(4))
		style(style().background(Color::rgb(246, 246, 250)).border(edge))
		role(Role::List)
		label("sidebar")
	>
		{entry("Overview", false)}
		{entry("Elements", true)}
		{entry("Layout", false)}
		{entry("Style", false)}
		{entry("Drawing", false)}
	</column>.element()
}

/// The picture with a badge anchored to its top-right corner.
fun card(picture: Texture): Element {
	let badge_look = style()
		.background(Color::rgb(230, 60, 70))
		.text_color(Color::white())
		.text_size(dp(11))
		.weight(700)
		.radius(dp(9));
	let card_look = style()
		.background(Color::white())
		.radius(dp(10))
		.shadow(DropShadow::new(dp(0), dp(2), dp(10), Color::rgba(0, 0, 0, 0.2)));
	<stack padding(dp(8)) style(card_look) label("card")>
		<image
			texture(picture)
			fit(Fit::Cover)
			width(dp(240))
			height(dp(120))
			style(style().radius(dp(6)))
			role(Role::Image)
			label("picture")
		/>
		<text
			padding_x(dp(8))
			padding_y(dp(3))
			anchor(Anchor::TopRight)
			style(badge_look)
			label("badge")
		>
			"NEW"
		</text>
	</stack>.element()
}

/// A paragraph — written as the builder calls a tag lowers to, which is the same
/// element (the recorded rectangles hold both spellings to one layout).
fun paragraph(words: str): Element {
	text().child(words).role(Role::Paragraph).element()
}

fun content(picture: Texture): Element {
	<column grow(1.0) padding(dp(28)) gap(dp(16)) label("content")>
		<text style(style().text_size(dp(26)).weight(700)) role(Role::Heading) label("title")>
			"Layout without a style sheet"
		</text>
		{paragraph("Rows and columns place their children in a line, a gap apart; a stack puts them on top of one another, each anchored to an edge or a corner. A paragraph wraps to the width its column gives it, and nothing here was positioned by hand.")}
		<row gap(dp(20)) align(Align::Start) label("feature")>
			{card(picture)}
			<column grow(1.0) shrink(1.0) gap(dp(8)) label("caption")>
				<text style(style().weight(600))>"A picture, cropped to cover its box"</text>
				{paragraph("The badge sits in the card's top-right corner because the card is a stack and the badge asks for that anchor. Make the window narrower and this column gives up its width first.")}
			</column>
		</row>
		{paragraph("Style is a value: a background, a border, a radius, a shadow, a text style. Text style alone is inherited, so the header's white reaches every word inside it.")}
	</column>.element()
}

/// The whole screen. `font`, when given, is set at the root and inherited by
/// every text (the end-to-end test's registered font).
fun screen(font: Option<str>, picture: Texture): Element {
	let base: Style = match font {
		Some(let family) => style().font(FontFamily::Named(family)),
		None => style(),
	};
	let look = base
		.background(Color::rgb(252, 252, 253))
		.text_color(ink())
		.text_size(dp(15))
		.line_height(1.4);
	<column style(look) label("screen")>
		{header()}
		<row grow(1.0) align(Align::Stretch) justify(Justify::Start) label("body")>
			{sidebar()}
			{content(picture)}
		</row>
	</column>.element()
}

// --- The icon screen -------------------------------------------------------------
//
// A few of Lucide's icons (ISC licence), as an icon set's generated functions
// answer them: 24-unit boxes, stroked 2 units wide with round joins and caps. The
// heart is filled, and the ring is made up to show an even-odd hole. (A real set
// is a package of these; std ships none.)

fun check(): Icon {
	Icon::stroked("M20 6 9 17l-5-5", 24.0, 2.0)
}

fun circle_check(): Icon {
	Icon::stroked("M22 12a10 10 0 1 1-20 0a10 10 0 1 1 20 0ZM9 12l2 2 4-4", 24.0, 2.0)
}

fun star(): Icon {
	Icon::stroked(
		"M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z",
		24.0,
		2.0,
	)
}

fun settings(): Icon {
	Icon::stroked(
		"M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2zM15 12a3 3 0 1 1-6 0a3 3 0 1 1 6 0Z",
		24.0,
		2.0,
	)
}

fun chevron_down(): Icon {
	Icon::stroked("m6 9 6 6 6-6", 24.0, 2.0)
}

fun heart(): Icon {
	Icon::filled(
		"M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z",
		24.0,
	)
}

fun ring(): Icon {
	Icon::new(
		"M12 2a10 10 0 1 1 0 20a10 10 0 1 1 0-20ZM12 7a5 5 0 1 1 0 10a5 5 0 1 1 0-10Z",
		24.0,
		PathPaint::Fill(FillRule::EvenOdd),
	)
}

/// The icon screen's size, in dp.
fun icon_screen_size(): Size {
	Size::new(dp(420), dp(200))
}

/// Icons in rows beside text. The first takes the text's size and colour; the
/// second row sets sizes, and one a colour and a label (the only icon an
/// assistive tool is told of); the button's icon turns white with its text; the
/// last row is filled.
fun icon_screen(font: str): Element {
	let look = style()
		.font(FontFamily::Named(font))
		.background(Color::white())
		.text_color(ink())
		.text_size(dp(15));
	let button_look = style().background(accent()).text_color(Color::white()).radius(dp(6));
	<column padding(dp(16)) gap(dp(14)) align(Align::Start) style(look) label("icons")>
		<row gap(dp(8)) align(Align::Center) label("saved")>
			<icon of(check()) />
			<text>"Saved"</text>
		</row>
		<row gap(dp(10)) align(Align::Center) label("sizes")>
			<icon of(star()) size(dp(16)) />
			<icon of(settings()) size(dp(24)) />
			<icon of(circle_check()) size(dp(32)) color(accent()) label("done") />
			<text>"16, 24 and 32 dp"</text>
		</row>
		<row
			padding_x(dp(12))
			padding_y(dp(6))
			gap(dp(6))
			align(Align::Center)
			style(button_look)
			role(Role::Button)
			label("menu")
		>
			<text>"Menu"</text>
			<icon of(chevron_down()) size(dp(18)) />
		</row>
		<row gap(dp(10)) align(Align::Center) label("filled")>
			<icon of(heart()) size(dp(24)) color(Color::rgb(220, 50, 70)) />
			<icon of(ring()) size(dp(24)) />
			<text>"Filled, and an even-odd hole"</text>
		</row>
	</column>.element()
}

/// Rects mode for the icon screen: its boxes at 100% and 150%, then what an
/// assistive tool is told of it.
fun icon_rects(arguments: List<str>) {
	let root = icon_screen(test_font(arguments));
	for scale in [1.0, 1.5] {
		layout(root, icon_screen_size(), scale);
		print(i"icons {icon_screen_size().width.value()} x {icon_screen_size().height.value()} dp at {scale}");
		for entry in root.outline() {
			let device = |length: f64| (length * scale).round();
			print(i"{"  ".repeat(entry.depth)}{entry.kind} {entry.label} {device(entry.bounds.x.value())} {device(entry.bounds.y.value())} {device(entry.bounds.width.value())} {device(entry.bounds.height.value())}");
		}
	}
	print("accessibility:");
	print(root.accessibility().trim());
}

/// Golden mode for the icon screen: offscreen, at 100% and 150%.
fun icon_golden(arguments: List<str>) {
	let golden = after(arguments, "--golden");
	let root = icon_screen(test_font(arguments));
	for scale in [1.0, 1.5] {
		let path = i"{golden}-{(scale * 100.0).round()}.png";
		let drawn = Offscreen::new(icon_screen_size().width, icon_screen_size().height)
			.scale_factor(scale)
			.software(true)
			.render(|frame: Frame| draw(frame, root));
		match drawn {
			Ok(let image) => compare(path, image, icon_stragglers()),
			Err(let reason) => {
				print(i"golden: {reason}");
				exit(2);
			},
		}
	}
}

fun main() {
	let arguments = args();
	if arguments.contains("--golden-rule") {
		golden_rule();
		ret;
	}
	let icons = arguments.contains("--icons");
	if arguments.contains("--rects") {
		if icons {
			icon_rects(arguments);
		} else {
			rects(arguments);
		}
		ret;
	}
	if arguments.contains("--golden") {
		if icons {
			icon_golden(arguments);
		} else {
			golden(arguments);
		}
		ret;
	}
	let window = match Window::builder().title("vilan ui").size(dp(960), dp(640)).open() {
		Ok(let window) => window,
		// No display, no GPU: say why.
		Err(let reason) => {
			print(i"no window: {reason}");
			ret;
		},
	};
	let root = screen(None, picture());
	if arguments.contains("--smoke") {
		window.on_frame(|frame: Frame| {
			draw(frame, root);
			let bounds = root.bounds();
			print(i"frame {bounds.width.value()} x {bounds.height.value()} at {frame.scale_factor()}");
			window.close();
		});
		ret;
	}
	mount(window, root);
}

/// The family the font at `--font` registers, or the program ends.
fun test_font(arguments: List<str>): str {
	match register_font(read_bytes(after(arguments, "--font"))) {
		Ok(let families) => families[0],
		Err(let reason) => {
			print(i"font: {reason}");
			exit(2);
			""
		},
	}
}

/// Rects mode: every box, in device pixels.
fun rects(arguments: List<str>) {
	let width = after(arguments, "--rects").parse_f64().unwrap_or(0.0);
	let height = arguments[index_of(arguments, "--rects") + 2].parse_f64().unwrap_or(0.0);
	let scale = arguments[index_of(arguments, "--rects") + 3].parse_f64().unwrap_or(1.0);
	let root = screen(Some(test_font(arguments)), picture());
	layout(root, Size::new(dp(width), dp(height)), scale);
	print(i"screen {width} x {height} dp at {scale}");
	for entry in root.outline() {
		let device = |length: f64| (length * scale).round();
		print(i"{"  ".repeat(entry.depth)}{entry.kind} {entry.label} {device(entry.bounds.x.value())} {device(entry.bounds.y.value())} {device(entry.bounds.width.value())} {device(entry.bounds.height.value())}");
	}
}

/// Golden mode: the screen offscreen, at 100% and 150%, held to a PNG each.
fun golden(arguments: List<str>) {
	let golden = after(arguments, "--golden");
	let root = screen(Some(test_font(arguments)), picture());
	for scale in [1.0, 1.5] {
		let path = i"{golden}-{(scale * 100.0).round()}.png";
		let drawn = Offscreen::new(dp(960), dp(640))
			.scale_factor(scale)
			.software(true)
			.render(|frame: Frame| draw(frame, root));
		match drawn {
			Ok(let image) => compare(path, image, 0),
			Err(let reason) => {
				print(i"golden: {reason}");
				exit(2);
			},
		}
	}
}

/// How many channel values of an icon golden may be one further off than the
/// tolerance (two, where the tolerance is one), none further (tracker N201). A
/// path's coverage mask is blended over the background and encoded to sRGB, and
/// two versions of the software rasteriser (this box's Mesa and CI's) round the
/// blend's last bit differently, which the encode stretches to two at a dark
/// value: the path sheets of the GPU crate met it on CI. The page's goldens draw
/// no path and keep the plain tolerance (0 allowed).
fun icon_stragglers(): i32 {
	12
}

/// Writes `image` to `path` (regenerating), or compares it with the PNG there:
/// every channel within one, but for at most `stragglers` within two.
fun compare(path: str, image: Image, stragglers: i32) {
	if env("VILAN_REGENERATE_GFX_GOLDENS").is_some() {
		match image.encode(Format::Png, 100) {
			Ok(let png) => write_bytes(path, png),
			Err(let reason) => print(i"golden: {reason}"),
		}
		print(i"golden: wrote {path}");
		ret;
	}
	let expected = match Image::decode(read_bytes(path)) {
		Ok(let expected) => expected,
		Err(let reason) => {
			print(i"golden: {path}: {reason}");
			exit(1);
			ret;
		},
	};
	if expected.width() != image.width() || expected.height() != image.height() {
		print(i"golden: {path} is {expected.width()} x {expected.height()}, the frame {image.width()} x {image.height()}");
		exit(1);
		ret;
	}
	let found = differences(expected.rgba(), image.rgba());
	if within(found, stragglers) {
		if found.past == 0 {
			print(i"golden: {path} matches");
		} else {
			print(i"golden: {path} matches ({found.past} channel values two off, of {stragglers} allowed)");
		}
	} else {
		print(i"golden: {path}: {found.past} channels differ by more than 1 ({found.far} by more than 2; {stragglers} allowed two off)");
		exit(1);
	}
}

/// How two images' channels differ: how many by more than one (past the
/// tolerance), and how many of those by more than two.
struct Differences {
	past: i32,
	far: i32,
}

/// Software Vulkan and software GL differ by one in a handful of channels.
fun differences(expected: Bytes, drawn: Bytes): Differences {
	mut past = 0;
	mut far = 0;
	for index in Range::new(0, drawn.len().as_i32()) {
		let difference = expected.get(index.as_usize()) - drawn.get(index.as_usize());
		if difference > 1 || difference < -1 {
			past += 1;
		}
		if difference > 2 || difference < -2 {
			far += 1;
		}
	}
	Differences { past, far }
}

/// The rule: no channel more than two off, and at most `stragglers` two off.
fun within(found: Differences, stragglers: i32): bool {
	found.far == 0 && found.past <= stragglers
}

/// One made-up case of the rule: 64 channel values of 100, the first ones
/// moved by `offsets`, judged with `stragglers` allowed.
fun rule_case(name: str, offsets: List<i32>, stragglers: i32) {
	let expected = Bytes::alloc(64);
	let drawn = Bytes::alloc(64);
	for index in Range::new(0, 64) {
		expected.set(index.as_usize(), 100);
		drawn.set(index.as_usize(), 100);
	}
	mut at: usize = 0;
	for offset in offsets {
		drawn.set(at, 100 + offset);
		at += 1;
	}
	let verdict = if within(differences(expected, drawn), stragglers) { "passes" } else { "fails" };
	print(i"rule {name}: {verdict}");
}

/// `count` copies of `offset`.
fun offsets(count: i32, offset: i32): List<i32> {
	mut all: List<i32> = [];
	for _ in Range::new(0, count) {
		all.push(offset);
	}
	all
}

/// Golden-rule mode: the rule on made-up images, for the test that pins it (no
/// GPU needed).
fun golden_rule() {
	rule_case("every value one off, none allowed", offsets(40, 1), 0);
	rule_case("one value two off, none allowed", [2], 0);
	rule_case("three values two off, 12 allowed", [2, -2, 2], icon_stragglers());
	rule_case("twelve values two off, 12 allowed", offsets(12, 2), icon_stragglers());
	rule_case("thirteen values two off, 12 allowed", offsets(13, -2), icon_stragglers());
	rule_case("one value three off, 12 allowed", [3], icon_stragglers());
}

fun index_of(arguments: List<str>, flag: str): usize {
	for index in Range::new(0, arguments.len().as_i32()) {
		if arguments[index.as_usize()] == flag {
			ret index.as_usize();
		}
	}
	print(i"{flag} is missing");
	exit(2);
	0
}

fun after(arguments: List<str>, flag: str): str {
	let index = index_of(arguments, flag) + 1;
	if index >= arguments.len() {
		print(i"{flag} needs a value");
		exit(2);
		ret "";
	}
	arguments[index]
}

main();
