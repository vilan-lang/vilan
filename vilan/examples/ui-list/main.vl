// A list of 10,000 rows in a `scroll` (native-ui.md part P3's exit test). Each row
// is a label and a count of its clicks, bound to a signal of its own; a click on
// a row adds one to that row's count, and a row under the pointer is lighter.
//
// What it shows about `std::ui`'s updates: the wheel moves the scroll's offset,
// which repaints the scroll alone — nothing inside it is laid out or painted
// again, and rows outside the viewport are skipped whole when the frame is
// drawn; a click changes one text, which the solver measures alone (it then
// places the column's rows again from its cache), and repaints one row. Every
// row is a real element: virtualising a list, laying out only the rows in view,
// is a `std::ui::kit` component (part P4), not this.
//
// Modes:
//
//   --smoke   a line per frame — the offset, the rows clicked, and what the frame
//             took (layout, paint, the window's draw of the frame before) — and
//             the first frame's scroll box; the test drives it with the wheel and
//             a click
//   --rows N  N rows instead of 10,000

import std::gfx::{ Color, Frame, Point, Window, dp };
import std::io::print;
import std::process::args;
import std::range::Range;
import std::reactive::{ Signal, SignalCell };
import std::shared::Shared;
import std::ui::{
	Align,
	Element,
	ScrollElement,
	Style,
	column,
	draw,
	hovered,
	last_frame,
	mount,
	row,
	scroll,
	style,
	text,
};

fun row_look(index: i32): Style {
	let shade = if index % 2 == 0 { Color::rgb(252, 252, 253) } else { Color::rgb(244, 245, 248) };
	style()
		.background(shade)
		.when(hovered(), |look: Style| look.background(Color::rgb(222, 230, 255)))
}

/// One row: its label, and its clicks — a signal of its own, so a click changes
/// this row's text and nothing else.
fun list_row(index: i32, clicked: Shared<i32>): Element {
	let clicks: SignalCell<i32> = Signal::new(0);
	<row
		padding_x(dp(12))
		padding_y(dp(6))
		gap(dp(8))
		align(Align::Center)
		style(row_look(index))
		on_click(|| {
			clicks.set_with(|value: i32| value + 1);
			clicked.write() = index;
		})
	>
		<text grow(1.0)>{i"Row {index}"}</text>
		<text>{clicks.derive(|value: i32| i"{value} clicks")}</text>
	</row>.element()
}

fun main() {
	let arguments = args();
	let smoke = arguments.contains("--smoke");
	mut count = 10000;
	for index in Range::new(1, arguments.len().as_i32()) {
		if arguments[(index - 1).as_usize()] == "--rows" {
			count = arguments[index.as_usize()].parse_f64().unwrap_or(10000.0).as_i32();
		}
	}
	let window = match Window::builder().title("vilan ui list").size(dp(480), dp(640)).open() {
		Ok(let window) => window,
		// No display, no GPU: say why.
		Err(let reason) => {
			print(i"no window: {reason}");
			ret;
		},
	};
	let clicked: Shared<i32> = Shared::new(-1);
	let offset: SignalCell<Point> = Signal::new(Point::new(dp(0), dp(0)));
	let rows = column().label("rows");
	for index in Range::new(0, count) {
		rows.child(list_row(index, clicked));
	}
	let viewport: ScrollElement = scroll().grow(1.0).offset(offset).label("viewport");
	viewport.child(rows);
	let root = <column style(style().text_color(Color::rgb(30, 30, 40))) label("list")>
		<text padding(dp(12)) style(style().weight(700))>
			{i"{count} rows: scroll, and click one"}
		</text>
		{viewport}
	</column>;
	mount(window, root);
	if !smoke {
		ret;
	}
	// Smoke mode: the same frames, through a frame callback of the program's own
	// so each can be reported.
	let frames: Shared<i32> = Shared::new(0);
	window.on_frame(|frame: Frame| {
		draw(frame, root);
		frames.write() = frames.read() + 1;
		let times = last_frame(window);
		print(i"frame {frames.read()} offset={offset.get().y.value()} clicked={clicked.read()} solved={times.solved} measured={times.measured} moved={times.moved} rebuilt={times.rebuilt} layout_us={times.layout.round()} paint_us={times.paint.round()} draw_us={times.draw.round()}");
		if frames.read() == 1 {
			let bounds = viewport.element().bounds();
			print(i"box viewport {bounds.x.value()} {bounds.y.value()} {bounds.width.value()} {bounds.height.value()} range={viewport.range().height.value()}");
		}
	});
}

main();
