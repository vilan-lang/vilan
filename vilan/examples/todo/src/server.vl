// The server: boots the one authoritative `TodoStore` (which owns its own
// persistence — see `store.vl`), serves the browser leg's build, and installs
// the store's generated dispatcher as a service on the same builder
// (`ServerBuilder::with_service`) — `POST /rpc` carries the client's calls, and
// each session's SSE stream (`GET /events`) carries the list's changes out to
// every subscribed tab. One chain, three claims on the port: the service's
// routes, the build's artifacts, and the page for everything else.

import std::build::require_build;
import std::document::require_shell;
import std::http::{ Response, Server };
import std::json::json_codec;
import std::print;
import std::rpc_server::Service;
import pkg::store::boot;

async fun main() {
	// What the build wrote for the browser leg: the bundle, and the stylesheet
	// its `const` styles emitted. Nothing here names a file or a content type —
	// `serve_build` installs one route per artifact in front of the page.
	let build = require_build("client");
	// Read once at boot, and CHECKED against that build: a `<link>` that no
	// longer matches the styles the build emitted — or a mount `<div id>` that
	// drifted from src/client.vl — stops the server here, naming the file and
	// the fix, rather than serving a page that renders wrong and looks right.
	let page = require_shell("src/app.html", build).html();

	// Reload, seed ids, subscribe persistence — the store's own lifecycle.
	let store = boot();

	Server::builder()
		.port(59386)
		.with_service(Service::new(store.dispatcher().into_protocol(json_codec())))
		.serve_build(build)
		.on_request(|request| Response::builder().set_header("Content-Type", "text/html").body(page).build())
		.on_start(|server| print(i"todo server: {server.url()} — open it in two tabs"))
		.build()
		.start();
}
