// The server entry: serve the browser leg's build, boot the store, and answer
// http + rpc on one port. Everything stateful lives in `pkg::store`, next to
// its database.

import std::build::require_build;
import std::fs;
import std::http::{ Response, build_handler };
import std::json::json_codec;
import std::print;
import std::rpc_server::serve_service;
import pkg::store::boot;

async fun main() {
	// The bundle and its stylesheet, as the build itself describes them: no
	// `dist/` path is spelled here, so renaming the leg cannot leave this file
	// compiling and the page blank.
	let build = require_build("client");
	let app_html = fs::read_file_to_str("src/app.html");

	let store = boot();

	serve_service(4600, store.dispatcher().into_protocol(json_codec()), build_handler(build, |request| Response::builder().set_header("Content-Type", "text/html").body(app_html).build()), |server| print(i"notes server listening on {server.url()}"));
}
