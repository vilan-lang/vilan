// The client entry: connect, restore the stored token, derive the route,
// and mount the screen. The mirror is read INSIDE the screen
// (`client.notes.or([])`): the subscription opens when the view mounts and
// closes when it unmounts, instead of living as long as the tab.
//
// `Signal`, `Result`/`Ok`/`Err` and `print` are ambient under the package's
// `prelude = "std::web"`, and `mount_root` is reached through the ambient MODULE
// `ui` — browser-only inside a module both layers declare, so the qualifier is
// what keeps a platform error at the call.

import std::json::json_codec;
import std::router::current_path;
import std::storage;
import pkg::routes::{ Route, parse };
import pkg::store::NotesClient;
import pkg::views::screen;

async fun main() {
	let token = Signal::new(storage::get("notes-token"));
	let route = current_path().map(parse);

	match NotesClient::connect("/", json_codec()) {
		Ok(let client) => {
			let _root = ui::mount_root("app", || screen(client, token, route));
		},
		Err(let error) => print(i"connect failed: {error.debug()}"),
	}
}
