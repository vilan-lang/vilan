// counter.vl — the smallest reactive component, on the explicit-dependency core.
//
// State is a `Signal`. A derived `Signal` (`count.derive(..)`) is a NEW reactive
// value whose dependency on `count` is STRUCTURAL — known the moment it's built,
// not discovered by running it. Bindings take a `Source`, not a tracking
// closure, so there is nothing to re-discover and an `await` can never hide a
// dependency.
//
// `Signal`, `view` and `View` are ambient: `prelude = "std::web"` in vilan.toml
// puts them in scope with no import, along with the MODULES `style` and `ui` —
// which is why the chain below writes `style::Display::Flex` and imports nothing
// for it. The prelude carries the module, not its members, so you
// qualify; importing the member `style` would SHADOW the module and take
// `style::Display` with it, so the builder is qualified too.
//
// error in every TYPE position, so `counter_card`'s return cannot be written


// Typed atomic styles (proposal/ui-styling.md): built inside `const`, so the
// rules land in app.css at build time; `.styled(..)` just sets the classes.
fun counter_card(): style::Style {
	style::style()
		.display(style::Display::Flex)
		.flex_direction(style::FlexDirection::Column)
		.gap(style::space(2))
		.padding(style::space(4))
		.background(style::Color::gray(50))
		.radius(style::space(2))
}

// A component is just a function returning the `View` subtree it owns.
fun counter(): View {
	let count = Signal::new(0);
	let card = const counter_card();

	view("section")
		.styled(card)
		.child(view("h2").text("Counter"))
		// `bind_text` binds to a `Source<str>`; derive one from `count`. The
		// i-string renders the number directly (host coercion).
		.child(view("p").bind_text(count.map(|n| i"Count: {n}")))
		.child(view("button").text("−").on("click", || count.set_with(|n| n - 1)))
		.child(view("button").text("+").on("click", || count.set_with(|n| n + 1)))
}
