// app.vl — the client entry. Components are ordinary functions returning a
// `View`, so an app is just composition: build the views and `mount` them.
//
// Both components build and run: the counter, and the todo list (`todos.vl`) now
// that `combine` (variadic generics), `bind_each`, and `show` are implemented.
//
// `ui` is a module the `std::web` prelude puts in scope (vilan.toml), so
// `ui::mount_root` needs no import. The prelude carries the module and not the
// member on purpose: `mount_root` exists only on the browser layer, and
// qualifying it keeps a node build's error at the call rather than at an import
// you never wrote.

import pkg::counter::counter;
import pkg::todos::todos;

fun main() {
	// Each root is a DISPOSAL BOUNDARY: everything the component binds
	// registers into it ambiently (proposal/ambient-owner.md §4). The
	// returned root owners would tear the components down; an app lets
	// them live.
	let counter_root = ui::mount_root("counter", || counter());
	let todos_root = ui::mount_root("todos", || todos());
}
