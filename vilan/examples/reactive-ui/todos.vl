// todos.vl — the fuller picture on the explicit-dependency core: derived signals
// (`derive`), a two-input dependency (`combine`), a reactive keyed list, and
// conditional rendering. The dependency graph is literally the combinator tree.
//
// `Signal`, `SignalCell`, `view` and `View` are ambient (`prelude = "std::web::prelude"`),
// so nothing below imports them — `SignalCell` travels with `Signal` precisely
// for the annotations and parameter types this file is full of. `format` and
// `combine` are NOT in the set and are imported by name: the prelude is a floor,
// not the module.

import std::display::format;
import std::reactive::combine;

export *;

// `each` reconciles by key and re-renders only CHANGED rows — `Todo`
// derives `PartialEq` so the reconciler can tell.
[derive(PartialEq)]
struct Todo {
	id: i32,
	label: str,
	done: bool,
}

fun todos(): View {
	// All state is plain signals. Value semantics means `set_with` hands the body
	// an owned copy of the current value to mutate and return.
	let items: SignalCell<List<Todo>> = Signal::new([]);
	let draft = Signal::new("");
	let filter = Signal::new("all"); // "all" | "active" | "done"
	let next_id = Signal::new(0);

	// `remaining` depends only on `items` — one input, so plain `derive`. The
	// result is a read-only `Source`; only the root `Signal`s above can be `set`.
	let remaining: SignalCell<i32> = items
		.derive(|list| {
			mut open = 0;
			for todo in list {
				if !todo.done {
					open = open + 1;
				}
			}
			open
		})
		.cell();

	// `visible` depends on BOTH `items` and `filter`. `combine` is variadic — it
	// takes a tuple of the dependencies (a `Signal` viewed as `.source()`) and
	// yields a `Source<(List<Todo>, str)>`; `derive` then maps the pair. The graph
	// is data: `visible` recomputes exactly when either input changes — no body is
	// run to "find" the dependencies.
	let visible: SignalCell<List<Todo>> = combine((items, filter))
		.derive(|(list, filter)| {
			mut shown: List<Todo> = [];
			for todo in list {
				let keep = filter == "all"
					|| (filter == "active" && !todo.done)
					|| (filter == "done" && todo.done);
				if keep {
					shown.push(todo);
				}
			}
			shown
		})
		.cell();

	let add = || {
		let label = draft.get(); // a one-shot SAMPLE — we want the value, not a dependency
		if label != "" {
			let id = next_id.get();
			next_id.set(id + 1);
			items.set_with(|list| {
				mut next = list;
				next.push(Todo { id, label, done = false });
				next
			});
			draft.set("");
		}
	};

	<section .class("todos")>
		<h2>"Todos"</h2>
		<div .class("row")>
			// `bind_value` is two-way: the input shows `draft` and writes it on input.
			<input placeholder("What needs doing?") .bind_value(draft) />
			<button .on("click", add)>"Add"</button>
		</div>
		<p>{remaining.derive(|n| format(n) + " remaining")}</p>
		<div .class("filters")>
			{filter_button(filter, "all", "All")}
			{filter_button(filter, "active", "Active")}
			{filter_button(filter, "done", "Done")}
		</div>
		// `each` renders one view per element, keyed by `Todo.id`, and
		// reconciles the DOM against `visible` as it changes.
		<ul>{each(visible, |todo| todo.id, |todo| todo_row(items, todo))}</ul>
		// `show` toggles VISIBILITY — the node stays mounted, state preserved.
		<p .class("empty") .show(visible.derive(|list| list.len() == 0))>"Nothing here 🎉"</p>
		// `when` mounts/unmounts CONTENT — a disposal boundary: the summary's
		// binding below exists only while something is done, and is disposed
		// (not just hidden) when the condition drops.
		{when(items.derive(|list| count_done(list) > 0), || {
			<p .class("summary")>{items.derive(|list| i"{count_done(list)} done")}</p>
		})}
	</section>
}

fun count_done(list: List<Todo>): i32 {
	mut done = 0;
	for todo in list {
		if todo.done {
			done += 1;
		}
	}
	done
}

// A filter button highlights itself when its value is the active filter — a
// single-dependency `derive` over `filter`.
fun filter_button(filter: SignalCell<str>, value: str, label: str): View {
	<button
		.bind_class(filter.derive(|current| if current == value { "active" } else { "" }))
		on:click(|| filter.set(value))
	>
		{label}
	</button>
}

// One row. `todo` is a plain value (a snapshot from `each`), so its styling
// is static for this render; toggling rebuilds `items`, which re-renders the row.
// It takes the shared `items` signal so the checkbox / remove button can update
// the list everyone reads from.
fun todo_row(items: SignalCell<List<Todo>>, todo: Todo): View {
	<li .class(if todo.done { "done" } else { "" })>
		<input type("checkbox") on:change(|| toggle(items, todo.id)) />
		<span>{todo.label}</span>
		<button .class("remove") on:click(|| remove(items, todo.id))>"✕"</button>
	</li>
}

fun toggle(items: SignalCell<List<Todo>>, id: i32) {
	items.set_with(|list| {
		mut next: List<Todo> = [];
		for todo in list {
			if todo.id == id {
				next.push(Todo { id = todo.id, label = todo.label, done = !todo.done });
			} else {
				next.push(todo);
			}
		}
		next
	});
}

fun remove(items: SignalCell<List<Todo>>, id: i32) {
	items.set_with(|list| {
		mut kept: List<Todo> = [];
		for todo in list {
			if todo.id != id {
				kept.push(todo);
			}
		}
		kept
	});
}
