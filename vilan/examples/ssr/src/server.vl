// The server: serve the browser leg's build and the HTML shell. On the page
// route it renders the app to markup with `render(app())` and splices it into the
// shell at the `<!--ssr-->` marker (proposal/ssr.md §1, §6b — the splice stays in
// user code, zero new std surface). The page arrives fully painted; `/client.js`
// carries the bundle that boots and replaces it, and `serve_build` is what puts
// it there — the bundle's name comes from the build, not from this file.

import std::build::require_build;
import std::fs;
import std::http::{ Request, Response, Server };
import std::print;
import std::ui::render;
import pkg::app::app;

async fun main() {
	// Read once at boot; the server runs from the project root (`vilan run .`).
	let build = require_build("client");
	let shell = fs::read_file_to_str("src/app.html");

	Server::builder()
		.port(8791)
		.serve_build(build)
		// Create, serialize, discard: a fresh `app()` is built and rendered per
		// request, its markup spliced into the shell. No effects, no
		// subscriptions, no owner survives the response.
		.on_request(|request| Response::builder().set_header("Content-Type", "text/html").body(shell.replace("<!--ssr-->", render(app()))).build())
		.on_start(|server| print("ssr example: http://localhost:8791/"))
		.build()
		.start();
}
