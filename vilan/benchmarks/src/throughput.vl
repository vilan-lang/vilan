// RPC round-trip throughput: sequential calls (each awaited — honest latency,
// no pipelining) over the in-process transport and over real HTTP on
// localhost, with the JSON and binary codecs side by side. Timings vary by
// machine; the report prints rates, not asserts.

import std::binary::binary_codec;
import std::http::{ Response, Server };
import std::io::panic;
import std::json::{ Json, json_codec };
import std::option::Option::{ None, Some };
import std::io::print;
import std::result::Result::{ Err, Ok, self };
import std::rpc::{
	Dispatcher,
	HttpTransport,
	RpcError,
	RpcOutcome,
	RpcProtocol,
	SocketDuplex,
	Transport,
	arg,
	call,
	connect_socket,
	decode_failed,
	local_rpc,
	reply,
};
import std::rpc_server::Service;
import std::shared::Shared;
import std::time::now_millis;
import std::wire::{ Codec, Serializer };
import pkg::report::{ rate, round, section };

fun add_protocol(codec: Codec): RpcProtocol {
	let total: Shared<i32> = Shared::new(0);
	Dispatcher::new()
		.on("add", |request| {
			let by: i32 = arg(request, 0);
			match decode_failed(request) {
				Some(let reason) => RpcOutcome::Failure(RpcError::Decode(reason)),
				None => {
					total.write() = total.read() + by;
					reply(total.read())
				},
			}
		})
		.into_protocol(codec)
}

// `calls` sequential round-trips over `transport`; returns elapsed ms.
fun drive<T: Transport>(transport: T, codec: Codec, calls: i32): f64 {
	let started = now_millis();
	mut index = 0;
	for index < calls {
		let one = 1;
		let outcome: Result<i32, RpcError> = call(transport, codec, "add", [
			|s: Serializer| one.describe(s),
		]);
		match outcome {
			Ok(let value) => {},
			Err(let error) => print(i"call failed: {error.to_json()}"),
		}
		index += 1;
	}
	now_millis() - started
}

fun run(finished: || void) {
	section("rpc round-trip throughput (sequential)");

	let local_calls = 2000;
	let local_json = drive(local_rpc(add_protocol(json_codec())), json_codec(), local_calls);
	print(i"in-process json: {local_calls} calls in {round(local_json)} ms -> {rate(local_calls, local_json)} calls/sec");
	let local_binary = drive(local_rpc(add_protocol(binary_codec())), binary_codec(), local_calls);
	print(i"in-process binary: {local_calls} calls in {round(local_binary)} ms -> {rate(local_calls, local_binary)} calls/sec");

	// Port 0 on every bind below: the OS picks a free port (E33 — a fixed
	// port collides with concurrent e2e legs under nextest), and each
	// `on_start` callback reads the real one back off `server` for its own
	// same-process client to dial. `[port]` lines let the harness confirm a
	// real port came back, not a stale literal. The no-op `on_connect`/
	// `on_disconnect` lifecycles keep the measurements sessionless — no
	// reactive session is registered per benchmark connection.
	let http_calls = 200;
	Server::builder()
		.port(0)
		.with_service(Service::new(add_protocol(json_codec()))
			.on_connect(|id, end| {})
			.on_disconnect(|id| {}))
		.on_start(|server| {
			let port = server.port();
			print(i"[port] {port}");
			let elapsed = drive(HttpTransport { url = i"http://localhost:{port}/rpc" }, json_codec(), http_calls);
			let average_us = round(elapsed * 1000.0 / http_calls);
			print(i"http json: {http_calls} calls in {round(elapsed)} ms -> {rate(http_calls, elapsed)} calls/sec ({average_us} us avg)");
			// The binary codec end-to-end over real HTTP rides the service's
			// byte-reading /rpc route; the next server's upgrade path then
			// serves the WebSocket-multiplexed measurement (json — the socket
			// transport multiplexes text frames).
			Server::builder()
				.port(0)
				.with_service(Service::new(add_protocol(binary_codec()))
					.on_connect(|id, end| {})
					.on_disconnect(|id| {}))
				.on_request(|request| Response::builder().code(404).body("benchmark").build())
				.on_start(|server| {
					let binary_port = server.port();
					print(i"[port] {binary_port}");
					let binary_elapsed = drive(HttpTransport { url = i"http://localhost:{binary_port}/rpc" }, binary_codec(), http_calls);
					let binary_average_us = round(binary_elapsed * 1000.0 / http_calls);
					print(i"http binary: {http_calls} calls in {round(binary_elapsed)} ms -> {rate(http_calls, binary_elapsed)} calls/sec ({binary_average_us} us avg)");
					Server::builder()
						.port(0)
						.with_service(Service::new(add_protocol(json_codec()))
							.on_connect(|id, end| {})
							.on_disconnect(|id| {}))
						.on_request(|request| Response::builder().code(404).body("benchmark").build())
						.on_start(|server| {
							let ws_port = server.port();
							print(i"[port] {ws_port}");
							let socket: SocketDuplex = match connect_socket(i"ws://localhost:{ws_port}") {
								Ok(let opened) => opened,
								Err(let reason) => panic(reason),
							};
							let ws_elapsed = drive(socket.transport(), json_codec(), http_calls);
							let ws_average_us = round(ws_elapsed * 1000.0 / http_calls);
							print(i"ws multiplex json: {http_calls} calls in {round(ws_elapsed)} ms -> {rate(http_calls, ws_elapsed)} calls/sec ({ws_average_us} us avg)");
							finished();
						})
						.build()
						.start();
				})
				.build()
				.start();
		})
		.build()
		.start();
}
