// Realtime fan-out over the real wire (SplitDuplex: SSE + POST): several
// sessions subscribed to one signal, one driver mutating it. Reports the
// per-session update-frame counts (deterministic) and the settle time from
// first mutation to every session having observed the final value.

import std::http::{ Response, Server };
import std::json::{ FromJson, Json, json_codec };
import std::option::Option::{ None, Some, self };
import std::io::print;
import std::reactive::{ Signal, Subscription };
import std::result::Result::{ Err, Ok, self };
import std::rpc::{
	DuplexEnd,
	DuplexTransport,
	HttpTransport,
	ReactiveClient,
	ReactiveServer,
	RemoteSource,
	SplitDuplex,
	bridge,
	connect_split,
};
import std::rpc_server::Service;
import std::shared::Shared;
import std::time::{ now_millis, sleep };
import std::wire::Frame;
import pkg::report::{ round, section };

let sessions: Shared<List<(i32, ReactiveServer)>> = Shared::new([]);

[service(Client)]
struct Board {
	count: Signal<i32>,
}

impl Board {
	[rpc]
	fun attach(self, connection: i32): i32 {
		mut channel = 0 - 1;
		for entry in sessions.read() {
			let (id, reactive) = entry;
			if id == connection {
				channel = reactive.expose(self.count);
			}
		}
		channel
	}

	[rpc]
	fun add(self, by: i32): i32 {
		self.count.set(self.count.get() + by);
		self.count.get()
	}
}

// A DuplexTransport shim counting inbound (server->client) frames.
struct CountingDuplex {
	inner: SplitDuplex,
	inbound: Shared<i32>,
}

impl CountingDuplex with DuplexTransport {
	fun send(self, frame: Frame) {
		self.inner.send(frame);
	}

	fun on_frame(self, handler: |Frame| void) {
		self.inner.on_frame(|frame| {
			self.inbound.write() = self.inbound.read() + 1;
			handler(frame);
		});
	}
}

struct Session {
	frames: Shared<i32>,
	last_seen: Shared<i32>,
	// The mirror's lease — disposed when the measurement is done, which
	// closes the channel (`Unsubscribe`) instead of leaving the server
	// forwarding to a session nobody reads.
	watching: Shared<Option<Subscription>>,
}

fun watch(base: str): Session {
	let split = connect_split(base);
	let frames: Shared<i32> = Shared::new(0);
	let counting = CountingDuplex { inner = split, inbound = frames };
	let reactive = ReactiveClient::new(bridge(counting), json_codec());
	let last_seen: Shared<i32> = Shared::new(0 - 1);
	let watching: Shared<Option<Subscription>> = Shared::new(None);
	let client = Client { transport = HttpTransport { url = i"{base}/rpc" }, codec = json_codec() };
	match client.attach(split.connection) {
		Ok(let channel) => {
			let mirror: RemoteSource<i32> = reactive.source(channel);
			watching.write() = Some(mirror.sub(|n| {
				last_seen.write() = n;
			}));
		},
		Err(let error) => print("attach failed"),
	}
	Session { frames = frames, last_seen = last_seen, watching = watching }
}

fun run(finished: || void) {
	section("realtime fan-out (sse + post, 3 sessions, 50 mutations)");
	let board = Board { count = Signal::new(0) };
	// Port 0 (E33 — a fixed port collides with concurrent e2e legs under
	// nextest): the OS picks a free one, and `on_start` reads it back for
	// the same-process client sessions below to dial.
	Server::builder()
		.port(0)
		.with_service(Service::new(board.dispatcher().into_protocol(json_codec()))
			.on_connect(|id, end| {
				sessions.write().push((id, ReactiveServer::new(end, json_codec())));
			})
			.on_disconnect(|id| {}))
		.on_request(|request| Response::builder().code(404).body("benchmark").build())
		.on_start(|server| {
			let port = server.port();
			print(i"[port] {port}");
			drive(port, finished);
		})
		.build()
		.start();
}

fun drive(port: i32, finished: || void) {
	let base = i"http://localhost:{port}";
	let alice = watch(base);
	let bob = watch(base);
	let carol = watch(base);
	sleep(200); // let the subscribe frames land
	let driver = Client { transport = HttpTransport { url = i"{base}/rpc" }, codec = json_codec() };

	let mutations = 50;
	let started = now_millis();
	mut index = 0;
	for index < mutations {
		let one = 1;
		match driver.add(one) {
			Ok(let value) => {},
			Err(let error) => print("add failed"),
		}
		index += 1;
	}
	// Poll until every session has observed the final value (or 5s).
	mut waited = 0;
	for (alice.last_seen.read() != mutations || bob.last_seen.read() != mutations || carol.last_seen.read() != mutations) && waited < 5000 {
		sleep(20);
		waited += 20;
	}
	let settled = now_millis() - started;
	print(i"per-session update frames: {alice.frames.read()} {bob.frames.read()} {carol.frames.read()} (subscribe + 1 per mutation)");
	print(i"all sessions settled at {mutations} after {round(settled)} ms ({round(settled * 1000.0 / mutations)} us per mutation fan-out)");
	// Done watching: release the three leases, which closes the channels.
	alice.watching.read()?.dispose();
	bob.watching.read()?.dispose();
	carol.watching.read()?.dispose();
	finished();
}
