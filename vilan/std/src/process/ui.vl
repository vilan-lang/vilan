// `std::ui` for `@process` — the server (SSR) view layer (proposal/ssr.md, A7). The
// exact public surface of the browser `std::ui`, but building an HTML STRING TREE
// instead of live DOM. A route handler calls the app's own view-building code — the
// same component functions the client runs — against this layer, `render(view)`
// serializes the tree to markup, and the handler splices it into its HTML shell.
// Create-serialize-discard: no effects, no subscriptions, no owner survives the
// request.
//
// READ-ONCE BINDINGS: `bind_text`/`bind_attr`/`bind_class`/`bind_value` embed
// the source's value AT RENDER TIME — no subscription is created (the value
// served is the value the data had). `each` renders the current list;
// `when`/`swap` render the taken branch. Event and draft binders ACCEPT AND
// DISCARD: a server-rendered `<button>` is just a button — its handler is
// client business.
//
// The read-only binders take a `Source<T>` bound rather than a concrete
// `SignalCell<T>` (A33), in LOCKSTEP with the browser twin — the same component
// source compiles through both layers, so a widening on one side that the other
// lacks would make a custom-source component client-only. `bind_value` and
// `bind_draft` stay concrete on both sides for the same reason: their browser
// halves write back.
//
// OMITTED (proposal/ssr.md §2, §6a): `mount`/`mount_root` do not exist here — a
// component that mounts is a client entry, not a renderable view; the natural
// factoring is a shared `fun app(): View` and a per-leg `main`. `std::dom` stays
// browser-only; a component importing it fails a process build at the `import` with
// the standard cross-platform error — the correct boundary.
//
// Only available when building for a process platform (node).

import pkg::compare::PartialEq;
import pkg::hash::Hashable;
import pkg::option::Option::{ self, None, Some };
import pkg::reactive::{
	Draft,
	Owner,
	Signal,
	SignalCell,
	Source,
	owner_scope,
	run_with_owner,
	turn_scope,
};
import pkg::shared::Shared;
import pkg::style::Style;

/// One attribute in an element's ordered attribute list. Ordering is INSERTION
/// ORDER — the component wrote them in code order — so serialization is
/// deterministic by construction (the differential relies on it).
export struct Attribute {
	name: str,
	value: str,
}

/// One child in an element's ordered child list — an element or a TEXT NODE. Text
/// children make mixed content real: prose interleaves with inline elements as
/// siblings, never through wrapper spans.
export enum Child {
	Element(View),
	Text(str),
}

/// A node under construction: an HTML element as a string tree. `View` carries
/// no owner — nothing survives the request — and its mutable parts are `Shared`,
/// so a `View` is a REFERENCE (like the browser's `Element`): chaining and
/// passing it share the one node rather than snapshotting it.
export struct View {
	tag: str,
	attributes: Shared<List<Attribute>>,
	children: Shared<List<Child>>,
	text: Shared<str>,
}

/// A fresh element of the given tag (`view("div")`, `view("button")`, …).
/// An `svg` root is seeded with its `xmlns` attribute, mirroring the browser
/// twin's `createElementNS` routing: the serialized markup then parses into
/// SVG-namespace nodes wherever it lands (descendants inherit the namespace,
/// so only the root needs it). A component setting `xmlns` itself simply
/// replaces the seed (`set_attribute` is set-or-replace by name). KEEP the
/// SVG tag story IN STEP with the browser twin's `is_svg_tag` allowlist
/// (browser/ui.vl) — the layer system shares no file between them.
export fun view(tag: str): View {
	let attributes: Shared<List<Attribute>> = Shared::new([]);
	if tag == "svg" {
		set_attribute(attributes, "xmlns", "http://www.w3.org/2000/svg");
	}
	View { tag, attributes, children = Shared::new([]), text = Shared::new("") }
}

/// Set-or-replace an attribute BY NAME, in place — mirrors the DOM's
/// `setAttribute`/`className`: a repeated name updates its value and keeps its
/// position; a new name appends. This is what makes attribute order insertion
/// order.
export fun set_attribute(attributes: Shared<List<Attribute>>, name: str, value: str) {
	mut updated: List<Attribute> = [];
	mut found = false;
	for attribute in attributes.read() {
		if attribute.name == name {
			updated.push(Attribute { name, value });
			found = true;
		} else {
			updated.push(attribute);
		}
	}
	if !found {
		updated.push(Attribute { name, value });
	}
	attributes.write() = updated;
}

/// Append one declaration to the element's `style` attribute, keeping whatever is
/// already there — the server end of writing an inline style, shared by `style_var`
/// and `show`.
fun add_style_declaration(attributes: Shared<List<Attribute>>, declaration: str) {
	mut current = "";
	for attribute in attributes.read() {
		if attribute.name == "style" {
			current = attribute.value;
		}
	}
	let next = if current == "" { declaration } else { current + ";" + declaration };
	set_attribute(attributes, "style", next);
}

export impl View {
	/// Static text content. Like the DOM's `textContent`, this REPLACES any
	/// children the node had.
	fun text(self, content: str): View {
		self.text.write() = content;
		self.children.write() = [];
		self
	}

	/// Static CSS class.
	fun class(self, name: str): View {
		set_attribute(self.attributes, "class", name);
		self
	}

	/// Classes from a compiled `Style` (`class_list` is runtime-legal — the rules
	/// were emitted when the style was constructed).
	fun styled(self, style: Style): View {
		set_attribute(self.attributes, "class", style.class_list());
		self
	}

	/// A CSS custom property, read once and folded into the `style` attribute — the
	/// server end of `width(Length::var("--w"))`. (No subscription: the value at
	/// render time is the value served.)
	fun style_var<S: Source<str>>(self, name: str, source: S): View {
		add_style_declaration(self.attributes, name + ":" + source.get());
		self
	}

	/// An attribute. The value's TYPE decides its life (proposal/element-syntax.md
	/// §5): a `str` sets once; a `SignalCell<str>` is read once, exactly
	/// `bind_attr`. Anything `AttrValue` fills the slot.
	fun attr<V: AttrValue>(self, name: str, value: V): View {
		value.apply(self, name);
		self
	}

	/// An event listener — ACCEPTED AND DISCARDED: a server-rendered element
	/// carries no handler wiring. Kept in the surface so the same component code
	/// compiles on both legs; the handler is the client's business.
	fun on(self, event: str, handler: (|| void) context turn_scope): View {
		self
	}

	/// Like `on`, but the handler receives the event. Accepted and discarded the
	/// same way. The event type is GENERIC (`E`) rather than the browser's
	/// `std::dom::Event`: a server layer cannot name that browser-only type, and a
	/// discarded handler never touches the event anyway — so any handler shape is
	/// accepted. (This is what lets a browser module like `std::router`, whose
	/// `link` binds an `on_event`, still resolve `std::ui` when the analyzer loads
	/// it to compute a process build's cross-platform requirements.)
	fun on_event<E>(self, event: str, handler: (|E| void) context turn_scope): View {
		self
	}

	/// Append content. Anything `Slot` fills a child position
	/// (proposal/element-syntax.md §5) — the CHILD CONTRACT (B268): a `View`
	/// appends as an element, a `str` as a text node, a `List<View>` appends each,
	/// and a `Source` of any of those three is READ ONCE, the value at render time
	/// being the value served.
	fun child<C: Slot>(self, content: C): View {
		content.place(self);
		self
	}

	/// Append several child views.
	fun children(self, items: List<View>): View {
		for item in items {
			self.children.write().push(Child::Element(item));
		}
		self
	}

	/// Reactive text content, READ ONCE: embeds `source`'s current value as text.
	/// No subscription — nothing to notify at serve time.
	fun bind_text<S: Source<str>>(self, source: S): View {
		self.text.write() = source.get();
		self.children.write() = [];
		self
	}

	/// Reactive CSS class, read once.
	fun bind_class<S: Source<str>>(self, source: S): View {
		set_attribute(self.attributes, "class", source.get());
		self
	}

	/// Reactive `Style`, read once: the style the signal holds at render time is
	/// the one served.
	fun bind_styled<S: Source<Style>>(self, source: S): View {
		set_attribute(self.attributes, "class", source.get().class_list());
		self
	}

	/// Reactive attribute, read once — and `Option`-valued sources are read once
	/// too (A105): `Some(text)` renders the attribute, `None` omits it entirely.
	/// There is no server counterpart to the browser twin's `remove_attribute`
	/// because nothing was written in the first place, which is `toggle_attr`'s
	/// arrangement exactly. KEEP IN STEP with the browser twin.
	fun bind_attr<V: AttrBinding>(self, name: str, source: V): View {
		source.bind_attribute(self, name);
		self
	}

	/// A boolean attribute, read once: rendered when `source` is currently true and
	/// absent when it is false (A66). Presence is the whole meaning, so there is
	/// nothing to render for the false case — the browser twin's `remove_attribute`
	/// has no server counterpart because the attribute was never written. KEEP IN
	/// STEP with the browser twin.
	fun toggle_attr<S: Source<bool>>(self, name: str, source: S): View {
		if source.get() {
			set_attribute(self.attributes, name, "");
		}
		self
	}

	/// A two-way input bind, server side: the input renders with its current value.
	/// The write-back listener is client business — accepted and dropped. Bounded
	/// on `Signal<str>`, matching the browser twin's write-back half (A32): it
	/// writes on the client, so it asks for the writable trait.
	fun bind_value<S: Signal<str>>(self, signal: S): View {
		set_attribute(self.attributes, "value", signal.get());
		self
	}

	/// A local-first editable field, server side: the input renders with the
	/// draft's current local value. The input listener is dropped.
	fun bind_draft(self, draft: Draft<str>): View {
		set_attribute(self.attributes, "value", draft.local.get());
		self
	}

	/// The element mount hook, server side: ACCEPTED AND DROPPED. There is no
	/// document to be in and no element to hand over — the server render
	/// creates, serializes and discards — so this returns `self` unchanged,
	/// exactly as the event binders do with their handlers. The parameter is
	/// generic for the same reason `on_event`'s is: a server layer cannot name
	/// the browser-only `std::dom::Element`. KEEP IN STEP with the browser
	/// twin (browser/ui.vl).
	fun on_mount<E>(self, action: sync |E| void): View {
		self
	}

	/// Focus, server side: nothing to focus. Dropped like `on_mount`, whose
	/// one-word form it is on the browser twin. KEEP IN STEP.
	///
	/// The browser twin also WRITES the `autofocus` attribute (A121 §6.1),
	/// and this deliberately does not: a served `autofocus` attribute is
	/// honored by the browser's own initial parse, which would focus the
	/// element before the client build ever ran — a real behaviour change to
	/// every server-rendered page that chains this, and a wider question than
	/// the focus scope that motivated the write. The client build sets it at
	/// mount either way.
	fun autofocus(self): View {
		self
	}

	/// Make this element a focus scope, server side: nothing is trapped and nothing
	/// is focused. Dropped like `autofocus` above, whose clock it shares on the
	/// browser twin. KEEP IN STEP.
	fun focus_scope(self, containment: FocusContainment): View {
		self
	}

	/// Show or hide on a condition, read once: a hidden element renders with the
	/// `hidden` attribute AND an inline `display:none`, exactly the two writes the
	/// browser twin makes (A60). The attribute alone does not hide anything an app
	/// styled, because the preflight's `[hidden]` rule is layered and a compiled
	/// `Style`'s rules are not — so serving the attribute alone would paint the
	/// element until the client's first toggle took it away. KEEP IN STEP with the
	/// browser twin.
	fun show<S: Source<bool>>(self, condition: S): View {
		if !condition.get() {
			set_attribute(self.attributes, "hidden", "");
			add_style_declaration(self.attributes, "display:none");
		}
		self
	}
}

/// A POSITIONAL REGION, server side: the parent and the position, with NO
/// ANCHOR — the marker node the browser twin plants renders as nothing here,
/// which is the whole of the SSR story for A71.
///
/// It reads as a no-op and is not one: it is the SERVER'S ANSWER to the browser
/// twin's anchor. The browser has to plant a node because its content arrives
/// LATER, after siblings the chain added further down; a server render is one
/// synchronous pass in source order, so the position a region opens at is still the
/// end of the parent when the content is written — appending IS inserting before
/// the anchor, and the served markup carries no marker for a client to trip over.
///
/// It is DECLARED here and not called from the methods below, deliberately. The
/// twin-surface gate (E34, `std_twin_parity.rs`) holds the two halves to one set of
/// names, so a `Region` in the browser twin is a `Region` here; and routing this
/// file's `when`/`swap`/`each` through it would change the bytes they emit — a
/// corpus golden — to say in a second way exactly what
/// `self.children.write().push(..)` already says. A85 (positional slots) is where
/// the server side grows a reason to call it: its value forms `place` into a region
/// on both twins. KEEP IN STEP with the browser twin's copy (browser/ui.vl).
export struct Region {
	parent: View,
}

/// One row of a run, server side: NOTHING. The browser twin's row is a leading
/// marker, because a row's content can be any `Slot` and can grow after it was
/// placed, so "move this row" has to be a span between markers (A91). A server
/// render is one pass in source order and nothing ever moves, so a row here is its
/// own position and the struct carries no state at all. KEEP IN STEP with the
/// browser twin's copy (browser/ui.vl).
export struct Row {}

export impl Region {
	/// Opens a region at `parent`'s current end.
	fun open(parent: View): Region {
		Region { parent }
	}

	/// Puts `child` at the end of the region.
	fun insert(self, child: View) {
		self.parent.children.write().push(Child::Element(child));
	}

	/// Places `content` as a new ROW (A91) — which, on this twin, is exactly
	/// placing it: a server render is one pass in source order, so a row IS
	/// wherever it was written and needs no marker to keep that place. The browser
	/// twin plants one, and `Row` is empty here for the same reason `Region` plants
	/// no anchor. KEEP IN STEP with the browser twin.
	[internal("the reconciler's own row bookkeeping; see `hold_rows`")]
	fun open_row<C: Slot>(self, content: C): Row {
		content.place(self.parent);
		Row {}
	}

	/// Places a row before another one — a server render writes in source order and
	/// never moves anything, so the position is `open_row`'s and the bound is
	/// dropped (A98). KEEP IN STEP with the browser twin.
	fun open_row_before<C: Slot>(self, content: C, end: Row): Row {
		self.open_row(content)
	}

	/// Cuts a row out of the document — there is no document to cut it out of,
	/// and nothing that ever moves. Accepted and dropped. KEEP IN STEP.
	[internal("the reconciler's own row bookkeeping; see `hold_rows`")]
	fun cut_row(self, row: Row, end: Row): Row {
		row
	}

	/// Puts a cut row back — see `cut_row`: nothing was ever taken out, and A98's
	/// `end` bound has nothing to bound. KEEP IN STEP.
	[internal("the reconciler's own row bookkeeping; see `hold_rows`")]
	fun insert_row(self, row: Row, content: Row, end: Row) {}

	/// Drops a row — a server render has no removal. KEEP IN STEP.
	[internal("the reconciler's own row bookkeeping; see `hold_rows`")]
	fun drop_row(self, row: Row) {}

	/// Records the live run — accepted and dropped, like the event binders'
	/// handlers. A88 exists because a browser boundary can be disposed while its
	/// parent survives; a server render has no disposal and no later change to
	/// survive, so there is nothing to remember. KEEP IN STEP with the browser twin
	/// (browser/ui.vl).
	fun hold(self, live: List<View>) {}

	/// Records the live ROWS — accepted and dropped, with `hold`. KEEP IN STEP.
	[internal("the reconciler's own row bookkeeping; see `hold_rows`")]
	fun hold_rows(self, rows: List<Row>) {}

	/// Drops the anchor — there is none to drop, and no live content to take out of
	/// a document that does not exist yet (A88). KEEP IN STEP.
	fun close(self) {}
}

/// Something that can fill a child position (proposal/element-syntax.md §5) — the
/// type-directed half of `child`: the value's type carries the static-vs-tracked
/// distinction; on this twin every arm reads once.
///
/// THE CHILD CONTRACT (B268), the same six arms the browser twin declares — a
/// `str`, a `View`, a `List<View>`, and a `Source` of each. The name stays `Slot`
/// and not `Child` for the reason this file makes plainest: `Child` is the ENUM
/// `render` walks, three declarations above. KEEP IN STEP with the browser twin's
/// copy (browser/ui.vl).
export trait Slot {
	fun place(self, parent: View);
}

/// A child element.
export impl View with Slot {
	fun place(self, parent: View) {
		parent.children.write().push(Child::Element(self));
	}
}

/// A static text node.
export impl str with Slot {
	fun place(self, parent: View) {
		parent.children.write().push(Child::Text(self));
	}
}

/// A text node, read once — the value at render time is the value served. A BLANKET
/// over the read trait (B158/B165), like the browser twin.
export impl type S: Source<str> with Slot {
	fun place(self, parent: View) {
		parent.children.write().push(Child::Text(self.get()));
	}
}

/// Several child elements, in order — the static run A46's fragment would lower to.
export impl List<View> with Slot {
	fun place(self, parent: View) {
		for item in self {
			parent.children.write().push(Child::Element(item));
		}
	}
}

/// A reactive element child, READ ONCE: the view the source holds at render time is
/// the one served (B268). The browser twin replaces it on every change — through a
/// `Region`, so the replacement keeps the hole's position (A71) — and here there is
/// no later change to follow, so the value is written at its position directly and
/// no anchor is served.
export impl type S: Source<View> with Slot {
	fun place(self, parent: View) {
		parent.children.write().push(Child::Element(self.get()));
	}
}

/// A reactive run of element children, read once — the `List<View>` arm's server
/// end, with the single-view arm's story above: the browser twin keeps the run in
/// place through a `Region`, and a one-pass render needs no anchor to do the same.
/// KEEP IN STEP with the browser twin.
export impl type S: Source<List<View>> with Slot {
	fun place(self, parent: View) {
		let items: List<View> = self.get();
		for item in items {
			parent.children.write().push(Child::Element(item));
		}
	}
}
// === The positional value forms (A85), server side =========================
//
// The browser twin's five value forms, read-once: `when`, `swap`, `each`,
// `each_values` and `each_by` are VALUES that fill a child position, and since
// A99 they are the whole surface — the `View` methods that were sugar over
// them are retired on both twins. A server render is one
// synchronous pass in source order, so a value placed in a child hole writes
// its content at exactly the point `place` runs — which is what the `Region`
// below has always said about the anchor the browser twin has to plant, and
// what A85 finally gives it a reason to be CALLED for.
//
// The closure FIELDS carry their `context` clause (B309) and not the `sync` marker
// (parameter-only), in lockstep with the browser twin: the same component source
// constructs these on both legs. KEEP IN STEP with the browser twin's copy
// (browser/ui.vl).

/// Conditional content as a child — the `when` slot value (A85/A99).
export struct Conditional<S: Source<bool>, C: Slot> {
	condition: S,
	body: (|| C) context owner_scope,
}

/// A dynamic subtree as a child — the `swap` slot value (A85/A99). No `gated`/`armed`
/// half: route chunks are a browser thing (nothing is ever in flight here), so
/// the server twin holds only what it renders.
export struct Swap<T: PartialEq, S: Source<T>, C: Slot> {
	source: S,
	render: (|T| C) context owner_scope,
}

/// A keyed reactive run as a child — the `each` slot value (A85/A99).
export struct Each<T: PartialEq, K: PartialEq + Hashable, S: Source<List<T>>, C: Slot> {
	source: S,
	key: |T| K,
	render: (|T| C) context owner_scope,
}

/// A run keyed by the ITEM ITSELF, as a child (A42).
export struct EachValues<T: PartialEq + Hashable, S: Source<List<T>>, C: Slot> {
	source: S,
	render: (|T| C) context owner_scope,
}

/// A run whose rows update through a cell, as a child (A42).
export struct EachBy<T, K: PartialEq + Hashable, S: Source<List<T>>, C: Slot> {
	source: S,
	key: |T| K,
	render: (|SignalCell<T>| C) context owner_scope,
}

/// Conditional content at THIS position, read once: the body renders when
/// `condition` is currently true and nothing when it is false.
export fun when<S: Source<bool>, C: Slot>(
	condition: S,
	body: (sync || C) context owner_scope,
): Conditional<S, C> {
	Conditional { condition, body }
}

/// The dynamic subtree at THIS position, read once: the branch for `source`'s
/// CURRENT value.
export fun swap<T: PartialEq, S: Source<T>, C: Slot>(
	source: S,
	render: (sync |T| C) context owner_scope,
): Swap<T, S, C> {
	Swap { source, render }
}

/// A keyed reactive run at THIS position, rendered from the current items.
export fun each<T: PartialEq, K: PartialEq + Hashable, S: Source<List<T>>, C: Slot>(
	source: S,
	key: sync |T| K,
	render: (sync |T| C) context owner_scope,
): Each<T, K, S, C> {
	Each { source, key, render }
}

/// A run keyed by the ITEM ITSELF, as a child (A42).
export fun each_values<T: PartialEq + Hashable, S: Source<List<T>>, C: Slot>(
	source: S,
	render: (sync |T| C) context owner_scope,
): EachValues<T, S, C> {
	EachValues { source, render }
}

/// A run whose rows update through a cell, as a child (A42).
export fun each_by<T, K: PartialEq + Hashable, S: Source<List<T>>, C: Slot>(
	source: S,
	key: sync |T| K,
	render: (sync |SignalCell<T>| C) context owner_scope,
): EachBy<T, K, S, C> {
	EachBy { source, key, render }
}

export impl Conditional<type S: Source<bool>, type C: Slot> with Slot {
	fun place(self, parent: View) {
		if self.condition.get() {
			let region = Region::open(parent);
			let owner = Owner::new();
			let _row = run_with_owner(owner, || region.open_row((self.body)()));
		}
	}
}

export impl Swap<type T: PartialEq, type S: Source<T>, type C: Slot> with Slot {
	fun place(self, parent: View) {
		place_swap(parent, self.source, self.render);
	}
}

export impl Each<type T: PartialEq, type K: PartialEq + Hashable, type S: Source<List<T>>, type C: Slot> with Slot {
	fun place(self, parent: View) {
		place_each(parent, self.source, self.key, self.render);
	}
}

export impl EachValues<type T: PartialEq + Hashable, type S: Source<List<T>>, type C: Slot> with Slot {
	fun place(self, parent: View) {
		place_each(parent, self.source, |item| item, self.render);
	}
}

export impl EachBy<type T, type K: PartialEq + Hashable, type S: Source<List<T>>, type C: Slot> with Slot {
	fun place(self, parent: View) {
		place_each_by(parent, self.source, self.key, self.render);
	}
}

/// `swap`'s body, server side — the branch for the current value, in position.
fun place_swap<T: PartialEq, S: Source<T>, C: Slot>(
	parent: View,
	source: S,
	render: (sync |T| C) context owner_scope,
) {
	let region = Region::open(parent);
	let value = source.get();
	let owner = Owner::new();
	let _row = run_with_owner(owner, || region.open_row(render(value)));
}

/// `each`'s body, server side — one child per element of the CURRENT list,
/// in order, no reconciliation. Each row runs under a fresh throwaway `Owner`:
/// `run_with_owner` establishes the `owner_scope` the injected `render` closure
/// declares, so this is self-contained — the caller need not establish any
/// boundary. Nothing a row registers survives, so the owner is discarded.
/// (`List<T>` is annotated so `get`'s element type resolves — the
/// two-parameter-generic inference trap.)
///
/// No op path (A112 S3): the browser twin follows a `DeltaSource`'s ops after its
/// first build, and a server render IS only a first build — it reads the list once
/// and never hears a change, so there is nothing for ops to say.
fun place_each<T: PartialEq, K: PartialEq + Hashable, S: Source<List<T>>, C: Slot>(
	parent: View,
	source: S,
	key: sync |T| K,
	render: (sync |T| C) context owner_scope,
) {
	let region = Region::open(parent);
	let items: List<T> = source.get();
	for item in items {
		let owner = Owner::new();
		let _row = run_with_owner(owner, || region.open_row(render(item)));
	}
}

/// `each_by`'s body, server side: one child per element of the CURRENT list, each
/// built against a fresh `SignalCell<T>` holding that element. No reconciliation
/// and no later change to follow, so the cell is written once and never again — but
/// it must exist, because `render` is the same closure the client runs.
fun place_each_by<T, K: PartialEq + Hashable, S: Source<List<T>>, C: Slot>(
	parent: View,
	source: S,
	key: sync |T| K,
	render: (sync |SignalCell<T>| C) context owner_scope,
) {
	let region = Region::open(parent);
	let items: List<T> = source.get();
	// The key is client business — it decides which row survives a change, and no
	// row here outlives the request. Accepted and dropped, like the event binders'
	// handlers.
	let _keyed = key;
	for item in items {
		let cell: SignalCell<T> = SignalCell::new(item);
		let owner = Owner::new();
		let _row = run_with_owner(owner, || region.open_row(render(cell)));
	}
}

/// Something that can fill an attribute value (proposal/element-syntax.md §5) —
/// what `<div name(value)>` desugars through (`.attr`, never `.bind_attr`). The
/// tracked arm is a BLANKET over `Source<str>` (B158/B165). KEEP IN STEP with the
/// browser twin's copy (browser/ui.vl).
export trait AttrValue {
	fun apply(self, parent: View, name: str);
}

/// Set once.
export impl str with AttrValue {
	fun apply(self, parent: View, name: str) {
		set_attribute(parent.attributes, name, self);
	}
}

/// Read once — exactly `bind_attr`, for every `Source<str>`.
export impl type S: Source<str> with AttrValue {
	fun apply(self, parent: View, name: str) {
		set_attribute(parent.attributes, name, self.get());
	}
}

/// Rendered only for a `Some` (A115): a `None` omits the attribute, which is the
/// server's whole answer to the browser twin's "write nothing".
export impl Option<str> with AttrValue {
	fun apply(self, parent: View, name: str) {
		match self {
			Some(let text) => set_attribute(parent.attributes, name, text),
			None => {},
		}
	}
}

/// Read once, rendered only for a `Some` (A115) — the twin of the browser's
/// removing arm. Nothing was written, so there is no `remove_attribute` to mirror,
/// which is `AttrBinding`'s arrangement exactly.
export impl type S: Source<Option<str>> with AttrValue {
	fun apply(self, parent: View, name: str) {
		match self.get() {
			Some(let text) => set_attribute(parent.attributes, name, text),
			None => {},
		}
	}
}

/// What `View::bind_attr` accepts (A105) — the twin of the browser's
/// `AttrBinding`, read once. `bind_attr` means "reactive attribute", so this
/// vocabulary is sources only and does not admit a static `str`; `AttrValue`
/// above is the element-syntax one and does.
/// KEEP IN STEP with the browser twin's copy (browser/ui.vl).
export trait AttrBinding {
	fun bind_attribute(self, parent: View, name: str);
}

/// Always present.
export impl type S: Source<str> with AttrBinding {
	fun bind_attribute(self, parent: View, name: str) {
		set_attribute(parent.attributes, name, self.get());
	}
}

/// Rendered only for a `Some`: a `None` omits the attribute, which is the server's
/// whole answer to the browser twin's `remove_attribute`.
export impl type S: Source<Option<str>> with AttrBinding {
	fun bind_attribute(self, parent: View, name: str) {
		match self.get() {
			Some(let text) => set_attribute(parent.attributes, name, text),
			None => {},
		}
	}
}

/// The HTML void elements: they render `<tag …>` with no closing tag, and children
/// are illegal — so any children of a void are dropped (a documented no-op;
/// components don't give voids children).
fun is_void_element(tag: str): bool {
	match tag {
		"area" => true,
		"base" => true,
		"br" => true,
		"col" => true,
		"embed" => true,
		"hr" => true,
		"img" => true,
		"input" => true,
		"link" => true,
		"meta" => true,
		"source" => true,
		"track" => true,
		"wbr" => true,
		_ => false,
	}
}

/// Escape a text node: `&`, `<`, `>` become entities (`&` FIRST so entities aren't
/// double-escaped). Renders `<script>` inert.
export fun escape_text(value: str): str {
	value.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
}

/// Escape a double-quoted attribute value: `&` and `"` become entities.
export fun escape_attribute(value: str): str {
	value.replace("&", "&amp;").replace("\"", "&quot;")
}

/// Serialize a `View` to HTML — the SSR entry point. No pretty-printing:
/// byte-stable output, attributes in insertion order, proper escaping, void
/// elements without a closing tag.
export fun render(view: View): str {
	mut out = "<" + view.tag;
	for attribute in view.attributes.read() {
		out = out + " " + attribute.name + "=\"" + escape_attribute(attribute.value) + "\"";
	}
	out = out + ">";
	if is_void_element(view.tag) {
		ret out;
	}
	out = out + escape_text(view.text.read());
	for child in view.children.read() {
		match child {
			Child::Element(let element) => {
				out = out + render(element);
			},
			Child::Text(let content) => {
				out = out + escape_text(content);
			},
		}
	}
	out + "</" + view.tag + ">"
}

/// The browser layer's route-chunk hooks, in their server form
/// (proposal/bundle-splitting.md §2/§S3). A server render is one pass over code
/// that is already loaded, so nothing is ever in flight and nothing can fail to
/// arrive: these are always `false` and `None`. They exist because
/// `std::router::pending`/`chunk_error` re-export them, and the two `ui` layers
/// declare the same surface — a component that binds one renders on both sides.
/// KEEP IN STEP with the browser twin (browser/ui.vl).
let chunk_pending_signal: SignalCell<bool> = SignalCell::new(false);
let chunk_error_signal: SignalCell<Option<str>> = SignalCell::new(None);

export fun chunk_pending(): SignalCell<bool> {
	chunk_pending_signal
}

export fun chunk_failure(): SignalCell<Option<str>> {
	chunk_error_signal
}

// === `when_some`: the conditional form that BINDS the value (A119) ==========
//
// The server twin: read once, and the body is handed a `SignalCell<T>` holding the
// current payload, so the SAME component source compiles on both legs (R6 at Order
// 39's GO — the browser twin's row survives a payload change through that cell, and
// there is nothing here for it to survive). KEEP IN STEP with the browser twin's
// copy (browser/ui.vl).

/// Content that exists while `source` is `Some`, with the payload bound — the
/// `when_some` slot value (A119).
export struct WhenSome<T, S: Source<Option<T>>, C: Slot> {
	source: S,
	render: (|SignalCell<T>| C) context owner_scope,
}

/// `Some`-conditional content at THIS position, read once: the body renders when
/// `source` currently holds a value and nothing when it is `None`. The body takes a
/// `SignalCell<T>` for the browser twin's reason (R6).
export fun when_some<T, S: Source<Option<T>>, C: Slot>(
	source: S,
	render: (sync |SignalCell<T>| C) context owner_scope,
): WhenSome<T, S, C> {
	WhenSome { source, render }
}

export impl WhenSome<type T, type S: Source<Option<T>>, type C: Slot> with Slot {
	fun place(self, parent: View) {
		place_when_some(parent, self.source, self.render);
	}
}

/// `when_some`'s body, server side — the body for the CURRENT payload, in position,
/// or nothing at all. A named helper beside `place_swap`'s and `place_each`'s,
/// which is also what keeps the two twins' surfaces in parity (`std_twin_parity`).
fun place_when_some<T, S: Source<Option<T>>, C: Slot>(
	parent: View,
	source: S,
	render: (sync |SignalCell<T>| C) context owner_scope,
) {
	match source.get() {
		Some(let payload) => {
			let region = Region::open(parent);
			let cell: SignalCell<T> = SignalCell::new(payload);
			let owner = Owner::new();
			let _row = run_with_owner(owner, || region.open_row(render(cell)));
		},
		None => {},
	}
}

// === A121: focus scopes, server side (proposal/focus-scope.md) ===============
//
// ACCEPTED AND DROPPED, exactly as `on_mount` and `autofocus` are: a server render
// has no focus to trap and no document to trap it in — the request creates,
// serializes and discards. The surface is declared name for name so the same
// component source compiles through both layers; the browser twin (browser/ui.vl)
// carries the mechanism and its reasoning. KEEP IN STEP.

/// What a focus scope does with a Tab that would leave it — the browser twin's
/// enum, declared here so a component that names an arm compiles on both legs.
export enum FocusContainment {
	/// A modal: Tab cycles, and focus that arrives elsewhere is pulled back.
	Contain,
	/// A menu: Tab cycles while focus is inside; anything else may leave.
	Wrap,
}

/// An installed focus scope, server side: an id and a latch, both inert. The
/// browser twin's handle also carries its root element, which a server layer cannot
/// name — a FIELD may differ between twins where a member may not, and nothing here
/// ever reads one.
export struct FocusScope {
	id: i32,
	focused: Shared<bool>,
}

export impl FocusScope {
	/// Take the initial focus, server side: there is none to take. `false` is also
	/// what the browser answers for a scope whose subtree holds nothing focusable,
	/// so a driver that retries on the next frame behaves the same on both legs —
	/// it simply has no next frame here. KEEP IN STEP.
	fun focus_initial(self): bool {
		false
	}
}

/// The scope stack, server side: nothing is ever pushed onto it. It is declared
/// rather than omitted because the twin surfaces are held name for name, and a name
/// that exists on one side only is the drift that gate exists to catch.
let focus_scopes: Shared<List<i32>> = Shared::new([]);

/// The id source, inert with the stack above.
let next_focus_scope: Shared<i32> = Shared::new(0);

/// The stack's two readers, answering the empty stack. They are what the browser
/// twin's two window listeners consult at event time; there are no events here.
fun focus_reaches_from(id: i32, target: i32): bool {
	false
}

fun topmost_contain_scope(): Option<i32> {
	None
}

/// Install a focus scope, server side: nothing is installed and nothing is focused.
/// The root is GENERIC for `on_mount`'s reason — a server layer cannot name the
/// browser-only `std::dom::Element` — and the handle it hands back answers `false`
/// from `focus_initial`, which is the same answer the browser gives for a scope
/// whose subtree holds nothing focusable.
export fun focus_scope<E>(root: E, containment: FocusContainment): FocusScope {
	let id = next_focus_scope.read() + 1;
	next_focus_scope.write() = id;
	FocusScope { id, focused = Shared::new(false) }
}
