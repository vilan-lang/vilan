// `std::ui` for `@process` — the server (SSR) view layer (proposal/ssr.md, A7).
// The exact public surface of the browser `std::ui`, but building an HTML
// STRING TREE instead of live DOM. A route handler calls the app's own
// view-building code — the same component functions the client runs — against
// this layer, `render(view)` serializes the tree to markup, and the handler
// splices it into its HTML shell. Create-serialize-discard: no effects, no
// subscriptions, no owner survives the request.
//
// READ-ONCE BINDINGS: `bind_text`/`bind_attr`/`bind_class`/`bind_value` embed
// the source's value AT RENDER TIME — no subscription is created (the value
// served is the value the data had). `bind_each` renders the current list;
// `when`/`swap` render the taken branch. Event and draft binders ACCEPT AND
// DISCARD: a server-rendered `<button>` is just a button — its handler is
// client business.
//
// The read-only binders take a `Source<T>` bound rather than a concrete
// `SignalCell<T>` (A33), in LOCKSTEP with the browser twin — the same component
// source compiles through both layers, so a widening on one side that the other
// lacks would make a custom-source component client-only. `bind_value` and
// `bind_draft` stay concrete on both sides for the same reason: their browser
// halves write back.
//
// OMITTED (proposal/ssr.md §2, §6a): `mount`/`mount_root` do not exist here — a
// component that mounts is a client entry, not a renderable view; the natural
// factoring is a shared `fun app(): View` and a per-leg `main`.
// `std::dom` stays browser-only; a component importing it fails a process build
// at the `import` with the standard cross-platform error — the correct boundary.
//
// Only available when building for a process platform (node).

import pkg::compare::PartialEq;
import pkg::option::Option::{ self, None };
import pkg::reactive::{
	Draft,
	Owner,
	Signal,
	SignalCell,
	Source,
	owner_scope,
	run_with_owner,
	turn_scope,
};
import pkg::shared::Shared;
import pkg::style::Style;

/// One attribute in an element's ordered attribute list. Ordering is INSERTION
/// ORDER — the component wrote them in code order — so serialization is
/// deterministic by construction (the differential relies on it).
struct Attribute {
	name: str,
	value: str,
}

/// One child in an element's ordered child list — an element or a TEXT NODE.
/// Text children make mixed content real: prose interleaves with inline
/// elements as siblings, never through wrapper spans.
enum Child {
	Element(View),
	Text(str),
}

/// A node under construction: an HTML element as a string tree. `View` carries
/// no owner — nothing survives the request — and its mutable parts are `Shared`,
/// so a `View` is a REFERENCE (like the browser's `Element`): chaining and
/// passing it share the one node rather than snapshotting it.
struct View {
	tag: str,
	attributes: Shared<List<Attribute>>,
	children: Shared<List<Child>>,
	text: Shared<str>,
}

/// A fresh element of the given tag (`view("div")`, `view("button")`, …).
/// An `svg` root is seeded with its `xmlns` attribute, mirroring the browser
/// twin's `createElementNS` routing: the serialized markup then parses into
/// SVG-namespace nodes wherever it lands (descendants inherit the namespace,
/// so only the root needs it). A component setting `xmlns` itself simply
/// replaces the seed (`set_attribute` is set-or-replace by name). KEEP the
/// SVG tag story IN STEP with the browser twin's `is_svg_tag` allowlist
/// (browser/ui.vl) — the layer system shares no file between them.
fun view(tag: str): View {
	let attributes: Shared<List<Attribute>> = Shared::new([]);
	if tag == "svg" {
		set_attribute(attributes, "xmlns", "http://www.w3.org/2000/svg");
	}
	View { tag, attributes, children = Shared::new([]), text = Shared::new("") }
}

/// Set-or-replace an attribute BY NAME, in place — mirrors the DOM's
/// `setAttribute`/`className`: a repeated name updates its value and keeps its
/// position; a new name appends. This is what makes attribute order insertion
/// order.
fun set_attribute(attributes: Shared<List<Attribute>>, name: str, value: str) {
	mut updated: List<Attribute> = [];
	mut found = false;
	for attribute in attributes.read() {
		if attribute.name == name {
			updated.push(Attribute { name, value });
			found = true;
		} else {
			updated.push(attribute);
		}
	}
	if !found {
		updated.push(Attribute { name, value });
	}
	attributes.write() = updated;
}

/// Append one declaration to the element's `style` attribute, keeping whatever
/// is already there — the server end of writing an inline style, shared by
/// `style_var` and `show`.
fun add_style_declaration(attributes: Shared<List<Attribute>>, declaration: str) {
	mut current = "";
	for attribute in attributes.read() {
		if attribute.name == "style" {
			current = attribute.value;
		}
	}
	let next = if current == "" { declaration } else { current + ";" + declaration };
	set_attribute(attributes, "style", next);
}

impl View {
	/// Static text content. Like the DOM's `textContent`, this REPLACES any
	/// children the node had.
	fun text(self, content: str): View {
		self.text.write() = content;
		self.children.write() = [];
		self
	}

	/// Static CSS class.
	fun class(self, name: str): View {
		set_attribute(self.attributes, "class", name);
		self
	}

	/// Classes from a compiled `Style` (`class_list` is runtime-legal — the
	/// rules were emitted when the style was constructed).
	fun styled(self, style: Style): View {
		set_attribute(self.attributes, "class", style.class_list());
		self
	}

	/// A CSS custom property, read once and folded into the `style` attribute —
	/// the server end of `width(Length::var("--w"))`. (No subscription: the
	/// value at render time is the value served.)
	fun style_var<S: Source<str>>(self, name: str, source: S): View {
		add_style_declaration(self.attributes, name + ":" + source.get());
		self
	}

	/// An attribute. The value's TYPE decides its life
	/// (proposal/element-syntax.md §5): a `str` sets once; a `SignalCell<str>` is
	/// read once, exactly `bind_attr`. Anything `AttrValue` fills the slot.
	fun attr<V: AttrValue>(self, name: str, value: V): View {
		value.apply(self, name);
		self
	}

	/// An event listener — ACCEPTED AND DISCARDED: a server-rendered element
	/// carries no handler wiring. Kept in the surface so the same component code
	/// compiles on both legs; the handler is the client's business.
	fun on(self, event: str, handler: (|| void) context turn_scope): View {
		self
	}

	/// Like `on`, but the handler receives the event. Accepted and discarded the
	/// same way. The event type is GENERIC (`E`) rather than the browser's
	/// `std::dom::Event`: a server layer cannot name that browser-only type, and a
	/// discarded handler never touches the event anyway — so any handler shape is
	/// accepted. (This is what lets a browser module like `std::router`, whose
	/// `link` binds an `on_event`, still resolve `std::ui` when the analyzer loads
	/// it to compute a process build's cross-platform requirements.)
	fun on_event<E>(self, event: str, handler: (|E| void) context turn_scope): View {
		self
	}

	/// Append content. Anything `Slot` fills a child position
	/// (proposal/element-syntax.md §5) — the CHILD CONTRACT (B268): a `View`
	/// appends as an element, a `str` as a text node, a `List<View>` appends
	/// each, and a `Source` of any of those three is READ ONCE, the value at
	/// render time being the value served.
	fun child<C: Slot>(self, content: C): View {
		content.place(self);
		self
	}

	/// Append several child views.
	fun children(self, items: List<View>): View {
		for item in items {
			self.children.write().push(Child::Element(item));
		}
		self
	}

	/// Reactive text content, READ ONCE: embeds `source`'s current value as
	/// text. No subscription — nothing to notify at serve time.
	fun bind_text<S: Source<str>>(self, source: S): View {
		self.text.write() = source.get();
		self.children.write() = [];
		self
	}

	/// Reactive CSS class, read once.
	fun bind_class<S: Source<str>>(self, source: S): View {
		set_attribute(self.attributes, "class", source.get());
		self
	}

	/// Reactive `Style`, read once: the style the signal holds at render time
	/// is the one served.
	fun bind_styled<S: Source<Style>>(self, source: S): View {
		set_attribute(self.attributes, "class", source.get().class_list());
		self
	}

	/// Reactive attribute, read once.
	fun bind_attr<S: Source<str>>(self, name: str, source: S): View {
		set_attribute(self.attributes, name, source.get());
		self
	}

	/// A boolean attribute, read once: rendered when `source` is currently true
	/// and absent when it is false (A66). Presence is the whole meaning, so
	/// there is nothing to render for the false case — the browser twin's
	/// `remove_attribute` has no server counterpart because the attribute was
	/// never written. KEEP IN STEP with the browser twin.
	fun toggle_attr<S: Source<bool>>(self, name: str, source: S): View {
		if source.get() {
			set_attribute(self.attributes, name, "");
		}
		self
	}

	/// A two-way input bind, server side: the input renders with its current
	/// value. The write-back listener is client business — accepted and dropped.
	/// Bounded on `Signal<str>`, matching the browser twin's write-back half
	/// (A32): it writes on the client, so it asks for the writable trait.
	fun bind_value<S: Signal<str>>(self, signal: S): View {
		set_attribute(self.attributes, "value", signal.get());
		self
	}

	/// A local-first editable field, server side: the input renders with the
	/// draft's current local value. The input listener is dropped.
	fun bind_draft(self, draft: Draft<str>): View {
		set_attribute(self.attributes, "value", draft.local.get());
		self
	}

	/// A reactive list, rendered from the CURRENT items — one child per element,
	/// in order, no reconciliation. Each row runs under a fresh throwaway
	/// `Owner`: `run_with_owner` establishes the `owner_scope` the injected
	/// `build` closure declares (the closure LITERAL defers, receiving the scope
	/// from `run_with_owner`), so this method is self-contained — the caller need
	/// not establish any boundary. Nothing a row registers survives, so the owner
	/// is discarded. (`List<T>` is annotated so `get`'s element type resolves —
	/// the two-parameter-generic inference trap.)
	fun bind_each<T: PartialEq, K: PartialEq, S: Source<List<T>>>(
		self,
		source: S,
		key: sync |T| K,
		build: (sync |T| View) context owner_scope,
	): View {
		// A85: one line of sugar over the value form, exactly as the browser
		// twin's is. KEEP IN STEP.
		self.child(each(source, key, build))
	}

	/// A reactive list keyed by the ITEM ITSELF, server side — the read-once
	/// twin of the browser's `bind_each_values` (A42). KEEP IN STEP.
	fun bind_each_values<T: PartialEq, S: Source<List<T>>>(
		self,
		source: S,
		build: (sync |T| View) context owner_scope,
	): View {
		self.child(each_values(source, build))
	}

	/// A reactive list whose rows update through a cell, server side: one child
	/// per element of the CURRENT list, each built against a fresh
	/// `SignalCell<T>` holding that element. No reconciliation and no later
	/// change to follow, so the cell is written once and never again — but it
	/// must exist, because `build` is the same closure the client runs.
	/// No bound on `T`, matching the browser twin. KEEP IN STEP.
	fun bind_each_by<T, K: PartialEq, S: Source<List<T>>>(
		self,
		source: S,
		key: sync |T| K,
		build: (sync |SignalCell<T>| View) context owner_scope,
	): View {
		self.child(each_by(source, key, build))
	}

	/// Conditional content: renders the body when `condition` is currently true,
	/// nothing when false. Read once — no toggling survives the request. The body
	/// runs under a throwaway owner, like `bind_each`'s rows.
	fun when<S: Source<bool>>(self, condition: S, body: (sync || View) context owner_scope): View {
		// A85: the VALUE is constructed here rather than through the free
		// `when`, because a method name shadows a module-level function of the
		// same name inside its own `impl` block. KEEP IN STEP.
		self.child(Conditional { condition, body })
	}

	/// The dynamic-subtree swap, server side: renders the branch for `source`'s
	/// CURRENT value. Read once — there is no later change to follow.
	/// A `Source<T>` bound, in lockstep with the browser twin's `swap` — held
	/// concrete by A33 for the bare-parameter bound gap, widened with it once
	/// B168 closed that gap.
	fun swap<T: PartialEq, S: Source<T>>(
		self,
		source: S,
		build: (sync |T| View) context owner_scope,
	): View {
		// A85: the literal, for the shadowing reason `when` above records.
		self.child(Swap { source, render = build })
	}

	/// The element mount hook, server side: ACCEPTED AND DROPPED. There is no
	/// document to be in and no element to hand over — the server render
	/// creates, serializes and discards — so this returns `self` unchanged,
	/// exactly as the event binders do with their handlers. The parameter is
	/// generic for the same reason `on_event`'s is: a server layer cannot name
	/// the browser-only `std::dom::Element`. KEEP IN STEP with the browser
	/// twin (browser/ui.vl).
	fun on_mount<E>(self, action: sync |E| void): View {
		self
	}

	/// Focus, server side: nothing to focus. Dropped like `on_mount`, whose
	/// one-word form it is on the browser twin. KEEP IN STEP.
	fun autofocus(self): View {
		self
	}

	/// Show or hide on a condition, read once: a hidden element renders with
	/// the `hidden` attribute AND an inline `display:none`, exactly the two
	/// writes the browser twin makes (A60). The attribute alone does not hide
	/// anything an app styled, because the preflight's `[hidden]` rule is
	/// layered and a compiled `Style`'s rules are not — so serving the
	/// attribute alone would paint the element until the client's first toggle
	/// took it away. KEEP IN STEP with the browser twin.
	fun show<S: Source<bool>>(self, condition: S): View {
		if !condition.get() {
			set_attribute(self.attributes, "hidden", "");
			add_style_declaration(self.attributes, "display:none");
		}
		self
	}
}

/// A POSITIONAL REGION, server side: the parent and the position, with NO
/// ANCHOR — the marker node the browser twin plants renders as nothing here,
/// which is the whole of the SSR story for A71.
///
/// It reads as a no-op and is not one: it is the SERVER'S ANSWER to the
/// browser twin's anchor. The browser has to plant a node because its content
/// arrives LATER, after siblings the chain added further down; a server render
/// is one synchronous pass in source order, so the position a region opens at
/// is still the end of the parent when the content is written — appending IS
/// inserting before the anchor, and the served markup carries no marker for a
/// client to trip over.
///
/// It is DECLARED here and not called from the methods below, deliberately.
/// The twin-surface gate (E34, `std_twin_parity.rs`) holds the two halves to
/// one set of names, so a `Region` in the browser twin is a `Region` here; and
/// routing this file's `when`/`swap`/`bind_each` through it would change the
/// bytes they emit — a corpus golden — to say in a second way exactly what
/// `self.children.write().push(..)` already says. A85 (positional slots) is
/// where the server side grows a reason to call it: its value forms `place`
/// into a region on both twins.
/// KEEP IN STEP with the browser twin's copy (browser/ui.vl).
struct Region {
	parent: View,
}

impl Region {
	/// Opens a region at `parent`'s current end.
	fun open(parent: View): Region {
		Region { parent }
	}

	/// Puts `child` at the end of the region.
	fun insert(self, child: View) {
		self.parent.children.write().push(Child::Element(child));
	}

	/// Records the live run — accepted and dropped, like the event binders'
	/// handlers. A88 exists because a browser boundary can be disposed while
	/// its parent survives; a server render has no disposal and no later
	/// change to survive, so there is nothing to remember. KEEP IN STEP with
	/// the browser twin (browser/ui.vl).
	fun hold(self, live: List<View>) {}

	/// Drops the anchor — there is none to drop, and no live content to take
	/// out of a document that does not exist yet (A88). KEEP IN STEP.
	fun close(self) {}
}

/// Something that can fill a child position (proposal/element-syntax.md §5) —
/// the type-directed half of `child`: the value's type carries the
/// static-vs-tracked distinction; on this twin every arm reads once.
///
/// THE CHILD CONTRACT (B268), the same six arms the browser twin declares — a
/// `str`, a `View`, a `List<View>`, and a `Source` of each. The name stays
/// `Slot` and not `Child` for the reason this file makes plainest: `Child` is
/// the ENUM `render` walks, three declarations above.
/// KEEP IN STEP with the browser twin's copy (browser/ui.vl).
trait Slot {
	fun place(self, parent: View);
}

/// A child element.
impl View with Slot {
	fun place(self, parent: View) {
		parent.children.write().push(Child::Element(self));
	}
}

/// A static text node.
impl str with Slot {
	fun place(self, parent: View) {
		parent.children.write().push(Child::Text(self));
	}
}

/// A text node, read once — the value at render time is the value served.
/// A BLANKET over the read trait (B158/B165), like the browser twin.
impl type S: Source<str> with Slot {
	fun place(self, parent: View) {
		parent.children.write().push(Child::Text(self.get()));
	}
}

/// Several child elements, in order — the static run A46's fragment would
/// lower to.
impl List<View> with Slot {
	fun place(self, parent: View) {
		for item in self {
			parent.children.write().push(Child::Element(item));
		}
	}
}

/// A reactive element child, READ ONCE: the view the source holds at render
/// time is the one served (B268). The browser twin replaces it on every
/// change — through a `Region`, so the replacement keeps the hole's position
/// (A71) — and here there is no later change to follow, so the value is
/// written at its position directly and no anchor is served.
impl type S: Source<View> with Slot {
	fun place(self, parent: View) {
		parent.children.write().push(Child::Element(self.get()));
	}
}

/// A reactive run of element children, read once — the `List<View>` arm's
/// server end, with the single-view arm's story above: the browser twin keeps
/// the run in place through a `Region`, and a one-pass render needs no anchor
/// to do the same. KEEP IN STEP with the browser twin.
impl type S: Source<List<View>> with Slot {
	fun place(self, parent: View) {
		let items: List<View> = self.get();
		for item in items {
			parent.children.write().push(Child::Element(item));
		}
	}
}
// === The positional value forms (A85), server side =========================
//
// The browser twin's five value forms, read-once: `when`, `swap`, `each`,
// `each_values` and `each_by` are VALUES that fill a child position, and the
// five `View` methods are one-line sugar over them. A server render is one
// synchronous pass in source order, so a value placed in a child hole writes
// its content at exactly the point `place` runs — which is what the `Region`
// below has always said about the anchor the browser twin has to plant, and
// what A85 finally gives it a reason to be CALLED for.
//
// The closure FIELDS carry their `context` clause (B309) and not the `sync`
// marker (parameter-only), in lockstep with the browser twin: the same
// component source constructs these on both legs.
// KEEP IN STEP with the browser twin's copy (browser/ui.vl).

/// Conditional content as a child — `View::when`'s value form.
struct Conditional<S: Source<bool>> {
	condition: S,
	body: (|| View) context owner_scope,
}

/// A dynamic subtree as a child — `View::swap`'s value form. No `gated`/`armed`
/// half: route chunks are a browser thing (nothing is ever in flight here), so
/// the server twin holds only what it renders.
struct Swap<T: PartialEq, S: Source<T>> {
	source: S,
	render: (|T| View) context owner_scope,
}

/// A keyed reactive run as a child — `View::bind_each`'s value form.
struct Each<T: PartialEq, K: PartialEq, S: Source<List<T>>> {
	source: S,
	key: |T| K,
	render: (|T| View) context owner_scope,
}

/// A run keyed by the ITEM ITSELF, as a child (A42).
struct EachValues<T: PartialEq, S: Source<List<T>>> {
	source: S,
	render: (|T| View) context owner_scope,
}

/// A run whose rows update through a cell, as a child (A42).
struct EachBy<T, K: PartialEq, S: Source<List<T>>> {
	source: S,
	key: |T| K,
	render: (|SignalCell<T>| View) context owner_scope,
}

/// Conditional content at THIS position, read once: the body renders when
/// `condition` is currently true and nothing when it is false.
fun when<S: Source<bool>>(condition: S, body: (sync || View) context owner_scope): Conditional<S> {
	Conditional { condition, body }
}

/// The dynamic subtree at THIS position, read once: the branch for `source`'s
/// CURRENT value.
fun swap<T: PartialEq, S: Source<T>>(
	source: S,
	render: (sync |T| View) context owner_scope,
): Swap<T, S> {
	Swap { source, render }
}

/// A keyed reactive run at THIS position, rendered from the current items.
fun each<T: PartialEq, K: PartialEq, S: Source<List<T>>>(
	source: S,
	key: sync |T| K,
	render: (sync |T| View) context owner_scope,
): Each<T, K, S> {
	Each { source, key, render }
}

/// A run keyed by the ITEM ITSELF, as a child (A42).
fun each_values<T: PartialEq, S: Source<List<T>>>(
	source: S,
	render: (sync |T| View) context owner_scope,
): EachValues<T, S> {
	EachValues { source, render }
}

/// A run whose rows update through a cell, as a child (A42).
fun each_by<T, K: PartialEq, S: Source<List<T>>>(
	source: S,
	key: sync |T| K,
	render: (sync |SignalCell<T>| View) context owner_scope,
): EachBy<T, K, S> {
	EachBy { source, key, render }
}

impl Conditional<type S: Source<bool>> with Slot {
	fun place(self, parent: View) {
		if self.condition.get() {
			let region = Region::open(parent);
			let owner = Owner::new();
			region.insert(run_with_owner(owner, self.body));
		}
	}
}

impl Swap<type T: PartialEq, type S: Source<T>> with Slot {
	fun place(self, parent: View) {
		place_swap(parent, self.source, self.render);
	}
}

impl Each<type T: PartialEq, type K: PartialEq, type S: Source<List<T>>> with Slot {
	fun place(self, parent: View) {
		place_each(parent, self.source, self.key, self.render);
	}
}

impl EachValues<type T: PartialEq, type S: Source<List<T>>> with Slot {
	fun place(self, parent: View) {
		place_each(parent, self.source, |item| item, self.render);
	}
}

impl EachBy<type T, type K: PartialEq, type S: Source<List<T>>> with Slot {
	fun place(self, parent: View) {
		place_each_by(parent, self.source, self.key, self.render);
	}
}

/// `swap`'s body, server side — the branch for the current value, in position.
fun place_swap<T: PartialEq, S: Source<T>>(
	parent: View,
	source: S,
	render: (sync |T| View) context owner_scope,
) {
	let region = Region::open(parent);
	let value = source.get();
	let owner = Owner::new();
	region.insert(run_with_owner(owner, || render(value)));
}

/// `bind_each`'s body, server side — one child per element of the CURRENT list,
/// in order, no reconciliation. Each row runs under a fresh throwaway `Owner`:
/// `run_with_owner` establishes the `owner_scope` the injected `render` closure
/// declares, so this is self-contained — the caller need not establish any
/// boundary. Nothing a row registers survives, so the owner is discarded.
/// (`List<T>` is annotated so `get`'s element type resolves — the
/// two-parameter-generic inference trap.)
fun place_each<T: PartialEq, K: PartialEq, S: Source<List<T>>>(
	parent: View,
	source: S,
	key: sync |T| K,
	render: (sync |T| View) context owner_scope,
) {
	let region = Region::open(parent);
	let items: List<T> = source.get();
	for item in items {
		let owner = Owner::new();
		region.insert(run_with_owner(owner, || render(item)));
	}
}

/// `bind_each_by`'s body, server side: one child per element of the CURRENT
/// list, each built against a fresh `SignalCell<T>` holding that element. No
/// reconciliation and no later change to follow, so the cell is written once
/// and never again — but it must exist, because `render` is the same closure
/// the client runs.
fun place_each_by<T, K: PartialEq, S: Source<List<T>>>(
	parent: View,
	source: S,
	key: sync |T| K,
	render: (sync |SignalCell<T>| View) context owner_scope,
) {
	let region = Region::open(parent);
	let items: List<T> = source.get();
	// The key is client business — it decides which row survives a change, and
	// no row here outlives the request. Accepted and dropped, like the event
	// binders' handlers.
	let _keyed = key;
	for item in items {
		let cell: SignalCell<T> = SignalCell::new(item);
		let owner = Owner::new();
		region.insert(run_with_owner(owner, || render(cell)));
	}
}

/// Something that can fill an attribute value (proposal/element-syntax.md §5) —
/// what `<div name(value)>` desugars through (`.attr`, never `.bind_attr`).
/// The tracked arm is a BLANKET over `Source<str>` (B158/B165).
/// KEEP IN STEP with the browser twin's copy (browser/ui.vl).
trait AttrValue {
	fun apply(self, parent: View, name: str);
}

/// Set once.
impl str with AttrValue {
	fun apply(self, parent: View, name: str) {
		set_attribute(parent.attributes, name, self);
	}
}

/// Read once — exactly `bind_attr`, for every `Source<str>`.
impl type S: Source<str> with AttrValue {
	fun apply(self, parent: View, name: str) {
		set_attribute(parent.attributes, name, self.get());
	}
}

/// The HTML void elements: they render `<tag …>` with no closing tag, and
/// children are illegal — so any children of a void are dropped (a documented
/// no-op; components don't give voids children).
fun is_void_element(tag: str): bool {
	match tag {
		"area" => true,
		"base" => true,
		"br" => true,
		"col" => true,
		"embed" => true,
		"hr" => true,
		"img" => true,
		"input" => true,
		"link" => true,
		"meta" => true,
		"source" => true,
		"track" => true,
		"wbr" => true,
		_ => false,
	}
}

/// Escape a text node: `&`, `<`, `>` become entities (`&` FIRST so entities
/// aren't double-escaped). Renders `<script>` inert.
fun escape_text(value: str): str {
	value.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
}

/// Escape a double-quoted attribute value: `&` and `"` become entities.
fun escape_attribute(value: str): str {
	value.replace("&", "&amp;").replace("\"", "&quot;")
}

/// Serialize a `View` to HTML — the SSR entry point. No pretty-printing:
/// byte-stable output, attributes in insertion order, proper escaping, void
/// elements without a closing tag.
fun render(view: View): str {
	mut out = "<" + view.tag;
	for attribute in view.attributes.read() {
		out = out + " " + attribute.name + "=\"" + escape_attribute(attribute.value) + "\"";
	}
	out = out + ">";
	if is_void_element(view.tag) {
		ret out;
	}
	out = out + escape_text(view.text.read());
	for child in view.children.read() {
		match child {
			Child::Element(let element) => {
				out = out + render(element);
			},
			Child::Text(let content) => {
				out = out + escape_text(content);
			},
		}
	}
	out + "</" + view.tag + ">"
}

/// The browser layer's route-chunk hooks, in their server form
/// (proposal/bundle-splitting.md §2/§S3). A server render is one pass over code
/// that is already loaded, so nothing is ever in flight and nothing can fail to
/// arrive: these are always `false` and `None`. They exist because
/// `std::router::pending`/`chunk_error` re-export them, and the two `ui` layers
/// declare the same surface — a component that binds one renders on both sides.
/// KEEP IN STEP with the browser twin (browser/ui.vl).
let chunk_pending_signal: SignalCell<bool> = SignalCell::new(false);
let chunk_error_signal: SignalCell<Option<str>> = SignalCell::new(None);

fun chunk_pending(): SignalCell<bool> {
	chunk_pending_signal
}

fun chunk_failure(): SignalCell<Option<str>> {
	chunk_error_signal
}
