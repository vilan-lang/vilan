// `std::fs` — minimal async filesystem access over `node:fs/promises`. The raw
// bindings are `async` (promise-returning host functions), so calls to them are
// implicitly awaited.
//
// Error posture (F13, fullstack-dx.md §9.3): every call here throws host-side
// on ANY failure — a missing path is treated the same as a permissions error,
// exactly `read_file_to_str`'s posture from before this file grew — with TWO
// named exceptions, both of which are non-throwing because the OPERATION means
// something a missing path already satisfies:
//
//   `stat`            — a probe. It exists to let a caller ask "is this here
//                       yet, and what does it look like" (dev-refresh.md
//                       §2(i)'s mtime-revalidating poller is the motivating
//                       customer), so a missing path is `None`, not a throw.
//   `remove_dir_all`  — "make sure this is gone". A path that was never there
//                       already satisfies it, so a missing one is a no-op
//                       (`{ force: true }`, which is what the host option
//                       means).
//
// Any OTHER failure of either — a permissions error, a busy directory — still
// throws. Every other function in this module has the throwing posture, and a
// caller who wants to branch on absence probes with `stat` first.
//
// Everything here is asynchronous — nothing in this module blocks. The last
// synchronous entry (`exists`, bound to `existsSync`) was DELETED with the
// handle slice (kolt.local 031 Q3, ruled 2026-08-27): its justification named
// a category ("boot code") rather than a caller, all three of its callers were
// already async, and `stat(path).is_some()` answers strictly more.
// proposal/filesystem.md §4 is the standing rule — a sync variant of an async
// operation must name the caller that cannot suspend, in a form a later
// reader can look up and find missing in one grep.

import pkg::bytes::Bytes;
import pkg::crypto::random_uuid;
import pkg::drop::Drop;
import pkg::option::Option::{ None, Some, self };
import pkg::task::{ CancelSignal, ambient_signal };

/// Reads a file, decoded as text under `encoding` (a `node:fs` encoding name —
/// `"utf8"`, `"latin1"`, …). Renamed off `read_file_bytes` (2026-08-11, F13):
/// that name promised bytes and delivered a decoded string — the exact
/// survey-flagged lie. No deprecated alias kept (pre-1.0; the sole caller was
/// `read_file_to_str`, updated in the same commit — `numeric-types.md` §8's
/// precedent for a rename that fixes a wrong name).
[extern("node:fs/promises", "readFile")]
async external fun read_file_encoded(path: str, encoding: str): str;

/// Reads a whole file's raw bytes — the binary read F13 asked for. `readFile`
/// called with NO encoding argument hands back a host `Buffer`, which IS a
/// `Uint8Array` (runtime-verified: `buffer instanceof Uint8Array` is `true`),
/// so it binds directly to `Bytes` with no conversion — the same interop
/// `std::http`'s `read_request_bytes` already relies on.
[extern("node:fs/promises", "readFile")]
async external fun read_bytes(path: str): Bytes;

[extern("node:fs/promises", "writeFile")]
async external fun write_file(path: str, contents: str): void;

/// Writes raw bytes to `path`, creating it or truncating what was there — the
/// missing mirror of `read_bytes`, and the reason it was missing is worth
/// recording: `writeFile` was bound once, typed `(path, contents: str)`, so
/// from F13 (which added the binary read) until now bytes could come IN and
/// never go OUT. A program could read a favicon and could not write one back.
/// The host `writeFile` accepts a `Uint8Array` argument directly, and `Bytes`
/// IS one, so this is the same host function bound at its other argument type
/// — exactly how `read_bytes` and `read_file_encoded` share `readFile`.
///
/// The bytes reach the file unchanged: no encode, no decode, no replacement
/// character. That is not a small promise — a text round trip through UTF-8
/// turned kolt's 483-byte favicon into 853 bytes served, one U+FFFD per byte
/// that was not a legal sequence.
[extern("node:fs/promises", "writeFile")]
async external fun write_bytes(path: str, contents: Bytes): void;

/// Reads a UTF-8 text file to a string. Async (it awaits `readFile`), so callers
/// implicitly await it.
fun read_file_to_str(path: str): str {
	read_file_encoded(path, "utf8")
}

// --- atomic replace ------------------------------------------------------

/// Renames (moves) `from` to `to`, replacing `to` if it already exists.
/// WITHIN one filesystem this is atomic: a reader of `to` sees either the old
/// file or the new one, never a mix. ACROSS filesystems the host raises
/// `EXDEV` and nothing moves — which is why `write_atomic` below keeps its
/// temporary a SIBLING of its target rather than putting it in a temp dir.
[extern("node:fs/promises", "rename")]
async external fun rename(from: str, to: str): void;

/// Writes `contents` to `path` atomically: into a uniquely-named sibling
/// first, then `rename` over the target. A crash at any point leaves either
/// the previous file intact or the complete new one — never the truncated
/// half-write a plain `write_file` leaves behind, which is how a JSON store
/// silently loses everything on the next boot that reads it back and finds it
/// corrupt (proposal/filesystem.md §2 traces that failure end to end).
///
/// ATOMIC, NOT DURABLE. After a power loss the rename may not have reached the
/// device. Durability needs `fsync`, which the host exposes only on an open
/// file handle — `File::open(path)` then `file.sync()`, below
/// (proposal/filesystem.md §5.2).
///
/// The temporary is uniquely named because concurrent writers must not share
/// one, so a crash can leave a `<path>.<uuid>.tmp` file behind: `vilan` has no
/// `try`/`catch` to clean it up on the failing path. That is the right trade —
/// a stray temporary is recoverable by hand, a torn target is not.
fun write_atomic(path: str, contents: str) {
	let unique = random_uuid();
	let temporary = i"{path}.{unique}.tmp";
	write_file(temporary, contents);
	rename(temporary, path);
}

/// `write_atomic` for bytes: the same uniquely-named sibling and the same
/// `rename` over the target, so an image, a font or a wasm module replaces its
/// predecessor whole or not at all. Everything `write_atomic`'s comment says
/// about atomicity, durability and the stranded temporary applies here word
/// for word — the only difference is which of the two `writeFile` bindings
/// stages the temporary.
fun write_bytes_atomic(path: str, contents: Bytes) {
	let unique = random_uuid();
	let temporary = i"{path}.{unique}.tmp";
	write_bytes(temporary, contents);
	rename(temporary, path);
}

// --- the other whole-path writes -----------------------------------------

/// Appends `contents` to the end of `path`, creating the file if it is not
/// there yet. Unlike `write_file` this never truncates, which makes it the
/// right call for a log and the wrong call for a store: an append is NOT
/// atomic, and a crash partway through leaves a partial line behind. There is
/// no `append_bytes` twin — nothing in the tree or in kolt has asked for one,
/// and §9's rule for this module is to bind a host call when something needs
/// it rather than to fill in the grid.
[extern("node:fs/promises", "appendFile")]
async external fun append(path: str, contents: str): void;

/// Copies the file at `from` to `to`, replacing `to` if it exists. Copies a
/// FILE only: `copyFile` on a directory raises `EISDIR`, and `copy_dir` below
/// is the directory form. The copy is not atomic — a reader watching `to` can
/// observe it partially written — so a destination something else reads back
/// wants `copy` to a temporary plus `rename`, which is `write_atomic`'s shape
/// spelled out by hand.
[extern("node:fs/promises", "copyFile")]
async external fun copy(from: str, to: str): void;

/// Removes the FILE at `path` (`unlink`). A directory raises host-side
/// (`EPERM` or `EISDIR` depending on the platform) rather than being removed:
/// `remove_dir` and `remove_dir_all` below are the directory forms, and the
/// split is the host's, kept rather than papered over. A missing path throws,
/// matching every other operation in this module except `stat` — probe with
/// `stat(path).is_some()` first if a missing file is an ordinary outcome.
[extern("node:fs/promises", "unlink")]
async external fun remove(path: str): void;

/// Reads `path` as UTF-8 text, hands it to `revise`, and writes what comes
/// back atomically. The read-modify-write every JSON store and every config
/// rewrite is made of, with the replace half already correct: a crash inside
/// `revise` leaves the previous file untouched, and a crash during the write
/// leaves the previous file or the complete new one.
///
/// NOT a lock, and the difference matters. Two processes calling `update` on
/// one path can still interleave read-read-write-write, and the second write
/// wins whole — the first revision is lost, silently. `update` closes the
/// TEARING window, not the racing one; the host cannot close the racing one
/// without advisory locking, which node has no access to
/// (proposal/filesystem.md §9). For a single writer — which is what a store,
/// a cache and a config all are — this is the complete answer.
///
/// `revise` is a plain value-returning closure, so it is asyncness-polymorphic
/// (async-polymorphism.md): a revision that itself awaits makes this instance
/// of `update` await too, with nothing to write at either the declaration or
/// the call site.
fun update(path: str, revise: |str| str) {
	let current = read_file_to_str(path);
	write_atomic(path, revise(current));
}

/// Lists a directory's immediate entries by NAME ONLY (files and
/// subdirectories alike, NOT path-joined — an entry is a bare name, and what
/// addresses it is `path::join(directory, name)`), in whatever order the host
/// filesystem hands them back (NOT guaranteed alphabetical or otherwise
/// stable across platforms). Until kolt.local 017 this comment read "join
/// with `path` yourself" and named a module that did not exist; `std::path`
/// is now that module. Deliberately flat
/// (F13): no recursion here — `read_dir_all` below walks the whole tree in
/// one call — and no dirent-kind distinction: a caller that needs to know
/// file vs. directory calls `scan_dir`, which gets the kind back from the same
/// host call for free. Throws host-side on a missing or unreadable directory,
/// matching `read_file_to_str`'s posture above.
[extern("node:fs/promises", "readdir")]
async external fun read_dir(path: str): List<str>;

/// Lists EVERY entry under `path` — files and subdirectories alike, however
/// deep — as paths RELATIVE to `path` (`"sub/c.txt"`, joined with the host's
/// own separator, so backslashes on Windows), in whatever order the host's
/// traversal hands them back (NOT guaranteed depth-first, alphabetical, or
/// stable across platforms — `read_dir`'s honesty, recursively). No
/// dirent-kind distinction here either: a subdirectory is one more entry, and
/// a caller that needs file vs. directory calls `scan_dir` per level. There is
/// deliberately no recursive `scan_dir`: the host DOES combine `recursive`
/// with `withFileTypes`, but a `Dirent` from that call carries only a BASENAME
/// plus a separate `parentPath`, so making it useful means joining the two —
/// path work this module has no business doing (`std::path` owns it as of
/// kolt.local 017, and proposal/filesystem.md §9's seam holds: `std::fs`
/// produces and consumes plain `str` paths and takes no position on how they
/// are built). One honesty note now that a path module exists: the entries
/// above carry the HOST separator, so on Windows they are backslash-joined
/// and `std::path` — which is `/`-only on every platform, by design — will
/// read such an entry as a single component. Splitting a Windows
/// `read_dir_all` result is the caller's problem until someone needs it.
/// Rides `readdir`'s `{ recursive: true }` option — an option object the extern
/// binding forms cannot spell, so the call is host-side glue
/// (`__fs_read_dir_all`, `transformer.rs`, the same seam as `__fs_stat`).
/// Throws host-side on a missing or unreadable directory, matching
/// `read_dir`.
[extern("__fs_read_dir_all")]
async external fun read_dir_all(path: str): List<str>;

// --- directories ---------------------------------------------------------

/// A host options object — the `{ recursive: true }` / `{ force: true }` /
/// `{ withFileTypes: true }` argument several `node:fs/promises` calls take as
/// their last parameter. It is a plain host `{}` built up through setters, not
/// a vilan struct, exactly like `std::fetch`'s `RequestInit`, and each wrapper
/// below sets only the keys its own host call reads.
///
/// Worth recording, because the paper this module is growing under
/// (proposal/filesystem.md §3.1) predicted otherwise: an options object needs
/// NO host glue. `read_dir_all` reaches for `__fs_read_dir_all` in
/// `transformer.rs` for its one `{ recursive: true }`, and the paper carried
/// that forward as a seam every options-taking function would have to ride.
/// It is not one. `[extern("Object")]` mints a fresh `{}` and `[extern(set,
/// …)]` fills it in — both forms already existed, both are ordinary vilan, and
/// `fetch.vl` has been building `RequestInit` this way the whole time. So the
/// five wrappers below are plain vilan over direct bindings and this lane
/// touches `transformer.rs` not at all; `__fs_read_dir_all` is now the odd one
/// out rather than the precedent, and could be retired the same way whenever
/// someone is in that file for another reason.
external struct FsOptions;

/// `Object()` returns a fresh empty `{}` to fill in.
[extern("Object")]
external fun new_fs_options(): FsOptions;

impl FsOptions {
	[extern(set, "recursive")]
	external fun set_recursive(self, value: bool);

	[extern(set, "force")]
	external fun set_force(self, value: bool);

	[extern(set, "withFileTypes")]
	external fun set_with_file_types(self, value: bool);
}

/// Creates the directory `path`. ONE level: the parent must already exist
/// (`ENOENT` otherwise), and an existing `path` raises `EEXIST` rather than
/// succeeding quietly — `create_dir_all` is the forgiving form. Keeping the
/// strict one is deliberate: "make exactly this directory, and tell me if
/// something is already there" is how a process claims a name, and it is the
/// only exclusive-create primitive this module has until the handle tier's
/// `create_new` lands (proposal/filesystem.md §3.3).
[extern("node:fs/promises", "mkdir")]
async external fun create_dir(path: str): void;

[extern("node:fs/promises", "mkdir")]
async external fun mkdir_with(path: str, options: FsOptions): void;

/// Creates `path` and every missing directory above it, and succeeds when the
/// whole chain is already there — `mkdir -p`. Idempotent BY DESIGN, which is
/// the one thing separating it from `create_dir`: this is the call for "make
/// sure this place exists before I write into it", and that operation has no
/// business failing because it already ran.
fun create_dir_all(path: str) {
	let options = new_fs_options();
	options.set_recursive(true);
	mkdir_with(path, options)
}

/// Removes the EMPTY directory `path`. A non-empty directory raises
/// `ENOTEMPTY` and a missing one `ENOENT` — `remove_dir_all` is the recursive
/// form. The strict version is worth having for the same reason `create_dir`
/// is: it refuses to destroy anything you did not know was there.
[extern("node:fs/promises", "rmdir")]
async external fun remove_dir(path: str): void;

[extern("node:fs/promises", "rm")]
async external fun rm_with(path: str, options: FsOptions): void;

/// Removes `path` and everything under it — `rm -rf`, and it deletes a plain
/// file just as readily as a tree.
///
/// THE ONE OTHER NON-THROWING CALL IN THIS MODULE, and the exception is
/// deliberate rather than inherited: a missing `path` is a no-op, not an
/// `ENOENT`, because `{ force: true }` is what the host option means and
/// because the operation's actual meaning is "make sure this is gone", which a
/// path that was never there already satisfies. That is `stat`'s reasoning
/// (this file's header) applied to a destructive call instead of a probing
/// one. Every other failure — a permissions error, a busy directory — still
/// throws. If you need to know whether something WAS there, `stat` first.
fun remove_dir_all(path: str) {
	let options = new_fs_options();
	options.set_recursive(true);
	options.set_force(true);
	rm_with(path, options)
}

[extern("node:fs/promises", "cp")]
async external fun cp_with(from: str, to: str, options: FsOptions): void;

/// Copies the directory `from` to `to`, whole tree included, creating `to` and
/// any missing parents. Files already at the destination are OVERWRITTEN (the
/// host's `cp` defaults `force` to true and this does not override it), and
/// entries under `to` that have no counterpart under `from` are left alone —
/// so this is a merge-and-replace, not a mirror. Not atomic: a reader watching
/// `to` sees the tree appear entry by entry.
///
/// The host call is `fs.promises.cp`, which reached stable in node 22.3; on an
/// older node it works and prints one `ExperimentalWarning` to stderr.
fun copy_dir(from: str, to: str) {
	let options = new_fs_options();
	options.set_recursive(true);
	cp_with(from, to, options)
}

/// One directory entry with its kind — the information `read_dir` discards.
///
/// Three booleans rather than an enum, and the reason is that a host dirent
/// has NINE kinds: file, directory, symlink, FIFO, socket, block device,
/// character device, and unknown. An enum would either model five variants no
/// vilan program will ever meet, or carry a catch-all meaning "one of five
/// things I did not model". Three booleans answer the three questions anyone
/// actually asks and stay honest about not being exhaustive: an entry that is
/// none of the three — a FIFO, a socket, a device node — reads back with all
/// three `false`, which is a true statement about it rather than a wrong one.
///
/// The kinds do NOT follow symlinks (the host dirent carries `lstat`
/// information). A symlink to a directory is `is_symlink = true` with
/// `is_directory = false` — verified against the host, and the reason
/// `is_symlink` is in the struct at all despite symlinks being a non-goal for
/// this module: a recursive walker that cannot see a link is a walker that
/// eventually loops. To learn what a link points at, `stat` it — `stat` DOES
/// follow.
struct Entry {
	name: str,
	is_directory: bool,
	is_file: bool,
	is_symlink: bool,
}

/// The raw host `Dirent`. Kept opaque and internal, exactly like `RawStat`
/// below — `scan_dir` copies the four fields into a plain `Entry`, so no
/// caller touches the host shape.
external struct RawEntry;

impl RawEntry {
	[extern(get, "name")]
	external fun name(self): str;

	[extern(method, "isDirectory")]
	external fun is_directory(self): bool;

	[extern(method, "isFile")]
	external fun is_file(self): bool;

	[extern(method, "isSymbolicLink")]
	external fun is_symlink(self): bool;
}

[extern("node:fs/promises", "readdir")]
async external fun raw_scan_dir(path: str, options: FsOptions): List<RawEntry>;

/// Lists a directory's immediate entries WITH their kinds — `read_dir`'s
/// names, plus the answer to "what is each of these". Flat, like `read_dir`,
/// and in the same unpromised host order (sort if order matters). Throws
/// host-side on a missing or unreadable directory.
///
/// This exists because the alternative costs a syscall per entry for
/// information the host already had: `read_dir` then `stat` on each name is a
/// thousand extra stats on a thousand-entry directory, and `read_dir`'s own
/// comment sends callers to do exactly that. `readdir { withFileTypes: true }`
/// hands the kind back with the name, for free.
fun scan_dir(path: str): List<Entry> {
	let options = new_fs_options();
	options.set_with_file_types(true);
	let raw = raw_scan_dir(path, options);
	raw.map(|entry| Entry { name = entry.name(), is_directory = entry.is_directory(), is_file = entry.is_file(), is_symlink = entry.is_symlink() })
}

// --- stat --------------------------------------------------------------

/// The raw host `fs.Stats` object (`node:fs/promises` `stat`). Kept opaque
/// and internal — `stat` below copies the three fields v1 needs into a plain
/// `Stat`, so no caller touches the host shape directly.
external struct RawStat;

impl RawStat {
	[extern(get, "size")]
	external fun size(self): i32;

	/// Milliseconds since the epoch, as an ordinary (fractional) number.
	/// `fs.Stats` only yields a `BigInt` here under the `{ bigint: true }`
	/// stat option, which this binding never passes — runtime-verified: a
	/// plain stat's `mtimeMs` is `typeof "number"`, not `"bigint"`.
	[extern(get, "mtimeMs")]
	external fun mtime_ms(self): f64;

	[extern(method, "isDirectory")]
	external fun is_directory(self): bool;
}

/// A path's metadata: byte size, last-modified time (milliseconds since the
/// epoch), and whether it names a directory.
struct Stat {
	size: i32,
	modified_at_ms: f64,
	is_directory: bool,
}

/// `fs.promises.stat(path)`, wrapped so a missing path reads back `None`
/// (`ENOENT`) instead of throwing; every other failure (permissions, …)
/// still throws. `vilan` has no `try`/`catch`, so the ENOENT-to-`None`
/// translation is host-side glue (`__fs_stat`, `transformer.rs`) — the same
/// "`Option` array form" convention `std::process::env` and `Database.first`
/// already use at this boundary.
[extern("__fs_stat")]
async external fun raw_stat(path: str): Option<RawStat>;

/// Probes `path`: `None` if nothing exists there yet, `Some(stat)` otherwise.
fun stat(path: str): Option<Stat> {
	match raw_stat(path) {
		Some(let raw) => Some(Stat { size = raw.size(), modified_at_ms = raw.mtime_ms(), is_directory = raw.is_directory() }),
		None => None,
	}
}

// --- the handle tier (kolt.local 031 S3, proposal/filesystem.md §3.2) -----

/// An open file (`node:fs/promises`' `FileHandle`). A `resource`: it moves
/// rather than copies, a stale binding is a compile error rather than an
/// `EBADF`, and its `Drop` (below) closes the underlying host handle at the
/// owner's scope end — `drop(file)` is the early form, and there is no
/// `close()` to forget or to call twice. A module-level `File` is
/// process-lifetime, loan-only, and never drops.
///
/// The handle is what makes a read-then-act sequence TOCTOU-free: `stat`,
/// `read_at` and `write_at` address the OPEN FILE, not the path, so nothing
/// re-resolves between the probe and the act — a rename or removal of the
/// path changes nothing about what this handle reads.
///
/// Two container rules worth meeting here rather than in a diagnostic
/// (destruction.md R9/R10): a closure cannot capture a `File` (`with_file`
/// below hands the body its file as a per-call parameter instead), and
/// `List`/`Map`/`Set` cannot hold one — `Option<File>` is the sanctioned
/// container, so "a pool of open files" is not expressible in v1.
resource external struct File;

/// The raw host open. Kept behind the five named constructors: node's flags
/// string is an untyped eleven-member enum whose failure mode is a runtime
/// `EINVAL`, and a typo in it is a typo the compiler cannot see — each
/// constructor says in its name what it does to a file that already exists,
/// which is the only thing anyone ever looks up
/// (proposal/filesystem.md §3.3).
[extern("node:fs/promises", "open")]
async external fun open_with_flags(path: str, flags: str): File;

/// One `FileHandle.read()` result (`{ bytesRead, buffer }`). Opaque and
/// internal, exactly like `RawStat`: `read_at` copies the one field out, so
/// no caller touches the host shape.
external struct RawReadResult;

impl RawReadResult {
	[extern(get, "bytesRead")]
	external fun bytes_read(self): i32;
}

/// One `FileHandle.write()` result (`{ bytesWritten, buffer }`).
external struct RawWriteResult;

impl RawWriteResult {
	[extern(get, "bytesWritten")]
	external fun bytes_written(self): i32;
}

impl File {
	/// Opens `path` for reading (host mode `"r"`). The path must exist —
	/// `ENOENT` otherwise, matching the module's throwing posture; probe with
	/// `stat` first if absence is an ordinary outcome.
	fun open(path: str): File {
		open_with_flags(path, "r")
	}

	/// Creates `path` for writing, truncating anything already there (host
	/// mode `"w"`) — the handle form of `write_file`'s posture.
	fun create(path: str): File {
		open_with_flags(path, "w")
	}

	/// Creates `path` for writing and FAILS (`EEXIST`) if anything is already
	/// there (host mode `"wx"`) — the exclusive create: how one process
	/// claims a name without racing another, and the second reading of
	/// "write atomically" (`write_atomic` above is the first). The primitive
	/// a lockfile package would be built from.
	fun create_new(path: str): File {
		open_with_flags(path, "wx")
	}

	/// Opens `path` for appending, creating it if missing (host mode `"a"`).
	/// HOST SEMANTICS, kept rather than papered over: every write through an
	/// append handle lands at the END of the file — `write_at`'s position is
	/// IGNORED on this handle (POSIX `O_APPEND`).
	fun append_to(path: str): File {
		open_with_flags(path, "a")
	}

	/// Opens `path` for reading AND writing without truncating it (host mode
	/// `"r+"`). The path must exist — the mode for editing in place.
	fun modify(path: str): File {
		open_with_flags(path, "r+")
	}

	[extern(method, "read")]
	async external fun raw_read(self, buffer: Bytes, offset: i32, length: i32, position: i53): RawReadResult;

	[extern(method, "write")]
	async external fun raw_write(self, buffer: Bytes, offset: i32, length: i32, position: i53): RawWriteResult;

	/// Reads into `buffer` from byte `position` of the file; returns the
	/// number of bytes actually read — `buffer.len()` at most, fewer near the
	/// end of the file, `0` at end of file. Short reads are normal and are
	/// not an error.
	///
	/// Positional and stateless BY DESIGN: a `File` has no cursor, so two
	/// loans of one handle cannot silently interleave through hidden
	/// host-side position state — which is why the host's implicit-position
	/// read mode is deliberately not bound (proposal/filesystem.md §3.4).
	fun read_at(self, buffer: Bytes, position: i53): i32 {
		self.raw_read(buffer, 0, buffer.len(), position).bytes_read()
	}

	/// Writes all of `buffer` at byte `position` of the file (extending it if
	/// the write reaches past the end); returns the number of bytes written.
	/// Positional and stateless, like `read_at` — and on an `append_to`
	/// handle the position is ignored (see there).
	fun write_at(self, buffer: Bytes, position: i53): i32 {
		self.raw_write(buffer, 0, buffer.len(), position).bytes_written()
	}

	[extern(method, "stat")]
	async external fun raw_handle_stat(self): RawStat;

	/// This open file's metadata — `stat(path)` without the path, so there is
	/// no missing-path case and no `Option`: the handle addresses the open
	/// file itself, and a rename or removal of the path in between changes
	/// nothing about what is measured.
	fun stat(self): Stat {
		let raw = self.raw_handle_stat();
		Stat {
			size = raw.size(),
			modified_at_ms = raw.mtime_ms(),
			is_directory = raw.is_directory(),
		}
	}

	/// Truncates the file to `length` bytes — or extends it, zero-filled.
	[extern(method, "truncate")]
	async external fun truncate(self, length: i53): void;

	/// Flushes this file's data AND metadata to the storage device (`fsync`)
	/// — the durability primitive, and a capability nothing path-addressed in
	/// this module has: `write_atomic` is atomic but not durable, and this is
	/// what closes that gap (proposal/filesystem.md §5.2).
	[extern(method, "sync")]
	async external fun sync(self): void;

	/// `fdatasync` — flushes the data only, not the metadata timestamps: the
	/// cheaper sync for a log whose contents are all that matters.
	[extern(method, "datasync")]
	async external fun data_sync(self): void;
}

/// Closes the underlying host handle — the one host operation with no public
/// surface. Reachable only from `File`'s `Drop` below, so there is no
/// `close()` to fall out of sync with the destructor; `drop(file)` is the
/// early form. THE ONE `File` EXCEPTION to destruction.md §5's "drop is
/// synchronous": `FileHandle.close()` returns a promise a destructor cannot
/// await, so the drop INITIATES the close without awaiting it — ruled
/// 2026-08-27 (kolt.local 031 Q1: (a)+(c), scoped to `File` ALONE, not a
/// general license for async teardown). What that costs, honestly: data
/// already written is safe (a resolved `write_at` was handed to the OS) and
/// the process cannot exit under a pending close, but the close's ERROR is
/// unobservable here (the glue reports it to stderr), and dropping a handle
/// then immediately re-opening or unlinking its path races the descriptor's
/// release — benign on POSIX, not always on Windows. `with_file` below is
/// the spelling in which the close is awaited and a failure observable.
[extern("__fs_close")]
external fun close_handle(file: File): void;

impl File with Drop {
	/// Runs at the owner's scope end (or at an explicit `drop(file)`):
	/// initiates the close through the `&mut self` loan. Synchronous and
	/// context-free, as a destructor must be — the close itself completes in
	/// the background (see `close_handle`).
	fun drop(&mut self) {
		close_handle(self);
	}
}

/// `with_file`'s close — AWAITED, unlike the destructor's, so a failure to
/// close is a failure of `with_file` itself. Not a public `close()`: a free
/// function the completion list never offers on a `File`, with `with_file`
/// as its one caller.
[extern("__fs_close_awaited")]
async external fun close_awaited(file: File): void;

/// Opens `path` for reading, runs `body` with the open file, closes it, and
/// hands back what `body` returned — with the close AWAITED, which the
/// destructor's close deliberately is not (kolt.local 031 Q1's ruling): the
/// documented idiom for handle use, and the only spelling in which a failure
/// to close is observable.
///
/// The file arrives as `body`'s PARAMETER — per-call, not a capture — which
/// is why a closure can be handed a resource at all (destruction.md R9). And
/// `body` is a plain value-returning closure, so it is asyncness-polymorphic
/// (async-polymorphism.md): a body that awaits makes that `with_file` await
/// too, with nothing to write at either site. Should `body` throw, the
/// scope-end `Drop` still closes the handle — the safety net behind the
/// awaited path; the host close is idempotent, so the net stays benign when
/// both run.
fun with_file<T>(path: str, body: |File| T): T {
	let file = File::open(path);
	let result = body(file);
	close_awaited(file);
	result
}

// --- the watch tier (kolt.local 020, which owns this surface whole) --------
//
// THE MECHANISM IS POLLING, deliberately, and this is the load-bearing choice
// in the tier. `node:fs`'s own `watch` is the least portable thing the host
// exposes: its events coalesce and also duplicate, its `"rename"` covers
// creation, deletion and actual renaming with no way to tell which without a
// `stat`, recursive watching is not available on every platform and every
// version, macOS can report a null filename, and an `fs.watch` on a path that
// does not exist yet throws instead of waiting for it. A watcher built on it
// could therefore promise only "something changed under here, go look" — which
// is why the design sketch this tier replaces (filesystem.md §8) had a
// two-variant `ChangeKind { Changed, Renamed }`: an under-promise calibrated
// to what every platform agrees on.
//
// Comparing two stats instead promises MORE, on every platform, for free: an
// entry present now and absent before was Created, absent now and present
// before was Removed, and one whose size or mtime moved was Modified. Nothing
// is coalesced into an ambiguity and nothing is platform-conditional. It is
// also the choice the compiler made for its own `--watch` loop
// (proposal/watch-mode.md: "a dependency-free poll ... every ~300 ms ... If
// trees ever grow enough to matter, swapping in an event-based watcher is a
// localized change behind the same loop"), which has run that way since
// 2026-07-02.
//
// What polling costs, stated rather than hidden: latency up to one interval
// before a change is seen; a change that CANCELS OUT inside one interval (a
// file created and deleted between two observations) is never reported at all,
// because there is nothing left to compare; a rewrite that alters NEITHER the
// size NOR the mtime is invisible, which is a real risk only where mtime is
// second-granular (some filesystems still are — the size is compared as well
// precisely because it is the half that never has granularity); and one `stat`
// per watched entry per interval, which on a recursive watch of a large tree
// is real syscall load. Watch the narrowest path that answers your question.

/// A live watch on a path — the tier's resource, built on `File`'s model
/// exactly (`Database` before it): it moves rather than copies, so a stale
/// watcher is a compile error; a closure cannot capture one and no
/// `List`/`Map`/`Set` can hold one (destruction.md R9/R10); and its `Drop`
/// stops the watch at the owner's scope end. There is no public `stop()` to
/// fall out of sync with the destructor — `drop(watcher)` is the early form.
///
/// UNLIKE `File`, ITS TEARDOWN IS GENUINELY SYNCHRONOUS. Stopping a poll is a
/// `clearTimeout`, so `Drop` needs none of `File`'s async-close exception
/// (kolt.local 031 Q1, which was ruled for `File` ALONE); destruction.md §5's
/// "drop is synchronous in v1" holds here with nothing asked of it. This is
/// `Database`'s situation, not `File`'s.
///
/// The stop is not decoration: a watcher polls on a host timer, and a pending
/// host timer KEEPS THE PROCESS ALIVE — exactly as `std::time::Timer`
/// documents for itself. A watcher that is never dropped is a program that
/// never exits.
resource external struct Watcher;

/// What happened to a path between two observations. Three variants and no
/// catch-all, because comparing two stats leaves no fourth possibility — the
/// opposite call from `Entry`'s three booleans above, and for the opposite
/// reason: a host dirent has NINE open-ended kinds, while a change is a closed
/// three-way outcome the poller computes itself.
///
/// A rename arrives as `Removed` on the old path plus `Created` on the new
/// one, in the same batch. That is what a rename IS to an observer comparing
/// two directory listings, and it is strictly more than node's `fs.watch`
/// reports (one `"rename"` event, sometimes only for one of the two paths).
///
/// An ordinary (unbacked) enum: the host poller hands its verdict across in
/// the `Option` ARRAY FORM this module already uses at every other host
/// boundary (`__fs_stat`, `__db_get`, `std::process::env`), so nothing has to
/// leak a meaningless integer identity into a public type to get it here.
enum ChangeKind {
	Created,
	Modified,
	Removed,
}

/// One observed change: the path it happened to, and which of the three
/// things it was.
///
/// `path` is ADDRESSABLE — the watched root joined with the entry's place
/// under it, so it is exactly the string to hand to `read_file_to_str`,
/// `stat` or `File::open`, with no joining at the call site. (`read_dir` and
/// `read_dir_all` hand back bare names and relative paths because a listing's
/// caller often wants the name itself; a change's caller always wants to act
/// on it.) Watching a single FILE reports that file's own path back. Entries
/// are `/`-separated on every host, like `read_dir_all`'s.
///
/// Deliberately NOT carrying the entry's kind. For a `Created` or `Modified`
/// path, `stat(change.path)` answers live and answers more; for a `Removed`
/// one the entry is gone and only a REMEMBERED kind exists, and this module
/// does not hand back remembered facts dressed as current ones.
struct Change {
	path: str,
	kind: ChangeKind,
}

/// The raw host change record. Opaque and internal, exactly like `RawStat` and
/// `RawEntry` above — `next` copies the two fields into a plain `Change`, so
/// no caller touches the host shape.
external struct RawChange;

impl RawChange {
	[extern(get, "path")]
	external fun path(self): str;

	[extern(get, "kind")]
	external fun kind(self): ChangeKind;
}

/// The raw start. Kept behind the two named constructors, the way
/// `open_with_flags` is kept behind `File`'s five: the recursion flag and the
/// poll interval are decisions the surface should make, not arguments a caller
/// gets wrong. Async because the BASELINE is taken here — a watcher reports
/// changes since the moment it was created, which requires reading the tree
/// once before returning.
///
/// The whole poll lives host-side (`__fs_watch`, `transformer.rs`) for the
/// same reason `__fs_stat` does: the loop must own a host timer and a queue,
/// and it must survive a `stat` that fails on a path that vanished mid-walk,
/// which `vilan` has no `try`/`catch` to express. It calls the same
/// `fs.promises.stat` that `stat` above wraps, and compares the same
/// `mtimeMs`/`size` that `Stat` exposes.
[extern("__fs_watch")]
async external fun start_watch(path: str, recursive: bool, interval_ms: i32): Watcher;

impl Watcher {
	/// Watches `path` and, when it is a directory, its IMMEDIATE entries —
	/// `read_dir`'s reach. The path need not exist yet: a watcher on a path
	/// that is not there reports `Created` when it appears, which is a thing
	/// `fs.watch` cannot do at all (it throws on a missing path).
	///
	/// The interval is 300 ms, the number the compiler's own `--watch` loop
	/// has used since it shipped (proposal/watch-mode.md). It is not a
	/// parameter: no caller has asked for one, one number across the language
	/// is worth more than a knob, and adding `watch_every` later is additive
	/// rather than breaking.
	fun watch(path: str): Watcher {
		start_watch(path, false, 300)
	}

	/// Watches `path` and everything under it, however deep —
	/// `read_dir_all`'s reach, and the `_all` suffix means the same thing it
	/// means there. Costs one `stat` per entry in the tree per interval; on a
	/// large tree that is the expensive call in this module.
	fun watch_all(path: str): Watcher {
		start_watch(path, true, 300)
	}

	[extern(method, "next_change")]
	async external fun raw_next(self, signal: Option<CancelSignal>): RawChange;

	/// The next change, awaiting one if nothing has happened yet — the pull
	/// shape, and the whole surface for consuming a watch. Async, so a caller
	/// awaits it implicitly and the ordinary spelling is a plain loop:
	///
	/// ```text
	/// let watcher = Watcher::watch_all("src");
	/// loop {
	///     let change = watcher.next();
	///     rebuild(change.path);
	/// }
	/// ```
	///
	/// PULL, NOT CALLBACK, and the reason is the language rather than
	/// fashion. A `|Change| void` observer is a VOID channel, which
	/// async-polymorphism.md makes fire-and-forget: a handler that wanted to
	/// read the file it was just told about could not await the read, and
	/// would drop the promise on the floor. (`Signal::sub` is that shape on
	/// purpose; a watch handler is not.) Meanwhile R9 forbids a closure from
	/// capturing a resource, so such a handler could not hold an open `File`
	/// either, leaving it to re-open by path per event — a TOCTOU race and a
	/// fresh open each time. `next` has neither problem: it returns a value
	/// into a scope that can already own a `File`, and it reads exactly like
	/// `BodyReader`'s chunk loop in `std::fetch`, which is the same problem
	/// (a sequence of things arriving over time) already solved this way.
	///
	/// Changes are QUEUED, so nothing observed is lost while the caller is
	/// busy — the poll runs on its own timer and does not wait to be asked.
	/// Several changes seen in one interval arrive path-sorted and one at a
	/// time; the order among them carries no timing information, because they
	/// were observed together.
	///
	/// Inside a nursery's dynamic extent the wait carries the ambient cancel
	/// signal, exactly as `sleep` and `Timer::wait` do. That is not a
	/// nicety: without it a cancelled nursery whose body is parked on a change
	/// that will never come could never drain.
	fun next(self): Change {
		let raw = self.raw_next(ambient_signal());
		Change { path = raw.path(), kind = raw.kind() }
	}
}

/// Stops the watch and clears its host timer — the one host operation with no
/// public surface. Reachable only from `Watcher`'s `Drop` below, so there is
/// no `stop()` to fall out of sync with the destructor; `drop(watcher)` is the
/// early form. Synchronous and idempotent (a second stop is a no-op), which is
/// why this resource needs no exception to destruction.md §5.
[extern("__fs_watch_stop")]
external fun stop_watch(watcher: Watcher): void;

impl Watcher with Drop {
	/// Runs at the owner's scope end (or at an explicit `drop(watcher)`):
	/// stops the poll through the `&mut self` loan. Synchronous and
	/// context-free, as a destructor must be — and genuinely synchronous, not
	/// `File`'s initiated-and-abandoned close.
	fun drop(&mut self) {
		stop_watch(self);
	}
}
