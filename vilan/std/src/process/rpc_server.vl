// `std::rpc_server` — the server half of `std::rpc`, mounted on `std::http`:
// where a protocol (a frame handler) meets a real listening socket. The client
// halves live in platform-neutral `std::rpc` (`HttpTransport`, `connect_split`);
// this module is their process-layer counterpart, and the two must agree on the
// wire format (the SSE `data:` framing, the `__conn:<id>` handshake, and the
// `/send?c=<id>` addressing that `SplitDuplex` speaks).
//
// A connected service rides `Server`'s public surface: the SSE stream is a
// STREAMING response (`ResponseBuilder::streaming` — partial writes over a
// held-open response), the binary RPC reply is a bytes body, and the
// WebSocket handshake mounts through `ServerBuilder::on_upgrade`.

import pkg::bytes::Bytes;
import pkg::compare::Ordering;
import pkg::http::{ NodeRequest, NodeSocket, Request, Response, ServerBuilder };
import pkg::json::{ FromJson, JsonKind, JsonValue, coerce_str, has_json_field };
import pkg::option::Option::{ None, Some, self };
import pkg::reactive::{ FlushPolicy, batch, turn };
import pkg::result::Result::{ Err, Ok, self };
import pkg::rpc::{
	Dispatcher,
	DuplexEnd,
	RpcError,
	RpcOutcome,
	RpcProtocol,
	RpcService,
	drop_session,
	duplex_pair,
	encode_reply,
	register_session,
	rpc_subprotocol,
	tag_duplex_bytes,
	tag_rpc_bytes,
};
import pkg::shared::Shared;
import pkg::time::now_millis;
import pkg::wire::{ Codec, Frame };
import pkg::ws::{ WsEvent, WsParser, binary_frame, close_frame, pong_frame, text_frame };

// --- WebSocket handshake (node:crypto) ------------------------------------------

external struct Hash;

/// Synchronous, and the one place in std where the usual claim for a sync
/// binding is actually TRUE: the handshake runs inside `upgrade_handler`, whose
/// type is `|NodeRequest, NodeSocket, Bytes| void` (`std::http`) — a plain
/// closure, not an `async` one — so `accept_socket` and everything it calls
/// genuinely cannot suspend. `std::crypto` is "async where the host is"
/// (WebCrypto's `subtle.digest` returns a promise); this binding diverges from
/// that on purpose, because the non-async upgrade channel leaves it no choice.
/// If that channel ever goes `async`, this is the reason to revisit.
[extern("node:crypto", "createHash")]
external fun create_hash(algorithm: str): Hash;

impl Hash {
	[extern(method, "update")]
	external fun update(self, data: str): Hash;

	[extern(method, "digest")]
	external fun digest(self, encoding: str): str;
}

/// RFC 6455 §4.2.2: the `Sec-WebSocket-Accept` proof — base64(SHA-1(key+GUID)).
fun ws_accept_key(key: str): str {
	create_hash("sha1").update(key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11").digest("base64")
}

// --- Service: an rpc mount installed on a `ServerBuilder` (fullstack-dx.md §4) -

/// What the app proved about a connection before the socket went up — the
/// identity half of `transport-rpc.md` Q4, carried into the factory as
/// `Connection.session`. A service with no `authorize` hook sees
/// `Session::anonymous()`; the app decides what more a connection's identity
/// means by looking `identity` up in the instance the factory builds.
struct Session {
	/// The app's name for whoever is on the other end — a user id, a subject
	/// claim. Empty when nothing authorized this connection.
	identity: str,
	/// The credential the identity was proved with, kept for apps that must
	/// re-present it downstream. Empty when there was none.
	credential: str,
}

impl Session {
	/// A connection nothing authorized: no identity, no credential.
	fun anonymous(): Session {
		Session { identity = "", credential = "" }
	}

	/// The ordinary `authorize` result: this connection is `identity`.
	fun of(identity: str): Session {
		Session { identity = identity, credential = "" }
	}

	/// `of`, keeping the credential the identity was proved with.
	fun with_credential(own self, credential: str): Session {
		self.credential = credential;
		self
	}

	/// Whether anything authorized this connection.
	fun is_anonymous(self): bool {
		self.identity == ""
	}
}

/// One connected client, as the factory sees it: the connection id the rest of
/// the layer keys by (the same id `on_connect`/`on_disconnect` carry and the
/// generated `__attach` is called with), the session `authorize` proved, and
/// the peer's address (`""` when the host does not report one — and the
/// PROXY's address behind a proxy).
struct Connection {
	id: i32,
	session: Session,
	remote_addr: str,
}

/// The upgrade request, as `authorize` sees it — everything the client could
/// say about itself before a socket exists (`transport-rpc.md` §4.2's upgrade
/// mechanics, A40).
///
/// `protocols` is the load-bearing field: the browser's `WebSocket` API sends
/// no headers, and the subprotocol list is the only thing it lets a page put
/// on the handshake. The convention (`std::rpc::rpc_protocols`) is
/// `["vilan-rpc", "token." + credential]` — the real protocol name the server
/// selects and echoes, and the credential riding beside it.
struct Handshake {
	path: str,
	headers: JsonValue,
	protocols: List<str>,
	remote_addr: str,
}

/// One header off a raw handshake's header object. `JsonValue` is the
/// documented accessor for a dynamic host object (there is no plain extern
/// shape for named property access), and the string check is what keeps a
/// non-string value from coercing to `"undefined"`.
fun header_text(headers: JsonValue, name: str): Option<str> {
	if has_json_field(headers, name) {
		let value = headers.field(name);
		if value.kind() == JsonKind::String {
			ret Some(coerce_str(value));
		}
	}
	None
}

impl Handshake {
	/// A named request header, or `None` when the handshake did not carry it.
	/// Node lowercases every name it parses, so `name` is lowered to match.
	fun header(self, name: str): Option<str> {
		header_text(self.headers, name.to_lowercase())
	}

	/// The credential offered by the `"token."` convention, if the client
	/// offered one.
	fun token(self): Option<str> {
		for offered in self.protocols {
			if offered.starts_with("token.") {
				ret Some(offered.substring(6, offered.len()));
			}
		}
		None
	}

	/// Whether the client offered `protocol` by name.
	fun offers(self, protocol: str): bool {
		for offered in self.protocols {
			if offered == protocol {
				ret true;
			}
		}
		false
	}
}

/// Why a handshake was refused. Each arm names the HTTP status the raw socket
/// is answered with before it is destroyed — no socket, no session, no
/// `ReactiveServer`, which is the whole point of gating BEFORE the upgrade
/// rather than inside a method.
[derive(PartialEq, Debug)]
enum Reject {
	/// 401 — no credential, or one that did not verify.
	Unauthorized,
	/// 403 — a good credential for someone who may not have this.
	Forbidden,
	/// 429 — a limit, not a judgement: `max_connections`, the per-IP
	/// handshake rate, or the app's own.
	TooMany,
}

/// The status line each refusal is answered with.
fun reject_status(reject: Reject): str {
	match reject {
		Reject::Unauthorized => "401 Unauthorized",
		Reject::Forbidden => "403 Forbidden",
		Reject::TooMany => "429 Too Many Requests",
	}
}

/// The frame a refused vilan client is told its refusal with (A47) — the
/// `__conn:<id>` announcement's negative twin, carrying the status the socket
/// API will not show it. `__reject:401` / `__reject:403`.
fun reject_announcement(reject: Reject): str {
	"__reject:" + reject_code(reject)
}

/// The status NUMBER, as text — the announcement's payload and the first token
/// of the status line, named once so the two cannot drift.
fun reject_code(reject: Reject): str {
	match reject {
		Reject::Unauthorized => "401",
		Reject::Forbidden => "403",
		Reject::TooMany => "429",
	}
}

/// Whether this refusal is one the CLIENT can act on rather than wait out
/// (A47): a judgement about the credential it presented. `TooMany` is not —
/// it is a limit, it says nothing about the credential, and retrying after a
/// backoff is the right answer to it.
fun is_judgement(reject: Reject): bool {
	match reject {
		Reject::Unauthorized => true,
		Reject::Forbidden => true,
		Reject::TooMany => false,
	}
}

/// Refuse an upgrade. Two shapes, and which one a client gets is decided by
/// what it is and what it did (A47).
///
/// **The status line** — a minimal HTTP response, then destroy — is the
/// default and stays exactly what A40 shipped. It is what a browser, a probe,
/// `curl`, a load balancer's health check and a port scanner get, so the HTTP
/// semantics of a refused handshake are unchanged for everything that speaks
/// HTTP and not this protocol.
///
/// **The typed refusal frame** is for a vilan rpc client refused by JUDGEMENT:
/// complete the upgrade, write one `__reject:<status>` frame, close, destroy.
/// It exists because neither host WebSocket implementation shows a client the
/// status of a failed handshake — measured on node 24 (undici's global
/// `WebSocket`), a 401, a 403, a 429, a socket destroyed mid-handshake, a
/// connection refused and a server with no upgrade handler at all produce the
/// SAME error message and the same close code (1002), and the browser API
/// exposes even less by design. A refused client therefore could not tell "my
/// token is wrong" from "the server is down", so it did what an unreachable
/// server deserves: ten redials over about 24 seconds of backoff, and then
/// `Transport("could not reach …")`.
///
/// **The DoS trade, and why it is bounded.** A refusal that upgrades costs one
/// 101, one small frame and a close where a status line costs one write — and
/// the socket is destroyed in the same turn either way, so nothing is HELD.
/// The bound is which refusals are eligible: `TooMany` never is, and `TooMany`
/// is exactly what `max_connections` and `handshake_rate` produce. A flood is
/// therefore refused by the cheap path by construction, and an attacker cannot
/// reach the expensive one more often than the rate limit admits.
///
/// A refusal only upgrades when the client offered the `vilan-rpc`
/// subprotocol — this protocol's own clients, and nothing else — and when the
/// handshake carries the key an upgrade needs.
fun refuse_upgrade(request: NodeRequest, socket: NodeSocket, reject: Reject) {
	// An `authorize` that ran out of time destroyed the socket already (A48);
	// there is nothing left to answer on.
	if socket.destroyed() {
		ret;
	}
	let headers = request.headers();
	// "the client offered `vilan-rpc`", asked through the selection itself:
	// the selection IS that name exactly when it was offered.
	let speaks_rpc = selected_protocol(offered_protocols(headers)) == rpc_subprotocol();
	if is_judgement(reject) && speaks_rpc && has_json_field(headers, "sec-websocket-key") {
		write_upgrade_101(socket, headers);
		socket.write_bytes(text_frame(reject_announcement(reject)));
		socket.write_bytes(close_frame());
		socket.destroy();
		ret;
	}
	let status = reject_status(reject);
	socket.write_text(i"HTTP/1.1 {status}\r\nConnection: close\r\nContent-Length: 0\r\n\r\n");
	socket.destroy();
}

/// Write the 101, subprotocol selection echoed (RFC 6455 §4.2.2). Shared by
/// the accepting path and the typed refusal, so a refused client's handshake
/// is byte-identical to an accepted one up to the first frame — which is what
/// makes the host WebSocket deliver that frame at all.
///
/// The caller has already checked `sec-websocket-key` is present; it is a
/// string by the handshake, so `unwrap_or` keeps the read total.
fun write_upgrade_101(socket: NodeSocket, headers: JsonValue) {
	let key: str = str::from_json_value(headers.field("sec-websocket-key")).unwrap_or("");
	let selected = selected_protocol(offered_protocols(headers));
	let echo = if selected == "" {
		""
	} else {
		"\r\nSec-WebSocket-Protocol: " + selected
	};
	socket.write_text("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: " + ws_accept_key(key) + echo + "\r\n\r\n");
}

/// The subprotocols the client offered, in order. One header, comma-separated
/// (RFC 6455 §4.1); a client that offered none gives an empty list.
fun offered_protocols(headers: JsonValue): List<str> {
	mut offered: List<str> = [];
	match header_text(headers, "sec-websocket-protocol") {
		Some(let raw) => {
			for part in raw.split(",") {
				let name = part.trim();
				if name.len() > 0 {
					offered.push(name);
				}
			}
		},
		None => {},
	}
	offered
}

/// The one the server selects out of what was offered: `vilan-rpc` when it is
/// there (which is what every vilan client offers), else the client's first
/// choice, else nothing. RFC 6455 §4.2.2 requires the selection to be ECHOED
/// in the 101 — a browser that offered a subprotocol and hears none back
/// closes the connection immediately — and this server echoed nothing at all
/// until A40.
fun selected_protocol(offered: List<str>): str {
	for name in offered {
		if name == rpc_subprotocol() {
			ret name;
		}
	}
	// The client's first choice otherwise — but never a `"token."` offer.
	// Those are not protocols anybody speaks; they are what a browser
	// handshake carries instead of a header, and selecting one would both
	// misreport the protocol and write the credential back out in the reply.
	for name in offered {
		if !name.starts_with("token.") {
			ret name;
		}
	}
	""
}

/// One rpc service mounted on a `Server`: the protocol, where its routes
/// live, and what happens to a connection's per-connection state. The routes
/// (`{mount}events`, `{mount}send`, `{mount}rpc`) and the upgrade handshake
/// are installed together, because a duplex service is both —
/// `ServerBuilder::with_service` folds both in at `build()`, in front of
/// `on_request`/`on_upgrade` (§4.3).
///
/// A connection ends when its stream closes (tab closed, network gone): the
/// wire is forgotten here, and `on_disconnect(id)` tells the app to drop its
/// own per-connection state (dispose a `ReactiveServer` session, say) —
/// otherwise a long-running server leaks a session per ever-connected client.
struct Service {
	/// The protocol THIS connection is answered by. `Service::new` hands every
	/// connection the same one; `Service::factory` builds a fresh service
	/// instance per connection and returns its dispatcher's protocol (Q9).
	build_protocol: |Connection| RpcProtocol,
	/// The one protocol, for a service that HAS one without a connection —
	/// `Service::new` only. It is what the connectionless `{mount}rpc` POST
	/// leg answers from; `None` under `factory`, which has no instance to
	/// answer with until a connection exists.
	shared: Option<RpcProtocol>,
	codec: Codec,
	mount: str,
	on_connect: |i32, DuplexEnd| void,
	on_disconnect: |i32| void,
	/// The pre-upgrade gate (A40), when the app installed one. `Ok(session)`
	/// feeds the factory; `Err(reject)` answers the raw socket and destroys
	/// it, before any of this service's state exists for that client.
	///
	/// Stored plain and re-marked `async` at a `let` where it is called (J2
	/// v1: an `async` closure TYPE lives only at parameter/`let`/field/return
	/// seams, and never nested inside a `Option<…>`) — which is what makes the
	/// call await, so a hook that verifies a signature settles before the
	/// handshake is answered.
	authorize: Option<|Handshake| Result<Session, Reject>>,
	/// Live upgraded connections on this mount, and the ceiling `0` means
	/// none. A cell, so every copy of this `Service` value counts into one
	/// total.
	live: Shared<i32>,
	max_connections: i32,
	/// Handshakes admitted per remote address per `handshake_window`
	/// milliseconds; `0` is unlimited.
	handshake_rate: i32,
	handshake_window: f64,
	/// The recent handshakes the rate is measured over: `(remote, at)`.
	handshakes: Shared<List<(str, f64)>>,
	/// Milliseconds a connection may stay silent after the upgrade before it
	/// is destroyed; `0` is unlimited. Armed at the handshake and DISARMED by
	/// the first inbound byte, so it bounds the greeting and never a
	/// legitimately idle connection.
	handshake_timeout: i32,
	/// Milliseconds the `authorize` hook may take before the handshake is
	/// refused and the socket destroyed; `0` — the default — waits forever
	/// (A48). `handshake_timeout`'s twin on the OTHER side of the upgrade:
	/// that one bounds a client that says nothing, this one bounds a VERIFIER
	/// that answers nothing.
	authorize_timeout: i32,
	/// Whether this server sits behind a proxy it trusts (A48). When it does,
	/// a client's address is the first entry of `X-Forwarded-For` rather than
	/// the socket peer — which is the proxy, and the same one for every
	/// client, so a per-address rate limit degenerates to a global one.
	/// OFF by default, because a directly-exposed server must never believe a
	/// header the client itself writes.
	trust_forwarded_for: bool,
}

impl Service {
	/// The `Client::connect` service (`transport-rpc.md` §4.2): the runtime
	/// session registry as the connection lifecycle — every connection gets a
	/// reactive session the generated `__attach` route can answer from,
	/// disposed on disconnect. Mounted at `/` until `.at(prefix)` says
	/// otherwise.
	///
	/// The STATELESS shorthand: one process-wide instance behind one protocol,
	/// shared by every client. `Service::factory(|_connection| shared, codec)`
	/// is the same service written the long way — reach for `factory` the
	/// moment a method needs to know who called.
	fun new(protocol: RpcProtocol): Service {
		Service {
			build_protocol = |_connection| protocol,
			shared = Some(protocol),
			codec = protocol.codec,
			mount = "/",
			on_connect = |connection, wire| register_session(connection, wire, protocol.codec),
			on_disconnect = |connection| drop_session(connection),
			authorize = None,
			live = Shared::new(0),
			max_connections = 0,
			handshake_rate = 0,
			handshake_window = 10000.0,
			handshakes = Shared::new([]),
			handshake_timeout = 0,
			authorize_timeout = 0,
			trust_forwarded_for = false,
		}
	}

	/// One service INSTANCE per connected client (`transport-rpc.md` Q9: the
	/// struct instance IS the connection's session). `build` is called once
	/// per connection, with that connection's `Connection` — its id, what
	/// `authorize` proved about it, and where it came from — and the instance
	/// it returns owns every route for that connection and nothing else:
	///
	/// ```text
	/// Service::factory(|connection| Store::open(connection.session.identity, db), json_codec())
	/// ```
	///
	/// Two consequences worth stating. A method can finally learn who called,
	/// because the answer is a field of the `self` its route closed over
	/// rather than a parameter the caller supplies. And `[expose]`d fields
	/// become per-client for free: each instance has its own cells, so each
	/// connection's `__attach` mints channels over that client's own sources.
	///
	/// The instance is dropped with the connection: `on_disconnect` releases
	/// the reactive session, and the dispatcher (with the instance every route
	/// captured) goes with the socket that held it.
	///
	/// The connectionless `{mount}rpc` POST leg has no connection to build
	/// for, so a factory service refuses it (501) — a factory service is
	/// reached over the WebSocket transport, which every generated
	/// `Client::connect` uses.
	fun factory<S: RpcService>(build: |Connection| S, codec: Codec): Service {
		Service {
			build_protocol = |connection| build(connection).dispatcher_for().into_protocol(codec),
			shared = None,
			codec = codec,
			mount = "/",
			on_connect = |connection, wire| register_session(connection, wire, codec),
			on_disconnect = |connection| drop_session(connection),
			authorize = None,
			live = Shared::new(0),
			max_connections = 0,
			handshake_rate = 0,
			handshake_window = 10000.0,
			handshakes = Shared::new([]),
			handshake_timeout = 0,
			authorize_timeout = 0,
			trust_forwarded_for = false,
		}
	}

	/// Mount under `prefix` instead of `/`. A prefix is what lets two services
	/// coexist, and what `Client::connect(url, codec)` already supplies —
	/// pass the same string on both sides (e.g. `"/admin/"`, trailing slash
	/// included: routes are formed by plain concatenation, `{mount}events`).
	fun at(own self, prefix: str): Service {
		self.mount = prefix;
		self
	}

	/// Replace the connection lifecycle, for apps holding custom
	/// per-connection state (an auth identity, an app-written attach).
	fun on_connect(own self, handler: |i32, DuplexEnd| void): Service {
		self.on_connect = handler;
		self
	}

	fun on_disconnect(own self, handler: |i32| void): Service {
		self.on_disconnect = handler;
		self
	}

	/// Decide whether a client may connect AT ALL, before the socket exists
	/// (`transport-rpc.md` Q4's transport half, A40). `check` runs on the
	/// upgrade request; `Err(reject)` answers 401/403/429 on the raw socket
	/// and destroys it — no connection id, no reactive session, no service
	/// instance — and `Ok(session)` becomes `Connection.session`, which
	/// `Service::factory`'s `build` reads to construct that client's instance.
	///
	/// The mechanism is the app's: std verifies nothing and knows no token
	/// format. What std provides is the seam and the transport convention —
	/// a browser cannot put a header on a WebSocket handshake, so the
	/// credential rides in the subprotocol list as `"token.<credential>"`
	/// (`Handshake::token`), which `std::rpc::rpc_protocols` writes on the
	/// client side.
	///
	/// The check may await: verifying a signature is a WebCrypto call
	/// everywhere, so this hook is async and the upgrade handler waits for it
	/// before answering.
	///
	/// ```text
	/// Service::factory(build, json_codec())
	///     .authorize(|handshake| match handshake.token() {
	///         Some(let token) => match verify(token) { … },
	///         None => Result::Err(Reject::Unauthorized),
	///     })
	/// ```
	///
	/// An authorized service answers ONLY the WebSocket upgrade: the
	/// connectionless SSE/POST legs carry no handshake to gate, so they are
	/// refused (`{mount}rpc` with a typed `RpcError::Unauthorized` envelope,
	/// the other two with a plain 401).
	fun authorize(own self, check: async |Handshake| Result<Session, Reject>): Service {
		self.authorize = Some(check);
		self
	}

	/// Refuse an upgrade (429) once this mount already holds `limit` live
	/// connections. `0` — the default — is unlimited. The cheapest of the
	/// limits on this seam, and one of the three that work with no
	/// `authorize` at all.
	///
	/// It counts UPGRADED SOCKETS on this mount and nothing else (A48): the
	/// counter moves in `accept_socket`, one up per 101 and one down per
	/// teardown. The SSE/POST legs are not counted — they hold no connection
	/// to count — and neither is a handshake still inside `authorize`, which
	/// is what `authorize_timeout` and `handshake_rate` are for. So a service
	/// whose clients arrive over `{mount}events` is not limited by this at
	/// all, and a flood that never finishes its handshake is not either.
	fun max_connections(own self, limit: i32): Service {
		self.max_connections = limit;
		self
	}

	/// Refuse an upgrade (429) once one client address has attempted
	/// `attempts` handshakes inside `window_millis`. `0` attempts — the
	/// default — is unlimited.
	///
	/// The address is the socket's peer unless `trust_forwarded_for(true)`
	/// says otherwise: behind a proxy every client shares the proxy's address
	/// and a per-address limit becomes a global one, refusing everybody as
	/// soon as one client is noisy.
	fun handshake_rate(own self, attempts: i32, window_millis: f64): Service {
		self.handshake_rate = attempts;
		self.handshake_window = window_millis;
		self
	}

	/// Read a client's address from the first entry of `X-Forwarded-For`
	/// instead of the socket peer (A48) — what `handshake_rate` keys on, what
	/// `authorize` sees in `Handshake.remote_addr`, and what a connection
	/// reports as `Connection.remote_addr`. One switch for all three, because
	/// a deployment either sits behind a proxy or it does not.
	///
	/// OFF by default and it must stay off unless a proxy you control is the
	/// ONLY way to reach this server: the header is written by whoever spoke
	/// last, so a directly-exposed server that trusts it lets any client pick
	/// its own rate-limit bucket — and its own audit trail — by writing one
	/// line. A trusted proxy overwrites (or appends to) the header, which is
	/// what makes the first entry the real client.
	///
	/// Falls back to the socket peer when the header is absent or empty, so
	/// turning it on never leaves an address blank.
	fun trust_forwarded_for(own self, trusted: bool): Service {
		self.trust_forwarded_for = trusted;
		self
	}

	/// Destroy a connection that has sent nothing `millis` after its upgrade.
	/// `0` — the default — waits forever. Disarmed by the first inbound byte,
	/// so it bounds the greeting rather than idleness: a client that connected
	/// and is only watching mirrors is never touched.
	fun handshake_timeout(own self, millis: i32): Service {
		self.handshake_timeout = millis;
		self
	}

	/// Refuse a handshake whose `authorize` hook has not answered `millis`
	/// after it was called, and destroy the socket (A48). `0` — the default —
	/// waits forever, which is what the hook got before this existed.
	///
	/// `authorize` is AWAITED inside the upgrade handler, so a verifier that
	/// hangs — a token endpoint that stopped answering, a database that is
	/// gone — holds an unanswered socket for as long as it hangs, and one per
	/// client trying to connect. That is a denial of service the server
	/// inflicts on itself, reached without a single malformed byte from
	/// anyone. `handshake_rate` caps how fast the pile grows; only a bound on
	/// the verifier caps how big it gets.
	///
	/// The refusal is `Reject::TooMany` — 429, not 503. The distinction the
	/// `Reject` enum draws is judgement (401/403) against LIMIT (429), and a
	/// verifier that did not answer in time is a limit: it says nothing about
	/// the credential, and it is exactly the case a client should retry. 503
	/// would be the more precise HTTP word for "this server is not well", and
	/// it is deliberately not used, because a fourth status would mean a
	/// fourth arm on an enum whose three arms are the three answers an app's
	/// own `authorize` may give — and this refusal is not one an app gives.
	///
	/// A hook that answers LATE is not raced back in: the socket is already
	/// destroyed and the timeout is one-way, so a straggling verifier's reply
	/// is discarded rather than written to a socket that is gone.
	fun authorize_timeout(own self, millis: i32): Service {
		self.authorize_timeout = millis;
		self
	}
}

/// Whether this handshake is inside the per-address rate, recording it when it
/// is. Prunes the window on the way through, so the table holds one window's
/// worth of handshakes and not a row per address ever seen.
fun admit_handshake(service: Service, remote: str): bool {
	let cutoff = now_millis() - service.handshake_window;
	mut kept: List<(str, f64)> = [];
	mut seen = 0;
	for entry in service.handshakes.read() {
		let (address, at) = entry;
		if at > cutoff {
			kept.push((address, at));
			if address == remote {
				seen = seen + 1;
			}
		}
	}
	if seen >= service.handshake_rate {
		service.handshakes.write() = kept;
		ret false;
	}
	kept.push((remote, now_millis()));
	service.handshakes.write() = kept;
	true
}

/// A client's address: the socket peer, or — when the service is configured
/// behind a proxy it trusts (A48) — the first entry of `X-Forwarded-For`.
///
/// The FIRST entry, because a proxy chain appends: `client, proxy1, proxy2`.
/// Empty entries are skipped and the socket peer is the fallback, so a missing
/// or blank header never yields a blank address.
fun client_address(service: Service, request: NodeRequest, socket: NodeSocket): str {
	let peer = socket.remote_address();
	if !service.trust_forwarded_for {
		ret peer;
	}
	match header_text(request.headers(), "x-forwarded-for") {
		Some(let raw) => {
			for part in raw.split(",") {
				let candidate = part.trim();
				if candidate.len() > 0 {
					ret candidate;
				}
			}
			peer
		},
		None => peer,
	}
}

/// The pre-upgrade gate: the limits that work with no auth at all, then the
/// app's own check. The order is deliberate — a flood is refused without
/// running (or paying for) a signature verification.
///
/// `Err(Reject)` here means the socket has NOT been written to and is still
/// open, with one exception the caller must respect: an `authorize` that ran
/// out of time has already destroyed it (`refuse_upgrade` checks, and writes
/// nothing to a destroyed socket).
fun gate_upgrade(
	service: Service,
	request: NodeRequest,
	socket: NodeSocket,
): Result<Session, Reject> {
	let remote = client_address(service, request, socket);
	if service.max_connections > 0 && service.live.read() >= service.max_connections {
		ret Err(Reject::TooMany);
	}
	if service.handshake_rate > 0 && !admit_handshake(service, remote) {
		ret Err(Reject::TooMany);
	}
	match service.authorize {
		None => Ok(Session::anonymous()),
		Some(let check) => {
			// Re-marked at the `let` so the call awaits (J2's typed channel):
			// the hook may verify a signature, and nothing may be written to
			// the socket until it has.
			let gate: async |Handshake| Result<Session, Reject> = check;
			// The verification bound (A48): armed before the hook is called
			// and disarmed the moment it answers. `settled` is what makes the
			// listener one-way — node's `"timeout"` handler stays attached for
			// the life of the socket, and `accept_socket` re-arms the same
			// timer for the greeting bound, so an authorized connection must
			// not be destroyed later by the listener this arm left behind.
			let settled: Shared<bool> = Shared::new(false);
			let expired: Shared<bool> = Shared::new(false);
			if service.authorize_timeout > 0 {
				socket.set_timeout(service.authorize_timeout);
				socket.on_signal("timeout", || {
					if !settled.read() {
						settled.write() = true;
						expired.write() = true;
						// Answered HERE and not by the caller: the point of
						// the bound is to release the socket now, and the
						// caller does not run again until the hook returns —
						// which is the thing that may never happen.
						refuse_upgrade(request, socket, Reject::TooMany);
					}
				});
			}
			let outcome = gate(Handshake {
				path = request.url(),
				headers = request.headers(),
				protocols = offered_protocols(request.headers()),
				remote_addr = remote,
			});
			if service.authorize_timeout > 0 {
				socket.set_timeout(0);
			}
			if expired.read() {
				// The socket is already gone; the hook's answer, whenever it
				// came, is discarded rather than written to it.
				ret Err(Reject::TooMany);
			}
			settled.write() = true;
			outcome
		},
	}
}

impl ServerBuilder {
	/// Install an rpc service. Repeatable. Its routes answer before
	/// `on_request`, independently of the order these calls were written —
	/// longest mount first, computed at `build()` (§4.3).
	fun with_service(own self, service: Service): ServerBuilder {
		self.services.push(service);
		self
	}
}

// --- The connection registry: a duplex wire per client --------------------------

/// Live SplitDuplex connections: each client's wire-side `DuplexEnd`, keyed by the
/// connection id announced on its SSE stream.
let connections: Shared<List<(i32, DuplexEnd)>> = Shared::new([]);

/// Connection ids — module-level, one counter for the program.
let next_connection: Shared<i32> = Shared::new(0);

fun fresh_connection(): i32 {
	let id = next_connection.read();
	next_connection.write() = id + 1;
	id
}

// --- The fold: `Service`s answer before `on_request`/`on_upgrade` (§4.3) -------

/// A path targets exactly `route`: itself, or `route` followed by a query
/// string — a path-SEGMENT match, not a prefix one, so a mount's `…/rpc`
/// route does not also claim `…/rpcs` (§10.8's fix for the old
/// `path.starts_with(…)` collision).
fun path_matches_route(path: str, route: str): bool {
	path == route || path.starts_with(route + "?")
}

/// Longest mount first — the tiebreak §4.3 gives so two services (`/` and
/// `/admin/`, say) are checked in the same order whichever order
/// `.with_service` was called in. Stable, so services sharing a mount length
/// keep their registration order.
fun services_by_mount(services: List<Service>): List<Service> {
	services.sort_by(|a, b| {
		if a.mount.len() > b.mount.len() {
			Ordering::Less
		} else if a.mount.len() < b.mount.len() {
			Ordering::Greater
		} else {
			Ordering::Equal
		}
	})
}

/// One connected service's SSE route: announce the connection, hand the app
/// its `DuplexEnd`, and forward inbound wire frames to the stream.
fun events_response(service: Service): Response {
	let id = fresh_connection();
	let on_connect = service.on_connect;
	let on_disconnect = service.on_disconnect;
	Response::builder()
		.set_header("Content-Type", "text/event-stream")
		.set_header("Cache-Control", "no-cache")
		.streaming(|stream| {
			stream.send(i"data: __conn:{id}\n\n");
			let (app_end, wire_end) = duplex_pair();
			wire_end.on_frame(|frame| {
				match frame {
					Frame::Text(let body) => stream.send(i"data: {body}\n\n"),
					// SSE can't carry bytes. Unreachable when both sides
					// run one codec: a binary codec's client panics on its
					// first send, before the server ever pushes.
					Frame::Binary(let _bytes) => {},
				}
			});
			connections.write().push((id, wire_end));
			stream.on_close(|| {
				drop_connection(id);
				on_disconnect(id);
			});
			on_connect(id, app_end);
		})
		.build()
}

/// One connected service's send route: forward the body to the addressed
/// connection's wire (§4.4 — the connection id space is process-wide, shared
/// by every mounted service, so this needs no service-specific state at all).
fun send_response(request: Request): Response {
	let content = request.body();
	// A garbled id parses to -1, which matches no connection — the frame is
	// dropped, same as an unknown id.
	let target = connection_id_of(request.path()).parse_i32().unwrap_or(0 - 1);
	for entry in connections.read() {
		let (id, wire) = entry;
		if id == target {
			// the wire turn: the frame's signal writes coalesce
			batch(|| {
				wire.send(Frame::Text(content));
			});
		}
	}
	Response::builder().code(204).body("").build()
}

/// One connected service's rpc route: the body as bytes, no sniffing — the
/// JSON codec's reader accepts a binary frame as UTF-8 (both sides run one
/// codec, Q6).
///
/// A POST carries no connection, so a service that builds one instance per
/// connection (`Service::factory`) has nothing to answer it with — no
/// instance, no session, no identity. That is refused in as many words rather
/// than silently answered by some other client's instance.
fun rpc_frame_response(service: Service, request: Request): Response {
	match service.shared {
		Some(let protocol) => {
			let reply = turn(FlushPolicy::AtEnd, || protocol.respond(Frame::Binary(request.bytes())));
			match reply {
				Frame::Text(let frame) => Response::builder().set_header("Content-Type", "application/json").body(frame).build(),
				Frame::Binary(let frame) => Response::builder().set_header("Content-Type", "application/octet-stream").body_bytes(frame).build(),
			}
		},
		None => Response::builder().code(501).body("this service builds one instance per connection (Service::factory), and a POST rpc frame carries no connection to build for — connect over the WebSocket transport instead").build(),
	}
}

/// An authorized service (A40) answers ONLY the WebSocket upgrade: the SSE
/// stream and the two POST legs carry no handshake — no subprotocol list, no
/// place for a credential the browser could have put there — so there is
/// nothing for `authorize` to gate and they are refused rather than left as
/// the open back door around it. The rpc leg says so in the protocol's own
/// vocabulary: a `Failure(RpcError::Unauthorized)` envelope, which is where
/// that variant finally gets a producer.
fun unauthorized_response(service: Service, route: str): Response {
	if route == "rpc" {
		let envelope = encode_reply(service.codec, RpcOutcome::Failure(RpcError::Unauthorized));
		match envelope {
			Frame::Text(let frame) => Response::builder().code(401).set_header("Content-Type", "application/json").body(frame).build(),
			Frame::Binary(let frame) => Response::builder().code(401).set_header("Content-Type", "application/octet-stream").body_bytes(frame).build(),
		}
	} else {
		Response::builder()
			.code(401)
			.body("this service authorizes its connections at the WebSocket upgrade, and the SSE/POST legs carry no handshake to authorize — connect over the WebSocket transport instead")
			.build()
	}
}

/// `service`'s answer to `request`, if its routes claim the path — `None`
/// when the path is not this service's.
fun service_response(service: Service, request: Request): Option<Response> {
	let path = request.path();
	let gated = service.authorize.is_some();
	if path_matches_route(path, service.mount + "events") {
		if gated {
			Some(unauthorized_response(service, "events"))
		} else {
			Some(events_response(service))
		}
	} else if path_matches_route(path, service.mount + "send") {
		if gated {
			Some(unauthorized_response(service, "send"))
		} else {
			Some(send_response(request))
		}
	} else if path_matches_route(path, service.mount + "rpc") {
		if gated {
			Some(unauthorized_response(service, "rpc"))
		} else {
			Some(rpc_frame_response(service, request))
		}
	} else {
		None
	}
}

/// The first (longest-mount) service that claims `request`, if any.
fun services_answer(services: List<Service>, request: Request): Option<Response> {
	mut answer: Option<Response> = None;
	for service in services {
		if answer.is_none() {
			answer = service_response(service, request);
		}
	}
	answer
}

/// Compose `services`' routing in front of `fallback`: rule 1's "services
/// first, then `on_request`, always" (§4.3), independent of the order
/// `.with_service` was called in.
fun fold_service_requests(
	services: List<Service>,
	fallback: async |Request| Response,
): async |Request| Response {
	let sorted = services_by_mount(services);
	|request| {
		match services_answer(sorted, request) {
			Some(let response) => response,
			None => fallback(request),
		}
	}
}

/// The first (longest-mount) service whose mount the upgrade request's path
/// targets, if any (§4.4: one multiplexed socket per connection, so the
/// upgrade path — not a per-route suffix — is what a mount claims).
fun service_for_upgrade(services: List<Service>, request: NodeRequest): Option<Service> {
	let path = request.url();
	mut answer: Option<Service> = None;
	for service in services {
		if answer.is_none() && path_matches_route(path, service.mount) {
			answer = Some(service);
		}
	}
	answer
}

/// Compose `services`' upgrade handshakes into one dispatcher: picks the
/// matching service by longest mount and runs its handshake (§4.4); an
/// upgrade no service claims falls to `fallback` if the app installed one,
/// and is destroyed otherwise — same as an unrecognized handshake today.
/// With no services at all, `fallback` is returned untouched, so a plain
/// `Server::builder()` with no `.with_service` calls installs no upgrade
/// listener beyond what the app asked for, exactly as before this layer
/// existed.
fun fold_service_upgrades(
	services: List<Service>,
	fallback: Option<|NodeRequest, NodeSocket, Bytes| void>,
): Option<|NodeRequest, NodeSocket, Bytes| void> {
	if services.len() == 0 {
		fallback
	} else {
		let sorted = services_by_mount(services);
		Some(|request, socket, head| {
			match service_for_upgrade(sorted, request) {
				// A40: the gate runs BEFORE the handshake, so a refused client
				// never reaches a connection id, a reactive session or a
				// service instance — it gets a status line and a destroyed
				// socket.
				Some(let service) => match gate_upgrade(service, request, socket) {
					Ok(let session) => accept_socket(request, socket, head, service, session),
					Err(let reject) => refuse_upgrade(request, socket, reject),
				},
				None => match fallback {
					Some(let handler) => handler(request, socket, head),
					None => socket.destroy(),
				},
			}
		})
	}
}

/// Perform the RFC 6455 handshake and wire the socket into the connection
/// registry. Client→server text frames route by channel prefix (§5's
/// multiplex): `r:<id>:<frame>` is an RPC turn answered on the same socket
/// with the same id, `d:<frame>` is a duplex/reactive wire turn. Pings are
/// answered; close (or a protocol violation) tears the session down like an
/// SSE close.
fun accept_socket(
	request: NodeRequest,
	socket: NodeSocket,
	head: Bytes,
	service: Service,
	session: Session,
) {
	let headers = request.headers();
	if !has_json_field(headers, "sec-websocket-key") {
		socket.destroy();
		ret;
	}
	// RFC 6455 §4.2.2: a client that offered subprotocols must hear the
	// server's selection back, or it closes the connection — which is what a
	// browser does, silently, and what this handshake gave every such client
	// before A40 because it echoed nothing at all.
	write_upgrade_101(socket, headers);
	let id = fresh_connection();
	// The connection's OWN protocol: under `Service::factory` this builds the
	// instance that answers for this client and nothing else (A38), and every
	// `respond` below routes through it. `session` is what `authorize` proved
	// about this client (A40) — anonymous when the service gates nothing.
	let protocol = (service.build_protocol)(Connection {
		id = id,
		session = session,
		// The same reading `authorize` and the rate limit used (A48).
		remote_addr = client_address(service, request, socket),
	});
	service.live.write() = service.live.read() + 1;
	let on_connect = service.on_connect;
	let on_disconnect = service.on_disconnect;
	let (app_end, wire_end) = duplex_pair();
	wire_end.on_frame(|frame| {
		match frame {
			Frame::Text(let body) => socket.write_bytes(text_frame("d:" + body)),
			Frame::Binary(let bytes) => socket.write_bytes(binary_frame(tag_duplex_bytes(bytes))),
		}
	});
	connections.write().push((id, wire_end));
	let closed: Shared<bool> = Shared::new(false);
	let teardown = || {
		if !closed.read() {
			closed.write() = true;
			service.live.write() = service.live.read() - 1;
			drop_connection(id);
			on_disconnect(id);
		}
	};
	// The greeting bound (A40): armed here, disarmed by the first inbound
	// byte, so a socket that upgrades and then says nothing costs one timer
	// rather than a connection slot for the life of the process.
	let greeted: Shared<bool> = Shared::new(false);
	if service.handshake_timeout > 0 {
		socket.set_timeout(service.handshake_timeout);
		socket.on_signal("timeout", || {
			if !greeted.read() {
				socket.destroy();
			}
		});
	}
	let parser = WsParser::new();
	let receive = |chunk: Bytes| {
		if !greeted.read() {
			greeted.write() = true;
			if service.handshake_timeout > 0 {
				socket.set_timeout(0);
			}
		}
		for event in parser.feed(chunk) {
			match event {
				WsEvent::Text(let frame) => {
					if frame.starts_with("r:") {
						// An RPC turn: answer on this socket with the same id.
						let rest = frame.substring(2, frame.len());
						let parts = rest.split(":");
						let id_text = parts[0];
						// `r:<id>` with no second `:` carries no payload — a
						// malformed frame off the wire, ignored rather than
						// answered. (`r:7:` is the well-formed empty payload.)
						if id_text.len() < rest.len() {
							let payload = rest.substring(id_text.len() + 1, rest.len());
							let reply = turn(FlushPolicy::AtEnd, || protocol.respond(Frame::Text(payload)));
							match reply {
								Frame::Text(let answer) => {
									socket.write_bytes(text_frame(i"r:{id_text}:{answer}"));
								},
								Frame::Binary(let bytes) => {
									let id = id_text.parse_i32().unwrap_or(0 - 1);
									socket.write_bytes(binary_frame(tag_rpc_bytes(id, bytes)));
								},
							}
						}
					} else if frame.starts_with("d:") {
						// the wire turn: the frame's signal writes coalesce
						batch(|| {
							wire_end.send(Frame::Text(frame.substring(2, frame.len())));
						});
					}
				},
				WsEvent::Ping(let payload) => socket.write_bytes(pong_frame(payload)),
				WsEvent::Closed => {
					socket.write_bytes(close_frame());
					socket.destroy();
				},
				// The byte lanes (§5's multiplex, tag form): `0x64` is a duplex
				// frame, `0x72` + 4-byte LE id is an RPC turn answered in kind.
				WsEvent::Binary(let bytes) => {
					if bytes.len() > 0 && bytes.get(0) == 0x64 {
						// the wire turn: the frame's signal writes coalesce
						batch(|| {
							wire_end.send(Frame::Binary(bytes.slice(1, bytes.len())));
						});
					} else if bytes.len() >= 5 && bytes.get(0) == 0x72 {
						let id = bytes.get(1) | bytes.get(2) << 8 | bytes.get(3) << 16 | bytes.get(4) << 24;
						let payload = bytes.slice(5, bytes.len());
						let reply = turn(FlushPolicy::AtEnd, || protocol.respond(Frame::Binary(payload)));
						match reply {
							Frame::Binary(let answer) => {
								socket.write_bytes(binary_frame(tag_rpc_bytes(id, answer)));
							},
							Frame::Text(let answer) => {
								socket.write_bytes(text_frame(i"r:{id}:{answer}"));
							},
						}
					}
				},
			}
		}
	};
	if head.len() > 0 {
		receive(head);
	}
	socket.on_bytes("data", receive);
	socket.on_signal("close", teardown);
	// A peer that simply goes away — a lost network, a killed process, any
	// disconnect that is not a WebSocket close frame — half-closes the socket,
	// and node leaves an UPGRADED socket half-open: `end` fires, `close` never
	// does. Teardown rode `close` alone, so every such connection's reactive
	// session and wire entry survived the client for the life of the process.
	// `teardown` is idempotent (the `closed` cell), so arming both is safe;
	// destroying our half is what then releases the descriptor and fires
	// `close`.
	socket.on_signal("end", || {
		teardown();
		socket.destroy();
	});
	socket.on_signal("error", || socket.destroy());
	socket.write_bytes(text_frame(i"__conn:{id}"));
	on_connect(id, app_end);
}

/// Forget a closed connection's wire (frames already in flight to it are
/// silently dropped by the host — see `NodeResponse.write`).
fun drop_connection(target: i32) {
	mut kept: List<(i32, DuplexEnd)> = [];
	for entry in connections.read() {
		let (id, wire) = entry;
		if id != target {
			kept.push((id, wire));
		}
	}
	connections.write() = kept;
}

/// `/send?c=<id>` → `<id>`.
fun connection_id_of(path: str): str {
	let parts = path.split("c=");
	parts[parts.len() - 1]
}
