// `std::rpc_server` — the server half of `std::rpc`, mounted on `std::http`:
// where a protocol (a frame handler) meets a real listening socket. The client
// halves live in platform-neutral `std::rpc` (`HttpTransport`, `connect_split`);
// this module is their process-layer counterpart, and the two must agree on the
// wire format (the SSE `data:` framing, the `__conn:<id>` handshake, and the
// `/send?c=<id>` addressing that `SplitDuplex` speaks).
//
// A connected service rides `Server`'s public surface: the SSE stream is a
// STREAMING response (`ResponseBuilder::streaming` — partial writes over a
// held-open response), the binary RPC reply is a bytes body, and the
// WebSocket handshake mounts through `ServerBuilder::on_upgrade`.

import pkg::bytes::Bytes;
import pkg::compare::Ordering;
import pkg::http::{ NodeRequest, NodeSocket, Request, Response, ServerBuilder };
import pkg::json::{ FromJson, JsonValue, has_json_field };
import pkg::option::Option::{ None, Some, self };
import pkg::reactive::{ FlushPolicy, batch, turn };
import pkg::rpc::{
	Dispatcher,
	DuplexEnd,
	RpcProtocol,
	RpcService,
	drop_session,
	duplex_pair,
	register_session,
	tag_duplex_bytes,
	tag_rpc_bytes,
};
import pkg::shared::Shared;
import pkg::wire::{ Codec, Frame };
import pkg::ws::{ WsEvent, WsParser, binary_frame, close_frame, pong_frame, text_frame };

// --- WebSocket handshake (node:crypto) ------------------------------------------

external struct Hash;

/// Synchronous, and the one place in std where the usual claim for a sync
/// binding is actually TRUE: the handshake runs inside `upgrade_handler`, whose
/// type is `|NodeRequest, NodeSocket, Bytes| void` (`std::http`) — a plain
/// closure, not an `async` one — so `accept_socket` and everything it calls
/// genuinely cannot suspend. `std::crypto` is "async where the host is"
/// (WebCrypto's `subtle.digest` returns a promise); this binding diverges from
/// that on purpose, because the non-async upgrade channel leaves it no choice.
/// If that channel ever goes `async`, this is the reason to revisit.
[extern("node:crypto", "createHash")]
external fun create_hash(algorithm: str): Hash;

impl Hash {
	[extern(method, "update")]
	external fun update(self, data: str): Hash;

	[extern(method, "digest")]
	external fun digest(self, encoding: str): str;
}

/// RFC 6455 §4.2.2: the `Sec-WebSocket-Accept` proof — base64(SHA-1(key+GUID)).
fun ws_accept_key(key: str): str {
	create_hash("sha1").update(key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11").digest("base64")
}

// --- Service: an rpc mount installed on a `ServerBuilder` (fullstack-dx.md §4) -

/// What the app proved about a connection before the socket went up — the
/// identity half of `transport-rpc.md` Q4, carried into the factory as
/// `Connection.session`. A service with no `authorize` hook sees
/// `Session::anonymous()`; the app decides what more a connection's identity
/// means by looking `identity` up in the instance the factory builds.
struct Session {
	/// The app's name for whoever is on the other end — a user id, a subject
	/// claim. Empty when nothing authorized this connection.
	identity: str,
	/// The credential the identity was proved with, kept for apps that must
	/// re-present it downstream. Empty when there was none.
	credential: str,
}

impl Session {
	/// A connection nothing authorized: no identity, no credential.
	fun anonymous(): Session {
		Session { identity = "", credential = "" }
	}

	/// The ordinary `authorize` result: this connection is `identity`.
	fun of(identity: str): Session {
		Session { identity = identity, credential = "" }
	}

	/// `of`, keeping the credential the identity was proved with.
	fun with_credential(own self, credential: str): Session {
		self.credential = credential;
		self
	}

	/// Whether anything authorized this connection.
	fun is_anonymous(self): bool {
		self.identity == ""
	}
}

/// One connected client, as the factory sees it: the connection id the rest of
/// the layer keys by (the same id `on_connect`/`on_disconnect` carry and the
/// generated `__attach` is called with), the session `authorize` proved, and
/// the peer's address (`""` when the host does not report one — and the
/// PROXY's address behind a proxy).
struct Connection {
	id: i32,
	session: Session,
	remote_addr: str,
}

/// One rpc service mounted on a `Server`: the protocol, where its routes
/// live, and what happens to a connection's per-connection state. The routes
/// (`{mount}events`, `{mount}send`, `{mount}rpc`) and the upgrade handshake
/// are installed together, because a duplex service is both —
/// `ServerBuilder::with_service` folds both in at `build()`, in front of
/// `on_request`/`on_upgrade` (§4.3).
///
/// A connection ends when its stream closes (tab closed, network gone): the
/// wire is forgotten here, and `on_disconnect(id)` tells the app to drop its
/// own per-connection state (dispose a `ReactiveServer` session, say) —
/// otherwise a long-running server leaks a session per ever-connected client.
struct Service {
	/// The protocol THIS connection is answered by. `Service::new` hands every
	/// connection the same one; `Service::factory` builds a fresh service
	/// instance per connection and returns its dispatcher's protocol (Q9).
	build_protocol: |Connection| RpcProtocol,
	/// The one protocol, for a service that HAS one without a connection —
	/// `Service::new` only. It is what the connectionless `{mount}rpc` POST
	/// leg answers from; `None` under `factory`, which has no instance to
	/// answer with until a connection exists.
	shared: Option<RpcProtocol>,
	codec: Codec,
	mount: str,
	on_connect: |i32, DuplexEnd| void,
	on_disconnect: |i32| void,
}

impl Service {
	/// The `Client::connect` service (`transport-rpc.md` §4.2): the runtime
	/// session registry as the connection lifecycle — every connection gets a
	/// reactive session the generated `__attach` route can answer from,
	/// disposed on disconnect. Mounted at `/` until `.at(prefix)` says
	/// otherwise.
	///
	/// The STATELESS shorthand: one process-wide instance behind one protocol,
	/// shared by every client. `Service::factory(|_connection| shared, codec)`
	/// is the same service written the long way — reach for `factory` the
	/// moment a method needs to know who called.
	fun new(protocol: RpcProtocol): Service {
		Service {
			build_protocol = |_connection| protocol,
			shared = Some(protocol),
			codec = protocol.codec,
			mount = "/",
			on_connect = |connection, wire| register_session(connection, wire, protocol.codec),
			on_disconnect = |connection| drop_session(connection),
		}
	}

	/// One service INSTANCE per connected client (`transport-rpc.md` Q9: the
	/// struct instance IS the connection's session). `build` is called once
	/// per connection, with that connection's `Connection` — its id, what
	/// `authorize` proved about it, and where it came from — and the instance
	/// it returns owns every route for that connection and nothing else:
	///
	/// ```text
	/// Service::factory(|connection| Store::open(connection.session.identity, db), json_codec())
	/// ```
	///
	/// Two consequences worth stating. A method can finally learn who called,
	/// because the answer is a field of the `self` its route closed over
	/// rather than a parameter the caller supplies. And `[expose]`d fields
	/// become per-client for free: each instance has its own cells, so each
	/// connection's `__attach` mints channels over that client's own sources.
	///
	/// The instance is dropped with the connection: `on_disconnect` releases
	/// the reactive session, and the dispatcher (with the instance every route
	/// captured) goes with the socket that held it.
	///
	/// The connectionless `{mount}rpc` POST leg has no connection to build
	/// for, so a factory service refuses it (501) — a factory service is
	/// reached over the WebSocket transport, which every generated
	/// `Client::connect` uses.
	fun factory<S: RpcService>(build: |Connection| S, codec: Codec): Service {
		Service {
			build_protocol = |connection| build(connection).dispatcher_for().into_protocol(codec),
			shared = None,
			codec = codec,
			mount = "/",
			on_connect = |connection, wire| register_session(connection, wire, codec),
			on_disconnect = |connection| drop_session(connection),
		}
	}

	/// Mount under `prefix` instead of `/`. A prefix is what lets two services
	/// coexist, and what `Client::connect(url, codec)` already supplies —
	/// pass the same string on both sides (e.g. `"/admin/"`, trailing slash
	/// included: routes are formed by plain concatenation, `{mount}events`).
	fun at(own self, prefix: str): Service {
		self.mount = prefix;
		self
	}

	/// Replace the connection lifecycle, for apps holding custom
	/// per-connection state (an auth identity, an app-written attach).
	fun on_connect(own self, handler: |i32, DuplexEnd| void): Service {
		self.on_connect = handler;
		self
	}

	fun on_disconnect(own self, handler: |i32| void): Service {
		self.on_disconnect = handler;
		self
	}
}

impl ServerBuilder {
	/// Install an rpc service. Repeatable. Its routes answer before
	/// `on_request`, independently of the order these calls were written —
	/// longest mount first, computed at `build()` (§4.3).
	fun with_service(own self, service: Service): ServerBuilder {
		self.services.push(service);
		self
	}
}

// --- The connection registry: a duplex wire per client --------------------------

/// Live SplitDuplex connections: each client's wire-side `DuplexEnd`, keyed by the
/// connection id announced on its SSE stream.
let connections: Shared<List<(i32, DuplexEnd)>> = Shared::new([]);

/// Connection ids — module-level, one counter for the program.
let next_connection: Shared<i32> = Shared::new(0);

fun fresh_connection(): i32 {
	let id = next_connection.read();
	next_connection.write() = id + 1;
	id
}

// --- The fold: `Service`s answer before `on_request`/`on_upgrade` (§4.3) -------

/// A path targets exactly `route`: itself, or `route` followed by a query
/// string — a path-SEGMENT match, not a prefix one, so a mount's `…/rpc`
/// route does not also claim `…/rpcs` (§10.8's fix for the old
/// `path.starts_with(…)` collision).
fun path_matches_route(path: str, route: str): bool {
	path == route || path.starts_with(route + "?")
}

/// Longest mount first — the tiebreak §4.3 gives so two services (`/` and
/// `/admin/`, say) are checked in the same order whichever order
/// `.with_service` was called in. Stable, so services sharing a mount length
/// keep their registration order.
fun services_by_mount(services: List<Service>): List<Service> {
	services.sort_by(|a, b| {
		if a.mount.len() > b.mount.len() {
			Ordering::Less
		} else if a.mount.len() < b.mount.len() {
			Ordering::Greater
		} else {
			Ordering::Equal
		}
	})
}

/// One connected service's SSE route: announce the connection, hand the app
/// its `DuplexEnd`, and forward inbound wire frames to the stream.
fun events_response(service: Service): Response {
	let id = fresh_connection();
	let on_connect = service.on_connect;
	let on_disconnect = service.on_disconnect;
	Response::builder()
		.set_header("Content-Type", "text/event-stream")
		.set_header("Cache-Control", "no-cache")
		.streaming(|stream| {
			stream.send(i"data: __conn:{id}\n\n");
			let (app_end, wire_end) = duplex_pair();
			wire_end.on_frame(|frame| {
				match frame {
					Frame::Text(let body) => stream.send(i"data: {body}\n\n"),
					// SSE can't carry bytes. Unreachable when both sides
					// run one codec: a binary codec's client panics on its
					// first send, before the server ever pushes.
					Frame::Binary(let _bytes) => {},
				}
			});
			connections.write().push((id, wire_end));
			stream.on_close(|| {
				drop_connection(id);
				on_disconnect(id);
			});
			on_connect(id, app_end);
		})
		.build()
}

/// One connected service's send route: forward the body to the addressed
/// connection's wire (§4.4 — the connection id space is process-wide, shared
/// by every mounted service, so this needs no service-specific state at all).
fun send_response(request: Request): Response {
	let content = request.body();
	// A garbled id parses to -1, which matches no connection — the frame is
	// dropped, same as an unknown id.
	let target = connection_id_of(request.path()).parse_i32().unwrap_or(0 - 1);
	for entry in connections.read() {
		let (id, wire) = entry;
		if id == target {
			// the wire turn: the frame's signal writes coalesce
			batch(|| {
				wire.send(Frame::Text(content));
			});
		}
	}
	Response::builder().code(204).body("").build()
}

/// One connected service's rpc route: the body as bytes, no sniffing — the
/// JSON codec's reader accepts a binary frame as UTF-8 (both sides run one
/// codec, Q6).
///
/// A POST carries no connection, so a service that builds one instance per
/// connection (`Service::factory`) has nothing to answer it with — no
/// instance, no session, no identity. That is refused in as many words rather
/// than silently answered by some other client's instance.
fun rpc_frame_response(service: Service, request: Request): Response {
	match service.shared {
		Some(let protocol) => {
			let reply = turn(FlushPolicy::AtEnd, || protocol.respond(Frame::Binary(request.bytes())));
			match reply {
				Frame::Text(let frame) => Response::builder().set_header("Content-Type", "application/json").body(frame).build(),
				Frame::Binary(let frame) => Response::builder().set_header("Content-Type", "application/octet-stream").body_bytes(frame).build(),
			}
		},
		None => Response::builder().code(501).body("this service builds one instance per connection (Service::factory), and a POST rpc frame carries no connection to build for — connect over the WebSocket transport instead").build(),
	}
}

/// `service`'s answer to `request`, if its routes claim the path — `None`
/// when the path is not this service's.
fun service_response(service: Service, request: Request): Option<Response> {
	let path = request.path();
	if path_matches_route(path, service.mount + "events") {
		Some(events_response(service))
	} else if path_matches_route(path, service.mount + "send") {
		Some(send_response(request))
	} else if path_matches_route(path, service.mount + "rpc") {
		Some(rpc_frame_response(service, request))
	} else {
		None
	}
}

/// The first (longest-mount) service that claims `request`, if any.
fun services_answer(services: List<Service>, request: Request): Option<Response> {
	mut answer: Option<Response> = None;
	for service in services {
		if answer.is_none() {
			answer = service_response(service, request);
		}
	}
	answer
}

/// Compose `services`' routing in front of `fallback`: rule 1's "services
/// first, then `on_request`, always" (§4.3), independent of the order
/// `.with_service` was called in.
fun fold_service_requests(
	services: List<Service>,
	fallback: async |Request| Response,
): async |Request| Response {
	let sorted = services_by_mount(services);
	|request| {
		match services_answer(sorted, request) {
			Some(let response) => response,
			None => fallback(request),
		}
	}
}

/// The first (longest-mount) service whose mount the upgrade request's path
/// targets, if any (§4.4: one multiplexed socket per connection, so the
/// upgrade path — not a per-route suffix — is what a mount claims).
fun service_for_upgrade(services: List<Service>, request: NodeRequest): Option<Service> {
	let path = request.url();
	mut answer: Option<Service> = None;
	for service in services {
		if answer.is_none() && path_matches_route(path, service.mount) {
			answer = Some(service);
		}
	}
	answer
}

/// Compose `services`' upgrade handshakes into one dispatcher: picks the
/// matching service by longest mount and runs its handshake (§4.4); an
/// upgrade no service claims falls to `fallback` if the app installed one,
/// and is destroyed otherwise — same as an unrecognized handshake today.
/// With no services at all, `fallback` is returned untouched, so a plain
/// `Server::builder()` with no `.with_service` calls installs no upgrade
/// listener beyond what the app asked for, exactly as before this layer
/// existed.
fun fold_service_upgrades(
	services: List<Service>,
	fallback: Option<|NodeRequest, NodeSocket, Bytes| void>,
): Option<|NodeRequest, NodeSocket, Bytes| void> {
	if services.len() == 0 {
		fallback
	} else {
		let sorted = services_by_mount(services);
		Some(|request, socket, head| {
			match service_for_upgrade(sorted, request) {
				Some(let service) => accept_socket(request, socket, head, service),
				None => match fallback {
					Some(let handler) => handler(request, socket, head),
					None => socket.destroy(),
				},
			}
		})
	}
}

/// Perform the RFC 6455 handshake and wire the socket into the connection
/// registry. Client→server text frames route by channel prefix (§5's
/// multiplex): `r:<id>:<frame>` is an RPC turn answered on the same socket
/// with the same id, `d:<frame>` is a duplex/reactive wire turn. Pings are
/// answered; close (or a protocol violation) tears the session down like an
/// SSE close.
fun accept_socket(request: NodeRequest, socket: NodeSocket, head: Bytes, service: Service) {
	let headers = request.headers();
	if !has_json_field(headers, "sec-websocket-key") {
		socket.destroy();
		ret;
	}
	// Present (checked above) and a string by the WS handshake, so a decode
	// error is impossible; `unwrap_or` keeps the read total.
	let key: str = str::from_json_value(headers.field("sec-websocket-key")).unwrap_or("");
	socket.write_text("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: " + ws_accept_key(key) + "\r\n\r\n");
	let id = fresh_connection();
	// The connection's OWN protocol: under `Service::factory` this builds the
	// instance that answers for this client and nothing else (A38), and every
	// `respond` below routes through it.
	let protocol = (service.build_protocol)(Connection {
		id = id,
		session = Session::anonymous(),
		remote_addr = socket.remote_address(),
	});
	let on_connect = service.on_connect;
	let on_disconnect = service.on_disconnect;
	let (app_end, wire_end) = duplex_pair();
	wire_end.on_frame(|frame| {
		match frame {
			Frame::Text(let body) => socket.write_bytes(text_frame("d:" + body)),
			Frame::Binary(let bytes) => socket.write_bytes(binary_frame(tag_duplex_bytes(bytes))),
		}
	});
	connections.write().push((id, wire_end));
	let closed: Shared<bool> = Shared::new(false);
	let teardown = || {
		if !closed.read() {
			closed.write() = true;
			drop_connection(id);
			on_disconnect(id);
		}
	};
	let parser = WsParser::new();
	let receive = |chunk: Bytes| {
		for event in parser.feed(chunk) {
			match event {
				WsEvent::Text(let frame) => {
					if frame.starts_with("r:") {
						// An RPC turn: answer on this socket with the same id.
						let rest = frame.substring(2, frame.len());
						let parts = rest.split(":");
						let id_text = parts[0];
						// `r:<id>` with no second `:` carries no payload — a
						// malformed frame off the wire, ignored rather than
						// answered. (`r:7:` is the well-formed empty payload.)
						if id_text.len() < rest.len() {
							let payload = rest.substring(id_text.len() + 1, rest.len());
							let reply = turn(FlushPolicy::AtEnd, || protocol.respond(Frame::Text(payload)));
							match reply {
								Frame::Text(let answer) => {
									socket.write_bytes(text_frame(i"r:{id_text}:{answer}"));
								},
								Frame::Binary(let bytes) => {
									let id = id_text.parse_i32().unwrap_or(0 - 1);
									socket.write_bytes(binary_frame(tag_rpc_bytes(id, bytes)));
								},
							}
						}
					} else if frame.starts_with("d:") {
						// the wire turn: the frame's signal writes coalesce
						batch(|| {
							wire_end.send(Frame::Text(frame.substring(2, frame.len())));
						});
					}
				},
				WsEvent::Ping(let payload) => socket.write_bytes(pong_frame(payload)),
				WsEvent::Closed => {
					socket.write_bytes(close_frame());
					socket.destroy();
				},
				// The byte lanes (§5's multiplex, tag form): `0x64` is a duplex
				// frame, `0x72` + 4-byte LE id is an RPC turn answered in kind.
				WsEvent::Binary(let bytes) => {
					if bytes.len() > 0 && bytes.get(0) == 0x64 {
						// the wire turn: the frame's signal writes coalesce
						batch(|| {
							wire_end.send(Frame::Binary(bytes.slice(1, bytes.len())));
						});
					} else if bytes.len() >= 5 && bytes.get(0) == 0x72 {
						let id = bytes.get(1) | bytes.get(2) << 8 | bytes.get(3) << 16 | bytes.get(4) << 24;
						let payload = bytes.slice(5, bytes.len());
						let reply = turn(FlushPolicy::AtEnd, || protocol.respond(Frame::Binary(payload)));
						match reply {
							Frame::Binary(let answer) => {
								socket.write_bytes(binary_frame(tag_rpc_bytes(id, answer)));
							},
							Frame::Text(let answer) => {
								socket.write_bytes(text_frame(i"r:{id}:{answer}"));
							},
						}
					}
				},
			}
		}
	};
	if head.len() > 0 {
		receive(head);
	}
	socket.on_bytes("data", receive);
	socket.on_signal("close", teardown);
	socket.on_signal("error", || socket.destroy());
	socket.write_bytes(text_frame(i"__conn:{id}"));
	on_connect(id, app_end);
}

/// Forget a closed connection's wire (frames already in flight to it are
/// silently dropped by the host — see `NodeResponse.write`).
fun drop_connection(target: i32) {
	mut kept: List<(i32, DuplexEnd)> = [];
	for entry in connections.read() {
		let (id, wire) = entry;
		if id != target {
			kept.push((id, wire));
		}
	}
	connections.write() = kept;
}

/// `/send?c=<id>` → `<id>`.
fun connection_id_of(path: str): str {
	let parts = path.split("c=");
	parts[parts.len() - 1]
}
