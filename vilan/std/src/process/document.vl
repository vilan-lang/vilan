// `std::document` — the HTML document a browser leg is loaded by, held against
// what that leg's build emitted (`fullstack-dx.md` §5.5–§5.6, RATIFIED
// 2026-08-11).
//
// The founding bug: a shell that linked no stylesheet, over a build that emitted
// one. Nothing failed. The page rendered — unstyled, and correct-looking — and
// shipped. It is one of a family (§5.1's F1–F6) that share a single root, *a
// fact the build knew, restated by hand in an HTML file, with nothing comparing
// the two copies*: a `<link>` for a stylesheet that no longer exists, a
// `<script src>` naming a leg that was renamed, a mount `<div id>` that drifted
// from `mount_root(id, …)`, a `type="module"` over a leg that splits. Every one
// of them is silent today, and the loudest of them costs one console line.
//
// `std::build` made the build's own knowledge reachable (`LegBuild`). This
// module compares a document against it.
//
// **Validation is the primitive; generation is sugar over it** (§5.6). A
// generator only protects documents it generated, and the person who most needs
// the check is exactly the one who dropped to a hand-written shell — for a CSP
// header, a font preload, an analytics snippet. So the primitive, `check_shell`,
// takes a plain `str`: a shell read from disk, templated, or fetched from a CMS.
// `Document` is a value over the same rules, and `Document::from_shell` is the
// rung-0 escape hatch made safe — the markup is yours, and we will still tell
// you when it is wrong. The `head`/`body` hatches are the same doctrine one
// rung further: raw markup, still checked — at `html()`, where the page is
// assembled, on a generated document (E70) and on a supplied shell alike
// (E77, where the markup splices in before the shell's own closing tags).
//
// **How loud is loud** (§10.7, ruled): a fault stops the server from STARTING,
// naming the file, the fault and the fix. That is defensible precisely because
// the check is cheap, total, and about the BUILD rather than about a request —
// it cannot fail intermittently, and a server that starts with a document that
// cannot work is worse than one that does not start. `check_shell` returns a
// `Result`, so an application that genuinely means it says so, once, in code.

import pkg::build::LegBuild;
import pkg::fs;
import pkg::io::panic;
import pkg::option::Option::{ None, Some, self };
import pkg::result::Result::{ Err, Ok, self };
import pkg::ui;
import pkg::ui::{ View, escape_attribute, escape_text };

/// The mount element's id when nothing says otherwise — what every shell in
/// this tree uses, and the other end of `mount_root("app", …)`.
let default_mount: str = "app";

/// What is wrong between a document and the build it loads. Each variant is one
/// of `fullstack-dx.md` §5.1's failures, and each was silent before this check
/// existed.
///
/// The payload is always the thing the fault is ABOUT — the file the build
/// emitted, or the url the document named — so a report can quote it back.
enum ShellFault {
	/// The build emitted styles and the document links no stylesheet (F1) — the
	/// owner's own bug, and the reason this module exists. The payload is the
	/// sidecar the build wrote.
	StylesNotLinked(str),
	/// The document links a stylesheet in this leg's namespace that the build
	/// did not emit (F2) — what deleting the last `const style()` leaves
	/// behind. The payload is the `href`.
	LinkedStyleMissing(str),
	/// The document loads a script in this leg's namespace that the build did
	/// not emit (F3) — a chunk that stopped being written, a bundle under an
	/// old name. The payload is the `src`.
	ScriptNotEmitted(str),
	/// This build's bundle is loaded by no `<script>` in the document (F3): the
	/// page ships without its own application. The payload is the bundle.
	BundleNotLoaded(str),
	/// No element carries the id the client mounts into (F4) — the failure that
	/// reads as `Cannot read properties of null` at boot. The payload is the
	/// id.
	MountMissing(str),
	/// The leg splits and its bundle is loaded as a module script (F6), so
	/// chunk resolution will miss on every nested route. The payload is the
	/// bundle.
	ModuleScriptWithChunks(str),
}

impl ShellFault {
	/// One line: what is wrong, and what to do about it.
	///
	/// The document's own name is deliberately not in here — a fault is about
	/// MARKUP, and markup arrives from anywhere — so a caller that knows where
	/// its markup came from says so itself (`require_shell` names the file it
	/// read).
	fun message(self): str {
		match self {
			ShellFault::StylesNotLinked(let file) => i"the build emitted the stylesheet {file} and this document links no stylesheet — add `<link rel=\"stylesheet\" href=\"/{file}\" />` inside <head>",
			ShellFault::LinkedStyleMissing(let href) => i"this document links {href}, which this build did not emit — remove the link, or restore the styles it names (a leg with no `const style()` emits no stylesheet at all)",
			ShellFault::ScriptNotEmitted(let src) => i"this document loads {src}, which this build did not emit — remove the script tag, or restore the build that wrote it",
			ShellFault::BundleNotLoaded(let file) => i"this build's bundle {file} is loaded by no script in this document — add `<script src=\"/{file}\"></script>` before </body>",
			ShellFault::MountMissing(let id) => i"no element in this document carries id=\"{id}\", which is where the client mounts — add `<div id=\"{id}\"></div>` inside <body>",
			ShellFault::ModuleScriptWithChunks(let file) => i"{file} is loaded as a module script and this leg SPLITS — chunk resolution reads `document.currentScript`, which is null in a module, so every nested route would fail to load its chunk; drop `type=\"module\"` from its script tag",
		}
	}
}

/// Check a hand-authored shell against a leg's build.
///
/// EVERY fault, not the first — a shell with two problems should report two,
/// because a boot-time check that reports one costs a restart per problem. The
/// order is fixed (styles, scripts, mount), so two runs over the same shell
/// report the same list.
///
/// What it checks is what a build KNOWS, which is also what bounds it. This
/// leg's artifacts are `<leg>.js`, `<leg>.css` and `<leg>.<Arm>.js`: the leg's
/// last build owns that namespace (`bundle-splitting.md` Appendix A), so a
/// document loading `<leg>.…` files this build did not emit is loading its own
/// stale output and is told so. A `/theme.css` the application serves itself is
/// outside the namespace and outside this check's knowledge — it says nothing
/// about it, which is the only honest answer and the one that keeps a refusal
/// to boot sound.
fun check_shell(shell: str, build: LegBuild, mount: str): Result<void, List<ShellFault>> {
	mut stylesheets: List<str> = [];
	mut scripts: List<Tag> = [];
	mut mounted = false;
	for tag in tags_of(shell) {
		if tag.name == "link" && is_stylesheet_rel(attribute(tag, "rel")) {
			stylesheets.push(attribute(tag, "href"));
		}
		if tag.name == "script" && attribute(tag, "src") != "" {
			scripts.push(tag);
		}
		if mount != "" && attribute(tag, "id") == mount {
			mounted = true;
		}
	}

	mut faults: List<ShellFault> = [];

	// F1 — the build emitted a stylesheet and nothing links it.
	match build.styles {
		Some(let sidecar) => {
			mut linked = false;
			for href in stylesheets {
				if is_local(href) && file_name_of(href) == sidecar {
					linked = true;
				}
			}
			if !linked {
				faults.push(ShellFault::StylesNotLinked(sidecar));
			}
		},
		None => {},
	}

	// F2 — a link into this leg's namespace that the build did not write.
	for href in stylesheets {
		let file = file_name_of(href);
		if is_local(href) && leg_owns(build, file) && !is_emitted_style(build, file) {
			faults.push(ShellFault::LinkedStyleMissing(href));
		}
	}

	// F3 — the scripts: what is loaded that was not emitted, and whether the
	// bundle is loaded at all. F6 rides on the bundle's own tag.
	mut loads_bundle = false;
	for script in scripts {
		let src = attribute(script, "src");
		if is_local(src) {
			let file = file_name_of(src);
			if file == build.bundle {
				loads_bundle = true;
				if build.classic_script && attribute(script, "type").to_lowercase_ascii() == "module" {
					faults.push(ShellFault::ModuleScriptWithChunks(build.bundle));
				}
			} else if leg_owns(build, file) && !is_emitted_chunk(build, file) {
				faults.push(ShellFault::ScriptNotEmitted(src));
			}
		}
	}
	if !loads_bundle {
		faults.push(ShellFault::BundleNotLoaded(build.bundle));
	}

	// F4 — the mount element, the other end of `mount_root(id, …)`.
	if !mounted {
		faults.push(ShellFault::MountMissing(mount));
	}

	if faults.is_empty() {
		Ok({})
	} else {
		Err(faults)
	}
}

/// The HTML document a browser leg is loaded by, built from what that leg's
/// build emitted — so the `<script>`, the `<link>` and the mount element cannot
/// disagree with the artifacts they name.
///
/// A string builder, not a `View`, and that is a decision (§5.5): a document is
/// not a reactive tree, nothing binds to it, and it is serialized once per
/// request — while a `View`-shaped document would reopen `ssr.md` §6(a)'s
/// ratified fragment-only process layer for no gain.
struct Document {
	/// The build this document loads: every generated tag is derived from it,
	/// and a supplied shell was checked against it.
	build: LegBuild,
	/// The markup, when it was supplied (`from_shell`) rather than generated
	/// (`of`) — and checked before this value existed.
	shell: Option<str>,
	/// Where a SUPPLIED shell's markup came from, for the composed page's own
	/// report (E77): `require_shell`'s file path, or `from_shell`'s generic
	/// name for markup that arrived as a value. Empty for a generated
	/// document, whose report names the document itself.
	source: str,
	/// The `<title>`'s text. Empty until `title()` says otherwise: a document
	/// that was not given one has no title rather than an invented one.
	title: str,
	/// `<html lang>`.
	lang: str,
	/// The mount element's id, for a generated document.
	mount: str,
	/// Raw markup appended inside `<head>`.
	head: str,
	/// Raw markup appended inside `<body>`, before the script tag.
	body: str,
	/// Server-rendered markup for the mount element (`render`), empty for a
	/// document that ships unrendered.
	rendered: str,
	/// For a SUPPLIED shell, where that markup goes: the index just past the
	/// mount element's start tag, located by the check itself (§5.8) — so
	/// nothing later can move the splice somewhere the check never looked.
	splice: i32,
}

impl Document {
	/// The default document for a build: doctype, `<html lang>`, charset,
	/// viewport, `<title>`, the stylesheet link IF AND ONLY IF the build
	/// emitted styles, the mount element, and the bundle's script tag in the
	/// form the build requires — a module script, or a classic one for a leg
	/// that splits (§3.5, F6).
	///
	/// Opinionated and small, and bounded by §10.1's ruling: the intersection
	/// of the shells this repository ships, each of which is reconstructible
	/// from it plus the `head`/`body` escape hatches. Everything it emits
	/// itself is derived from the build, which is what makes the guarantee
	/// true by construction — every document this can produce passes
	/// `check_shell`. The hatches take raw markup that could break that
	/// guarantee, so `html()` holds a page carrying any to the same rules
	/// (E70) rather than trusting it.
	fun of(build: LegBuild): Document {
		Document {
			build = build,
			shell = None,
			source = "",
			title = "",
			lang = "en",
			mount = default_mount,
			head = "",
			body = "",
			rendered = "",
			splice = 0,
		}
	}

	/// A hand-authored shell, CHECKED: the rung-0 escape hatch made safe — the
	/// same `Document` value, its markup supplied rather than generated. The
	/// `head`/`body` hatches compose into it too, spliced in before its
	/// `</head>`/`</body>` when `html()` writes the page — and checked there
	/// (E77).
	///
	/// The mount element is `"app"`, which is what every shell in this tree
	/// uses. A shell that mounts elsewhere calls `check_shell(shell, build,
	/// id)` directly and serves its own string: the primitive is public
	/// precisely so that dropping a rung never drops the check.
	fun from_shell(shell: str, build: LegBuild): Result<Document, List<ShellFault>> {
		match check_shell(shell, build, default_mount) {
			Ok(let _checked) => Ok(Document { build = build, shell = Some(shell), source = "this supplied shell", title = "", lang = "en", mount = default_mount, head = "", body = "", rendered = "", splice = splice_point(shell, default_mount) }),
			Err(let faults) => Err(faults),
		}
	}

	/// The `<title>`'s text, escaped when the document is written.
	fun title(own self, title: str): Document {
		self.title = title;
		self
	}

	/// The document's language (`<html lang>`).
	fun lang(own self, lang: str): Document {
		self.lang = lang;
		self
	}

	/// The mount element's id — the other end of `mount_root(id, …)`. Defaults
	/// to `"app"`, which is what every shell in this tree uses.
	///
	/// This is about a GENERATED document. A supplied shell's mount element is
	/// the one `from_shell`'s check located, and nothing here moves it — a
	/// splice into an element the check never saw is exactly the silence this
	/// module exists to remove.
	fun mount(own self, id: str): Document {
		self.mount = id;
		self
	}

	/// Raw markup appended inside `<head>`: a favicon, an `og:` tag, a CSP, an
	/// inline `<style>` for the page frame. Repeatable — each call appends.
	/// On a generated document it lands inside the `<head>` the document
	/// writes; on a supplied shell it splices in immediately before the
	/// shell's own `</head>` (E77) — a shell that carries no `</head>` stops
	/// at `html()` rather than having the markup guessed into it.
	///
	/// It is raw on purpose (that is what an escape hatch is), and it is not an
	/// exemption: when the page is written, `html()` runs the assembled markup
	/// through the same `check_shell` rules as anything else, so a `<link>`
	/// here to a stylesheet the build did not emit stops the boot exactly as
	/// it would in a hand-written shell.
	fun head(own self, markup: str): Document {
		self.head = self.head + markup;
		self
	}

	/// Raw markup appended inside `<body>` — before the script tag on a
	/// generated document, immediately before the shell's own `</body>` on a
	/// supplied one (E77). Repeatable. An escape hatch like `head`, and
	/// checked at `html()` like it too.
	fun body(own self, markup: str): Document {
		self.body = self.body + markup;
		self
	}

	/// Server-rendered markup for the mount element (`ssr.md` §1) — the splice,
	/// with no marker string in it (§5.8).
	///
	/// The document already knows where the mount element is, so the markup goes
	/// INSIDE it by construction and there is nothing to spell wrong: the
	/// `<!--ssr-->` convention it replaces was a string literal in `.vl` that
	/// had to equal a string literal in `.html`, whose mismatch was a silent
	/// no-op observed only by a crawler.
	///
	/// The one method here that takes `self` rather than `own self`, because it
	/// is the one called PER REQUEST: a handler builds the document once at
	/// boot and renders a fresh view into a copy of it for each response —
	/// create, serialize, discard.
	fun render(self, view: View): Document {
		mut rendered = self;
		rendered.rendered = ui::render(view);
		rendered
	}

	/// The document as markup. A `str`, not a `Response` (§5.5): the
	/// application decides the status code, the headers, and which paths get
	/// it. A document that knew about HTTP would have to know about routing,
	/// and then it is a framework.
	///
	/// This is also where the `head`/`body` escape hatches meet the rules
	/// (E70, §16.10; E77, §16.12): a page carrying hatch markup runs through
	/// `check_shell` before it is handed back, and a fault stops the boot —
	/// every fault and its fix, exactly as a hand-written shell's would. That
	/// holds at both rungs: a generated page is checked as assembled, and a
	/// supplied shell as COMPOSED — its own bytes plus the spliced hatch
	/// markup — because `from_shell`'s check covered the shell alone. A page
	/// with no hatch markup runs no check at all: the generated one is
	/// derived from the build and cannot fail, and the supplied one is the
	/// shell `from_shell` already accepted, byte for byte (plus the render
	/// splice).
	fun html(self): str {
		match self.shell {
			// Supplied: its own bytes, composed — the render spliced into the
			// mount element the check located, and any hatch markup spliced
			// in before the closing tag it aims at (E77).
			Some(let markup) => {
				let composed = self.composed(markup);
				// The same rule as the generated arm below, at the same
				// moment: hatch markup is raw and can break what
				// `from_shell`'s check proved, so a page carrying any is
				// re-checked whole. The mount id is the one `from_shell`
				// located — `mount()` documents that it does not move a
				// supplied shell's mount, so the check does not read it
				// either.
				if self.head != "" || self.body != "" {
					match check_shell(composed, self.build, default_mount) {
						Ok(let _checked) => {},
						Err(let faults) => panic(fault_report(i"{self.source} composed with this document's `head`/`body` markup", self.build, faults)),
					}
				}
				composed
			},
			None => {
				let markup = self.generated();
				// The escape hatches are raw markup, and raw markup can be
				// wrong (§5.6) — so a page carrying any faces the same
				// `check_shell` a hand-written shell faces. The emptiness
				// test is the whole cost of the hatch-less path: no check,
				// no re-reading of the page's own output, the same bytes.
				if self.head != "" || self.body != "" {
					match check_shell(markup, self.build, self.mount) {
						Ok(let _checked) => {},
						Err(let faults) => panic(fault_report("this generated document's `head`/`body` markup", self.build, faults)),
					}
				}
				markup
			},
		}
	}

	/// The generated document — §5.5's default, written out.
	fun generated(self): str {
		mut markup = "<!doctype html>\n";
		markup = markup + i"<html lang=\"{escape_attribute(self.lang)}\">\n";
		markup = markup + "\t<head>\n";
		markup = markup + "\t\t<meta charset=\"utf-8\" />\n";
		markup = markup + "\t\t<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n";
		markup = markup + i"\t\t<title>{escape_text(self.title)}</title>\n";
		// If and only if the build emitted styles — the whole of F1 and F2, on
		// the generating side.
		match self.build.styles {
			Some(let sidecar) => markup = markup + i"\t\t<link rel=\"stylesheet\" href=\"/{sidecar}\" />\n",
			None => {},
		}
		if self.head != "" {
			markup = markup + "\t\t" + self.head + "\n";
		}
		markup = markup + "\t</head>\n";
		markup = markup + "\t<body>\n";
		markup = markup + i"\t\t<div id=\"{escape_attribute(self.mount)}\">{self.rendered}</div>\n";
		if self.body != "" {
			markup = markup + "\t\t" + self.body + "\n";
		}
		markup = markup + "\t\t" + script_tag(self.build) + "\n";
		markup + "\t</body>\n</html>\n"
	}

	/// The supplied shell with this document's own markup spliced in: the
	/// render inside the mount element `from_shell`'s check located (§5.8),
	/// `head()`'s markup immediately before the shell's `</head>`, and
	/// `body()`'s immediately before its `</body>` (E77). The closing tags
	/// are read the way the check reads markup — a `</head>` inside a
	/// comment or a script body is no splice point, for the same reason it
	/// is no closing tag to a browser.
	///
	/// The check guarantees the mount element and the bundle's script tag,
	/// NOT the closing tags — a browser tolerates their absence — so a shell
	/// `from_shell` accepted can still lack the tag a used hatch aims at.
	/// That stops here, naming every missing tag rather than the first
	/// (§5.6's doctrine): the markup has nowhere to land, and guessing a
	/// position would put it somewhere the author cannot see. A document
	/// with no render and no hatch markup composes to the shell's own bytes,
	/// untouched.
	fun composed(self, shell: str): str {
		mut insertions: List<(i32, str)> = [];
		mut missing: List<str> = [];
		if self.rendered != "" {
			insertions.push((self.splice, self.rendered));
		}
		if self.head != "" {
			match closing_point(shell, "head") {
				Some(let at) => insertions.push((at, self.head)),
				None => missing.push(missing_closing_tag(self.source, "head")),
			}
		}
		if self.body != "" {
			match closing_point(shell, "body") {
				Some(let at) => insertions.push((at, self.body)),
				None => missing.push(missing_closing_tag(self.source, "body")),
			}
		}
		if !missing.is_empty() {
			mut report = "";
			for problem in missing {
				report = if report == "" {
					problem
				} else {
					report + "\n" + problem
				};
			}
			panic(report);
		}
		spliced(shell, insertions)
	}
}

/// The bundle's script tag, in the form the build requires (§3.5): a classic
/// script exactly when the leg splits, because chunk resolution reads
/// `document.currentScript` and a module script has none.
fun script_tag(build: LegBuild): str {
	if build.classic_script {
		i"<script src=\"/{build.bundle}\"></script>"
	} else {
		i"<script type=\"module\" src=\"/{build.bundle}\"></script>"
	}
}

/// Where server-rendered markup goes in a supplied shell: just past the mount
/// element's start tag, i.e. its first child position. `0` when the shell has no
/// such element — unreachable through `from_shell`, whose check refuses a shell
/// that does not carry the mount id.
fun splice_point(shell: str, mount: str): i32 {
	for tag in tags_of(shell) {
		if attribute(tag, "id") == mount {
			ret tag.end;
		}
	}
	0
}

/// Where hatch markup destined for inside an element goes in a supplied
/// shell: the index of the shell's first `</name>` — insertion happens BEFORE
/// the closing tag — or `None` when the shell carries no such tag (E77).
fun closing_point(shell: str, name: str): Option<i32> {
	for tag in tags_of(shell) {
		if tag.closing && tag.name == name {
			ret Some(tag.start);
		}
	}
	None
}

/// A used hatch with no closing tag to land before — the compose-time
/// refusal's one line per missing tag (E77). Both fixes are real: give the
/// shell the tag, or give the markup to the shell.
fun missing_closing_tag(source: str, name: str): str {
	i"{source} has no </{name}> for this document's {name}() markup to splice before — add </{name}> to the shell, or write the markup into the shell itself"
}

/// `text` with each insertion's markup spliced in at its index. The indices
/// are into the ORIGINAL text; insertions apply in ascending index order, and
/// two at the same index keep their list order.
fun spliced(text: str, insertions: List<(i32, str)>): str {
	// A stable sort by index — at most three insertions ever arrive, so the
	// quadratic count is fine and the clarity is not.
	mut ordered: List<(i32, str)> = [];
	for insertion in insertions {
		let (at, _markup) = insertion;
		mut index = 0;
		for entry in ordered {
			let (before, _before_markup) = entry;
			if before <= at {
				index = index + 1;
			}
		}
		ordered.insert(index, insertion);
	}
	mut result = "";
	mut cursor = 0;
	for entry in ordered {
		let (at, markup) = entry;
		result = result + text.substring(cursor, at) + markup;
		cursor = at;
	}
	result + text.substring(cursor, text.len())
}

/// The shell at `path`, read and checked against `build` — or a stop naming the
/// file, every fault and its fix. The server-boot idiom, and §10.7's "refuse to
/// boot" doctrine spelled once.
///
/// It is an addition beyond §5.6's sketch, for two reasons. The language one is
/// `require_build`'s (§12.4): `Document::from_shell(…)!` cannot be written in
/// the `async fun main()` every server has, because `!` asserts-or-RETURNS and a
/// void `main` has no residual to carry. The better one is the message — a
/// `ShellFault` is about markup and cannot know where the markup came from,
/// while the founding bug's report wants to say `src/app.html` first.
fun require_shell(path: str, build: LegBuild): Document {
	match Document::from_shell(fs::read_file_to_str(path), build) {
		Ok(let document) => {
			// The document knows where its markup came from, so the composed
			// page's own report (E77) can say the file's name first too.
			mut named = document;
			named.source = path;
			named
		},
		Err(let faults) => panic(fault_report(path, build, faults)),
	}
}

/// The markup from `source` does not match `build`, spelled for a person: the
/// source, the leg, and one line per fault. `source` is where the markup came
/// from — `require_shell`'s file path, or `html()`'s name for the hatch
/// markup it checked (the generated document's own, or the supplied shell
/// composed with it) — because a `ShellFault` is about markup and cannot
/// know that itself.
fun fault_report(source: str, build: LegBuild, faults: List<ShellFault>): str {
	mut report = i"{source} does not match the `{build.leg}` build:";
	for fault in faults {
		report = report + "\n  - " + fault.message();
	}
	report
}

// --- Reading the markup ---------------------------------------------------

/// One tag, as the scanner found it — opening or closing.
struct Tag {
	/// The tag name, lowercased — `link`, `script`, `div`. A closing tag's
	/// name has its `/` stripped: `</head>` scans as `head` with `closing`
	/// set.
	name: str,
	/// Its attributes in source order, as `(lowercased name, raw value)`.
	/// Always empty for a closing tag — which is also what keeps the checks,
	/// every one attribute-keyed, reading opening tags only.
	attributes: List<(str, str)>,
	/// The index of its `<`. For a closing tag, the last position still
	/// inside the element — the splice point hatch markup wants (E77).
	start: i32,
	/// One past its `>`, i.e. where its content begins — the splice point a
	/// server-rendered document needs (§5.8).
	end: i32,
	/// Whether this is a closing tag (`</head>`).
	closing: bool,
}

/// The value of `tag`'s `name` attribute, or `""` when it carries none. A bare
/// attribute (`<script defer>`) has the empty value too — no check here
/// distinguishes the two, and none should have to.
fun attribute(tag: Tag, name: str): str {
	for entry in tag.attributes {
		let (attribute_name, value) = entry;
		if attribute_name == name {
			ret value;
		}
	}
	""
}

/// Whether a `<link rel>` value names a stylesheet. The attribute is a
/// space-separated, case-insensitive token list (`rel="stylesheet preload"` is
/// legal), so it is read as one rather than compared whole.
fun is_stylesheet_rel(rel: str): bool {
	for token in rel.to_lowercase_ascii().split(" ") {
		if token == "stylesheet" {
			ret true;
		}
	}
	false
}

/// Whether `url` addresses something this build could have emitted — i.e. not
/// another origin. An absolute url, a protocol-relative one and a data url are
/// all somebody else's business, and a check that guessed otherwise would
/// refuse to boot over a font CDN.
fun is_local(url: str): bool {
	!url.contains("://") && !url.starts_with("//") && !url.starts_with("data:")
}

/// The file name `url` addresses: its last path segment, without the query
/// string or fragment a cache-buster adds (`/client.js?v=2` is `client.js`,
/// which is also how `serve_build` routes it).
fun file_name_of(url: str): str {
	let path = url.split("?")[0].split("#")[0];
	let segments = path.split("/");
	segments[segments.len() - 1]
}

/// Whether `file` is in this leg's own namespace — the `<leg>.` prefix its
/// build writes and its last build owns (`bundle-splitting.md` Appendix A).
/// This is the boundary of what a fault may be reported about: inside it, a
/// file the build did not emit is this leg's stale output; outside it, the
/// application's own.
fun leg_owns(build: LegBuild, file: str): bool {
	file.starts_with(build.leg + ".")
}

/// Whether `file` is the style sidecar this build emitted.
fun is_emitted_style(build: LegBuild, file: str): bool {
	match build.styles {
		Some(let sidecar) => sidecar == file,
		None => false,
	}
}

/// Whether `file` is one of the route chunks this build emitted.
fun is_emitted_chunk(build: LegBuild, file: str): bool {
	for chunk in build.chunks {
		if chunk == file {
			ret true;
		}
	}
	false
}

/// Every tag in `markup`, in document order — the whole of this module's HTML
/// reading.
///
/// Not a parser: it finds tags and their attributes and skips everything else,
/// because every question asked here is about a tag. Three details are handled
/// rather than approximated, since each one would otherwise produce a WRONG
/// answer instead of a coarse one: a comment is skipped whole, so a
/// commented-out `<link>` links nothing; `<script>` and `<style>` bodies are raw
/// text and are skipped to their closing tag, so `"<div id=\"app\">"` inside a
/// script is not a mount element; and a quoted attribute value may contain `>`.
fun tags_of(markup: str): List<Tag> {
	let length = markup.len();
	mut tags: List<Tag> = [];
	mut index = 0;
	for index < length {
		if markup.substring(index, index + 1) != "<" {
			index = index + 1;
			jump continue;
		}
		if markup.substring(index, index + 4) == "<!--" {
			index = past(index_of(markup, "-->", index + 4), 3, length);
			jump continue;
		}
		let after = markup.substring(index + 1, index + 2);
		// A doctype or a processing instruction: nothing to read off it, so
		// skip to its `>`.
		if after == "!" || after == "?" {
			index = past(index_of(markup, ">", index + 1), 1, length);
			jump continue;
		}
		// A closing tag: no attributes to read, but its position matters —
		// it is where the compose splice aims (E77).
		if after == "/" {
			mut cursor = index + 2;
			for cursor < length && is_name_char(markup.substring(cursor, cursor + 1)) {
				cursor = cursor + 1;
			}
			let name = markup.substring(index + 2, cursor).to_lowercase_ascii();
			let end = past(index_of(markup, ">", cursor), 1, length);
			tags.push(Tag {
				name = name,
				attributes = [],
				start = index,
				end = end,
				closing = true,
			});
			index = end;
			jump continue;
		}
		if !is_name_start(after) {
			// A bare `<` in text — not the start of anything.
			index = index + 1;
			jump continue;
		}
		mut cursor = index + 1;
		for cursor < length && is_name_char(markup.substring(cursor, cursor + 1)) {
			cursor = cursor + 1;
		}
		let name = markup.substring(index + 1, cursor).to_lowercase_ascii();
		let (attributes, end) = attributes_of(markup, cursor);
		tags.push(Tag {
			name = name,
			attributes = attributes,
			start = index,
			end = end,
			closing = false,
		});
		index = if name == "script" || name == "style" {
			skip_raw_text(markup, end, name)
		} else {
			end
		};
	}
	tags
}

/// A found index plus `offset`, or `fallback` when the search came up empty —
/// the "skip past this delimiter, or give up on the rest of the document" step
/// the scanner takes four times.
fun past(found: Option<i32>, offset: i32, fallback: i32): i32 {
	match found {
		Some(let at) => at + offset,
		None => fallback,
	}
}

/// The attributes of the tag whose name ends at `from`, and the index one past
/// its `>`.
fun attributes_of(markup: str, from: i32): (List<(str, str)>, i32) {
	let length = markup.len();
	mut attributes: List<(str, str)> = [];
	mut index = from;
	for index < length {
		let character = markup.substring(index, index + 1);
		if character == ">" {
			ret (attributes, index + 1);
		}
		// Whitespace between attributes, and the `/` of a self-closing tag —
		// whose `>` ends the tag on the next turn.
		if is_space(character) || character == "/" {
			index = index + 1;
			jump continue;
		}
		mut cursor = index;
		for cursor < length && !is_attribute_break(markup.substring(cursor, cursor + 1)) {
			cursor = cursor + 1;
		}
		let name = markup.substring(index, cursor).to_lowercase_ascii();
		index = skip_spaces(markup, cursor);
		mut value = "";
		if markup.substring(index, index + 1) == "=" {
			index = skip_spaces(markup, index + 1);
			let quote = markup.substring(index, index + 1);
			if quote == "\"" || quote == "'" {
				let close = past(index_of(markup, quote, index + 1), 0, length);
				value = markup.substring(index + 1, close);
				index = if close < length {
					close + 1
				} else {
					length
				};
			} else {
				mut end = index;
				for end < length && !is_space(markup.substring(end, end + 1)) && markup.substring(end, end + 1) != ">" {
					end = end + 1;
				}
				value = markup.substring(index, end);
				index = end;
			}
		}
		attributes.push((name, value));
	}
	(attributes, length)
}

/// Past a raw-text element's body (`<script>`, `<style>`): its content is not
/// markup, so the scanner resumes at its closing tag.
fun skip_raw_text(markup: str, from: i32, name: str): i32 {
	// Lowercased for the search only — `to_lowercase_ascii` maps ASCII in
	// place, so the index it reports is an index into `markup` too.
	past(index_of(markup.to_lowercase_ascii(), "</" + name, from), 0, markup.len())
}

/// The first index at or after `from` that is not whitespace.
fun skip_spaces(markup: str, from: i32): i32 {
	let length = markup.len();
	mut index = from;
	for index < length && is_space(markup.substring(index, index + 1)) {
		index = index + 1;
	}
	index
}

/// The index of `needle` in `text` at or after `from`, or `None`. (`str` can
/// answer whether it `contains` something, but not where.)
fun index_of(text: str, needle: str, from: i32): Option<i32> {
	let limit = text.len() - needle.len();
	mut index = if from < 0 {
		0
	} else {
		from
	};
	for index <= limit {
		if text.substring(index, index + needle.len()) == needle {
			ret Some(index);
		}
		index = index + 1;
	}
	None
}

/// Whether `character` can open a tag name.
fun is_name_start(character: str): bool {
	let lower = character.to_lowercase_ascii();
	lower >= "a" && lower <= "z"
}

/// Whether `character` can continue a tag name (`h1`, `font-face`, `svg:use`).
fun is_name_char(character: str): bool {
	is_name_start(character) || (character >= "0" && character <= "9") || character == "-" || character == ":"
}

/// Whether `character` ends an attribute name.
fun is_attribute_break(character: str): bool {
	is_space(character) || character == "=" || character == ">" || character == "/"
}

/// Whether `character` is HTML whitespace.
fun is_space(character: str): bool {
	character == " " || character == "\t" || character == "\n" || character == "\r"
}
