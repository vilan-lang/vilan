import pkg::compare::PartialEq;
import pkg::context::Context;
import pkg::hash::Hashable;
import pkg::native_map::NativeMap;
import pkg::option::Option::{ None, Some, self };
import pkg::result::Result::{ Err, Ok, self };
import pkg::shared::Shared;
import pkg::time::Timer;

/// A resource that can be released. An `Owner` collects `Disposable`s and releases
/// them as a group; `Subscription`, `Owner`, and `std::ui`'s `View` are disposable.
trait Disposable {
	fun dispose(self);
}

/// A registered observer of a signal: `notify` re-runs it when the signal's value
/// changes; `id` lets a `Subscription` find and remove it.
struct Subscriber {
	id: i32,
	notify: || void,
}

/// Monotonic ids for subscribers — module-level, one counter for the program.
let next_subscriber_id: Shared<i32> = Shared::new(0);

fun fresh_id(): i32 {
	let id = next_subscriber_id.read();
	next_subscriber_id.write() = id + 1;
	id
}

// === Turn scheduler (`proposal/reactive-turns.md`) ===
//
// Flush is SCOPED, not global. A `Turn` owns a pending-notification queue and
// is established for a dynamic extent through `turn_scope` (`std::context`),
// so two interleaved extents — two server requests, two event handlers — can
// never drain each other's queues: a `set` commits its value immediately and
// defers the NOTIFICATION into the ambient turn's queue (no ambient turn →
// notify inline, exactly as before; deferral is opt-in at a boundary).
// Context capture-at-creation carries a turn across its own extent's awaits
// while interleaved extents keep theirs.

enum FlushPolicy {
	// Settle when the turn's extent ends — the transactional cadence
	// (server dispatch).
	AtEnd,
	// The optimistic-paint cadence (UI events).
	AtSuspension,
}
// v1 NOTE (reactive-turns.md): for an ASYNC extent the policies converge —
// the sync part settles when `turn`'s body returns (its first suspension),
// and each CONTINUATION segment settles on a microtask right after it runs
// (see `enqueue`'s settled path), coalesced per segment. A true
// held-across-await `AtEnd` needs a `turn` that can await its body
// (recorded follow-on); the enum states intent and keeps the API stable.

/// The host's microtask queue — the continuation-settling primitive.
[extern("queueMicrotask", retains)]
external fun queue_microtask(callback: || void);

struct Turn {
	pending: Shared<List<Subscriber>>,
	// The ids in `pending`, as a keyed set — `enqueue`'s dedup (A44). Kept in
	// exact step with `pending`: cleared when a wave is taken out, scrubbed
	// when a `Subscription` removes itself.
	queued: Shared<NativeMap<bool>>,
	draining: Shared<bool>,
	// True once the extent's own settle ran; a LATE enqueue (an async
	// continuation's write) then schedules its own segment-coalesced drain.
	settled: Shared<bool>,
	scheduled: Shared<bool>,
}

impl Turn {
	fun new(): Turn {
		Turn {
			pending = Shared::new([]),
			queued = Shared::new(NativeMap::new()),
			draining = Shared::new(false),
			settled = Shared::new(false),
			scheduled = Shared::new(false),
		}
	}
}

/// The ambient transaction. Established by `turn`/`batch` (and, at the
/// framework boundaries, `std::ui` event dispatch and the RPC server's
/// per-message dispatch); read by `set` via `get_safe`, so unscoped code
/// pays nothing.
let turn_scope: Context<Turn> = Context::new();

/// Drain affinity — the ONE runtime device in the model. A notify fired
/// during a drain may `set` (a derived recomputing), but that notifier is an
/// arbitrary closure created ANYWHERE (usually outside every extent), so
/// compile-time capture cannot hand it the draining turn. A set that sees no
/// ambient turn joins the CURRENTLY DRAINING one instead — which is what
/// keeps cascades coalescing (dedup) inside their own settle. Drains are
/// synchronous, so entries cannot interleave across extents; this never
/// crosses an `await`.
let draining_turns: Shared<List<Turn>> = Shared::new([]);

/// Enqueue subscribers into `turn`'s queue, deduped by id so a subscriber fed
/// by several inputs in one turn fires once — the dedup *is* the
/// glitch-freeness.
///
/// The membership test is a KEYED SET (A44), not a scan of the pending list.
/// The scan it replaces was linear in the queue's own length and it ran inside
/// `Signal::notify`'s loop, so one write that reached n queued observers cost
/// O(n²) — which is exactly the regime `selector` exists to serve, a thousand
/// rows deep. `queued` holds the ids in `pending` and nothing else, so the
/// semantics are unchanged, one entry per subscriber per wave.
fun enqueue(turn: Turn, subscribers: List<Subscriber>) {
	for subscriber in subscribers {
		let key = subscriber.id.hash();
		if !turn.queued.read().contains_key(key) {
			turn.queued.write().insert(key, true);
			turn.pending.write().push(subscriber);
		}
	}
	// A write AFTER the extent settled — an async continuation's — must not
	// sit forever (and must not settle per-set, which would glitch a
	// multi-input observer): one microtask drains the whole segment's
	// writes together, right after the segment runs.
	if turn.settled.read() && !turn.scheduled.read() && !turn.draining.read() {
		turn.scheduled.write() = true;
		queue_microtask(|| {
			turn.scheduled.write() = false;
			drain(turn);
		});
	}
}

/// Drain `turn` until quiescent — the "settle now" primitive. A notify may
/// enqueue more (a derived propagating), which this same loop drains.
/// Re-entrancy-guarded per turn (a `set` from inside a notify only enqueues;
/// the running loop picks it up) and budget-bounded (a feedback loop that
/// never converges stops here instead of hanging).
fun drain(turn: Turn) {
	if !turn.draining.read() {
		turn.draining.write() = true;
		draining_turns.write().push(turn);
		mut budget = 100000;
		for !turn.pending.read().is_empty() && budget > 0 {
			let wave = turn.pending.read();
			turn.pending.write() = [];
			// The wave is out of the queue, so its ids are free to re-enter it
			// — a cascade re-enqueuing an observer this wave already ran is
			// the propagation `drain`'s loop exists for.
			turn.queued.write() = NativeMap::new();
			for subscriber in wave {
				(subscriber.notify)();
				budget -= 1;
			}
		}
		draining_turns.write().pop();
		turn.draining.write() = false;
	}
}

/// Settle the AMBIENT turn's pending notifies now. With no ambient turn there
/// is nothing pending by construction (every `set` notified inline).
fun flush() {
	match turn_scope.get_safe() {
		Some(let turn) => drain(turn),
		None => {},
	}
}

/// Run `action` when the ambient turn settles; with no ambient turn, now. The
/// action rides the turn's pending queue as an ordinary `Subscriber`, so it is
/// deduped by `id` exactly like a notification — repeated deferrals of the
/// same action inside one turn flush once — and it resolves its turn the way
/// `Signal::notify` does: the ambient turn, else the currently DRAINING one
/// (an action deferred from inside a settle joins that settle), else inline.
/// The caller owns `id` (a `fresh_id()` kept for the action's lifetime) so the
/// dedup is per action, not per call. "Ambient" is the context rule's
/// (spec §8.4): reached through a stored closure — an owner's cleanup, a
/// subscription's release hook — the turn is the one that closure captured
/// at creation, exactly as a `set` from a stored callback; a settled capture
/// drains on a microtask (`enqueue`'s late path), which still lands after
/// the current synchronous segment. `proposal/remote-sources.md` §2a: the
/// `Unsubscribe` a remote mirror owes at its last release is deferred here,
/// which is what lets a same-segment re-subscribe cancel it.
fun at_settle(id: i32, action: || void) {
	let deferred = [Subscriber { id, notify = action }];
	match turn_scope.get_safe() {
		Some(let turn) => enqueue(turn, deferred),
		None => {
			match draining_turns.read().last() {
				Some(let draining) => enqueue(draining, deferred),
				None => action(),
			}
		},
	}
}

/// Establish a FRESH turn for `body`'s dynamic extent, and settle it when the
/// extent ends. The isolation primitive: `body`'s writes (and those of the
/// closures it creates — capture-at-creation) queue here and nowhere else.
///
/// The body is a plain closure parameter, so it is asyncness-polymorphic
/// (spec §7.4): a synchronous body drains at the end of its synchronous
/// extent — the atomic turn — and an AWAITING body adapts, holding EVERY
/// notification — before the first suspension and in every continuation —
/// until the body has fully completed, then settling once (same-signal
/// writes coalesce to their final value). The held form is the wire turn:
/// an RPC handler that reads, awaits, and writes publishes one coherent
/// wave. (`turn_async` was the pre-adaptation spelling of the held form.)
fun turn<T>(policy: FlushPolicy, body: (|| T) context turn_scope): T {
	// The policies converge for async extents in v1 — see `FlushPolicy`.
	let _cadence = policy;
	let fresh = Turn::new();
	let result = turn_scope.run(fresh, body);
	drain(fresh);
	fresh.settled.write() = true;
	result
}

/// The optimistic-write → reconcile lifecycle (reactive-turns.md §5.5):
/// paint `value` into `signal` NOW, run `commit` (usually a server call),
/// then reconcile — the confirmed value on success, the previous value
/// rolled back on failure. Returns the outcome for the caller's error UX.
/// Under a UI turn the optimistic paint settles when the handler's sync
/// extent ends (its first suspension); the reconcile settles as its own
/// continuation segment. Inside a held turn (a `turn` with an awaiting
/// body) the whole lifecycle holds — the transaction wins.
///
/// Bounded on `Signal<T>` because it WRITES (A32's write-back class, with
/// `Optimistic::over` and `ui`'s `bind_value`). `Source` declares `get`/`sub`
/// and no `set`, so the whole point of this function is outside it — and any
/// impl of the writable trait serves, not only the canonical cell.
fun optimistic<T, E, S: Signal<T>>(signal: S, value: T, commit: async || Result<T, E>): Result<T, E> {
	let previous = signal.get();
	signal.set(value);
	let outcome = commit();
	match outcome {
		Ok(let confirmed) => signal.set(confirmed),
		Err(let _error) => signal.set(previous),
	}
	outcome
}

/// Run `body` with notifications deferred, settled once — joins the ambient
/// turn when one is established (nested batches fold into the outermost, the
/// shipped semantics), else a fresh at-end turn. Returns `body`'s value.
///
/// The body is INJECTED (`context turn_scope`), not captured: a batch body is
/// a literal at the call site, created BEFORE the batch's extent exists —
/// capture-at-creation would hand it the caller's (often absent) turn. Both
/// arms enter the extent through `run`, which supplies the turn to the
/// deferred literal: the join arm re-establishes the CURRENT turn (same
/// queue; the outer settle fires once), the fresh arm settles at the end.
fun batch<T>(body: (sync || T) context turn_scope): T {
	match turn_scope.get_safe() {
		Some(let current) => turn_scope.run(current, body),
		None => {
			let fresh = Turn::new();
			let result = turn_scope.run(fresh, body);
			drain(fresh);
			fresh.settled.write() = true;
			result
		},
	}
}

/// A live subscription. Dropping it does NOT stop it (an owner scope is
/// responsible for that — see the proposal); call `dispose` to stop early.
struct Subscription {
	subscribers: Shared<List<Subscriber>>,
	id: i32,
	// Extra teardown to run on dispose, once. `Signal::sub` leaves it `None`;
	// a COUNTED subscription — `RemoteSource::sub`, whose lease holds a
	// network channel open (`proposal/remote-sources.md` §2a) — puts its
	// decrement here, so disposing the handle releases the lease too. A cell,
	// so every copy of the handle shares the one-shot.
	release: Shared<Option<|| void>>,
}

impl Subscription {
	/// A subscription over NO signal: `dispose` runs `release` once and does
	/// nothing else. The registration shape for a source outside the signal
	/// graph — `std::dom`'s `listen`, whose whole teardown is the call that
	/// unhooks the DOM listener (`proposal/router.md` §5.2).
	///
	/// The one-shot is the `release` cell's, so an owner releasing a handle the
	/// app already disposed by hand cannot unhook twice.
	fun teardown(release: || void): Subscription {
		mut subscribers: List<Subscriber> = [];
		Subscription {
			subscribers = Shared::new(subscribers),
			id = fresh_id(),
			release = Shared::new(Some(release)),
		}
	}
}

impl Subscription with Disposable {
	fun dispose(self) {
		mut kept: List<Subscriber> = [];
		for subscriber in self.subscribers.read() {
			if subscriber.id != self.id {
				kept.push(subscriber);
			}
		}
		self.subscribers.write() = kept;

		// Scrub the AMBIENT turn's pending queue too: a disposed observer
		// never fires, even if a `set` earlier in the same extent already
		// enqueued it. (A subscriber queued in ANOTHER extent's turn is out
		// of this one's reach — the isolation cuts both ways; that stale
		// notify fires once against current state. Recorded in
		// `reactive-turns.md`.)
		match turn_scope.get_safe() {
			Some(let turn) => {
				mut kept_pending: List<Subscriber> = [];
				for subscriber in turn.pending.read() {
					if subscriber.id != self.id {
						kept_pending.push(subscriber);
					}
				}
				turn.pending.write() = kept_pending;
				turn.queued.write().remove(self.id.hash());
			},
			None => {},
		}

		// The release hook runs ONCE: taken out before it runs, so a second
		// `dispose` (an owner releasing a handle the app already disposed by
		// hand) cannot double-decrement a count.
		match self.release.read() {
			Some(let release) => {
				self.release.write() = None;
				release();
			},
			None => {},
		}
	}
}

/// An owner scope: collects subscriptions (and child owners / views) and disposes
/// them as a group. Ownership is explicit for now — build a value, `take` it into
/// an owner, and `dispose` the owner to release the whole group.
struct Owner {
	cleanups: Shared<List<|| void>>,
}

impl Owner {
	fun new(): Owner {
		Owner { cleanups = Shared::new([]) }
	}

	/// Take ownership of a disposable (a `Subscription`, a `View`, or a child
	/// `Owner`), returning it for chaining. It is released when this owner is.
	fun take<T: Disposable>(self, item: T): T {
		self.cleanups.write().push(|| {
			item.dispose();
		});
		item
	}

	/// Register a plain cleanup to run at disposal — for teardown that isn't a
	/// single `Disposable` (e.g. `bind_each` disposing whichever rows are live).
	fun defer(self, cleanup: || void) {
		self.cleanups.write().push(cleanup);
	}
}

impl Owner with Disposable {
	fun dispose(self) {
		for cleanup in self.cleanups.read() {
			cleanup();
		}
		self.cleanups.write() = [];
	}
}

/// === The ambient owner (proposal/ambient-owner.md, backlog A5) ===
///
/// A dynamically-scoped `Owner`, carried by `std::context` — compile-time
/// hidden-parameter threading, so it survives stored callbacks and `await`
/// by construction, and reading it outside any `owner_scope.run` extent is a
/// COMPILE error (the context coverage check), never a runtime absence.
///
/// The extent is entered DIRECTLY on the context:
///
///     owner_scope.run(owner, || {
///         count.effect(|value| ..);   // disposed with `owner`
///     });
///
/// A `run_with_owner(owner, body)` wrapper FUNCTION is impossible by the
/// context model's own rules (probed): `run` requires a closure literal at
/// its call site, and a closure captures its context AT CREATION — a body
/// passed to a wrapper is born at the caller's site, outside the extent, so
/// its reads are statically rejected. The literal therefore belongs at the
/// user's site, on the context itself. (Sugar that keeps this shape is
/// possible as a macro, which splices the literal in place — recorded in the
/// proposal.)
let owner_scope: Context<Owner> = Context::new();

/// The ambient owner established by the nearest enclosing `owner_scope.run`.
fun get_owner(): Owner {
	owner_scope.get()
}

/// Hand `subscription` to the ambient owner when there is one, and give it
/// back either way — the OWNER-OPTIONAL half of `Source::effect`
/// (`proposal/lifetimes.md` §5, A28).
///
/// `effect` reads the owner strictly (`get_owner`), which makes "no ambient
/// owner" a COMPILE error; that is right for a subscription the caller never
/// sees, and wrong for the derivation combinators (`map`, `combine`,
/// `flatten`), which are documented as callable at module level — `current_path()
/// .map(parse)` at the top of `main`, `RemoteSource::status` above every
/// boundary. So they read it SAFELY: inside a boundary the derivation dies with
/// the boundary (the leak A28 measured — 25 mount/dispose rounds left 25 dead
/// subscribers on the module path signal — is gone), and outside every boundary
/// the derivation lives as long as its source, exactly as it does today.
///
/// The ownerless case is therefore leak-as-today, not a refusal. Refusing it
/// would be the stronger law ("a derivation must have an owner", the shape
/// `RemoteSource::map` already enforces), and it is a BREAKING change to a
/// documented idiom, so it is the owner's call and not this function's.
fun register_with_owner(subscription: Subscription): Subscription {
	match owner_scope.get_safe() {
		Some(let owner) => owner.take(subscription),
		None => subscription,
	}
}

/// `Owner::defer` against the ambient owner when there is one — the
/// `register_with_owner` shape for teardown that is not a single
/// `Disposable` (`flatten`'s rolling inner subscription).
fun defer_to_owner(cleanup: || void) {
	match owner_scope.get_safe() {
		Some(let owner) => owner.defer(cleanup),
		None => {},
	}
}

/// Establish `owner` as the ambient owner for the dynamic extent of `body` —
/// the plain-function wrapper, made possible by the `context` clause
/// (proposal/ambient-owner.md §5): `body` is an INJECTED closure, deferring
/// its ambient reads to call-supplied binding instead of capturing at
/// creation, so the literal may be born at the caller's site. Yields the
/// body's value, like `run` and `batch`.
fun run_with_owner<T>(owner: Owner, body: (sync || T) context owner_scope): T {
	owner_scope.run(owner, body)
}

/// A component scope in one expression (proposal/ambient-owner.md §4): a
/// fresh owner, the body run under it as the ambient extent, and the body's
/// product PAIRED with the disposal handle — `scope.dispose()` tears down
/// every effect the component registered, stored callbacks and post-`await`
/// registrations included.
fun comp<T>(body: (sync || T) context owner_scope): (T, Owner) {
	let scope = Owner::new();
	let result = owner_scope.run(scope, body);
	(result, scope)
}

/// The read-only view of a reactive value: read the current value and subscribe to its
/// changes. `SignalCell<T>` implements it (and adds `set`/`set_with`); a *remote* handle
/// implements it too (its `sub` flows over a transport), so code that only observes can't
/// tell a local signal from a remote one — the split the reactive north star needs
/// (`proposal/transport-rpc.md` §8).
trait Source<T> {
	fun get(self): T;
	[must_use]
	fun sub(self, observer: |T| void): Subscription;

	/// Subscribe and register with the ambient owner (backlog A5): the
	/// scope-tied `sub` — nothing to hold, nothing to drop by hand. Requires
	/// an enclosing `owner_scope.run`, statically. A trait DEFAULT, so every
	/// `Source` gets it (B14 wired the dispatch edges that make a default
	/// body's context read coverable).
	fun effect(self, observer: |T| void) {
		get_owner().take(self.sub(observer));
	}

	/// Subscribe WITHOUT the immediate first call (backlog A43): `observer`
	/// runs on every CHANGE from here on, and never for the value the source
	/// already holds. `sub` is exactly this plus that call, so the pair is the
	/// eager/lazy opt-out Solid spells `on(deps, fn, { defer: true })` — vilan
	/// has neither overloading nor optional parameters, so the opt-out is a
	/// NAME.
	///
	/// Reach for it when the first value is already accounted for: a
	/// derivation that seeded its own initial value (`map`, `combine`), a
	/// side effect that must not fire on the state the program starts in — a
	/// "you have unsaved changes" prompt, an analytics ping. Every UI binding
	/// wants the opposite (the immediate call IS the initial paint), which is
	/// why `sub`/`effect` keep it.
	///
	/// The DEFAULT body wraps `sub` and swallows that first call, which is
	/// honest against `sub`'s documented contract — one immediate call with
	/// the current value, then one per change. An impl whose `sub` does not
	/// fire immediately is already outside that contract and must override
	/// this. `SignalCell` does override it, with a direct attach that never
	/// makes the call at all (`observe`).
	[must_use]
	fun on_change(self, observer: |T| void): Subscription {
		let seeded: Shared<bool> = Shared::new(false);
		self.sub(|value| {
			if seeded.read() {
				observer(value);
			} else {
				seeded.write() = true;
			}
		})
	}

	/// A derived signal: `transform` of this one's value, recomputed on every
	/// change. DETACHABLE (A28): the subscription into this signal is handed to
	/// the ambient owner, so a derivation made inside a boundary — a mounted
	/// view, a `bind_each` row — dies when that boundary is disposed instead of
	/// notifying a dead derived signal for the rest of the session. Made
	/// outside every boundary (module level, the top of `main`) it lives as long
	/// as its source, which is what a module-level `current_path().map(parse)`
	/// wants.
	fun map<U>(self, transform: sync |T| U): SignalCell<U> {
		let derived = SignalCell::new(transform(self.get()));
		let _owned = register_with_owner(self.on_change(|value| {
			derived.set(transform(value));
		}));
		derived
	}

	/// `on_change` registered with the ambient owner — `effect`'s lazy twin,
	/// and the same static requirement: an enclosing `owner_scope.run`.
	fun effect_on_change(self, observer: |T| void) {
		get_owner().take(self.on_change(observer));
	}
}

/// The WRITABLE half of the pair: `Source` reads, `Signal` writes. A component
/// that only observes takes a `Source`; one that writes back takes a `Signal`,
/// and any impl satisfies it — a cell that clamps its setter, one that
/// persists to storage, one that debounces. `set` and `notify` are the
/// requirements, because that is where custom write logic lives and no generic
/// body can reach an arbitrary impl's storage or subscriber list.
///
/// `Signal::new(value)` is the everyday spelling and does NOT dispatch: with no
/// receiver there is nothing to select an impl from, so it resolves statically
/// to this default body and means the canonical cell in every file (B162). An
/// impl may declare its own `new`, reached at its own name.
///
/// `update` is deliberately NOT here. Its value is in-place mutation with one
/// notify, and a generic default can only read-copy-mutate-write-back — the
/// copy A18 existed to avoid. Impls may want their own update logic or none at
/// all, so it stays inherent on `SignalCell` and general consumers are locked
/// out of it.
///
/// The trait promises NOTHING about notification frequency. `SignalCell`
/// notifies unconditionally (`set` never compares); an impl that wants "don't
/// publish an unchanged value" writes that in its own `set`.
trait Signal<T> with Source<T> {
	/// The canonical cell, concretely — deliberately not `Self`: a bare
	/// `Signal::new(1)` has no receiver and no bound in scope to resolve a
	/// `Self` against.
	fun new(value: T): SignalCell<T> {
		SignalCell::new(value)
	}

	fun set(self, value: T);

	/// Publish the current value without changing it.
	fun notify(self);

	/// Read, transform, write. The default is exactly that line; an impl that
	/// can do better overrides it.
	fun set_with(self, transform: sync |T| T) {
		self.set(transform(self.get()));
	}
}

/// A reactive value: a current value plus the observers to notify when it changes.
/// Both a root cell and every derived value share this representation; the
/// difference is only who may write it (a root, via `set`). The canonical
/// `Signal` impl — `Signal::new` hands one back.
struct SignalCell<T> {
	value: Shared<T>,
	subscribers: Shared<List<Subscriber>>,
}

impl SignalCell<type T> with Source<T> {
	fun get(self): T {
		self.value.read()
	}

	[must_use]
	fun sub(self, observer: |T| void): Subscription {
		let subscription = observe(self, observer);
		observer(self.get());
		subscription
	}

	/// The direct attach — `observe` itself (A43). The trait's default body
	/// would reach this through `sub` and drop the immediate call on the
	/// floor; the cell can simply not make it.
	[must_use]
	fun on_change(self, observer: |T| void): Subscription {
		observe(self, observer)
	}
}

/// Attach `observer` to `signal`'s subscriber list and hand back the handle
/// that detaches it — `sub` WITHOUT the immediate first call. `sub` is this
/// plus that call; a derivation (`map`) seeds its own first value and must not
/// pay for a second `transform`.
///
/// The notify closure captures the VALUE CELL, never the signal
/// (`proposal/lifetimes.md` §5, V1). Capturing `self` closed a back edge —
/// signal → subscribers cell → list → subscriber → closure → scope → signal —
/// so every subscription in the program minted its own 6-node cycle. The cell
/// is what the closure actually needs, and nothing points from it back to the
/// signal.
///
/// Concrete `Signal` and NOT widenable to `Source` (A33): this reads the
/// STRUCTURE — the value cell and the subscriber list — not the trait's
/// `get`/`sub`, and the whole reason it exists is to attach without the
/// immediate first call that `sub` makes. There is no `Source` spelling for
/// that, so `map`, which is built on it, stays a `Signal` method too.
fun observe<T>(signal: SignalCell<T>, observer: |T| void): Subscription {
	let id = fresh_id();
	let cell = signal.value;
	signal.subscribers.write().push(Subscriber {
		id,
		notify = || {
			observer(cell.read());
		},
	});
	Subscription { subscribers = signal.subscribers, id, release = Shared::new(None) }
}

/// The canonical write side. `set_with` is the trait's default, unchanged —
/// the body std used to carry here is the body the trait carries now.
impl SignalCell<type T> with Signal<T> {
	/// Declared, not inherited: `Type::func` reads the type's OWN members, so
	/// the trait's default body is reachable at `Signal::new` and this one is
	/// reachable at `SignalCell::new`. They are the same cell either way.
	fun new(value: T): SignalCell<T> {
		mut subscribers: List<Subscriber> = [];
		SignalCell { value = Shared::new(value), subscribers = Shared::new(subscribers) }
	}

	fun set(self, value: T) {
		self.value.write() = value;
		self.notify();
	}

	/// Publish this signal's current value to its observers — the notification
	/// half of a write, shared by `set` and `update`.
	///
	/// Under an ambient turn, defer the notification to ITS settle — writes
	/// coalesce glitch-free, and only this extent's flush fires them. With no
	/// ambient turn, join the currently DRAINING one if a settle is in progress
	/// (a derived recomputing mid-drain — see `draining_turns`), else notify
	/// inline (eager, depth-first).
	fun notify(self) {
		match turn_scope.get_safe() {
			Some(let turn) => enqueue(turn, self.subscribers.read()),
			None => {
				match draining_turns.read().last() {
					Some(let draining) => enqueue(draining, self.subscribers.read()),
					None => {
						for subscriber in self.subscribers.read() {
							(subscriber.notify)();
						}
					},
				}
			},
		}
	}
}

impl SignalCell<type T> {
	/// Mutate the stored value IN PLACE, then notify once (backlog A18,
	/// `proposal/signal-update.md`). `mutate` receives a writable view of the
	/// storage, so a collection grows without the copy-transform-return dance
	/// `set_with` requires:
	///
	///     todos.update(|&mut list| { list.push(todo); });
	///
	/// INHERENT, not a `Signal` member (A32's ruling): a generic default could
	/// only read-copy-mutate-write-back, which is the copy this exists to
	/// avoid, and an impl may want its own update logic or none at all. A
	/// consumer that needs it asks for the cell.
	///
	/// The notification is UNCONDITIONAL — exactly like `set`, which never
	/// compares either. A `mutate` that writes nothing still publishes; that
	/// is cheap and predictable, and it keeps `update` and `set` one rule.
	/// Under a `batch`/`turn` the notification defers and coalesces like any
	/// other write. `mutate` is `sync`: the view may not be live across an
	/// `await` (spec §6.6), so an async closure is refused rather than adapted.
	fun update(self, mutate: sync |&mut T| void) {
		mutate(self.value.write());
		self.notify();
	}
}

/// A component value that may be STATIC or REACTIVE, with no ceremony at the
/// call site (B157). A component takes one parameter bounded on this trait and
/// accepts both `badge("draft")` and `badge(Signal::new("draft"))`; the value's
/// TYPE decides its life, exactly as `AttrValue` has always decided an
/// attribute's.
///
/// `bind` is EFFECT-SHAPED rather than getter-shaped, which is what makes one
/// signature serve both cases: the static impl fires the handler once and is
/// done, the reactive one subscribes and keeps firing. There is no runtime
/// discrimination anywhere — which impl runs is settled at the call, by the
/// specificity order (spec §5.4).
///
/// The reactive arm registers with the AMBIENT OWNER (`effect`), so a
/// component's subscription dies with the boundary that built it. That is also
/// why `bind` may only be called under one: the requirement is static, and it
/// flows through the bound.
trait MaybeSignal<T> {
	fun bind(self, react: |T| void);
}

/// The static case: the value is the value, so hand it over once.
///
/// A BLANKET (B158) — the least specific tier, so any impl below outranks it
/// wherever both match.
impl type T with MaybeSignal<T> {
	fun bind(self, react: |T| void) {
		react(self);
	}
}

/// The reactive case, over the READ trait: a cell, a derivation, a
/// `RemoteSource`, a mirror of one's own. Bounded on `Source` rather than on
/// `Signal` because `bind` only reads — a component that wants to write back
/// asks for `Signal<T>` directly.
///
/// The binder in the bound is the impl's own parameter (B165), which is what
/// makes this one impl rather than one per element type.
impl type S: Source<type T> with MaybeSignal<T> {
	fun bind(self, react: |T| void) {
		self.effect(react);
	}
}

/// The product combinator: a signal of the tuple of its inputs' current values,
/// recomputed whenever any input changes. Variadic over the inputs' (distinct)
/// types via a mapped-tuple parameter — `combine((a, b, c))` of `SignalCell<A>`,
/// `SignalCell<B>`, `SignalCell<C>` yields `SignalCell<(A, B, C)>`.
///
/// Detachable like `map` (A28): each per-input subscription is handed to the
/// ambient owner, so the whole product dies with the boundary that built it.
///
/// READ-ONLY (it only `get`s and `sub`s) and still concrete — HELD by the
/// spelling, not by the semantics (A33). Widening the elements would need each
/// one to be *some* `Source<U>`, a per-element EXISTENTIAL, and the mapped-tuple
/// form has no place to bind it: `(U in T: Source<U>)` is refused because vilan
/// has no trait objects, and a `<S: Source<U>>` parameter names ONE type where
/// the tuple needs a different one per element. `combine` widens when the
/// mapped-tuple grammar can bind a bound per element, not before.
fun combine<T: (2..)>(sources: (U in T: SignalCell<U>)): SignalCell<T> {
	let snapshot = || (source in sources => source.get());
	let derived = SignalCell::new(snapshot());
	// Subscribe each input LAZILY (A43): `derived` was just seeded with the
	// snapshot, so an eager `sub` would re-set it to that same value once per
	// input — n redundant writes, and n redundant snapshots, at construction.
	// `on_change` attaches without the call. The handles are the AMBIENT
	// OWNER's from here on — the tuple itself is what is dropped, not the
	// subscriptions.
	let _owned = (source in sources => register_with_owner(source.on_change(|_| {
		derived.set(snapshot());
	})));
	derived
}

// === Per-key selection (backlog A44; Solid's `createSelector`) ===============
//
// "Is THIS row the selected one?" — asked once per row, answered live. The
// obvious spelling derives a boolean per row off the selection signal, and
// every one of them recomputes on every change: n notifications to move a
// highlight one row. `selector` takes ONE subscription on the source and keeps
// a cell per key, so a change writes exactly TWO of them — the key that left
// and the key that arrived — whatever n is.

/// The per-key selection handle `selector` hands back. `of(key)` is the live
/// answer for one key, as a `SignalCell<bool>` that drops straight into
/// `show` / `when` / `bind_class` / `bind_styled`.
///
/// A HANDLE with a method rather than the closure Solid returns, and that is
/// forced rather than chosen: a closure captures its context AT CREATION
/// (spec §8.4), so a closure built inside `selector` would defer every key's
/// cleanup to whatever owner was ambient where `selector` was CALLED — the
/// component, never the row. A method call threads the caller's ambient owner
/// the ordinary way, which is what lets a row's entry die with the row.
struct Selector<T> {
	// One cell per key, keyed by `key.hash()` (the canonical key `Map`/`Set`
	// use). Every `of` for the same key hands back the same cell.
	cells: Shared<NativeMap<SignalCell<bool>>>,
	// The source's current value, mirrored here so `of` can seed a fresh cell
	// and the change observer can find the key that is LEAVING.
	current: Shared<T>,
}

/// Build a per-key selection over `source` — one subscription, O(2)
/// notifications per change (`Selector`).
///
/// ```
/// let selected = selector(current_id);
/// // … inside a row, under the row's own owner:
/// view("li").bind_styled(selected.of(todo.id).map(|on| if on { active } else { plain }))
/// ```
///
/// The subscription is the AMBIENT OWNER's, like every derivation combinator's
/// (A28), and it is a LAZY one (A43): the cells are seeded by `of` from
/// `current`, so there is nothing for a first call to do.
fun selector<T: Hashable + PartialEq, S: Source<T>>(source: S): Selector<T> {
	let cells: Shared<NativeMap<SignalCell<bool>>> = Shared::new(NativeMap::new());
	let current: Shared<T> = Shared::new(source.get());
	let _owned = register_with_owner(source.on_change(|value| {
		let previous = current.read();
		current.write() = value;
		// Two writes, whatever the row count: the key that left goes false,
		// the key that arrived goes true. A key nobody asked about has no
		// cell, and needs none.
		match cells.read().get(previous.hash()) {
			Some(let leaving) => leaving.set(false),
			None => {},
		}
		match cells.read().get(value.hash()) {
			Some(let arriving) => arriving.set(true),
			None => {},
		}
	}));
	Selector { cells = cells, current = current }
}

impl Selector<type T: Hashable + PartialEq> {
	/// The live answer for one key: `true` exactly while the source holds it.
	///
	/// Creates the key's cell on first ask (seeded against the current value)
	/// and hands back that same cell every time after. The entry's REMOVAL is
	/// deferred to the ambient owner, so asking from inside a `bind_each` row
	/// frees the entry when the row is disposed and the map stays the size of
	/// the live list rather than of every list the session ever showed.
	fun of(self, key: T): SignalCell<bool> {
		let hash = key.hash();
		match self.cells.read().get(hash) {
			Some(let existing) => existing,
			None => {
				let cell: SignalCell<bool> = SignalCell::new(key == self.current.read());
				self.cells.write().insert(hash, cell);
				defer_to_owner(|| {
					self.cells.write().remove(hash);
				});
				cell
			},
		}
	}
}

// The monadic join (backlog A4): follow whichever inner signal the outer
// currently holds — a DYNAMIC dependency. When the outer switches, the result
// detaches from the replaced inner and follows the new one from its current
// value; when the current inner changes, the result updates. The rolling INNER
// subscription is disposed on every switch, so a replaced inner stops driving
// the result — and BOTH halves are the ambient owner's (A28): the outer
// subscription is registered, and the inner one that happens to be live at
// disposal is deferred, so nothing survives the boundary.
impl SignalCell<SignalCell<type U>> {
	fun flatten(self): SignalCell<U> {
		let derived = SignalCell::new(self.get().get());
		let inner_subscription: Shared<Option<Subscription>> = Shared::new(None);
		// `sub` runs its observer immediately, so the first inner wires here too.
		let _outer = register_with_owner(self.sub(|inner| {
			inner_subscription.read()?.dispose();
			inner_subscription.write() = Some(inner.sub(|value| {
				derived.set(value);
			}));
		}));
		// The outer handle detaches this signal from the outer; whichever inner
		// is current at that moment needs releasing too, and it is not a handle
		// anyone else holds.
		defer_to_owner(|| {
			inner_subscription.read()?.dispose();
			inner_subscription.write() = None;
		});
		derived
	}
}

// === Keyed list reconciliation (backlog A3) — `bind_each`'s engine ===
//
// Aligns a keyed row set with a new list of items. Per new item, in order:
// KEEP a same-key row whose item is unchanged, REFRESH a same-key row whose
// item changed (the caller disposes the old row and renders anew), or render
// FRESH when the key is new. Old rows whose keys left the list are REMOVED.
// A duplicate key claims its old row once — later duplicates render fresh.
// Pure logic (no DOM), so its edge cases pin in ordinary node tests; the
// browser's `bind_each` applies the plan to elements.
//
// "Unchanged" is the CALLER's predicate (`same`), not `T: PartialEq` (A42).
// The key decides identity and the element MOVES; `same` decides, for a
// surviving key, reuse against dispose-and-rebuild — two different questions
// that the old bound conflated into one. `bind_each` passes `==` and behaves
// exactly as it always has; `bind_each_by` passes "always the same", which is
// what lets it take a `T` with no equality at all and update a kept row
// through its own cell instead of rebuilding it.

/// One new-position row's fate. `Keep`/`Refresh` carry the OLD row's index.
enum RowStep {
	Keep(i32),
	Refresh(i32),
	Fresh,
}

/// The plan for one reconcile pass: a step per NEW item (in the new order),
/// then the old indices whose rows are gone entirely.
struct ReconcilePlan {
	steps: List<RowStep>,
	removed: List<i32>,
}

fun reconcile<T, K: PartialEq>(
	old_keys: List<K>,
	old_items: List<T>,
	items: List<T>,
	key_of: sync |T| K,
	same: sync |T, T| bool,
): ReconcilePlan {
	mut claimed: List<bool> = [];
	for _ in old_keys {
		claimed.push(false);
	}
	mut steps: List<RowStep> = [];
	for item in items {
		let item_key = key_of(item);
		mut step = RowStep::Fresh;
		mut index = 0;
		for index < old_keys.len() {
			if !claimed[index] && old_keys[index] == item_key {
				claimed[index] = true;
				step = if same(old_items[index], item) {
					RowStep::Keep(index)
				} else {
					RowStep::Refresh(index)
				};
				jump break;
			}
			index += 1;
		}
		steps.push(step);
	}
	mut removed: List<i32> = [];
	mut index = 0;
	for index < old_keys.len() {
		if !claimed[index] {
			removed.push(index);
		}
		index += 1;
	}
	ReconcilePlan { steps = steps, removed = removed }
}

// === Local-first drafts (Kolt's `Crate`, typed) ==============================
//
// A `Draft<T>` is a local-first cell over a remote commit: edits land in
// `local` FIRST (an input never waits on the wire), `push` commits them, and
// `adopt` folds in remote changes without fighting in-flight edits. Failure
// KEEPS the local value (unlike `optimistic`, which rolls back — right for
// one-shot actions, hostile mid-typing); the next push retries naturally.
// Conflicts are last-write-wins: a dirty local survives remote adoption, and
// its eventual push overwrites the remote edit.
//
// Two opt-in behaviours ride on top (`proposal/draft-reconnect.md`, A14):
// `repush()` re-sends edits the remote never accepted — wire it to a
// transport's reconnect and a dropped connection stops losing the user's
// work — and `debounce(millis)` coalesces a burst of keystrokes into one
// commit instead of one per edit. Both are off unless asked for.

/// The sync status a UI can bind ("saved" / "unsaved" / the failure).
[derive(PartialEq, Debug)]
enum DraftState {
	// `local` matches the last pushed/adopted value.
	Synced,
	// Local edits not yet confirmed (in-flight included).
	Dirty,
	// The last push errored; `local` is kept, not rolled back.
	Failed(str),
}

struct Draft<T> {
	// Bind inputs to this; read it like any signal.
	local: SignalCell<T>,
	state: SignalCell<DraftState>,
	// The last value known to match the remote (pushed by us or adopted).
	synced: Shared<T>,
	// Discards stale completions when pushes overlap (fast typing over a
	// slow wire): only the newest push settles the state.
	generation: Shared<i32>,
	// The coalescing window in milliseconds; 0 (the default) commits on every
	// `push`. A CELL, like every other field, so copying a draft can never
	// produce two values that disagree about their own window.
	debounce_millis: Shared<i32>,
	// The outstanding coalescing timer, when a debounced push is waiting out
	// its window. Cancelled by a newer push, by `commit`, and by `repush`.
	pending: Shared<Option<Timer>>,
	/// `None` = success, `Some(reason)` = failure. Calls through the field
	/// await (a sync commit just resolves).
	commit: async |T| Option<str>,
}

/// A local-first cell seeded with `initial`, committing through `commit`.
/// The parameter is `async`-typed so an rpc-calling closure flows in legally
/// (J2's channel) — a sync commit passes fine too (awaiting a plain value
/// just resolves).
fun draft<T: PartialEq>(initial: T, commit: async |T| Option<str>): Draft<T> {
	Draft {
		local = SignalCell::new(initial),
		state = SignalCell::new(DraftState::Synced),
		synced = Shared::new(initial),
		generation = Shared::new(0),
		debounce_millis = Shared::new(0),
		pending = Shared::new(None),
		commit,
	}
}

impl Draft<type T: PartialEq> {
	/// Set locally and commit — the per-keystroke path. LOCAL-FIRST: the
	/// commit is spawned, never awaited, so `push` (and the input handler
	/// calling it) returns without riding the wire.
	///
	/// Under a `debounce(millis)` window the LOCAL half is unchanged — the
	/// value and the `Dirty` state land synchronously, exactly as here — and
	/// only the commit waits out the window, coalescing a burst of pushes
	/// into one.
	fun push(self, value: T) {
		// ONE wave: a lifecycle transition writes two signals, and an
		// observer of both must never see half of it
		// (`proposal/optimistic-lifecycle.md` §5). `batch` joins the ambient
		// turn when there is one — under a UI boundary turn nothing changes —
		// and creates one when there is not, which is the case that used to
		// publish the new text still claiming `Synced`.
		batch(|| {
			self.local.set(value);
			self.state.set(DraftState::Dirty);
		});
		if self.debounce_millis.read() > 0 {
			self.arm();
		} else {
			self.send(value);
		}
	}

	/// Commit `value` now, unconditionally: claim the newest generation (so
	/// any older in-flight commit's outcome is discarded) and spawn the
	/// in-flight half.
	///
	/// Deliberately unstructured (no nursery): the in-flight commit is owned
	/// by the draft CELL, not by any function's extent — the caller
	/// returning is the point. `settle` resolves every outcome into the
	/// draft's state; a panic escaping it surfaces as the task report.
	fun send(self, value: T) {
		let mine = self.generation.read() + 1;
		self.generation.write() = mine;
		let _in_flight = async self.settle(value, mine);
	}

	/// Start (or restart) the coalescing window: call off whatever was
	/// waiting and park a fresh timer. Trailing-edge — the commit happens
	/// `debounce_millis` after the LAST push, not the first.
	fun arm(self) {
		self.cancel_pending();
		let timer = Timer::after(self.debounce_millis.read());
		self.pending.write() = Some(timer);
		let _waiting = async self.fire(timer);
	}

	/// The trailing edge. `wait` settles `true` only if the window ran out;
	/// a `cancel` — a newer push, a manual `commit`, a `repush` — settles it
	/// `false` and this task retires without touching the wire. The value
	/// sent is the LATEST local one, which is the point of coalescing.
	fun fire(self, timer: Timer) {
		if timer.wait() {
			self.pending.write() = None;
			self.send(self.local.get());
		}
	}

	/// Call off any outstanding coalescing timer. Idempotent (`Timer.cancel`
	/// is, and a settled timer is untouched), so this is safe to call on a
	/// draft that has no window and never armed one.
	fun cancel_pending(self) {
		match self.pending.read() {
			Some(let timer) => timer.cancel(),
			None => {},
		}
		self.pending.write() = None;
	}

	/// Coalesce pushes into one commit per `millis` of quiet — the fix for
	/// one wire frame per keystroke. Returns the draft for chaining:
	///
	///     let title = draft(page.title, commit).debounce(300);
	///
	/// `0` restores the default, a commit on every `push`. The window is a
	/// cell shared by every copy of the draft, so this is a property of the
	/// CELL and not of the value you happen to be holding.
	fun debounce(self, millis: i32): Draft<T> {
		self.debounce_millis.write() = millis;
		self
	}

	/// Commit the current local value NOW, cancelling any pending debounce
	/// window — the explicit save (a blur handler, a Save button, a submit).
	/// Exactly one commit results: the cancelled timer's parked task retires
	/// without sending.
	fun commit(self) {
		self.cancel_pending();
		self.send(self.local.get());
	}

	/// Re-send local edits the remote never accepted — the reconnect path
	/// (`proposal/draft-reconnect.md`). Wire it to a transport's reconnect
	/// hook and a dropped connection stops losing the user's work:
	///
	///     client.transport.on_reconnect(|| title.repush());
	///
	/// It is also the "retry" button in a failure banner.
	///
	/// A no-op unless `local` differs from `synced` — that test covers both
	/// an edit whose commit never left and one caught in flight by the drop
	/// (a failed commit KEEPS the local value and does not advance `synced`),
	/// and it means a screen of untouched drafts costs nothing on reconnect.
	/// A pending debounce is cancelled and the value goes immediately:
	/// recovery is not typing, and there is no burst to coalesce.
	///
	/// DELIVERY IS AT-LEAST-ONCE. A commit that reached the server and
	/// succeeded, whose reply was lost with the connection, is
	/// indistinguishable here from one that never arrived — so the server
	/// may see it twice. `Draft`'s own reconcile is idempotent (`adopt`
	/// no-ops on an echo; the generation guard discards the superseded
	/// commit's outcome), but the commit CLOSURE is yours: "set the remote to
	/// this value" repeats harmlessly, "append this" does not.
	///
	/// A re-push that fails settles `Failed` like any other and is NOT
	/// retried on a timer — `local` still differs from `synced`, so the next
	/// reconnect sends it again. A draft the server is permanently refusing
	/// must not spin.
	fun repush(self) {
		if self.local.get().ne(self.synced.read()) {
			self.cancel_pending();
			self.send(self.local.get());
		}
	}

	/// The in-flight half of a push: await the commit, then resolve the
	/// draft's state — unless a newer push superseded this one while it was
	/// on the wire (fast typing over a slow commit), in which case that
	/// push's completion owns the state.
	fun settle(self, value: T, mine: i32) {
		let outcome = (self.commit)(value);
		if self.generation.read() == mine {
			match outcome {
				None => {
					self.synced.write() = value;
					self.state.set(DraftState::Synced);
				},
				Some(let reason) => self.state.set(DraftState::Failed(reason)),
			}
		}
	}

	/// A remote value arrived (a mirror update). An echo of our own push is
	/// a no-op; a genuine remote change adopts into `local` — unless local
	/// has unpushed edits, which win until their push lands.
	fun adopt(self, remote: T) {
		if remote == self.synced.read() {
			// Our own edit reflected back (or nothing changed).
		} else if self.local.get() == self.synced.read() {
			// Clean local: take the remote edit — again as ONE wave.
			self.synced.write() = remote;
			batch(|| {
				self.local.set(remote);
				self.state.set(DraftState::Synced);
			});
		} else {
			// Dirty local: the user's text wins for now; remember the
			// remote so the eventual push knowingly overwrites it.
			self.synced.write() = remote;
		}
	}
}

// === The optimistic-write → reconcile lifecycle (A14) ========================
//
// `optimistic` above is the stateless one-shot: paint, await, confirm or roll
// back. An `Optimistic<T>` cell is the same lifecycle made OBSERVABLE and
// made correct when writes overlap (`proposal/optimistic-lifecycle.md`):
//
//   - `state` publishes `Pending` while a write is on the wire and
//     `Rejected(reason)` when one is refused, so a spinner, a disabled
//     button and a failure banner have something to bind. The free function
//     hands the outcome to its caller and to no one else.
//   - Two guards keep overlapping writes honest. Only the NEWEST write
//     paints the cell (a superseded outcome is discarded, like `Draft`'s
//     generation guard), and the rollback target is the last value the
//     SERVER confirmed rather than whatever the signal happened to hold —
//     which is a different question, so it has a counter of its own.
//
// The cell WRAPS an existing signal, so adopting it changes no binding.
// Unlike `Draft` it does not re-push on reconnect, and that is deliberate:
// re-push is at-least-once (`proposal/draft-reconnect.md` §3.2), safe for a
// draft's "set this field to this value" and unsafe for the one-shot ACTIONS
// this cell exists for. The rollback is the recovery; the user re-issues.

/// Where a write made through an `Optimistic` cell stands. Bind it.
[derive(PartialEq, Debug)]
enum WriteState {
	// Nothing in flight; the cell's value is the last confirmed truth.
	Confirmed,
	// The newest write is on the wire.
	Pending,
	// The newest write was refused; the cell has rolled back. Sticky until
	// the next write, so a banner stays up until something changes.
	Rejected(str),
}

// The cell is generic over the SIGNAL as well as its value (B186): a field
// must name a real type, so widening `over` past the canonical cell means
// naming the signal's type, and `S` is that name. A33's write-back class is
// what makes it worth the arity — a clamped or persisted cell of the user's
// own is now wrappable, where before only `SignalCell` was.
struct Optimistic<T, S: Signal<T>> {
	// The signal being written — the one handed to `over`. Bind it.
	value: S,
	// The lifecycle, for the UI.
	state: SignalCell<WriteState>,
	// The last value the server confirmed: the ROLLBACK TARGET, and the
	// reason this cannot be a free function over a bare signal.
	confirmed: Shared<T>,
	// Claimed per write; only the newest write's outcome paints.
	generation: Shared<i32>,
	// The highest generation whose outcome reported a confirmation, so
	// out-of-order completions cannot un-tell us what the server holds.
	confirmed_generation: Shared<i32>,
}

impl Optimistic<type T, type S: Signal<T>> {
	/// Wrap `signal` in an optimistic-write cell, seeded with its current
	/// value as the confirmed truth — the value the cell is handed is, by
	/// definition, the last thing anyone confirmed.
	///
	/// Any `Signal<T>` serves, not only the canonical cell (A32's write-back
	/// class, with `optimistic` and `ui`'s `bind_value`): the cell WRITES, and
	/// `Source` declares `get`/`sub` and no `set`. `S` is written out rather
	/// than sugared, because the return type names it — B186's implicit
	/// generic is a parameter's bound, and this one is the struct's.
	fun over(signal: S): Optimistic<T, S> {
		Optimistic {
			value = signal,
			state = SignalCell::new(WriteState::Confirmed),
			confirmed = Shared::new(signal.get()),
			generation = Shared::new(0),
			confirmed_generation = Shared::new(0),
		}
	}

	/// Paint `value` and flip to `Pending` in one wave, run `commit`, then
	/// reconcile in one wave — the confirmed value on `Ok`, a rollback to the
	/// last confirmed value on `Err`. Returns the outcome, so a caller that
	/// wants its own error UX keeps it; the `state` signal is an addition to
	/// that, not a replacement.
	///
	/// Awaits, like `optimistic`. Fire-and-forget is
	/// `let _sent = async cell.write(..)`.
	///
	/// If a NEWER write claimed the cell while this one was on the wire, this
	/// outcome does not paint: the newest write owns the cell, and its own
	/// commit answers for it. The outcome still comes back here.
	fun write(self, value: T, commit: async || Result<T, str>): Result<T, str> {
		let mine = self.generation.read() + 1;
		self.generation.write() = mine;
		batch(|| {
			self.value.set(value);
			self.state.set(WriteState::Pending);
		});

		let outcome = commit();

		// Knowledge first, and independently of the paint guard: a superseded
		// write that SUCCEEDED still told us something true about the server,
		// and it is the rollback target. Only a later write's confirmation may
		// replace it, so out-of-order completions cannot walk it backwards.
		match outcome {
			Ok(let server_value) => {
				if mine > self.confirmed_generation.read() {
					self.confirmed.write() = server_value;
					self.confirmed_generation.write() = mine;
				}
			},
			// A refusal taught us only that the server still holds what it held.
			Err(let _reason) => {},
		}

		if self.generation.read() == mine {
			batch(|| {
				match outcome {
					Ok(let server_value) => {
						self.value.set(server_value);
						self.state.set(WriteState::Confirmed);
					},
					Err(let reason) => {
						self.value.set(self.confirmed.read());
						self.state.set(WriteState::Rejected(reason));
					},
				}
			});
		}
		outcome
	}
}
