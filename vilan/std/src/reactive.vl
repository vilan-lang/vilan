import pkg::compare::PartialEq;
import pkg::context::Context;
import pkg::hash::Hashable;
import pkg::io::panic;
import pkg::native_map::NativeMap;
import pkg::option::Option::{ self, None, Some };
import pkg::result::Result::{ self, Err, Ok };
import pkg::shared::{ Shared, Weak };
import pkg::task::{ Nursery, ambient_nursery, detached_nursery };
import pkg::time::Timer;
import pkg::tuple::Tuple;

// === The change structure (A112 S1) ==========================================
//
// The delta log, its cursor and the op vocabulary are `std::reactive`'s by design —
// `SeqOp` is a reactive type where `Delta` is a `std::wire` one, and this module
// still imports nothing from `std::wire`. Their BODIES sit in `delta.vl`, which
// imports `Source` and `fresh_id` from here; re-exporting them is what makes the
// designed spelling (`std::reactive::DeltaCursor`) resolve without this file
// growing a second subject.
//
// `proposal/incremental-collections.md` §4 is the design; `std::rpc`'s `KeyedCell`
// is the first consumer (A54's machinery, lifted).
export import pkg::delta::{
	DeltaCursor,
	DeltaFeed,
	DeltaLog,
	DeltaSource,
	ListCell,
	MapOp,
	SeqOp,
	Sequence,
	SequenceCell,
	SetOp,
	Tracked,
	delta_log_limit,
	map_each,
};

/// A resource that can be released. An `Owner` collects `Disposable`s and releases
/// them as a group; `Subscription`, `Owner`, and `std::ui`'s `View` are disposable.
export trait Disposable {
	fun dispose(self);
}

/// A registered observer of a signal: `notify` re-runs it when the signal's value
/// changes; `id` lets a `Subscription` find and remove it.
///
/// The id is the OBSERVER's, not the registration's (A124 R2). The consumer of a
/// pipe mints ONE subscriber and every stage forwards it to its upstream untouched
/// (`Source::on_settle`), so a diamond puts the same record on a
/// root's list twice, or on two roots' lists once each — and `enqueue`'s dedup,
/// keyed on this id, collapses the duplicate notify into one call. Nothing is lost
/// by the collapse: every copy of one record is the same record, the same `notify`,
/// the same liveness cell.
export struct Subscriber {
	id: i32,
	notify: || void,
	/// LIVENESS — `false` once this subscriber's `Subscription` was disposed
	/// (tracker A110, door 1). Both notification loops read it and skip a lowered
	/// one: `drain`'s wave loop and `SignalCell::notify`'s inline arm.
	///
	/// The flag is what makes "a disposed observer never fires" TRUE rather than
	/// nearly true. Detaching from the subscriber list and scrubbing the ambient
	/// turn's pending queue — the two things `Subscription::dispose` did — both
	/// miss a subscriber that is already IN FLIGHT, and there are three ways for
	/// that to happen:
	///
	///   1. **The inline snapshot.** With no ambient turn `notify` iterates
	///      `subscribers.read()`, which is a COPY. An earlier observer in that
	///      copy may cascade depth-first and dispose a later one; the copy
	///      still holds it, so it was called anyway.
	///   2. **The wave copy.** `drain` takes a whole wave OUT of `pending`
	///      before running it, so a dispose from inside the wave scrubs a queue
	///      the wave is no longer in.
	///   3. **The scrub's blind spot.** `dispose` scrubs the AMBIENT turn, and
	///      the ambient turn of a disposer reached through a stored closure is
	///      the one that closure captured (spec §8.4) — usually none. A cleanup
	///      running inside a drain therefore scrubbed nothing at all, while the
	///      subscriber sat in the draining turn's queue waiting for a later
	///      wave.
	///
	/// A cell and not a plain field, deliberately: every reader above holds a COPY
	/// of the `Subscriber` (a list read, a wave, an enqueued entry), and `Shared`
	/// is the one thing a copy does not duplicate (spec §6.9), so the one flag is
	/// visible through every copy that exists. It is the same cell the owning
	/// `Subscription` holds, so lowering is O(1) and does not depend on finding the
	/// entry in any list.
	live: Shared<bool>,
	/// CLASS — is this subscriber a DERIVATION (A110 door 2)? A derivation
	/// exists to publish a value; an effect exists to act on one. `drain` runs
	/// the derivations of a wave to a fixpoint FIRST and only then the effects,
	/// which is what makes an effect see a settled graph.
	///
	/// A plain field and not a cell, deliberately, where `live` above is a
	/// cell: liveness CHANGES after the subscriber is made and every copy must
	/// see the change, and a class never changes at all. It is decided by the
	/// one thing that mints an observer's subscriber (`mint_subscriber`, reached
	/// from `observe` and from a pipe's consumer) from the mark
	/// `as_derivation` leaves, and it is read at exactly one place (`enqueue`,
	/// to pick the bucket).
	derived: bool,
}

/// The liveness cell every DEFERRAL subscriber shares — `at_settle`'s and
/// `at_release_settle`'s, the ones `defer_to_turn` mints.
///
/// One cell for the program rather than one per deferral, because a deferred action
/// has no `Subscription`: nothing holds a handle to it, so there is nothing that
/// could ever lower its flag, and a per-call cell would be an allocation on
/// `at_settle`'s hot path (a remote mirror defers its `Unsubscribe` through it on
/// every release) bought for a bit that cannot change. A future `Subscriber` that
/// something CAN dispose mints its own, as `observe` does.
let always_live: Shared<bool> = Shared::new(true);

/// The DERIVATION MARK (A110 door 2) — set by `as_derivation`, consumed by the
/// `observe` the marked attach reaches.
///
/// Tagging a derivation AT ITS OWN `on_change` call is not something the trait can
/// express: a generic `on_change` reaches the impl's own `attach_observer`, not
/// `observe`. But every observer in the world is minted in one place — `observe`
/// for a cell, `Flow::on_change`'s pulling subscriber for a pipe, and every other
/// source bottoms out in one of those (`RemoteSource`'s lazy attach is
/// `self.cache.on_change(observer)`) — so the mark is left at the derivation site
/// and read where the `Subscriber` is actually minted, one layer below every impl.
///
/// CONSUMED rather than merely read, which is what keeps the window one
/// subscriber wide: `RemoteSource::on_change` attaches and then `acquire()`s,
/// and a seeding frame arriving inside that call must not be able to mint a
/// second derivation. The attach is the first statement of every one of those
/// bodies, so the mark reaches exactly the subscriber it was left for.
let minting_derivation: Shared<bool> = Shared::new(false);

/// Mark the subscriber the NEXT attach mints as a DERIVATION — one statement above
/// the attach it describes:
///
///     as_derivation();
///     let _owned = register_with_owner(self.on_change(|value| ..));
///
/// A bare statement and not a wrapper, and neither half of that is stylistic.
/// A CLOSURE wrapper (`as_derivation(|| register_with_owner(..))`, which is
/// what lane reactive-38's instrument wrote) carries the ambient contexts, and
/// that put an 8-node component into the no-cycle gate's UNMOUNTED reading
/// (`reactive_lifetimes::a_disposed_exemplar_holds_no_reactive_cycle`), which
/// is the one number in the suite that may never be regenerated. A marker
/// taking the SOURCE and handing it back (`as_derivation(self).on_change(..)`)
/// reads better and costs a `__clone` of the source per derivation, because
/// returning a value is a copy — nineteen new copy sites across the corpus.
/// Nothing is passed and nothing is returned, so neither is bought.
export fun as_derivation() {
	minting_derivation.write() = true;
}

/// Monotonic ids for subscribers — module-level, one counter for the program.
let next_subscriber_id: Shared<i32> = Shared::new(0);

export fun fresh_id(): i32 {
	let id = next_subscriber_id.read();
	next_subscriber_id.write() = id + 1;
	id
}

/// Mint the subscriber for ONE observer — a fresh id, its own liveness cell, and
/// the class the derivation mark left (A110 door 2), spent here.
///
/// Every observer std subscribes is minted here: `observe`'s payload observer and,
/// since the protocol split the mint from the attach (A124 S2a), the no-payload
/// subscriber a pipe's consumer attaches through the pipe. That keeps this the one place the
/// mark is spent, as `observe` was: an attach no longer mints, it pushes a record
/// it was HANDED, so a leaf standing on three registrations spends the mark once.
export [internal("a node author's subscriber mint (A110 door 2's mark spent here); an application attaches through `on_change`/`sub`")]
fun mint_subscriber(notify: || void): Subscriber {
	let derived = minting_derivation.read();
	minting_derivation.write() = false;
	subscriber_of(notify, derived)
}

/// A subscriber of a known class, mark untouched. The RELAY shape: a stage that
/// must keep a registration of its OWN — a `Switch`'s re-selection, a `Distinct`'s
/// comparison — registers one of these upstream and re-notifies its downstream
/// through `wake`, so the downstream's id is still the one the turn dedups on.
///
/// A relay is always a DERIVATION: it decides whether (and which) downstream to
/// wake, and that has to happen in the wave's first phase, where a derivation it
/// wakes still joins the fixpoint and an effect it wakes still runs after it.
fun subscriber_of(notify: || void, derived: bool): Subscriber {
	Subscriber { id = fresh_id(), notify, live = Shared::new(true), derived }
}

// === Turn scheduler (`proposal/reactive-turns.md`) ===
//
// Flush is SCOPED, not global. A `Turn` owns a pending-notification queue and
// is established for a dynamic extent through `turn_scope` (`std::context`),
// so two interleaved extents — two server requests, two event handlers — can
// never drain each other's queues: a `set` commits its value immediately and
// defers the NOTIFICATION into the ambient turn's queue (no ambient turn →
// notify inline, exactly as before; deferral is opt-in at a boundary).
// Context capture-at-creation carries a turn across its own extent's awaits
// while interleaved extents keep theirs.

export enum FlushPolicy {
	// Settle when the turn's extent ends — the transactional cadence (server
	// dispatch).
	AtEnd,
	// The optimistic-paint cadence (UI events).
	AtSuspension,
}
// v1 NOTE (reactive-turns.md): for an ASYNC extent the policies converge —
// the sync part settles when `turn`'s body returns (its first suspension),
// and each CONTINUATION segment settles on a microtask right after it runs
// (see `enqueue`'s settled path), coalesced per segment. A true
// held-across-await `AtEnd` needs a `turn` that can await its body
// (recorded follow-on); the enum states intent and keeps the API stable.

/// The host's microtask queue — the continuation-settling primitive.
export [extern("queueMicrotask", retains)]
external fun queue_microtask(callback: || void);

/// The runtime's `try`/`finally` (tracker B292). vilan has no exception
/// syntax, so the catch seam is glue — `__with_finally` in `transformer.rs`,
/// the shape `std::db`'s `exec_guarded` already uses at this boundary. Run
/// `body`, and run `after` before the stack leaves: on a normal return AND on
/// a host throw, which then keeps unwinding UNTOUCHED — its type, its message
/// and its stack are the ones it was thrown with, from where it was thrown.
/// Nothing is allocated per call, which is what lets the drain hot path carry
/// it.
[extern("__with_finally")]
external fun with_finally(body: || void, after: || void);

/// The runtime's `try`/`catch` (tracker B292) — for a loop that must FINISH past a
/// throw rather than merely restore itself on the way out. `None` when `body`
/// returned; `Some(text)` carrying the host's own diagnosis when it threw. It costs
/// one `Option` per call, so it belongs where the loop is a disposal group and not
/// where it is a notification wave.
export [extern("__guarded")]
external fun guarded(body: || void): Option<str>;

export struct Turn {
	// The EFFECT queue, kept ASCENDING BY SUBSCRIBER ID (A110 door 2): the ids are
	// minted by one monotonic counter and a parent form's effect is created when
	// the parent is PLACED, before anything its render closure creates, so
	// ascending id is parent-before-child with no owner-depth bookkeeping anywhere.
	// `enqueue` does the ordered insert rather than `drain` sorting a wave, because
	// entries arrive close to in order already — the scan is one comparison in the
	// common case, against O(k²) for an insertion sort per wave (reactive-turns.md
	// §7.5: 60 % of the naive cost).
	pending: Shared<List<Subscriber>>,
	// The DERIVATION queue (A110 door 2). Bucketed at INSERT time, so `drain` has
	// nothing to partition: it runs this bucket to a fixpoint and only then the
	// effects. Unordered — a derivation publishes a value, and the fixpoint is what
	// makes the order among them unobservable.
	pending_derived: Shared<List<Subscriber>>,
	// The ids in `pending`, as a keyed set — `enqueue`'s dedup (A44). Kept in exact
	// step with `pending`: cleared when a wave is taken out, scrubbed when a
	// `Subscription` removes itself.
	queued: Shared<NativeMap<bool>>,
	// The same dedup for `pending_derived`, and a SECOND map rather than one map
	// over both queues. The two queues have two wave boundaries, so one shared map
	// could no longer be cleared wholesale when a wave is taken out — it would have
	// to lose ids one `remove` at a time, which is a change to the drain's hot path
	// with a cost of its own (tracker M83, measured separately). Two maps keep the
	// fresh-map-per-wave shape exactly as it was, so door 2 is charged for door 2
	// only.
	queued_derived: Shared<NativeMap<bool>>,
	draining: Shared<bool>,
	// True once the extent's own settle ran; a LATE enqueue (an async
	// continuation's write) then schedules its own segment-coalesced drain.
	settled: Shared<bool>,
	scheduled: Shared<bool>,
}

export impl Turn {
	fun new(): Turn {
		Turn {
			pending = Shared::new([]),
			pending_derived = Shared::new([]),
			queued = Shared::new(NativeMap::new()),
			queued_derived = Shared::new(NativeMap::new()),
			draining = Shared::new(false),
			settled = Shared::new(false),
			scheduled = Shared::new(false),
		}
	}

	/// Nothing left to run — BOTH queues empty (A110 door 2). The drain's own loop
	/// condition, named: with two buckets there are two ways for a turn to still
	/// have work, and a settle is over when neither has any.
	fun is_quiescent(self): bool {
		self.pending.read().is_empty() && self.pending_derived.read().is_empty()
	}
}

/// The ambient transaction. Established by `turn`/`batch` (and, at the framework
/// boundaries, `std::ui` event dispatch and the RPC server's per-message dispatch);
/// read by `set` via `get_safe`, so unscoped code pays nothing.
export let turn_scope: Context<Turn> = Context::new();

/// Drain affinity — the ONE runtime device in the model. A notify fired during a
/// drain may `set` (a derived recomputing), but that notifier is an arbitrary
/// closure created ANYWHERE (usually outside every extent), so compile-time capture
/// cannot hand it the draining turn. A set that sees no ambient turn joins the
/// CURRENTLY DRAINING one instead — which is what keeps cascades coalescing (dedup)
/// inside their own settle. Drains are synchronous, so entries cannot interleave
/// across extents; this never crosses an `await`.
let draining_turns: Shared<List<Turn>> = Shared::new([]);

/// Release affinity (tracker B283) — the narrow twin of `draining_turns`, and the
/// second and last runtime device in the model.
///
/// A subscription's RELEASE HOOK is a stored closure, so the turn its body
/// reads is the one it captured AT CREATION (spec §8.4's context rule). A
/// lease taken outside every turn — the top of `main`, a module-level binding,
/// a handle fetched before the first event — and then disposed INSIDE one
/// therefore deferred its `Unsubscribe` against no turn at all and sent it
/// inline, so a dispose-and-rebuild in one turn paid a whole
/// `Unsubscribe` + `Subscribe` round for a rebuild the guide promises churns
/// nothing (the plant measured `same-turn:up=2 down=1`). The capture rule is
/// right for a `set` from a stored callback and wrong for this, because a
/// release is not the hook's own event: it is the DISPOSER's.
///
/// `Subscription::dispose` is the one place that knows the answer — it reads
/// the ambient turn a few lines earlier to scrub the pending queue — so it
/// publishes it here for the duration of the hook, and `at_release_settle`
/// reads it. A stack, because disposing one subscription may dispose another;
/// `None` ON the stack is an honest "no turn was ambient at that release",
/// which is a different answer from an empty stack's "no release is running".
let releasing_turns: Shared<List<Option<Turn>>> = Shared::new([]);

/// Enqueue subscribers into `turn`'s queue, deduped by id so a subscriber fed by
/// several inputs in one turn fires once — the dedup *is* the glitch-freeness.
///
/// The membership test is a KEYED SET (A44), not a scan of the pending list. The
/// scan it replaces was linear in the queue's own length and it ran inside
/// `Signal::notify`'s loop, so one write that reached n queued observers cost O(n²)
/// — which is exactly the regime `selector` exists to serve, a thousand rows deep.
/// `queued` holds the ids in `pending` and nothing else, so the semantics are
/// unchanged, one entry per subscriber per wave.
///
/// The entry is ROUTED BY CLASS (A110 door 2). A derivation goes to
/// `pending_derived`, unordered — the fixpoint is what makes the order among
/// derivations unobservable. An effect goes to `pending`, INSERTED so that the
/// queue stays ascending by subscriber id, which is the ordering contract
/// itself: within one settle, a parent form's effect runs before anything its
/// render created.
///
/// The insert scans BACKWARDS from the end, and that is the whole reason this is
/// not a sort: a wave's entries arrive close to in order already (one cell's
/// subscriber list is in attach order, and attach order is creation order), so the
/// common case is one comparison and a push at the end. A partition-and-sort per
/// wave measured 2.2× the drain's cost against this shape's +23.5 %
/// (reactive-turns.md §7.5, §7.10).
fun enqueue(turn: Turn, subscribers: List<Subscriber>) {
	for subscriber in subscribers {
		let key = subscriber.id.hash();
		if subscriber.derived {
			if !turn.queued_derived.read().contains_key(key) {
				turn.queued_derived.write().insert(key, true);
				turn.pending_derived.write().push(subscriber);
			}
		} else if !turn.queued.read().contains_key(key) {
			turn.queued.write().insert(key, true);
			// The scan reads through `write()` and not through `read()`, and that
			// is the difference between O(1) and O(n) PER ENQUEUE: `read()` yields
			// a VALUE, so binding the queue to a local copies the whole list
			// (`__clone`), and a wave of n observers on one cell then costs n²
			// element copies — the shape reactive-turns.md §7.5 records as "a trap
			// for whoever builds this", measured here at 7.6 s against 80 ms for
			// A44's 2,000-observer pin. A `&mut` view indexes the storage in place.
			mut index = turn.pending.write().len();
			for index > 0 && turn.pending.write()[index - 1].id > subscriber.id {
				index -= 1;
			}
			turn.pending.write().insert(index, subscriber);
		}
	}
	// A write AFTER the extent settled — an async continuation's — must not sit
	// forever (and must not settle per-set, which would glitch a multi-input
	// observer): one microtask drains the whole segment's writes together, right
	// after the segment runs.
	if turn.settled.read() && !turn.scheduled.read() && !turn.draining.read() {
		turn.scheduled.write() = true;
		queue_microtask(|| {
			turn.scheduled.write() = false;
			drain(turn);
		});
	}
}

/// Drain `turn` until quiescent — the "settle now" primitive. A notify may
/// enqueue more (a derived propagating), which this same loop drains.
/// Re-entrancy-guarded per turn (a `set` from inside a notify only enqueues;
/// the running loop picks it up) and budget-bounded (a feedback loop that
/// never converges stops here instead of hanging).
export fun drain(turn: Turn) {
	if !turn.draining.read() {
		turn.draining.write() = true;
		draining_turns.write().push(turn);
		// The restore is a FINALLY (tracker B292). A notify is an arbitrary
		// closure — an application observer that panics, a host API that
		// refuses its argument (Chrome's `insertRule` on a selector it does
		// not know) — and a throw out of one unwound straight past the two
		// writes below. The turn then stayed DRAINING forever and stayed on
		// `draining_turns`, so every later write that resolved to it — a
		// settled capture's late path, and EVERY no-ambient-turn `set` or
		// `at_settle`, which join `draining_turns.last()` — enqueued and never
		// flushed: one error turned the reactive graph off for the rest of the
		// session, with no second error to show for it.
		//
		// Restore-and-rethrow, not catch-and-continue: the wave's remaining
		// notifies are abandoned, because a throwing observer means the graph is
		// mid-update and the honest thing is for the write that started the drain
		// to see the failure. What the finally guarantees is that the SCHEDULER
		// survives it — the next `set` drains normally, this turn included. Nested
		// drains unwind in LIFO order, so each one's finally pops its own entry.
		with_finally(|| {
			mut budget = 100000;
			for !turn.is_quiescent() && budget > 0 {
				// PHASE 1 — DERIVATIONS, to a fixpoint (A110 door 2). A
				// sealed pipe's (`.memo()`/`.cell()`), a stage relay's or a
				// `selector`'s subscriber exists to
				// publish a value, not to act on one, so every derivation the
				// wave can reach — and every derivation those writes reach,
				// until nothing new is enqueued — runs before any effect. That
				// is what extends the dedup's glitch-freeness from "each
				// subscriber fires once" to "each subscriber fires once, on
				// final values".
				for !turn.pending_derived.read().is_empty() && budget > 0 {
					let derivations = turn.pending_derived.read();
					turn.pending_derived.write() = [];
					turn.queued_derived.write() = NativeMap::new();
					for subscriber in derivations {
						if subscriber.live.read() {
							(subscriber.notify)();
						}
						budget -= 1;
					}
				}
				// PHASE 2 — EFFECTS, in the order `enqueue` already put them
				// in: ascending subscriber id, which is parent-before-child
				// wherever the forms are genuinely nested. Order among
				// INDEPENDENT observers of one source is NOT part of the
				// contract (reactive-turns.md §7.10) — it is what this queue
				// happens to do.
				let wave = turn.pending.read();
				turn.pending.write() = [];
				// The wave is out of the queue, so its ids are free to re-enter it
				// — a cascade re-enqueuing an observer this wave already ran is the
				// propagation `drain`'s loop exists for.
				turn.queued.write() = NativeMap::new();
				for subscriber in wave {
					// A subscriber disposed since this wave was taken OUT of the
					// queue does not fire (A110 door 1, `Subscriber.live`).
					// `dispose`'s scrub cannot reach it — the wave is no longer in
					// `pending` — and neither can a disposer whose own ambient turn
					// is not this one. The budget is charged either way: it is a
					// cascade cutoff, not a count of work done.
					//
					// Door 2 is why the flag rather than a live queue: an effect
					// that disposes a child EFFECT of the same wave — which is
					// every nested form's teardown — cannot be asked to reach
					// into the list phase 2 is walking (reactive-turns.md §7.4,
					// finding one, resolved by door 1 landing first).
					if subscriber.live.read() {
						(subscriber.notify)();
					}
					budget -= 1;
				}
			}
		}, || {
			draining_turns.write().pop();
			turn.draining.write() = false;
		});
	}
}

/// Settle the AMBIENT turn's pending notifies now. With no ambient turn there is
/// nothing pending by construction (every `set` notified inline).
export fun flush() {
	match turn_scope.get_safe() {
		Some(let turn) => drain(turn),
		None => {},
	}
}

/// Run `action` when the ambient turn settles; with no ambient turn, now. The
/// action rides the turn's pending queue as an ordinary `Subscriber`, so it is
/// deduped by `id` exactly like a notification — repeated deferrals of the same
/// action inside one turn flush once — and it resolves its turn the way
/// `Signal::notify` does: the ambient turn, else the currently DRAINING one (an
/// action deferred from inside a settle joins that settle), else inline. The caller
/// owns `id` (a `fresh_id()` kept for the action's lifetime) so the dedup is per
/// action, not per call. "Ambient" is the context rule's (spec §8.4): reached
/// through a stored closure — an owner's cleanup, a subscription's release hook —
/// the turn is the one that closure captured at creation, exactly as a `set` from a
/// stored callback; a settled capture drains on a microtask (`enqueue`'s late
/// path), which still lands after the current synchronous segment. A release hook
/// that wants the turn ambient at the RELEASE instead says `at_release_settle`
/// (B283). `proposal/remote-sources.md` §2a: the `Unsubscribe` a remote mirror owes
/// at its last release is deferred there, which is what lets a same-segment
/// re-subscribe cancel it.
export fun at_settle(id: i32, action: || void) {
	defer_to_turn(turn_scope.get_safe(), id, action)
}

/// `at_settle` for a subscription's RELEASE HOOK: resolved against the turn ambient
/// at the RELEASE rather than the one the hook captured at creation (tracker B283).
///
/// Outside a release hook this IS `at_settle` — a direct `mirror.release()` reads
/// its caller's turn correctly, because nothing stored stands between them — so the
/// two are one rule with one extra question asked first.
export fun at_release_settle(id: i32, action: || void) {
	match releasing_turns.read().last() {
		Some(let at_release) => defer_to_turn(at_release, id, action),
		None => at_settle(id, action),
	}
}

/// The shared tail of both: park `action` on `turn` if there is one, else on the
/// currently DRAINING turn (an action deferred from inside a settle joins that
/// settle), else run it now. Takes the turn as a VALUE — the whole difference
/// between the two callers above is which turn they resolve, and that question
/// belongs at the seam, not in here.
fun defer_to_turn(turn: Option<Turn>, id: i32, action: || void) {
	// EFFECT-CLASS (A110 door 2), and not a third class of its own: a deferred
	// action acts, it does not publish, so it belongs after the derivations have
	// settled — which is what "when the turn settles" means. Its position among the
	// effects is its `id`'s, exactly like a notification's.
	defer_subscriber(turn, Subscriber { id, notify = action, live = always_live, derived = false });
}

/// Hand one subscriber to `turn` if there is one, else to the currently DRAINING
/// turn, else notify it now — the resolution `SignalCell::notify` makes for a
/// whole list, made for one record. Inline, the record's liveness is read first,
/// exactly as `notify`'s inline arm reads it (A110 door 1); queued, `drain` reads
/// it when the record's turn comes.
fun defer_subscriber(turn: Option<Turn>, subscriber: Subscriber) {
	match turn {
		Some(let ambient) => enqueue(ambient, [reissued(subscriber)]),
		None => {
			match draining_turns.read().last() {
				Some(let draining) => enqueue(draining, [reissued(subscriber)]),
				None => {
					if subscriber.live.read() {
						(subscriber.notify)();
					}
				},
			}
		},
	}
}

/// `subscriber` as a fresh record of the same four fields — for a record that has
/// to go INTO a list (a subscriber list, a turn's queue) from a parameter.
///
/// A parameter placed in a list is a rule-1 copy (`__clone`), and on the attach
/// path that is one per subscription in the program, where `observe` used to build
/// its record in place and pay none. Every field is a scalar, a closure or a
/// `Shared`, none of which a copy duplicates (spec §6.9), so the reissued record IS
/// the original: the same id, the same notify, the same liveness cell.
fun reissued(subscriber: Subscriber): Subscriber {
	Subscriber {
		id = subscriber.id,
		notify = subscriber.notify,
		live = subscriber.live,
		derived = subscriber.derived,
	}
}

/// Re-notify a DOWNSTREAM subscriber from a relay (A124 R2): a node that keeps a
/// registration of its own — `Switch`, `Distinct`, `Source::on_settle`'s payload
/// bridge — is told first, decides, and then wakes the observer below it.
///
/// Through the TURN, not by a direct call, and that is the whole reason this
/// exists: in a turn the downstream is enqueued under its own id, so a relay's
/// wake and the same observer's direct registration elsewhere in its chain (the
/// diamond's other arm) collapse into one call in `enqueue`'s dedup, and the
/// observer keeps its own class and its own place in the effect order. With no
/// turn anywhere it is a call, as every inline notification is.
///
/// The turn is the DRAINING one, and the ambient turn is not asked — which is both
/// correct and load-bearing. Correct, because a relay is a subscriber and is only
/// ever run by a list walk: under an ambient turn `SignalCell::notify` QUEUES a
/// relay rather than calling it, so a relay runs either inside that turn's drain or
/// inline with no turn at all, and those are exactly the two answers this gives.
/// Load-bearing, because reading `turn_scope` here would give `Source::on_settle`'s
/// default a hidden context parameter that `SignalCell`'s override does not take,
/// and one table signature cannot carry a parameter only some implementations
/// declare: every `dyn Source` would stop building natively.
fun wake(subscriber: Subscriber) {
	defer_subscriber(None, subscriber);
}

/// Establish a FRESH turn for `body`'s dynamic extent, and settle it when the
/// extent ends. The isolation primitive: `body`'s writes (and those of the closures
/// it creates — capture-at-creation) queue here and nowhere else.
///
/// The body is a plain closure parameter, so it is asyncness-polymorphic (spec
/// §7.4): a synchronous body drains at the end of its synchronous extent — the
/// atomic turn — and an AWAITING body adapts, holding EVERY notification — before
/// the first suspension and in every continuation — until the body has fully
/// completed, then settling once (same-signal writes coalesce to their final
/// value). The held form is the wire turn: an RPC handler that reads, awaits, and
/// writes publishes one coherent wave. (`turn_async` was the pre-adaptation
/// spelling of the held form.)
export fun turn<T>(policy: FlushPolicy, body: (|| T) context turn_scope): T {
	// The policies converge for async extents in v1 — see `FlushPolicy`.
	let _cadence = policy;
	let fresh = Turn::new();
	let result = turn_scope.run(fresh, body);
	drain(fresh);
	fresh.settled.write() = true;
	result
}

/// The optimistic-write → reconcile lifecycle (reactive-turns.md §5.5):
/// paint `value` into `signal` NOW, run `commit` (usually a server call),
/// then reconcile — the confirmed value on success, the previous value
/// rolled back on failure. Returns the outcome for the caller's error UX.
/// Under a UI turn the optimistic paint settles when the handler's sync
/// extent ends (its first suspension); the reconcile settles as its own
/// continuation segment. Inside a held turn (a `turn` with an awaiting
/// body) the whole lifecycle holds — the transaction wins.
///
/// Bounded on `Signal<T>` because it WRITES (A32's write-back class, with
/// `Optimistic::over` and `ui`'s `bind_value`). `Source` declares `get`/`sub`
/// and no `set`, so the whole point of this function is outside it — and any
/// impl of the writable trait serves, not only the canonical cell.
export fun optimistic<T, E, S: Signal<T>>(
	signal: S,
	value: T,
	commit: async || Result<T, E>,
): Result<T, E> {
	let previous = signal.get();
	signal.set(value);
	let outcome = commit();
	match outcome {
		Ok(let confirmed) => signal.set(confirmed),
		Err(let _error) => signal.set(previous),
	}
	outcome
}

/// Run `body` with notifications deferred, settled once — joins the ambient turn
/// when one is established (nested batches fold into the outermost, the shipped
/// semantics), else a fresh at-end turn. Returns `body`'s value.
///
/// The body is INJECTED (`context turn_scope`), not captured: a batch body is a
/// literal at the call site, created BEFORE the batch's extent exists —
/// capture-at-creation would hand it the caller's (often absent) turn. Both arms
/// enter the extent through `run`, which supplies the turn to the deferred literal:
/// the join arm re-establishes the CURRENT turn (same queue; the outer settle fires
/// once), the fresh arm settles at the end.
export fun batch<T>(body: (sync || T) context turn_scope): T {
	match turn_scope.get_safe() {
		Some(let current) => turn_scope.run(current, body),
		None => {
			let fresh = Turn::new();
			let result = turn_scope.run(fresh, body);
			drain(fresh);
			fresh.settled.write() = true;
			result
		},
	}
}

/// A live subscription. Dropping it does NOT stop it (an owner scope is responsible
/// for that — see the proposal); call `dispose` to stop early.
export struct Subscription {
	// WEAK, and this is the second of std's two back edges (C14 S3,
	// `signal-cell-representation.md` §6). A subscription is an alias of the
	// SIGNAL's subscriber list, held by whoever took it — an owner's cleanup
	// list, an app's own binding — and none of those holders is the list's
	// owner. A strong alias would mean a live handle to a disposed signal's
	// list kept that list alive for as long as the handle lived, which is the
	// leak a count cannot collect and the GC only hides.
	subscribers: Weak<List<Subscriber>>,
	id: i32,
	// The subscriber's LIVENESS cell — the same cell the `Subscriber` in the list
	// carries (A110 door 1, `Subscriber.live`). `dispose` lowers it, and both
	// notification loops skip a lowered subscriber, which is what makes "a disposed
	// observer never fires" hold for one already in flight: in an inline notify's
	// snapshot, in a wave `drain` has already taken out of `pending`, and in a
	// queue the disposer's own ambient turn cannot reach.
	//
	// Held HERE as well as in the list so that lowering never depends on the
	// weak edge above: a `None` upgrade means there is no list to detach from,
	// and it must not also mean there is no flag to lower.
	live: Shared<bool>,
	// Extra teardown to run on dispose, once. `Signal::sub` leaves it `None`;
	// a COUNTED subscription — `RemoteSource::sub`, whose lease holds a
	// network channel open (`proposal/remote-sources.md` §2a) — puts its
	// decrement here, so disposing the handle releases the lease too. A cell,
	// so every copy of the handle shares the one-shot.
	release: Shared<Option<|| void>>,
}

export impl Subscription {
	/// A subscription over NO signal: `dispose` runs `release` once and does
	/// nothing else. The registration shape for a source outside the signal graph —
	/// `std::dom`'s `listen`, whose whole teardown is the call that unhooks the DOM
	/// listener (`proposal/router.md` §5.2).
	///
	/// The one-shot is the `release` cell's, so an owner releasing a handle the app
	/// already disposed by hand cannot unhook twice.
	fun teardown(release: || void): Subscription {
		// Its own liveness cell, not the module-level `always_live`: this handle IS
		// disposable, and lowering a shared flag would retire every deferred action
		// in the program. Nothing reads it (there is no subscriber to skip) and it
		// stays for the uniform representation.
		detached(fresh_id(), Shared::new(true), release)
	}
}

/// The handle a stage hands back when it could not simply FORWARD its
/// downstream's subscriber (A124 R2) — a `Combine`'s arms, a `Switch`'s own
/// registrations; a relay needing only its liveness chained uses `also_retiring`.
/// Disposing it retires `subscriber` itself: its liveness goes down (so a copy
/// already queued in a turn, or in flight in a wave, never fires — A110 door 1),
/// the ambient turn is scrubbed of its id, and `release` then takes down the
/// registrations the node made.
///
/// That is the one obligation `on_settle` puts on the handle it returns — "when
/// this is disposed, `subscriber` never fires again" — and a node that forwards
/// meets it for free, because the root's handle carries the subscriber's own
/// liveness cell.
fun retiring(subscriber: Subscriber, release: || void): Subscription {
	detached(subscriber.id, subscriber.live, release)
}

/// Make `handle` retire `subscriber` as well when it is disposed — for a handle
/// that is a RELAY's own (`Distinct`'s comparison), whose disposal must also lower
/// the liveness of the observer the relay wakes, so a wake already queued for it is
/// skipped (A110 door 1).
///
/// The retirement is CHAINED onto the handle's release rather than wrapped in a
/// second handle whose release disposes this one, and that is not an economy. A
/// closure that calls `dispose` reads the ambient turn (`dispose` scrubs it), so
/// the default body that made one would take a hidden context parameter that
/// `SignalCell`'s override does not — and a `dyn Source` cannot carry a table slot
/// whose implementations disagree about their parameters natively. Lowering a flag
/// and calling the release the handle already had (a mirror's lease) reads no
/// context at all.
///
/// It returns nothing: `release` is a cell, which every copy of the handle shares,
/// so the caller hands back the handle it already holds — returning this
/// parameter would be a rule-1 copy.
fun also_retiring(handle: Subscription, subscriber: Subscriber) {
	let previous = handle.release.read();
	handle.release.write() = Some(|| {
		subscriber.live.write() = false;
		match previous {
			Some(let release) => release(),
			None => {},
		}
	});
}

/// A handle over NO subscriber list, whose disposal runs `release` once: the shape
/// `Subscription::teardown` and `retiring` share, which differ only in whose id and
/// whose liveness the handle carries.
fun detached(id: i32, live: Shared<bool>, release: || void): Subscription {
	mut subscribers: List<Subscriber> = [];
	// There is no signal here, so there is no subscriber list to alias: the cell
	// dies with this frame and the weak handle answers `None` once anything counts
	// (C14 S4). `dispose`'s `None` arm is the right answer for exactly this case —
	// nothing to detach, and `release` still runs, which is the whole of this
	// shape's teardown.
	let empty: Shared<List<Subscriber>> = Shared::new(subscribers);
	Subscription { subscribers = empty.downgrade(), id, live, release = Shared::new(Some(release)) }
}

export impl Subscription with Disposable {
	fun dispose(self) {
		// THE TURN IS RESOLVED THE WAY `SignalCell::notify` RESOLVES ITS OWN
		// (FIND-2): the ambient turn, else the currently DRAINING one — see
		// `release_under` for why each half is needed.
		let ambient = match turn_scope.get_safe() {
			Some(let established) => Some(established),
			None => draining_turns.read().last(),
		};
		release_under(self, ambient);
	}
}

/// `dispose` for a registration a NODE made for itself (A124 S2b) — a `Switch`'s
/// rolling inner, a `Combine`'s arms — resolved against the DRAINING turn only.
///
/// A node's registrations are released from inside its own handle's release (a
/// stored closure), and `dispose` there would read the ambient turn: the closure
/// would capture it, and every node's `on_settle` — and through the dispatch,
/// every `on_change` in the program — would take a hidden context parameter, which
/// the native backend cannot give one slot of a `dyn Source` table and not
/// another. The ambient half of the answer only matters to a scrub (an
/// optimization since A110 door 1) and to a release hook's turn (B283), and a
/// node's registration is released either inside a drain — where the draining turn
/// IS the answer — or from inside the release of the handle an owner's teardown
/// disposed, whose `dispose` PUBLISHED its ambient turn for exactly that extent
/// (`releasing_turns`), which is where this reads it.
fun detach(handle: Subscription) {
	// Inside a release, the turn that release published (B283's own answer,
	// which is `dispose`'s ambient one); else the draining turn, else none.
	let turn = match releasing_turns.read().last() {
		Some(let at_release) => at_release,
		None => draining_turns.read().last(),
	};
	release_under(handle, turn);
}

/// The body of `dispose`, given the turn it resolves: lower the liveness, detach
/// from the subscriber list, scrub `ambient`'s queues, run the release hook once
/// with `ambient` published for it.
fun release_under(handle: Subscription, ambient: Option<Turn>) {
	// LIVENESS DOWN FIRST (A110 door 1). Everything below is a REMOVAL — from the
	// subscriber list, from the ambient turn's pending queue — and a removal cannot
	// reach a subscriber that is already in flight. The flag can, because every
	// copy of the `Subscriber` shares this one cell, so both notification loops see
	// it lowered from this statement on. It goes down before the release hook runs
	// too: a hook that writes a signal must not be able to reach the observer it is
	// releasing.
	handle.live.write() = false;

	// The list this subscription aliases, IF it is still there. Under counting a
	// `None` means the signal outlived nothing and its list is gone, so there is no
	// subscriber to detach — and the rest of the teardown (the turn scrub,
	// `release`) still runs, which is what `Subscription::teardown`'s signal-less
	// shape needs.
	match handle.subscribers.upgrade() {
		Some(let subscribers) => {
			mut kept: List<Subscriber> = [];
			for subscriber in subscribers.read() {
				if subscriber.id != handle.id {
					kept.push(subscriber);
				}
			}
			subscribers.write() = kept;
		},
		None => {},
	}

	// Scrub the AMBIENT turn's pending queue too. Since the liveness flag above,
	// this is an OPTIMIZATION rather than the guarantee — a lowered subscriber left
	// in a queue is skipped when the wave runs — and it is worth keeping: it takes
	// the entry out now, frees its `queued` id so a re-subscribe in the same extent
	// can enqueue, and keeps the queue the length of the live graph.
	//
	// It is also why the flag is not optional: a subscriber queued in ANOTHER
	// extent's turn is out of every scrub's reach. That one used to fire once
	// against current state and no longer does, so `reactive-turns.md`'s note on
	// the cross-turn case is superseded by the flag.
	//
	// `ambient` is the CALLER's answer. `dispose` resolves it THE WAY
	// `SignalCell::notify` RESOLVES ITS OWN (FIND-2): the ambient turn, else the
	// currently DRAINING one; `detach` asks a narrower question. `get_safe` alone
	// was wrong, and wrong in the common case rather than an exotic one. `turn`
	// calls `drain(fresh)` AFTER `turn_scope.run(fresh, body)` has returned, so a
	// drain runs OUTSIDE its own turn's context extent — and a dispose reached from
	// inside a notify is every form's teardown, since a form's own effect is what
	// disposes the previous instantiation. Those disposals read `None` here and
	// scrubbed nothing at all, leaving a disposed subscriber (and its notify
	// closure, and everything that closure captured — a whole torn-down subtree)
	// reachable from the turn's queue until the drain ended. `defer_to_turn` and
	// `notify` have always read the draining turn as the fallback; this is the
	// third reader of the same question and it now asks it the same way.
	//
	// B283 is unaffected. `ambient` is also what `dispose` publishes on
	// `releasing_turns` for the release hook, and the hook's own
	// `at_release_settle` already resolved `None` through `at_settle` →
	// `defer_to_turn` → `draining_turns.last()`, which is the very turn this match
	// now names — the same answer, one hop earlier.
	match ambient {
		Some(let turn) => {
			mut kept_pending: List<Subscriber> = [];
			for subscriber in turn.pending.read() {
				if subscriber.id != handle.id {
					kept_pending.push(subscriber);
				}
			}
			turn.pending.write() = kept_pending;
			turn.queued.write().remove(handle.id.hash());
			// BOTH queues (A110 door 2). The handle does not know its subscriber's
			// class — `derived` is the `Subscriber`'s and this is the
			// `Subscription` — and it does not need to: an id is in at most one
			// bucket, so scrubbing both is one wasted walk of an empty list in the
			// common case and correct in every case.
			mut kept_derived: List<Subscriber> = [];
			for subscriber in turn.pending_derived.read() {
				if subscriber.id != handle.id {
					kept_derived.push(subscriber);
				}
			}
			turn.pending_derived.write() = kept_derived;
			turn.queued_derived.write().remove(handle.id.hash());
		},
		None => {},
	}

	// The release hook runs ONCE: taken out before it runs, so a second `dispose`
	// (an owner releasing a handle the app already disposed by hand) cannot
	// double-decrement a count.
	//
	// `ambient` is published for the hook's duration (tracker B283): the hook is a
	// stored closure, so its own turn read answers the turn it was CREATED under,
	// and a release belongs to whoever disposed it. Under a finally, so a throwing
	// hook cannot leave the stack standing.
	match handle.release.read() {
		Some(let release) => {
			handle.release.write() = None;
			releasing_turns.write().push(ambient);
			with_finally(release, || {
				releasing_turns.write().pop();
			});
		},
		None => {},
	}
}

/// An owner scope: collects subscriptions (and child owners / views) and disposes
/// them as a group. Ownership is explicit for now — build a value, `take` it into
/// an owner, and `dispose` the owner to release the whole group.
///
/// An owner has a DISPOSED state (tracker B291), and it is the half that makes
/// ownership hold across `await`. A registration is a PROMISE to release, and an
/// async continuation registers whenever it happens to run — a route switched away
/// before a handle's reply, an `each` row rebuilt while its first fetch is in
/// flight. Without the flag such a late `take` parked a cleanup on a list nothing
/// ever runs again: the subscription fired for the rest of the session and only a
/// SECOND `dispose` released it. With it, the promise is kept the only way it still
/// can be — the item is disposed ON THE SPOT, because the extent it would have
/// belonged to is already over.
///
/// **An owner is one EPOCH of a cell (A142 S2).** The cell holds the live epoch's
/// number, its cleanups and its nursery; an `Owner` value names one epoch, and it
/// is disposed exactly when the cell has moved past it. That is what lets a pipe
/// stage give every RUN of its body an owner of its own without allocating one: the
/// stage keeps one cell, each run is the next epoch of it, and releasing a run is
/// advancing the epoch — so a late registration from a released run (an `await`
/// that resumed after the next run began) finds its epoch gone and is disposed on
/// the spot, B291's promise, while the next run registers into the live one. The
/// cleanup list is allocated at the epoch's FIRST registration, so a run that
/// registers nothing costs a read and a write (A142 §4.1).
export struct Owner {
	cell: Shared<OwnerCell>,
	epoch: i32,
}

/// The live epoch of an owner: its number, what it must release, and the nursery
/// its tasks run in when it has one (a pipe run's, A142 §4.1). An epoch that has
/// registered nothing holds the shared, never-pushed `no_cleanups` (`listed` is
/// false) and no nursery; each is its own only once something needs it.
export struct OwnerCell {
	epoch: i32,
	// Its own cell once `listed`, so a registration pushes in place. Not an
	// `Option`: the native backend holds a closure list in a `Shared` but not an
	// `Option` of one.
	cleanups: Shared<List<|| void>>,
	listed: bool,
	nursery: Option<Nursery>,
}

/// The cleanup list of every epoch that has registered nothing. Never pushed to:
/// `defer` gives an epoch a list of its own at its first registration.
let no_cleanups: Shared<List<|| void>> = Shared::new([]);

/// How many cleanup lists owners have allocated since the program started — the
/// instrument behind "a run that registers nothing allocates no owner" (A142 §4.1).
let owner_lists_allocated_count: Shared<i32> = Shared::new(0);

/// `owner_lists_allocated_count`, read. A pin's instrument, not an application's.
export [internal("an instrument for the lazy-owner pin (A142 §4.1); it counts, it decides nothing")]
fun owner_lists_allocated(): i32 {
	owner_lists_allocated_count.read()
}

export impl Owner {
	fun new(): Owner {
		Owner {
			cell = Shared::new(OwnerCell { epoch = 0, cleanups = no_cleanups, listed = false, nursery = None }),
			epoch = 0,
		}
	}

	/// Whether this owner has been disposed. A late registration is not an error —
	/// it is the async shape — but a caller that can do something CHEAPER than
	/// register-and-immediately-release (a remote mirror, whose lease is a network
	/// frame) reads this first.
	fun is_disposed(self): bool {
		self.cell.read().epoch != self.epoch
	}

	/// Take ownership of a disposable (a `Subscription`, a `View`, or a child
	/// `Owner`), returning it for chaining. It is released when this owner is — or
	/// NOW, if this owner is already disposed (B291): the item is still returned,
	/// so a caller that chains on it reads a disposed handle rather than a live one
	/// nothing will ever release.
	fun take<T: Disposable>(self, item: T): T {
		self.defer(|| {
			item.dispose();
		});
		item
	}

	/// Register a plain cleanup to run at disposal — for teardown that isn't a
	/// single `Disposable` (e.g. `each` disposing whichever rows are live). On a
	/// disposed owner the cleanup runs immediately, for `take`'s reason.
	fun defer(self, cleanup: || void) {
		if self.is_disposed() {
			cleanup();
		} else {
			let held = self.cell.read();
			if held.listed {
				held.cleanups.write().push(cleanup);
			} else {
				owner_lists_allocated_count.write() = owner_lists_allocated_count.read() + 1;
				self.cell.write() = OwnerCell {
					epoch = held.epoch,
					cleanups = Shared::new([cleanup]),
					listed = true,
					nursery = held.nursery,
				};
			}
		}
	}

	/// The owner of this cell's NEXT run: the live epoch is released (its cleanups
	/// run, its nursery is cancelled) and the epoch after it opened, with a fresh
	/// nursery for its tasks when `with_nursery` — a pipe stage's per-run owner
	/// (A142 §4). Reached from any epoch of the cell: a stage keeps the cell and
	/// renews through whichever epoch it last handed out.
	[internal("a pipe stage's per-run owner (A142 §4); an application disposes an owner and makes a new one")]
	fun renew(self, with_nursery: bool): Owner {
		let live = Owner { cell = self.cell, epoch = self.cell.read().epoch };
		live.dispose();
		let next = self.cell.read().epoch;
		if with_nursery {
			let held = self.cell.read();
			self.cell.write() = OwnerCell {
				epoch = held.epoch,
				cleanups = held.cleanups,
				listed = held.listed,
				nursery = Some(detached_nursery()),
			};
		}
		Owner { cell = self.cell, epoch = next }
	}

	/// The nursery of this owner's live epoch, if it has one. A run renewed with a
	/// nursery has one; `run_body` establishes it for the body.
	[internal("a pipe stage's per-run nursery (A142 §4.1)")]
	fun nursery(self): Option<Nursery> {
		if self.is_disposed() {
			None
		} else {
			self.cell.read().nursery
		}
	}
}

export impl Owner with Disposable {
	/// Idempotent: a second `dispose` runs nothing. The epoch advances FIRST, so
	/// anything a cleanup registers back into this owner is disposed on the spot
	/// instead of landing on the emptied list — and so does a late registration
	/// made through this epoch's handle after a newer epoch opened.
	fun dispose(self) {
		if !self.is_disposed() {
			let held = self.cell.read();
			self.cell.write() = OwnerCell {
				epoch = self.epoch + 1,
				cleanups = no_cleanups,
				listed = false,
				nursery = None,
			};
			// Tasks first: a cancelled task's in-flight IO rejects at once, and a
			// cleanup below that inspects what the run left sees it settled.
			match held.nursery {
				Some(let nursery) => nursery.cancel(),
				None => {},
			}
			// Every cleanup runs, even past a throwing one (tracker B292).
			// `drain`'s finally would be the wrong guard here: a disposal group is
			// a LIST OF PROMISES, not one update, and abandoning the rest of it
			// leaks every subscription after the failure — now permanently, because
			// the epoch above makes a second `dispose` a no-op. So the loop finishes
			// and the first failure is raised after the group is released. Only the
			// first: the later ones are the same event, and a `panic` takes one
			// message.
			if held.listed {
				mut failure: Option<str> = None;
				for cleanup in held.cleanups.read() {
					match guarded(cleanup) {
						Some(let message) => {
							if failure.is_none() {
								failure = Some(message);
							}
						},
						None => {},
					}
				}
				match failure {
					Some(let message) => panic(message),
					None => {},
				}
			}
		}
	}
}

/// === The ambient owner (proposal/ambient-owner.md, backlog A5) ===
///
/// A dynamically-scoped `Owner`, carried by `std::context` — compile-time
/// hidden-parameter threading, so it survives stored callbacks and `await` by
/// construction, and reading it outside any `owner_scope.run` extent is a COMPILE
/// error (the context coverage check), never a runtime absence.
///
/// The extent is entered DIRECTLY on the context:
///
///     owner_scope.run(owner, || {
///         count.effect(|value| ..);   // disposed with `owner`
///     });
///
/// A `run_with_owner(owner, body)` wrapper FUNCTION is impossible by the context
/// model's own rules (probed): `run` requires a closure literal at its call site,
/// and a closure captures its context AT CREATION — a body passed to a wrapper is
/// born at the caller's site, outside the extent, so its reads are statically
/// rejected. The literal therefore belongs at the user's site, on the context
/// itself. (Sugar that keeps this shape is possible as a macro, which splices the
/// literal in place — recorded in the proposal.)
export let owner_scope: Context<Owner> = Context::new();

/// The ambient owner established by the nearest enclosing `owner_scope.run`.
export fun get_owner(): Owner {
	owner_scope.get()
}

/// Hand `subscription` to the ambient owner when there is one, and give it back
/// either way — the OWNER-OPTIONAL half of `Source::effect`
/// (`proposal/lifetimes.md` §5, A28).
///
/// `effect` reads the owner strictly (`get_owner`), which makes "no ambient
/// owner" a COMPILE error; that is right for a subscription the caller never
/// sees, and wrong for the materialising nodes (`.cell()`, `selector`, `.load`,
/// `RemoteSource::status`), which are callable at the top of `main`. So they read
/// it SAFELY: inside a boundary the cell dies with the boundary (the leak A28
/// measured — 25 mount/dispose rounds left 25 dead subscribers on the module path
/// signal — is gone), and outside every boundary it lives as long as its source.
/// (The combinators — `derive`, `switch`, `flatten`, `and_then`, `combine` —
/// build pipes, which register nothing at all until they are consumed, so they
/// need no owner.)
///
/// The ownerless case is therefore leak-as-today, not a refusal — except in a
/// module binding's initializer, where `.cell()` is refused and `.cell_global()`
/// says the lifetime (A130). Refusing it everywhere would be the stronger law ("a
/// derivation must have an owner"), and it is the owner's call and not this
/// function's.
export fun register_with_owner(subscription: Subscription): Subscription {
	match owner_scope.get_safe() {
		Some(let owner) => owner.take(subscription),
		None => subscription,
	}
}

/// `Owner::defer` against the ambient owner when there is one — the
/// `register_with_owner` shape for teardown that is not a single `Disposable`
/// (`flatten`'s rolling inner subscription).
export fun defer_to_owner(cleanup: || void) {
	match owner_scope.get_safe() {
		Some(let owner) => owner.defer(cleanup),
		None => {},
	}
}

/// Run `cleanup` when the ambient owner is released — `get_owner().defer(..)` as a
/// free function (tracker A114, R2).
///
/// ONE NAME, and the AMBIENT OWNER decides what it means. Inside a `scoped_effect`
/// the ambient owner is that RUN's, so the cleanup runs before the next run and
/// once more when the enclosing boundary goes: the per-run hook A113 row 4 recorded
/// as missing. Inside any other boundary — a mounted view, a `swap` instantiation,
/// an `each` row — it is the boundary's, so it runs once, at teardown. That is not
/// two rules; it is `Owner::defer`, reached without having to name the owner.
///
/// STRICT, like `effect` and unlike `defer_to_owner`: no ambient owner is a COMPILE
/// error. A cleanup silently dropped because nothing was in scope to run it is the
/// defect this exists to prevent, so "there is no owner" may not be a runtime
/// no-op.
export fun on_cleanup(cleanup: || void) {
	get_owner().defer(cleanup);
}

/// Run `body` as the NEXT run of a stage body whose runs `runs` holds (A142 §4):
/// the previous run is released — whatever it registered, and the tasks it
/// started — and `body` runs with a fresh epoch of `runs` as its ambient owner and
/// a fresh nursery as its ambient nursery. Every body a pipe runs goes through
/// here: a `derive` transform, a `switch` selector, an `effect`.
///
/// `body` is INJECTED (the `context` clause), not captured: it is a literal at the
/// user's call site, born before the run's owner exists, so capture-at-creation
/// would hand it the BOUNDARY's owner and the whole point would be lost.
///
/// Nothing here allocates an owner: the run's owner is the next epoch of the one
/// cell the stage already holds, and its cleanup list is allocated at the run's
/// first registration (`Owner::defer`). The nursery IS allocated per run — the
/// host's spawn machinery registers a task with the ambient nursery at the `async`
/// expression, so one has to exist before the body runs.
fun run_body<T>(runs: Owner, body: (|| T) context (owner_scope, ambient_nursery)): T {
	let run = runs.renew(true);
	match run.nursery() {
		Some(let nursery) => owner_scope.run(run, || ambient_nursery.run(nursery, || body())),
		None => panic("a renewed run carries its nursery"),
	}
}

/// Release the LAST run a stage made — at the instance's release, when no run
/// follows. A late registration from it (an `await` resuming afterwards) finds its
/// epoch gone and is disposed on the spot (B291).
fun release_runs(runs: Owner) {
	Owner { cell = runs.cell, epoch = runs.cell.read().epoch }.dispose();
}

/// Establish `owner` as the ambient owner for the dynamic extent of `body` — the
/// plain-function wrapper, made possible by the `context` clause
/// (proposal/ambient-owner.md §5): `body` is an INJECTED closure, deferring its
/// ambient reads to call-supplied binding instead of capturing at creation, so the
/// literal may be born at the caller's site. Yields the body's value, like `run`
/// and `batch`.
export fun run_with_owner<T>(owner: Owner, body: (sync || T) context owner_scope): T {
	owner_scope.run(owner, body)
}

/// A component scope in one expression (proposal/ambient-owner.md §4): a fresh
/// owner, the body run under it as the ambient extent, and the body's product
/// PAIRED with the disposal handle — `scope.dispose()` tears down every effect the
/// component registered, stored callbacks and post-`await` registrations included.
export fun comp<T>(body: (sync || T) context owner_scope): (T, Owner) {
	let scope = Owner::new();
	let result = owner_scope.run(scope, body);
	(result, scope)
}

// === Sources and pipes (A142 R29, `proposal/reactive-layers.md` §3) ===========
//
// Two kinds of reactive value, and the whole layer is built from them:
//
//   - a `Source` HAS STATE and can be read: a root cell, a sealed memo, a
//     constant, a remote mirror. Copying one copies a handle.
//   - a PIPE is a transformation (`derive`, `switch`, `distinct`, …): a
//     DESCRIPTION with no `get`. Its node types are `[resource]`s, so a pipe
//     has one owner and is consumed exactly once — SEALED into a source
//     (`.memo()`, `.cell()`, the `_global` twins, `.sample()`) or handed to a
//     CONSUMER (an effect, a UI binding).
//
// `Flow` is what both are: anything a pipeline can start from. It carries the
// combinators and the consumers, and every one of them takes `own self` — for a
// source that is a copy, for a pipe it is the move that makes a second consumer a
// compile error ("use of `p` after it was moved"). `Pipe` adds the sealing
// operations, which exist on pipes only, so `cell.memo()` has no method.
//
// Because a pipe has exactly one consumer, every body in it runs once per change of
// its input, inside the one INSTANCE that consumer started. That is what lets a
// stage keep its own state (a `switch` its current inner, a `distinct` its last
// value) and, since S2, give every run of its body an owner.
//
// **`own self` everywhere, including trait defaults (B463).** A default whose
// receiver is the loan `self` can move a resource `Self` into an aggregate
// undetected, which is exactly what a combinator does with its receiver. `own self`
// is refused-or-sound on every compiler; a loan `self` here is the hole.

/// The read-only view of a reactive value: read the current value, and let a
/// subscriber be told when it may have changed. `SignalCell<T>` implements it (and
/// adds `set`/`set_with` through `Signal`); a *remote* handle implements it too, so
/// code that only observes can't tell a local signal from a remote one
/// (`proposal/transport-rpc.md` §8).
///
/// **Two members, both the implementer's.** `get` is the read, and `on_settle` is
/// the attach: the node author's primitive the whole pipeline is built on. Every
/// consumer — `on_change`, `sub`, `effect`, the UI bindings — lives on `Flow`,
/// which every `Source` is through the blanket below, so a type that writes these
/// two gets the whole surface.
///
/// A transformation is NOT a `Source` (A142 R29): `count.derive(double)` has no
/// `get`. Seal it (`.memo()`) where it is shared or read, or read it once with
/// `.sample()`.
export trait Source<T> with Flow<T> {
	fun get(self): T;

	/// The NO-PAYLOAD attach (A124 R2): `subscriber` is told that this source MAY
	/// have changed, and is handed no value — it reads `get()` if it wants one.
	/// That is what lets a chain of pipe stages cost nothing per hop: a leaf's ONE
	/// subscriber is forwarded untouched to the root, so a five-stage chain puts
	/// one record on its root, and a diamond puts the same record on the root twice,
	/// which a turn's dedup collapses into one call (the id is the leaf's; see
	/// `Subscriber`).
	///
	/// The handle this returns must RETIRE `subscriber` when it is disposed — after
	/// it, the subscriber never fires. Attaching the record as given meets that for
	/// free: the handle carries the record's own liveness cell. A source that must
	/// keep a registration of its OWN (a mirror's lease) chains its teardown onto
	/// the handle's release.
	///
	/// A root that stores its value in a `SignalCell` implements this in one line,
	/// by handing `subscriber` to that cell's `on_settle`.
	[must_use]
	fun on_settle(self, subscriber: Subscriber): Subscription;

	/// Attach an OBSERVER, and call it once now when `immediately` — the root's
	/// `on_change` (false) and `sub` (true), which `Flow` answers through for every
	/// source. The default is `on_settle` with a pulling subscriber, then the call.
	///
	/// A root overrides it to skip the indirection (`SignalCell` attaches directly)
	/// or to keep a contract of its own: a mirror's seeding frame arrives INSIDE
	/// its lease over an in-process transport, so its eager form leases first and
	/// makes the one immediate call itself, where the default would make it twice.
	[must_use]
	fun attach_observer(self, observer: |T| void, immediately: bool): Subscription {
		let subscription = self.on_settle(mint_subscriber(|| observer(self.get())));
		if immediately {
			observer(self.get());
		}
		subscription
	}

	/// A `Source` that always holds `value` (A142 R3): `get()` is `value`, and a
	/// subscription is a no-op. It fits a static value into a position that asks
	/// for a reactive one — a `switch` arm, a `then_some`, a field typed
	/// `dyn Source<T>`. (`MaybeSignal`'s static arm is a different thing, and
	/// stays: it takes a plain value with no wrapper at all, R26.)
	fun constant(value: T): Constant<T> {
		Constant<T> { value }
	}
}

/// `Source::constant(value)`'s answer.
export struct Constant<T> {
	value: T,
}

export impl Constant<type T> with Source<T> {
	fun get(self): T {
		self.value
	}

	/// Nothing ever changes, so nothing is registered anywhere; the handle only
	/// retires the subscriber, which is the one obligation `on_settle` puts on it.
	[must_use]
	fun on_settle(self, subscriber: Subscriber): Subscription {
		retiring(subscriber, || {})
	}
}

/// A STARTED flow: the instance one consumer made by calling `start`, and the
/// consumer's three handles on it.
///
/// Starting is split from attaching so that the consumer holds `pull` BEFORE any
/// subscriber can fire — an attach may deliver a notification inside the call (a
/// mirror's seeding frame over an in-process transport arrives inside its
/// `Subscribe`), and the observer that wakes has to be able to read.
export struct Instance<T> {
	/// Read the instance's current value: one application per stateless stage,
	/// and a stateful stage's own state. A consumer calls it once per wake-up,
	/// which is what makes every body run once per change.
	pull: || T,
	/// Attach the consumer's ONE subscriber (at most once): every stage forwards it
	/// to its roots, or wakes it from a relay of its own. Disposing the handle
	/// detaches every registration the instance made.
	attach: |Subscriber| Subscription,
	/// Release what the instance's bodies built (the per-run owners, A142 §4).
	/// Consumers chain it onto the attach handle (`also_releasing`), so disposing
	/// the handle releases both; `.sample()`, which never attaches, calls it
	/// directly.
	release: || void,
}

/// Anything a pipeline can start from (A142 R30): every `Source`, through the
/// blanket below, and every pipe stage. It carries the combinators and the
/// consumers; the sealing operations are `Pipe`'s.
///
/// Every member takes `own self`. On a source that is a copy — a root is data, and
/// passing the same `SignalCell` to two consumers is fine. On a pipe it is a move,
/// so handing one pipe to two consumers, or branching it (`let q = p.derive(..);
/// p.memo();`), is "use of `p` after it was moved". Two consumers of one derived
/// value need a `Source` between them: seal it with `.memo()`.
///
/// Declared `[resource]` (R39): a pipe stage erases into `dyn Flow<T>`, and that
/// object is move-only. The attribute is this trait's alone, so `dyn Source<T>`
/// stays copyable though `Source` extends `Flow`.
export [resource] trait Flow<T> {
	/// Start this flow for its one consumer: the node author's member, where every
	/// member below is the consumer's. A stage starts its upstream, keeps whatever
	/// state its instance needs, and hands back how to read it, attach to it and
	/// release it.
	[must_use]
	fun start(own self): Instance<T>;

	/// Subscribe WITHOUT the immediate first call (A43): `observer` runs on every
	/// CHANGE from here on, and never for the value the flow already holds.
	///
	/// Reach for it when the first value is already accounted for: a side effect
	/// that must not fire on the state the program starts in — a "you have unsaved
	/// changes" prompt, an analytics ping. Every UI binding wants the opposite (the
	/// immediate call IS the initial paint), which is why `sub`/`effect` exist
	/// beside it.
	///
	/// REQUIRED rather than a default, like `sub`, so that each impl answers it
	/// itself: a stage with `observe_flow`, and every source through the blanket
	/// below with its own `attach_observer` (a mirror's lease, a cell's direct
	/// attach) — which a default overridden in the blanket would not reach through
	/// a generic bound.
	[must_use]
	fun on_change(own self, observer: |T| void): Subscription;

	/// Subscribe: `observer` fires ONCE NOW with the current value, then once per
	/// change. The eager form. You hold the `Subscription`; `effect` is the
	/// owner-tied spelling.
	[must_use]
	fun sub(own self, observer: |T| void): Subscription;

	/// `effect` WITHOUT the immediate first call: `body` runs on every CHANGE from
	/// here on, each run under an owner of its own (`effect`'s contract otherwise).
	fun effect_on_change(own self, body: (|T| void) context (owner_scope, ambient_nursery)) {
		let runs = Owner::new();
		let subscription = self.on_change(|value: T| run_body(runs, || body(value)));
		also_releasing(subscription, || release_runs(runs));
		get_owner().take(subscription);
	}

	/// Subscribe and register with the ambient owner (A5): `body` runs once now and
	/// once per change, and the subscription dies with the enclosing boundary.
	/// Requires an enclosing `owner_scope.run`, statically.
	///
	/// **Every run has an owner of its own (A142 R2, merging A114's
	/// `scoped_effect`).** Whatever `body` registers — an `on_cleanup`, a nested
	/// `effect`, a seal, a `take`, a mirror's lease — is released BEFORE the next
	/// run, and the last run's with the boundary; a task `body` starts is owned by
	/// the run and cancelled at its release. A body that registers nothing pays for
	/// no owner (§4.1): the run's owner is an epoch of one cell per effect, and its
	/// cleanup list is made at its first registration.
	fun effect(own self, body: (|T| void) context (owner_scope, ambient_nursery)) {
		let runs = Owner::new();
		let subscription = self.sub(|value: T| run_body(runs, || body(value)));
		also_releasing(subscription, || release_runs(runs));
		get_owner().take(subscription);
	}

	/// `effect`'s name before A142 R2 merged the two: every `effect` run has its
	/// own owner now.
	[deprecated("use `effect`: every run of an effect's body has an owner of its own (A142 R2)")]
	fun scoped_effect(own self, body: (sync |T| void) context owner_scope) {
		self.effect(|value: T| body(value));
	}

	/// `effect_on_change`'s name before A142 R2.
	[deprecated("use `effect_on_change`: every run has an owner of its own (A142 R2)")]
	fun scoped_effect_on_change(own self, body: (sync |T| void) context owner_scope) {
		self.effect_on_change(|value: T| body(value));
	}
}

/// The combinators every flow has — a BLANKET over `Flow` rather than trait
/// defaults, so that a `dyn Source<T>` reaches them too: a trait member with a
/// generic of its own (`derive<U>`) cannot sit in an object's table, and a blanket
/// method is chosen statically, with the object as its receiver.
export impl type F: Flow<type T> {
	/// A pipe of `transform` applied to this flow's value (A142 R1, the rename of
	/// `Source.map`). It runs when the pipe's consumer reads it — once per change,
	/// inside the one instance that consumed it.
	fun derive<U>(
		own self,
		transform: (sync |T| U) context (owner_scope, ambient_nursery),
	): Derive<F, T, U> {
		Derive<F, T, U> { up = self, transform }
	}

	/// The DYNAMIC dependency (A123): follow the flow `select` builds for this
	/// flow's current value, and re-select when it changes — Rx's `switchMap`.
	/// `select` runs once per change of this flow, and it must BUILD the flow it
	/// answers (a closure cannot capture a prebuilt pipe); the flow a previous
	/// selection built is released at re-selection.
	fun switch<U, I: Flow<U>>(
		own self,
		select: (sync |T| I) context (owner_scope, ambient_nursery),
	): Switch<F, T, I, U> {
		Switch<F, T, I, U> { up = self, select }
	}

	/// This flow, passing a change on only when `key` of the value differs from
	/// `key` of the last value passed on (A142 R7). The value passed downstream is
	/// the whole `T`.
	fun distinct_by<K: PartialEq>(own self, key: sync |T| K): DistinctBy<F, T, K> {
		DistinctBy<F, T, K> { up = self, key }
	}
}

/// Every `Source` is a `Flow` (A142 R30): starting one reads it and attaches to it,
/// and `own self` is a copy. An object satisfies the bound too, so a
/// `dyn Source<T>` starts the same way.
export impl type S: Source<type T> with Flow<T> {
	fun start(own self): Instance<T> {
		Instance<T> {
			pull = || self.get(),
			attach = |subscriber: Subscriber| self.on_settle(subscriber),
			release = || {},
		}
	}

	[must_use]
	fun on_change(own self, observer: |T| void): Subscription {
		self.attach_observer(observer, false)
	}

	[must_use]
	fun sub(own self, observer: |T| void): Subscription {
		self.attach_observer(observer, true)
	}
}

/// A stage's `on_change` (`immediately` false) and `sub` (true), written once:
/// start the flow, attach one pulling subscriber, and chain the instance's release
/// onto the handle. The subscriber is MINTED, so it spends the derivation mark
/// (`as_derivation`) like every observer does.
fun observe_flow<T, F: Flow<T>>(own flow: F, observer: |T| void, immediately: bool): Subscription {
	let instance = flow.start();
	let pull = instance.pull;
	let subscription = (instance.attach)(mint_subscriber(|| observer(pull())));
	also_releasing(subscription, instance.release);
	if immediately {
		observer(pull());
	}
	subscription
}

/// A transformation: a `Flow` with no `get` of its own, consumed exactly once (A142
/// R29). The node types are `[resource]`s and implement this with no body — the
/// sealing operations are all defaults, written once over `start`.
///
/// **Sharing is sealing.** Two consumers of one derived value need a `Source`
/// between them:
///
///     let total = cart.derive(|c| c.sum()).memo();   // one instance, one run per change
///     text(total);                                    // a source is data: pass it anywhere
///     badge(total.derive(|t| t > 100));               // each consumer builds its own pipe
export [resource] trait Pipe<T> with Flow<T> {
	/// Seal into a READ-ONLY source backed by one cell (A142 R11/R20): the pipe's
	/// one consumer, run once per change, with the value cached for every reader.
	/// Nothing downstream can `set` a derivation.
	///
	/// Owner-tied, like every consumer (A28): made inside a boundary its
	/// registration dies with the boundary; outside every boundary it lives as long
	/// as its source. A module binding's initializer has no owner and refuses it —
	/// `.memo_global()` says that lifetime (A130). It does NOT compare: every
	/// change above it is a write, and a write always notifies — `.distinct()` is
	/// the stage that compares.
	fun memo(own self): MemoCell<T> {
		MemoCell<T> { cell = self.cell() }
	}

	/// Seal into the WRITABLE cell (R20). A local `set` holds until the next change
	/// upstream overwrites it — a legitimate pattern (a local override of a derived
	/// value), and the only difference from `.memo()`.
	fun cell(own self): SignalCell<T> {
		let instance = self.start();
		let pull = instance.pull;
		let cached = SignalCell::new(pull());
		// A DERIVATION (A110 door 2): it publishes a value, so a turn settles it
		// before any effect reads it.
		let refreshed = (instance.attach)(subscriber_of(|| {
			cached.set(pull());
		}, true));
		also_releasing(refreshed, instance.release);
		let _owned = register_with_owner(refreshed);
		cached
	}

	/// `.memo()` for a value that lives as long as the PROGRAM — the spelling for a
	/// module-level derivation (A130), and for anything a `Memo` maker builds.
	fun memo_global(own self): MemoCell<T> {
		MemoCell<T> { cell = self.cell_global() }
	}

	/// `.cell()` for a cell that lives as long as the PROGRAM (A130): it registers
	/// with NO owner, even inside a boundary, and nothing releases it. What it
	/// holds — the upstream's list → its record → this cell's refresh → the chain
	/// above → the upstream — is a loop for the life of the program BY DESIGN
	/// (`proposal/reactive-pipeline.md` §2.4); the standing no-cycle gate excludes
	/// it by the refresh closure's name.
	fun cell_global(own self): SignalCell<T> {
		let instance = self.start();
		let pull = instance.pull;
		let cached = SignalCell::new(pull());
		// NAMED, and the name is load-bearing: the emitted closure carries it, and
		// the no-cycle gate's walk excludes the loop through a closure of this name
		// (`reactive_lifetimes.rs`) — the one loop that is the design.
		let cell_global_refresh = || {
			cached.set(pull());
		};
		let _for_the_program = (instance.attach)(subscriber_of(cell_global_refresh, true));
		cached
	}

	/// A one-off read (A142 R32): start the pipe, take its current value, and
	/// release it — including anything its bodies built. It subscribes to nothing,
	/// so it opens no channel; its cost is written at the call:
	/// `on_click(|| submit(total_of(cart).sample()))` runs the chain once per click.
	fun sample(own self): T {
		let instance = self.start();
		let value = (instance.pull)();
		(instance.release)();
		value
	}
}

/// Read any flow ONCE: start it, pull, release — `Pipe::sample` for a flow that may
/// be a source as well as a pipe. The server renderer's read, which hears no change
/// after its one pass; an application reads a source with `get` and a pipe with
/// `.sample()`.
export [internal("the server renderer's one read of a flow — read a source with `get`, a pipe with `.sample()`")]
fun read_once<T, F: Flow<T>>(own flow: F): T {
	let instance = flow.start();
	let value = (instance.pull)();
	(instance.release)();
	value
}

/// `release` chained onto `handle`'s own release, so disposing the handle releases
/// the instance behind it too — the consumer's half of `Instance`. Chained rather
/// than wrapped for `also_retiring`'s reason: no second handle, no context read.
fun also_releasing(handle: Subscription, release: || void) {
	let previous = handle.release.read();
	handle.release.write() = Some(|| {
		release();
		match previous {
			Some(let earlier) => earlier(),
			None => {},
		}
	});
}

/// The WRITABLE half of the pair: `Source` reads, `Signal` writes. A component
/// that only observes takes a `Source`; one that writes back takes a `Signal`,
/// and any impl satisfies it — a cell that clamps its setter, one that
/// persists to storage, one that debounces. `set` and `notify` are the
/// requirements, because that is where custom write logic lives and no generic
/// body can reach an arbitrary impl's storage or subscriber list.
///
/// `Signal::new(value)` is the everyday spelling and does NOT dispatch: with no
/// receiver there is nothing to select an impl from, so it resolves statically
/// to this default body and means the canonical cell in every file (B162). An
/// impl may declare its own `new`, reached at its own name.
///
/// `update` is deliberately NOT here. Its value is in-place mutation with one
/// notify, and a generic default can only read-copy-mutate-write-back — the copy
/// A18 existed to avoid. Impls may want their own update logic or none at all, so
/// it stays inherent on `SignalCell` and general consumers are locked out of it.
///
/// The trait promises NOTHING about notification frequency. `SignalCell` notifies
/// unconditionally (`set` never compares); an impl that wants "don't publish an
/// unchanged value" writes that in its own `set`.
export trait Signal<T> with Source<T> {
	/// The canonical cell, concretely — deliberately not `Self`: a bare
	/// `Signal::new(1)` has no receiver and no bound in scope to resolve a `Self`
	/// against.
	fun new(value: T): SignalCell<T> {
		SignalCell::new(value)
	}

	fun set(self, value: T);

	/// Publish the current value without changing it.
	fun notify(self);

	/// Read, transform, write. The default is exactly that line; an impl that can
	/// do better overrides it.
	fun set_with(self, transform: sync |T| T) {
		self.set(transform(self.get()));
	}
}

/// A reactive value: a current value plus the observers to notify when it changes.
/// Both a root cell and every derived value share this representation; the
/// difference is only who may write it (a root, via `set`). The canonical
/// `Signal` impl — `Signal::new` hands one back.
export struct SignalCell<T> {
	value: Shared<T>,
	subscribers: Shared<List<Subscriber>>,
}

/// This cell's IDENTITY — the same number for every handle to one cell, a
/// different one for every other cell. vilan has no reference equality, and a
/// cell is exactly the kind of thing two holders need to recognise as the SAME
/// one: `Shared` is not deep-copied, so two bindings of one cell are one cell,
/// and nothing else in the value says so.
///
/// The consumer is the rpc runtime's dynamic exposure (A92): a reply carrying a
/// source the connection has already exported answers the channel it already
/// minted, rather than a second capability and a second forward of the same
/// updates. It reads the VALUE cell's identity, which is the cell's: a `SignalCell`
/// is a struct over two `Shared`s, and copying the struct copies neither.
///
/// A92 stamped this at construction, into an `id` field every `SignalCell` in
/// every program paid for whether or not anything ever asked (M66). The stamp
/// is `Shared::identity`'s now, which takes it on the first ASK — so the twelve
/// corpus goldens that moved when the field landed are back where they were,
/// and a program that exposes nothing mints no identities at all.
export fun cell_identity<T>(cell: SignalCell<T>): i32 {
	cell.value.identity()
}

export impl SignalCell<type T> with Source<T> {
	fun get(self): T {
		self.value.read()
	}

	/// The protocol's root (A124 R2): push the record a leaf minted, AS GIVEN,
	/// onto this cell's list. No subscriber is minted here and no value is read —
	/// the id, the class and the liveness cell are the leaf's, which is what lets
	/// every registration in one leaf's chain dedup as one.
	[must_use]
	fun on_settle(self, subscriber: Subscriber): Subscription {
		attach(self, subscriber)
	}

	/// The trait's default, specialized: identical in effect, one call shallower.
	/// Every UI binding over a cell lands here, so the cell reaches `observe`
	/// directly.
	[must_use]
	fun attach_observer(self, observer: |T| void, immediately: bool): Subscription {
		let subscription = observe(self, observer);
		if immediately {
			observer(self.get());
		}
		subscription
	}
}

/// Attach `observer` to `signal`'s subscriber list and hand back the handle that
/// detaches it — `sub` WITHOUT the immediate first call. `sub` is this plus that
/// call, and it is the cell's own `attach_observer`.
///
/// The notify closure captures the VALUE CELL, never the signal
/// (`proposal/lifetimes.md` §5, V1). Capturing `self` closed a back edge — signal →
/// subscribers cell → list → subscriber → closure → scope → signal — so every
/// subscription in the program minted its own 6-node cycle. The cell is what the
/// closure actually needs, and nothing points from it back to the signal.
///
/// And the capture is WEAK — the first of std's two back edges (C14 S3). V1's
/// repair shortened the cycle; it did not remove it. What is left is four
/// nodes: cell → subscribers → `Subscriber` → `notify` → (captured) cell, a
/// loop a refcount cannot collect because every edge in it is a holder. The
/// closure must FOLLOW the cell to read it and must not decide when it dies —
/// which is precisely what a weak handle says — so the notify upgrades on each
/// call and does nothing if the cell is gone. On this backend it never is
/// (`downgrade` is the identity until something counts, C14 S4); what lands
/// here is the edge, written where the graph can be checked against it.
///
/// Concrete `SignalCell` and NOT widenable to `Source` (A33): this reads the
/// STRUCTURE — the value cell and the subscriber list — not the trait's
/// `get`/`on_settle`. The `Source` spelling of the same attach is `on_change`.
export fun observe<T>(signal: SignalCell<T>, observer: |T| void): Subscription {
	let cell = signal.value.downgrade();
	attach(signal, mint_subscriber(|| {
		match cell.upgrade() {
			// `upgrade` rather than `get`: `observer` takes a VALUE, and `read()`
			// is the spelling that copies one out of the cell (spec §6.1). A `get`
			// view would have to be dereferenced to the same copy, and would say
			// the weaker thing — that this only touches the cell — where a
			// notification genuinely holds it for the length of the call.
			Some(let live) => observer(live.read()),
			None => {},
		}
	}))
}

/// Push `subscriber` onto `signal`'s list and hand back the handle that detaches it
/// — the ATTACH half of `observe`, split from the mint (A124 S2a) so a leaf's one
/// record can stand on several lists.
///
/// The handle carries the subscriber's OWN liveness cell (A110 door 1): one per
/// observer, held by the record every list carries and by every handle to it,
/// so `dispose` lowers it in O(1) without having to find an entry again — and a
/// leaf whose record stands on two lists (a diamond) is retired by disposing
/// either, which is the one-observer truth the shared id already says. The
/// class was decided at the mint and is not touched here.
fun attach<T>(signal: SignalCell<T>, subscriber: Subscriber): Subscription {
	// The handle is built FIRST and the push is the record's LAST use, so the
	// native backend MOVES the record into the list (F37's last-use pass; before it
	// the order was forced the other way — the native emitter moved `live` out of
	// the record for the handle and handed rustc a use of the partially moved
	// record — and the push paid a native copy per attach). `reissued` stays for
	// the JS backend: a parameter pushed into a list is a rule-1 copy there
	// (`__clone`, one per subscription in the program), and the reissued record is
	// built in place.
	let handle = Subscription {
		subscribers = signal.subscribers.downgrade(),
		id = subscriber.id,
		live = subscriber.live,
		release = Shared::new(None),
	};
	signal.subscribers.write().push(reissued(subscriber));
	handle
}

/// The canonical write side. `set_with` is the trait's default, unchanged — the
/// body std used to carry here is the body the trait carries now.
export impl SignalCell<type T> with Signal<T> {
	/// Declared, not inherited: `Type::func` reads the type's OWN members, so the
	/// trait's default body is reachable at `Signal::new` and this one is reachable
	/// at `SignalCell::new`. They are the same cell either way.
	fun new(value: T): SignalCell<T> {
		mut subscribers: List<Subscriber> = [];
		SignalCell { value = Shared::new(value), subscribers = Shared::new(subscribers) }
	}

	fun set(self, value: T) {
		self.value.write() = value;
		self.notify();
	}

	/// Publish this signal's current value to its observers — the notification half
	/// of a write, shared by `set` and `update`.
	///
	/// Under an ambient turn, defer the notification to ITS settle — writes
	/// coalesce glitch-free, and only this extent's flush fires them. With no
	/// ambient turn, join the currently DRAINING one if a settle is in progress (a
	/// derived recomputing mid-drain — see `draining_turns`), else notify inline
	/// (eager, depth-first).
	fun notify(self) {
		match turn_scope.get_safe() {
			Some(let turn) => enqueue(turn, self.subscribers.read()),
			None => {
				match draining_turns.read().last() {
					Some(let draining) => enqueue(draining, self.subscribers.read()),
					None => {
						// The loop walks a SNAPSHOT of the list, so an observer
						// that cascades depth-first and disposes a later one leaves
						// that later one in the copy. It does not fire (A110 door
						// 1, `Subscriber.live`).
						for subscriber in self.subscribers.read() {
							if subscriber.live.read() {
								(subscriber.notify)();
							}
						}
					},
				}
			},
		}
	}
}

export impl SignalCell<type T> {
	/// Mutate the stored value IN PLACE, then notify once (backlog A18,
	/// `proposal/signal-update.md`). `mutate` receives a writable view of the
	/// storage, so a collection grows without the copy-transform-return dance
	/// `set_with` requires:
	///
	///     todos.update(|&mut list| { list.push(todo); });
	///
	/// INHERENT, not a `Signal` member (A32's ruling): a generic default could only
	/// read-copy-mutate-write-back, which is the copy this exists to avoid, and an
	/// impl may want its own update logic or none at all. A consumer that needs it
	/// asks for the cell.
	///
	/// `mutate` receives the storage as a `&mut` SUBJECT, and a pattern binder
	/// under it is a binding like any other: `Some(mut list)` takes rule 1's COPY,
	/// so `list.push(..)` inside the arm grows the copy and the cell keeps the
	/// value it had. Write back through the subject (`held = Some(list)`), or move
	/// the payload out and put one back with `take`/`replace`. Only a wrapped
	/// collection meets this — `update` on a `SignalCell<List<T>>` mutates the
	/// storage directly.
	///
	/// The notification is UNCONDITIONAL — exactly like `set`, which never compares
	/// either. A `mutate` that writes nothing still publishes; that is cheap and
	/// predictable, and it keeps `update` and `set` one rule. Under a
	/// `batch`/`turn` the notification defers and coalesces like any other write.
	/// `mutate` is `sync`: the view may not be live across an `await` (spec §6.6),
	/// so an async closure is refused rather than adapted.
	fun update(self, mutate: sync |&mut T| void) {
		mutate(self.value.write());
		self.notify();
	}
}

/// A SEALED derivation's read-only face — what `.memo()` and `.memo_global()` hand
/// back (A142 R11/R20). A `Source`: read it, pass it anywhere, build any number of
/// pipes over it. It has no `set`: a derivation is written by its upstream only.
/// (`.cell()` is the writable twin, a `SignalCell`.)
///
/// One cell underneath, so a memo read by N consumers ran its chain once per change,
/// whatever N is.
export struct MemoCell<T> {
	cell: SignalCell<T>,
}

export impl MemoCell<type T> with Source<T> {
	fun get(self): T {
		self.cell.get()
	}

	[must_use]
	fun on_settle(self, subscriber: Subscriber): Subscription {
		attach(self.cell, subscriber)
	}

	[must_use]
	fun attach_observer(self, observer: |T| void, immediately: bool): Subscription {
		self.cell.attach_observer(observer, immediately)
	}
}

/// A component value that may be STATIC or REACTIVE, with no ceremony at the call
/// site (B157). A component takes one parameter bounded on this trait and accepts
/// both `badge("draft")` and `badge(Signal::new("draft"))`; the value's TYPE
/// decides its life, exactly as `AttrValue` has always decided an attribute's.
///
/// `bind` is EFFECT-SHAPED rather than getter-shaped, which is what makes one
/// signature serve both cases: the static impl fires the handler once and is done,
/// the reactive one subscribes and keeps firing. There is no runtime discrimination
/// anywhere — which impl runs is settled at the call, by the specificity order
/// (spec §5.4).
///
/// `own self`, because the reactive arm CONSUMES: a pipe handed to a component is
/// that component's to start (A142 R29).
///
/// The reactive arm registers with the AMBIENT OWNER (`effect`), so a component's
/// subscription dies with the boundary that built it. That is also why `bind` may
/// only be called under one: the requirement is static, and it flows through the
/// bound.
export trait MaybeSignal<T> {
	fun bind(own self, react: |T| void);
}

/// The static case: the value is the value, so hand it over once (R26: unchanged by
/// A142).
///
/// A BLANKET (B158) — the least specific tier, so any impl below outranks it
/// wherever both match.
export impl type T with MaybeSignal<T> {
	fun bind(own self, react: |T| void) {
		react(self);
	}
}

/// The reactive case, over `Flow`: a cell, a sealed memo, a `RemoteSource`, a
/// mirror of one's own — or a pipe (`badge(count.derive(label))`), which the
/// component starts.
///
/// The binder in the bound is the impl's own parameter (B165), which is what makes
/// this one impl rather than one per element type.
export impl type F: Flow<type T> with MaybeSignal<T> {
	fun bind(own self, react: |T| void) {
		self.effect(|value: T| react(value));
	}
}

/// The product combinator: a pipe of the tuple of its inputs' current values,
/// changing whenever any input changes. Variadic over the inputs' (distinct) types
/// via a mapped-tuple parameter — `combine((a, b, c))` of sources of `A`, `B` and
/// `C` is a `Combine<(A, B, C)>`, a `Pipe<(A, B, C)>`.
///
/// Each input is a SOURCE — a cell, a sealed memo, a mirror — erased to
/// `dyn Source<U>` at the argument (A33's per-element existential, answered by
/// `dyn`). A pipe input is sealed first
/// (`combine((name, name.derive(len).memo()))`): a `[resource]` cannot become a
/// `dyn` (memory.md R7/R10), and the inputs are read from the combined pipe's own
/// pulls.
export fun combine<T: (2..)>(sources: (U in T: dyn Source<U>)): Combine<T> {
	Combine<T> { sources }
}

/// The reverse of `combine`: one derived pipe per position of a tuple-valued source
/// — `divorce(pair)` over a `Source<(A, B)>` is a pair of pipes of `A` and of `B`,
/// and `divorce(combine((a, b)).memo())` re-derives `a`'s and `b`'s values.
///
/// Each output is a `derive` reading its own position (`whole.get(key)`,
/// `std::tuple`), started by whichever consumer takes it. Every output follows the
/// WHOLE source, so each one fires on every change of the source — including a
/// change to another position, and a `set` that changes nothing. Where a consumer
/// wants to fire only when ITS position moved, it gates that output:
/// `divorce(pair).0.distinct()` (`.distinct()` asks `PartialEq` of that one element
/// only).
///
/// It takes a `Source` rather than a `Flow` because it reads it more than once —
/// once here for its POSITIONS (`keys()` needs a value of the tuple to count them),
/// and once per output (A142 R34: a parameter read twice asks for a `Source`, and
/// the caller seals).
export fun divorce<T: (2..), S: Source<T>>(source: S): (U in T: Derive<S, T, U>) {
	source.get().keys().map(|key| source.derive(|whole| whole.get(key)))
}

// === Per-key selection (backlog A44; Solid's `createSelector`) ===============
//
// "Is THIS row the selected one?" — asked once per row, answered live. The obvious
// spelling derives a boolean per row off the selection signal, and every one of
// them recomputes on every change: n notifications to move a highlight one row.
// `selector` takes ONE subscription on the source and keeps a cell per key, so a
// change writes exactly TWO of them — the key that left and the key that arrived —
// whatever n is.

/// The per-key selection handle `selector` hands back. `of(key)` is the live answer
/// for one key, as a `SignalCell<bool>` that drops straight into `show` / `when` /
/// `bind_class` / `bind_styled`.
///
/// A HANDLE with a method rather than the closure Solid returns, and that is forced
/// rather than chosen: a closure captures its context AT CREATION (spec §8.4), so a
/// closure built inside `selector` would defer every key's cleanup to whatever
/// owner was ambient where `selector` was CALLED — the component, never the row. A
/// method call threads the caller's ambient owner the ordinary way, which is what
/// lets a row's entry die with the row.
export struct Selector<T> {
	// One cell per key, keyed by `key.hash()` (the canonical key `Map`/`Set` use).
	// Every `of` for the same key hands back the same cell.
	cells: Shared<NativeMap<SignalCell<bool>>>,
	// The source's current value, mirrored here so `of` can seed a fresh cell and
	// the change observer can find the key that is LEAVING.
	current: Shared<T>,
}

/// Build a per-key selection over `source` — one subscription, O(2) notifications
/// per change (`Selector`).
///
/// ```
/// let selected = selector(current_id);
/// // … inside a row, under the row's own owner:
/// view("li").bind_styled(selected.of(todo.id).map(|on| if on { active } else { plain }))
/// ```
///
/// The subscription is the AMBIENT OWNER's, like every derivation combinator's
/// (A28), and it is a LAZY one (A43): the cells are seeded by `of` from `current`,
/// so there is nothing for a first call to do.
export fun selector<T: Hashable + PartialEq, S: Source<T>>(source: S): Selector<T> {
	let cells: Shared<NativeMap<SignalCell<bool>>> = Shared::new(NativeMap::new());
	let current: Shared<T> = Shared::new(source.get());
	// A DERIVATION (A110 door 2): its two writes publish the per-key cells, and a
	// row's own effect must see them settled.
	as_derivation();
	let _owned = register_with_owner(source.on_change(|value| {
		let previous = current.read();
		current.write() = value;
		// Two writes, whatever the row count: the key that left goes false,
		// the key that arrived goes true. A key nobody asked about has no
		// cell, and needs none.
		match cells.read().get(previous.hash()) {
			Some(let leaving) => leaving.set(false),
			None => {},
		}
		match cells.read().get(value.hash()) {
			Some(let arriving) => arriving.set(true),
			None => {},
		}
	}));
	Selector { cells, current }
}

export impl Selector<type T: Hashable + PartialEq> {
	/// The live answer for one key: `true` exactly while the source holds it.
	///
	/// Creates the key's cell on first ask (seeded against the current value) and
	/// hands back that same cell every time after. The entry's REMOVAL is deferred
	/// to the ambient owner, so asking from inside an `each` row frees the entry
	/// when the row is disposed and the map stays the size of the live list rather
	/// than of every list the session ever showed.
	fun of(self, key: T): SignalCell<bool> {
		let hash = key.hash();
		match self.cells.read().get(hash) {
			Some(let existing) => existing,
			None => {
				let cell: SignalCell<bool> = SignalCell::new(key == self.current.read());
				self.cells.write().insert(hash, cell);
				defer_to_owner(|| {
					self.cells.write().remove(hash);
				});
				cell
			},
		}
	}
}

// === The pipe stages (A142 §3; A124's nodes, made move-only) =================
//
// A stage holds its upstream and its operation, and nothing else until a consumer
// STARTS it. Starting builds the instance: stateless stages (`Derive`) compose
// their upstream's pull and forward its attach, so a sealed chain puts the
// consumer's ONE subscriber on its root and evaluates the stages fused, once per
// change; stateful stages (`Switch`, `Distinct`) keep their state in the instance
// and relay.
//
// Every stage is a `[resource]`: a pipe is consumed exactly once. A stage's
// upstream is moved into `start` and started there, so the instance a consumer
// holds is plain data — closures and cells — and no closure ever captures a pipe.
//
// A relay is a stage's OWN registration (the re-selection a `switch` makes, the
// comparison a `distinct` makes). It wakes the consumer's subscriber through the
// turn (`wake`), where its id still dedups, and it is always a DERIVATION: it
// decides whether and which downstream to wake, and that has to happen in the
// wave's first phase.

/// A relay that only wakes `subscriber`: the registration a stage puts on the flow
/// it currently FOLLOWS (a `switch`'s inner), which it detaches at re-selection
/// without retiring the consumer below it.
fun relay_to(subscriber: Subscriber): Subscriber {
	subscriber_of(|| wake(subscriber), true)
}

/// Detach the registration a stage holds in `handle`, if it holds one.
fun detach_held(handle: Shared<Option<Subscription>>) {
	match handle.read() {
		Some(let held) => detach(held),
		None => {},
	}
	handle.write() = None;
}

/// `derive` as a stage: the upstream and the transform, nothing else. Its instance
/// is its upstream's with the transform applied at the pull, and its attach is its
/// upstream's, forwarded — no subscriber minted, no transform run.
///
/// Three type parameters: the transform is a FIELD, and a field's type must name
/// every type it mentions, so the upstream's `T` is a parameter of the struct. The
/// transform is held plain (`|T| U`, not `sync |T| U`): `sync` is accepted on a
/// parameter and not on a field, so it is checked where the stage is built.
export [resource] struct Derive<S, T, U> {
	up: S,
	transform: (|T| U) context (owner_scope, ambient_nursery),
}

export impl Derive<type S: Flow<type T>, T, type U> with Flow<U> {
	[must_use]
	fun on_change(own self, observer: |U| void): Subscription {
		observe_flow(self, observer, false)
	}

	[must_use]
	fun sub(own self, observer: |U| void): Subscription {
		observe_flow(self, observer, true)
	}

	fun start(own self): Instance<U> {
		let transform = self.transform;
		let upstream = self.up.start();
		let pull = upstream.pull;
		let runs = Owner::new();
		Instance<U> {
			pull = || {
				let value = pull();
				run_body(runs, || transform(value))
			},
			attach = upstream.attach,
			release = || {
				release_runs(runs);
				(upstream.release)();
			},
		}
	}
}

export impl Derive<type S: Flow<type T>, T, type U> with Pipe<U> {}

/// `switch` as a stage (A123's dynamic dependency): which flow to follow is decided
/// by the upstream's value, ONCE PER CHANGE of it, inside the instance.
///
/// The instance keeps the flow it currently follows — started, with a relay of the
/// stage's own on it — and a relay on the upstream that re-selects: it detaches and
/// releases the followed instance, builds the next one with `select`, and wakes the
/// consumer. It never forwards the consumer's own record to the followed flow,
/// because detaching that at the next re-selection would retire the consumer.
///
/// FOUR type parameters, and the fourth, `U`, is in no field: it is the followed
/// flow's value type, bound DIRECTLY in the impl subject
/// (`type I: Flow<U>, type U`) rather than read out of `I`'s bound (A124 S2b: read
/// out of the bound, an inherited default's observer parameter is the trait's
/// unsubstituted `T`).
export [resource] struct Switch<S, T, I, U> {
	up: S,
	select: (|T| I) context (owner_scope, ambient_nursery),
}

export impl Switch<type S: Flow<type T>, T, type I: Flow<U>, type U> with Flow<U> {
	[must_use]
	fun on_change(own self, observer: |U| void): Subscription {
		observe_flow(self, observer, false)
	}

	[must_use]
	fun sub(own self, observer: |U| void): Subscription {
		observe_flow(self, observer, true)
	}

	fun start(own self): Instance<U> {
		let select = self.select;
		let runs = Owner::new();
		let outer = self.up.start();
		let outer_pull = outer.pull;
		// The FIRST selection is made here, at start — the instance's state begins
		// with it, and a consumer's first pull reads it.
		let followed: Shared<Instance<U>> = Shared::new(run_body(runs, || select(outer_pull())).start());
		let followed_handle: Shared<Option<Subscription>> = Shared::new(None);
		Instance<U> {
			pull = || (followed.read().pull)(),
			attach = |subscriber: Subscriber| {
				followed_handle.write() = Some((followed.read().attach)(relay_to(subscriber)));
				let outer_handle = (outer.attach)(subscriber_of(|| {
					detach_held(followed_handle);
					(followed.read().release)();
					let next = run_body(runs, || select(outer_pull())).start();
					followed_handle.write() = Some((next.attach)(relay_to(subscriber)));
					followed.write() = next;
					wake(subscriber);
				}, true));
				retiring(subscriber, || {
					detach_held(followed_handle);
					detach(outer_handle);
				})
			},
			release = || {
				release_runs(runs);
				(followed.read().release)();
				(outer.release)();
			},
		}
	}
}

export impl Switch<type S: Flow<type T>, T, type I: Flow<U>, type U> with Pipe<U> {}

/// `switch_some` as a stage (A142 R8): `Switch` over a flow of `Option<T>`, where
/// `None` DETACHES — nothing is followed and the stage reads `None` — and `Some(x)`
/// follows the flow `select` builds for `x`, wrapped.
export [resource] struct SwitchSome<S, T, I, U> {
	up: S,
	select: (|T| I) context (owner_scope, ambient_nursery),
}

export impl SwitchSome<type S: Flow<Option<T>>, type T, type I: Flow<U>, type U> with Flow<
	Option<U>,
> {
	[must_use]
	fun on_change(own self, observer: |Option<U>| void): Subscription {
		observe_flow(self, observer, false)
	}

	[must_use]
	fun sub(own self, observer: |Option<U>| void): Subscription {
		observe_flow(self, observer, true)
	}

	fun start(own self): Instance<Option<U>> {
		let select = self.select;
		let runs = Owner::new();
		let outer = self.up.start();
		let outer_pull = outer.pull;
		let followed: Shared<Option<Instance<U>>> = Shared::new(match outer_pull() {
			Some(let value) => Some(run_body(runs, || select(value)).start()),
			None => None,
		});
		let followed_handle: Shared<Option<Subscription>> = Shared::new(None);
		Instance<Option<U>> {
			pull = || match followed.read() {
				Some(let instance) => Some((instance.pull)()),
				None => None,
			},
			attach = |subscriber: Subscriber| {
				match followed.read() {
					Some(let instance) => {
						followed_handle.write() = Some((instance.attach)(relay_to(subscriber)));
					},
					None => {},
				}
				let outer_handle = (outer.attach)(subscriber_of(|| {
					detach_held(followed_handle);
					match followed.read() {
						Some(let previous) => (previous.release)(),
						None => {},
					}
					followed.write() = match outer_pull() {
						Some(let value) => {
							let next = run_body(runs, || select(value)).start();
							followed_handle.write() = Some((next.attach)(relay_to(subscriber)));
							Some(next)
						},
						// Detached: what the last selection built is released now,
						// not at the next `Some`.
						None => {
							release_runs(runs);
							None
						},
					};
					wake(subscriber);
				}, true));
				retiring(subscriber, || {
					detach_held(followed_handle);
					detach(outer_handle);
				})
			},
			release = || {
				release_runs(runs);
				match followed.read() {
					Some(let instance) => (instance.release)(),
					None => {},
				}
				(outer.release)();
			},
		}
	}
}

export impl SwitchSome<type S: Flow<Option<T>>, type T, type I: Flow<U>, type U> with Pipe<
	Option<U>,
> {}

/// `and_then` as a stage (A123's Kleisli composition): `None` on the outer is
/// `None`; `Some(value)` follows the `Flow<Option<U>>` that `select` builds for it,
/// and the two absences collapse into one. The instance is `SwitchSome`'s, without
/// the wrapping.
export [resource] struct AndThen<S, T, I, U> {
	up: S,
	select: (|T| I) context (owner_scope, ambient_nursery),
}

export impl AndThen<type S: Flow<Option<T>>, type T, type I: Flow<Option<U>>, type U> with Flow<
	Option<U>,
> {
	[must_use]
	fun on_change(own self, observer: |Option<U>| void): Subscription {
		observe_flow(self, observer, false)
	}

	[must_use]
	fun sub(own self, observer: |Option<U>| void): Subscription {
		observe_flow(self, observer, true)
	}

	fun start(own self): Instance<Option<U>> {
		let select = self.select;
		let runs = Owner::new();
		let outer = self.up.start();
		let outer_pull = outer.pull;
		let followed: Shared<Option<Instance<Option<U>>>> = Shared::new(match outer_pull() {
			Some(let value) => Some(run_body(runs, || select(value)).start()),
			None => None,
		});
		let followed_handle: Shared<Option<Subscription>> = Shared::new(None);
		Instance<Option<U>> {
			pull = || match followed.read() {
				Some(let instance) => (instance.pull)(),
				None => None,
			},
			attach = |subscriber: Subscriber| {
				match followed.read() {
					Some(let instance) => {
						followed_handle.write() = Some((instance.attach)(relay_to(subscriber)));
					},
					None => {},
				}
				let outer_handle = (outer.attach)(subscriber_of(|| {
					detach_held(followed_handle);
					match followed.read() {
						Some(let previous) => (previous.release)(),
						None => {},
					}
					followed.write() = match outer_pull() {
						Some(let value) => {
							let next = run_body(runs, || select(value)).start();
							followed_handle.write() = Some((next.attach)(relay_to(subscriber)));
							Some(next)
						},
						// Detached: what the last selection built is released now,
						// not at the next `Some`.
						None => {
							release_runs(runs);
							None
						},
					};
					wake(subscriber);
				}, true));
				retiring(subscriber, || {
					detach_held(followed_handle);
					detach(outer_handle);
				})
			},
			release = || {
				release_runs(runs);
				match followed.read() {
					Some(let instance) => (instance.release)(),
					None => {},
				}
				(outer.release)();
			},
		}
	}
}

export impl AndThen<type S: Flow<Option<T>>, type T, type I: Flow<Option<U>>, type U> with Pipe<
	Option<U>,
> {}

/// `then_some` as a stage: a flow of `bool` gating a SOURCE. While the flag is true
/// the stage follows `source`, as `Some`; while it is false it reads `None` and is
/// detached. It takes a `Source` rather than a pipe because it starts the followed
/// flow afresh each time the flag TURNS true, and a pipe starts once.
export [resource] struct ThenSome<F, S, T> {
	up: F,
	source: S,
}

export impl ThenSome<type F: Flow<bool>, type S: Source<T>, type T> with Flow<Option<T>> {
	[must_use]
	fun on_change(own self, observer: |Option<T>| void): Subscription {
		observe_flow(self, observer, false)
	}

	[must_use]
	fun sub(own self, observer: |Option<T>| void): Subscription {
		observe_flow(self, observer, true)
	}

	fun start(own self): Instance<Option<T>> {
		let source = self.source;
		let outer = self.up.start();
		let outer_pull = outer.pull;
		let following: Shared<bool> = Shared::new(outer_pull());
		let followed_handle: Shared<Option<Subscription>> = Shared::new(None);
		Instance<Option<T>> {
			pull = || if following.read() { Some(source.get()) } else { None },
			attach = |subscriber: Subscriber| {
				if following.read() {
					followed_handle.write() = Some(source.on_settle(relay_to(subscriber)));
				}
				let outer_handle = (outer.attach)(subscriber_of(|| {
					let on = outer_pull();
					if on != following.read() {
						following.write() = on;
						if on {
							followed_handle.write() = Some(source.on_settle(relay_to(subscriber)));
						} else {
							detach_held(followed_handle);
						}
						wake(subscriber);
					}
				}, true));
				retiring(subscriber, || {
					detach_held(followed_handle);
					detach(outer_handle);
				})
			},
			release = outer.release,
		}
	}
}

export impl ThenSome<type F: Flow<bool>, type S: Source<T>, type T> with Pipe<Option<T>> {}

/// `combine` as a stage over the TUPLE BOUND: a pipe of the tuple of its inputs'
/// current values. Its attach forwards the SAME subscriber to every input, so a
/// diamond standing on one root puts one consumer's record on it once per arm — and
/// a turn calls it once. The handle disposes every arm.
export [resource] struct Combine<T: (2..)> {
	sources: (U in T: dyn Source<U>),
}

export impl Combine<type T> with Flow<T> {
	[must_use]
	fun on_change(own self, observer: |T| void): Subscription {
		observe_flow(self, observer, false)
	}

	[must_use]
	fun sub(own self, observer: |T| void): Subscription {
		observe_flow(self, observer, true)
	}

	fun start(own self): Instance<T> {
		let sources = self.sources;
		Instance<T> {
			pull = || (source in sources => source.get()),
			attach = |subscriber: Subscriber| {
				let arms = (source in sources => source.on_settle(subscriber));
				retiring(subscriber, || {
					let _released = (arm in arms => detach(arm));
				})
			},
			release = || {},
		}
	}
}

export impl Combine<type T> with Pipe<T> {}

/// `.distinct()` as a stage (A142 R7): the upstream's value, passed on ONLY when it
/// differs from the last one passed on. Sealing does not compare — every change
/// above a `.memo()` is a write, and a write always notifies — so the equality is
/// this stage's, and `T: PartialEq` is asked here and nowhere else.
///
/// The last value is the INSTANCE's state: the relay reads the upstream once per
/// change, keeps what it read, and the consumer's pull reads what was kept — so the
/// chain above runs once per change, not once per read.
export [resource] struct Distinct<S, T> {
	up: S,
}

export impl Distinct<type S: Flow<T>, type T: PartialEq> with Flow<T> {
	[must_use]
	fun on_change(own self, observer: |T| void): Subscription {
		observe_flow(self, observer, false)
	}

	[must_use]
	fun sub(own self, observer: |T| void): Subscription {
		observe_flow(self, observer, true)
	}

	fun start(own self): Instance<T> {
		let upstream = self.up.start();
		let pull = upstream.pull;
		let last: Shared<T> = Shared::new(pull());
		Instance<T> {
			pull = || last.read(),
			attach = |subscriber: Subscriber| {
				let relayed = (upstream.attach)(subscriber_of(|| {
					let now = pull();
					if now != last.read() {
						last.write() = now;
						wake(subscriber);
					}
				}, true));
				also_retiring(relayed, subscriber);
				relayed
			},
			release = upstream.release,
		}
	}
}

export impl Distinct<type S: Flow<T>, type T: PartialEq> with Pipe<T> {}

/// `.distinct_by(key)` as a stage (A142 R7): `Distinct`, comparing `key` of the
/// value rather than the value, and passing the whole value on.
export [resource] struct DistinctBy<S, T, K> {
	up: S,
	key: |T| K,
}

export impl DistinctBy<type S: Flow<T>, type T, type K: PartialEq> with Flow<T> {
	[must_use]
	fun on_change(own self, observer: |T| void): Subscription {
		observe_flow(self, observer, false)
	}

	[must_use]
	fun sub(own self, observer: |T| void): Subscription {
		observe_flow(self, observer, true)
	}

	fun start(own self): Instance<T> {
		let key = self.key;
		let upstream = self.up.start();
		let pull = upstream.pull;
		let first = pull();
		let last: Shared<T> = Shared::new(first);
		let last_key: Shared<K> = Shared::new(key(first));
		Instance<T> {
			pull = || last.read(),
			attach = |subscriber: Subscriber| {
				let relayed = (upstream.attach)(subscriber_of(|| {
					let now = pull();
					let now_key = key(now);
					if now_key != last_key.read() {
						last.write() = now;
						last_key.write() = now_key;
						wake(subscriber);
					}
				}, true));
				also_retiring(relayed, subscriber);
				relayed
			},
			release = upstream.release,
		}
	}
}

export impl DistinctBy<type S: Flow<T>, type T, type K: PartialEq> with Pipe<T> {}

/// The combinators whose receiver needs a bound of its own — a default cannot add a
/// bound on `T`, so each is a blanket over the flows it applies to.
export impl type F: Flow<type T: PartialEq> {
	/// This flow, passing a change on only when the value differs from the last one
	/// passed on — the `Distinct` stage, `T: PartialEq` asked here only (R7).
	fun distinct(own self): Distinct<F, T> {
		Distinct<F, T> { up = self }
	}
}

export impl type F: Flow<Option<type T>> {
	/// `switch` over an optional value (A142 R8): `None` detaches and reads `None`,
	/// `Some(x)` follows the flow `select` builds for `x`, wrapped in `Some`.
	fun switch_some<U, I: Flow<U>>(
		own self,
		select: (sync |T| I) context (owner_scope, ambient_nursery),
	): SwitchSome<F, T, I, U> {
		SwitchSome<F, T, I, U> { up = self, select }
	}

	/// The Kleisli form (A123): `select` answers a `Flow<Option<U>>`, and the outer
	/// `None` (nothing selected) and the inner `None` (the followed flow holds
	/// nothing yet) collapse into one — `Option::and_then`, one level up.
	fun and_then<U, I: Flow<Option<U>>>(
		own self,
		select: (sync |T| I) context (owner_scope, ambient_nursery),
	): AndThen<F, T, I, U> {
		AndThen<F, T, I, U> { up = self, select }
	}
}

export impl type F: Flow<bool> {
	/// Follow `source`, as `Some`, while this flag is true, and read `None` (and
	/// hold no registration on `source`) while it is false.
	fun then_some<T, S: Source<T>>(own self, source: S): ThenSome<F, S, T> {
		ThenSome<F, S, T> { up = self, source }
	}
}

/// The join (A86, A142 §3.2): a flow of `Option<source>` — `None` reads `None` and
/// detaches, `Some(inner)` follows that inner, wrapped. `switch_some(|x| x)`.
///
/// A pipe cannot travel through a flow (its values are copied into every consumer),
/// so a flow of flows is always a flow of SOURCES. The TOTAL join of a flow of
/// sources — A4's `flatten` over a `Source<Source<U>>` — is `.switch(|inner|
/// inner)`, one stage: a second blanket `flatten` over `Flow<I: Source<U>>` beside
/// this one resolves by declaration order rather than by its nested bound
/// (reactive-44's `flatten` find, REPORT-reactive-44), so only one of the two can
/// carry the name, and A142 §3.2 gives it to this one.
export impl type F: Flow<Option<type I: Source<type U>>> {
	fun flatten(own self): SwitchSome<F, I, I, U> {
		SwitchSome<F, I, I, U> { up = self, select = |inner| inner }
	}
}

// === Pending values: `Resource<T>` (A124 R5, `proposal/reactive-pipeline.md` §2.5)
//
// A value that is not there yet — a fetch in flight — is NOT a `Source`: it cannot
// answer `get`. It is this small state machine, and it becomes a source through a
// FALLBACK, which is where the `Option` appears once instead of in every `map`
// below it:
//
//     [pending] --settles--> [settled v] --re-fetch--> [pending] ...
//         \--fails--> [failed e] <--fails--/     (a retry is a re-pend)
//
// `.or(default)` RESETS to the default while pending (Q2) — the one reading
// consistent with `.optional()`, which has no value to report then; `.latest`
// HOLDS the last settled value, the "keep the old list while the new one loads"
// product, as a NAME rather than a mode.
//
// Public since the flip (A124 S2c), beside the nodes its fallbacks return. The TYPE
// keeps the paper's name; the constructor over a source is `.load(fetch)`, because
// `resource` is a keyword (the struct kind), and a word that reads as what it does
// — load, for this value, again at every change — beats a suffixed `resource_of`.

/// Where a `Resource` stands.
export enum ResourceState<T> {
	Pending,
	Settled(T),
	Failed(str),
}

export struct Resource<T> {
	state: SignalCell<ResourceState<T>>,
	// The last SETTLED value, across every re-pend and failure since — what
	// `.latest` holds. `None` until the first settle.
	latest: Shared<Option<T>>,
	// Claimed per load; only the newest load's outcome is applied, so a slow answer
	// to an old value cannot overwrite a fast answer to the new one.
	generation: Shared<i32>,
}

export impl Resource<type T> {
	/// A resource with nothing yet: pending. The hand-driven form — `settle`,
	/// `fail` and `pend` move it; `.load(fetch)` on a source drives one for you.
	fun pending(): Resource<T> {
		Resource {
			state = SignalCell::new(ResourceState::Pending),
			latest = Shared::new(None),
			generation = Shared::new(0),
		}
	}

	/// pending/failed → settled.
	fun settle(self, value: T) {
		self.latest.write() = Some(value);
		self.state.set(ResourceState::Settled(value));
	}

	/// → failed: a third state, not a settled `Err` — a failed resource is retried
	/// by re-pending it.
	fun fail(self, reason: str) {
		self.state.set(ResourceState::Failed(reason));
	}

	/// settled/failed → pending again: the upstream changed, or a retry began.
	fun pend(self) {
		self.state.set(ResourceState::Pending);
	}

	/// The state itself, as a source — for a view that shows the failure.
	fun state(self): SignalCell<ResourceState<T>> {
		self.state
	}

	/// Total, with `default` standing in while pending or failed — and AGAIN on
	/// every re-pend (Q2: it resets).
	fun or(self, default: T): Derive<SignalCell<ResourceState<T>>, ResourceState<T>, T> {
		self.state.derive(|state| {
			match state {
				ResourceState::Settled(let value) => value,
				_ => default,
			}
		})
	}

	/// Total, HOLDING the last settled value across a re-pend or a failure;
	/// `default` only before the first settle.
	fun latest(self, default: T): Derive<SignalCell<ResourceState<T>>, ResourceState<T>, T> {
		let latest = self.latest;
		self.state.derive(|state| {
			match state {
				ResourceState::Settled(let value) => value,
				_ => latest.read().unwrap_or(default),
			}
		})
	}

	/// Total, with absence as a value: `None` while pending or failed.
	fun optional(self): Derive<SignalCell<ResourceState<T>>, ResourceState<T>, Option<T>> {
		self.state.derive(|state| {
			match state {
				ResourceState::Settled(let value) => Some(value),
				_ => None,
			}
		})
	}

	/// `true` exactly while pending — the spinner, which is what keeps `.latest`
	/// honest about showing stale data.
	fun is_pending(self): Derive<SignalCell<ResourceState<T>>, ResourceState<T>, bool> {
		self.state.derive(|state| {
			match state {
				ResourceState::Pending => true,
				_ => false,
			}
		})
	}

	/// One load for `value`, claimed as generation `mine`: awaited, then applied
	/// only if no newer load has claimed the resource since.
	fun load_for<V>(self, load: async |V| Result<T, str>, value: V, mine: i32) {
		let outcome = load(value);
		if self.generation.read() == mine {
			match outcome {
				Ok(let loaded) => self.settle(loaded),
				Err(let reason) => self.fail(reason),
			}
		}
	}
}

export impl type S: Source<type T> {
	/// A `Resource` over this source: `fetch` runs for the current value and again
	/// whenever it changes, and the resource RE-PENDS at every change — pending →
	/// settled → pending again, R5's machine. The newest load wins. The
	/// registration is the ambient owner's (A28) and a derivation (door 2), so a
	/// fallback read by an effect in the same turn already reads `pending`.
	///
	/// `user_id.load(fetch_user).or(guest)` — the `Option` of "not there yet" is
	/// confronted once, at the fallback, and never in a `map` below it.
	fun load<U>(self, fetch: async |T| Result<U, str>): Resource<U> {
		let loaded: Resource<U> = Resource::pending();
		let start = |value: T| {
			let mine = loaded.generation.read() + 1;
			loaded.generation.write() = mine;
			loaded.pend();
			let _in_flight = async loaded.load_for(fetch, value, mine);
		};
		start(self.get());
		as_derivation();
		let _owned = register_with_owner(self.on_change(start));
		loaded
	}
}

// === Keyed list reconciliation (backlog A3) — `each`'s engine ===
//
// Aligns a keyed row set with a new list of items. Per new item, in order: KEEP a
// same-key row whose item is unchanged, REFRESH a same-key row whose item changed
// (the caller disposes the old row and renders anew), or render FRESH when the key
// is new. Old rows whose keys left the list are REMOVED. A duplicate key claims its
// old row once — later duplicates render fresh. Pure logic (no DOM), so its edge
// cases pin in ordinary node tests; the browser's `each` applies the plan to
// elements.
//
// "Unchanged" is the CALLER's predicate (`same`), not `T: PartialEq` (A42). The key
// decides identity and the element MOVES; `same` decides, for a surviving key,
// reuse against dispose-and-rebuild — two different questions that the old bound
// conflated into one. `each` passes `==` and behaves exactly as it always has;
// `each_by` passes "always the same", which is what lets it take a `T` with no
// equality at all and update a kept row through its own cell instead of rebuilding
// it.
//
// The KEY is `PartialEq + Hashable` (A125): the plan is found through a hash index,
// so a key's hash must agree with its equality — `a == b` implies
// `a.hash() == b.hash()`, which is the obligation `std::hash` states for a
// hand-written impl. That agreement is what makes a REORDER linear rather than
// quadratic, and the bound is what makes it true rather than hoped for.

/// One new-position row's fate. `Keep`/`Refresh` carry the OLD row's index.
export enum RowStep {
	Keep(usize),
	Refresh(usize),
	Fresh,
}

/// The plan for one reconcile pass: a step per NEW item (in the new order),
/// then the old indices whose rows are gone entirely.
export struct ReconcilePlan {
	steps: List<RowStep>,
	removed: List<usize>,
}

export fun reconcile<T, K: PartialEq + Hashable>(
	old_keys: List<K>,
	old_items: List<T>,
	items: List<T>,
	key_of: sync |T| K,
	same: sync |T, T| bool,
): ReconcilePlan {
	mut claimed: List<bool> = [];
	for _ in old_keys {
		claimed.push(false);
	}
	let held = old_keys.len();
	// M82's POSITION INDEX, on A125's `K: Hashable`: a pass is linear for every
	// change, a REORDER included.
	//
	// The scan this replaces walked `old_keys` from 0 for every new item,
	// skipping claimed entries — so for a list that did not reorder, item `i`
	// matched at index `i` after walking `i + 1` entries, and a pass cost
	// N(N+1)/2 iterations whatever the change was: 500,500 at 1,000 rows for
	// ONE append. The index is the same thing `KeyedCell` keeps, built per
	// pass: for each key's hash, the chain of old positions holding it,
	// smallest first. `first` is a chain's head and `next_same[i]` is the
	// position after `i` in `i`'s own chain — one native map of at most N
	// entries plus one N-element list, no nested containers and no per-key list
	// to grow.
	//
	// Built DESCENDING so each head ends up the smallest index in its chain,
	// which is what makes walking a chain the same order as scanning from 0.
	//
	// **Why the bound, and what it buys (A125).** M82 keyed the index on
	// `canonical_hash`, which no bound made agree with `K`'s `==`, so an EARLIER
	// equal key could sit outside the chain and the stretch from the smallest
	// unclaimed index up to the candidate had to be scanned as well. That stretch
	// is empty when nothing moved and is the WHOLE prefix when a list is reversed —
	// `each` on a sorted-in-place list was quadratic. `K: Hashable` states the
	// obligation `std::hash` already names ("its obligation is consistency with the
	// equality the key is used under"), so `a == b` implies `a.hash() == b.hash()`:
	// every key equal to this item's is somewhere in THIS chain, and the chain's
	// first unclaimed `==` match is the scan's answer. The scan is gone and the
	// pass is linear.
	//
	// A COARSER hash is still fine and still correct — two keys that are not
	// `==` may share a hash, which is an ordinary collision: the walk below
	// steps past them along the chain. What the bound forbids is the opposite,
	// a `==` coarser than the hash, and that is the case the bound refuses to
	// compile rather than mis-plan.
	// I5 S2: the chain is `Option<usize>` — a position, or the end of the chain —
	// where it was an `i32` terminated by `-1`. The walks below are the same
	// walks; the sentinel became `None` and the build loop counts down to zero
	// without ever reaching below it.
	mut first: NativeMap<usize> = NativeMap::new();
	mut next_same: List<Option<usize>> = [];
	for _ in old_keys {
		next_same.push(None);
	}
	mut build = held;
	for build > 0 {
		build -= 1;
		let canonical = old_keys[build].hash();
		next_same[build] = first.get(canonical);
		first.insert(canonical, build);
	}
	mut steps: List<RowStep> = [];
	for item in items {
		let item_key = key_of(item);
		let canonical = item_key.hash();
		// The chain for this key's hash. Entries at its head that are already
		// claimed are dropped from the chain for good (`first` is advanced past
		// them), so the total cost of skipping claimed entries across a whole pass
		// is bounded by the number of claims.
		mut head: Option<usize> = first.get(canonical);
		mut advancing = true;
		for advancing {
			match head {
				Some(let at) => {
					if claimed[at] {
						head = next_same[at];
					} else {
						advancing = false;
					}
				},
				None => advancing = false,
			}
		}
		match head {
			Some(let at) => first.insert(canonical, at),
			None => first.remove(canonical),
		}
		mut found: Option<usize> = None;
		mut walk = head;
		mut walking = true;
		for walking {
			match walk {
				Some(let at) => {
					if !claimed[at] && old_keys[at] == item_key {
						found = Some(at);
						walking = false;
					} else {
						// Unclaimed, the same hash, and yet not `==`: a COLLISION.
						// Walk on rather than advance the head, because a later
						// item may still match here.
						walk = next_same[at];
					}
				},
				None => walking = false,
			}
		}
		mut step = RowStep::Fresh;
		if found is Some(let at) {
			claimed[at] = true;
			step = if same(old_items[at], item) { RowStep::Keep(at) } else { RowStep::Refresh(at) };
		}
		steps.push(step);
	}
	mut removed: List<usize> = [];
	mut index = 0;
	for index < held {
		if !claimed[index] {
			removed.push(index);
		}
		index += 1;
	}
	ReconcilePlan { steps, removed }
}

// === Local-first drafts (Kolt's `Crate`, typed) ==============================
//
// A `Draft<T>` is a local-first cell over a remote commit: edits land in `local`
// FIRST (an input never waits on the wire), `push` commits them, and `adopt` folds
// in remote changes without fighting in-flight edits. Failure KEEPS the local value
// (unlike `optimistic`, which rolls back — right for one-shot actions, hostile
// mid-typing); the next push retries naturally. Conflicts are last-write-wins: a
// dirty local survives remote adoption, and its eventual push overwrites the remote
// edit.
//
// Two opt-in behaviours ride on top (`proposal/draft-reconnect.md`, A14):
// `repush()` re-sends edits the remote never accepted — wire it to a transport's
// reconnect and a dropped connection stops losing the user's work — and
// `debounce(millis)` coalesces a burst of keystrokes into one commit instead of one
// per edit. Both are off unless asked for.

/// The sync status a UI can bind ("saved" / "unsaved" / the failure).
export [derive(PartialEq, Debug)]
enum DraftState {
	// `local` matches the last pushed/adopted value.
	Synced,
	// Local edits not yet confirmed (in-flight included).
	Dirty,
	// The last push errored; `local` is kept, not rolled back.
	Failed(str),
}

export struct Draft<T> {
	// Bind inputs to this; read it like any signal.
	local: SignalCell<T>,
	state: SignalCell<DraftState>,
	// The last value known to match the remote (pushed by us or adopted).
	synced: Shared<T>,
	// Discards stale completions when pushes overlap (fast typing over a slow
	// wire): only the newest push settles the state.
	generation: Shared<i32>,
	// The coalescing window in milliseconds; 0 (the default) commits on every
	// `push`. A CELL, like every other field, so copying a draft can never produce
	// two values that disagree about their own window.
	debounce_millis: Shared<i32>,
	// The outstanding coalescing timer, when a debounced push is waiting out its
	// window. Cancelled by a newer push, by `commit`, and by `repush`.
	pending: Shared<Option<Timer>>,
	/// `None` = success, `Some(reason)` = failure. Calls through the field await (a
	/// sync commit just resolves).
	commit: async |T| Option<str>,
}

/// A local-first cell seeded with `initial`, committing through `commit`. The
/// parameter is `async`-typed so an rpc-calling closure flows in legally (J2's
/// channel) — a sync commit passes fine too (awaiting a plain value just resolves).
export fun draft<T: PartialEq>(initial: T, commit: async |T| Option<str>): Draft<T> {
	Draft {
		local = SignalCell::new(initial),
		state = SignalCell::new(DraftState::Synced),
		synced = Shared::new(initial),
		generation = Shared::new(0),
		debounce_millis = Shared::new(0),
		pending = Shared::new(None),
		commit,
	}
}

export impl Draft<type T: PartialEq> {
	/// Set locally and commit — the per-keystroke path. LOCAL-FIRST: the commit is
	/// spawned, never awaited, so `push` (and the input handler calling it) returns
	/// without riding the wire.
	///
	/// Under a `debounce(millis)` window the LOCAL half is unchanged — the value
	/// and the `Dirty` state land synchronously, exactly as here — and only the
	/// commit waits out the window, coalescing a burst of pushes into one.
	fun push(self, value: T) {
		// ONE wave: a lifecycle transition writes two signals, and an observer of
		// both must never see half of it (`proposal/optimistic-lifecycle.md` §5).
		// `batch` joins the ambient turn when there is one — under a UI boundary
		// turn nothing changes — and creates one when there is not, which is the
		// case that used to publish the new text still claiming `Synced`.
		batch(|| {
			self.local.set(value);
			self.state.set(DraftState::Dirty);
		});
		if self.debounce_millis.read() > 0 {
			self.arm();
		} else {
			self.send(value);
		}
	}

	/// Commit `value` now, unconditionally: claim the newest generation (so any
	/// older in-flight commit's outcome is discarded) and spawn the in-flight half.
	///
	/// Deliberately unstructured (no nursery): the in-flight commit is owned by the
	/// draft CELL, not by any function's extent — the caller returning is the
	/// point. `settle` resolves every outcome into the draft's state; a panic
	/// escaping it surfaces as the task report.
	fun send(self, value: T) {
		let mine = self.generation.read() + 1;
		self.generation.write() = mine;
		let _in_flight = async self.settle(value, mine);
	}

	/// Start (or restart) the coalescing window: call off whatever was waiting and
	/// park a fresh timer. Trailing-edge — the commit happens `debounce_millis`
	/// after the LAST push, not the first.
	fun arm(self) {
		self.cancel_pending();
		let timer = Timer::after(self.debounce_millis.read());
		self.pending.write() = Some(timer);
		let _waiting = async self.fire(timer);
	}

	/// The trailing edge. `wait` settles `true` only if the window ran out;
	/// a `cancel` — a newer push, a manual `commit`, a `repush` — settles it
	/// `false` and this task retires without touching the wire. The value
	/// sent is the LATEST local one, which is the point of coalescing.
	fun fire(self, timer: Timer) {
		if timer.wait() {
			self.pending.write() = None;
			self.send(self.local.get());
		}
	}

	/// Call off any outstanding coalescing timer. Idempotent (`Timer.cancel`
	/// is, and a settled timer is untouched), so this is safe to call on a
	/// draft that has no window and never armed one.
	fun cancel_pending(self) {
		match self.pending.read() {
			Some(let timer) => timer.cancel(),
			None => {},
		}
		self.pending.write() = None;
	}

	/// Coalesce pushes into one commit per `millis` of quiet — the fix for one wire
	/// frame per keystroke. Returns the draft for chaining:
	///
	///     let title = draft(page.title, commit).debounce(300);
	///
	/// `0` restores the default, a commit on every `push`. The window is a cell
	/// shared by every copy of the draft, so this is a property of the CELL and not
	/// of the value you happen to be holding.
	fun debounce(self, millis: i32): Draft<T> {
		self.debounce_millis.write() = millis;
		self
	}

	/// Commit the current local value NOW, cancelling any pending debounce window —
	/// the explicit save (a blur handler, a Save button, a submit). Exactly one
	/// commit results: the cancelled timer's parked task retires without sending.
	fun commit(self) {
		self.cancel_pending();
		self.send(self.local.get());
	}

	/// Re-send local edits the remote never accepted — the reconnect path
	/// (`proposal/draft-reconnect.md`). Wire it to a transport's reconnect hook and
	/// a dropped connection stops losing the user's work:
	///
	///     client.transport.on_reconnect(|| title.repush());
	///
	/// It is also the "retry" button in a failure banner.
	///
	/// A no-op unless `local` differs from `synced` — that test covers both
	/// an edit whose commit never left and one caught in flight by the drop
	/// (a failed commit KEEPS the local value and does not advance `synced`),
	/// and it means a screen of untouched drafts costs nothing on reconnect.
	/// A pending debounce is cancelled and the value goes immediately:
	/// recovery is not typing, and there is no burst to coalesce.
	///
	/// DELIVERY IS AT-LEAST-ONCE. A commit that reached the server and
	/// succeeded, whose reply was lost with the connection, is
	/// indistinguishable here from one that never arrived — so the server
	/// may see it twice. `Draft`'s own reconcile is idempotent (`adopt`
	/// no-ops on an echo; the generation guard discards the superseded
	/// commit's outcome), but the commit CLOSURE is yours: "set the remote to
	/// this value" repeats harmlessly, "append this" does not.
	///
	/// A re-push that fails settles `Failed` like any other and is NOT retried on a
	/// timer — `local` still differs from `synced`, so the next reconnect sends it
	/// again. A draft the server is permanently refusing must not spin.
	fun repush(self) {
		if self.local.get().ne(self.synced.read()) {
			self.cancel_pending();
			self.send(self.local.get());
		}
	}

	/// The in-flight half of a push: await the commit, then resolve the draft's
	/// state — unless a newer push superseded this one while it was on the wire
	/// (fast typing over a slow commit), in which case that push's completion owns
	/// the state.
	fun settle(self, value: T, mine: i32) {
		let outcome = (self.commit)(value);
		if self.generation.read() == mine {
			match outcome {
				None => {
					self.synced.write() = value;
					self.state.set(DraftState::Synced);
				},
				Some(let reason) => self.state.set(DraftState::Failed(reason)),
			}
		}
	}

	/// A remote value arrived (a mirror update). An echo of our own push is a
	/// no-op; a genuine remote change adopts into `local` — unless local has
	/// unpushed edits, which win until their push lands.
	fun adopt(self, remote: T) {
		if remote == self.synced.read() {
			// Our own edit reflected back (or nothing changed).
		} else if self.local.get() == self.synced.read() {
			// Clean local: take the remote edit — again as ONE wave.
			self.synced.write() = remote;
			batch(|| {
				self.local.set(remote);
				self.state.set(DraftState::Synced);
			});
		} else {
			// Dirty local: the user's text wins for now; remember the remote so the
			// eventual push knowingly overwrites it.
			self.synced.write() = remote;
		}
	}
}

// === The optimistic-write → reconcile lifecycle (A14) ========================
//
// `optimistic` above is the stateless one-shot: paint, await, confirm or roll back.
// An `Optimistic<T>` cell is the same lifecycle made OBSERVABLE and made correct
// when writes overlap (`proposal/optimistic-lifecycle.md`):
//
//   - `state` publishes `Pending` while a write is on the wire and
//     `Rejected(reason)` when one is refused, so a spinner, a disabled
//     button and a failure banner have something to bind. The free function
//     hands the outcome to its caller and to no one else.
//   - Two guards keep overlapping writes honest. Only the NEWEST write
//     paints the cell (a superseded outcome is discarded, like `Draft`'s
//     generation guard), and the rollback target is the last value the
//     SERVER confirmed rather than whatever the signal happened to hold —
//     which is a different question, so it has a counter of its own.
//
// The cell WRAPS an existing signal, so adopting it changes no binding. Unlike
// `Draft` it does not re-push on reconnect, and that is deliberate: re-push is
// at-least-once (`proposal/draft-reconnect.md` §3.2), safe for a draft's "set this
// field to this value" and unsafe for the one-shot ACTIONS this cell exists for.
// The rollback is the recovery; the user re-issues.

/// Where a write made through an `Optimistic` cell stands. Bind it.
export [derive(PartialEq, Debug)]
enum WriteState {
	// Nothing in flight; the cell's value is the last confirmed truth.
	Confirmed,
	// The newest write is on the wire.
	Pending,
	// The newest write was refused; the cell has rolled back. Sticky until the next
	// write, so a banner stays up until something changes.
	Rejected(str),
}

// The cell is generic over the SIGNAL as well as its value (B186): a field must
// name a real type, so widening `over` past the canonical cell means naming the
// signal's type, and `S` is that name. A33's write-back class is what makes it
// worth the arity — a clamped or persisted cell of the user's own is now wrappable,
// where before only `SignalCell` was.
export struct Optimistic<T, S: Signal<T>> {
	// The signal being written — the one handed to `over`. Bind it.
	value: S,
	// The lifecycle, for the UI.
	state: SignalCell<WriteState>,
	// The last value the server confirmed: the ROLLBACK TARGET, and the reason this
	// cannot be a free function over a bare signal.
	confirmed: Shared<T>,
	// Claimed per write; only the newest write's outcome paints.
	generation: Shared<i32>,
	// The highest generation whose outcome reported a confirmation, so out-of-order
	// completions cannot un-tell us what the server holds.
	confirmed_generation: Shared<i32>,
}

export impl Optimistic<type T, type S: Signal<T>> {
	/// Wrap `signal` in an optimistic-write cell, seeded with its current value as
	/// the confirmed truth — the value the cell is handed is, by definition, the
	/// last thing anyone confirmed.
	///
	/// Any `Signal<T>` serves, not only the canonical cell (A32's write-back class,
	/// with `optimistic` and `ui`'s `bind_value`): the cell WRITES, and `Source`
	/// declares `get`/`sub` and no `set`. `S` is written out rather than sugared,
	/// because the return type names it — B186's implicit generic is a parameter's
	/// bound, and this one is the struct's.
	fun over(signal: S): Optimistic<T, S> {
		Optimistic {
			value = signal,
			state = SignalCell::new(WriteState::Confirmed),
			confirmed = Shared::new(signal.get()),
			generation = Shared::new(0),
			confirmed_generation = Shared::new(0),
		}
	}

	/// Paint `value` and flip to `Pending` in one wave, run `commit`, then
	/// reconcile in one wave — the confirmed value on `Ok`, a rollback to the last
	/// confirmed value on `Err`. Returns the outcome, so a caller that wants its
	/// own error UX keeps it; the `state` signal is an addition to that, not a
	/// replacement.
	///
	/// Awaits, like `optimistic`. Fire-and-forget is
	/// `let _sent = async cell.write(..)`.
	///
	/// If a NEWER write claimed the cell while this one was on the wire, this
	/// outcome does not paint: the newest write owns the cell, and its own commit
	/// answers for it. The outcome still comes back here.
	fun write(self, value: T, commit: async || Result<T, str>): Result<T, str> {
		let mine = self.generation.read() + 1;
		self.generation.write() = mine;
		batch(|| {
			self.value.set(value);
			self.state.set(WriteState::Pending);
		});

		let outcome = commit();

		// Knowledge first, and independently of the paint guard: a superseded
		// write that SUCCEEDED still told us something true about the server,
		// and it is the rollback target. Only a later write's confirmation may
		// replace it, so out-of-order completions cannot walk it backwards.
		match outcome {
			Ok(let server_value) => {
				if mine > self.confirmed_generation.read() {
					self.confirmed.write() = server_value;
					self.confirmed_generation.write() = mine;
				}
			},
			// A refusal taught us only that the server still holds what it held.
			Err(let _reason) => {},
		}

		if self.generation.read() == mine {
			batch(|| {
				match outcome {
					Ok(let server_value) => {
						self.value.set(server_value);
						self.state.set(WriteState::Confirmed);
					},
					Err(let reason) => {
						self.value.set(self.confirmed.read());
						self.state.set(WriteState::Rejected(reason));
					},
				}
			});
		}
		outcome
	}
}
