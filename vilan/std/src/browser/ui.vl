// `std::ui` — a declarative, fine-grained reactive view layer over `std::dom`.
//
// A `View` describes a DOM element; methods chain to build it. Plain setters
// (`text`/`class`/`attr`) set static content; the `bind_*` setters take a
// `Source` and keep one DOM property in sync — each is an `effect`, so when
// the source changes only that property updates, with no re-render.
//
// A READ-ONLY binding demands only `Source<T>`, never the concrete `SignalCell<T>`
// (A33): a binding that never writes its argument has no business insisting on
// the writable type, and a user's own `Source` — a storage-backed cell, a
// `RemoteSource`, any custom mirror — drives them exactly like a signal.
// `bind_value` and `bind_draft` stay concrete because they WRITE BACK; the
// write side is A32's ruling, not this one's.
//
// OWNERSHIP LIVES AT DISPOSAL BOUNDARIES (proposal/ambient-owner.md §4): a
// subscription must die exactly when its subtree becomes garbage, and
// subtrees only become garbage at DYNAMIC boundaries — a `mount_root`/`comp`
// root, an `each` row, a `when` instantiation. Static content shares its
// nearest boundary's lifetime, so `View` carries no owner and bindings
// register AMBIENTLY into the nearest boundary. Building UI outside every
// boundary is a COMPILE error (the context coverage fence): every entry
// point establishes a root, so no subscription can be unrooted.
//
// `show` deliberately stays a visibility toggle — content mounted, state
// preserved, no boundary. `when` is the state-dropping form: it mounts its
// body under a fresh owner per instantiation and disposes it on the way out.
//
// Only available when building for the browser (`vilan build --target browser`).

import pkg::compare::PartialEq;
import pkg::dev::{ hmr_active, on_teardown };
import pkg::dom::{
	Element,
	Event,
	Text,
	create_document_fragment,
	create_element,
	create_element_ns,
	create_range,
	create_text_node,
	get_element_by_id,
	request_animation_frame,
};
import pkg::io::panic;
import pkg::option::Option::{ self, None, Some };
import pkg::reactive::{
	Disposable,
	Draft,
	FlushPolicy,
	Owner,
	RowStep,
	Signal,
	SignalCell,
	Source,
	comp,
	get_owner,
	owner_scope,
	queue_microtask,
	reconcile,
	run_with_owner,
	turn,
	turn_scope,
};
import pkg::shared::Shared;
import pkg::style::Style;

/// A handle to a DOM element under construction — nothing more: ownership is
/// the enclosing boundary's job.
export struct View {
	element: Element,
}

/// A fresh element of the given tag (`view("div")`, `view("button")`, …).
/// SVG tag names (exact case — `clipPath`, not `clippath`) create in the SVG
/// namespace, so an inline `view("svg")` tree actually renders; everything
/// else is an HTML element. Tags that exist in BOTH vocabularies (`a`,
/// `title`, `style`, `script`) resolve to HTML — inline SVG rarely wants
/// them, and a link around an icon is the HTML `a`.
export fun view(tag: str): View {
	if is_svg_tag(tag) {
		View { element = create_element_ns("http://www.w3.org/2000/svg", tag) }
	} else {
		View { element = create_element(tag) }
	}
}

/// The SVG vocabulary `view` routes through `createElementNS` — the drawing
/// and paint-server elements, exact-case (the camelCase names cannot be
/// created by `createElement` at all: it lowercases). Deliberately excludes
/// the HTML-ambiguous tags (`a`, `title`, `style`, `script`).
/// KEEP IN STEP with the process twin's copy (process/ui.vl) — the layer
/// system shares no file between them, and SSR must serialize exactly the
/// set the browser namespaces.
fun is_svg_tag(tag: str): bool {
	match tag {
		"svg" => true,
		"path" => true,
		"circle" => true,
		"ellipse" => true,
		"rect" => true,
		"line" => true,
		"polyline" => true,
		"polygon" => true,
		"g" => true,
		"defs" => true,
		"use" => true,
		"symbol" => true,
		"marker" => true,
		"pattern" => true,
		"mask" => true,
		"clipPath" => true,
		"linearGradient" => true,
		"radialGradient" => true,
		"stop" => true,
		"text" => true,
		"tspan" => true,
		"textPath" => true,
		"filter" => true,
		"foreignObject" => true,
		"feGaussianBlur" => true,
		"feColorMatrix" => true,
		"feOffset" => true,
		"feMerge" => true,
		"feMergeNode" => true,
		"feFlood" => true,
		"feComposite" => true,
		"feBlend" => true,
		"feDropShadow" => true,
		_ => false,
	}
}

export impl View {
	/// Static text content.
	fun text(self, content: str): View {
		self.element.set_text(content);
		self
	}

	/// Static CSS class. Set as the `class` ATTRIBUTE, not the `className`
	/// property: identical on HTML elements, and the only form that works on
	/// SVG (whose `className` is a readonly `SVGAnimatedString` — assigning
	/// it throws in module code).
	fun class(self, name: str): View {
		self.element.set_attribute("class", name);
		self
	}

	/// Classes from a compiled `Style` (proposal/ui-styling.md §4). Rendering
	/// is runtime-legal — the rules were emitted when the style was
	/// constructed, inside its `const` expression.
	fun styled(self, style: Style): View {
		self.element.set_attribute("class", style.class_list());
		self
	}

	/// A signal-driven CSS custom property: pairs with
	/// `width(Length::var("--w"))` in a style — dynamism through the variable,
	/// never through runtime rule construction. Registers with the nearest
	/// enclosing boundary (an ambient `effect`), exactly like every `bind_*`:
	/// a subscription parked in a `let _sub` outlives the view it writes to.
	fun style_var<S: Source<str>>(self, name: str, source: S): View {
		let element = self.element;
		source.effect(|value| {
			element.set_style_property(name, value);
		});
		self
	}

	/// An attribute. The value's TYPE decides its life
	/// (proposal/element-syntax.md §5): a `str` sets once; a `SignalCell<str>`
	/// re-sets whenever it changes, exactly `bind_attr`. Anything `AttrValue`
	/// fills the slot.
	fun attr<V: AttrValue>(self, name: str, value: V): View {
		value.apply(self, name);
		self
	}

	/// An event listener (`"click"`, `"input"`, …). A DOM event is a TURN
	/// boundary (proposal/reactive-turns.md §2): the host stores only the
	/// plain adapter below, and each dispatch runs the clause-typed handler
	/// inside a fresh turn — an event's signal writes settle as one wave.
	/// (`AtSuspension` behaves as `AtEnd` until the async hook lands.)
	/// Handlers die with the DOM
	/// node — no registration needed.
	fun on(self, event: str, handler: (|| void) context turn_scope): View {
		self.element.on(event, || turn(FlushPolicy::AtSuspension, || handler()));
		self
	}

	/// Like `on`, but the handler receives the DOM `Event` — for
	/// `prevent_default`, modifier keys, key names. The same turn discipline:
	/// each dispatch settles as one wave.
	fun on_event(self, event: str, handler: (|Event| void) context turn_scope): View {
		self.element
			.on_event(event, |dispatched| turn(FlushPolicy::AtSuspension, || handler(dispatched)));
		self
	}

	/// Append content. Anything `Slot` fills a child position
	/// (proposal/element-syntax.md §5), which is the whole CHILD CONTRACT
	/// (B268): a `View` appends as an element, a `str` as a text node, a
	/// `List<View>` appends each, and a `Source` of any of those three keeps
	/// the position in sync — text re-set in place, an element or a run
	/// replaced. Text and element children interleave as real siblings — mixed
	/// content without wrapper spans.
	///
	/// Structure only for the static arms; the reactive ones register their one
	/// subscription with the nearest enclosing boundary, exactly as every
	/// `bind_*` does.
	fun child<C: Slot>(self, content: C): View {
		content.place(self);
		self
	}

	/// Append several child views.
	fun children(self, items: List<View>): View {
		for item in items {
			self.element.append(item.element);
		}
		self
	}

	/// Reactive text content — re-set whenever `source` changes. Registers
	/// with the nearest enclosing boundary (an ambient `effect`). Any
	/// `Source<str>` drives it: a `Signal`, a derived signal, a `RemoteSource`
	/// mirror, a user's own cell (A33).
	fun bind_text<S: Source<str>>(self, source: S): View {
		let element = self.element;
		source.effect(|value| {
			element.set_text(value);
		});
		self
	}

	/// Reactive CSS class.
	fun bind_class<S: Source<str>>(self, source: S): View {
		let element = self.element;
		source.effect(|value| {
			element.set_attribute("class", value);
		});
		self
	}

	/// Reactive `Style` — the reactive twin of `styled`, the way `bind_class`
	/// is `class`'s. The whole compiled style swaps when `source` changes.
	/// Nothing is CONSTRUCTED here: every candidate style emitted its rules
	/// inside its own `const` expression, and `class_list` is a map read, so
	/// the construct-in-const rule holds with a signal in the middle.
	fun bind_styled<S: Source<Style>>(self, source: S): View {
		let element = self.element;
		source.effect(|value| {
			element.set_attribute("class", value.class_list());
		});
		self
	}

	/// Reactive attribute.
	fun bind_attr<S: Source<str>>(self, name: str, source: S): View {
		let element = self.element;
		source.effect(|value| {
			element.set_attribute(name, value);
		});
		self
	}

	/// A BOOLEAN attribute, bound: present when `source` is true, absent when
	/// it is false (A66). `inert`, `disabled`, `hidden`, `open` — the family
	/// whose meaning is PRESENCE, not value, so `attr("disabled", "false")` is
	/// a disabled control and there is no string that turns one off.
	///
	/// `bind_attr`'s twin at the other value type: an effect under the current
	/// owner, dying with the boundary that built it exactly as every binding
	/// does. The set writes the empty string, which is the canonical spelling
	/// of a present boolean attribute (`<div inert>` and `<div inert="">`
	/// serialize alike).
	fun toggle_attr<S: Source<bool>>(self, name: str, source: S): View {
		let element = self.element;
		source.effect(|present| {
			if present {
				element.set_attribute(name, "");
			} else {
				element.remove_attribute(name);
			}
		});
		self
	}

	/// Two-way bind an `<input>`'s value to a signal: the input shows the
	/// signal, and typing writes it back.
	///
	/// Bounded on `Signal<str>`, the WRITABLE trait (A32): this binding writes,
	/// so `Source` — which declares `get`/`sub` and no `set` — is not enough,
	/// and the concrete cell is more than it needs. Any impl satisfies it: a
	/// cell that clamps its setter, one that persists, one that debounces.
	///
	/// The listener reaches NO element (`proposal/lifetimes.md` §5, V3), which
	/// takes both halves of `write_back_value`'s note: the typed text comes off
	/// the EVENT, and the listener is created in a scope that never held an
	/// element. What survives an unmount is then element → listener → signal,
	/// with nothing pointing back.
	fun bind_value<S: Signal<str>>(self, signal: S): View {
		let element = self.element;
		signal.effect(|value| {
			element.set_value(value);
		});
		write_back_value(self.element, signal);
		self
	}

	/// A local-first editable field: the input shows the draft's local value,
	/// and USER input pushes (locally first, then the draft's commit). An
	/// `adopt`ed remote change writes `local` without passing through here,
	/// so it never re-pushes — and a DIRTY draft ignores adoption entirely,
	/// so an echo never touches a focused input's caret.
	///
	/// Concrete `Draft`, with `bind_value` (A33): a draft is the write side by
	/// construction — this pushes.
	fun bind_draft(self, draft: Draft<str>): View {
		let element = self.element;
		draft.local.effect(|value| {
			// Skip the no-op write (a push echoing through `local`): setting
			// an input's value, even to itself, can move the caret.
			if element.value() != value {
				element.set_value(value);
			}
		});
		write_back_draft(self.element, draft);
		self
	}

	/// Run `action` with this element once it is IN THE DOCUMENT (backlog
	/// A45).
	///
	/// Attachment happens at six different places in this module — `mount`,
	/// `Slot::place`, `children`, `each`'s order pass, `when`, `swap` —
	/// and none of them is a hook a view can reach. So the hook is a
	/// MICROTASK: the whole synchronous build, and the `mount`/append that
	/// finishes it, run to completion before any microtask does, so by the
	/// time `action` runs the element is where the build put it.
	///
	/// The chained form is the point — `view("input").attr("type", "text")
	/// .on_mount(|element| element.focus())` — and it replaces the id-plus-
	/// timer dance an app writes otherwise: mint a uuid, set it as the id,
	/// `set_timeout(1)`, look the element back up. There is nothing to look
	/// up: the callback is handed the element itself.
	///
	/// WHAT THIS GUARANTEES, AND WHAT IT DOES NOT (B271). The element is IN
	/// THE DOCUMENT when `action` runs, and that is the whole promise. A
	/// microtask runs BEFORE the frame's rendering step, so at that moment the
	/// element is connected but not yet rendered: it has no layout, its
	/// computed style is not resolved, and nothing a `ResizeObserver` or an
	/// `IntersectionObserver` does in reaction to layout has happened. Any
	/// action whose precondition is "rendered" or "visible" — `focus()`, a
	/// measurement, a scroll into view — must ask again on an animation frame
	/// if the first attempt does not take. `View::autofocus` is that pattern
	/// written once; `std::dom::request_animation_frame` is the clock.
	fun on_mount(self, action: sync |Element| void): View {
		// Capture the ELEMENT, not the view: the closure the host holds must
		// reach exactly what the callback needs and nothing more
		// (`proposal/lifetimes.md` §5, V1).
		let element = self.element;
		queue_microtask(|| action(element));
		self
	}

	/// Move keyboard focus here once the element is in the document — the
	/// one-word form of `on_mount(|element| element.focus())`, and the reason
	/// `on_mount` exists. HTML's `autofocus` attribute fires only on a
	/// document's initial parse, so it does nothing for a modal opened later.
	///
	/// FRAME-AWARE AND BOUNDED (B271). `focus()` is a request with a
	/// PRECONDITION — the target must be connected, RENDERED, visible and not
	/// inert at the call — and the platform's answer to a target that is not is
	/// to do nothing, silently. `on_mount`'s microtask runs before the frame's
	/// rendering step, so a subtree that becomes focusable only during that
	/// step is still hidden when the first attempt lands: an overlay panel held
	/// at `visibility: hidden` until a `ResizeObserver` callback places it and
	/// flips it visible is exactly this, and it refused focus every time.
	///
	/// So: attempt in the microtask; if the element did not take focus, attempt
	/// again on the next animation frame, and once more on the frame after
	/// (layout-driven flips land in the rendering step between). Then stop.
	/// Three attempts on the platform's own clock — no timer, no millisecond,
	/// nothing to tune. `matches(":focus")` is how the attempt is read back:
	/// `focus()` returns void and reports nothing.
	///
	/// THE CASE NO TIMING FIXES: iOS Safari ignores a programmatic `focus()`
	/// outside a user gesture, whatever frame it runs on. And the formal shape
	/// for an overlay is that focus is a consequence of the SHOW — a hook the
	/// driver runs when it flips visibility, or `<dialog>.showModal()`, whose
	/// focusing steps run once the dialog is rendered — not a retry.
	fun autofocus(self): View {
		self.on_mount(|element| {
			element.focus();
			if !element.matches(":focus") {
				request_animation_frame(|| {
					element.focus();
					if !element.matches(":focus") {
						request_animation_frame(|| element.focus());
					}
				});
			}
		})
	}

	/// Show or hide the element on a reactive condition — present when
	/// `condition` is true, hidden otherwise. A pure visibility toggle: the
	/// content stays mounted and its state (bindings, input text) survives.
	///
	/// TWO WRITES, and the second one is the one that hides (A60). The
	/// `hidden` ATTRIBUTE is what CSS selectors and assistive technology read,
	/// so it is set; but the preflight's `[hidden]{display:none}` rule sits in
	/// `@layer vilan.preflight`, and a compiled `Style`'s rules are UNLAYERED —
	/// an unlayered author declaration is the highest-priority author layer
	/// there is, so `.sX{display:flex}` beats the reset whatever its
	/// specificity, and `show` was a silent no-op on every flex container in a
	/// real app (kolt's `child_relation("not([hidden])", …)` is that defect
	/// wearing a HACK comment). No cascade layer can fix it, because there is
	/// no layer above "unlayered"; `!important` is refused permanently
	/// (css-block.md §10). So hiding writes the INLINE `display: none`, which
	/// beats every rule in the sheet, and showing writes back the element's own
	/// inline `display` — captured once, before the first toggle, because
	/// `show` owns that slot from then on. `set_style_property` with the empty
	/// string REMOVES the declaration (CSSOM), so an element that had no
	/// inline display ends with none.
	///
	/// The cost is stated plainly: an app that writes this element's inline
	/// `display` itself, after `show` has bound it, loses that write on the
	/// next toggle. Style the element through a `Style` — which is what the
	/// styling surface is for — and the two never meet.
	fun show<S: Source<bool>>(self, condition: S): View {
		let element = self.element;
		let restored = element.style_property("display");
		condition.effect(|visible| {
			element.set_hidden(!visible);
			if visible {
				element.set_style_property("display", restored);
			} else {
				element.set_style_property("display", "none");
			}
		});
		self
	}
}

// === The input write-back listeners (proposal/lifetimes.md §5, V3) ==========
//
// These exist as FUNCTIONS OF THEIR OWN, and that is the whole fix. A closure
// captures its enclosing SCOPE, not the names it happens to mention (§4's
// capture rule), and one JS scope is allocated per invocation — so a listener
// written inline in `bind_value` would reach the `element` its sibling effect
// closure needs, however carefully the listener's own body avoids naming it.
// Element → listener → element is the one cycle that straddles the
// language/host boundary, where no vilan-side disposal can see both halves, so
// it has to be absent by CONSTRUCTION.
//
// Born here, a listener's scope chain holds the signal (or the draft) and
// nothing else: the element is a plain parameter no closure reads, and the
// typed text comes off the event (`Event::target_value`). After an unmount the
// element still reaches the signal — a dead end, since the effect that pointed
// back was disposed with the boundary.

/// The write-back half of `bind_value`. Each input event's write is a boundary
/// dispatch, so it settles in its own turn.
fun write_back_value<S: Signal<str>>(element: Element, signal: S) {
	element.on_event("input", |event| turn(FlushPolicy::AtSuspension, || {
		signal.set(event.target_value());
	}));
}

/// The write-back half of `bind_draft`: USER input pushes (locally first, then
/// the draft's commit).
fun write_back_draft(element: Element, draft: Draft<str>) {
	element.on_event("input", |event| turn(FlushPolicy::AtSuspension, || {
		draft.push(event.target_value());
	}));
}

/// True while a route chunk is in flight (proposal/bundle-splitting.md §2) —
/// the one hook a loading indicator needs. Re-exported as
/// `std::router::pending`, which is where an app reads it.
let chunk_pending_signal: SignalCell<bool> = SignalCell::new(false);

/// Why the last route chunk fetch failed, or `None` (§S3). Re-exported as
/// `std::router::chunk_error`. Cleared when the next navigation starts, so a
/// view bound to it shows the failure exactly until something is retried.
let chunk_error_signal: SignalCell<Option<str>> = SignalCell::new(None);

/// The route arm a value selects. See `swap_split`.
[extern("__chunk_arm", retains)]
external fun chunk_arm<T>(value: T): i32;

/// Whether `arm`'s code is already present — true for every arm of a build
/// that emitted no chunk map.
[extern("__chunk_ready")]
external fun chunk_ready(arm: i32): bool;

/// Fetches `arm`'s chunk and then calls `then` — or `failed` with the reason,
/// which is also reported to the console. A failure is not remembered as in
/// flight, so the next navigation to the arm refetches.
[extern("__chunk_load", retains)]
external fun chunk_load(arm: i32, then: || void, failed: |str| void): void;

/// Starts `arm`'s chunk fetching without waiting for it. Failure is silent
/// here — `chunk_load` has already reported it, and the gate's own load
/// surfaces it on `chunk_error()`.
[extern("__chunk_preload")]
external fun chunk_preload_arm(arm: i32): void;

/// The BOOT PRELOAD (proposal/bundle-splitting.md §S3): start the chunk for
/// `source`'s current value and do not wait. A split build's emitter plants a
/// call to this immediately before the statement that mounts the route swap —
/// the swap is the last call in its view chain, so without it the whole shell
/// subtree is built before the boot route's chunk is even asked for. Declares
/// the same generics as `swap_split`, in the same order, because the emitter
/// rebinds the gate call's type arguments onto it by position. `swap_split`
/// then joins the in-flight fetch this started rather than opening a second
/// one.
export fun chunk_preload<T: PartialEq, S: Source<T>>(source: S) {
	chunk_preload_arm(chunk_arm(source.get()));
}

/// True while a route chunk is being fetched.
export fun chunk_pending(): SignalCell<bool> {
	chunk_pending_signal
}

/// Why the last route chunk fetch failed, or `None`.
export fun chunk_failure(): SignalCell<Option<str>> {
	chunk_error_signal
}

/// Publish a change of the in-flight flag — only a real change, so an ordinary
/// navigation over already-loaded code notifies nothing.
fun set_chunk_pending(busy: bool) {
	if chunk_pending_signal.get() != busy {
		chunk_pending_signal.set(busy);
	}
}

/// Drop a recorded failure — only when there is one, so an ordinary navigation
/// publishes nothing to a view bound to `chunk_error()`.
fun clear_chunk_error() {
	match chunk_error_signal.get() {
		Some(let _reason) => chunk_error_signal.set(None),
		None => {},
	}
}

/// A POSITIONAL REGION: a run of sibling nodes that keeps its place among a
/// parent's other children (A71). Everything reactive in this module owns
/// such a run — `when`'s instantiation, `swap`'s subtree, `each`'s rows,
/// a `Source<View>` child's current view — and before this each of them
/// APPENDED, so the first change moved the run behind whatever static
/// siblings had been added after it.
///
/// The mechanism is one empty text node. `open` appends it at the parent's
/// current end, which is the position the caller is standing at — the `when`
/// / `swap` / `each` call sits in the chain exactly where its content
/// belongs, and a `Slot::place` runs at the `{hole}` it fills. Every later
/// insertion goes BEFORE that anchor, so the run stays put however the
/// parent grows afterwards.
///
/// THE BOUNDARY REMOVES WHAT IT PLACED (A88). A region holds the run that is
/// live in it, and `close` takes the nodes OUT of the document before dropping
/// the anchor. Disposal used to end the subscriptions and leave the DOM alone,
/// on the assumption that a disposed subtree is leaving with its parent — true
/// for a component under its own root, and FALSE for a PORTAL, whose parent
/// outlives the boundary that filled it. kolt's overlay hand-wrote
/// `get_owner().defer(|| live_panel.read()?.remove())` with a comment saying
/// exactly this; that line is what this closes, for every form at once.
///
/// The region does not RECONCILE the run — each form still tracks what it has
/// live and disposes its owners, which is the half the region has no business
/// repeating — it is TOLD the current run (`hold`) after each update, so
/// `close` has the node list without a second copy of the bookkeeping. The
/// cost is one `remove` per live node at disposal, and it is paid only at
/// disposal; a `remove` of a node whose parent already went is a no-op.
///
/// A85 (positional slots) is the design this serves: there, `when(..)` /
/// `swap(..)` / `each(..)` become VALUES that create their region in
/// `Slot::place`, and the parent methods below become one-line sugar over
/// them. Nothing in this order changes a signature.
/// KEEP IN STEP with the process twin's copy (process/ui.vl).
export struct Region {
	anchor: Text,
	live: Shared<List<View>>,
	rows: Shared<List<Row>>,
}

/// One ROW of a region — the unit a reconciler moves, refreshes and removes.
///
/// A row is not an element and not even a fixed set of nodes. Since A91 a
/// render closure may yield any `Slot`, so a row can be a fragment, a text
/// node, or a value form that GROWS after it was placed (a `when` inside a row
/// inserts its body before its own anchor, which no snapshot taken at build
/// time could know about). What IS stable is the row's leading MARKER — an
/// empty text node planted immediately before the row's first node — so a
/// row's extent is "everything after my marker, up to the next boundary", and
/// the next boundary is the next row's marker or the region's own anchor.
///
/// That marker is the one node a row costs beyond its content, and it is the
/// price of a row whose shape is the app's business rather than std's.
/// KEEP IN STEP with the process twin's copy (process/ui.vl), where a row is
/// nothing at all: a server render is one pass in source order, so a row IS
/// wherever it was written.
export struct Row {
	marker: Text,
}

export impl Region {
	/// Opens a region at `parent`'s current end — the caller's position in
	/// the chain.
	fun open(parent: View): Region {
		let anchor = create_text_node("");
		parent.element.append_text(anchor);
		Region { anchor, live = Shared::new([]), rows = Shared::new([]) }
	}

	/// The element the region currently sits in, read off the anchor rather
	/// than remembered.
	///
	/// That is not an economy, it is the correctness condition A91 needs: a
	/// region opened INSIDE a row is built in a detached staging parent and
	/// then planted, and the row is re-inserted on every order pass — so a host
	/// captured at `open` would be a parent the content has since left, and a
	/// `when` inside a row would go on toggling into a fragment nobody can see.
	/// The anchor IS the region's identity; wherever it is, that is where the
	/// region's content belongs.
	fun host(self): Element {
		self.anchor.parent_element()
	}

	/// Puts `child` at the end of the region, before the anchor. A child that
	/// is already in the document MOVES, which is what makes this the order
	/// pass for a reconciled run as well as the insert for a fresh one.
	fun insert(self, child: View) {
		self.host().insert_before(child.element, self.anchor);
	}

	/// Places `content` as a NEW ROW at the end of the region, and returns the
	/// handle the reconciler moves it by (A91).
	fun open_row<C: Slot>(self, content: C): Row {
		self.open_row_before(content, self.anchor)
	}

	/// Places `content` as a new row immediately BEFORE `end` — the marker of
	/// the row it must precede, or this region's own anchor for the end of the
	/// run (A98). `open_row` is this at the anchor.
	///
	/// The content is built into a detached fragment first and planted whole.
	/// That is not an optimisation: `Slot::place` appends to the parent it is
	/// handed, and appending to the real parent would land the row AFTER the
	/// region's anchor. A fragment is a parent whose end is the row's own end,
	/// so a nested region's anchor goes down inside the row, the row's later
	/// growth stays inside it, and one `insert_before` puts the finished run
	/// where the marker says.
	/// KEEP IN STEP with the process twin's copy (process/ui.vl).
	fun open_row_before<C: Slot>(self, content: C, end: Text): Row {
		let marker = create_text_node("");
		self.host().insert_text_before(marker, end);
		let staging = create_document_fragment();
		content.place(View { element = staging });
		self.host().insert_before(staging, end);
		Row { marker }
	}

	/// Takes the row's CURRENT nodes out of the document, as a fragment.
	///
	/// `end` is whatever bounds the row on the right in the document order
	/// being read — the next row's marker, or this region's anchor for the
	/// last row. The marker itself stays where it is, so a whole run can be cut
	/// row by row before anything moves: every boundary is still meaningful.
	fun cut_row(self, row: Row, end: Text): Element {
		let range = create_range();
		range.set_start_after(row.marker);
		range.set_end_before(end);
		range.extract_contents()
	}

	/// Puts a cut row back immediately BEFORE `end`: its marker first, then its
	/// nodes. Re-inserting the marker MOVES it, so this is the order pass — the
	/// per-row `insert` of a run whose rows are single elements, widened to a
	/// run of any shape.
	///
	/// `end` is the marker of the next row the order pass is NOT moving, or the
	/// region's anchor when there is none after this one (A98). Before A98
	/// every row was re-inserted at the anchor, in the new order, which is the
	/// same answer and costs a move per row whether or not the row went
	/// anywhere.
	/// KEEP IN STEP with the process twin's copy (process/ui.vl).
	fun insert_row(self, row: Row, content: Element, end: Text) {
		self.host().insert_text_before(row.marker, end);
		self.host().insert_before(content, end);
	}

	/// Drops a row that is going away: its content has already been cut out,
	/// so what is left is the marker.
	fun drop_row(self, row: Row) {
		row.marker.remove();
	}

	/// Records the run that is live in this region, for `close` to remove
	/// (A88). Every form calls it wherever it already writes its own live
	/// bookkeeping — after the order pass, after an instantiation, after a
	/// swap — so the two can never disagree; an empty run is the right answer
	/// for a `when` that is off.
	///
	/// Two spellings, and they are never both non-empty: `hold` is for the
	/// three reactive CHILD arms, which place exactly the views they were
	/// handed and so cost no marker, and `hold_rows` is for the forms whose
	/// content is a `Slot` of the app's choosing (A91).
	fun hold(self, live: List<View>) {
		self.live.write() = live;
	}

	/// Records the ROWS that are live in this region, for `close` (A91).
	fun hold_rows(self, rows: List<Row>) {
		self.rows.write() = rows;
	}

	/// Takes the region out of the document: every live node, then the
	/// anchor (A88). Called from the `defer` each form registers with the
	/// enclosing boundary, so the content and the marker die with it rather
	/// than outliving it in a parent that survives.
	///
	/// A row is cut by its span rather than removed node by node, for the
	/// reason `Row` records: whatever a row's `Slot` placed, and whatever it
	/// grew afterwards, lies between its marker and the next boundary.
	fun close(self) {
		for view in self.live.read() {
			view.element.remove();
		}
		self.live.write() = [];
		let rows = self.rows.read();
		mut at = 0;
		for row in rows {
			let end = if at + 1 < rows.len() { rows[at + 1].marker } else { self.anchor };
			let _cut = self.cut_row(row, end);
			self.drop_row(row);
			at += 1;
		}
		self.rows.write() = [];
		self.anchor.remove();
	}
}

/// Something that can fill a child position (proposal/element-syntax.md §5) —
/// the type-directed half of `child`: the value's type carries the
/// static-vs-tracked distinction, and ordinary trait dispatch decides what
/// lands in the DOM.
///
/// THE CHILD CONTRACT (B268), six arms in three pairs — a `str`, a `View`, a
/// `List<View>`, and a `Source` of each. The static arm places once; the
/// reactive arm places and REPLACES, owning its own re-render under the nearest
/// boundary. That pairing is the whole rule: whatever may be a child statically
/// may be a child reactively, and `{expr}` in element syntax means the same
/// thing either way.
///
/// The trait keeps the name `Slot` rather than becoming a `Child`: it already
/// IS this contract — the arms grew, the trait did not change — `Child` is
/// taken on the process twin (the `enum Child` `render` walks), and every doc
/// page and generic helper in the estate spells the bound `Slot` today.
/// KEEP IN STEP with the process twin's copy (process/ui.vl).
export trait Slot {
	fun place(self, parent: View);
}

/// A child element.
export impl View with Slot {
	fun place(self, parent: View) {
		parent.element.append(self.element);
	}
}

/// A static text node.
export impl str with Slot {
	fun place(self, parent: View) {
		parent.element.append_text(create_text_node(self));
	}
}

/// A reactive text node — re-set whenever the source changes: `bind_text`
/// scoped to one node instead of the whole element. Registers with the
/// nearest enclosing boundary, like every binding.
///
/// A BLANKET over the read trait (B158/B165): every `Source<str>` places
/// reactively — a cell, a derived signal, a `RemoteSource`, a user's own
/// mirror — and `str`'s own impl outranks it by the specificity order wherever
/// both would match.
export impl type S: Source<str> with Slot {
	fun place(self, parent: View) {
		let node = create_text_node("");
		parent.element.append_text(node);
		// A88: the boundary removes what it PLACED. This arm has no region —
		// one text node is its whole run — so it takes that node out itself.
		// The three STATIC arms take no such defer, deliberately: a static
		// child's lifetime is its parent element's, and it was placed while
		// the caller was building that parent, not by a boundary.
		get_owner().defer(|| node.remove());
		self.effect(|value| {
			node.set_text(value);
		});
	}
}

/// Several child elements, in order — a STATIC run, placed once. This is the
/// arm a fragment literal would walk through (A46): its type is `List<View>`,
/// and a list already fills a child position.
export impl List<View> with Slot {
	fun place(self, parent: View) {
		for item in self {
			parent.element.append(item.element);
		}
	}
}

/// A reactive ELEMENT child — the view the source holds, replaced whenever it
/// changes. `swap`'s shape without `swap`'s render closure: the source's value
/// IS the new subtree, so there is nothing to build, only the previous element
/// to remove and the new one to append.
///
/// This is what `{signal}` means when the signal carries a `View`. It used to
/// mean the text arm below — a `Signal<View>` reached the `Source<str>` blanket
/// because a bound's ARGUMENTS were dropped when an impl was matched to a
/// receiver — and the DOM took the view's runtime shape, `[object Object]`
/// (B268; kolt views.vl:543 wrote `swap(signal, |x| view)` to avoid it).
///
/// OWNERSHIP, exactly (proposal/ambient-owner.md §5). The re-render is an
/// ambient `effect`, so the SUBSCRIPTION belongs to the nearest boundary and
/// dies with it: a `{signal}` child inside an `each` row stops replacing
/// anything the moment the row is disposed. What it does NOT own is the views
/// themselves — each arrived already built, under whatever owner was ambient
/// where it was CONSTRUCTED, so a replaced view's own bindings die with that
/// scope and not here. Reach for `swap(source, |value| …)` when each subtree
/// must be built and disposed per value; reach for this when the views are
/// values the app already holds.
///
/// POSITION: the view keeps the `{signal}`'s own place among its siblings
/// (A71). The arm opens a `Region` where it is placed and inserts every
/// replacement before that anchor, so a reactive element child in the middle
/// of a chain stays in the middle — which is what `{expr}` means the same
/// thing either way requires.
export impl type S: Source<View> with Slot {
	fun place(self, parent: View) {
		let region = Region::open(parent);
		let live: Shared<Option<View>> = Shared::new(None);
		// A88: the arm's view and its anchor leave with the boundary. The
		// subscription already dies with it (an ambient `effect`); this is the
		// DOM half, which matters exactly when the parent survives.
		get_owner().defer(|| region.close());
		self.effect(|next: View| {
			match live.read() {
				Some(let previous) => previous.element.remove(),
				None => {},
			}
			region.insert(next);
			region.hold([next]);
			live.write() = Some(next);
		});
	}
}

/// A reactive RUN of element children — the `List<View>` arm's reactive twin,
/// and the door A46's fragment walks through in a `{signal}` hole. The whole
/// run is replaced on every change: every previous element is removed, every
/// new one appended, in order.
///
/// Not a reconciler, deliberately. `each` is the keyed form — it moves
/// surviving rows and rebuilds only what changed, and it is what a list of DATA
/// wants. This one takes a list of VIEWS, which carries no key and no item to
/// compare, so there is nothing to reconcile against; it is the grouping arm,
/// with the same ownership story as the single-view arm above — and, with it,
/// the same `Region`, so the whole run keeps the hole's position (A71).
export impl type S: Source<List<View>> with Slot {
	fun place(self, parent: View) {
		let region = Region::open(parent);
		let live: Shared<List<View>> = Shared::new([]);
		// A88, as for the single-view arm above: the run and its anchor leave
		// with the boundary.
		get_owner().defer(|| region.close());
		self.effect(|next: List<View>| {
			for previous in live.read() {
				previous.element.remove();
			}
			for item in next {
				region.insert(item);
			}
			region.hold(next);
			live.write() = next;
		});
	}
}
// === The positional value forms (A85) ======================================
//
// `when`, `swap`, `each`, `each_values` and `each_by` as VALUES that fill a
// CHILD POSITION, instead of methods that append to a parent. Each is a struct
// holding its source and its closures, and each `impl .. with Slot` opens its
// `Region` (A71) where `place` runs — which is where the `{hole}` sits — so a
// conditional or a keyed run reads as one child among its siblings:
//
//     <ul>{header}{each(items, key, row)}{when(more, || footer_row())}</ul>
//
// They are the WHOLE surface (A99). The five `View` methods that used to be
// one-line sugar over them — `when`, `swap`, `swap_split`, `bind_each`,
// `bind_each_values`, `bind_each_by` — are retired: a method's content always
// landed at the parent's current end, which is the one thing a positional slot
// exists not to do. Write the value in a child hole where it belongs, or hand
// it to `child` (`parent.child(each(..))`) for the parent's current end, which
// is byte-for-byte what the method did.
//
// THE CLOSURES ARE FIELDS, not type parameters (positional-slots.md §3a), and
// that is load-bearing: a helper returning one of these has to be able to NAME
// the type (`fun account(): Conditional<SignalCell<bool>>`), and a type
// parameterized by a closure's own type is unnameable. A body field carries its
// `context` clause (B309) WITHOUT the `sync` marker — `sync` is parameter-only
// by design (it refuses an async ARGUMENT, and a plain closure field already
// refuses an async store) — so each constructor below takes the marked closure
// as a PARAMETER and lands it in the unmarked field. The clause is what makes
// §3e's "ownership unchanged" true: the body answers to the owner ambient at
// `place`, not to whichever one happened to be ambient where the value was
// BUILT (a plain closure field captures at CREATION — measured, and pinned as
// this one's control).
// KEEP IN STEP with the process twin's copy (process/ui.vl).

/// Conditional content as a child — the `when` slot value (A85/A99).
export struct Conditional<S: Source<bool>, C: Slot> {
	condition: S,
	body: (|| C) context owner_scope,
}

/// A dynamic subtree as a child — the `swap` slot value (A85/A99).
///
/// `gated`, `armed` and `wire` are the ROUTE GATE's, not a user's
/// (proposal/bundle-splitting.md §2): a `split = true` build's recognizer
/// retargets the recognized `swap(route, |current| match current { .. })` call
/// to `swap_split` below, which BUILDS the gate — a cell that does not advance
/// until the arm's code has landed, and the closure that drives it — and
/// `place` runs that closure under the boundary the hole sits in.
///
/// The gate travels as a closure FIELD rather than being wired at construction
/// for two reasons, both load-bearing. (1) The retargeted call must have the
/// same emitted shape as the call it replaces, hidden context arguments
/// included; a `swap_split` that subscribed at construction would be a
/// needs-context node where `swap` is not, and the emitted call would arrive
/// one argument short. (2) `place` then names nothing chunk-shaped — an
/// ordinary build constructs `wire = || {}` and the whole machinery stays
/// unreferenced, which is what keeps a flagless build emitting what it always
/// did (§4).
export struct Swap<T: PartialEq, S: Source<T>, C: Slot> {
	source: S,
	render: (|T| C) context owner_scope,
	gated: Option<SignalCell<T>>,
	armed: Shared<bool>,
	wire: (|| void) context owner_scope,
}

/// A keyed reactive run as a child — the `each` slot value (A85/A99).
export struct Each<T: PartialEq, K: PartialEq, S: Source<List<T>>, C: Slot> {
	source: S,
	key: |T| K,
	render: (|T| C) context owner_scope,
}

/// A run keyed by the ITEM ITSELF, as a child (A42).
export struct EachValues<T: PartialEq, S: Source<List<T>>, C: Slot> {
	source: S,
	render: (|T| C) context owner_scope,
}

/// A run whose rows update through a cell, as a child (A42).
export struct EachBy<T, K: PartialEq, S: Source<List<T>>, C: Slot> {
	source: S,
	key: |T| K,
	render: (|SignalCell<T>| C) context owner_scope,
}

/// Conditional CONTENT at THIS position: while `condition` is true the body's
/// view is mounted under a fresh owner; when it turns false the owner is
/// disposed and the content removed. Write it in a child hole when the
/// conditional is one child among siblings, or `parent.child(when(..))` when it
/// belongs at the parent's current end (A99 retired the `View::when` method).
export fun when<S: Source<bool>, C: Slot>(
	condition: S,
	body: (sync || C) context owner_scope,
): Conditional<S, C> {
	Conditional { condition, body }
}

/// The dynamic subtree at THIS position: whenever `source` CHANGES the previous
/// subtree is disposed and `render` builds the new one under a fresh owner.
/// Write it in a child hole, or `parent.child(swap(..))` at the parent's current
/// end (A99 retired the `View::swap` method).
export fun swap<T: PartialEq, S: Source<T>, C: Slot>(
	source: S,
	render: (sync |T| C) context owner_scope,
): Swap<T, S, C> {
	Swap { source, render, gated = None, armed = Shared::new(true), wire = || {} }
}

/// `swap`, gated on the route's chunk — what the split recognizer retargets a
/// recognized `swap` VALUE to (`chunks.rs`). It declares the same generics in
/// the same ORDER as `swap`, because the gate rebinds the call's type arguments
/// by position. An app never writes it.
///
/// A99 folded `split_route` back into this function. The third name existed
/// only because `View::swap_split` — a method — could not call the free
/// `swap_split` from inside its own `impl` block, where that name was the
/// method; the method is gone, so nothing shadows this one and the gate lives
/// under the name the recognizer already looks for.
///
/// The gate is BUILT here and RUN at `place`, so `place` names nothing
/// chunk-shaped: a build that did not ask to split never reaches this function,
/// and none of the machinery below is emitted at all. Nothing subscribes here,
/// deliberately: the retargeted call must have the same emitted shape as the
/// `swap` call it replaces, hidden context arguments included, and a
/// needs-context `swap_split` standing in for a context-free `swap` would
/// arrive one argument short.
export fun swap_split<T: PartialEq, S: Source<T>, C: Slot>(
	source: S,
	render: (sync |T| C) context owner_scope,
): Swap<T, S, C> {
	let gated: SignalCell<T> = SignalCell::new(source.get());
	// `place` renders nothing until the gate has advanced at least once: on
	// boot the route's chunk may still be in flight, and the arm's code is not
	// there to build with.
	let armed: Shared<bool> = Shared::new(false);
	let generation: Shared<i32> = Shared::new(0);
	// The clause is written out so the NEED does not leak into this function's
	// own signature: `advance` writes a signal, which wants the ambient turn,
	// and a `swap_split` that took one would be a wider emitted shape than the
	// `swap` call the gate replaces. Every call below stands in a turn.
	let advance: (|T| void) context turn_scope = |value: T| {
		armed.write() = true;
		gated.set(value);
	};
	// Built here, RUN at `place`: the closure carries only the owner clause, so
	// this function needs no context of its own and the retargeted call keeps
	// the emitted shape of the `swap` call it replaces.
	//
	// Each navigation opens ITS OWN turn — the gate's writes (the pending flag,
	// the gated route) settle as one wave, exactly as the two chunk-arrival
	// continuations below have always done, and exactly as an event handler's
	// would. Threading an ambient turn in from the build instead is what made
	// this function a context node, which the gate cannot afford.
	let wire: (|| void) context owner_scope = || {
		source.effect(|value: T| turn(FlushPolicy::AtSuspension, || {
			// Claim this navigation's generation before anything can await, so
			// a continuation can tell whether it is still the latest.
			let mine = generation.read() + 1;
			generation.write() = mine;
			clear_chunk_error();
			let arm = chunk_arm(value);
			if chunk_ready(arm) {
				// Navigating BACK to loaded code while something is in flight
				// ends the wait: that fetch has just been superseded, and its
				// arrival is dropped by the generation guard below.
				set_chunk_pending(false);
				advance(value);
			} else {
				set_chunk_pending(true);
				chunk_load(arm, || turn(FlushPolicy::AtSuspension, || {
					if generation.read() == mine {
						set_chunk_pending(false);
						advance(value);
					}
				}), |reason: str| turn(FlushPolicy::AtSuspension, || {
					if generation.read() == mine {
						set_chunk_pending(false);
						chunk_error_signal.set(Some(reason));
					}
				}));
			}
		}));
	};
	Swap { source, render, gated = Some(gated), armed, wire }
}

/// A keyed reactive run at THIS position — one row per element, in a child hole.
///
/// Named `each` and not `bind_each`: the `bind_` prefix means "one property
/// kept in sync" on every other method in this module, and a value that IS a
/// child has no property to bind. `{each(items, key, row)}` reads as markup
/// where `{bind_each(..)}` read as a setter that had escaped — which is why A99
/// retired the method and left the value form alone.
export fun each<T: PartialEq, K: PartialEq, S: Source<List<T>>, C: Slot>(
	source: S,
	key: sync |T| K,
	render: (sync |T| C) context owner_scope,
): Each<T, K, S, C> {
	Each { source, key, render }
}

/// A run keyed by the ITEM ITSELF, as a child (A42).
export fun each_values<T: PartialEq, S: Source<List<T>>, C: Slot>(
	source: S,
	render: (sync |T| C) context owner_scope,
): EachValues<T, S, C> {
	EachValues { source, render }
}

/// A run whose rows update through a cell, as a child (A42).
export fun each_by<T, K: PartialEq, S: Source<List<T>>, C: Slot>(
	source: S,
	key: sync |T| K,
	render: (sync |SignalCell<T>| C) context owner_scope,
): EachBy<T, K, S, C> {
	EachBy { source, key, render }
}

export impl Conditional<type S: Source<bool>, type C: Slot> with Slot {
	fun place(self, parent: View) {
		// The body lands at THIS position among the parent's children (A71),
		// not at the end: the hole sits where the conditional content belongs,
		// so a `when` between two static siblings toggles on between them
		// however the chain continues afterwards.
		let region = Region::open(parent);
		let live_row: Shared<Option<Row>> = Shared::new(None);
		let live_owner: Shared<Option<Owner>> = Shared::new(None);
		// Live content dies with the enclosing boundary, and the anchor with
		// it.
		get_owner().defer(|| {
			live_owner.read()?.dispose();
			region.close();
		});
		self.condition.effect(|on| {
			if on {
				match live_row.read() {
					Some(let _present) => {},
					None => {
						let owner = Owner::new();
						// The body's own owner is established HERE, at the
						// call — the clause on the field is what carries the
						// requirement this far (B309) — and the PLACE runs
						// under it too, so whatever the body's `Slot` registers
						// (a nested region's `defer`, above all) dies with the
						// instantiation rather than with the enclosing
						// boundary (A91).
						let row = run_with_owner(owner, || region.open_row((self.body)()));
						region.hold_rows([row]);
						live_row.write() = Some(row);
						live_owner.write() = Some(owner);
					},
				}
			} else {
				match live_row.read() {
					Some(let row) => {
						live_owner.read()?.dispose();
						// The instantiation is a ROW, not an element: its body
						// may be a fragment, a text node or a value form that
						// grew after it was placed, so it leaves by its span.
						let _cut = region.cut_row(row, region.anchor);
						region.drop_row(row);
						region.hold_rows([]);
						live_row.write() = None;
						live_owner.write() = None;
					},
					None => {},
				}
			}
		});
	}
}

export impl Swap<type T: PartialEq, type S: Source<T>, type C: Slot> with Slot {
	fun place(self, parent: View) {
		// The route gate, when there is one — a no-op closure otherwise. It runs
		// under the boundary this hole sits in, so its subscription dies with
		// everything else `place` registers.
		(self.wire)();
		match self.gated {
			Some(let gated) => place_swap(parent, gated, self.render, self.armed),
			None => place_swap(parent, self.source, self.render, self.armed),
		}
	}
}

export impl Each<type T: PartialEq, type K: PartialEq, type S: Source<List<T>>, type C: Slot> with Slot {
	fun place(self, parent: View) {
		place_each(parent, self.source, self.key, self.render);
	}
}

export impl EachValues<type T: PartialEq, type S: Source<List<T>>, type C: Slot> with Slot {
	fun place(self, parent: View) {
		place_each(parent, self.source, |item| item, self.render);
	}
}

export impl EachBy<type T, type K: PartialEq, type S: Source<List<T>>, type C: Slot> with Slot {
	fun place(self, parent: View) {
		place_each_by(parent, self.source, self.key, self.render);
	}
}

/// `swap`'s body, against a region opened at `parent`'s current end — shared by
/// the `swap` and `swap_split` values. `armed` is the route gate's hold (see
/// `Swap`): `true` for every ordinary swap.
fun place_swap<T: PartialEq, S: Source<T>, C: Slot>(
	parent: View,
	source: S,
	render: (sync |T| C) context owner_scope,
	armed: Shared<bool>,
) {
	// The rendered subtree keeps THIS position among the parent's children
	// (A71): a page container between a header and a footer stays between them
	// across every navigation.
	let region = Region::open(parent);
	let last_value: Shared<Option<T>> = Shared::new(None);
	let live_row: Shared<Option<Row>> = Shared::new(None);
	let live_owner: Shared<Option<Owner>> = Shared::new(None);
	// The live subtree dies with the enclosing boundary, and the anchor with
	// it.
	get_owner().defer(|| {
		live_owner.read()?.dispose();
		region.close();
	});
	source.effect(|value: T| {
		let unchanged = match last_value.read() {
			Some(let previous) => previous == value,
			None => false,
		};
		if armed.read() && !unchanged {
			live_owner.read()?.dispose();
			match live_row.read() {
				Some(let row) => {
					let _cut = region.cut_row(row, region.anchor);
					region.drop_row(row);
				},
				None => {},
			}
			let owner = Owner::new();
			let row = run_with_owner(owner, || region.open_row(render(value)));
			region.hold_rows([row]);
			last_value.write() = Some(value);
			live_row.write() = Some(row);
			live_owner.write() = Some(owner);
		}
	});
}

/// A98: which of `steps` name a row the order pass can LEAVE WHERE IT IS.
///
/// A settled row is one whose previous index reads as part of an INCREASING run
/// across the new order: those rows already stand in the document in their new
/// relative order, so leaving them alone and threading every other row around
/// them (each inserted before the next settled row's marker) produces exactly
/// the new order. Before A98 nothing was settled — every live row was cut by
/// span and re-inserted at the anchor, whether or not it had gone anywhere —
/// which is one `extractContents`, one marker move and one content move per
/// row per pass, for a list that may not have moved at all.
///
/// TWO SCANS, and the better of them wins. A forward greedy run keeps the
/// EARLIEST row of each increasing chain and is optimal when one row moved
/// backward (a row dragged to the end); a backward greedy run keeps the LATEST
/// and is optimal when one row moved forward (a row dragged to the front).
/// Neither is the maximum increasing subsequence — that is a patience sort, and
/// the two scans agree with it on every shape a real list takes (an append, a
/// prepend, a removal at either end, a value refresh, one row moved either way,
/// two rows swapped) and fall short of it only on a reshuffle, where nearly
/// every row has to move whichever set is chosen. `Refresh` and `Fresh` are
/// never settled: both build a row that is not in the document yet.
fun settled_steps(steps: List<RowStep>): List<bool> {
	mut forward: List<bool> = [];
	mut forward_count = 0;
	mut highest = -1;
	for step in steps {
		match step {
			RowStep::Keep(let index) => {
				if index > highest {
					highest = index;
					forward_count += 1;
					forward.push(true);
				} else {
					forward.push(false);
				}
			},
			_ => {
				forward.push(false);
			},
		}
	}
	// The same greedy run read from the end. `lowest` starts above every index
	// (an empty run has nothing to its right), and a row settles when it sits
	// strictly below whatever settled after it — which, read forwards, is the
	// increasing condition again.
	mut backward: List<bool> = [];
	mut backward_count = 0;
	mut lowest = steps.len();
	mut at = steps.len() - 1;
	for at >= 0 {
		match steps[at] {
			RowStep::Keep(let index) => {
				if index < lowest {
					lowest = index;
					backward_count += 1;
					backward.push(true);
				} else {
					backward.push(false);
				}
			},
			_ => {
				backward.push(false);
			},
		}
		at -= 1;
	}
	if forward_count >= backward_count {
		forward
	} else {
		backward.reverse()
	}
}

/// A98: the marker each step must insert BEFORE — the next settled row's
/// marker, or the region's anchor when no settled row follows.
///
/// Read from the end, because the answer for a step is a property of what comes
/// after it. A step that is itself settled still gets an answer (it is never
/// asked for one); what matters is that the answer it CONTRIBUTES is its own
/// marker, for every step to its left.
fun row_references(
	steps: List<RowStep>,
	rows: List<Row>,
	settled: List<bool>,
	anchor: Text,
): List<Text> {
	mut references: List<Text> = [];
	mut reference = anchor;
	mut at = steps.len() - 1;
	for at >= 0 {
		references.push(reference);
		if settled[at] {
			match steps[at] {
				RowStep::Keep(let index) => {
					reference = rows[index].marker;
				},
				_ => {},
			}
		}
		at -= 1;
	}
	references.reverse()
}

/// `each`'s body, against a region opened at `parent`'s current end —
/// shared by `Each`, `EachValues` and, through them, by the two methods.
fun place_each<T: PartialEq, K: PartialEq, S: Source<List<T>>, C: Slot>(
	parent: View,
	source: S,
	key: sync |T| K,
	render: (sync |T| C) context owner_scope,
) {
	// The rows keep THIS position among the parent's children (A71): the hole
	// sits where they belong, so the anchor goes down now and every row is
	// inserted before it.
	let region = Region::open(parent);
	let row_keys: Shared<List<K>> = Shared::new([]);
	let row_items: Shared<List<T>> = Shared::new([]);
	let row_rows: Shared<List<Row>> = Shared::new([]);
	let row_owners: Shared<List<Owner>> = Shared::new([]);
	// Whichever rows are live when the enclosing boundary is disposed go with
	// it, and the anchor goes with them.
	get_owner().defer(|| {
		for owner in row_owners.read() {
			owner.dispose();
		}
		region.close();
	});
	source.effect(|list: List<T>| {
		let plan = reconcile(row_keys.read(), row_items.read(), list, key, |before, after| {
			before == after
		});
		let previous_rows = row_rows.read();
		let previous_owners = row_owners.read();
		// A98: the rows that already stand in their new relative order, and the
		// marker every other row is threaded in before.
		let settled = settled_steps(plan.steps);
		let references = row_references(plan.steps, previous_rows, settled, region.anchor);
		mut staying: List<bool> = [];
		mut fill = 0;
		for fill < previous_rows.len() {
			staying.push(false);
			fill += 1;
		}
		mut settled_at = 0;
		for step in plan.steps {
			if settled[settled_at] {
				match step {
					RowStep::Keep(let index) => {
						staying[index] = true;
					},
					_ => {},
				}
			}
			settled_at += 1;
		}
		// A91's order pass, in two halves. First CUT every live row that is
		// going somewhere, in the order the document holds them: a row's extent
		// runs from its own marker to the next row's, and those boundaries are
		// only meaningful while nothing has moved. A settled row is not cut at
		// all (A98) — it keeps its marker, its nodes and its place — and a
		// `None` in `cut` is exactly "this row did not move".
		mut cut: List<Option<Element>> = [];
		mut at = 0;
		for row in previous_rows {
			if staying[at] {
				cut.push(None);
			} else {
				let end = if at + 1 < previous_rows.len() {
					previous_rows[at + 1].marker
				} else {
					region.anchor
				};
				cut.push(Some(region.cut_row(row, end)));
			}
			at += 1;
		}
		for index in plan.removed {
			previous_owners[index].dispose();
			region.drop_row(previous_rows[index]);
		}
		mut next_rows: List<Row> = [];
		mut next_owners: List<Owner> = [];
		mut position = 0;
		// Then put the moved rows back in the NEW order, each before the next
		// settled row's marker: a kept row is its marker and its cut nodes
		// moved as a unit, a fresh one is placed from scratch at that same
		// point. A settled row is already there and is touched by nothing here.
		for step in plan.steps {
			let item = list[position];
			let reference = references[position];
			match step {
				RowStep::Keep(let index) => {
					match cut[index] {
						Some(let content) => {
							region.insert_row(previous_rows[index], content, reference);
						},
						None => {},
					}
					next_rows.push(previous_rows[index]);
					next_owners.push(previous_owners[index]);
				},
				RowStep::Refresh(let index) => {
					previous_owners[index].dispose();
					region.drop_row(previous_rows[index]);
					let owner = Owner::new();
					next_rows.push(run_with_owner(owner, || {
						region.open_row_before(render(item), reference)
					}));
					next_owners.push(owner);
				},
				RowStep::Fresh => {
					let owner = Owner::new();
					next_rows.push(run_with_owner(owner, || {
						region.open_row_before(render(item), reference)
					}));
					next_owners.push(owner);
				},
			}
			position += 1;
		}
		// A88: the region holds the run it now shows, so a disposal in a parent
		// that survives takes these rows out of the document.
		region.hold_rows(next_rows);
		mut next_keys: List<K> = [];
		for item in list {
			next_keys.push(key(item));
		}
		row_keys.write() = next_keys;
		row_items.write() = list;
		row_rows.write() = next_rows;
		row_owners.write() = next_owners;
	});
}

/// `each_by`'s body, against a region opened at `parent`'s current end.
fun place_each_by<T, K: PartialEq, S: Source<List<T>>, C: Slot>(
	parent: View,
	source: S,
	key: sync |T| K,
	render: (sync |SignalCell<T>| C) context owner_scope,
) {
	// A region at this position, exactly as `place_each` opens one (A71).
	let region = Region::open(parent);
	let row_keys: Shared<List<K>> = Shared::new([]);
	let row_items: Shared<List<T>> = Shared::new([]);
	let row_cells: Shared<List<SignalCell<T>>> = Shared::new([]);
	let row_rows: Shared<List<Row>> = Shared::new([]);
	let row_owners: Shared<List<Owner>> = Shared::new([]);
	// Whichever rows are live when the enclosing boundary is disposed go with
	// it, exactly as `place_each`'s do.
	get_owner().defer(|| {
		for owner in row_owners.read() {
			owner.dispose();
		}
		region.close();
	});
	source.effect(|list: List<T>| {
		// A surviving key is ALWAYS kept: the row's cell carries the new item,
		// so there is nothing for a `Refresh` to rebuild.
		let plan = reconcile(row_keys.read(), row_items.read(), list, key, |_before, _after| {
			true
		});
		let previous_cells = row_cells.read();
		let previous_rows = row_rows.read();
		let previous_owners = row_owners.read();
		// A98, exactly as `place_each` reads it: the rows already in their new
		// relative order stay put, and every other row is threaded in before
		// the next settled row's marker.
		let settled = settled_steps(plan.steps);
		let references = row_references(plan.steps, previous_rows, settled, region.anchor);
		mut staying: List<bool> = [];
		mut fill = 0;
		for fill < previous_rows.len() {
			staying.push(false);
			fill += 1;
		}
		mut settled_at = 0;
		for step in plan.steps {
			if settled[settled_at] {
				match step {
					RowStep::Keep(let index) => {
						staying[index] = true;
					},
					_ => {},
				}
			}
			settled_at += 1;
		}
		// Cut what moves first, in old document order — `place_each`'s two
		// halves, for `place_each`'s reason (A91).
		mut cut: List<Option<Element>> = [];
		mut at = 0;
		for row in previous_rows {
			if staying[at] {
				cut.push(None);
			} else {
				let end = if at + 1 < previous_rows.len() {
					previous_rows[at + 1].marker
				} else {
					region.anchor
				};
				cut.push(Some(region.cut_row(row, end)));
			}
			at += 1;
		}
		for index in plan.removed {
			previous_owners[index].dispose();
			region.drop_row(previous_rows[index]);
		}
		mut next_cells: List<SignalCell<T>> = [];
		mut next_rows: List<Row> = [];
		mut next_owners: List<Owner> = [];
		mut position = 0;
		for step in plan.steps {
			let item = list[position];
			let reference = references[position];
			match step {
				RowStep::Keep(let index) => {
					let cell = previous_cells[index];
					cell.set(item);
					next_cells.push(cell);
					match cut[index] {
						Some(let content) => {
							region.insert_row(previous_rows[index], content, reference);
						},
						None => {},
					}
					next_rows.push(previous_rows[index]);
					next_owners.push(previous_owners[index]);
				},
				// Unreachable: `same` above is constantly true, so `reconcile`
				// never refreshes here. Kept in step with `Keep` rather than
				// left to rot differently.
				RowStep::Refresh(let index) => {
					let cell = previous_cells[index];
					cell.set(item);
					next_cells.push(cell);
					match cut[index] {
						Some(let content) => {
							region.insert_row(previous_rows[index], content, reference);
						},
						None => {},
					}
					next_rows.push(previous_rows[index]);
					next_owners.push(previous_owners[index]);
				},
				RowStep::Fresh => {
					let cell: SignalCell<T> = SignalCell::new(item);
					let owner = Owner::new();
					next_cells.push(cell);
					next_rows.push(run_with_owner(owner, || {
						region.open_row_before(render(cell), reference)
					}));
					next_owners.push(owner);
				},
			}
			position += 1;
		}
		// A88: the region holds the run it now shows, so a disposal in a parent
		// that survives takes these rows out of the document.
		region.hold_rows(next_rows);
		mut next_keys: List<K> = [];
		for item in list {
			next_keys.push(key(item));
		}
		row_keys.write() = next_keys;
		row_items.write() = list;
		row_cells.write() = next_cells;
		row_rows.write() = next_rows;
		row_owners.write() = next_owners;
	});
}

/// Something that can fill an attribute value (proposal/element-syntax.md §5).
/// This is what `<div name(value)>` desugars through — element syntax builds
/// `.attr(name, value)`, never `.bind_attr` — so the arms below are exactly the
/// element-syntax attribute vocabulary. The tracked arm is a BLANKET over
/// `Source<str>` (B158/B165), so any reactive value fills an attribute.
/// KEEP IN STEP with the process twin's copy (process/ui.vl).
export trait AttrValue {
	fun apply(self, parent: View, name: str);
}

/// Set once.
export impl str with AttrValue {
	fun apply(self, parent: View, name: str) {
		parent.element.set_attribute(name, self);
	}
}

/// Set and track — exactly `bind_attr`, for every `Source<str>`.
export impl type S: Source<str> with AttrValue {
	fun apply(self, parent: View, name: str) {
		let element = parent.element;
		self.effect(|value| {
			element.set_attribute(name, value);
		});
	}
}

/// Whether a host value is JS `null`/`undefined` — the one peek this module
/// needs at `get_element_by_id`'s result. `get_element_by_id` (`browser/dom.vl`)
/// has no `Option` return, so a missing id reads back as `null` typed as
/// `Element`; giving IT an `Option<Element>` signature is a wider API question
/// (A24, fullstack-dx.md §9.5) deliberately NOT taken here — this is a private
/// guard at the mount seam alone.
export [extern("__is_null")]
external fun is_null(value: Element): bool;

/// The lookup `mount`/`mount_root` share: fails loud, naming the id, instead
/// of leaving `element.clear()` below to throw "Cannot read properties of
/// null" with the wrong id nowhere in the message (A24, fullstack-dx.md
/// §9.5 — "the cheapest loud win in the whole survey"). The happy path is
/// unchanged: an existing id resolves exactly as `get_element_by_id` already
/// did.
fun mount_target(id: str): Element {
	let element = get_element_by_id(id);
	if is_null(element) {
		panic(i"mount: no element with id '{id}'");
	}
	element
}

/// Attach a view to the page element with the given id — CLEARING the container
/// first (`replaceChildren`) so the freshly built UI REPLACES whatever was there
/// (proposal/ssr.md §1 step 3). A no-op for the empty container every client app
/// mounts into today; on a server-rendered page it discards the server markup and
/// mounts the live tree in its place. Render, then replace — no adoption.
export fun mount(id: str, view: View) {
	let element = mount_target(id);
	element.clear();
	element.append(view.element);
}

/// Mount a component ROOT: the body builds under a fresh ambient owner (the
/// root boundary — every binding inside registers into it) and the view is
/// attached. Returns the root owner; most apps let it live forever.
export fun mount_root(id: str, body: (sync || View) context owner_scope): Owner {
	// The initial build is a turn boundary too: bindings created during
	// mount settle as one wave instead of notifying per-`set`.
	let (built, root) = turn(FlushPolicy::AtSuspension, || comp(body));
	mount(id, built);
	// HMR (`hmr.md` §3, step 2): before the next bundle mounts, dispose the root
	// owner (so every subscription under it dies) and clear the container element
	// (so the old DOM is gone). A no-op without a dev shim — the closure isn't
	// even built in a production run.
	if hmr_active() {
		let element = get_element_by_id(id);
		on_teardown(|| {
			root.dispose();
			element.clear();
		});
	}
	root
}
