// `std::dom` — the browser (DOM) platform layer: a minimal binding to the host
// document, elements, and events. Only available when building for the browser
// (`vilan build --target browser`).
//
// An `Element` is an opaque handle to a live DOM node — like `Shared`, it is a
// reference, not a value: methods mutate the node in place and binding/passing it
// shares the one node rather than snapshotting it.

import pkg::compare::Ord;
import pkg::option::Option::{ None, Some };
import pkg::reactive::Subscription;

export *;

external struct Element;

/// `document.getElementById(id)` — the element with that id (the mount point a
/// page provides, e.g. `<div id="app">`).
[extern("document.getElementById")]
external fun get_element_by_id(id: str): Element;

/// `document.createElement(tag)` — a fresh, unattached element of that tag.
[extern("document.createElement")]
external fun create_element(tag: str): Element;

/// `document.createElementNS(namespace, tag)` — a fresh element in an explicit
/// namespace. SVG elements must be created this way: `createElement` produces
/// an HTML-namespace node whatever the tag says, and an HTML-namespace `<svg>`
/// renders nothing. `std::ui::view` routes SVG tag names here by itself.
[extern("document.createElementNS")]
external fun create_element_ns(namespace: str, tag: str): Element;

/// `document.createTextNode(content)` — a fresh, unattached text node. Text
/// CHILDREN ride this (`std::ui`'s `child` on a `str` or `SignalCell<str>`): mixed
/// content interleaves text nodes between element children as real siblings,
/// never wrapper spans.
[extern("document.createTextNode")]
external fun create_text_node(content: str): Text;

/// `document.createDocumentFragment()` — an empty, unattached container whose
/// CHILDREN move when it is inserted, leaving it empty. `std::ui` builds a row
/// in one of these and then plants the whole thing with a single
/// `insert_before`, which is how content of an unknown shape (A91: a row may be
/// any `Slot`) reaches a position that is not the parent's end.
///
/// It is typed `Element` and it is not one: the DOM's insertion and append
/// methods take any node, a fragment above all, and giving it a struct of its
/// own would fork `append`/`append_text`/`insert_before` into two copies each
/// for a handle that is only ever a staging area. `get_element_by_id` already
/// spends the same coin (a missing id reads back as `null` typed `Element`).
[extern("document.createDocumentFragment")]
external fun create_document_fragment(): Element;

/// `document.createRange()` — a live span between two boundary points, used
/// here for exactly one job: taking a RUN of sibling nodes out of the document
/// in one call (`extract_contents`).
///
/// A `std::ui` run's rows are delimited by empty text markers, and since A91 a
/// row's node set is not fixed — a row that is itself a `when` or an `each`
/// grows and shrinks after it was placed. So "move this row" cannot be a list
/// of remembered nodes; it is "everything between these two markers", which is
/// what a range names and what nothing else in the DOM does without walking
/// the sibling chain node by node.
[extern("document.createRange")]
external fun create_range(): Range;

/// `document.querySelector(selector)` — the first element matching a CSS selector
/// (e.g. `"#name"`, `".item"`, `"input[name=email]"`).
[extern("document.querySelector")]
external fun query_selector(selector: str): Element;

/// `document.querySelectorAll(selector)` — every element matching a CSS selector,
/// as a `List` (a real array, so `map`/`for`-in/`len` all work).
external fun query_selector_all(selector: str): List<Element>;

/// An element's box in VIEWPORT coordinates — what `Element::bounding_rect`
/// measures, and the one thing in this module that is a VALUE rather than a
/// handle. That is deliberate: a measurement is a fact about a moment, so it
/// copies, compares, and can be parked in a signal, where a live host rect
/// would keep changing under whoever held it.
///
/// The host's `DOMRect` carries `right`/`bottom` too; they are `left + width`
/// and `top + height`, so they are methods here rather than fields that could
/// disagree with the pair they are derived from.
struct DomRect {
	/// Distance from the viewport's left edge to the box's left edge.
	left: f64,
	/// Distance from the viewport's top edge to the box's top edge.
	top: f64,
	/// The box's width, borders included; fractional, unlike `offset_width`.
	width: f64,
	/// The box's height, borders included.
	height: f64,
}

impl DomRect {
	/// The box's right edge (`left + width`).
	fun right(self): f64 {
		self.left + self.width
	}

	/// The box's bottom edge (`top + height`).
	fun bottom(self): f64 {
		self.top + self.height
	}
}

/// The host `ResizeObserver` — the raw class, in the same relation to
/// `Element::observe_resize` that `on_event`/`off_event` are to `listen`: it is
/// what the wrapper is built on, and reaching for it means holding the
/// disconnect yourself. An observer the host holds a callback for outlives
/// every vilan value that mentions it until `disconnect` runs, so an
/// unmanaged one is a leak by construction.
external struct ResizeObserver;

impl ResizeObserver {
	/// `new ResizeObserver(callback)`. The host calls `callback` once when
	/// observation of an element begins and again on every size change; it
	/// carries no argument here, because the element whose size changed is the
	/// one the caller passed to `observe`.
	[extern(new, "ResizeObserver", retains)]
	external fun new(callback: || void): ResizeObserver;

	/// `observer.observe(target)` — start watching `target`'s size.
	[extern(method, "observe")]
	external fun observe(self, target: Element): void;

	/// `observer.disconnect()` — stop watching everything. Idempotent in the
	/// host, which is what lets `observe_resize`'s `Subscription` be disposed
	/// twice safely.
	[extern(method, "disconnect")]
	external fun disconnect(self): void;
}

/// `requestAnimationFrame(callback)` — run `callback` before the next rendering
/// step (backlog B271).
///
/// The browser twin of `std::reactive`'s `queue_microtask`, and it lives HERE
/// rather than beside it because it is a browser API: node has a microtask
/// queue and no frames, and `std::reactive` is the layer both targets share.
///
/// The difference is the whole reason this exists. A microtask runs before the
/// rendering step, so layout, style resolution and every observer that reacts
/// to them (`ResizeObserver`, `IntersectionObserver`) have not happened yet; a
/// frame callback runs after the previous rendering step, so what those made
/// visible is visible. Anything whose precondition is "rendered" — focus, a
/// measurement, a scroll into view — belongs on this clock and not on a timer.
[extern("requestAnimationFrame", retains)]
external fun request_animation_frame(callback: || void);

impl Element {
	/// Sets the element's text content (`element.textContent = text`).
	[extern(set, "textContent")]
	external fun set_text(self, text: str): void;

	/// Sets the element's CSS class (`element.className = name`).
	[extern(set, "className")]
	external fun set_class(self, name: str): void;

	/// Sets an attribute (`element.setAttribute(name, value)`).
	[extern(method, "setAttribute")]
	external fun set_attribute(self, name: str, value: str): void;

	/// Removes an attribute (`element.removeAttribute(name)`). The other half
	/// of a BOOLEAN attribute, whose meaning is presence and not value: `inert`,
	/// `disabled`, `hidden`, `open` are on when the attribute is there at all,
	/// so turning one off means taking it away, never setting it to `"false"`.
	/// `View::toggle_attr` is the binding written over this; removing an
	/// attribute that is not there is a no-op, as in the DOM.
	[extern(method, "removeAttribute")]
	external fun remove_attribute(self, name: str): void;

	/// Sets a CSS custom property (`element.style.setProperty(name, value)`) —
	/// the DOM end of the styling system's dynamic-value channel
	/// (proposal/ui-styling.md §2.1).
	[extern(method, "style.setProperty")]
	external fun set_style_property(self, name: str, value: str): void;

	/// One inline CSS property's current value
	/// (`element.style.getPropertyValue(name)`), or `""` when the element
	/// declares none. The read half of `set_style_property`: `View::show`
	/// takes the element's own inline `display` before it starts writing that
	/// slot, so it can put back exactly what it found.
	[extern(method, "style.getPropertyValue")]
	external fun style_property(self, name: str): str;

	/// Appends `child` as the element's last child.
	[extern(method, "appendChild")]
	external fun append(self, child: Element): void;

	/// Appends a text node as the element's last child — the `Text` overload of
	/// `append` (the same `appendChild` binding; the DOM takes any node).
	[extern(method, "appendChild")]
	external fun append_text(self, child: Text): void;

	/// Inserts `child` immediately BEFORE `anchor`, which must be a child of
	/// this element (`element.insertBefore(child, anchor)`) — the positional
	/// counterpart to `append`, and what `std::ui`'s `Region` is built on.
	///
	/// Like `append`, this MOVES a node that is already in the document
	/// rather than copying it, so re-inserting a live element is how a run of
	/// children is re-ordered.
	///
	/// The anchor is a `Text` because that is the marker std plants — an
	/// EMPTY text node, never a comment. The reasons are both about what the
	/// node is worth outside the DOM: an empty text node serializes to
	/// nothing, so a browser tree and the `@process` twin's HTML string stay
	/// byte-comparable (a `<!---->` would not), and the `Source<str>` child
	/// arm has planted empty text nodes since it shipped, so this is the
	/// marker the estate already has rather than a second kind. A comment
	/// would read better in devtools; if hydration ever needs to FIND the
	/// markers in served markup, that is the trade to revisit and the one
	/// argument that would win.
	[extern(method, "insertBefore")]
	external fun insert_before(self, child: Element, anchor: Text): void;

	/// Inserts a text node immediately before `anchor` — the `Text` overload of
	/// `insert_before` (the same `insertBefore` binding; the DOM takes any
	/// node). This is how a run plants and MOVES a row's marker.
	[extern(method, "insertBefore")]
	external fun insert_text_before(self, child: Text, anchor: Text): void;

	/// Removes the element from the document (`element.remove()`).
	[extern(method, "remove")]
	external fun remove(self): void;

	/// Removes every child (`element.replaceChildren()`).
	[extern(method, "replaceChildren")]
	external fun clear(self): void;

	/// Shows or hides the element (`element.hidden = hidden`).
	[extern(set, "hidden")]
	external fun set_hidden(self, hidden: bool): void;

	/// The element's box in VIEWPORT coordinates
	/// (`element.getBoundingClientRect()`) — where an anchored overlay reads
	/// its anchor, and where a drag reads the frame it is dragging inside.
	///
	/// Reading it FORCES LAYOUT, so measure once and pass the `DomRect` value
	/// around rather than re-measuring per field. A DETACHED element measures
	/// 0×0 — ask `is_connected` first, or position on a rect that says the
	/// element is nowhere.
	[extern("__dom_bounding_rect")]
	external fun bounding_rect(self): DomRect;

	/// The element's laid-out width in CSS pixels, borders and scrollbar
	/// included and ROUNDED to an integer (`element.offsetWidth`) — the cheap
	/// measurement beside `bounding_rect`'s fractional box, and the one to
	/// reach for when the question is "how wide is it" rather than "where is
	/// it". 0 for a detached element and for `display: none`.
	[extern(get, "offsetWidth")]
	external fun offset_width(self): f64;

	/// The element's laid-out height (`element.offsetHeight`), rounded exactly
	/// as `offset_width` is.
	[extern(get, "offsetHeight")]
	external fun offset_height(self): f64;

	/// Whether the element is attached to the document (`element.isConnected`).
	///
	/// The guard measurement waits on: a detached element measures 0×0, so
	/// positioning that runs before the node is in the tree positions against
	/// nothing and reads as a bug about the layout rather than about the
	/// timing.
	[extern(get, "isConnected")]
	external fun is_connected(self): bool;

	/// The element's place in the SEQUENTIAL FOCUS ORDER
	/// (`element.tabIndex`) — the DOM's own answer to "is this in the tab
	/// order", and the predicate `tabbable` is written on.
	///
	/// It is the ATTRIBUTE reflected with a PER-TAG DEFAULT, which is what
	/// makes it a whole answer rather than half of one: `-1` for an element
	/// that is not focusable at all (a bare `<div>`), `0` for one that is
	/// natively focusable (`<a href>`, `<button>`, `<input>`, `<select>`,
	/// `<textarea>`, `<summary>`, `[contenteditable]`) or opted in with
	/// `tabindex="0"`, and the written value otherwise. So a focus walk needs
	/// no tag table: the host already has one.
	///
	/// A NEGATIVE value is the opt-out that KEEPS programmatic focus —
	/// `tabindex="-1"` is focusable by `focus()` and skipped by Tab, which is
	/// what `focus_first` writes onto a panel with nothing tabbable inside it.
	[extern(get, "tabIndex")]
	external fun tab_index(self): i32;

	/// The element's parent ELEMENT (`element.parentElement`), or null at the
	/// document's root element — `Text::parent_element`'s twin on an element,
	/// and the step an ancestor walk takes.
	///
	/// `inert` and `hidden` disable a whole SUBTREE, so "can this take focus"
	/// is never a question about one element; it is answered by walking up. A
	/// selector cannot express that honestly — `[inert] *` still misses a
	/// scope root that is itself inside an inert ancestor — which is why
	/// `tabbable` walks (A121).
	[extern(get, "parentElement")]
	external fun parent(self): Element;

	/// Whether the element carries `name` AT ALL
	/// (`element.hasAttribute(name)`) — the read half of a BOOLEAN attribute,
	/// whose meaning is presence and not value, and whose write half is the
	/// `set_attribute` / `remove_attribute` pair. `disabled`, `inert`,
	/// `hidden`, `open`, `controls`: each is on when the attribute is there,
	/// whatever it was set to.
	[extern(method, "hasAttribute")]
	external fun has_attribute(self, name: str): bool;

	/// One RESOLVED CSS property — what the cascade, the inherited
	/// declarations and the user agent's own sheet finally say
	/// (`getComputedStyle(element).getPropertyValue(name)`), where
	/// `style_property` reads only what THIS element declares inline.
	///
	/// The read `visibility: hidden` needs, and the reason it needs one: a
	/// `visibility: hidden` element KEEPS ITS BOX, so `offset_width` and
	/// `offset_height` see it as laid out and only the resolved value says
	/// otherwise. `visibility` INHERITS, so the resolved value answers for a
	/// hidden ANCESTOR too, with no walk of its own.
	///
	/// It FORCES LAYOUT, exactly as `bounding_rect` does, and costs more than
	/// an attribute read — ask it last, of the elements a cheaper predicate
	/// has already kept.
	[extern("__dom_computed_style")]
	external fun computed_style(self, name: str): str;

	/// Whether `other` IS this element or lies inside it
	/// (`element.contains(other)`).
	///
	/// The outside-click question: a dismiss handler asks it of the event's
	/// `target` — "did this click land in my panel" — which is the one question
	/// a document-level listener cannot answer from coordinates.
	[extern(method, "contains")]
	external fun contains(self, other: Element): bool;

	/// Every DESCENDANT matching a CSS selector
	/// (`element.querySelectorAll(selector)`), as a `List` — the scoped form of
	/// the module-level `query_selector_all`, which searches the whole
	/// document. A real array like its document twin, so `map`/`for`-in/`len`
	/// all work; empty when nothing matches, which is why it is the list form
	/// and not a nullable one.
	[extern("__dom_query_all")]
	external fun query_selector_all(self, selector: str): List<Element>;

	/// Moves keyboard focus to the element (`element.focus()`). HTML's
	/// `autofocus` attribute only fires on a document's initial parse, so
	/// anything mounted later — every custom modal — has to ask; this is what
	/// `View::autofocus` calls.
	///
	/// It is a REQUEST with a precondition, not a command: the platform focuses
	/// only a target that is connected, rendered, visible and not inert AT THE
	/// CALL, and silently does nothing otherwise. `visibility: hidden` refuses;
	/// so does a `display: none` ancestor, and so does an `inert` subtree. "Just
	/// created" is never the problem — `View::on_mount` already guarantees the
	/// element is in the document — "still hidden" is.
	[extern(method, "focus")]
	external fun focus(self): void;

	/// Whether the element matches a CSS selector (`element.matches(selector)`).
	///
	/// `matches(":focus")` is how a caller asks whether a `focus()` was HONORED,
	/// which the void-returning `focus` cannot say. It is `document.activeElement
	/// === element` in the selector engine's own vocabulary, and unlike a
	/// document-level read it needs no handle comparison between two opaque
	/// `Element`s.
	[extern(method, "matches")]
	external fun matches(self, selector: str): bool;

	/// The element's current value (`element.value`) — e.g. what the user has
	/// typed into an `<input>`.
	[extern(get, "value")]
	external fun value(self): str;

	/// Sets the element's value (`element.value = value`).
	[extern(set, "value")]
	external fun set_value(self, value: str): void;

	/// Registers `handler` to run on `event` (e.g. `"click"`, `"input"`).
	[extern(method, "addEventListener", retains)]
	external fun on(self, event: str, handler: || void): void;

	/// Like `on`, but the handler receives the `Event` — for `prevent_default`,
	/// modifier keys, and anything else on the event object. The same
	/// `addEventListener` binding; the host always passes the event, `on` just
	/// ignores it.
	[extern(method, "addEventListener", retains)]
	external fun on_event(self, event: str, handler: |Event| void): void;

	/// `element.removeEventListener(event, handler)` — `listen`'s teardown.
	/// Removal is IDENTITY-matched: `handler` must be the same value the host
	/// was handed, so a freshly written closure removes nothing. `listen` is the
	/// form that holds the pairing for you; reach for this only when you already
	/// hold both halves. Unmarked by `retains` deliberately — removal keeps
	/// nothing past the call (`proposal/router.md` §5.2).
	[extern(method, "removeEventListener")]
	external fun off_event(self, event: str, handler: |Event| void): void;

	/// Registers `handler` on `event` and hands back the `Subscription` that
	/// unhooks it — the REMOVABLE form of `on_event` (`proposal/router.md`
	/// §5.2). `on`/`on_event` are fire-and-forget: an element listener dies with
	/// its element, which is usually the whole answer. `listen` is for the rest —
	/// a listener that must stop before its target does.
	///
	/// `[must_use]` exactly as `Source::sub` is, and ownership is the caller's
	/// exactly as `sub`'s is: hand it to a scope with
	/// `get_owner().take(element.listen(..))`, or `dispose` it by hand. Disposing
	/// twice is safe.
	[must_use]
	fun listen(self, event: str, handler: |Event| void): Subscription {
		self.on_event(event, handler);
		Subscription::teardown(|| {
			self.off_event(event, handler);
		})
	}

	/// `element.addEventListener(event, handler, true)` — the CAPTURE-phase
	/// registration. `listen_capture` is the form that holds the pairing;
	/// this and its `off` twin are the raw halves, exactly as
	/// `on_event`/`off_event` are for the bubble phase.
	[extern(method, "addEventListener", retains)]
	external fun on_event_capture(self, event: str, handler: |Event| void, capture: bool): void;

	/// `element.removeEventListener(event, handler, true)` — capture's
	/// teardown. The PHASE is part of the identity the host matches on, so a
	/// capture listener cannot be removed by the bubble-phase `off_event` and
	/// vice versa; that is why this is a second pair rather than a flag.
	[extern(method, "removeEventListener")]
	external fun off_event_capture(self, event: str, handler: |Event| void, capture: bool): void;

	/// `listen`, in the CAPTURE phase — same `[must_use]` `Subscription`
	/// contract, opposite direction of travel.
	///
	/// Capture runs the ancestors' listeners on the way DOWN to the target,
	/// before the target's own; bubble runs them on the way back up. Two things
	/// need the downward pass. Events that do not bubble at all — `scroll`,
	/// `focus`, `blur` — are only heard from an ancestor in capture, which is
	/// how an anchored menu hears every scrolling ancestor at once and stays on
	/// its element while the page moves under it. And a listener that must run
	/// BEFORE the target's own (a dismiss guard, a modal's key trap) has to be
	/// in capture, because bubble is by definition too late.
	[must_use]
	fun listen_capture(self, event: str, handler: |Event| void): Subscription {
		self.on_event_capture(event, handler, true);
		Subscription::teardown(|| {
			self.off_event_capture(event, handler, true);
		})
	}

	/// Runs `on_resize` whenever this element's size changes — and ONCE when
	/// observation starts, which is what makes it a first-layout hook as well
	/// as a change hook: an overlay can position itself from the same callback
	/// that will re-position it later, instead of racing the first render.
	///
	/// The wrapper, not the raw `ResizeObserver`, is the form to reach for
	/// (`[must_use]`, and owned exactly as `listen`'s subscription is): hand it
	/// to a scope with `get_owner().take(element.observe_resize(..))`, or
	/// `dispose` it by hand. Disposing disconnects the observer, and disposing
	/// twice is safe.
	[must_use]
	fun observe_resize(self, on_resize: || void): Subscription {
		let observer = ResizeObserver::new(on_resize);
		observer.observe(self);
		Subscription::teardown(|| {
			observer.disconnect();
		})
	}

	/// Whether this element can take SEQUENTIAL focus — whether Tab can reach
	/// it (A121, `proposal/focus-scope.md` §3).
	///
	/// The literature's definition of tabbable is one big selector:
	///
	/// ```text
	/// a[href], area[href], input:not([disabled]), select:not([disabled]),
	/// textarea:not([disabled]), button:not([disabled]), iframe, object,
	/// embed, summary, audio[controls], video[controls], [contenteditable],
	/// [tabindex]
	/// ```
	///
	/// That selector is the DEFINITION and this is the implementation of it,
	/// which is not the same thing. Half of it — every tag in the list — is
	/// what `tab_index` already answers, because the host reflects the
	/// attribute with a per-tag default and knows its own focusable set; and
	/// the half a selector CANNOT answer honestly is the subtree: `inert`,
	/// `hidden` and a closed `<details>` disable everything under them, which
	/// `[inert] *` expresses only approximately and misses entirely when the
	/// element you started from is itself inside an inert ancestor. So the
	/// predicate is read off the element and its ancestors, in cost order:
	///
	/// 1. a negative `tab_index` — the author's opt-out, and every tag that
	///    is not focusable at all;
	/// 2. `disabled`, which keeps its `tabIndex` of 0 and is not tabbable;
	/// 3. an `inert` or `hidden` ANCESTOR, this element included;
	/// 4. a resolved `visibility: hidden`, which INHERITS, so one read
	///    answers for a hidden ancestor too;
	/// 5. a 0x0 box, which is `display: none` — on this element or on any
	///    ancestor, since a hidden subtree lays nothing out.
	///
	/// 4 and 5 are the two that force layout, and they come last for that
	/// reason. What is deliberately NOT here: a scrolled container's
	/// off-screen children are tabbable and stay tabbable — they are laid
	/// out, and only their position is elsewhere.
	fun is_tabbable(self): bool {
		if self.tab_index() < 0 {
			ret false;
		}
		if self.has_attribute("disabled") {
			ret false;
		}
		mut walk = self;
		for !is_null(walk) {
			if walk.has_attribute("inert") || walk.has_attribute("hidden") {
				ret false;
			}
			walk = walk.parent();
		}
		if self.computed_style("visibility") == "hidden" {
			ret false;
		}
		self.offset_width() != 0f || self.offset_height() != 0f
	}

	/// Every tabbable DESCENDANT, in the order Tab visits them (A121).
	///
	/// The order is the part usually got wrong, and it is the reason this
	/// answers a `List` rather than leaving the caller with
	/// `query_selector_all`'s document order: within a subtree, Tab visits
	/// POSITIVE `tabindex` values first in ascending order, then everything
	/// else in document order. That is the HTML specification's sequential
	/// focus navigation order restricted to a subtree, and a positive
	/// `tabindex` is rare enough that a scope which has none pays only the
	/// enumeration.
	///
	/// The enumeration is `query_selector_all("*")` — the UNIVERSAL selector,
	/// which is every descendant element in document order rather than a
	/// predicate — and each one is then asked `is_tabbable`. The ties are
	/// stable, so two elements at `tabindex="2"` keep their document order.
	fun tabbable(self): List<Element> {
		mut positive: List<Element> = [];
		mut natural: List<Element> = [];
		for candidate in self.query_selector_all("*") {
			if candidate.is_tabbable() {
				if candidate.tab_index() > 0 {
					positive.push(candidate);
				} else {
					natural.push(candidate);
				}
			}
		}
		mut ordered = positive.sort_by(|a, b| a.tab_index().compare(b.tab_index()));
		for element in natural {
			ordered.push(element);
		}
		ordered
	}

	/// Move focus to the first tabbable descendant, or — when there is none —
	/// to this element itself, at `tabindex="-1"`. Answers whether the focus
	/// was TAKEN (A121).
	///
	/// The last rung is the one worth reading twice: a `tabindex="-1"`
	/// element is programmatically focusable and NOT tabbable, which is
	/// exactly right for a panel with nothing to focus inside it — focus
	/// lands on the panel, Tab then leaves it in document order, and the
	/// panel never becomes a tab stop of its own. A bare `<div>` without that
	/// attribute is not a focusable area at all, so `focus()` on one is a
	/// silent no-op: this is the fallback every app writes by hand, made to
	/// work.
	///
	/// The answer is a `bool` for `focus()`'s own reason (B271): focusing is
	/// a REQUEST whose precondition is that the target is rendered and
	/// visible at the call, so a caller that runs before layout — a show hook
	/// that fires with the panel still `visibility: hidden` — reads `false`
	/// and asks again on the next frame.
	fun focus_first(self): bool {
		match self.tabbable().get(0) {
			Some(let first) => {
				first.focus();
				first.matches(":focus")
			},
			None => {
				self.set_attribute("tabindex", "-1");
				self.focus();
				self.matches(":focus")
			},
		}
	}
}

/// The host `window` — a listen TARGET, opaque exactly as `Element` is
/// (`proposal/router.md` §5.1). It carries the events no element is given:
/// `resize`, `popstate`, `storage`, `message`, and the pointer stream a drag
/// needs after the pointer has left the element it started on.
external struct Window;

/// The one `window` object (via a helper — a global property has no function
/// form, the same reason `std::router`'s `location.pathname` needs one).
[extern("__dom_window")]
external fun window(): Window;

/// `document.activeElement` — the element that currently has focus, or the
/// document's `<body>` when nothing does. Through a helper for `window()`'s
/// reason: a global PROPERTY has no function form, and the function-extern
/// form addresses only callables.
///
/// Distinct from `Element::matches(":focus")`, and the difference is worth
/// knowing both ways round. `:focus` does not match when the DOCUMENT itself
/// is not focused — another window holds it — while `activeElement` still
/// names the element focus would return to. "Is the focus still MINE?" is
/// `:focus`'s question, asked of one element; "where was focus before I
/// opened?" is this one's, and a scope opened by a keyboard shortcut while
/// the window was unfocused would remember nothing from `:focus`.
[extern("__dom_active_element")]
external fun active_element(): Element;

/// Whether a host handle is JS `null`/`undefined` — the peek the NULLABLE
/// reads in this module need. `get_element_by_id`, `query_selector`,
/// `Element::parent` and `Event::related_target` all answer `null` rather
/// than an `Option` (A24, `fullstack-dx.md` §9.5 — giving them one is a wider
/// API question, deliberately not taken here), and an ancestor walk has to
/// stop somewhere: `parent()` at the document's root element is where.
[extern("__is_null")]
external fun is_null(handle: Element): bool;

impl Window {
	/// Registers `handler` to run on `event` (e.g. `"resize"`, `"popstate"`) —
	/// `Element::on`'s twin on the window, and fire-and-forget in the same way.
	[extern(method, "addEventListener", retains)]
	external fun on(self, event: str, handler: || void): void;

	/// Like `on`, but the handler receives the `Event`.
	[extern(method, "addEventListener", retains)]
	external fun on_event(self, event: str, handler: |Event| void): void;

	/// `window.removeEventListener(event, handler)` — `listen`'s teardown, and
	/// identity-matched exactly as `Element::off_event` is.
	[extern(method, "removeEventListener")]
	external fun off_event(self, event: str, handler: |Event| void): void;

	/// Registers `handler` on `event` and hands back the `Subscription` that
	/// unhooks it. This is the form window listeners actually want: nothing
	/// about the window ever goes away, so a window listener that cannot be
	/// removed is a leak by construction.
	[must_use]
	fun listen(self, event: str, handler: |Event| void): Subscription {
		self.on_event(event, handler);
		Subscription::teardown(|| {
			self.off_event(event, handler);
		})
	}

	/// `window.addEventListener(event, handler, true)` — the raw capture-phase
	/// registration, `Element::on_event_capture`'s twin on the window.
	[extern(method, "addEventListener", retains)]
	external fun on_event_capture(self, event: str, handler: |Event| void, capture: bool): void;

	/// `window.removeEventListener(event, handler, true)` — capture's teardown,
	/// phase-matched exactly as `Element::off_event_capture` is.
	[extern(method, "removeEventListener")]
	external fun off_event_capture(self, event: str, handler: |Event| void, capture: bool): void;

	/// `listen`, in the CAPTURE phase. On the WINDOW this is the form that
	/// hears `scroll` from every scrolling ancestor at once: `scroll` does not
	/// bubble, so a bubble-phase window listener hears only the document's own
	/// scrolling and an anchored overlay drifts off its element the moment the
	/// page's inner panel is what moved.
	[must_use]
	fun listen_capture(self, event: str, handler: |Event| void): Subscription {
		self.on_event_capture(event, handler, true);
		Subscription::teardown(|| {
			self.off_event_capture(event, handler, true);
		})
	}
}

/// A DOM text node — an opaque handle like `Element`, carrying text only: no
/// attributes, no children, no listeners.
external struct Text;

impl Text {
	/// Replaces the node's text (`node.textContent = text`).
	[extern(set, "textContent")]
	external fun set_text(self, text: str): void;

	/// Removes the node from the document (`node.remove()`) — `Element`'s
	/// `remove` for a text node, which is what a `std::ui` `Region` does with
	/// its anchor when the boundary holding it is disposed.
	[extern(method, "remove")]
	external fun remove(self): void;

	/// The node's current parent (`node.parentNode`).
	///
	/// A `std::ui` `Region` reads its host through this rather than
	/// remembering one, because since A91 an anchor MOVES: a region opened
	/// inside a row is built in a detached staging parent and then planted,
	/// and the row itself is re-inserted on every order pass. The anchor is
	/// the region's identity; wherever it is, that is where the region's
	/// content belongs.
	[extern(get, "parentNode")]
	external fun parent_element(self): Element;
}

/// A DOM range — two boundary points in one document, and the one operation
/// `std::ui` needs from them: cut everything between them out as a fragment.
///
/// Both boundaries are `Text` because both are markers std planted: a row's
/// own leading marker and whatever bounds it on the right (the next row's
/// marker, or the region's anchor). A range whose boundaries are not siblings
/// in the order given is not a state this module can reach — the markers are
/// planted by the same code that reads them, in the order it planted them.
external struct Range;

impl Range {
	/// Starts the range immediately after `node` (`range.setStartAfter(node)`).
	[extern(method, "setStartAfter")]
	external fun set_start_after(self, node: Text): void;

	/// Ends the range immediately before `node` (`range.setEndBefore(node)`).
	[extern(method, "setEndBefore")]
	external fun set_end_before(self, node: Text): void;

	/// Takes every node in the range OUT of the document and returns them as a
	/// document fragment, in order (`range.extractContents()`). The nodes
	/// themselves move — identity, listeners and state intact — so a run's
	/// order pass is a cut and a re-insert, not a rebuild. Typed `Element` for
	/// the reason `create_document_fragment` records.
	[extern(method, "extractContents")]
	external fun extract_contents(self): Element;
}

/// A DOM event, as delivered to an `on_event` handler — an opaque handle like
/// `Element`.
external struct Event;

impl Event {
	/// Cancels the event's default action (`event.preventDefault()`) — e.g. stop
	/// an `<a>` from performing a full-page navigation.
	[extern(method, "preventDefault")]
	external fun prevent_default(self): void;

	/// The mouse button (`event.button`): 0 is the main button.
	[extern(get, "button")]
	external fun button(self): i32;

	/// Modifier-key state at dispatch time.
	[extern(get, "metaKey")]
	external fun meta_key(self): bool;

	[extern(get, "ctrlKey")]
	external fun ctrl_key(self): bool;

	[extern(get, "shiftKey")]
	external fun shift_key(self): bool;

	[extern(get, "altKey")]
	external fun alt_key(self): bool;

	/// The key for a keyboard event (`event.key`): `"Enter"`, `"Escape"`, `"a"`, ….
	/// This is the CHARACTER the layout produced — what a text-entry handler
	/// wants, and what changes when the user switches keyboard layouts.
	[extern(get, "key")]
	external fun key(self): str;

	/// The PHYSICAL key for a keyboard event (`event.code`): `"KeyE"`,
	/// `"Digit1"`, `"Enter"`, `"Escape"` — the position on the board, unchanged
	/// by the layout mapped onto it.
	///
	/// The pair matters, and picking wrong is silent. A shortcut table wants
	/// `code`: `"KeyE"` is the same physical key on QWERTY, AZERTY and Dvorak,
	/// where `key` there is `"e"`, `"e"` and `"."` — so a shortcut written
	/// against `key` moves under the user's layout, and a shortcut written
	/// against `code` does not. A text-entry handler wants `key`, for the
	/// mirror-image reason: it is the character the user meant to type.
	///
	/// The names are the host's own (`KeyboardEvent.code`'s value space), so
	/// a binding table reads the same in vilan as in the DOM docs it is
	/// written from.
	[extern(get, "code")]
	external fun code(self): str;

	/// Where the pointer is, in viewport coordinates (`event.clientX` /
	/// `event.clientY`) — the numbers a drag subtracts.
	///
	/// Named for the pointer, not for the DOM's coordinate space
	/// (`proposal/router.md` §5.3): `clientX`'s "client" means *viewport* for
	/// purely historical reasons, and the transliteration would teach that
	/// history to every reader. The document-relative pair (`pageX`/`pageY`)
	/// lands as `page_x`/`page_y` when something reads it.
	[extern(get, "clientX")]
	external fun pointer_x(self): f64;

	[extern(get, "clientY")]
	external fun pointer_y(self): f64;

	/// The element the event was DISPATCHED TO — the innermost node under the
	/// pointer or holding the focus (`event.target`).
	///
	/// This is the "did it land inside me?" accessor: a document-level click
	/// listener reads `event.target()` and dismisses the overlay it guards when
	/// the click landed outside it.
	[extern(get, "target")]
	external fun target(self): Element;

	/// The event's OTHER element (`event.relatedTarget`) — on a `focusout`,
	/// where focus WENT; on a `focusin`, where it came FROM. Null when there
	/// is no other element, which is the case that matters: focus leaving the
	/// document entirely (to the browser's chrome) reads as null, and a guard
	/// that pulled focus back there would be yanking it into a page the user
	/// has left.
	///
	/// It is also the `mouseover`/`mouseout` pair's "from where / to where",
	/// which is the same accessor and the same null rule.
	[extern(get, "relatedTarget")]
	external fun related_target(self): Element;

	/// The element whose LISTENER is running (`event.currentTarget`) — the node
	/// the handler was registered on, as the event bubbles past it.
	///
	/// Distinct from `target` and deliberately so, because the two answer
	/// different questions and coincide only when the event was dispatched
	/// straight at the listening element. `target` is where the event STARTED
	/// (a click on the `<span>` inside a button is the span); `current_target`
	/// is which handler is speaking (the button). A row of buttons sharing one
	/// handler reads `current_target` to learn which row it is in — reading
	/// `target` there gets whatever glyph the user happened to hit.
	///
	/// It is only meaningful DURING dispatch: the host clears it when the
	/// handler returns, so a captured `Event` read later hands back null. Read
	/// it in the handler, not out of one.
	[extern(get, "currentTarget")]
	external fun current_target(self): Element;

	/// The value of the element the event was dispatched to
	/// (`event.target.value`) — what an `<input>` holds right now, read from
	/// the EVENT instead of from a captured element.
	///
	/// That is the whole point (`proposal/lifetimes.md` §5, V3): a listener that
	/// reaches for its own element closes an element ↔ listener cycle that
	/// straddles the language/host boundary, where no vilan-side scheme can see
	/// both halves. `bind_value`/`bind_draft` read the value through here and
	/// capture no element at all.
	[extern(get, "target.value")]
	external fun target_value(self): str;
}
