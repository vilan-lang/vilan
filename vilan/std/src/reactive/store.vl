// `std::reactive::store` — the fine-grained version of a type, generated from its
// shape (tracker A142 S7, `proposal/store.md`).
//
// A `SignalCell<User>` wakes every reader on every write: a write to the user's
// city reruns the binding that shows their name. A STORE wakes exactly the readers
// whose value changed, and nobody writes a twin type to get that:
//
//     [derive(Storable)]
//     struct User { name: str, address: Address }
//
//     let user = Store::new(alice());
//     let city: Store<str> = user.address().city();   // a handle, not a value
//     city.set("Bergen");                              // wakes `city`, `address`, `user`
//
// **The handle (§2.1).** `Store<T>` is a root plus a static path. The root's value
// lives in ONE `Shared`, in place; a projection is another `Store` cut from its
// parent, and its `set` writes back through the root. It is a `Source<T>` and a
// `Signal<T>`, so every pipe, effect and binding takes one unchanged. Copying a
// handle allocates nothing.
//
// **Slots (§2.2, Q12).** A slot is one path's subscriber list: a notification-only
// cell. It is made by the FIRST subscription at its path, together with the nodes
// on the way down to it, counts its subscriptions, and goes with the last one —
// taking every node it leaves empty. A read allocates nothing, and the store's
// memory follows what is watched, not what is held.
//
// **The write rule (§2.3, Q7).** A write wakes exactly the live slots whose value
// changed. Unlike `SignalCell::set`, which never compares, a store write always
// does: that is the layer's whole job. It compares only where a slot is live,
// unless a whole-value slot above needs the answer, so a write into an unwatched
// store compares nothing. `notify()` is the escape hatch that wakes without
// comparing.
//
// **The spine (§2.5).** A write through a handle diffs that handle's subtree and,
// if anything changed, wakes each ancestor's whole-value slot. Siblings are never
// looked at, because the path is static. The diff collects what changed and the
// TURN delivers it (§2.8): every write's wakes are notified inside one `batch`, so
// an observer of two changed slots runs once, on the settled value.
//
// **Shapes (§3.1, §4).** `[derive(Storable)]` is the opt-in, and the encapsulation
// boundary (vilan has no private fields): a derived struct diffs field by field and
// projects one handle per field; a derived enum diffs its discriminant, then the
// live variant's payload. Every other type is a LEAF — compared with `==` when it
// has `PartialEq`, and changed on every covering write when it has not — through
// the two blanket tiers below. `Option` is structural without a derive.
//
// **Through a variant (§2.6, Q6).** A handle into an enum payload, or into an
// `Option`'s `Some`, is a `StoreSome<P>`: a `Source<Option<P>>` that reads `None`
// while the variant is not live, plus `patch(value: P): bool`, which writes only
// while it is. It is not a `Signal`: `set(None)` would have no meaning there.
// Switching the variant is a write to the enum's own handle.
//
// **Collections (§2.7, A149 S3).** A collection takes its DECLARED SHAPE, with no
// derive to write:
//
//   - a `HashMap<K, V>` is a KEYED node: `at(key)` is a `Store<Option<V>>` whose
//     slot hangs off the map's node by the key's hash, so a write to key 7 wakes
//     the readers of key 7 and nobody else, and `at(key).set(None)` removes the key;
//   - a `HashSet<T>` likewise, with `contains(x)`, a `Store<bool>`;
//   - a `List<T>` is a SEQUENCE node: the sequence writes (`push`, `splice`, ...)
//     land in place, and a keyed list (`T: Keyed<K>`) reads one element by its key
//     with `by_key(k)`. There is no `at(index)` (Q11): a position shifts under a
//     splice, and the handle would silently change which element it names.
//
// A whole write of a collection diffs by key — or, for a list, by its common prefix
// and suffix, `reconcile_to`'s diff — and wakes only the changed keys. A collection
// handle is the shape's FLOW: `app.channels().keys()` and
// `each_by(app.messages(), ..)` start from it and are told per-key or per-span OPS
// (`MapOp`, `SetOp`, `SeqOp`), not handed a copy to diff. Each flow started from a
// handle keeps its own op log at the collection's node, recorded only while it is
// open — a per-subscription FEED, as a slot is per path.
import pkg::hash::{ Hash, Hashable };
import pkg::hash_map::HashMap;
import pkg::hash_set::HashSet;
import pkg::io::panic;
import pkg::option::Option::{ self, None, Some };
import pkg::reactive::delta::{
	CollFlow,
	CollInstance,
	DeltaLog,
	MapFlow,
	MapInstance,
	MapOp,
	RowFeed,
	SeqOp,
	SequenceCell,
	SetFlow,
	SetInstance,
	SetOp,
	splice_count,
	splice_in_place,
	splice_start,
};
import pkg::reactive::store_core::{
	Spine,
	attach_feed,
	deliver,
	detach_feed,
	has_feeds,
	keyed_hashes,
	lent_value,
	spine,
	store_keyed,
	store_touch,
	touch_spine,
	watch_at,
};
import pkg::reactive::{ Signal, Source, Subscriber };
import pkg::shared::{ Shared, fresh_identity };
import pkg::wire::{ Deserialize, Deserializer, Keyed, Serialize, Serializer, Wire };

// The core — the handle types, the slot tree, the write — is `store_core.vl`,
// re-exported here whole: `std::reactive::store` is the one module a program imports.
export import pkg::reactive::store_core::{
	Storable,
	Store,
	StoreFeed,
	StoreFlag,
	StoreLeaf,
	StoreNode,
	StoreSlot,
	StoreSome,
	StoreStep,
	StoreTouch,
	StoreWoken,
	store_census,
	store_feed_census,
	store_has_me,
	store_kid,
	store_switch,
	store_wake_all,
	store_wake_me,
	store_wire_census,
};

// === The declared shapes (§2.7, A149 S3) =====================================

/// What `map` holds under the key whose hash is `hash` — one value, copied.
fun value_at<K: Hashable, V>(map: &HashMap<K, V>, hash: Hash): Option<V> {
	match map.table.get(hash) {
		Some(let entry) => Some(entry.1),
		None => None,
	}
}

/// Whether two values differ, exactly, waking nothing.
fun differs<T: Storable>(a: &T, b: &T, woken: &mut StoreWoken): bool {
	a.store_diff(b, None, true, woken)
}

/// A map is a KEYED node: each watched key's child is the `Option<V>` that key
/// holds, diffed against what the written map holds there, so a change to one key
/// wakes that key's slots and nobody else's. Every OTHER key is compared only when
/// someone needs the answer — the map's own slot or an ancestor's (settled with the
/// first difference), or an open flow's feed (every key, each changed one told). It
/// never compares the maps with `==` (§1.3).
export impl HashMap<type K: Hashable, type V: Storable> with Storable {
	fun store_diff(
		&self,
		other: &HashMap<K, V>,
		node: Option<Shared<StoreNode>>,
		need: bool,
		woken: &mut StoreWoken,
	): bool {
		if !need && node.is_none() {
			ret false;
		}
		let here = need || store_has_me(node);
		let fed = has_feeds(node);
		mut changed = false;
		let watched = keyed_hashes(node);
		for hash in watched {
			let mine = value_at(self, hash);
			let theirs = value_at(other, hash);
			if mine.store_diff(&theirs, store_keyed(node, hash), fed || (here && !changed), woken) {
				changed = true;
				store_touch(node, StoreTouch::Key(hash), woken);
			}
		}
		if fed || (here && !changed) {
			for hash in self.table.keys() {
				if fed || !changed {
					if store_keyed(node, hash).is_none() {
						let moved = match self.table.get(hash) {
							Some(let mine) => match other.table.get(hash) {
								Some(let theirs) => differs(&mine.1, &theirs.1, woken),
								None => true,
							},
							None => false,
						};
						if moved {
							changed = true;
							store_touch(node, StoreTouch::Key(hash), woken);
						}
					}
				}
			}
			for hash in other.table.keys() {
				if (fed || !changed)
					&& !self.table.contains_key(hash)
					&& store_keyed(node, hash).is_none() {
					changed = true;
					store_touch(node, StoreTouch::Key(hash), woken);
				}
			}
		}
		store_wake_me(node, changed, woken);
		changed
	}
}

/// A set is a keyed node of flags: each watched member's child is whether the set
/// holds it, so adding or removing one member wakes that member's slots only.
export impl HashSet<type T: Hashable> with Storable {
	fun store_diff(
		&self,
		other: &HashSet<T>,
		node: Option<Shared<StoreNode>>,
		need: bool,
		woken: &mut StoreWoken,
	): bool {
		if !need && node.is_none() {
			ret false;
		}
		let here = need || store_has_me(node);
		let fed = has_feeds(node);
		mut changed = false;
		for hash in keyed_hashes(node) {
			if self.table.contains_key(hash) != other.table.contains_key(hash) {
				changed = true;
				store_wake_all(store_keyed(node, hash), woken);
				store_touch(node, StoreTouch::Key(hash), woken);
			}
		}
		if fed || (here && !changed) {
			for hash in self.table.keys() {
				if (fed || !changed)
					&& !other.table.contains_key(hash)
					&& store_keyed(node, hash).is_none() {
					changed = true;
					store_touch(node, StoreTouch::Key(hash), woken);
				}
			}
			for hash in other.table.keys() {
				if (fed || !changed)
					&& !self.table.contains_key(hash)
					&& store_keyed(node, hash).is_none() {
					changed = true;
					store_touch(node, StoreTouch::Key(hash), woken);
				}
			}
		}
		store_wake_me(node, changed, woken);
		changed
	}
}

/// A value's KEY in a keyed list, as a store reads it (A149 S3): the hash of its
/// `Keyed` key, or `None` for a type with no key. Two tiers, like `StoreLeaf`'s:
/// every type answers, and a keyed one answers with its key.
export trait StoreKey {
	fun store_key(&self): Option<Hash>;
}

/// A type with no key.
export impl type T with StoreKey {
	fun store_key(&self): Option<Hash> {
		None
	}
}

/// A keyed type: its key's hash.
export impl type T: Keyed<type K: Hashable> with StoreKey {
	fun store_key(&self): Option<Hash> {
		Some(self.key().hash())
	}
}

/// The position of the first element of `list` whose key hashes to `hash`.
fun keyed_position<T: StoreKey>(list: &List<T>, hash: Hash): Option<usize> {
	mut index: usize = 0;
	let length = list.len();
	for index < length {
		match list[index].store_key() {
			Some(let key) => {
				if key == hash {
					ret Some(index);
				}
			},
			None => {},
		}
		index += 1;
	}
	None
}

/// The first element of `list` whose key hashes to `hash` — `by_key`'s read.
fun keyed_element<T: StoreKey>(list: &List<T>, hash: Hash): Option<T> {
	match keyed_position(list, hash) {
		Some(let index) => Some(list[index]),
		None => None,
	}
}

/// The keyed children of a list's `node` whose key is carried by an element of
/// `list` in `start .. start + count` — the by-key handles a splice of that span
/// may have moved.
fun keys_in_span<T: StoreKey>(
	node: Option<Shared<StoreNode>>,
	list: &List<T>,
	start: usize,
	count: usize,
	into: &mut List<Hash>,
) {
	mut index = start;
	for index < start + count {
		match list[index].store_key() {
			Some(let key) => {
				if store_keyed(node, key).is_some() && !into.contains(key) {
					into.push(key);
				}
			},
			None => {},
		}
		index += 1;
	}
}

/// A list is a SEQUENCE node. A whole write is `reconcile_to`'s diff — the common
/// prefix, the common suffix, and one span between them — so the list's slot wakes,
/// an open flow is told one splice, and a `by_key` handle wakes only when the
/// element under its key changed. Elements compare exactly, by their own `Storable`
/// diff.
export impl List<type T: Storable + StoreKey> with Storable {
	fun store_diff(
		&self,
		other: &List<T>,
		node: Option<Shared<StoreNode>>,
		need: bool,
		woken: &mut StoreWoken,
	): bool {
		if !need && node.is_none() {
			ret false;
		}
		let old_length = self.len();
		let new_length = other.len();
		mut prefix: usize = 0;
		for prefix < old_length && prefix < new_length {
			if differs(&self[prefix], &other[prefix], woken) {
				jump break;
			}
			prefix += 1;
		}
		mut suffix: usize = 0;
		for prefix + suffix < old_length && prefix + suffix < new_length {
			if differs(&self[old_length - 1 - suffix], &other[new_length - 1 - suffix], woken) {
				jump break;
			}
			suffix += 1;
		}
		let removed = old_length - prefix - suffix;
		let inserted = new_length - prefix - suffix;
		let changed = removed > 0 || inserted > 0;
		if changed {
			store_touch(node, StoreTouch::Span(prefix, removed, inserted), woken);
			mut moved: List<Hash> = [];
			keys_in_span(node, self, prefix, removed, &mut moved);
			keys_in_span(node, other, prefix, inserted, &mut moved);
			for hash in moved {
				let mine = keyed_element(self, hash);
				let theirs = keyed_element(other, hash);
				let _moved = mine.store_diff(&theirs, store_keyed(node, hash), false, woken);
			}
		}
		store_wake_me(node, changed, woken);
		changed
	}
}

/// A splice at `path` — `removed` elements leave at `at` and `inserted` arrive —
/// landed IN PLACE through `modify`: no copy of the list. Wakes the list's slot and
/// every ancestor's, the `by_key` handles whose element the splice moved, and tells
/// the list's open flows the span. A splice that changes nothing (clamped to
/// nothing, or the same elements back) wakes nothing.
fun splice_at<T: Storable + StoreKey>(
	root: Shared<StoreNode>,
	path: List<StoreStep>,
	lend: |(|&List<T>| void)| void,
	modify: |(|&mut List<T>| void)| void,
	at: usize,
	removed: usize,
	inserted: List<T>,
) {
	let found = spine(root, &path);
	let node = found.node;
	mut woken = StoreWoken { slots = [], feeds = [] };
	mut reached = false;
	mut start: usize = 0;
	mut taking: usize = 0;
	mut changed = false;
	mut moved: List<Hash> = [];
	mut olds: List<Option<T>> = [];
	lend(|list: &List<T>| {
		reached = true;
		start = splice_start(list.len(), at);
		taking = splice_count(list.len(), start, removed);
		changed = taking != inserted.len();
		mut index: usize = 0;
		for !changed && index < taking {
			changed = differs(&list[start + index], &inserted[index], &mut woken);
			index += 1;
		}
		if changed {
			keys_in_span(node, list, start, taking, &mut moved);
			keys_in_span(node, &inserted, 0, inserted.len(), &mut moved);
			for hash in moved {
				olds.push(keyed_element(list, hash));
			}
		}
	});
	if !reached || !changed {
		ret;
	}
	store_touch(node, StoreTouch::Span(start, taking, inserted.len()), &mut woken);
	touch_spine(found.touches, &mut woken);
	for feed in woken.feeds {
		(feed.before)();
	}
	modify(|list: &mut List<T>| {
		let _op = splice_in_place(list, start, taking, inserted);
	});
	for feed in woken.feeds {
		(feed.after)();
	}
	if !moved.is_empty() {
		lend(|list: &List<T>| {
			mut index: usize = 0;
			for index < moved.len() {
				let now = keyed_element(list, moved[index]);
				let _moved = olds[index].store_diff(&now, store_keyed(node, moved[index]), false, &mut woken);
				index += 1;
			}
		});
	}
	store_wake_me(node, true, &mut woken);
	for slot in found.ancestors {
		woken.slots.push(slot);
	}
	match found.wire {
		Some(let log) => log.record(path),
		None => {},
	}
	deliver(woken.slots);
}

// === The feeds (A149 S3) ======================================================
//
// A collection handle's flow keeps its own op log, recorded by a feed standing on
// the collection's node for as long as the flow is open. The write tells the feed
// WHICH part moved — a key, a span — and the feed reads that part through the
// handle's in-place lend before the assignment and after it, so its ops carry what
// left as well as what arrived (`delta.vl`'s requirement) at the cost of the parts
// that moved, never a copy of the collection. A change the store did not take apart
// (`StoreTouch::Whole`) is recorded as the shape's `Reset`.

/// The touches one write left a feed, and whether one of them was `Whole`.
struct Pending {
	keys: List<Hash>,
	spans: List<(usize, usize, usize)>,
	whole: bool,
}

fun pending_none(): Pending {
	Pending { keys = [], spans = [], whole = false }
}

/// `pending` with `touch` noted.
fun pending_with(pending: Pending, touch: StoreTouch): Pending {
	mut noted = pending;
	match touch {
		StoreTouch::Key(let hash) => noted.keys.push(hash),
		StoreTouch::Span(let at, let removed, let inserted) => noted.spans.push((at, removed, inserted)),
		StoreTouch::Whole => {
			noted.whole = true;
		},
	}
	noted
}

// Each feed's state is `mut` bindings its three closures capture: a binding the
// closures of one frame capture IS their shared storage (spec §6.9, M93's rule),
// so a feed mints no cell of its own.

/// A map flow's feed: a `Put` or `Delete` per touched key, read around the write.
fun map_feed<K: Hashable, V>(
	lend: |(|&HashMap<K, V>| void)| void,
	log: DeltaLog<MapOp<K, V>>,
): StoreFeed {
	mut pending = pending_none();
	mut olds: List<Option<(K, V)>> = [];
	StoreFeed {
		id = fresh_identity(),
		touch = |touch: StoreTouch| {
			pending = pending_with(pending, touch);
		},
		before = || {
			olds = [];
			lend(|map: &HashMap<K, V>| {
				for hash in pending.keys {
					olds.push(map.table.get(hash));
				}
			});
		},
		after = || {
			let keys = pending.keys;
			mut reached = false;
			lend(|map: &HashMap<K, V>| {
				reached = true;
				if pending.whole || olds.len() != keys.len() {
					log.record(MapOp::Reset(*map));
					ret;
				}
				mut index: usize = 0;
				for index < keys.len() {
					match olds[index] {
						Some(let was) => match map.table.get(keys[index]) {
							Some(let now) => log.record(MapOp::Put(now.0, Some(was.1), now.1)),
							None => log.record(MapOp::Delete(was.0, was.1)),
						},
						None => match map.table.get(keys[index]) {
							Some(let now) => log.record(MapOp::Put(now.0, None, now.1)),
							None => {},
						},
					}
					index += 1;
				}
			});
			if !reached {
				log.record(MapOp::Reset(HashMap::new()));
			}
			pending = pending_none();
		},
	}
}

/// A set flow's feed: an `Add` or `Remove` per touched member.
fun set_feed<T: Hashable>(lend: |(|&HashSet<T>| void)| void, log: DeltaLog<SetOp<T>>): StoreFeed {
	mut pending = pending_none();
	mut olds: List<Option<T>> = [];
	StoreFeed {
		id = fresh_identity(),
		touch = |touch: StoreTouch| {
			pending = pending_with(pending, touch);
		},
		before = || {
			olds = [];
			lend(|set: &HashSet<T>| {
				for hash in pending.keys {
					olds.push(set.table.get(hash));
				}
			});
		},
		after = || {
			let keys = pending.keys;
			mut reached = false;
			lend(|set: &HashSet<T>| {
				reached = true;
				if pending.whole || olds.len() != keys.len() {
					log.record(SetOp::Reset(*set));
					ret;
				}
				mut index: usize = 0;
				for index < keys.len() {
					match olds[index] {
						Some(let was) => {
							if !set.table.contains_key(keys[index]) {
								log.record(SetOp::Remove(was));
							}
						},
						None => match set.table.get(keys[index]) {
							Some(let now) => log.record(SetOp::Add(now)),
							None => {},
						},
					}
					index += 1;
				}
			});
			if !reached {
				log.record(SetOp::Reset(HashSet::new()));
			}
			pending = pending_none();
		},
	}
}

/// The elements of `list` in `start .. start + count`.
fun span_of<T>(list: &List<T>, start: usize, count: usize): List<T> {
	mut out: List<T> = [];
	mut index = start;
	for index < start + count {
		out.push(list[index]);
		index += 1;
	}
	out
}

/// What a list feed read of one touched part before the write: a span's elements,
/// or the position and element under a key.
enum SeqBefore<T> {
	Span(usize, List<T>, usize),
	Keyed(Hash, Option<(usize, T)>),
}

/// The position and element under the key whose hash is `hash`.
fun keyed_place<T: StoreKey>(list: &List<T>, hash: Hash): Option<(usize, T)> {
	match keyed_position(list, hash) {
		Some(let index) => Some((index, list[index])),
		None => None,
	}
}

/// A list flow's feed: one `Splice` per touched span (`SetAt` for one element
/// changed in place), read around the write. A write that touched the list in more
/// than one place is recorded as a `Reset`.
fun list_feed<T: StoreKey>(lend: |(|&List<T>| void)| void, log: DeltaLog<SeqOp<T>>): StoreFeed {
	mut pending = pending_none();
	mut olds: List<SeqBefore<T>> = [];
	StoreFeed {
		id = fresh_identity(),
		touch = |touch: StoreTouch| {
			pending = pending_with(pending, touch);
		},
		before = || {
			olds = [];
			lend(|list: &List<T>| {
				for span in pending.spans {
					olds.push(SeqBefore::Span(span.0, span_of(list, span.0, span.1), span.2));
				}
				for hash in pending.keys {
					olds.push(SeqBefore::Keyed(hash, keyed_place(list, hash)));
				}
			});
		},
		after = || {
			let touched = pending.spans.len() + pending.keys.len();
			mut reached = false;
			lend(|list: &List<T>| {
				reached = true;
				if pending.whole || olds.len() != touched || touched > 1 {
					log.record(SeqOp::Reset(*list));
					ret;
				}
				for before in olds {
					match before {
						SeqBefore::Span(let at, let left, let arriving) => {
							let arrived = span_of(list, at, arriving);
							if left.len() == 1 && arrived.len() == 1 {
								log.record(SeqOp::SetAt(at, left[0], arrived[0]));
							} else {
								log.record(SeqOp::Splice(at, left, arrived));
							}
						},
						SeqBefore::Keyed(let hash, let was) => record_keyed(log, was, keyed_place(list, hash)),
					}
				}
			});
			if !reached {
				log.record(SeqOp::Reset([]));
			}
			pending = pending_none();
		},
	}
}

/// The op a write under one key made, from where the key's element stood before and
/// after: an edit in place, a removal, an arrival, or a move.
fun record_keyed<T>(log: DeltaLog<SeqOp<T>>, was: Option<(usize, T)>, now: Option<(usize, T)>) {
	match was {
		Some(let old) => match now {
			Some(let new) => {
				if old.0 == new.0 {
					log.record(SeqOp::SetAt(old.0, old.1, new.1));
				} else {
					log.record(SeqOp::Splice(old.0, [old.1], []));
					log.record(SeqOp::Splice(new.0, [], [new.1]));
				}
			},
			None => log.record(SeqOp::Splice(old.0, [old.1], [])),
		},
		None => match now {
			Some(let new) => log.record(SeqOp::Splice(new.0, [], [new.1])),
			None => {},
		},
	}
}

// === Collection handles (§2.7, A149 S3) =======================================

/// `by_key(k)`'s write: the first element under the key whose hash is `hash`, as an
/// `Option` handed to `f`, written back in place (`Some`), removed (`None`), or
/// appended (`Some` for a key the list did not hold).
fun keyed_write<T: StoreKey>(held: &mut List<T>, hash: Hash, f: |&mut Option<T>| void) {
	match keyed_position(held, hash) {
		Some(let index) => {
			mut found = Some(held[index]);
			f(&mut found);
			match found {
				Some(let now) => {
					held[index] = now;
				},
				None => {
					let _gone = held.remove(index);
				},
			}
		},
		None => {
			mut found: Option<T> = None;
			f(&mut found);
			match found {
				Some(let now) => held.push(now),
				None => {},
			}
		},
	}
}

/// A map field is a KEYED node.
export impl Store<HashMap<type K: Hashable, type V>> {
	/// How many keys the map holds — read in place, copying nothing.
	fun len(self): usize {
		mut length: usize = 0;
		(self.lend)(|map: &HashMap<K, V>| {
			length = map.len();
		});
		length
	}

	/// The value under `key`, as a handle that depends on that key only: a write to
	/// another key never wakes it. A `Store<Option<V>>`, so `set(None)` removes the
	/// key, `.some()` reaches into a present value, and its subscription's slot
	/// lives as long as its subscriptions do (Q12).
	fun at(self, key: K): Store<Option<V>> {
		self.descend(StoreStep::Key(key.hash()), |held: &HashMap<K, V>, f: |&Option<V>| void| {
			let value = held.get(key);
			f(&value);
		}, |held: &mut HashMap<K, V>, f: |&mut Option<V>| void| {
			mut value = held.get(key);
			f(&mut value);
			match value {
				Some(let now) => held.insert(key, now),
				None => held.remove(key),
			}
		})
	}
}

export impl Store<HashMap<type K: Hashable, type V: Storable>> {
	/// `key` holds `value` now — `at(key).set(Some(value))`.
	fun insert(self, key: K, value: V) {
		self.at(key).set(Some(value));
	}

	/// `key` leaves — `at(key).set(None)`.
	fun remove(self, key: K) {
		self.at(key).set(None);
	}
}

/// A map field inside a variant: the same keyed step, through the variant.
export impl StoreSome<HashMap<type K: Hashable, type V>> {
	fun at(self, key: K): StoreSome<Option<V>> {
		self.descend(StoreStep::Key(key.hash()), |held: &HashMap<K, V>, f: |&Option<V>| void| {
			let value = held.get(key);
			f(&value);
		}, |held: &mut HashMap<K, V>, f: |&mut Option<V>| void| {
			mut value = held.get(key);
			f(&mut value);
			match value {
				Some(let now) => held.insert(key, now),
				None => held.remove(key),
			}
		})
	}
}

/// A set field is a keyed node of flags.
export impl Store<HashSet<type T: Hashable>> {
	/// How many members the set holds — read in place, copying nothing.
	fun len(self): usize {
		mut length: usize = 0;
		(self.lend)(|set: &HashSet<T>| {
			length = set.len();
		});
		length
	}

	/// Whether the set holds `member`, as a handle that depends on that member
	/// only. A `Store<bool>`: `set(true)` adds it and `set(false)` removes it.
	fun contains(self, member: T): Store<bool> {
		self.descend(StoreStep::Key(member.hash()), |held: &HashSet<T>, f: |&bool| void| {
			let present = held.contains(member);
			f(&present);
		}, |held: &mut HashSet<T>, f: |&mut bool| void| {
			mut present = held.contains(member);
			f(&mut present);
			if present {
				held.insert(member);
			} else {
				held.remove(member);
			}
		})
	}

	/// `member` joins the set — `contains(member).set(true)`.
	fun insert(self, member: T) {
		self.contains(member).set(true);
	}

	/// `member` leaves the set — `contains(member).set(false)`.
	fun remove(self, member: T) {
		self.contains(member).set(false);
	}
}

export impl StoreSome<HashSet<type T: Hashable>> {
	fun contains(self, member: T): StoreSome<bool> {
		self.descend(StoreStep::Key(member.hash()), |held: &HashSet<T>, f: |&bool| void| {
			let present = held.contains(member);
			f(&present);
		}, |held: &mut HashSet<T>, f: |&mut bool| void| {
			mut present = held.contains(member);
			f(&mut present);
			if present {
				held.insert(member);
			} else {
				held.remove(member);
			}
		})
	}
}

/// A keyed list reads one element by its key (Q11: no `at(index)`).
export impl Store<List<type T: StoreKey + Keyed<type K: Hashable>>> {
	/// The first element whose key is `key`, as a handle that depends on that
	/// element only: a splice elsewhere in the list never wakes it, and a write
	/// that moves no element under `key` wakes nothing. `set(None)` removes the
	/// element; `set(Some(v))` replaces it in place, or appends `v` when the list
	/// holds no element under `key`.
	fun by_key(self, key: K): Store<Option<T>> {
		let hash = key.hash();
		self.descend(StoreStep::Key(hash), |held: &List<T>, f: |&Option<T>| void| {
			let found = keyed_element(held, hash);
			f(&found);
		}, |held: &mut List<T>, f: |&mut Option<T>| void| keyed_write(held, hash, f))
	}
}

export impl StoreSome<List<type T: StoreKey + Keyed<type K: Hashable>>> {
	fun by_key(self, key: K): StoreSome<Option<T>> {
		let hash = key.hash();
		self.descend(StoreStep::Key(hash), |held: &List<T>, f: |&Option<T>| void| {
			let found = keyed_element(held, hash);
			f(&found);
		}, |held: &mut List<T>, f: |&mut Option<T>| void| keyed_write(held, hash, f))
	}
}

/// A list field is a SEQUENCE node: every `SequenceCell` write — `push`, `prepend`,
/// `insert_at`, `remove_at`, `extend`, `clear`, `truncate`, ... — is one splice,
/// landed in place.
export impl Store<List<type T: Storable + StoreKey>> with SequenceCell<T> {
	/// How many elements the list holds — read in place.
	fun size(self): usize {
		mut length: usize = 0;
		(self.lend)(|list: &List<T>| {
			length = list.len();
		});
		length
	}

	fun splice(self, at: usize, removed: usize, inserted: List<T>) {
		splice_at(self.root, self.path, self.lend, self.modify, at, removed, inserted);
	}
}

/// A list field inside a variant: the same writes, landing only while the variant
/// is live (`patch`'s rule).
export impl StoreSome<List<type T: Storable + StoreKey>> with SequenceCell<T> {
	fun size(self): usize {
		mut length: usize = 0;
		(self.lend)(|list: &List<T>| {
			length = list.len();
		});
		length
	}

	fun splice(self, at: usize, removed: usize, inserted: List<T>) {
		splice_at(self.root, self.path, self.lend, self.modify, at, removed, inserted);
	}
}

/// A map field is a map FLOW: every map operator (`keys`, `values`, `filter`, ...)
/// starts from it and is told `MapOp`s.
export impl Store<HashMap<type K: Hashable, type V>> with MapFlow<K, V> {
	fun open(own self): MapInstance<K, V> {
		let lend = self.lend;
		let root = self.root;
		let path = self.path;
		let log = DeltaLog<MapOp<K, V>>::new();
		let cursor = log.cursor();
		let feed = map_feed(lend, log);
		attach_feed(root, path, feed);
		MapInstance<K, V> {
			snapshot = || lent_value(lend),
			attach = |subscriber: Subscriber| watch_at(root, path, subscriber),
			drain = || match log.since(cursor) {
				Some(let ops) => ops,
				None => [MapOp::Reset(lent_value(lend))],
			},
			release = || {
				log.drop_cursor(cursor);
				detach_feed(root, path, feed.id);
			},
		}
	}
}

/// A set field is a set flow, told `SetOp`s.
export impl Store<HashSet<type T: Hashable>> with SetFlow<T> {
	fun open(own self): SetInstance<T> {
		let lend = self.lend;
		let root = self.root;
		let path = self.path;
		let log = DeltaLog<SetOp<T>>::new();
		let cursor = log.cursor();
		let feed = set_feed(lend, log);
		attach_feed(root, path, feed);
		SetInstance<T> {
			snapshot = || lent_value(lend),
			attach = |subscriber: Subscriber| watch_at(root, path, subscriber),
			drain = || match log.since(cursor) {
				Some(let ops) => ops,
				None => [SetOp::Reset(lent_value(lend))],
			},
			release = || {
				log.drop_cursor(cursor);
				detach_feed(root, path, feed.id);
			},
		}
	}
}

/// A list field is a collection flow, told `SeqOp`s — and what `each`/`each_by`
/// read their rows from, so a `push` builds one row.
export impl Store<List<type T: StoreKey>> with CollFlow<T> {
	fun open(own self): CollInstance<T> {
		let lend = self.lend;
		let root = self.root;
		let path = self.path;
		let log = DeltaLog<SeqOp<T>>::new();
		let cursor = log.cursor();
		let feed = list_feed(lend, log);
		attach_feed(root, path, feed);
		CollInstance<T> {
			snapshot = || lent_value(lend),
			attach = |subscriber: Subscriber| watch_at(root, path, subscriber),
			drain = || match log.since(cursor) {
				Some(let ops) => ops,
				None => [SeqOp::Reset(lent_value(lend))],
			},
			release = || {
				log.drop_cursor(cursor);
				detach_feed(root, path, feed.id);
			},
		}
	}
}

export impl Store<List<type T: StoreKey>> with RowFeed<T> {
	fun open_rows(own self): CollInstance<T> {
		self.open()
	}
}

// === The wire walkers (A153 S1, `mirrored-store.md` §3–§4) =====================
//
// A mirrored store crosses the wire BY PATH: the server describes the value at a
// path below a handle it granted, and reads a client's subscription path off the
// frame at the types the path walks through; the client applies a value at a path
// of its replica. Every store type answers all three through `StoreWire`, by the
// same child indices the slot tree uses (§3.1): `[derive(Storable)]` writes it for
// a struct or an enum, `Option`, `HashMap`, `HashSet` and `List` answer by their
// shape, and every other type is a LEAF, described and rebuilt whole by its `Wire`
// impl.
//
// A described value is a BOUNDARY'S SUBTREE (§2.2): a keyed collection inside it —
// a `HashMap` or a `HashSet` — is described EMPTY, because its keys are boundaries
// of their own. A key's value crosses when that key is subscribed (`at(k)`,
// `contains(x)`), never with its parent, which is what keeps a root that holds a
// database from shipping it on connect (§2.3). The format is otherwise `Wire`'s,
// call for call: a struct is `begin_struct` and its fields by name, an enum its
// tagged variant, so a value with no keyed collection inside describes exactly as
// its `[derive(Wire)]` impl would.

/// How a walk to a path went (A153 S1).
[derive(Debug, PartialEq)]
export enum StoreReach {
	/// The path reached a value, and it was described (or would have been).
	Described,
	/// The path reached a KEYED collection, which a boundary's subtree carries
	/// empty: its keys cross as boundaries of their own.
	Keyed,
	/// The path reached nothing: a variant on the way is not live, an `Option` on
	/// the way is `None`, or a step names no child.
	Absent,
}

/// A store type the wire can walk (A153 S1). Every type answers: a derived type
/// field by field, the declared shapes by their shape, everything else whole
/// (`StoreWireLeaf`).
export trait StoreWire {
	/// Walk `path[from..]` below this value and, when `write`, describe what it
	/// reaches into `serializer` — the target's subtree, keyed collections empty.
	/// Answers how the walk went whether or not it wrote, so a caller can ask first
	/// and frame the answer after.
	fun store_describe_at(
		&self,
		path: &List<StoreStep>,
		from: usize,
		serializer: &mut Serializer,
		write: bool,
	): StoreReach;

	/// Apply what `deserializer` holds at `path[from..]` below this value, in
	/// place: the twin of `store_describe_at`, which a replica lands a frame with.
	/// A keyed collection on the way is KEPT — the frame carried it empty — so
	/// the keys a replica holds are not thrown away by a write to their parent.
	fun store_apply_at(
		&mut self,
		path: &List<StoreStep>,
		from: usize,
		deserializer: &mut Deserializer,
	): StoreReach;

	/// Read `remaining` steps of a subscription path off `deserializer`, at the
	/// types they walk through, into `into`: a field's step is its child index, a
	/// key's is the key described at its own type, read here and kept as its
	/// `Hash`. Answers whether every step named a child a subscription can stand
	/// at.
	fun store_read_path(
		deserializer: &mut Deserializer,
		remaining: i32,
		into: &mut List<StoreStep>,
	): bool;

	/// A fresh value read off `deserializer` — what `store_apply_at` lands where
	/// there was nothing to merge into (a variant that changed, a `None` that
	/// became `Some`).
	fun store_fresh(deserializer: &mut Deserializer): Self;
}

/// A value the wire carries WHOLE — `StoreWire`'s leaf tier, as `StoreLeaf` is
/// `Storable`'s: a `Wire` type is described and rebuilt by its `Wire` impl, and a
/// type with none cannot cross at all (the `[rpc]` element rule refuses it before a
/// frame is ever written).
export trait StoreWireLeaf {
	fun store_wire_describe(&self, serializer: &mut Serializer);
	fun store_wire_rebuild(deserializer: &mut Deserializer): Self;
}

/// A type with no `Wire` impl: nothing a mirror can carry.
export impl type T with StoreWireLeaf {
	fun store_wire_describe(&self, serializer: &mut Serializer) {
		panic("a mirrored store reached a value with no `Wire` impl: a store crosses the wire only when every value in it is `Wire`");
	}

	fun store_wire_rebuild(deserializer: &mut Deserializer): T {
		panic("a mirrored store reached a value with no `Wire` impl: a store crosses the wire only when every value in it is `Wire`")
	}
}

/// A `Wire` value, described and rebuilt by its own impl.
export impl type T: Wire with StoreWireLeaf {
	fun store_wire_describe(&self, serializer: &mut Serializer) {
		(*self).describe(serializer);
	}

	fun store_wire_rebuild(deserializer: &mut Deserializer): T {
		T::rebuild(deserializer)
	}
}

/// Every type the shapes and the derive do not answer is a leaf: it ends a path,
/// and it is described and rebuilt whole.
export impl type T: StoreWireLeaf with StoreWire {
	fun store_describe_at(
		&self,
		path: &List<StoreStep>,
		from: usize,
		serializer: &mut Serializer,
		write: bool,
	): StoreReach {
		if from != path.len() {
			ret StoreReach::Absent;
		}
		if write {
			self.store_wire_describe(serializer);
		}
		StoreReach::Described
	}

	fun store_apply_at(
		&mut self,
		path: &List<StoreStep>,
		from: usize,
		deserializer: &mut Deserializer,
	): StoreReach {
		if from != path.len() {
			ret StoreReach::Absent;
		}
		self = T::store_wire_rebuild(deserializer);
		StoreReach::Described
	}

	fun store_read_path(
		deserializer: &mut Deserializer,
		remaining: i32,
		into: &mut List<StoreStep>,
	): bool {
		remaining == 0
	}

	fun store_fresh(deserializer: &mut Deserializer): T {
		T::store_wire_rebuild(deserializer)
	}
}

/// `T::store_read_path`, spelled as a call the derive can write over any field's
/// TYPE: a static call naming a concrete type that only a blanket answers
/// (`str::store_read_path(..)`) does not resolve, and a generic call does.
[internal("the derive's static step (A153 S1)")]
export fun store_read_path_of<T: StoreWire>(
	deserializer: &mut Deserializer,
	remaining: i32,
	into: &mut List<StoreStep>,
): bool {
	T::store_read_path(deserializer, remaining, into)
}

/// `T::store_fresh` over any field's type (`store_read_path_of`'s reason).
[internal("the derive's static step (A153 S1)")]
export fun store_fresh_of<T: StoreWire>(deserializer: &mut Deserializer): T {
	T::store_fresh(deserializer)
}

/// `T::store_wire_rebuild` over any type — a backed enum's fresh value.
[internal("the derive's static step (A153 S1)")]
export fun store_wire_rebuild_of<T: StoreWireLeaf>(deserializer: &mut Deserializer): T {
	T::store_wire_rebuild(deserializer)
}

/// What the derive writes where a closure-typed field would cross: nothing can.
[internal("the derive's refusal at a closure field (A153 S1)")]
export fun store_wire_closure<T>(): T {
	panic("a mirrored store reached a closure: a closure never crosses the wire")
}

/// An `Option` is walked through its `Some`: child 1, the payload (§4).
export impl Option<type P: StoreWire> with StoreWire {
	fun store_describe_at(
		&self,
		path: &List<StoreStep>,
		from: usize,
		serializer: &mut Serializer,
		write: bool,
	): StoreReach {
		if from == path.len() {
			if write {
				match self {
					Some(let held) => {
						serializer.some_value();
						let _described = held.store_describe_at(path, from, serializer, true);
					},
					None => serializer.null_value(),
				}
			}
			ret StoreReach::Described;
		}
		match path[from] {
			StoreStep::Field(let index) => {
				if index != 1 {
					ret StoreReach::Absent;
				}
				match self {
					Some(let held) => held.store_describe_at(path, from + 1, serializer, write),
					None => StoreReach::Absent,
				}
			},
			StoreStep::Key(let _hash) => StoreReach::Absent,
		}
	}

	fun store_apply_at(
		&mut self,
		path: &List<StoreStep>,
		from: usize,
		deserializer: &mut Deserializer,
	): StoreReach {
		if from == path.len() {
			if deserializer.is_null() {
				deserializer.null_value();
				self = None;
				ret StoreReach::Described;
			}
			match &mut self {
				Some(let held) => {
					let _applied = held.store_apply_at(path, from, deserializer);
				},
				None => {
					self = Some(P::store_fresh(deserializer));
				},
			}
			ret StoreReach::Described;
		}
		match path[from] {
			StoreStep::Field(let index) => {
				if index != 1 {
					ret StoreReach::Absent;
				}
				match &mut self {
					Some(let held) => held.store_apply_at(path, from + 1, deserializer),
					None => StoreReach::Absent,
				}
			},
			StoreStep::Key(let _hash) => StoreReach::Absent,
		}
	}

	fun store_read_path(
		deserializer: &mut Deserializer,
		remaining: i32,
		into: &mut List<StoreStep>,
	): bool {
		if remaining == 0 {
			ret true;
		}
		if deserializer.i32_value() != 1 {
			ret false;
		}
		into.push(StoreStep::Field(1));
		P::store_read_path(deserializer, remaining - 1, into)
	}

	fun store_fresh(deserializer: &mut Deserializer): Option<P> {
		if deserializer.is_null() {
			deserializer.null_value();
			ret None;
		}
		Some(P::store_fresh(deserializer))
	}
}

/// Read an elided keyed collection off the wire: it arrives EMPTY, and a frame that
/// carries keys there is a protocol fault.
fun read_elided(deserializer: &mut Deserializer) {
	let count = deserializer.begin_list();
	if count != 0 {
		deserializer.fail("a keyed collection inside a mirrored value arrives empty: its keys cross as boundaries of their own");
	}
	deserializer.end_list();
}

/// Describe an elided keyed collection: an empty list, `HashMap`'s own `Wire` form
/// with nothing in it.
fun describe_elided(serializer: &mut Serializer) {
	serializer.begin_list(0);
	serializer.end_list();
}

/// A map's keys are boundaries: the map itself is described empty, and a key's step
/// reaches the `Option<V>` that key holds — `at(key)`'s value.
export impl HashMap<type K: Hashable + Wire, type V: StoreWire> with StoreWire {
	fun store_describe_at(
		&self,
		path: &List<StoreStep>,
		from: usize,
		serializer: &mut Serializer,
		write: bool,
	): StoreReach {
		if from == path.len() {
			if write {
				describe_elided(serializer);
			}
			ret StoreReach::Keyed;
		}
		match path[from] {
			StoreStep::Key(let hash) => {
				let value = value_at(self, hash);
				value.store_describe_at(path, from + 1, serializer, write)
			},
			StoreStep::Field(let _index) => StoreReach::Absent,
		}
	}

	fun store_apply_at(
		&mut self,
		path: &List<StoreStep>,
		from: usize,
		deserializer: &mut Deserializer,
	): StoreReach {
		if from == path.len() {
			read_elided(deserializer);
			ret StoreReach::Keyed;
		}
		// A key's value lands through its own boundary's handle, which holds the
		// key itself: a path carries only its hash.
		StoreReach::Absent
	}

	fun store_read_path(
		deserializer: &mut Deserializer,
		remaining: i32,
		into: &mut List<StoreStep>,
	): bool {
		if remaining == 0 {
			ret true;
		}
		let key = K::rebuild(deserializer);
		into.push(StoreStep::Key(key.hash()));
		store_read_path_of<Option<V>>(deserializer, remaining - 1, into)
	}

	fun store_fresh(deserializer: &mut Deserializer): HashMap<K, V> {
		read_elided(deserializer);
		HashMap::new()
	}
}

/// A set's members are boundaries: the set is described empty, and a member's step
/// reaches whether the set holds it — `contains(member)`'s value.
export impl HashSet<type T: Hashable + Wire> with StoreWire {
	fun store_describe_at(
		&self,
		path: &List<StoreStep>,
		from: usize,
		serializer: &mut Serializer,
		write: bool,
	): StoreReach {
		if from == path.len() {
			if write {
				describe_elided(serializer);
			}
			ret StoreReach::Keyed;
		}
		match path[from] {
			StoreStep::Key(let hash) => {
				let present = self.table.contains_key(hash);
				present.store_describe_at(path, from + 1, serializer, write)
			},
			StoreStep::Field(let _index) => StoreReach::Absent,
		}
	}

	fun store_apply_at(
		&mut self,
		path: &List<StoreStep>,
		from: usize,
		deserializer: &mut Deserializer,
	): StoreReach {
		if from == path.len() {
			read_elided(deserializer);
			ret StoreReach::Keyed;
		}
		StoreReach::Absent
	}

	fun store_read_path(
		deserializer: &mut Deserializer,
		remaining: i32,
		into: &mut List<StoreStep>,
	): bool {
		if remaining == 0 {
			ret true;
		}
		let member = T::rebuild(deserializer);
		into.push(StoreStep::Key(member.hash()));
		store_read_path_of<bool>(deserializer, remaining - 1, into)
	}

	fun store_fresh(deserializer: &mut Deserializer): HashSet<T> {
		read_elided(deserializer);
		HashSet::new()
	}
}

/// A list is a sequence INSIDE its boundary: described element by element, and no
/// subscription stands below it (a position is not an address, Q11; a `by_key`
/// element crosses with its list).
export impl List<type T: StoreWire> with StoreWire {
	fun store_describe_at(
		&self,
		path: &List<StoreStep>,
		from: usize,
		serializer: &mut Serializer,
		write: bool,
	): StoreReach {
		if from != path.len() {
			ret StoreReach::Absent;
		}
		if write {
			serializer.begin_list(self.len().as_i32());
			for element in self {
				let _described = element.store_describe_at(path, from, serializer, true);
			}
			serializer.end_list();
		}
		StoreReach::Described
	}

	fun store_apply_at(
		&mut self,
		path: &List<StoreStep>,
		from: usize,
		deserializer: &mut Deserializer,
	): StoreReach {
		if from != path.len() {
			ret StoreReach::Absent;
		}
		self = List<T>::store_fresh(deserializer);
		StoreReach::Described
	}

	fun store_read_path(
		deserializer: &mut Deserializer,
		remaining: i32,
		into: &mut List<StoreStep>,
	): bool {
		remaining == 0
	}

	fun store_fresh(deserializer: &mut Deserializer): List<T> {
		let length = deserializer.begin_list();
		mut items: List<T> = [];
		mut index = 0;
		for index < length {
			items.push(T::store_fresh(deserializer));
			index += 1;
		}
		deserializer.end_list();
		items
	}
}

// === `[derive(Storable)]` (§3.1, Q3, Q4, Q9, Q10) =============================
//
// Everything per type is emitted here — the macro door. A derive sees one item at a
// time, so the slot tree is one uniform node type and a field's type is reached
// only through the `Storable` bound: a field whose type nothing derives is a leaf,
// by the tiers above. Per struct it writes:
//
//   - `impl T with Storable`: one diff line per field, in declaration order, each
//     handed the field's child node and whether an answer is still needed;
//   - `impl Store<T>` and `impl StoreSome<T>`: one projection per field, each one
//     in-place step (`|held, f| f(&held.field)`) onto its parent's handle.
//
// Per enum: the diff (the discriminant, then the live payload), and on both handle
// types the discriminant projection per variant (`is_online()`) and, per payload
// variant, the through-variant handle (`online()`, a `StoreSome`).
//
// Every closure the output writes carries its parameter types. The native backend
// types an unannotated closure parameter from the value it is matched against and,
// for a closure-typed one, drops the view on ITS parameter (`|&F| void` arrives as
// `|F| void`), which rustc refuses.

/// The members of the handle surface — `Store`'s, `StoreSome`'s and every `Source`,
/// `Signal` and `Flow` member a handle reaches. An inherent member wins over a
/// generated projection of the same name (spec `names.md` §4.6), so a field
/// spelled like one could never be reached; the derive refuses it (Q9).
macro fun store_reserved(name: str): bool {
	let reserved = [
		"get",
		"set",
		"set_with",
		"notify",
		"new",
		"on_settle",
		"attach_observer",
		"identity",
		"constant",
		"start",
		"on_change",
		"sub",
		"effect",
		"effect_on_change",
		"scoped_effect",
		"scoped_effect_on_change",
		"derive",
		"switch",
		"distinct",
		"distinct_by",
		"switch_some",
		"and_then",
		"then_some",
		"flatten",
		"track",
		"load",
		"bind",
		"delta_cursor",
		"delta_since",
		"drop_delta_cursor",
		"start_element",
		"start_element_value",
		"coll",
		"coll_by",
		"place",
		"apply",
		"bind_attribute",
		"project",
		"descend",
		"variant",
		"tag",
		"some",
		"is_some",
		"assume",
		"patch",
		"live",
	];
	for word in reserved {
		if word == name {
			ret true;
		}
	}
	false
}

/// `Online` -> `online`, `HttpError` -> `http_error`: a variant's projection names.
macro fun store_snake(name: str): str {
	mut out = "";
	mut index: usize = 0;
	for index < name.len() {
		let letter = name.substring(index, index + 1);
		let lower = letter.to_lowercase();
		if lower != letter && index > 0 {
			out = out + "_";
		}
		out = out + lower;
		index = index + 1;
	}
	out
}

/// A written type as it stands inside a closure type's parameter list: a closure
/// type is parenthesized, so `|&F| void` over `F = || void` stays one type.
macro fun store_operand(type_: TypeExpr): str {
	let written = type_.render();
	if written.contains("|") {
		ret i"({written})";
	}
	written
}

/// Whether a written type is a closure type — `|&F| void`, `|| void`.
macro fun store_is_closure(type_: TypeExpr): bool {
	type_.render().contains("|")
}

/// The diff a payload position takes: a closure-typed one is a leaf, through
/// `StoreLeaf` (see `store_struct_impls`); every other type is `Storable`.
macro fun store_step(type_: TypeExpr): str {
	if store_is_closure(type_) {
		"store_leaf_diff"
	} else {
		"store_diff"
	}
}

/// The `<type A, type B>` an inherent impl on `Store<Subject<A, B>>` binds, bare.
macro fun store_bare_binders(generics: List<GenericParameter>): str {
	import macro_std::build::join;

	if generics.len() == 0 {
		ret "";
	}
	mut parts: List<str> = [];
	for parameter in generics {
		parts.push(i"type {parameter.name}");
	}
	"<" + join(parts, ", ") + ">"
}

/// One field projection on a handle type (`Store` or `StoreSome`): the in-place
/// read and write of `held.{field}`, one step below the handle's own.
macro fun store_projection(
	handle: str,
	subject: str,
	method: str,
	field: str,
	index: usize,
	type_: TypeExpr,
): str {
	let operand = store_operand(type_);
	let written = type_.render();
	let read = i"|held: &{subject}, f: |&{operand}| void| f(&held.{field})";
	let write = i"|held: &mut {subject}, f: |&mut {operand}| void| f(&mut held.{field})";
	i"fun {method}(self): {handle}<{written}> \{\n\tself.project({index}, {read}, {write})\n" + "}"
}

export macro fun store_struct_impls(target: StructItem): str {
	import macro_std::build::{ impl_of, fun_of };
	import macro_std::panic;

	let subject = target.subject();
	mut diff = fun_of("store_diff")
		.parameter("&self")
		.parameter(i"other: &{subject}")
		.parameter("node: Option<Shared<StoreNode>>")
		.parameter("need: bool")
		.parameter("woken: &mut StoreWoken")
		.returns("bool")
		.line("if !need && node.is_none() {\n\tret false;\n}")
		.line("let here = need || store_has_me(node);")
		.line("mut changed = false;");
	mut store_impl = impl_of(i"Store<{target.name}{store_bare_binders(target.generics)}>");
	mut some_impl = impl_of(i"StoreSome<{target.name}{store_bare_binders(target.generics)}>");
	mut index: usize = 0;
	for field in target.fields {
		let method = if field.reactive_name != "" { field.reactive_name } else { field.name };
		if store_reserved(method) {
			panic(i"`[derive(Storable)]` on `{target.name}`: the field `{field.name}` would project as `{method}()`, which a store handle already has (`{method}` is a handle member, and an inherent member wins over a projection) — rename the projection with `[reactive(name = \"..\")]` on the field");
		}
		// A coarse field is diffed whole, through the leaf tiers. So is a
		// closure-typed one: a blanket reaches a closure one tier deep (B508), so
		// `StoreLeaf`'s bare tier answers it, but not yet through `Storable`'s
		// blanket over `StoreLeaf`, a second tier (B508's remainder).
		let step = if field.reactive_coarse || store_is_closure(field.type_) {
			"store_leaf_diff"
		} else {
			"store_diff"
		};
		diff = diff.line(i"changed = self.{field.name}.{step}(&other.{field.name}, store_kid(node, {index}), here && !changed, woken) || changed;");
		store_impl = store_impl.member(store_projection("Store", subject, method, field.name, index, field.type_));
		some_impl = some_impl.member(store_projection("StoreSome", subject, method, field.name, index, field.type_));
		index = index + 1;
	}
	diff = diff.line("store_wake_me(node, changed, woken);").expr("changed");
	mut out = impl_of(target.name)
		.generics(target.binders("Storable"))
		.implements("Storable")
		.method(diff)
		.render();
	if target.fields.len() > 0 {
		out = out + store_impl.render() + some_impl.render();
	}
	out
}

export macro fun store_enum_impls(target: EnumItem): str {
	import macro_std::option::Option::{ self, Some, None };
	import macro_std::build::{ impl_of, fun_of, match_of, join };
	import macro_std::panic;

	let subject = target.subject();
	let name = target.name;
	// Which payload child the WRITTEN value's variant owns: child `1 + i` for
	// variant `i`, child 0 being the discriminant.
	mut to_arms = match_of("other");
	mut index: usize = 0;
	for variant in target.variants {
		let pattern = if variant.payload.len() == 0 {
			i"{name}::{variant.name}"
		} else {
			mut blanks: List<str> = [];
			for _type in variant.payload {
				blanks.push("_");
			}
			i"{name}::{variant.name}({join(blanks, ", ")})"
		};
		to_arms = to_arms.arm(pattern, i"{index + 1}");
		index = index + 1;
	}
	mut self_arms = match_of("self");
	mut store_impl = impl_of(i"Store<{name}{store_bare_binders(target.generics)}>");
	mut some_impl = impl_of(i"StoreSome<{name}{store_bare_binders(target.generics)}>");
	mut seen: List<str> = [];
	index = 0;
	for variant in target.variants {
		let child = index + 1;
		let arity = variant.payload.len();
		let snake = store_snake(variant.name);
		let flag = i"is_{snake}";
		for taken in seen {
			if taken == snake {
				panic(i"`[derive(Storable)]` on `{name}`: two variants project as `{snake}()`");
			}
		}
		seen.push(snake);
		if store_reserved(flag) || (arity > 0 && store_reserved(snake)) {
			panic(i"`[derive(Storable)]` on `{name}`: the variant `{variant.name}` would project as `{snake}()`/`{flag}()`, which a store handle already has — rename the variant");
		}
		mut blanks: List<str> = [];
		mut mine: List<str> = [];
		mut theirs: List<str> = [];
		mut position: usize = 0;
		for _type in variant.payload {
			blanks.push("_");
			mine.push(i"let a{position}");
			theirs.push(i"let b{position}");
			position = position + 1;
		}
		let bare = if arity == 0 {
			i"{name}::{variant.name}"
		} else {
			i"{name}::{variant.name}({join(blanks, ", ")})"
		};
		let test = i"|held: &{subject}| match held \{\n\t{bare} => true,\n\t_ => false,\n" + "}";
		let flag_method = i"fun {flag}(self): StoreFlag \{\n\tself.tag({child}, {test})\n" + "}";
		store_impl = store_impl.member(flag_method);
		some_impl = some_impl.member(flag_method);
		if arity == 0 {
			self_arms = self_arms.arm(bare, match_of("other")
				.arm(bare, "false")
				.arm("_", i"store_switch(node, {child}, to, woken)")
				.render());
		} else {
			let mine_pattern = i"{name}::{variant.name}({join(mine, ", ")})";
			let theirs_pattern = i"{name}::{variant.name}({join(theirs, ", ")})";
			// The payload diff: one position is the payload node itself; several
			// are its children, by position.
			mut same: List<str> = [];
			if arity == 1 {
				let step = store_step(variant.payload[0]);
				same.push(i"a0.{step}(&b0, store_kid(node, {child}), here, woken)");
			} else {
				same.push(i"let payload = store_kid(node, {child});");
				same.push("let deep = here || store_has_me(payload);");
				same.push("mut moved = false;");
				position = 0;
				for type_ in variant.payload {
					let step = store_step(type_);
					same.push(i"moved = a{position}.{step}(&b{position}, store_kid(payload, {position}), deep && !moved, woken) || moved;");
					position = position + 1;
				}
				same.push("store_wake_me(payload, moved, woken);");
				same.push("moved");
			}
			let same_body = if arity == 1 { same[0] } else { "{\n" + join(same, "\n") + "\n}" };
			self_arms = self_arms.arm(mine_pattern, match_of("other")
				.arm(theirs_pattern, same_body)
				.arm("_", i"store_switch(node, {child}, to, woken)")
				.render());
			// The through-variant handle: the payload type, a tuple for several.
			mut payload_types: List<str> = [];
			mut operands: List<str> = [];
			for type_ in variant.payload {
				payload_types.push(type_.render());
				operands.push(store_operand(type_));
			}
			let payload = if arity == 1 {
				payload_types[0]
			} else {
				"(" + join(payload_types, ", ") + ")"
			};
			let operand = if arity == 1 { operands[0] } else { payload };
			mut binds: List<str> = [];
			mut parts: List<str> = [];
			position = 0;
			for _type in variant.payload {
				binds.push(i"let p{position}");
				parts.push(i"p{position}");
				position = position + 1;
			}
			let bound = i"{name}::{variant.name}({join(binds, ", ")})";
			let built = if arity == 1 { "p0" } else { "(" + join(parts, ", ") + ")" };
			mut unpacked: List<str> = [];
			if arity == 1 {
				unpacked.push("payload");
			} else {
				position = 0;
				for _type in variant.payload {
					unpacked.push(i"payload.{position}");
					position = position + 1;
				}
			}
			let read = i"|held: &{subject}, f: |&{operand}| void| \{\n\tmatch held \{\n\t\t{bound} => f(&{built}),\n\t\t_ => \{" + "},\n\t}\n}";
			// One payload is lent IN PLACE: under `match &mut held` its capture is
			// a writable view into the slot (B509), so nothing is copied out or
			// written back. Several are gathered into the tuple the handle lends,
			// then spread back — a tuple of views cannot be formed (Q6).
			let write = if arity == 1 {
				i"|held: &mut {subject}, f: |&mut {operand}| void| \{\n\tmatch &mut held \{\n\t\t{name}::{variant.name}(let p0) => f(p0),\n\t\t_ => \{" + "},\n\t}\n}"
			} else {
				i"|held: &mut {subject}, f: |&mut {operand}| void| \{\n\tmatch held \{\n\t\t{bound} => \{\n\t\t\tmut payload = {built};\n\t\t\tf(&mut payload);\n\t\t\theld = {name}::{variant.name}({join(unpacked, ", ")});\n\t\t" + "},\n\t\t_ => {},\n\t}\n}"
			};
			let through = i"fun {snake}(self): StoreSome<{payload}> \{\n\tself.variant({child}, {read}, {write})\n" + "}";
			store_impl = store_impl.member(through);
			some_impl = some_impl.member(through);
		}
		index = index + 1;
	}
	let diff = fun_of("store_diff")
		.parameter("&self")
		.parameter(i"other: &{subject}")
		.parameter("node: Option<Shared<StoreNode>>")
		.parameter("need: bool")
		.parameter("woken: &mut StoreWoken")
		.returns("bool")
		.line("if !need && node.is_none() {\n\tret false;\n}")
		.line("let here = need || store_has_me(node);")
		.line(i"let to: usize = {to_arms.render()};")
		.line(i"let changed = {self_arms.render()};")
		.line("store_wake_me(node, changed, woken);")
		.expr("changed");
	impl_of(name)
		.generics(target.binders("Storable"))
		.implements("Storable")
		.method(diff)
		.render()
		+ store_impl.render()
		+ some_impl.render()
}

/// The parameter lists of `StoreWire`'s three walking methods, as the derive writes
/// them.
macro fun store_wire_describe_parameters(): str {
	"&self, path: &List<StoreStep>, from: usize, serializer: &mut Serializer, write: bool"
}

macro fun store_wire_apply_parameters(): str {
	"&mut self, path: &List<StoreStep>, from: usize, deserializer: &mut Deserializer"
}

macro fun store_wire_read_parameters(): str {
	"deserializer: &mut Deserializer, remaining: i32, into: &mut List<StoreStep>"
}

/// `if {test} {\n\t{body}\n}`, the shape every step arm takes.
macro fun store_wire_if(test: str, body: List<str>): str {
	import macro_std::build::{ join, indent };

	"if " + test + " {\n" + indent(join(body, "\n"), 1) + "\n}"
}

/// A step arm's tail: the field steps tried in order, then `Absent`; a key step
/// names nothing below a struct or an enum.
macro fun store_wire_step_match(arms: List<str>, absent: str): str {
	import macro_std::build::{ join, indent };

	let binder = if arms.len() == 0 { "_index" } else { "index" };
	mut body = arms;
	body.push(absent);
	"match path[from] {\n"
		+ indent(i"StoreStep::Field(let {binder}) => " + "{\n" + indent(join(body, "\n"), 1) + "\n},", 1)
		+ "\n"
		+ indent(i"StoreStep::Key(let _hash) => {absent},", 1)
		+ "\n}"
}

/// The struct's `StoreWire` (A153 S1): its fields by name at the end of a path,
/// and a field step by the field's child index — the slot tree's.
export macro fun store_struct_wire(target: StructItem): str {
	import macro_std::build::{ impl_of, fun_of, init_of, quote };

	let subject = target.subject();
	mut whole: List<str> = [];
	mut steps: List<str> = [];
	mut apply_whole: List<str> = [];
	mut apply_steps: List<str> = [];
	mut reads: List<str> = [];
	mut fresh: List<str> = [];
	mut literal = init_of(target.name);
	mut index: usize = 0;
	for field in target.fields {
		let label = quote(field.name);
		let written = field.type_.render();
		whole.push(i"serializer.field({label});");
		apply_whole.push(i"deserializer.field({label});");
		fresh.push(i"deserializer.field({label});");
		if store_is_closure(field.type_) {
			// A closure never crosses: the `[rpc]` element rule refuses the type
			// before a frame is written, so these lines only keep the impl whole.
			whole.push("let _closure: bool = store_wire_closure();");
			apply_whole.push("let _closure: bool = store_wire_closure();");
			fresh.push(i"let __{field.name}: {written} = store_wire_closure();");
		} else {
			whole.push(i"let _f{index} = self.{field.name}.store_describe_at(path, from, serializer, true);");
			steps.push(store_wire_if(i"index == {index}", [
				i"ret self.{field.name}.store_describe_at(path, from + 1, serializer, write);",
			]));
			apply_whole.push(i"let _f{index} = self.{field.name}.store_apply_at(path, from, deserializer);");
			apply_steps.push(store_wire_if(i"index == {index}", [
				i"ret self.{field.name}.store_apply_at(path, from + 1, deserializer);",
			]));
			reads.push(store_wire_if(i"index == {index}", [
				i"into.push(StoreStep::Field({index}));",
				i"ret store_read_path_of<{written}>(deserializer, remaining - 1, into);",
			]));
			fresh.push(i"let __{field.name} = store_fresh_of<{written}>(deserializer);");
		}
		literal = literal.field(field.name, i"__{field.name}");
		index = index + 1;
	}
	mut wrote: List<str> = [i"serializer.begin_struct({target.fields.len()});"];
	for line in whole {
		wrote.push(line);
	}
	wrote.push("serializer.end_struct();");
	let describe = fun_of("store_describe_at")
		.parameter(store_wire_describe_parameters())
		.returns("StoreReach")
		.line(store_wire_if("from == path.len()", [
			store_wire_if("write", wrote),
			"ret StoreReach::Described;",
		]))
		.expr(store_wire_step_match(steps, "StoreReach::Absent"));
	mut landed: List<str> = ["deserializer.begin_struct();"];
	for line in apply_whole {
		landed.push(line);
	}
	landed.push("deserializer.end_struct();");
	landed.push("ret StoreReach::Described;");
	let apply = fun_of("store_apply_at")
		.parameter(store_wire_apply_parameters())
		.returns("StoreReach")
		.line(store_wire_if("from == path.len()", landed))
		.expr(store_wire_step_match(apply_steps, "StoreReach::Absent"));
	mut read = fun_of("store_read_path")
		.parameter(store_wire_read_parameters())
		.returns("bool")
		.line("if remaining == 0 {\n\tret true;\n}")
		.line(if reads.len() == 0 {
			"let _index = deserializer.i32_value();"
		} else {
			"let index = deserializer.i32_value();"
		});
	for arm in reads {
		read = read.line(arm);
	}
	read = read.expr("false");
	mut built = fun_of("store_fresh")
		.parameter("deserializer: &mut Deserializer")
		.returns(subject)
		.line("deserializer.begin_struct();");
	for line in fresh {
		built = built.line(line);
	}
	built = built.line("deserializer.end_struct();").expr(literal.render());
	impl_of(target.name)
		.generics(target.binders("StoreWire"))
		.implements("StoreWire")
		.method(describe)
		.method(apply)
		.method(read)
		.method(built)
		.render()
}

/// `m0`, `m1`, .. — the names a gathered payload is spread back from.
macro fun spread_names(arity: usize): List<str> {
	mut names: List<str> = [];
	mut position: usize = 0;
	for position < arity {
		names.push(i"m{position}");
		position = position + 1;
	}
	names
}

/// The enum's `StoreWire` (A153 S1): at the end of a path its tagged variant, as
/// `[derive(Wire)]` writes it (a backed enum its backing value, whole); a step
/// `1 + i` reaches variant `i`'s payload while it is the live one — one payload
/// directly, several by their position one step further, the slot tree's numbering
/// (`store_enum_impls`).
export macro fun store_enum_wire(target: EnumItem): str {
	import macro_std::build::{ impl_of, fun_of, match_of, quote, join, indent };

	let subject = target.subject();
	let name = target.name;
	if target.backing_type != "" {
		// A backed enum crosses as its backing value and has no payload to walk.
		let describe = fun_of("store_describe_at")
			.parameter(store_wire_describe_parameters())
			.returns("StoreReach")
			.line(store_wire_if("from != path.len()", ["ret StoreReach::Absent;"]))
			.line(store_wire_if("write", ["self.store_wire_describe(serializer);"]))
			.expr("StoreReach::Described");
		let apply = fun_of("store_apply_at")
			.parameter(store_wire_apply_parameters())
			.returns("StoreReach")
			.line(store_wire_if("from != path.len()", ["ret StoreReach::Absent;"]))
			.line(i"self = store_wire_rebuild_of<{subject}>(deserializer);")
			.expr("StoreReach::Described");
		let read = fun_of("store_read_path")
			.parameter(store_wire_read_parameters())
			.returns("bool")
			.expr("remaining == 0");
		let built = fun_of("store_fresh")
			.parameter("deserializer: &mut Deserializer")
			.returns(subject)
			.expr(i"store_wire_rebuild_of<{subject}>(deserializer)");
		ret impl_of(name)
			.generics(target.binders("StoreWire"))
			.implements("StoreWire")
			.method(describe)
			.method(apply)
			.method(read)
			.method(built)
			.render();
	}
	mut whole = match_of("self");
	mut steps: List<str> = [];
	mut apply_tags: List<str> = [];
	mut apply_steps: List<str> = [];
	mut reads: List<str> = [];
	mut fresh_tags: List<str> = [];
	mut index: usize = 0;
	for variant in target.variants {
		let child = index + 1;
		let arity = variant.payload.len();
		let tag = quote(variant.name);
		// The variant's pattern, binding each payload `p{i}` — a closure's as
		// `_p{i}`, since nothing reads it: a closure never crosses.
		mut binds: List<str> = [];
		mut position: usize = 0;
		for type_ in variant.payload {
			if store_is_closure(type_) {
				binds.push(i"let _p{position}");
			} else {
				binds.push(i"let p{position}");
			}
			position = position + 1;
		}
		let bound = if arity == 0 {
			i"{name}::{variant.name}"
		} else {
			i"{name}::{variant.name}({join(binds, ", ")})"
		};
		// The whole value, tagged.
		mut described: List<str> = [i"serializer.begin_variant({tag}, {arity});"];
		// A fresh payload, read in order.
		mut payload_reads: List<str> = [];
		mut fresh_parts: List<str> = [];
		position = 0;
		for type_ in variant.payload {
			if store_is_closure(type_) {
				described.push("let _closure: bool = store_wire_closure();");
				payload_reads.push(i"let __p{position}: {type_.render()} = store_wire_closure();");
			} else {
				described.push(i"let _p{position} = p{position}.store_describe_at(path, from, serializer, true);");
				payload_reads.push(i"let __p{position} = store_fresh_of<{type_.render()}>(deserializer);");
			}
			fresh_parts.push(i"__p{position}");
			position = position + 1;
		}
		described.push("serializer.end_variant();");
		whole = whole.arm_block(bound, described);
		let constructed = if arity == 0 {
			i"{name}::{variant.name}"
		} else {
			i"{name}::{variant.name}({join(fresh_parts, ", ")})"
		};
		mut fresh_arm: List<str> = [i"deserializer.begin_variant({tag}, {arity});"];
		for line in payload_reads {
			fresh_arm.push(line);
		}
		fresh_arm.push("deserializer.end_variant();");
		fresh_arm.push(i"ret {constructed};");
		fresh_tags.push(store_wire_if(i"tag == {tag}", fresh_arm));
		// Applied in place: the live variant's payload MERGES (its keyed
		// collections kept), another variant is built fresh.
		mut applied: List<str> = [i"deserializer.begin_variant({tag}, {arity});"];
		mut rebuilt = payload_reads;
		rebuilt.push(i"self = {constructed};");
		if arity == 0 {
			applied.push(i"self = {constructed};");
		} else if arity == 1 && !store_is_closure(variant.payload[0]) {
			// One payload merges IN PLACE: under `match &mut self` its capture is a
			// writable view (B509, the projection's write).
			applied.push(match_of("&mut self")
				.arm_block(i"{name}::{variant.name}(let p0)", [
					"let _p0 = p0.store_apply_at(path, from, deserializer);",
				])
				.arm_block("_", rebuilt)
				.render());
		} else {
			// Several are gathered, merged and spread back — a tuple of views
			// cannot be formed (the projection's Q6).
			mut merged: List<str> = [];
			mut spread: List<str> = [];
			position = 0;
			for type_ in variant.payload {
				if store_is_closure(type_) {
					merged.push(i"let m{position}: {type_.render()} = store_wire_closure();");
				} else {
					merged.push(i"mut m{position} = p{position};");
					merged.push(i"let _m{position} = m{position}.store_apply_at(path, from, deserializer);");
				}
				spread.push(i"m{position}");
				position = position + 1;
			}
			merged.push(i"self = {name}::{variant.name}({join(spread, ", ")});");
			applied.push(match_of("self")
				.arm_block(bound, merged)
				.arm_block("_", rebuilt)
				.render());
		}
		applied.push("deserializer.end_variant();");
		applied.push("ret StoreReach::Described;");
		apply_tags.push(store_wire_if(i"tag == {tag}", applied));
		// The steps into this variant's payload.
		if arity == 1 && !store_is_closure(variant.payload[0]) {
			steps.push(store_wire_if(i"index == {child}", [
				"ret " + match_of("self")
					.arm(bound, "p0.store_describe_at(path, from + 1, serializer, write)")
					.arm("_", "StoreReach::Absent")
					.render()
					+ ";",
			]));
			apply_steps.push(store_wire_if(i"index == {child}", [
				"ret " + match_of("&mut self")
					.arm(i"{name}::{variant.name}(let p0)", "p0.store_apply_at(path, from + 1, deserializer)")
					.arm("_", "StoreReach::Absent")
					.render()
					+ ";",
			]));
			reads.push(store_wire_if(i"index == {child}", [
				i"into.push(StoreStep::Field({child}));",
				i"ret store_read_path_of<{variant.payload[0].render()}>(deserializer, remaining - 1, into);",
			]));
		} else if arity > 1 {
			// The payload node is the tuple of payloads and its children are the
			// positions: described whole as a list, each walked by its own walker.
			mut listed: List<str> = [i"serializer.begin_list({arity});"];
			mut positions: List<str> = [];
			mut read_positions: List<str> = [];
			position = 0;
			for type_ in variant.payload {
				if !store_is_closure(type_) {
					listed.push(i"let _p{position} = p{position}.store_describe_at(path, from + 1, serializer, true);");
					positions.push(store_wire_if(i"position == {position}", [
						i"ret p{position}.store_describe_at(path, from + 2, serializer, write);",
					]));
					read_positions.push(store_wire_if(i"position == {position}", [
						i"into.push(StoreStep::Field({position}));",
						i"ret store_read_path_of<{type_.render()}>(deserializer, remaining - 2, into);",
					]));
				}
				position = position + 1;
			}
			listed.push("serializer.end_list();");
			let binder = if positions.len() == 0 { "_position" } else { "position" };
			mut position_arm = positions;
			position_arm.push("StoreReach::Absent");
			let walked = [
				store_wire_if("from + 1 == path.len()", [
					store_wire_if("write", listed),
					"ret StoreReach::Described;",
				]),
				"match path[from + 1] {\n"
					+ indent(i"StoreStep::Field(let {binder}) => " + "{\n" + indent(join(position_arm, "\n"), 1) + "\n},", 1)
					+ "\n"
					+ indent("StoreStep::Key(let _hash) => StoreReach::Absent,", 1)
					+ "\n}",
			];
			steps.push(store_wire_if(i"index == {child}", [
				"ret " + match_of("self")
					.arm_block(bound, walked)
					.arm("_", "StoreReach::Absent")
					.render()
					+ ";",
			]));
			// Applied: the payloads gathered, the one the path names merged (or all
			// of them, at the payload node), and spread back.
			mut gathered: List<str> = [];
			mut spread: List<str> = [];
			mut listed_in: List<str> = ["let _count = deserializer.begin_list();"];
			mut apply_positions: List<str> = [];
			position = 0;
			for type_ in variant.payload {
				if store_is_closure(type_) {
					gathered.push(i"let m{position}: {type_.render()} = store_wire_closure();");
				} else {
					gathered.push(i"mut m{position} = p{position};");
					listed_in.push(i"let _m{position} = m{position}.store_apply_at(path, from + 1, deserializer);");
					apply_positions.push(store_wire_if(i"position == {position}", [
						i"let landed = m{position}.store_apply_at(path, from + 2, deserializer);",
						i"self = {name}::{variant.name}(" + join(spread_names(arity), ", ") + ");",
						"ret landed;",
					]));
				}
				spread.push(i"m{position}");
				position = position + 1;
			}
			listed_in.push("deserializer.end_list();");
			listed_in.push(i"self = {name}::{variant.name}({join(spread, ", ")});");
			listed_in.push("ret StoreReach::Described;");
			let apply_binder = if apply_positions.len() == 0 { "_position" } else { "position" };
			mut apply_position_arm = apply_positions;
			apply_position_arm.push("StoreReach::Absent");
			mut merged_walk = gathered;
			merged_walk.push(store_wire_if("from + 1 == path.len()", listed_in));
			merged_walk.push("ret match path[from + 1] {\n"
				+ indent(i"StoreStep::Field(let {apply_binder}) => " + "{\n" + indent(join(apply_position_arm, "\n"), 1) + "\n},", 1)
				+ "\n"
				+ indent("StoreStep::Key(let _hash) => StoreReach::Absent,", 1)
				+ "\n};");
			apply_steps.push(store_wire_if(i"index == {child}", [
				match_of("self")
					.arm_block(bound, merged_walk)
					.arm_block("_", ["ret StoreReach::Absent;"])
					.render(),
			]));
			mut read_arm: List<str> = [
				i"into.push(StoreStep::Field({child}));",
				"if remaining == 1 {\n\tret true;\n}",
				if read_positions.len() == 0 {
					"let _position = deserializer.i32_value();"
				} else {
					"let position = deserializer.i32_value();"
				},
			];
			for line in read_positions {
				read_arm.push(line);
			}
			read_arm.push("ret false;");
			reads.push(store_wire_if(i"index == {child}", read_arm));
		}
		index = index + 1;
	}
	let unknown = i"deserializer.fail(i\"unknown variant '\{tag\}' of {name}\");";
	let describe = fun_of("store_describe_at")
		.parameter(store_wire_describe_parameters())
		.returns("StoreReach")
		.line(store_wire_if("from == path.len()", [
			store_wire_if("write", [whole.render()]),
			"ret StoreReach::Described;",
		]))
		.expr(store_wire_step_match(steps, "StoreReach::Absent"));
	mut at_end: List<str> = ["let tag = deserializer.variant_tag();"];
	for arm in apply_tags {
		at_end.push(arm);
	}
	at_end.push(unknown);
	at_end.push("ret StoreReach::Absent;");
	let apply = fun_of("store_apply_at")
		.parameter(store_wire_apply_parameters())
		.returns("StoreReach")
		.line(store_wire_if("from == path.len()", at_end))
		.expr(store_wire_step_match(apply_steps, "StoreReach::Absent"));
	mut read = fun_of("store_read_path")
		.parameter(store_wire_read_parameters())
		.returns("bool")
		.line("if remaining == 0 {\n\tret true;\n}")
		.line(if reads.len() == 0 {
			"let _index = deserializer.i32_value();"
		} else {
			"let index = deserializer.i32_value();"
		});
	for arm in reads {
		read = read.line(arm);
	}
	read = read.expr("false");
	mut built = fun_of("store_fresh")
		.parameter("deserializer: &mut Deserializer")
		.returns(subject)
		.line("let tag = deserializer.variant_tag();");
	for arm in fresh_tags {
		built = built.line(arm);
	}
	// An unknown tag poisons the deserializer, and `Wire`'s own rebuild then
	// answers its zero value — the sticky-error contract.
	built = built.line(unknown).expr(i"store_wire_rebuild_of<{subject}>(deserializer)");
	impl_of(name)
		.generics(target.binders("StoreWire"))
		.implements("StoreWire")
		.method(describe)
		.method(apply)
		.method(read)
		.method(built)
		.render()
}

/// `[derive(Storable)]`: the struct's or enum's store surface (§3.1). Its output
/// carries its own imports, through `std::reactive::store` — the module a program
/// names — which re-exports the core's names. Its `Storable` is two items, the
/// re-exported TRAIT and this derive macro; an import binds the trait, as it does
/// in a hand-written module (B547).
export macro fun Storable(item: Item): Source {
	import macro_std::option::Option::{ self, Some, None };

	let header = "import std::option::Option;\n"
		+ "import std::shared::Shared;\n"
		+ "import std::reactive::store::{ Storable, StoreFlag, StoreLeaf, StoreNode, StoreReach, StoreSlot, StoreStep, StoreWire, StoreWireLeaf, StoreWoken, Store, StoreSome, store_fresh_of, store_has_me, store_kid, store_read_path_of, store_switch, store_wake_me, store_wire_closure, store_wire_rebuild_of };\n"
		+ "import std::wire::{ Deserialize, Deserializer, Serialize, Serializer };\n";
	if item.as_struct() is Some(let target) {
		ret source(header + store_struct_impls(target) + store_struct_wire(target));
	}
	if item.as_enum() is Some(let target) {
		ret source(header + store_enum_impls(target) + store_enum_wire(target));
	}
	source("")
}
