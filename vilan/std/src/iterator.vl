import pkg::option::Option::{ self };

/// The lazy-sequence protocol. `next` advances the iterator's own state, so it
/// takes `&mut self`: a stateful iterator — a cursor, a counter, an adapter
/// holding an upstream — is exactly what this trait is for, and a by-value
/// receiver made every one of them unconformable (I5).
trait Iterator<T> {
	fun next(&mut self): Option<T>;
}

struct IteratorFromFn<T> {
	fn: || Option<T>,
}

impl IteratorFromFn<type T> with Iterator<T> {
	fun next(&mut self) {
		(self.fn)()
	}
}

impl Iterator<type T> {
	fun from_fn(fn: || Option<T>): IteratorFromFn<T> {
		IteratorFromFn { fn }
	}
}

trait Iterable<T> {
	fun iter(self): Iterator<T>;
}

impl Iterator<type T> with Iterable<T> {
	fun iter(self): Iterator<T> {
		self
	}
}
