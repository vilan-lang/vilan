// `Set<T>` is the built-in hash set. It holds unique values compared **by
// value** — a struct/enum/tuple element works as long as it derives `Hashable`
// (I1). Each element is turned into a canonical `Hash` via `value.hash()`, which
// keys the underlying native map; the original value is stored alongside so
// `for x in set` yields real `T`s in insertion order.
import pkg::hash::{ Hash, Hashable };
import pkg::native_map::NativeMap;

struct Set<T: Hashable> {
	table: NativeMap<T>,
}

impl Set<type T: Hashable> {
	fun new(): Set<T> {
		// The annotated `let` directs `NativeMap::new()`'s element type; a
		// struct-literal field doesn't direct a generic call (a known gap).
		let table: NativeMap<T> = NativeMap::new();
		Set { table = table }
	}

	fun insert(&mut self, value: T) {
		self.table.insert(value.hash(), value);
	}

	fun contains(self, value: T): bool {
		self.table.contains_key(value.hash())
	}

	fun remove(&mut self, value: T) {
		self.table.remove(value.hash());
	}

	fun len(self): i32 {
		self.table.len()
	}

	fun is_empty(self): bool {
		self.len() == 0
	}

	/// A `List` snapshot of the elements, in insertion order (`for x in set`
	/// iterates these).
	fun values(self): List<T> {
		self.table.values()
	}

	// `union`/`intersection`/`difference` walk `self.table.values()` rather than
	// `for x in self` — matching `values()` above, and every other method in this
	// file. That started as a workaround: the native `for x in set` lowering used
	// to fire only for an iterable that carried a type on its own expression, so
	// `self` (or any parameter, call result or `*view`) fell through to a loop
	// over the struct's one-element backing array. B85 fixed that at the root —
	// the loop's iterable type now comes from the analyzer — so `for x in self`
	// is a correct way to write these today. The `.table.values()` form stays
	// because it is equivalent and rewriting it would be churn, NOT because the
	// direct form is unsafe.

	/// A new set holding every element that is in `self`, `other`, or both.
	fun union(self, other: Set<T>): Set<T> {
		mut result: Set<T> = Set::new();
		for value in self.table.values() {
			result.insert(value);
		}
		for value in other.table.values() {
			result.insert(value);
		}
		result
	}

	/// A new set holding only the elements present in BOTH `self` and `other`.
	fun intersection(self, other: Set<T>): Set<T> {
		mut result: Set<T> = Set::new();
		for value in self.table.values() {
			if other.contains(value) {
				result.insert(value);
			}
		}
		result
	}

	/// A new set holding the elements of `self` that are NOT in `other`.
	fun difference(self, other: Set<T>): Set<T> {
		mut result: Set<T> = Set::new();
		for value in self.table.values() {
			if !other.contains(value) {
				result.insert(value);
			}
		}
		result
	}
}

/// The set half of the explicit termination family, and the end of an iterator
/// chain: `xs.iter().filter(f).to_list().to_set()`. Duplicates collapse and the
/// first occurrence of each value decides its position.
///
/// It lives on `List` rather than on `Iterator` because the bound has nowhere
/// else to go: `T: Hashable` is not a bound `Iterator<T>` declares, a trait
/// default may not require one the trait does not, and a member cannot carry
/// its own — so `to_set` on the trait would be a compile error at its own
/// definition. This is the `join`-on-`Display` precedent: the method lives
/// beside the bound it needs.
impl List<type T: Hashable> {
	fun to_set(self): Set<T> {
		mut result: Set<T> = Set::new();
		for value in self {
			result.insert(value);
		}
		result
	}
}
