// std::math — mathematical constants and generic free functions (backlog K2).
//
// The METHOD families on the numeric types (`x.sin()`, `x.abs()`, `x.rem(m)`)
// are the primary surface and live in `number.vl`; this module holds what has
// no receiver: the constants, and the `Ord`-generic free functions (moved
// here from `compare.vl` — the trait METHODS `Ord::min`/`max`/`clamp` stay
// there). The surface is bounded to what `libm` provides, so the native
// backends (F3/F4) stay implementable — no JS-isms.

import pkg::compare::{ Ord, PartialEq };
import pkg::operators::{ Add, Sub };

// --- Constants -----------------------------------------------------------------
//
// Plain module-level values. `EPSILON` is computed (the lexer has no exponent
// literals): 2^-52 is exactly f64's unit of least precision at 1.0.
// `INFINITY`/`NAN` are the IEEE results of the expressions that define them.

let PI: f64 = 3.141592653589793;
let TAU: f64 = 6.283185307179586;
let E: f64 = 2.718281828459045;
let EPSILON: f64 = 2f.pow(0f - 52f);
let INFINITY: f64 = 1f / 0f;
let NAN: f64 = 0f / 0f;

// --- Generic comparisons ---------------------------------------------------------
//
// Free-function forms of the `Ord` methods, for call sites without a natural
// receiver (`min(a, b)` over `a.min(b)`).

fun min<T: Ord>(a: T, b: T): T {
	a.min(b)
}

fun max<T: Ord>(a: T, b: T): T {
	a.max(b)
}

/// Both values, ordered — `(smaller, larger)`.
fun minmax<T: Ord>(a: T, b: T): (T, T) {
	if a <= b {
		(a, b)
	} else {
		(b, a)
	}
}

// --- 2-D vectors -----------------------------------------------------------
//
// The smallest vector value the estate actually asks for (A83). Pointer drags
// measure offsets, distances and thresholds, and an app without this writes
// `magnitude((x, y): (f64, f64))` by hand — the exhibit is kolt's
// `interact.vl`, with a TODO on it asking for exactly this.
//
// A NAMED type rather than a `(f64, f64)` tuple, because the call site reads:
// `origin.distance(pointer)` says what it measures, while `distance(a, b)`
// over two pairs says only that four numbers went in — and a tuple of two
// floats is also a size, a range and a pair of weights, so nothing catches the
// argument that was none of those.
//
// The components are plain `f64` and carry NO UNIT: they are CSS pixels at a
// UI call site and metres at a physics one, so a `Length` here would be a
// claim this module cannot make. Only what `libm` provides is used (`sqrt`),
// so the native backends (F3/F4) stay implementable, exactly as the constants
// above do.

/// A 2-D vector — a point, an offset, a velocity, a size: whichever the call
/// site means, in its own units.
struct Vec2 {
	x: f64,
	y: f64,
}

impl Vec2 {
	/// `self` with both components multiplied by `factor` — the scalar half
	/// of the arithmetic, which `Mul` cannot carry: the operator traits take
	/// ONE other operand type per impl, and `Vec2 * Vec2` would be the more
	/// natural claim on `Mul` if this module ever wanted a component-wise
	/// product. A method says which of the two it is.
	fun scale(self, factor: f64): Vec2 {
		Vec2 { x = self.x * factor, y = self.y * factor }
	}

	/// The vector's LENGTH from the origin (its magnitude) — `sqrt(x² + y²)`.
	/// Comparing two lengths, or a length against a threshold, does not need
	/// the square root: reach for `length_squared` and square the threshold.
	fun length(self): f64 {
		self.length_squared().sqrt()
	}

	/// The length WITHOUT the square root — `x² + y²`, which is `self.dot(self)`
	/// under the name the comparison actually wants. `sqrt` is monotonic, so
	/// `a.length() < b.length()` and `a.length_squared() < b.length_squared()`
	/// agree on every pair, and a THRESHOLD comparison squares the threshold
	/// once instead of taking a root per sample:
	///
	///     if moved.length_squared() > drag_threshold * drag_threshold { … }
	///
	/// Which is a pointer-move handler's whole arithmetic, run on every event.
	/// It is a name for a comparison, not a faster `length`: take the root when
	/// the NUMBER is the answer.
	fun length_squared(self): f64 {
		self.dot(self)
	}

	/// The distance between the two points `self` and `other` — the length of
	/// the vector between them, and the reason this type exists at a drag
	/// call site.
	fun distance(self, other: Vec2): f64 {
		self.sub(other).length()
	}

	/// The dot product `self.x * other.x + self.y * other.y`. Zero when the
	/// two are perpendicular, and `v.dot(v)` is `v`'s length squared.
	fun dot(self, other: Vec2): f64 {
		self.x * other.x + self.y * other.y
	}
}

/// Component-wise addition — `a + b` as well as `a.add(b)`.
impl Vec2 with Add {
	fun add(self, b: Vec2): Vec2 {
		Vec2 { x = self.x + b.x, y = self.y + b.y }
	}
}

/// Component-wise subtraction. `pointer - origin` is the offset of a drag, and
/// the operand order reads the way the arithmetic does.
impl Vec2 with Sub {
	fun sub(self, b: Vec2): Vec2 {
		Vec2 { x = self.x - b.x, y = self.y - b.y }
	}
}

/// Exact component equality — `f64` equality, with everything that implies: a
/// vector arrived at by arithmetic is rarely `==` one written down. Compare a
/// `distance` against a tolerance where that matters. It is here because a
/// `Vec2` in a signal wants the dedupe (`swap`, `bind_each`, `set` on a
/// `PartialEq` mirror all ask for it) and a hand-written impl is what a std
/// struct can have — a derive would dispatch a macro at world-load.
impl Vec2 with PartialEq {
	fun eq(self, b: Vec2): bool {
		self.x == b.x && self.y == b.y
	}
}
