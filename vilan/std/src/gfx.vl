// `std::gfx` — a window drawn by the GPU, for a native program (native-ui.md part
// P1; its section 9 RULED 2026-11-10).
//
// A program opens a window, and each frame its frame callback is handed a `Frame`
// to fill with primitives in display pixels (dp): rounded rectangles with gradients
// and borders, shadows, text, underlines, textures and paths (gfx-path.md), under
// clips, transforms and opacity layers. Frames are drawn ON DEMAND — when the
// window opens, resizes or changes scale, and when the program asks
// (`request_redraw`) — so an idle window costs nothing. Input arrives as `Event`
// values through the window's event callback.
//
// NATIVE ONLY. Its runtime is the `vilan-rt-gfx` crate (`wgpu` + `winit` + a
// renderer of its own, text by `parley`), which a generated cargo project links
// only when the program reaches this module. The JavaScript backend refuses a
// program that reaches it, by name, when it builds; `vilan check` does not,
// because a check is the same for both backends. A process module: a browser
// entry that reaches it is refused by the platform check.
//
// ONE THREAD (R8): the window system's loop owns the main thread and runs the
// program's event loop inside it, so every callback here runs on the thread that
// draws, between the window system's events, never beside them.
//
// `dp` is the only length unit (native-ui.md section 5), and it is a TYPE here
// (`Dp`), not a bare number: device pixels never appear in this surface at all
// — positions, sizes and every primitive are in dp, the scale factor is a plain
// ratio — and `Dp` keeps a dp length from being mixed with a number that is not
// one (a scale, an opacity, a count) without saying so. `dp(8)` makes one;
// `Dp + Dp`, `Dp - Dp`, `Dp * f64` and `Dp / f64` are lengths; `.value()` is
// the number.
//
// Closing the LAST window stops the program the way SIGTERM does: servers stop
// accepting and drain, the event loop ends, `main` returns, exit code 0.
//
// Not here yet (native-ui.md section 8): icons as elements (`std::ui`), more than
// one window, rotation, text editing, input methods, publishing accessibility.
// Shared code never names this module (D4).

[platform("@process")] mod self;

import pkg::bytes::Bytes;
import pkg::compare::{ Ordering, PartialEq, PartialOrd };
import pkg::image::Image;
import pkg::operators::{ Add, Div, Mul, Sub };
import pkg::option::Option::{ self, None, Some };
import pkg::result::Result::{ self, Err, Ok };

// --- The seam ------------------------------------------------------------------
//
// `vilan-rt-gfx`'s `host` module. A window crosses as its id and a frame as its
// token; a primitive crosses as the numbers it is made of (one call each, nothing
// allocated per primitive); an event as a kind code and numbers read one at a time.
// The event table is kept by `crates/vilan-rt-gfx/src/host/input.rs` too:
//
//   kind  event              numbers                                text
//   0     pointer moved      x, y
//   1     pointer pressed    x, y, button, modifiers
//   2     pointer released   x, y, button, modifiers
//   3     pointer left
//   4     scrolled           x, y, delta x, delta y, modifiers
//   5     key pressed        repeat, modifiers, named               the key
//   6     key released       repeat, modifiers, named               the key
//   7     text input                                                the text
//   8     resized            width, height
//   9     scale changed      scale factor
//   10    close requested
//
// A button is 0 left, 1 right, 2 middle, 3 back, 4 forward, 5 + n other; the
// modifiers are bits, 1 shift, 2 control, 4 alt, 8 meta; `named` is 1 for a key
// that types nothing (its name is winit's, which is the web's) and 0 for a key that
// types its text.

[extern("__gfx_open")]
async external fun gfx_open(
	title: str,
	width: f64,
	height: f64,
	red: f64,
	green: f64,
	blue: f64,
	alpha: f64,
): Result<u32, str>;

[extern("__gfx_close")]
external fun gfx_close(window: u32): void;

[extern("__gfx_request_redraw")]
external fun gfx_request_redraw(window: u32): void;

[extern("__gfx_on_frame")]
external fun gfx_on_frame(window: u32, callback: || void): void;

[extern("__gfx_on_event")]
external fun gfx_on_event(window: u32, callback: || void): void;

/// The window's width (0) and height (1) in dp, its scale factor (2).
[extern("__gfx_window_number")]
external fun gfx_window_number(window: u32, which: i32): f64;

[extern("__gfx_event_next")]
