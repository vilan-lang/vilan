/// One segment: `verb` 0 move, 1 line, 2 quadratic, 3 cubic, 4 arc (radii,
/// rotation, the large and sweep flags as 0 or 1, the end), 5 close; its numbers
/// in order, unused ones 0.
[extern("__gfx_path_segment")]
external fun gfx_path_segment(
	builder: PathBuilder,
	verb: i32,
	a: f64,
	b: f64,
	c: f64,
	d: f64,
	e: f64,
	f: f64,
