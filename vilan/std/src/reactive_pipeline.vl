// === A124 S1 — the push-pull pipeline, built over TODAY's `Source` ===========
//
// EVIDENCE, NOT SURFACE (`proposal/reactive-pipeline.md` §7). Nothing here is
// re-exported through `std::reactive`, named in a prelude, or used by any other
// std module: it exists so the paper's claims are measured rather than argued,
// and it needs no compiler change — every node is an ordinary struct, every
// combinator an ordinary blanket, exactly probe `a124_h_blanket_adapter.vl`'s
// shape at std scale.
//
// The model (paper §2):
//
//   * A node is COLD and STATELESS. `Map` holds its upstream and its transform
//     and nothing else; `get()` PULLS through the chain; a node allocates no
//     cell and computes nothing until someone reads or subscribes.
//   * A notification carries NO PAYLOAD (R2). `Source::on_settle` — the
//     protocol itself since A124 S2a, on the read trait and no longer a twin
//     trait here — tells a downstream THAT something changed; the leaf pulls the
//     value through `get()`. A node FORWARDS the subscriber it is handed, so a
//     linear chain puts ONE record on its root however deep it is, and a
//     diamond puts the same record there twice, which a turn's dedup collapses
//     (the id is the leaf's — `Subscriber`).
//   * A node's own `on_change` is the leaf: mint one subscriber that pulls,
//     attach it through `on_settle`. So every node is a `Source`, and
//     `effect`/`sub`/`bind` work on one unchanged.
//   * State lives at the ends: the root cell, and `.cell()` — one more node,
//     composable anywhere, that materialises what is above it into a cached
//     `SignalCell` for an efficient shared or hot-read value (R2's note).
import pkg::option::Option::{ self, None, Some };
import pkg::reactive::{
	SignalCell,
	Source,
	Subscriber,
	Subscription,
	fresh_id,
	register_with_owner,
};
import pkg::shared::Shared;

/// The LEAF, and every node's `on_change`: ONE subscriber, minted here, whose
/// notification pulls `source`; `on_settle` carries it to the root untouched.
///
/// Minted BY HAND from the public record, because the probe is a module of its own
/// and `std::reactive`'s minting helper is private to it — which is also why
/// `derived` is an argument: `.cell()` below is the one derivation-class leaf.
fun leaf<T, S: Source<T>>(source: S, derived: bool, notify: || void): Subscription {
	source.on_settle(minted(notify, derived))
}

/// One observer's record: a fresh id and its own liveness cell.
fun minted(notify: || void, derived: bool): Subscriber {
	Subscriber { id = fresh_id(), notify, live = Shared::new(true), derived }
}

/// `map` as a NODE: the upstream, the transform, nothing else.
///
/// The transform is held plain (`|T| U`, not `sync |T| U`): the `sync` contract
/// is accepted on a PARAMETER and not on a field, so it is checked at the
/// combinator that builds the node — the J2 pattern `std::rpc` already uses.
export struct Map<S, T, U> {
	up: S,
	transform: |T| U,
}

export impl Map<type S: Source<type T>, T, type U> with Source<U> {
	/// The PULL: one call up the chain, one application of the transform. A cold
	/// node's whole cost, paid by the reader.
	fun get(self): U {
		(self.transform)(self.up.get())
	}

	/// The payload form, derived from the no-payload one — this is where a leaf
	/// that wants values re-enters.
	fun on_change(self, observer: |U| void): Subscription {
		leaf(self, false, || observer(self.get()))
	}

	/// FORWARDED, not wrapped: no subscriber minted here, no transform run.
	fun on_settle(self, subscriber: Subscriber): Subscription {
		self.up.on_settle(subscriber)
	}
}

/// `switch` as a NODE (A123's dynamic dependency, cold): the inner source is chosen
/// by the current value of the upstream at every read.
///
/// The rolling registration is the one thing a cold `Switch` cannot avoid
/// keeping: a downstream told "something settled" must be told again when the
/// NEW inner changes, and only a live registration can do that. Here it is the
/// PAYLOAD shape — its own two registrations over `on_change` — and it takes
/// `Source::on_settle`'s default, the bridge that wakes a downstream through
/// the turn: a relay has to wake through the turn to dedup, and the waking
/// helper is private to `std::reactive`.
export struct Switch<S, T, I> {
	up: S,
	select: |T| I,
}

export impl Switch<type S: Source<type T>, T, type I: Source<type U>> with Source<U> {
	fun get(self): U {
		(self.select)(self.up.get()).get()
	}

	fun on_change(self, observer: |U| void): Subscription {
		let inner_subscription: Shared<Option<Subscription>> = Shared::new(None);
		let attach = || {
			inner_subscription.read()?.dispose();
			inner_subscription.write() = Some((self.select)(self.up.get()).on_change(|_value| {
				observer(self.get());
			}));
		};
		attach();
		let outer = self.up.on_change(|_value| {
			attach();
			observer(self.get());
		});
		Subscription::teardown(|| {
			inner_subscription.read()?.dispose();
			inner_subscription.write() = None;
			outer.dispose();
		})
	}
}

/// `combine` as a NODE over a PAIR. The paper writes the family over a tuple bound;
/// the pair is what S1 needs to measure a diamond, and the n-ary shape is the same
/// body with one more field.
export struct Combine<A, B> {
	left: A,
	right: B,
}

export impl Combine<type A: Source<type X>, type B: Source<type Y>> with Source<(X, Y)> {
	fun get(self): (X, Y) {
		(self.left.get(), self.right.get())
	}

	/// The leaf, minted by hand and attached through `attach_arms` DIRECTLY — not
	/// through `leaf`'s `on_settle` dispatch. A default overridden by an impl whose
	/// trait argument is a TUPLE is not selected through a generic bound: the call
	/// lands on `Source::on_settle`'s default, whose bridge calls back into this
	/// `on_change`, and the two recurse until the stack is gone. Found building S2a
	/// and filed; written around here the way A123 wrote `switch` over `on_change`.
	fun on_change(self, observer: |(X, Y)| void): Subscription {
		self.attach_arms(minted(|| observer(self.get()), false))
	}

	fun on_settle(self, subscriber: Subscriber): Subscription {
		self.attach_arms(subscriber)
	}
}

export impl Combine<type A: Source<type X>, type B: Source<type Y>> {
	/// The SAME subscriber forwarded to both inputs — so a diamond standing on one
	/// root puts ONE observer's record on it twice. Inline (no turn) that is two
	/// calls, each reading a settled pair; in a turn `enqueue`'s dedup keys on the
	/// leaf's id and it is one (A124 S2a). The handle disposes both arms, and each
	/// retires the same subscriber.
	fun attach_arms(self, subscriber: Subscriber): Subscription {
		let left = self.left.on_settle(subscriber);
		let right = self.right.on_settle(subscriber);
		Subscription::teardown(|| {
			left.dispose();
			right.dispose();
		})
	}
}

/// The combinators — blanket methods over the read trait, each returning a concrete
/// node. Named with a `_node` suffix ONLY so this file can live beside today's
/// `map`/`switch`/`combine` in one program; the surface S2 would ship keeps the
/// plain names (R4).
export impl type S: Source<type T> {
	fun map_node<U>(self, transform: sync |T| U): Map<S, T, U> {
		Map<S, T, U> { up = self, transform }
	}

	fun switch_node<U, I: Source<U>>(self, select: sync |T| I): Switch<S, T, I> {
		Switch<S, T, I> { up = self, select }
	}

	fun combine_node<Y, B: Source<Y>>(self, other: B): Combine<S, B> {
		Combine<S, B> { left = self, right = other }
	}

	/// `.cell()` (R2, the owner's name) — the ONE stateful node: materialise what
	/// is above into a cached cell with an ambient-owner-tied registration, a
	/// DERIVATION-class leaf so door 2 settles it before any effect. Composable
	/// anywhere: the result is a `SignalCell`, a `Source` again, so a chain
	/// continues through it.
	fun cell(self): SignalCell<T> {
		let cached = SignalCell::new(self.get());
		let _owned = register_with_owner(leaf(self, true, || {
			cached.set(self.get());
		}));
		cached
	}
}

/// The LEAF, as a free function: the observer gets the pulled value once per
/// settle. A LINEAR chain puts exactly one record on its root however deep it is; a
/// diamond puts the same record there once per arm, and a turn calls it once.
export fun watch<T, S: Source<T>>(source: S, observer: |T| void): Subscription {
	leaf(source, false, || observer(source.get()))
}
