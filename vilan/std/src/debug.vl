// `std::debug` — `[derive(Debug)]` synthesizes `debug(self): str`, a developer
// representation `Type { field = value, … }` / `Type::Variant(..)` built from the
// fields: the `dbg` printer's spelling on one line (E275), so the two agree. Numbers
// and bools format raw, a string quoted and escaped as vilan writes it, and a field
// recurses through its own `debug` — a written impl's, when the field's type has one.

import pkg::option::Option::{ self, None, Some };
import pkg::result::Result::{ self, Err, Ok };
import pkg::tuple::Tuple;

export *;

trait Debug {
	fun debug(self): str;
}

impl str with Debug {
	/// Quoted, with `\\`, `\"`, `\n`, `\t`, `\r` and `\0` escaped: the `dbg`
	/// printer's spelling (E275).
	fun debug(self): str {
		let escaped = self
			.replace("\\", "\\\\")
			.replace("\"", "\\\"")
			.replace("\n", "\\n")
			.replace("\t", "\\t")
			.replace("\r", "\\r")
			.replace("\0", "\\0");
		"\"" + escaped + "\""
	}
}

impl i32 with Debug {
	[extern("JSON.stringify")]
	external fun debug(self): str;
}

impl u32 with Debug {
	[extern("JSON.stringify")]
	external fun debug(self): str;
}

impl f64 with Debug {
	/// The language's number text, keeping the `.0` an integral value drops (`3.0`,
	/// not `3`), and negative zero as `-0.0`: `dbg`'s rule (debugging.md S4, E260,
	/// E276).
	fun debug(self): str {
		if self == 0.0 && 1.0 / self < 0.0 {
			ret "-0.0";
		}
		let text = "" + self;
		if text.contains(".") || text.contains("e") || text.contains("N") || text.contains("I") {
			text
		} else {
			text + ".0"
		}
	}
}

impl bool with Debug {
	[extern("JSON.stringify")]
	external fun debug(self): str;
}

/// Its digits, as `dbg` prints a `BigInt` (`10`, not `10n`) (E283).
impl BigInt with Debug {
	fun debug(self): str {
		i"{self}"
	}
}

// Every container the `dbg` printer prints is `Debug` when its elements are
// (debugging.md S4, E260), so a struct with a `List` or `Option` field derives it
// and `T: Debug` takes a list, an option, a result or a tuple. The rendering is the
// printer's, on one line.

impl List<type T: Debug> with Debug {
	fun debug(self): str {
		mut out = "[";
		mut first = true;
		for item in self {
			if !first {
				out = out + ", ";
			}
			first = false;
			out = out + item.debug();
		}
		out + "]"
	}
}

impl Option<type T: Debug> with Debug {
	fun debug(self): str {
		match self {
			Some(let value) => "Some(" + value.debug() + ")",
			None => "None",
		}
	}
}

impl Result<type T: Debug, type E: Debug> with Debug {
	fun debug(self): str {
		match self {
			Ok(let value) => "Ok(" + value.debug() + ")",
			Err(let error) => "Err(" + error.debug() + ")",
		}
	}
}

/// A tuple of `Debug` elements, at any arity: `(1, "two", 2.5)`. The blanket covers
/// the tuple family and nothing else (B557).
impl type T: (2..: Debug) with Debug {
	fun debug(self): str {
		mut out = "(";
		mut first = true;
		for key in self.keys() {
			if !first {
				out = out + ", ";
			}
			first = false;
			out = out + self.get(key).debug();
		}
		out + ")"
	}
}

// The `Debug` derive: a prelude macro (this module is always loaded).

macro fun Debug(item: Item): Source {
	import macro_std::option::Option::{ self, Some, None };
	import macro_std::build::{ impl_of, fun_of, match_of, quote, join };

	// Debug output glues text fragments around each `.debug()` call, so the pieces
	// join on ` + ", " + ` — a quoted separator between quoted labels.
	let glued_comma = " + " + quote(", ") + " + ";

	if item.as_struct() is Some(let target) {
		// `"T { " + "a = " + self.a.debug() + ", " + … + " }"`; a field-less struct
		// is just its name.
		mut body = "";
		if target.fields.len() == 0 {
			body = quote(target.name);
		} else {
			mut parts: List<str> = [];
			for field in target.fields {
				parts.push(quote(i"{field.name} = ")
					+ " + "
					+ debug_member(i"self.{field.name}", field.type_.render()));
			}
			body = quote(i"{target.name} \{ ")
				+ " + "
				+ join(parts, glued_comma)
				+ " + "
				+ quote(" }");
		}
		let printer = fun_of("debug").parameter("self").returns("str").expr(body);
		ret source("import std::debug::Debug;\n" + impl_of(target.name)
			.generics(target.binders("Debug"))
			.implements("Debug")
			.method(printer)
			.render());
	}
	if item.as_enum() is Some(let target) {
		// `match self { E::V(let p0,..) => "E::V(" + p0.debug() + ", " + .. +
		// ")", E::W => "E::W" }` — qualified, as `dbg` prints a variant (E275).
		mut arms = match_of("self");
		for variant in target.variants {
			let arity = variant.payload.len();
			if arity == 0 {
				arms = arms.arm(i"{target.name}::{variant.name}", quote(i"{target.name}::{variant.name}"));
			} else {
				mut binds: List<str> = [];
				mut parts: List<str> = [];
				mut index = 0;
				for index < arity {
					binds.push(i"let p{index}");
					parts.push(debug_member(i"p{index}", variant.payload[index].render()));
					index = index + 1;
				}
				let bind_pattern = join(binds, ", ");
				let rendering = quote(i"{target.name}::{variant.name}(")
					+ " + "
					+ join(parts, glued_comma)
					+ " + "
					+ quote(")");
				arms = arms.arm(i"{target.name}::{variant.name}({bind_pattern})", rendering);
			}
		}
		let printer = fun_of("debug").parameter("self").returns("str").expr(arms.render());
		ret source("import std::debug::Debug;\n" + impl_of(target.name)
			.generics(target.binders("Debug"))
			.implements("Debug")
			.method(printer)
			.render());
	}
	source("")
}

/// The `Debug` derive's rendering of one member at `place`, an expression of
/// type `str`. A closure has no `Debug` to call, so it prints its written type
/// as `dbg` does (`<closure |i32| i32>`); a fixed array of a LITERAL length
/// prints element by element (`[1, 2]`) until arrays of every length take an
/// impl (array-lengths.md S2); anything else calls its `debug` (E283).
macro fun debug_member(place: str, written: str): str {
	import macro_std::option::Option::{ self, Some, None };
	import macro_std::build::{ quote, join };

	if written.starts_with("|") {
		ret quote("<closure " + written + ">");
	}
	if written.starts_with("[") && written.ends_with("]") && written.contains(";") {
		let inner = written.substring(1, written.len() - 1);
		let parts = inner.split(";");
		let length = parts[parts.len() - 1].trim().parse_i32();
		if length is Some(let count) {
			mut element = "";
			mut index: usize = 0;
			for index + 1 < parts.len() {
				if index > 0 {
					element = element + ";";
				}
				element = element + parts[index];
				index = index + 1;
			}
			element = element.trim();
			if count == 0 {
				ret quote("[]");
			}
			mut items: List<str> = [];
			mut at = 0;
			for at < count {
				items.push(debug_member(i"{place}[{at}]", element));
				at = at + 1;
			}
			ret quote("[") + " + " + join(items, " + " + quote(", ") + " + ") + " + " + quote("]");
		}
	}
	place + ".debug()"
}

// --- Locations (debugging.md S0) ---

/// Where a call was made: the file relative to its package root (std's own as
/// `std/src/..`), a 1-based line and a 1-based column — `src/main.vl:12:5`. A
/// `[track_caller]` function receives its caller's as a hidden parameter, and
/// `caller()` reads it.
external struct Location;

impl Location {
	/// The location as written: `file:line:column`.
	[extern("String")]
	external fun text(self): str;

	/// The file, relative to its package root.
	fun file(self): str {
		let parts = self.text().split(":");
		mut file = "";
		mut index: usize = 0;
		for index + 2 < parts.len() {
			if index > 0 {
				file = file + ":";
			}
			file = file + parts[index];
			index = index + 1;
		}
		file
	}

	/// The 1-based line.
	fun line(self): i32 {
		let parts = self.text().split(":");
		parts[parts.len() - 2].parse_i32().unwrap_or(0)
	}

	/// The 1-based column, in characters.
	fun column(self): i32 {
		let parts = self.text().split(":");
		parts[parts.len() - 1].parse_i32().unwrap_or(0)
	}
}

/// Inside a `[track_caller]` function, the location it was called from;
/// anywhere else, the location of this call itself.
[track_caller]
external fun caller(): Location;

// --- `dbg` (debugging.md S1) ---

/// `dbg(a, b, ..)` prints each argument to stderr (`console.log` in the
/// browser) as `[src/main.vl:12:5] expr = value`, in vilan's own literal syntax
/// (`Point { x = 1, y = 2 }`, `Some(5)`, `[1, 2]`, `3.0`), the same bytes on
/// both backends. It answers its argument — a tuple of them for several, `()`
/// for none — so it can wrap an expression: `let total = dbg(price * qty) +
/// tax;`. Written as a statement (`dbg(guard);`) it reads its arguments in
/// place and moves nothing. It takes ANY number of arguments of any types: the
/// compiler types and lowers every call, and this declaration exists to be
/// named, imported and documented. A release build refuses it unless
/// `vilan.toml` sets `[build] dbg = "strip"` or `"keep"`.
external fun dbg(): void;

// --- `dbg_stack` (debugging.md S2) ---

/// `dbg_stack()` prints every binding in scope at the call to stderr (`console.log`
/// in the browser): a `[src/main.vl:12:5] dbg_stack() in main` line, then one
/// `name: Type = value` line per parameter and local, innermost scope first, a
/// shadowed binding under the one that hides it. The compiler expands the call from
/// the scope it sits in, so it prints without looking anything up at run time and
/// the same bytes on both backends. It reads nothing it must not: a resource
/// already moved prints `<moved at L:C>` (or `<moved on some paths>`), a view a
/// later push invalidated prints `<view, invalidated by push at L:C>`, a pipe and a
/// `lazy` parameter print without running, and a cell prints its current value
/// without subscribing. Inside a closure it lists the closure's own bindings and
/// then the ones it captures. A release build refuses it, as it refuses `dbg`.
external fun dbg_stack(): void;

// --- Json / Wire (shared JSON impls via in-world helpers) ---

// --- The sized numeric family (proposal/numeric-types.md §5) ---

impl i8 with Debug {
	[extern("JSON.stringify")]
	external fun debug(self): str;
}

impl u8 with Debug {
	[extern("JSON.stringify")]
	external fun debug(self): str;
}

impl i16 with Debug {
	[extern("JSON.stringify")]
	external fun debug(self): str;
}

impl u16 with Debug {
	[extern("JSON.stringify")]
	external fun debug(self): str;
}

impl i53 with Debug {
	[extern("JSON.stringify")]
	external fun debug(self): str;
}

impl u53 with Debug {
	[extern("JSON.stringify")]
	external fun debug(self): str;
}

impl usize with Debug {
	[extern("JSON.stringify")]
	external fun debug(self): str;
}

impl f32 with Debug {
	/// The language's number text, keeping the `.0` an integral value drops (`3.0`,
	/// not `3`), and negative zero as `-0.0`: `dbg`'s rule (debugging.md S4, E260,
	/// E276).
	fun debug(self): str {
		if self == 0.0 && 1.0 / self < 0.0 {
			ret "-0.0";
		}
		let text = "" + self;
		if text.contains(".") || text.contains("e") || text.contains("N") || text.contains("I") {
			text
		} else {
			text + ".0"
		}
	}
}
