// `List<T>` is the built-in growable array. It is `external` (an opaque
// intrinsic): a `List` value is a native JS array, `List::new()` is `[]`, and
// `push` is the native `.push`. Iterating a `List` uses a native `for...of`.
import pkg::default::Default;
import pkg::io::panic;
import pkg::iterator::ListIterator;
import pkg::operators::{ Add, Mul };
import pkg::option::Option;

external struct List<T>;

impl List<type T> {
	external fun new(): List<T>;

	/// Appends `item`, which the list KEEPS — hence `own` (rule 1: storing a
	/// place in a slot that outlives the call is a copy, and `own` is how a
	/// signature says so; a fresh value moves in for free).
	external fun push(&mut self, own item: T): void;

	/// Removes and returns the last element — `None` when empty (an intrinsic:
	/// the compiler lowers it over the native `.pop`).
	external fun pop(&mut self): Option<T>;

	external fun len(self): i32;

	fun is_empty(self): bool {
		self.len() == 0
	}

	/// A lazy cursor over the list, and the entry to the adapter chain:
	/// `xs.iter().filter(f).take(3).to_list()`. The cursor holds a SNAPSHOT
	/// (rule 1), so mutating `xs` afterwards cannot disturb a walk in flight —
	/// and the copy is why the eager methods below do not route through it for
	/// a single pass.
	fun iter(self): ListIterator<T> {
		ListIterator { items = self, index = 0 }
	}

	/// A new list with `fn` applied to every element.
	fun map<U>(self, fn: |T| U): List<U> {
		mut result = List::new();
		for item in self {
			result.push(fn(item));
		}
		result
	}

	/// A new list of the elements for which `predicate` holds.
	fun filter(self, predicate: |T| bool): List<T> {
		mut result = List::new();
		for item in self {
			if predicate(item) {
				result.push(item);
			}
		}
		result
	}

	/// Combines the elements left-to-right, starting from `init`.
	fun fold<B>(self, init: B, fn: |B, T| B): B {
		mut accumulator = init;
		for item in self {
			accumulator = fn(accumulator, item);
		}
		accumulator
	}

	fun for_each(self, fn: |T| void): void {
		for item in self {
			fn(item);
		}
	}

	/// A new list with the elements in the opposite order. Eager and pure, like
	/// `map`/`filter` — the receiver is untouched. (The LAZY adapter is `rev`,
	/// which is a different method and belongs to the iterator paper.)
	fun reverse(self): List<T> {
		mut result = List::new();
		mut index = self.len() - 1;
		for index >= 0 {
			result.push(self[index]);
			index -= 1;
		}
		result
	}

	/// Inserts `value` before the element at `index`, shifting the tail right.
	/// `index == len()` appends. PANICS out of bounds, in `[]`'s words: a bad
	/// index is a caller bug, the class `[]` already punishes. (`get`'s
	/// `Option` is for callers who don't know whether an index is live; an
	/// arbitrary bad index passed to a splice is not that.)
	fun insert(&mut self, index: i32, value: T): void {
		let length = self.len();
		if index < 0 || index > length {
			panic(i"index out of bounds: the length is {length} but the index is {index}");
		}
		if index == length {
			self.push(value);
		} else {
			// Grow by one (duplicating the last element), then shift the tail
			// right into the new slot and overwrite the hole.
			self.push(self[length - 1]);
			mut cursor = length - 1;
			for cursor > index {
				self[cursor] = self[cursor - 1];
				cursor -= 1;
			}
			self[index] = value;
		}
	}

	/// Removes and returns the element at `index`, shifting the tail left.
	/// PANICS out of bounds — see `insert`. (`pop` returns an `Option` because
	/// "the list was empty" is a normal condition; a bad index is not.)
	fun remove(&mut self, index: i32): T {
		let length = self.len();
		if index < 0 || index >= length {
			panic(i"index out of bounds: the length is {length} but the index is {index}");
		}
		let removed = self[index];
		mut cursor = index;
		for cursor < length - 1 {
			self[cursor] = self[cursor + 1];
			cursor += 1;
		}
		self.pop();
		removed
	}
}

// `sum`/`product` seed with the first element and fall back to `T::default()`
// only for an empty list. NOTE: that empty-list fallback can't resolve `T`
// concretely yet — a `List` erases its element type — so it relies on Gap B
// (parameterized enum/struct types). The common non-empty path works today.
impl List<type T: Add + Default> {
	fun sum(self): T {
		mut total = T::default();
		mut seeded = false;
		for item in self {
			if seeded {
				total += item;
			} else {
				total = item;
				seeded = true;
			}
		}
		total
	}
}

impl List<type T: Mul + Default> {
	fun product(self): T {
		mut total = T::default();
		mut seeded = false;
		for item in self {
			if seeded {
				total *= item;
			} else {
				total = item;
				seeded = true;
			}
		}
		total
	}
}

// DEFERRED: `iter` (the `Iterable` trait) needs a concrete `List` iterator
// (returning `ListIterator<T>`, not the abstract `Iterator<T>`) plus a `get`
// intrinsic and mutable iterator state. `for x in myList`, `len`/`map`/`filter`/
// `fold`/`for_each`, and `sum`/`product` work today via native `for...of`.
