// `std::bytes` — byte buffers over the host `Uint8Array`
// (proposal/bits-and-bytes.md §3): the binary codec's output/input and the future
// WebSocket frame unit. `Uint8Array`, `TextEncoder`, and `TextDecoder` exist in the
// browser, node, deno, and bun alike, so this is a core module.

// A byte buffer (the host `Uint8Array`). Fixed-length; build incrementally by
// writing into an allocation, growing with `concat` when needed.
import pkg::range::Range;

export external struct Bytes;

export impl Bytes {
	/// A zero-filled buffer of `size` bytes.
	[extern(new, "Uint8Array")]
	external fun alloc(size: usize): Bytes;

	/// The byte count.
	[extern(get, "length")]
	external fun len(self): usize;

	/// The byte at `index` (0–255).
	[extern(method, "at")]
	external fun get(self, index: usize): i32;

	/// The same byte `u32`-typed — for unsigned reassembly (`b0 | b1 << 8 …`),
	/// where the operand type selects the unsigned shift/wrap emission.
	[extern(method, "at")]
	external fun get_u32(self, index: usize): u32;

	/// Lowercase hex rendering of the whole buffer.
	fun to_hex(self): str {
		let digits = "0123456789abcdef";
		mut out = "";
		for index in Range::new(0, self.len().as_i32()) {
			let byte = self.get(index.as_usize());
			out = out
				+ digits.substring((byte / 16).as_usize(), (byte / 16 + 1).as_usize())
				+ digits.substring((byte % 16).as_usize(), (byte % 16 + 1).as_usize());
		}
		out
	}

	/// Overwrite `from..to` (exclusive) with `value` — host semantics: the stored
	/// byte is `value & 0xFF`.
	[extern(method, "fill")]
	external fun fill(self, value: i32, from: usize, to: usize): Bytes;

	/// Copy all of `source` into this buffer starting at `offset` (the host
	/// `TypedArray.set` — errors if it would overflow).
	[extern(method, "set")]
	external fun copy_into(self, source: Bytes, offset: usize);

	/// A copy of `from..to` (`to` exclusive).
	[extern(method, "slice")]
	external fun slice(self, from: usize, to: usize): Bytes;

	/// Store one byte (`value & 0xFF`) at `index`.
	fun set(self, index: usize, value: i32) {
		let _ = self.fill(value, index, index + 1);
	}

	/// The same store `u32`-typed (the host coerces `& 0xFF` either way) — for byte
	/// extraction done in `u32` arithmetic, mirroring `get_u32`.
	[extern(method, "fill")]
	external fun fill_u32(self, value: u32, from: usize, to: usize): Bytes;

	fun set_u32(self, index: usize, value: u32) {
		let _ = self.fill_u32(value, index, index + 1);
	}

	/// A new buffer holding `a` then `b`.
	fun concat(a: Bytes, b: Bytes): Bytes {
		let joined = Bytes::alloc(a.len() + b.len());
		joined.copy_into(a, 0);
		joined.copy_into(b, a.len());
		joined
	}
}

// --- Float access -----------------------------------------------------------

/// The buffer under a `Bytes` (the host `ArrayBuffer`) and a `DataView` over it —
/// the standard route to IEEE-754 bytes, used by the binary codec for `f64`. A
/// `Bytes` produced by `slice`/`alloc` owns its whole buffer, so offset 0 of the
/// view is offset 0 of the bytes.
export external struct ByteBuffer;

export impl Bytes {
	[extern(get, "buffer")]
	external fun buffer(self): ByteBuffer;
}

/// A whole `ArrayBuffer` viewed as bytes (`new Uint8Array(buffer)`) — how a binary
/// fetch response body becomes a `Bytes`.
export [extern(new, "Uint8Array")]
external fun bytes_of_buffer(buffer: ByteBuffer): Bytes;

export external struct DataView;

export [extern(new, "DataView")]
external fun data_view(buffer: ByteBuffer): DataView;

export impl DataView {
	/// Read/write an IEEE-754 double at `offset`; `little_endian` selects the byte
	/// order.
	[extern(method, "getFloat64")]
	external fun read_f64(self, offset: usize, little_endian: bool): f64;

	[extern(method, "setFloat64")]
	external fun write_f64(self, offset: usize, value: f64, little_endian: bool);
}

// --- UTF-8 ----------------------------------------------------------------

/// The host `TextEncoder`/`TextDecoder` classes. The struct + constructor are
/// exposed (not just the `encode_utf8`/`decode_utf8` shorthands) for streaming use
/// — `std::fetch`'s chunked body reads decode with a long-lived decoder.
external struct TextEncoder;

[extern(new, "TextEncoder")]
external fun new_text_encoder(): TextEncoder;

impl TextEncoder {
	[extern(method)]
	external fun encode(self, text: str): Bytes;
}

export external struct TextDecoder;

export [extern(new, "TextDecoder")]
external fun new_text_decoder(): TextDecoder;

export impl TextDecoder {
	[extern(method)]
	external fun decode(self, bytes: Bytes): str;
}

/// `text` as UTF-8 bytes.
export fun encode_utf8(text: str): Bytes {
	new_text_encoder().encode(text)
}

/// UTF-8 `bytes` as text.
export fun decode_utf8(bytes: Bytes): str {
	new_text_decoder().decode(bytes)
}
