import pkg::operators::Add;

external struct str;

impl str {
	external fun len(self): i32;

	external fun trim(self): str;

	/// The host's **full Unicode** uppercase mapping, locale-independent.
	///
	/// One-to-many mappings included, so the result can be LONGER than the
	/// receiver: `"Straße".to_uppercase()` is `"STRASSE"` — ß expands to two
	/// characters — and non-ASCII letters map, `"ǳ".to_uppercase()` being
	/// `"Ǳ"`. Indices therefore do not survive the call. For a
	/// length-preserving fold over the 26 ASCII letters alone, reach for
	/// `to_uppercase_ascii`.
	external fun to_uppercase(self): str;

	/// The host's **full Unicode** lowercase mapping, locale-independent.
	///
	/// The mirror of `to_uppercase`: non-ASCII letters map (`"Ǳ"` lowers to
	/// `"ǳ"`, `"É"` to `"é"`) and one-to-many mappings apply, so the result
	/// can be LONGER than the receiver — `"İ"` lowers to `"i̇"`, two code
	/// units — and indices do not survive the call. For a length-preserving
	/// fold over the 26 ASCII letters alone, reach for `to_lowercase_ascii`.
	external fun to_lowercase(self): str;

	/// `A`–`Z` shifted to `a`–`z`, and **nothing else touched**.
	///
	/// Exactly the 26 ASCII letters: `ß`, `Ǳ`, `İ`, `É` and every other code
	/// unit passes through unchanged, so the result always has the same
	/// length as the receiver and an index into one is an index into the
	/// other. That is what makes it the tool for protocol text — file
	/// extensions, mime rows, HTTP header names, HTML tag names, hex — where
	/// "case-insensitive" is defined over ASCII and a Unicode fold would
	/// rewrite data instead: U+212A KELVIN SIGN lowers to a plain `k` under
	/// `to_lowercase`, so a full fold makes a character that is not an ASCII
	/// letter read as one. For human text, `to_lowercase` is the one you want.
	fun to_lowercase_ascii(self): str {
		let lowercase = "abcdefghijklmnopqrstuvwxyz";
		let length = self.len();
		mut out = "";
		mut index = 0;
		for index < length {
			let unit = self.code_at(index);
			// `A` (65) through `Z` (90) — the only units this maps.
			if unit >= 65 && unit <= 90 {
				let letter = (unit - 65).as_i32();
				out = out + lowercase.substring(letter, letter + 1);
			} else {
				out = out + self.substring(index, index + 1);
			}
			index = index + 1;
		}
		out
	}

	/// `a`–`z` shifted to `A`–`Z`, and **nothing else touched**.
	///
	/// The mirror of `to_lowercase_ascii`: exactly the 26 ASCII letters, every
	/// other code unit unchanged, the length preserved. `"Straße"` comes back
	/// `"STRAßE"` — where `to_uppercase` would expand the ß to `SS` and change
	/// the length. The right tool wherever an identifier is ASCII by
	/// specification; for human text, `to_uppercase`.
	fun to_uppercase_ascii(self): str {
		let uppercase = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
		let length = self.len();
		mut out = "";
		mut index = 0;
		for index < length {
			let unit = self.code_at(index);
			// `a` (97) through `z` (122) — the only units this maps.
			if unit >= 97 && unit <= 122 {
				let letter = (unit - 97).as_i32();
				out = out + uppercase.substring(letter, letter + 1);
			} else {
				out = out + self.substring(index, index + 1);
			}
			index = index + 1;
		}
		out
	}

	external fun contains(self, needle: str): bool;

	external fun starts_with(self, prefix: str): bool;

	external fun ends_with(self, suffix: str): bool;

	/// Replaces every occurrence of `from` with `to`.
	external fun replace(self, from: str, to: str): str;

	external fun repeat(self, count: i32): str;

	/// Splits on each occurrence of `separator`, returning the pieces.
	external fun split(self, separator: str): List<str>;

	/// The substring in `[start, end)` (zero-based, by UTF-16 code unit).
	///
	/// REFUSES anything but `0 <= start <= end <= len()`: a negative bound, an
	/// inverted pair, or an `end` past the length is a panic, not a correction.
	/// (The host's own `substring` clamps and SWAPS, so `s.substring(k, -1)`
	/// would quietly return `s[0..k]` — the complement of the request.) A caller
	/// who means "to the end" writes `s.len()`; to drop a known affix, reach for
	/// `strip_prefix`/`strip_suffix`, which return `Option<str>`.
	external fun substring(self, start: i32, end: i32): str;

	/// The UTF-16 code unit at `index` (0..len), as its integer value — the
	/// primitive under checksums and parsers. Out of range is NaN-shaped in
	/// the host; index within `len()` is the caller's contract.
	[extern(method, "charCodeAt")]
	external fun code_at(self, index: i32): u32;

	fun is_empty(self): bool {
		self.len() == 0
	}
}

// `+` on strings is native concatenation; this impl admits `str` to generic
// `T: Add` code. (`operators` pulls only `io` — string.vl stays off the
// `option` chain, the constraint recorded in option.vl's `parse_i32` note.)
impl str with Add {
	fun add(self, b: str): str {
		self + b
	}
}
