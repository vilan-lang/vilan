// Typed atomic styles, compiled (proposal/ui-styling.md). A `Style` maps
// property SLOTS to `(class name, declaration)` pairs; each property method
// merges one property in — LAST WINS, a record update, never a cascade — and
// emits the atomic rule through the const-only asset channel, so styles
// construct inside `const` expressions and the whole stylesheet exists at
// build time. `+` combines named styles (right side wins per property).
//
// Slot keys encode conditions as `media:condition:property`, where a CONDITION
// is up to three optional tokens, space-joined outside-in: a RELATION token
// (whose element does this slot dress? — the ancestor guard
// `^[data-theme="dark"]`, the children combinator `>*`, or the divide
// combinator `>*+*`; the `^`/`>` first byte is what keeps it distinct from
// the attribute token), a self-targeting attribute selector
// (`[data-open="true"]`, always the bracketed token), and a pseudo-class
// ("hover", always last). So "" (base), "hover", `^[data-theme="dark"]`,
// `^[data-theme="dark"] hover`, `[data-open="true"] hover`, `>*` and the full
// `^[data-theme="dark"] [data-open="true"] hover` are all conditions.
// Conditions nest OUTSIDE-IN in the order the CSS nests them,
// `md(within(.., attribute(.., hover(..))))`; any other order is
// refused with a message naming the fix, one relation per slot, and the
// child-side relations (`children`, `divide`) take an unconditioned inner.
// Child-side rules emit inside `@layer vilan` (ui-styling.md §0bis.6): a
// child's own Style always wins against a rule reaching in from an ancestor,
// because unlayered styles beat layered ones whatever their specificity —
// while the ancestor guard stays UNLAYERED and wins against its own
// element's base rule on specificity, exactly as the deleted `dark()` did.
// Class names are
// content hashes of `key|declaration` (deterministic across builds — the
// channel dedups identical rules program-wide, which is what makes the
// stylesheet plateau). Themeable tokens carry their value as a CSS custom
// property (`var(--space-4)`) plus the `:root` line declaring it — re-theming
// and dark mode swap property values with zero recompilation.
//
// Properties that COVER other properties (`padding` over its four edges,
// `border` over its parts) form FAMILIES, and last-wins holds across a family,
// not just across one property (§0bis.4): a shorthand set later drops the
// slots it covers, and a shorthand's rule renders `*.sX{..}` so the lexical
// sort puts it ahead of its family's longhands. The two meet exactly — a
// shorthand and a longhand survive together only when the longhand came last —
// so a family resolves by AUTHORING order, the way every other merge here
// does, and never by the class-name sort.

import pkg::asset::emit;
import pkg::io::panic;
import pkg::map::Map;
import pkg::operators::Add;
import pkg::option::Option::{ None, Some, self };
import pkg::range::Range;

// --- values -------------------------------------------------------------------

/// A CSS length: a token's IDENTITY (`var(--space-4)`) or a literal unit.
/// `root` carries the token's `:root` declaration ("" when none).
struct Length {
	text: str,
	root: str,
}

impl Length {
	fun px(value: f64): Length {
		Length { text = i"{value}px", root = "" }
	}

	fun rem(value: f64): Length {
		Length { text = i"{value}rem", root = "" }
	}

	/// Relative to the element's own font size — the unit `letter_spacing`
	/// and optical spacing are written in.
	fun em(value: f64): Length {
		Length { text = i"{value}em", root = "" }
	}

	fun pct(value: f64): Length {
		Length { text = i"{value}%", root = "" }
	}

	/// Viewport units. `min_height(Length::vh(100.0))` is the full-height
	/// shell.
	fun vh(value: f64): Length {
		Length { text = i"{value}vh", root = "" }
	}

	fun vw(value: f64): Length {
		Length { text = i"{value}vw", root = "" }
	}

	fun auto(): Length {
		Length { text = "auto", root = "" }
	}

	/// Bare `0` — the unit-less zero CSS accepts for any length, and what the
	/// `min-width:0` flex idiom and the `inset:0` fill-the-parent idiom are
	/// written as. `space(0)` renders `var(--space-0)` and `Length::px(0.0)`
	/// renders `0px`; all three compute the same, and this one is the spelling.
	fun zero(): Length {
		Length { text = "0", root = "" }
	}

	/// A `calc()` expression, written WITHOUT the wrapper:
	/// `Length::calc("100% - 2rem")`. The property stays typed while the
	/// arithmetic — which the `Length` representation deliberately does not
	/// model — rides a string. Composes with tokens through their rendered
	/// form, e.g. `Length::calc("100vh - var(--space-16)")`.
	///
	/// Sugar over `raw`: `Length::calc(e)` is `Length::raw("calc(" + e + ")")`.
	fun calc(expression: str): Length {
		check_not_blank("Length::calc", expression);
		Length { text = i"calc({expression})", root = "" }
	}

	/// A complete CSS value, verbatim — `Color::hex`'s twin for lengths, and
	/// the escape for the functional values the representation does not model:
	/// `Length::raw("clamp(120px, 100vw, 1920px)")`, `min()`, `max()`, `env()`,
	/// `fit-content()`. Use `calc` when you are writing ARITHMETIC and want the
	/// wrapper supplied; use this when the value is already whole, which is also
	/// what lets one named expression be reused across properties.
	///
	/// (`clamp`/`min`/`max` also nest inside `calc()`, so `calc` reaches them
	/// too — at the cost of a wrapper the author did not write.)
	fun raw(expression: str): Length {
		check_not_blank("Length::raw", expression);
		Length { text = expression, root = "" }
	}

	/// The typed end of the dynamic-value channel: pairs with
	/// `view.style_var(name, signal)` writing the custom property at runtime.
	fun var(name: str): Length {
		Length { text = i"var({name})", root = "" }
	}
}

/// The spacing scale (Tailwind's, rem-based). The scale is data; the
/// validation is const evaluation — an unknown step fails the build.
fun space(step: i32): Length {
	let value = match step {
		0 => "0px",
		1 => "0.25rem",
		2 => "0.5rem",
		3 => "0.75rem",
		4 => "1rem",
		5 => "1.25rem",
		6 => "1.5rem",
		8 => "2rem",
		10 => "2.5rem",
		12 => "3rem",
		16 => "4rem",
		20 => "5rem",
		24 => "6rem",
		_ => panic(i"unknown spacing step {step} (the scale has 0-6, 8, 10, 12, 16, 20, 24)"),
	};
	Length { text = i"var(--space-{step})", root = i":root\{--space-{step}:{value}\}" }
}

/// A CSS color: a ramp token's identity (`var(--gray-50)`) or a literal.
struct Color {
	text: str,
	root: str,
}

fun ramp(name: str, step: i32, value: str): Color {
	Color { text = i"var(--{name}-{step})", root = i":root\{--{name}-{step}:{value}\}" }
}

impl Color {
	fun white(): Color {
		Color { text = "#ffffff", root = "" }
	}

	fun black(): Color {
		Color { text = "#000000", root = "" }
	}

	fun transparent(): Color {
		Color { text = "transparent", root = "" }
	}

	/// The typed arbitrary-value escape.
	fun hex(value: str): Color {
		Color { text = value, root = "" }
	}

	/// The typed end of the dynamic-value channel for colours — `Length::var`'s
	/// counterpart: renders `var({name})` and declares NOTHING (`root = ""`).
	/// The app owns the custom property's declaration — its emitted theme
	/// block, or `view.style_var(name, signal)` writing it at runtime.
	/// `.alpha()` composes over it through the relative-colour form,
	/// `rgb(from var(..) r g b / a)`, so a variable-backed colour
	/// translucifies exactly like a ramp token.
	fun var(name: str): Color {
		Color { text = i"var({name})", root = "" }
	}

	fun gray(step: i32): Color {
		ramp("gray", step, match step {
			50 => "#f9fafb",
			100 => "#f3f4f6",
			200 => "#e5e7eb",
			300 => "#d1d5db",
			400 => "#9ca3af",
			500 => "#6b7280",
			600 => "#4b5563",
			700 => "#374151",
			800 => "#1f2937",
			900 => "#111827",
			_ => panic(i"unknown gray step {step} (ramps run 50, 100-900 by hundreds)"),
		})
	}

	fun blue(step: i32): Color {
		ramp("blue", step, match step {
			50 => "#eff6ff",
			100 => "#dbeafe",
			200 => "#bfdbfe",
			300 => "#93c5fd",
			400 => "#60a5fa",
			500 => "#3b82f6",
			600 => "#2563eb",
			700 => "#1d4ed8",
			800 => "#1e40af",
			900 => "#1e3a8a",
			_ => panic(i"unknown blue step {step} (ramps run 50, 100-900 by hundreds)"),
		})
	}

	fun red(step: i32): Color {
		ramp("red", step, match step {
			50 => "#fef2f2",
			100 => "#fee2e2",
			200 => "#fecaca",
			300 => "#fca5a5",
			400 => "#f87171",
			500 => "#ef4444",
			600 => "#dc2626",
			700 => "#b91c1c",
			800 => "#991b1b",
			900 => "#7f1d1d",
			_ => panic(i"unknown red step {step} (ramps run 50, 100-900 by hundreds)"),
		})
	}

	fun green(step: i32): Color {
		ramp("green", step, match step {
			50 => "#f0fdf4",
			100 => "#dcfce7",
			200 => "#bbf7d0",
			300 => "#86efac",
			400 => "#4ade80",
			500 => "#22c55e",
			600 => "#16a34a",
			700 => "#15803d",
			800 => "#166534",
			900 => "#14532d",
			_ => panic(i"unknown green step {step} (ramps run 50, 100-900 by hundreds)"),
		})
	}

	/// A literal color WITH alpha — the `hex` escape's translucent twin, and
	/// what a brand palette outside the ramps is written in. Channels are
	/// validated at const time, like every other scale here.
	fun rgba(red: i32, green: i32, blue: i32, alpha: f64): Color {
		check_channel("red", red);
		check_channel("green", green);
		check_channel("blue", blue);
		check_alpha(alpha);
		Color { text = i"rgba({red}, {green}, {blue}, {alpha})", root = "" }
	}

	/// A perceptual literal — OKLCH, Oklab's polar form: `lightness` 0.0-1.0
	/// (the CSS number form — 1.0 is white), `chroma` 0.0-0.5 (0 is
	/// achromatic; sRGB tops out near 0.37), `hue` in degrees, 0.0-360.0.
	/// The space palette derivation works in: hold a hue angle, step the
	/// lightness, and the steps look even across hues — which rgb cannot
	/// promise. Ranges are validated at const time like `rgba`'s channels,
	/// and the hue is required in its canonical turn: angles wrap in CSS, so
	/// admitting 700 beside 340 would mint two classes for one colour.
	/// `.alpha()` composes over the result like over any other colour.
	fun oklch(lightness: f64, chroma: f64, hue: f64): Color {
		check_oklch(lightness, chroma, hue);
		Color { text = i"oklch({lightness} {chroma} {hue})", root = "" }
	}

	/// This color at `alpha` (0.0-1.0). Renders the RELATIVE color form,
	/// `rgb(from <this> r g b / a)`, which keeps a token's identity intact —
	/// `Color::gray(900).alpha(0.08)` is still `var(--gray-900)` underneath,
	/// so it re-themes like the opaque color does, and it carries the token's
	/// `:root` declaration onward. (An 8-digit hex would work only on a
	/// literal; mixing toward `transparent` would need the alpha as a
	/// percentage, and `0.07 * 100.0` is `7.000000000000001`.)
	fun alpha(self, value: f64): Color {
		check_alpha(value);
		Color { text = i"rgb(from {self.text} r g b / {value})", root = self.root }
	}
}

fun check_channel(name: str, value: i32) {
	if value < 0 || value > 255 {
		panic(i"{name} channel {value} is outside 0-255");
	}
}

fun check_alpha(value: f64) {
	if value < 0.0 || value > 1.0 {
		panic(i"alpha {value} is outside 0.0-1.0");
	}
}

/// What an attribute condition's name must avoid: the characters that
/// delimit the machinery it rides — `:` (the slot key's fields), the space
/// (the condition grammar's tokens), quotes (the selector's own), and the
/// selector syntax an attribute NAME never contains anyway.
fun check_attribute_name(name: str) {
	if name.trim() == "" {
		panic("attribute was given an empty name");
	}
	for banned in ["\"", "'", " ", ":", "[", "]", "="] {
		if name.contains(banned) {
			panic(i"an attribute name cannot contain '{banned}' (got \"{name}\") — a name is one token, like data-open");
		}
	}
}

/// The value's fence is the name's minus the selector syntax: `[data-x="a=b"]`
/// is legal CSS and breaks nothing here. An EMPTY value stays legal — CSS
/// `[name=""]` matches an attribute explicitly set to the empty string.
fun check_attribute_value(value: str) {
	for banned in ["\"", "'", " ", ":"] {
		if value.contains(banned) {
			panic(i"an attribute value cannot contain '{banned}' (got \"{value}\") — a styling hook's value is one token, like \"true\"");
		}
	}
}

fun check_oklch(lightness: f64, chroma: f64, hue: f64) {
	if lightness < 0.0 || lightness > 1.0 {
		panic(i"oklch lightness {lightness} is outside 0.0-1.0 (the CSS number form — 1.0 is white)");
	}
	if chroma < 0.0 || chroma > 0.5 {
		panic(i"oklch chroma {chroma} is outside 0.0-0.5 (0 is achromatic; sRGB tops out near 0.37)");
	}
	if hue < 0.0 || hue > 360.0 {
		panic(i"oklch hue {hue} is outside 0.0-360.0 (degrees; angles wrap, so write the canonical turn)");
	}
}

/// The one malformation a CSS-TEXT escape can actually detect: nothing at all.
/// An empty value renders `property:`, a declaration the browser drops in
/// silence, and the realistic way to produce one is an interpolation whose
/// variable was never set — which is how real code writes background sizes and
/// data-URI images. Everything else in a CSS expression is text this language
/// deliberately does not model.
fun check_not_blank(what: str, value: str) {
	if value.trim() == "" {
		panic(i"{what} was given an empty value");
	}
}

/// How far a radial gradient's ending shape reaches — the CSS extent
/// keywords. Position (`at 20% 40%`) is deliberately not modelled: the sites
/// that want it want it computed from custom properties, which is `raw`'s job.
enum RadialExtent {
	ClosestSide = "closest-side",
	ClosestCorner = "closest-corner",
	FarthestSide = "farthest-side",
	FarthestCorner = "farthest-corner",
}

/// A gradient — a `background-image` value, NOT a `Color` (CSS paints an
/// image over a color, and `background` takes one color). Open one with
/// `Gradient::linear`/`Gradient::radial`, add stops, and hand it to
/// `background_gradient`.
struct Gradient {
	// The CSS function and its geometry argument, kept apart so `render`
	// composes them once: `linear-gradient` + `90deg`, `radial-gradient` +
	// `closest-side`.
	function: str,
	geometry: str,
	// Stops as rendered CSS, comma-joined, plus the count the two-stop
	// minimum is checked against.
	stops: str,
	stop_count: i32,
	// The `:root` lines the stops' colors carry, emitted when the gradient
	// reaches a `Style` — so a gradient of ramp tokens themes like everything
	// else.
	roots: List<str>,
}

impl Gradient {
	/// `degrees` is the CSS angle: 0 points up, 90 to the right, 180 down.
	fun linear(degrees: f64): Gradient {
		Gradient {
			function = "linear-gradient",
			geometry = i"{degrees}deg",
			stops = "",
			stop_count = 0,
			roots = [],
		}
	}

	fun radial(extent: RadialExtent): Gradient {
		Gradient {
			function = "radial-gradient",
			geometry = extent.value(),
			stops = "",
			stop_count = 0,
			roots = [],
		}
	}

	/// One color stop at `percent` along the gradient line. Positions are
	/// explicit rather than defaulted — the value type holds pairs, so both
	/// halves are written.
	fun stop(self, color: Color, percent: f64): Gradient {
		mut roots = self.roots;
		if color.root != "" {
			roots.push(color.root);
		}
		let rendered = i"{color.text} {percent}%";
		Gradient {
			function = self.function,
			geometry = self.geometry,
			stops = if self.stops == "" {
				rendered
			} else {
				self.stops + ", " + rendered
			},
			stop_count = self.stop_count + 1,
			roots = roots,
		}
	}

	fun render(self): str {
		i"{self.function}({self.geometry}, {self.stops})"
	}
}

/// Something that can be the VALUE of a declaration
/// (proposal/css-block.md §6) — the type-directed half of `raw`, the
/// `Slot`/`AttrValue` precedent on the style side. A `str` is a complete CSS
/// value written verbatim; a `Length` or a `Color` is a value that may be a
/// THEME TOKEN, and a token carries a `:root` line the sheet needs beside the
/// reference to it.
///
/// The trait only DESCRIBES a value — its text, and the `:root` line its
/// token needs. Putting the line on the sheet belongs to the surface that
/// writes the sheet (`Style::raw`, `Declarations::raw`), not to the impl.
/// That is the honest split — `Length` and `Color` are plain data — and it is
/// also the safe one: `emit` is the compile-time channel, and the const-only
/// capability check follows CALL EDGES, which it cannot do through a bounded
/// generic's trait dispatch. An `emit` inside an impl here would escape the
/// check and reach the emitted JS as a live `__emit_asset` with no runtime
/// binding.
trait CssValue {
	/// The declaration's value text, exactly as it renders into CSS.
	fun css_text(self): str;

	/// The `:root` line declaring this value's theme token, or `""` when the
	/// value declares nothing.
	fun css_root(self): str;
}

/// A complete CSS value, written verbatim. Declares no token.
impl str with CssValue {
	fun css_text(self): str {
		self
	}

	fun css_root(self): str {
		""
	}
}

/// A length — a token's identity plus the `:root` line that defines it.
impl Length with CssValue {
	fun css_text(self): str {
		self.text
	}

	fun css_root(self): str {
		self.root
	}
}

/// A color — `Length`'s twin, same token discipline.
impl Color with CssValue {
	fun css_text(self): str {
		self.text
	}

	fun css_root(self): str {
		self.root
	}
}

// --- keyword properties ---------------------------------------------------------

enum Display {
	Flex = "flex",
	Grid = "grid",
	Block = "block",
	Inline = "inline",
	InlineBlock = "inline-block",
	InlineFlex = "inline-flex",
	InlineGrid = "inline-grid",
	// `display:none` — named to stay clear of `Option::None` at use sites.
	Hidden = "none",
}

enum Position {
	Static = "static",
	Relative = "relative",
	Absolute = "absolute",
	Fixed = "fixed",
	Sticky = "sticky",
}

enum FlexDirection {
	Row = "row",
	Column = "column",
	RowReverse = "row-reverse",
	ColumnReverse = "column-reverse",
}

enum AlignItems {
	Start = "flex-start",
	Center = "center",
	End = "flex-end",
	Stretch = "stretch",
	Baseline = "baseline",
}

enum JustifyContent {
	Start = "flex-start",
	Center = "center",
	End = "flex-end",
	Between = "space-between",
	Around = "space-around",
	Evenly = "space-evenly",
}

enum TextAlign {
	Left = "left",
	Center = "center",
	Right = "right",
}

enum Cursor {
	Pointer = "pointer",
	Default = "default",
	Text = "text",
	NotAllowed = "not-allowed",
}

enum Overflow {
	Visible = "visible",
	Hidden = "hidden",
	Auto = "auto",
	Scroll = "scroll",
}

enum WhiteSpace {
	Normal = "normal",
	Nowrap = "nowrap",
	Pre = "pre",
	PreWrap = "pre-wrap",
	PreLine = "pre-line",
}

enum UserSelect {
	Auto = "auto",
	Text = "text",
	All = "all",
	// `user-select:none` — named to stay clear of `Option::None` at use
	// sites, the `Display::Hidden` rule.
	Off = "none",
}

// --- the class-name hash --------------------------------------------------------

/// djb2 over the slot key and declaration, base36, prefixed for CSS validity.
/// Content-addressed — never a counter — so builds, caching, and reordering
/// all agree on names (the determinism the asset channel's dedup relies on).
fun class_hash(text: str): str {
	mut hash = 5381u32;
	for index in Range::new(0, text.len()) {
		// hash * 33 + code, wrapped to 32 bits: the shift and mask are
		// u32-wrapped; the additions stay exact in between.
		hash = ((hash << 5u32) + hash + text.code_at(index)) & 0xFFFFFFFFu32;
	}
	"s" + encode36(hash)
}

fun encode36(value: u32): str {
	let digits = "0123456789abcdefghijklmnopqrstuvwxyz";
	if value == 0u32 {
		ret "0";
	}
	mut rest = value;
	mut out = "";
	// A u32 is at most 7 base36 digits.
	for _step in Range::new(0, 7) {
		if rest > 0u32 {
			let digit = (rest % 36u32).as_i32();
			out = digits.substring(digit, digit + 1) + out;
			rest = rest / 36u32;
		}
	}
	out
}

// --- Style ----------------------------------------------------------------------

struct Style {
	// Slot key `media:condition:property` -> (class name, declaration). The
	// declaration is kept so condition combinators can re-emit it under
	// their selector.
	rules: Map<str, (str, str)>,
}

/// Opens a builder chain. Property methods reach the const-only asset
/// channel, so construction belongs inside a `const` expression; selection
/// and merging (`+`, `class_list`) are ordinary runtime code.
fun style(): Style {
	Style { rules = Map::new() }
}

/// The shorthand-to-longhand table (§0bis.4): the properties a property
/// COVERS, `;`-delimited and `;`-terminated at both ends so membership is one
/// `contains(";" + property + ";")`. Everything else maps to "" and is a
/// longhand (or a property with no family at all).
///
/// One whole-box shorthand per family, and everything it covers is a longhand
/// — which is what keeps `border` ahead of `border-top` while `border-top`
/// stays ahead of nothing. Deliberately NOT prefix-based: `border-radius`,
/// `border-collapse` and `flex-direction` share a prefix with a shorthand and
/// are not covered by it. Every row is earned by a real site in the demand
/// sweep; a new property method that is a CSS shorthand over another writable
/// property adds its row here in the same commit.
///
/// `raw` writes slots like any other method, so its properties are placed by
/// this table too — `border_none()` IS `raw("border", "none")`, and the two
/// live instances of the hazard this fixes both had `raw` on one side.
fun family_longhands(property: str): str {
	match property {
		"padding" => ";padding-top;padding-right;padding-bottom;padding-left;",
		"margin" => ";margin-top;margin-right;margin-bottom;margin-left;",
		"inset" => ";top;right;bottom;left;",
		"flex" => ";flex-grow;flex-shrink;flex-basis;",
		"background" => ";background-color;background-image;background-position;background-size;background-repeat;background-attachment;background-origin;background-clip;",
		"border" => border_longhands(),
		_ => "",
	}
}

/// `border`'s longhands: the three part shorthands, the four edges, and the
/// twelve `border-<edge>-<part>` leaves. Built rather than written out, so
/// each edge and part name appears once.
fun border_longhands(): str {
	mut out = ";border-width;border-style;border-color;";
	for edge in ["top", "right", "bottom", "left"] {
		out = out + i"border-{edge};";
		for part in ["width", "style", "color"] {
			out = out + i"border-{edge}-{part};";
		}
	}
	out
}

/// Drops every slot the incoming `property` covers, under the SAME media and
/// condition — the ordinary last-wins rule widened from one property to its
/// family. A map removal and nothing else: no emission, so `+` resolves a
/// family exactly as a chain does even though it is runtime-legal.
fun without_covered(
	rules: Map<str, (str, str)>,
	media: str,
	condition: str,
	property: str,
): Map<str, (str, str)> {
	let longhands = family_longhands(property);
	if longhands == "" {
		ret rules;
	}
	mut out = rules;
	for key in rules.keys() {
		let parts = key.split(":");
		if parts[0] == media && parts[1] == condition && longhands.contains(";" + parts[2] + ";") {
			out.remove(key);
		}
	}
	out
}

/// The condition's RELATION token, if any — always the FIRST token when it is
/// one: the ancestor guard (`^[data-theme="dark"]`), the children combinator
/// (`>*`), or the divide combinator (`>*+*`). `""` when the condition opens
/// with an attribute or pseudo-class token instead.
fun condition_relation(condition: str): str {
	let first = condition.split(" ")[0];
	if first.starts_with("^") || first.starts_with(">") {
		first
	} else {
		""
	}
}

/// The condition's attribute token, if any: `[data-open="true"]` from any
/// condition carrying one, `""` otherwise. The attribute token is the one
/// bracketed form, so the scan is a prefix check per token.
fun condition_attribute(condition: str): str {
	for part in condition.split(" ") {
		if part.starts_with("[") {
			ret part;
		}
	}
	""
}

/// The condition's pseudo-class, if any — always the LAST token, when that
/// token is neither a relation token nor an attribute selector: `"hover"`
/// from `"hover"`, from `^[data-theme="dark"] hover` and from the full
/// three-token stack; `""` from `""`, from `^[data-theme="dark"]`, from
/// `[data-open="true"]` and from `>*`.
fun condition_pseudo(condition: str): str {
	let parts = condition.split(" ");
	let last = parts[parts.len() - 1];
	if last.starts_with("^") || last.starts_with(">") || last.starts_with("[") {
		""
	} else {
		last
	}
}

/// One atomic rule as CSS text. The four condition axes nest the way CSS
/// nests them — media outermost, then the relation (the ancestor guard's
/// prefix, or the child combinator's suffix), then the attribute suffix on
/// the element itself, then the pseudo-class suffix — which is exactly the
/// outside-in order the condition combinators require at the call site.
///
/// The leading byte is load-bearing (B35): `assemble_assets` has no
/// "base < pseudo < media" comparator, it sorts lines lexically with a numeric
/// override for `@media` min-widths, and the band order falls out of ASCII
/// ('*' < '.' < ':' < '@' < '['). An ancestor-guarded rule starts with '[',
/// so every `within` rule lands in one band AFTER the base, pseudo, `:root`
/// and `@layer` bands and before the media group (which sorts last by its
/// numeric key, not by '@') — so a `within` rule wins its (0,2,0) tie against
/// a pseudo rule by source order (the theme beats the state), and composed
/// rules win their cascade on SPECIFICITY, never on the sort. The full
/// ledger, tie by tie, is ui-styling.md §0bis.6.
///
/// A child-side relation's rule is wrapped in `@layer vilan` — 032's cascade
/// invariant, "unlayered beats layered whatever the specificity", read as: a
/// child's own Style always wins against a rule reaching in from an ancestor.
/// `divide` renders `> :not(:first-child)` rather than `> * + *` — the same
/// element set, but carrying (0,2,0) — so on a property both relations touch,
/// divide outranks children by SPECIFICITY instead of tying and falling to
/// the class-hash line order (§0bis.6's probe caught the owl spelling's
/// winner flipping with the hash bytes).
///
/// A family SHORTHAND carries one more sort marker, on the same principle
/// (§0bis.4): its selector is `*.sX` rather than `.sX`. `*` is 0x2A and `.` is
/// 0x2E, so every shorthand rule sorts ahead of its family's longhands inside
/// its own band — a condition prefix is byte-identical across a family pair,
/// so the `*`/`.` byte still decides inside the `[` band and inside the
/// layer. The marker is free of side effects: `*.sX` is the same compound
/// selector as `.sX` matching the same elements at the same specificity (the
/// universal selector contributes nothing), so the condition axis — which is
/// also specificity — is exactly as it was.
fun render_rule(media: str, condition: str, property: str, class: str, declaration: str): str {
	mut selector = if family_longhands(property) == "" {
		"." + class
	} else {
		"*." + class
	};
	let relation = condition_relation(condition);
	if relation.starts_with("^") {
		// The ancestor guard: the token minus its `^` marker is the ancestor's
		// attribute selector, prepended with the descendant combinator.
		selector = relation.substring(1, relation.len()) + " " + selector;
	}
	// The attribute token is already selector syntax, appended to the
	// element's own compound selector — an attribute-conditioned base rule
	// still starts with '.', so it stays in the base cascade band (B35).
	let attribute = condition_attribute(condition);
	if attribute != "" {
		selector = selector + attribute;
	}
	let pseudo = condition_pseudo(condition);
	if pseudo != "" {
		selector = selector + ":" + pseudo;
	}
	if relation == ">*" {
		selector = selector + " > *";
	}
	if relation == ">*+*" {
		selector = selector + " > :not(:first-child)";
	}
	mut rule = selector + "{" + declaration + "}";
	if relation.starts_with(">") {
		rule = "@layer vilan{" + rule + "}";
	}
	if media != "" {
		rule = "@media (min-width: " + media + "){" + rule + "}";
	}
	rule
}

impl Style {
	/// The one chokepoint: hash the slot, emit the atomic rule, insert
	/// last-wins — across the property's whole FAMILY, so a shorthand set here
	/// clears the longhands it covers under this condition (§0bis.4).
	fun rule(self, media: str, condition: str, property: str, declaration: str): Style {
		let key = media + ":" + condition + ":" + property;
		let class = class_hash(key + "|" + declaration);
		emit("css", render_rule(media, condition, property, class, declaration));
		mut rules = without_covered(self.rules, media, condition, property);
		rules.insert(key, (class, declaration));
		Style { rules = rules }
	}

	/// The escape hatch: any property, any value, atomic like the rest. The
	/// value is any `CssValue` — a verbatim `str`, or a `Length`/`Color`
	/// whose theme token carries its own `:root` line onto the sheet, so
	/// `.raw("padding", space(4))` is never a dangling `var()`.
	fun raw<V: CssValue>(self, property: str, value: V): Style {
		let root = value.css_root();
		if root != "" {
			emit("css", root);
		}
		self.rule("", "", property, property + ":" + value.css_text())
	}

	/// An untyped property with a `Length` value. Exactly `raw` at that
	/// instantiation, kept for the spelling the surface has always had.
	fun with_length(self, property: str, value: Length): Style {
		self.raw(property, value)
	}

	/// `with_length`'s twin for colors.
	fun with_color(self, property: str, value: Color): Style {
		self.raw(property, value)
	}

	// --- layout ---

	fun display(self, value: Display): Style {
		self.raw("display", value.value())
	}

	fun position(self, value: Position): Style {
		self.raw("position", value.value())
	}

	fun flex_direction(self, value: FlexDirection): Style {
		self.raw("flex-direction", value.value())
	}

	fun align_items(self, value: AlignItems): Style {
		self.raw("align-items", value.value())
	}

	fun justify_content(self, value: JustifyContent): Style {
		self.raw("justify-content", value.value())
	}

	fun gap(self, value: Length): Style {
		self.with_length("gap", value)
	}

	/// The `flex` shorthand — grow, shrink and basis in one value
	/// (`"1 1 auto"`, `"1"`, `"0 0 12rem"`). A string because the three parts
	/// have three different value kinds; the alternative is three methods
	/// nobody writes separately.
	fun flex(self, value: str): Style {
		self.raw("flex", value)
	}

	fun flex_shrink(self, value: f64): Style {
		self.raw("flex-shrink", i"{value}")
	}

	/// The grid track list (`"repeat(3, 1fr)"`, `"12rem 1fr"`). `fr` is a grid
	/// unit rather than a length, so the track list stays a string.
	fun grid_template_columns(self, value: str): Style {
		self.raw("grid-template-columns", value)
	}

	// --- box ---

	fun padding(self, value: Length): Style {
		self.with_length("padding", value)
	}

	fun padding_x(self, value: Length): Style {
		self.with_length("padding-left", value).with_length("padding-right", value)
	}

	fun padding_y(self, value: Length): Style {
		self.with_length("padding-top", value).with_length("padding-bottom", value)
	}

	// One edge at a time. The four come in as a FAMILY (§0bis.3): the sweep
	// wanted `padding-left`, `padding-right` and `padding-top`, and splitting
	// one CSS concept by a count is the cut the inset family already refused.
	// `padding_x`/`padding_y` write these same slots, so mixing them with an
	// edge is an ordinary last-wins override; mixing an edge with the `padding`
	// SHORTHAND resolves by authoring order too, through the family rules in
	// `rule` and `render_rule` (§0bis.4).

	fun padding_top(self, value: Length): Style {
		self.with_length("padding-top", value)
	}

	fun padding_right(self, value: Length): Style {
		self.with_length("padding-right", value)
	}

	fun padding_bottom(self, value: Length): Style {
		self.with_length("padding-bottom", value)
	}

	fun padding_left(self, value: Length): Style {
		self.with_length("padding-left", value)
	}

	fun margin(self, value: Length): Style {
		self.with_length("margin", value)
	}

	fun margin_x(self, value: Length): Style {
		self.with_length("margin-left", value).with_length("margin-right", value)
	}

	fun margin_y(self, value: Length): Style {
		self.with_length("margin-top", value).with_length("margin-bottom", value)
	}

	fun margin_top(self, value: Length): Style {
		self.with_length("margin-top", value)
	}

	fun margin_right(self, value: Length): Style {
		self.with_length("margin-right", value)
	}

	fun margin_bottom(self, value: Length): Style {
		self.with_length("margin-bottom", value)
	}

	/// `margin_left(Length::auto())` is the flex-push idiom, and was five of
	/// the nine single-edge sites in the demand sweep on its own.
	fun margin_left(self, value: Length): Style {
		self.with_length("margin-left", value)
	}

	fun width(self, value: Length): Style {
		self.with_length("width", value)
	}

	fun height(self, value: Length): Style {
		self.with_length("height", value)
	}

	/// Width and height in one call — the sizing pair's axis shorthand,
	/// `padding_x`'s pattern (one value, two slots), and the square case is
	/// the demand: `size(Length::rem(1.0))` is the icon-box idiom. One arity
	/// only, because `width(w).height(h)` already spells the rectangle and
	/// this file mints no multi-value shorthands (§0bis.5). Writes the same
	/// two slots `width` and `height` write, so mixing is the ordinary
	/// last-wins override.
	fun size(self, value: Length): Style {
		self.with_length("width", value).with_length("height", value)
	}

	fun min_width(self, value: Length): Style {
		self.with_length("min-width", value)
	}

	fun max_width(self, value: Length): Style {
		self.with_length("max-width", value)
	}

	fun min_height(self, value: Length): Style {
		self.with_length("min-height", value)
	}

	fun max_height(self, value: Length): Style {
		self.with_length("max-height", value)
	}

	// --- placement ---
	// The offsets a `position` other than `static` resolves against.

	fun top(self, value: Length): Style {
		self.with_length("top", value)
	}

	fun right(self, value: Length): Style {
		self.with_length("right", value)
	}

	fun bottom(self, value: Length): Style {
		self.with_length("bottom", value)
	}

	fun left(self, value: Length): Style {
		self.with_length("left", value)
	}

	/// All four offsets at once — `inset(space(0))` is the fill-the-parent
	/// idiom under `position(Position::Absolute)`.
	fun inset(self, value: Length): Style {
		self.with_length("inset", value)
	}

	fun radius(self, value: Length): Style {
		self.with_length("border-radius", value)
	}

	/// The one border body: `<width> solid <color>` on whichever edge the
	/// property names. `solid` is baked in because the demand sweep found
	/// ZERO non-`solid` borders across every line of styling written in the
	/// language — a `BorderStyle` enum's other variants would be speculation
	/// (§0bis.3).
	fun with_border(self, property: str, width: Length, color: Color): Style {
		if width.root != "" {
			emit("css", width.root);
		}
		if color.root != "" {
			emit("css", color.root);
		}
		self.rule("", "", property, i"{property}:{width.text} solid {color.text}")
	}

	fun border(self, width: Length, color: Color): Style {
		self.with_border("border", width, color)
	}

	fun border_top(self, width: Length, color: Color): Style {
		self.with_border("border-top", width, color)
	}

	fun border_right(self, width: Length, color: Color): Style {
		self.with_border("border-right", width, color)
	}

	fun border_bottom(self, width: Length, color: Color): Style {
		self.with_border("border-bottom", width, color)
	}

	fun border_left(self, width: Length, color: Color): Style {
		self.with_border("border-left", width, color)
	}

	/// No border. Written as a method rather than a `BorderStyle::None` so it
	/// fills the SAME slot `border` does — removing a border a base style set
	/// is then the ordinary last-wins override, not a second rule racing the
	/// first through the cascade.
	fun border_none(self): Style {
		self.raw("border", "none")
	}

	/// Just the colour, its own slot — so a `hover`/`focus` variant can
	/// recolour a border without restating its width, which is what four of
	/// the five real `border-color` sites were doing by hand.
	fun border_color(self, value: Color): Style {
		self.with_color("border-color", value)
	}

	/// A shadow list (`"0 1px 2px rgba(0,0,0,0.08)"`, `"none"`). Comma-joined
	/// layers of four lengths and a colour: a string, like `transition`.
	fun box_shadow(self, value: str): Style {
		self.raw("box-shadow", value)
	}

	fun overflow(self, value: Overflow): Style {
		self.raw("overflow", value.value())
	}

	// --- color & text ---

	fun background(self, value: Color): Style {
		self.with_color("background-color", value)
	}

	/// A gradient, on the `background-image` slot — a DIFFERENT slot from
	/// `background`, because a gradient is an image in CSS and paints over
	/// the background colour rather than replacing it. Each stop's colour
	/// carries its `:root` line out here, so a gradient of ramp tokens themes
	/// like any other value.
	fun background_gradient(self, value: Gradient): Style {
		if value.stop_count < 2 {
			panic(i"a gradient needs at least two stops, got {value.stop_count} — add .stop(color, percent)");
		}
		for root in value.roots {
			emit("css", root);
		}
		self.rule("", "", "background-image", "background-image:" + value.render())
	}

	/// The SAME slot `background_gradient` writes, as CSS text — the escape for
	/// the image values a `Gradient` cannot hold: a `url()` or data URI, a
	/// multi-layer list, a positioned or `repeating-*` gradient. One slot and
	/// two methods is deliberate, the `border`/`border_none` shape: they
	/// override each other under the ordinary last-wins rule, where two
	/// different slots would race in the cascade. Reach for
	/// `background_gradient` when a `Gradient` holds the value.
	fun background_image(self, value: str): Style {
		check_not_blank("background_image", value);
		self.raw("background-image", value)
	}

	/// How the background image is sized (`"cover"`, `"120px 120px"`,
	/// `"calc(100% - 2rem) auto"`). A string because the value is up to two
	/// components per layer, which one `Length` cannot hold — the `flex` and
	/// `grid_template_columns` bargain. It ships WITH `background_image` rather
	/// than on its own count: a size is inert without an image (§0bis.5).
	fun background_size(self, value: str): Style {
		check_not_blank("background_size", value);
		self.raw("background-size", value)
	}

	fun color(self, value: Color): Style {
		self.with_color("color", value)
	}

	/// A font stack (`"system-ui, sans-serif"`). A string: the value is an
	/// ordered fallback list of names the compiler has nothing to check.
	fun font_family(self, value: str): Style {
		self.raw("font-family", value)
	}

	fun font_size(self, value: Length): Style {
		self.with_length("font-size", value)
	}

	fun font_weight(self, value: i32): Style {
		self.raw("font-weight", i"{value}")
	}

	/// Tracking. Usually `Length::em(..)`, so it scales with the font size.
	fun letter_spacing(self, value: Length): Style {
		self.with_length("letter-spacing", value)
	}

	/// The `text-decoration` shorthand (`"underline"`, `"line-through"`,
	/// `"none"`, or a full `"underline wavy #dc2626 1.5px"`).
	fun text_decoration(self, value: str): Style {
		self.raw("text-decoration", value)
	}

	fun white_space(self, value: WhiteSpace): Style {
		self.raw("white-space", value.value())
	}

	fun user_select(self, value: UserSelect): Style {
		self.raw("user-select", value.value())
	}

	/// The unitless form, and the one to prefer: a number inherits as a RATIO
	/// and re-computes against each descendant's own font size.
	fun line_height(self, value: f64): Style {
		self.raw("line-height", i"{value}")
	}

	/// A line height WITH a unit, on the same slot `line_height` writes — a
	/// sibling rather than a widened `line_height`, since the language has no
	/// overloading and the `f64` form keeps its name and its callers. A length
	/// inherits as a COMPUTED LENGTH, so it will not track a descendant that
	/// resizes its text; reach for it when the design specifies a leading in px.
	fun line_height_length(self, value: Length): Style {
		self.with_length("line-height", value)
	}

	fun text_align(self, value: TextAlign): Style {
		self.raw("text-align", value.value())
	}

	fun cursor(self, value: Cursor): Style {
		self.raw("cursor", value.value())
	}

	fun opacity(self, value: f64): Style {
		self.raw("opacity", i"{value}")
	}

	fun transition(self, value: str): Style {
		self.raw("transition", value)
	}

	/// A transform list (`"translateY(-2px)"`, `"rotate(45deg) scale(1.1)"`).
	/// A string: the functions take angles, ratios and lengths in one value.
	fun transform(self, value: str): Style {
		self.raw("transform", value)
	}

	// --- conditions ---
	// A condition takes a Style built by its own chain and re-emits each of
	// its properties under the condition's selector. (The inner chain's base
	// rules also emit — deduplicated, possibly unused: the recorded
	// over-approximation, shared with unused styles generally.)
	//
	// The four axes nest OUTSIDE-IN in the order the selector nests them:
	// media, then the relation, then the attribute, then the pseudo-class —
	// `md(within(.., attribute(.., hover(..))))`. Every other order is a build
	// error naming the fix, so there is exactly one spelling per combination
	// and one slot key per combination with it. One relation per slot, and
	// the child-side relations (`children`, `divide`) take an unconditioned
	// inner in v1: a pseudo or attribute under them would bind to the CHILD's
	// compound, which is semantics nobody has ruled yet.

	fun hover(self, inner: Style): Style {
		self.pseudo("hover", inner)
	}

	fun focus(self, inner: Style): Style {
		self.pseudo("focus", inner)
	}

	fun active(self, inner: Style): Style {
		self.pseudo("active", inner)
	}

	fun disabled(self, inner: Style): Style {
		self.pseudo("disabled", inner)
	}

	fun first(self, inner: Style): Style {
		self.pseudo("first-child", inner)
	}

	fun last(self, inner: Style): Style {
		self.pseudo("last-child", inner)
	}

	/// The ancestor guard — `[name="value"] .sX`: the element's own slots,
	/// conditioned on an ANCESTOR carrying the attribute. The theme condition
	/// is its motivating instance — `within("data-theme", "dark", ..)` under a
	/// root the app stamps, and SSR-friendly for the same reason the deleted
	/// `dark()` was: the server sets the attribute before a byte of JS runs —
	/// but any ancestor state rides: an n-ary theme id, a density mode, a
	/// `[data-collapsed]` sidebar. The guard's rule is UNLAYERED and (0,2,0),
	/// so it beats the element's own base rule (0,1,0) exactly when the
	/// ancestor matches; ties against a pseudo rule resolve to the guard by
	/// the sheet's band order (the theme beats the state — ui-styling.md
	/// §0bis.6's ledger).
	///
	/// Takes dark's grammar seat: an attribute and a pseudo-class nest INSIDE
	/// (`within(.., attribute(.., hover(..)))` — the composed rule outranks
	/// its parts on specificity), media nests outside, and no relation wraps
	/// a relation. Name and value are fenced at const time like `attribute`'s
	/// — one token, no quotes, spaces or `:`.
	fun within(self, name: str, value: str, inner: Style): Style {
		check_attribute_name(name);
		check_attribute_value(value);
		mut out = self;
		for key in inner.rules.keys() {
			match inner.rules.get(key) {
				Some(let entry) => {
					let (_class, declaration) = entry;
					let parts = key.split(":");
					if parts[0] != "" {
						panic("nest conditions as md(within(..)) — within cannot wrap a media-conditioned style");
					}
					if condition_relation(parts[1]) != "" {
						panic("within cannot wrap an already relation-conditioned style — one within, children or divide per slot");
					}
					let token = i"^[{name}=\"{value}\"]";
					let condition = if parts[1] == "" {
						token
					} else {
						token + " " + parts[1]
					};
					out = out.rule("", condition, parts[2], declaration);
				}
				None => {}
			}
		}
		out
	}

	/// Styles every direct CHILD of the element — `.sX > *`, the parent-owned
	/// spacing idiom (Tailwind's `space-*` family). The rule emits inside
	/// `@layer vilan`, and that is the whole cascade story: a child's own
	/// `Style` always wins against a rule reaching in from an ancestor,
	/// because unlayered styles beat layered ones whatever their specificity.
	/// The symmetric cost is real: a children rule cannot override ANY
	/// unlayered declaration, so this is a default the child may refuse, not
	/// an escape hatch.
	fun children(self, inner: Style): Style {
		self.child_relation(">*", "children", inner)
	}

	/// Styles every direct child BUT THE FIRST — the between-children slot
	/// (Tailwind's `divide-*`), rendered `> :not(:first-child)` rather than
	/// `> * + *`: the same element set, but carrying the argument's (0,1,0)
	/// so the whole selector is (0,2,0) — on a property `children` also
	/// touches, divide outranks it by SPECIFICITY, whatever the authoring
	/// order, instead of tying and falling to the class-hash line order
	/// (§0bis.6). Layered like `children`, with the same standing.
	fun divide(self, inner: Style): Style {
		self.child_relation(">*+*", "divide", inner)
	}

	/// The two child-side relations' shared chokepoint. Their inner style is
	/// UNCONDITIONED in v1 — a pseudo or attribute under a child combinator
	/// would bind to the child's compound (`.sX > *:hover`), semantics no
	/// ruling has settled — and media wraps from outside as ever.
	fun child_relation(self, token: str, name: str, inner: Style): Style {
		mut out = self;
		for key in inner.rules.keys() {
			match inner.rules.get(key) {
				Some(let entry) => {
					let (_class, declaration) = entry;
					let parts = key.split(":");
					if parts[0] != "" {
						panic(i"nest conditions as md({name}(..)) — {name} cannot wrap a media-conditioned style");
					}
					if parts[1] != "" {
						panic(i"{name} takes an unconditioned style — a hover, attribute or within condition belongs on the child's own style");
					}
					out = out.rule("", token, parts[2], declaration);
				}
				None => {}
			}
		}
		out
	}

	/// An attribute condition on the element ITSELF — `.sX[data-open="true"]`
	/// — where `within` is the ancestor form. The general spelling of state
	/// carried in markup: `data-state`, `data-open`, `aria-expanded` — any
	/// attribute rides, `aria-*` included, and the value matches exactly
	/// (CSS `[name="value"]`). Its own slot in the condition axis, between
	/// the relation and the pseudo-class —
	/// `md(within(.., attribute(.., hover(..))))` — so a theme guard composes
	/// with an element's state; every other order is refused naming the fix,
	/// and one attribute per slot, like one relation and one pseudo-class.
	/// The composed rule outranks its parts on SPECIFICITY:
	/// `.sX[..]:hover` is (0,3,0) over both (0,2,0) components.
	///
	/// The app owns SETTING the attribute on the element; the style only
	/// selects on it. Name and value are validated at const time: no quotes,
	/// no spaces, no `:` — those delimit the machinery underneath (the slot
	/// key, the condition grammar, the selector's own quoting), and a styling
	/// hook is a single token in practice.
	fun attribute(self, name: str, value: str, inner: Style): Style {
		check_attribute_name(name);
		check_attribute_value(value);
		mut out = self;
		for key in inner.rules.keys() {
			match inner.rules.get(key) {
				Some(let entry) => {
					let (_class, declaration) = entry;
					let parts = key.split(":");
					if parts[0] != "" {
						panic("nest conditions as md(attribute(..)) — attribute cannot wrap a media-conditioned style");
					}
					if condition_relation(parts[1]) != "" {
						panic("nest the relation OUTSIDE the attribute — within(.., attribute(..)), not attribute(within(..))");
					}
					if condition_attribute(parts[1]) != "" {
						panic("attribute cannot wrap an already attribute-conditioned style");
					}
					let token = i"[{name}=\"{value}\"]";
					let condition = if parts[1] == "" {
						token
					} else {
						token + " " + parts[1]
					};
					out = out.rule("", condition, parts[2], declaration);
				}
				None => {}
			}
		}
		out
	}

	/// An arbitrary pseudo-class — `.pseudo("focus-visible", ..)`; the named
	/// methods above are the common set. A pseudo-class takes the INNERMOST
	/// position: a relation, an attribute and a breakpoint may wrap it, and it
	/// may wrap none of them (nor another pseudo-class).
	fun pseudo(self, name: str, inner: Style): Style {
		mut out = self;
		for key in inner.rules.keys() {
			match inner.rules.get(key) {
				Some(let entry) => {
					let (_class, declaration) = entry;
					let parts = key.split(":");
					if parts[0] != "" {
						panic(i"nest conditions as md(hover(..)) — {name} cannot wrap a media-conditioned style");
					}
					if condition_relation(parts[1]) != "" {
						panic(i"nest the relation OUTSIDE the pseudo — within(.., {name}(..)), not {name}(within(..))");
					}
					if condition_attribute(parts[1]) != "" {
						panic(i"nest the attribute OUTSIDE the pseudo — attribute(.., {name}(..)), not {name}(attribute(..))");
					}
					if parts[1] != "" {
						panic(i"{name} cannot wrap an already pseudo-conditioned style");
					}
					out = out.rule("", name, parts[2], declaration);
				}
				None => {}
			}
		}
		out
	}

	/// Breakpoints (Tailwind's): min-width media queries. Media is the
	/// OUTERMOST condition — it may wrap a pseudo-conditioned style
	/// (`md(hover(..))`), a relation-conditioned one (`md(within(..))`,
	/// `md(children(..))`) or a full stack (`md(within(.., hover(..)))`),
	/// and never another media.
	fun sm(self, inner: Style): Style {
		self.media("640px", inner)
	}

	fun md(self, inner: Style): Style {
		self.media("768px", inner)
	}

	fun lg(self, inner: Style): Style {
		self.media("1024px", inner)
	}

	fun xl(self, inner: Style): Style {
		self.media("1280px", inner)
	}

	fun media(self, min_width: str, inner: Style): Style {
		mut out = self;
		for key in inner.rules.keys() {
			match inner.rules.get(key) {
				Some(let entry) => {
					let (_class, declaration) = entry;
					let parts = key.split(":");
					if parts[0] != "" {
						panic("a breakpoint cannot wrap another media-conditioned style");
					}
					out = out.rule(min_width, parts[1], parts[2], declaration);
				}
				None => {}
			}
		}
		out
	}

	/// The rendered class attribute: every slot's class, space-joined.
	/// Runtime-legal (no emission) — selection and merging stay ordinary code.
	fun class_list(self): str {
		mut out = "";
		for entry in self.rules.values() {
			let (class, _declaration) = entry;
			if out == "" {
				out = class;
			} else {
				out = out + " " + class;
			}
		}
		out
	}
}

// `+` combines NAMED styles: per-property, right side wins — and per FAMILY,
// so a `border` on the right clears a `border-color` on the left exactly as it
// would inside one chain. Still runtime-legal: the rules were already emitted
// when each side was constructed, and resolving a family here is a map removal
// (§0bis.4 — the `+` path is why the fix could not be a shorthand SPLIT, which
// would have had to emit rules that did not exist yet).
//
// `b`'s slots replay in b's own insertion order, which is its authoring order,
// so a right side that itself mixes a shorthand and a longhand lands the same
// way it resolved on its own.
impl Style with Add {
	fun add(self, b: Style): Style {
		mut rules = self.rules;
		for key in b.rules.keys() {
			match b.rules.get(key) {
				Some(let entry) => {
					let parts = key.split(":");
					rules = without_covered(rules, parts[0], parts[1], parts[2]);
					rules.insert(key, entry);
				}
				None => {}
			}
		}
		Style { rules = rules }
	}
}

// --- declaration blocks -----------------------------------------------------------

/// A set of CSS declarations carrying NO slot key, no class name and no
/// `Style` — the body `declare` puts under an author-chosen selector. Built
/// like a style chain, but each link appends TEXT: nothing here is hashed, so
/// nothing here can mint a class name or move one.
///
/// This is the other door into the const-only CSS channel, and it is
/// deliberately narrow. `Style` is how you dress an ELEMENT — atomic, merged
/// by record update, cascade-free by construction. A declaration block is how
/// you declare something the element model cannot reach: a theme's custom
/// properties under `[data-theme="…"]`, a `:root` token table, a reset's
/// `box-sizing`. Reach for `Style` first; reach for this when the thing being
/// styled is a selector rather than a view.
struct Declarations {
	// `property:value` pairs, `;`-joined; "" while empty.
	text: str,
	// The `:root` lines of the theme tokens spent in those declarations,
	// carried on the value and put on the sheet by `declare` — the `Gradient`
	// shape. A chain builds no sheet lines of its own, which is what keeps the
	// whole surface usable outside a `const` expression.
	roots: List<str>,
}

/// Opens a declaration chain — `style()`'s counterpart on the text side of
/// the channel. Nothing reaches the stylesheet until `declare` puts the chain
/// under a selector — a token's `:root` line included: the chain accumulates
/// the lines it owes and `declare` puts them there with the block.
fun declarations(): Declarations {
	Declarations { text = "", roots = [] }
}

impl Declarations {
	/// Any property, any `CssValue` — `Style::raw`'s counterpart, and the
	/// spelling for the two things this surface exists for: a custom property
	/// (`--color-ink`) and a plain CSS property under a selector no class
	/// names. A `Length` or `Color` value carries its own `:root` token line
	/// onto the sheet, so a token spent here is never a dangling `var()`.
	fun raw<V: CssValue>(self, property: str, value: V): Declarations {
		let text = value.css_text();
		check_declaration(property, text);
		mut roots = self.roots;
		let root = value.css_root();
		if root != "" {
			roots.push(root);
		}
		let pair = property + ":" + text;
		Declarations {
			text = if self.text == "" {
				pair
			} else {
				self.text + ";" + pair
			},
			roots = roots,
		}
	}

	/// A `Color`-valued declaration. Exactly `raw` at that instantiation,
	/// kept for the spelling the surface has always had.
	fun color(self, property: str, value: Color): Declarations {
		self.raw(property, value)
	}

	/// A `Length`-valued declaration — `color`'s twin.
	fun length(self, property: str, value: Length): Declarations {
		self.raw(property, value)
	}
}

/// Puts `body`'s declarations under `selector`, as one line of CSS text in
/// the build's stylesheet. It mints NO class, produces no `Style`, touches no
/// slot key and rehashes nothing — the atomic system is untouched, and a
/// build that never calls `declare` emits a byte-identical sheet.
///
/// It is the escape hatch apps were hand-rolling through `asset::emit`, with
/// the line surgery removed: the channel appends a LINE, dedups by line and
/// sorts by line, so a hand-rolled block had to flatten its own declarations
/// with a string `replace`. `declare` builds the one line itself.
///
/// **Ordering.** The block emits inside one cascade layer, `@layer vilan`,
/// and that IS the ordering rule — there is no band to reason about and no
/// dependence on where the line lands in the sheet's sort. Unlayered styles
/// beat layered ones in the cascade whatever their specificity, so **a
/// `Style` always wins over a declaration block**, and a block can never
/// reach in and out-specify a view's own rules. That keeps the system's
/// cascade-free promise intact for everything a `Style` spells, and weakens
/// it only among blocks an author opted into, where ordinary CSS rules apply
/// (specificity first, then the sheet's own deterministic line order).
///
/// The other face of the same rule: a declaration block cannot override an
/// UNLAYERED declaration either — including std's own `:root` token lines
/// (`--space-4`, `--gray-50`) and any hand-written CSS the page loads
/// unlayered. Declare your own custom properties and read them with
/// `Color::var` / `Length::var`; that is the recipe the estate already uses,
/// and it composes with this one exactly.
///
/// ```vilan,fragment
/// const declare(i"[data-theme=\"{id}\"]", declarations()
///     .color("--color-ink", Color::hex("#fafafa"))
///     .color("--color-ground", Color::hex("#161616")))
/// // @layer vilan{[data-theme="iron-dark"]{--color-ink:#fafafa;--color-ground:#161616}}
/// ```
fun declare(selector: str, body: Declarations) {
	check_selector(selector);
	if body.text == "" {
		panic(i"the declaration block for \"{selector}\" declares nothing — add a declaration with .raw(..), .color(..) or .length(..), or drop the block");
	}
	// The tokens the block spent, declared beside it — a ramp step or a
	// spacing step used here is never a dangling `var()`. The channel dedups
	// by line, so a token the styles already emitted costs nothing.
	for root in body.roots {
		emit("css", root);
	}
	emit("css", "@layer vilan{" + selector + "{" + body.text + "}}");
}

/// A base stylesheet — the opinionated reset (kolt.local 008) an app opts
/// into with one `const preflight()` and opts out of by deleting the line.
///
/// **What it is.** Tailwind's preflight scope, adapted: `box-sizing:
/// border-box` everywhere, the UA's margins zeroed, its form-control chrome
/// stripped so a button inherits the page's font and colour instead of the
/// platform's, replaced elements laid out as blocks that cannot overflow their
/// container, list markers and heading sizes removed, and the ruling's own
/// addition — **`a`, `button` and `select` are `display: block`**. That last
/// one is the most visible: an anchor in running prose becomes a block, so a
/// page that wants inline links styles them back. It is a deliberate,
/// opinionated default, not a normalization.
///
/// **Why it is opt-in.** A reset baked into every build would be a breaking
/// change for anyone styling against UA defaults, and there is no way to
/// unsend one. So it is a std style asset the app EMITS, like `declare` — the
/// only door into the stylesheet is a `const` expression, and a build that
/// never calls this emits a byte-identical sheet. It deliberately is NOT a
/// `Document::of` option: `Document` reads a build's manifest and writes one
/// `<link>`, it has no channel into the sheet at all, and a browser-only
/// project — the one that most wants a reset — has no server leg to call it
/// from.
///
/// **Ordering, which is the whole design.** Every rule here goes in
/// `@layer vilan.preflight`, a SUB-layer of the layer `declare` and the
/// child-side relations use. That settles precedence by the cascade rather
/// than by where a line lands in the sheet's sort, twice over and in the same
/// direction each time:
///
/// - unlayered beats layered, so **every `Style` wins against every reset
///   rule**, whatever either one's specificity — the same guarantee `declare`
///   already gives, unchanged;
/// - a layer's own rules beat its sub-layers', so **every `declare` block wins
///   against every reset rule** too, and an app that resets `button` further
///   does not have to out-specify std to do it.
///
/// The reset is therefore the weakest author-origin thing in the sheet, which
/// is exactly what a reset should be — and it is still stronger than every UA
/// default, because layers order AUTHOR declarations and the UA origin loses
/// to all of them. Nothing above depends on the sheet's byte order, which
/// matters because that order is a lexical sort with no notion of a reset
/// (`const-eval.md` §3).
///
/// ```vilan,fragment
/// let _reset = const preflight();
/// // @layer vilan.preflight{*,::before,::after{box-sizing:border-box}}
/// // …and one line per rule below, deduped and sorted with everything else
/// ```
fun preflight() {
	// Structure. The universal box model is the one rule the whole system
	// leans on: `width(px(200)).padding(space(4))` measures 200 under it and
	// 232 without.
	preflight_rule("*,::before,::after", declarations().raw("box-sizing", "border-box"));
	preflight_rule("html", declarations()
		.raw("line-height", "1.5")
		.raw("-webkit-text-size-adjust", "100%")
		.raw("tab-size", "4"));
	preflight_rule("body", declarations().raw("margin", "0").raw("line-height", "inherit"));

	// The UA's margins, gone — the block elements that carry one by default.
	preflight_rule("blockquote,dl,dd,h1,h2,h3,h4,h5,h6,hr,figure,p,pre", declarations().raw("margin", "0"));
	preflight_rule("fieldset", declarations().raw("margin", "0").raw("padding", "0"));
	preflight_rule("legend", declarations().raw("padding", "0"));
	preflight_rule("dialog", declarations().raw("padding", "0"));
	preflight_rule("ol,ul,menu", declarations()
		.raw("list-style", "none")
		.raw("margin", "0")
		.raw("padding", "0"));

	// Typography: headings and small print stop having sizes of their own, so
	// a type scale is the app's to state.
	preflight_rule("h1,h2,h3,h4,h5,h6", declarations()
		.raw("font-size", "inherit")
		.raw("font-weight", "inherit"));
	preflight_rule("b,strong", declarations().raw("font-weight", "bolder"));
	preflight_rule("small", declarations().raw("font-size", "80%"));
	preflight_rule("code,kbd,samp,pre", declarations()
		.raw("font-family", "ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace")
		.raw("font-size", "1em"));
	preflight_rule("a", declarations().raw("color", "inherit").raw("text-decoration", "inherit"));
	preflight_rule("table", declarations()
		.raw("text-indent", "0")
		.raw("border-color", "inherit")
		.raw("border-collapse", "collapse"));
	preflight_rule("hr", declarations()
		.raw("height", "0")
		.raw("color", "inherit")
		.raw("border-top-width", "1px"));

	// Form controls: the platform's chrome off, the page's typography on.
	preflight_rule("button,input,optgroup,select,textarea", declarations()
		.raw("font-family", "inherit")
		.raw("font-size", "100%")
		.raw("font-weight", "inherit")
		.raw("line-height", "inherit")
		.raw("color", "inherit")
		.raw("margin", "0")
		.raw("padding", "0")
		.raw("border", "0")
		.raw("background-color", "transparent"));
	preflight_rule("button,select", declarations().raw("text-transform", "none"));
	preflight_rule("button,[type=\"button\"],[type=\"reset\"],[type=\"submit\"]", declarations()
		.raw("-webkit-appearance", "button")
		.raw("background-image", "none"));
	preflight_rule("[type=\"search\"]", declarations()
		.raw("-webkit-appearance", "textfield")
		.raw("outline-offset", "-2px"));
	preflight_rule("::-webkit-search-decoration", declarations().raw("-webkit-appearance", "none"));
	preflight_rule("::-webkit-file-upload-button", declarations()
		.raw("-webkit-appearance", "button")
		.raw("font", "inherit"));
	preflight_rule("textarea", declarations().raw("resize", "vertical"));
	preflight_rule("input::placeholder,textarea::placeholder", declarations()
		.raw("opacity", "1")
		.raw("color", "#9ca3af"));
	preflight_rule("button,[role=\"button\"]", declarations().raw("cursor", "pointer"));
	preflight_rule("progress", declarations().raw("vertical-align", "baseline"));
	preflight_rule("summary", declarations().raw("display", "list-item"));

	// Replaced elements lay out as blocks and cannot overflow their container.
	preflight_rule("img,svg,video,canvas,audio,iframe,embed,object", declarations()
		.raw("display", "block")
		.raw("vertical-align", "middle"));
	preflight_rule("img,video", declarations().raw("max-width", "100%").raw("height", "auto"));

	// The ruling's own addition, stated on its own line so it reads as the
	// decision it is: an anchor, a button and a select are BLOCKS here, where
	// every reset this one is adapted from leaves them inline.
	preflight_rule("a,button,select", declarations().raw("display", "block"));

	// `[hidden]` last in reading order and strongest in the cascade — (0,1,0)
	// against the element selectors above, so hiding still wins.
	preflight_rule("[hidden]", declarations().raw("display", "none"));
}

/// One [`preflight`] rule, in the reset's own sub-layer. Internal to this
/// module by the same convention `render_rule` and `check_selector` keep — the
/// language has no privacy modifier here, so what makes it internal is that it
/// is absent from the reference surface: `@layer vilan.preflight` is std's
/// floor, not a third place an app puts declarations. `declare` is the app's
/// door, and it deliberately lands one layer ABOVE this one.
fun preflight_rule(selector: str, body: Declarations) {
	check_selector(selector);
	// Tokens spent in a rule declare themselves beside it, exactly as
	// `declare` does. Nothing in the reset above spends one today; the loop
	// is here so a later rule that does cannot leave a dangling `var()`.
	for root in body.roots {
		emit("css", root);
	}
	emit("css", "@layer vilan.preflight{" + selector + "{" + body.text + "}}");
}

/// What a declaration block's SELECTOR must avoid, in the const-time-refusal
/// style the rest of this module validates in.
///
/// A NEWLINE is the structural one: the asset channel is line-granular, so a
/// newline does not indent the rule, it SPLITS it into two lines that then
/// dedup and sort independently of each other — which is exactly the tax the
/// hand-rolled hatch paid with `.replace(";\n--", ";--")`, and refusing it
/// here is what lets the tax be deleted rather than moved.
///
/// A BRACE is the other: the block's braces are `declare`'s to write, and a
/// selector carrying one either closes the rule early or opens a nested one.
/// Refusing both braces outright is stronger than requiring them balanced,
/// and a selector never legitimately contains one.
///
/// An AT-RULE is refused by design, not by omission. This surface puts
/// DECLARATIONS under a selector; a conditional group rule (`@media`,
/// `@supports`) holds RULES, so `@media (…){color:red}` would be invalid CSS
/// the moment it were admitted, and the surface's meaning would depend on the
/// first byte of its argument. `@font-face` — the one at-rule that does hold
/// declarations — is a separate spelling and is left to its own item.
/// Everything else a selector needs rides: quotes, brackets, `:`, `>`, `~`,
/// `,` and spaces are all legal here, which is what makes
/// `[data-theme="iron-dark"]` and `:root` say what they mean.
fun check_selector(selector: str) {
	check_not_blank("a declaration block's selector", selector);
	for banned in ["\n", "\r"] {
		if selector.contains(banned) {
			panic(i"a declaration block's selector cannot contain a newline (got \"{selector}\") — the CSS channel is line-granular, so write the selector on one line");
		}
	}
	for banned in ["{", "}"] {
		if selector.contains(banned) {
			panic(i"a declaration block's selector cannot contain '{banned}' (got \"{selector}\") — declare writes the block's braces, so pass the selector alone");
		}
	}
	if selector.trim().starts_with("@") {
		panic(i"a declaration block's selector cannot be an at-rule (got \"{selector}\") — declare puts declarations under a SELECTOR, and a group at-rule holds rules, not declarations; write the inner selector instead");
	}
}

/// What one declaration must avoid. The property name owns the `:` that
/// separates it from its value and the `;` that separates it from the next
/// declaration, so it may carry neither; both halves refuse newlines (the
/// line-granular channel) and braces (the block's own).
///
/// A `;` in the VALUE stays legal, deliberately: a data URI carries one
/// (`url("data:image/svg+xml;base64,…")`), and refusing it would refuse the
/// inline-asset spelling the estate actually writes.
fun check_declaration(property: str, value: str) {
	check_not_blank("a declaration's property", property);
	check_not_blank(i"the value for \"{property}\"", value);
	for banned in ["\n", "\r"] {
		if property.contains(banned) || value.contains(banned) {
			panic(i"the declaration \"{property}\" cannot contain a newline — the CSS channel is line-granular, so write the declaration on one line");
		}
	}
	for banned in ["{", "}"] {
		if property.contains(banned) || value.contains(banned) {
			panic(i"the declaration \"{property}\" cannot contain '{banned}' — declare writes the block's braces");
		}
	}
	for banned in [":", ";"] {
		if property.contains(banned) {
			panic(i"a declaration's property cannot contain '{banned}' (got \"{property}\") — it separates the property from its value and from the next declaration; pass the value as the second argument");
		}
	}
}
