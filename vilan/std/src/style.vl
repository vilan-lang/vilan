// Typed atomic styles, compiled (proposal/ui-styling.md). A `Style` maps
// property SLOTS to `(class name, declaration)` pairs; each property method
// merges one property in — LAST WINS, a record update, never a cascade — and
// emits the atomic rule through the const-only asset channel, so styles
// construct inside `const` expressions and the whole stylesheet exists at
// build time. `+` combines named styles (right side wins per property).
//
// Slot keys encode conditions as `media:condition:property`, where a CONDITION
// is "" (base), a pseudo-class ("hover"), the dark marker ("dark"), or dark
// stacked over a pseudo-class ("dark hover") — the space mirroring the
// descendant combinator the selector renders. Conditions nest OUTSIDE-IN in
// the order the CSS nests them, `md(dark(hover(..)))`; any other order is
// refused with a message naming the fix. Class names are
// content hashes of `key|declaration` (deterministic across builds — the
// channel dedups identical rules program-wide, which is what makes the
// stylesheet plateau). Themeable tokens carry their value as a CSS custom
// property (`var(--space-4)`) plus the `:root` line declaring it — re-theming
// and dark mode swap property values with zero recompilation.
//
// Properties that COVER other properties (`padding` over its four edges,
// `border` over its parts) form FAMILIES, and last-wins holds across a family,
// not just across one property (§0bis.4): a shorthand set later drops the
// slots it covers, and a shorthand's rule renders `*.sX{..}` so the lexical
// sort puts it ahead of its family's longhands. The two meet exactly — a
// shorthand and a longhand survive together only when the longhand came last —
// so a family resolves by AUTHORING order, the way every other merge here
// does, and never by the class-name sort.

import pkg::asset::emit;
import pkg::io::panic;
import pkg::map::Map;
import pkg::operators::Add;
import pkg::option::Option::{ None, Some, self };
import pkg::range::Range;

// --- values -------------------------------------------------------------------

/// A CSS length: a token's IDENTITY (`var(--space-4)`) or a literal unit.
/// `root` carries the token's `:root` declaration ("" when none).
struct Length {
	css: str,
	root: str,
}

impl Length {
	fun px(value: f64): Length {
		Length { css = i"{value}px", root = "" }
	}

	fun rem(value: f64): Length {
		Length { css = i"{value}rem", root = "" }
	}

	/// Relative to the element's own font size — the unit `letter_spacing`
	/// and optical spacing are written in.
	fun em(value: f64): Length {
		Length { css = i"{value}em", root = "" }
	}

	fun pct(value: f64): Length {
		Length { css = i"{value}%", root = "" }
	}

	/// Viewport units. `min_height(Length::vh(100.0))` is the full-height
	/// shell.
	fun vh(value: f64): Length {
		Length { css = i"{value}vh", root = "" }
	}

	fun vw(value: f64): Length {
		Length { css = i"{value}vw", root = "" }
	}

	fun auto(): Length {
		Length { css = "auto", root = "" }
	}

	/// Bare `0` — the unit-less zero CSS accepts for any length, and what the
	/// `min-width:0` flex idiom and the `inset:0` fill-the-parent idiom are
	/// written as. `space(0)` renders `var(--space-0)` and `Length::px(0.0)`
	/// renders `0px`; all three compute the same, and this one is the spelling.
	fun zero(): Length {
		Length { css = "0", root = "" }
	}

	/// A `calc()` expression, written WITHOUT the wrapper:
	/// `Length::calc("100% - 2rem")`. The property stays typed while the
	/// arithmetic — which the `Length` representation deliberately does not
	/// model — rides a string. Composes with tokens through their rendered
	/// form, e.g. `Length::calc("100vh - var(--space-16)")`.
	///
	/// Sugar over `css`: `Length::calc(e)` is `Length::css("calc(" + e + ")")`.
	fun calc(expression: str): Length {
		check_not_blank("Length::calc", expression);
		Length { css = i"calc({expression})", root = "" }
	}

	/// A complete CSS value, verbatim — `Color::hex`'s twin for lengths, and
	/// the escape for the functional values the representation does not model:
	/// `Length::css("clamp(120px, 100vw, 1920px)")`, `min()`, `max()`, `env()`,
	/// `fit-content()`. Use `calc` when you are writing ARITHMETIC and want the
	/// wrapper supplied; use this when the value is already whole, which is also
	/// what lets one named expression be reused across properties.
	///
	/// (`clamp`/`min`/`max` also nest inside `calc()`, so `calc` reaches them
	/// too — at the cost of a wrapper the author did not write.)
	fun css(expression: str): Length {
		check_not_blank("Length::css", expression);
		Length { css = expression, root = "" }
	}

	/// The typed end of the dynamic-value channel: pairs with
	/// `view.style_var(name, signal)` writing the custom property at runtime.
	fun var(name: str): Length {
		Length { css = i"var({name})", root = "" }
	}
}

/// The spacing scale (Tailwind's, rem-based). The scale is data; the
/// validation is const evaluation — an unknown step fails the build.
fun space(step: i32): Length {
	let value = match step {
		0 => "0px",
		1 => "0.25rem",
		2 => "0.5rem",
		3 => "0.75rem",
		4 => "1rem",
		5 => "1.25rem",
		6 => "1.5rem",
		8 => "2rem",
		10 => "2.5rem",
		12 => "3rem",
		16 => "4rem",
		20 => "5rem",
		24 => "6rem",
		_ => panic(i"unknown spacing step {step} (the scale has 0-6, 8, 10, 12, 16, 20, 24)"),
	};
	Length { css = i"var(--space-{step})", root = i":root\{--space-{step}:{value}\}" }
}

/// A CSS color: a ramp token's identity (`var(--gray-50)`) or a literal.
struct Color {
	css: str,
	root: str,
}

fun ramp(name: str, step: i32, value: str): Color {
	Color { css = i"var(--{name}-{step})", root = i":root\{--{name}-{step}:{value}\}" }
}

impl Color {
	fun white(): Color {
		Color { css = "#ffffff", root = "" }
	}

	fun black(): Color {
		Color { css = "#000000", root = "" }
	}

	fun transparent(): Color {
		Color { css = "transparent", root = "" }
	}

	/// The typed arbitrary-value escape.
	fun hex(value: str): Color {
		Color { css = value, root = "" }
	}

	fun gray(step: i32): Color {
		ramp("gray", step, match step {
			50 => "#f9fafb",
			100 => "#f3f4f6",
			200 => "#e5e7eb",
			300 => "#d1d5db",
			400 => "#9ca3af",
			500 => "#6b7280",
			600 => "#4b5563",
			700 => "#374151",
			800 => "#1f2937",
			900 => "#111827",
			_ => panic(i"unknown gray step {step} (ramps run 50, 100-900 by hundreds)"),
		})
	}

	fun blue(step: i32): Color {
		ramp("blue", step, match step {
			50 => "#eff6ff",
			100 => "#dbeafe",
			200 => "#bfdbfe",
			300 => "#93c5fd",
			400 => "#60a5fa",
			500 => "#3b82f6",
			600 => "#2563eb",
			700 => "#1d4ed8",
			800 => "#1e40af",
			900 => "#1e3a8a",
			_ => panic(i"unknown blue step {step} (ramps run 50, 100-900 by hundreds)"),
		})
	}

	fun red(step: i32): Color {
		ramp("red", step, match step {
			50 => "#fef2f2",
			100 => "#fee2e2",
			200 => "#fecaca",
			300 => "#fca5a5",
			400 => "#f87171",
			500 => "#ef4444",
			600 => "#dc2626",
			700 => "#b91c1c",
			800 => "#991b1b",
			900 => "#7f1d1d",
			_ => panic(i"unknown red step {step} (ramps run 50, 100-900 by hundreds)"),
		})
	}

	fun green(step: i32): Color {
		ramp("green", step, match step {
			50 => "#f0fdf4",
			100 => "#dcfce7",
			200 => "#bbf7d0",
			300 => "#86efac",
			400 => "#4ade80",
			500 => "#22c55e",
			600 => "#16a34a",
			700 => "#15803d",
			800 => "#166534",
			900 => "#14532d",
			_ => panic(i"unknown green step {step} (ramps run 50, 100-900 by hundreds)"),
		})
	}

	/// A literal color WITH alpha — the `hex` escape's translucent twin, and
	/// what a brand palette outside the ramps is written in. Channels are
	/// validated at const time, like every other scale here.
	fun rgba(red: i32, green: i32, blue: i32, alpha: f64): Color {
		check_channel("red", red);
		check_channel("green", green);
		check_channel("blue", blue);
		check_alpha(alpha);
		Color { css = i"rgba({red}, {green}, {blue}, {alpha})", root = "" }
	}

	/// This color at `alpha` (0.0-1.0). Renders the RELATIVE color form,
	/// `rgb(from <this> r g b / a)`, which keeps a token's identity intact —
	/// `Color::gray(900).alpha(0.08)` is still `var(--gray-900)` underneath,
	/// so it re-themes like the opaque color does, and it carries the token's
	/// `:root` declaration onward. (An 8-digit hex would work only on a
	/// literal; mixing toward `transparent` would need the alpha as a
	/// percentage, and `0.07 * 100.0` is `7.000000000000001`.)
	fun alpha(self, value: f64): Color {
		check_alpha(value);
		Color { css = i"rgb(from {self.css} r g b / {value})", root = self.root }
	}
}

fun check_channel(name: str, value: i32) {
	if value < 0 || value > 255 {
		panic(i"{name} channel {value} is outside 0-255");
	}
}

fun check_alpha(value: f64) {
	if value < 0.0 || value > 1.0 {
		panic(i"alpha {value} is outside 0.0-1.0");
	}
}

/// The one malformation a CSS-TEXT escape can actually detect: nothing at all.
/// An empty value renders `property:`, a declaration the browser drops in
/// silence, and the realistic way to produce one is an interpolation whose
/// variable was never set — which is how real code writes background sizes and
/// data-URI images. Everything else in a CSS expression is text this language
/// deliberately does not model.
fun check_not_blank(what: str, value: str) {
	if value.trim() == "" {
		panic(i"{what} was given an empty value");
	}
}

/// How far a radial gradient's ending shape reaches — the CSS extent
/// keywords. Position (`at 20% 40%`) is deliberately not modelled: the sites
/// that want it want it computed from custom properties, which is `raw`'s job.
enum RadialExtent {
	ClosestSide = "closest-side",
	ClosestCorner = "closest-corner",
	FarthestSide = "farthest-side",
	FarthestCorner = "farthest-corner",
}

/// A gradient — a `background-image` value, NOT a `Color` (CSS paints an
/// image over a color, and `background` takes one color). Open one with
/// `Gradient::linear`/`Gradient::radial`, add stops, and hand it to
/// `background_gradient`.
struct Gradient {
	// The CSS function and its geometry argument, kept apart so `render`
	// composes them once: `linear-gradient` + `90deg`, `radial-gradient` +
	// `closest-side`.
	function: str,
	geometry: str,
	// Stops as rendered CSS, comma-joined, plus the count the two-stop
	// minimum is checked against.
	stops: str,
	stop_count: i32,
	// The `:root` lines the stops' colors carry, emitted when the gradient
	// reaches a `Style` — so a gradient of ramp tokens themes like everything
	// else.
	roots: List<str>,
}

impl Gradient {
	/// `degrees` is the CSS angle: 0 points up, 90 to the right, 180 down.
	fun linear(degrees: f64): Gradient {
		Gradient {
			function = "linear-gradient",
			geometry = i"{degrees}deg",
			stops = "",
			stop_count = 0,
			roots = [],
		}
	}

	fun radial(extent: RadialExtent): Gradient {
		Gradient {
			function = "radial-gradient",
			geometry = extent.value(),
			stops = "",
			stop_count = 0,
			roots = [],
		}
	}

	/// One color stop at `percent` along the gradient line. Positions are
	/// explicit rather than defaulted — the value type holds pairs, so both
	/// halves are written.
	fun stop(self, color: Color, percent: f64): Gradient {
		mut roots = self.roots;
		if color.root != "" {
			roots.push(color.root);
		}
		let rendered = i"{color.css} {percent}%";
		Gradient {
			function = self.function,
			geometry = self.geometry,
			stops = if self.stops == "" {
				rendered
			} else {
				self.stops + ", " + rendered
			},
			stop_count = self.stop_count + 1,
			roots = roots,
		}
	}

	fun render(self): str {
		i"{self.function}({self.geometry}, {self.stops})"
	}
}

// --- keyword properties ---------------------------------------------------------

enum Display {
	Flex = "flex",
	Grid = "grid",
	Block = "block",
	Inline = "inline",
	InlineBlock = "inline-block",
	InlineFlex = "inline-flex",
	InlineGrid = "inline-grid",
	// `display:none` — named to stay clear of `Option::None` at use sites.
	Hidden = "none",
}

enum Position {
	Static = "static",
	Relative = "relative",
	Absolute = "absolute",
	Fixed = "fixed",
	Sticky = "sticky",
}

enum FlexDirection {
	Row = "row",
	Column = "column",
	RowReverse = "row-reverse",
	ColumnReverse = "column-reverse",
}

enum AlignItems {
	Start = "flex-start",
	Center = "center",
	End = "flex-end",
	Stretch = "stretch",
	Baseline = "baseline",
}

enum JustifyContent {
	Start = "flex-start",
	Center = "center",
	End = "flex-end",
	Between = "space-between",
	Around = "space-around",
	Evenly = "space-evenly",
}

enum TextAlign {
	Left = "left",
	Center = "center",
	Right = "right",
}

enum Cursor {
	Pointer = "pointer",
	Default = "default",
	Text = "text",
	NotAllowed = "not-allowed",
}

enum Overflow {
	Visible = "visible",
	Hidden = "hidden",
	Auto = "auto",
	Scroll = "scroll",
}

enum WhiteSpace {
	Normal = "normal",
	Nowrap = "nowrap",
	Pre = "pre",
	PreWrap = "pre-wrap",
	PreLine = "pre-line",
}

enum UserSelect {
	Auto = "auto",
	Text = "text",
	All = "all",
	// `user-select:none` — named to stay clear of `Option::None` at use
	// sites, the `Display::Hidden` rule.
	Off = "none",
}

// --- the class-name hash --------------------------------------------------------

/// djb2 over the slot key and declaration, base36, prefixed for CSS validity.
/// Content-addressed — never a counter — so builds, caching, and reordering
/// all agree on names (the determinism the asset channel's dedup relies on).
fun class_hash(text: str): str {
	mut hash = 5381u32;
	for index in Range::new(0, text.len()) {
		// hash * 33 + code, wrapped to 32 bits: the shift and mask are
		// u32-wrapped; the additions stay exact in between.
		hash = ((hash << 5u32) + hash + text.code_at(index)) & 0xFFFFFFFFu32;
	}
	"s" + encode36(hash)
}

fun encode36(value: u32): str {
	let digits = "0123456789abcdefghijklmnopqrstuvwxyz";
	if value == 0u32 {
		ret "0";
	}
	mut rest = value;
	mut out = "";
	// A u32 is at most 7 base36 digits.
	for _step in Range::new(0, 7) {
		if rest > 0u32 {
			let digit = (rest % 36u32).as_i32();
			out = digits.substring(digit, digit + 1) + out;
			rest = rest / 36u32;
		}
	}
	out
}

// --- Style ----------------------------------------------------------------------

struct Style {
	// Slot key `media:condition:property` -> (class name, declaration). The
	// declaration is kept so condition combinators can re-emit it under
	// their selector.
	rules: Map<str, (str, str)>,
}

/// Opens a builder chain. Property methods reach the const-only asset
/// channel, so construction belongs inside a `const` expression; selection
/// and merging (`+`, `class_list`) are ordinary runtime code.
fun style(): Style {
	Style { rules = Map::new() }
}

/// The shorthand-to-longhand table (§0bis.4): the properties a property
/// COVERS, `;`-delimited and `;`-terminated at both ends so membership is one
/// `contains(";" + property + ";")`. Everything else maps to "" and is a
/// longhand (or a property with no family at all).
///
/// One whole-box shorthand per family, and everything it covers is a longhand
/// — which is what keeps `border` ahead of `border-top` while `border-top`
/// stays ahead of nothing. Deliberately NOT prefix-based: `border-radius`,
/// `border-collapse` and `flex-direction` share a prefix with a shorthand and
/// are not covered by it. Every row is earned by a real site in the demand
/// sweep; a new property method that is a CSS shorthand over another writable
/// property adds its row here in the same commit.
///
/// `raw` writes slots like any other method, so its properties are placed by
/// this table too — `border_none()` IS `raw("border", "none")`, and the two
/// live instances of the hazard this fixes both had `raw` on one side.
fun family_longhands(property: str): str {
	match property {
		"padding" => ";padding-top;padding-right;padding-bottom;padding-left;",
		"margin" => ";margin-top;margin-right;margin-bottom;margin-left;",
		"inset" => ";top;right;bottom;left;",
		"flex" => ";flex-grow;flex-shrink;flex-basis;",
		"background" => ";background-color;background-image;background-position;background-size;background-repeat;background-attachment;background-origin;background-clip;",
		"border" => border_longhands(),
		_ => "",
	}
}

/// `border`'s longhands: the three part shorthands, the four edges, and the
/// twelve `border-<edge>-<part>` leaves. Built rather than written out, so
/// each edge and part name appears once.
fun border_longhands(): str {
	mut out = ";border-width;border-style;border-color;";
	for edge in ["top", "right", "bottom", "left"] {
		out = out + i"border-{edge};";
		for part in ["width", "style", "color"] {
			out = out + i"border-{edge}-{part};";
		}
	}
	out
}

/// Drops every slot the incoming `property` covers, under the SAME media and
/// condition — the ordinary last-wins rule widened from one property to its
/// family. A map removal and nothing else: no emission, so `+` resolves a
/// family exactly as a chain does even though it is runtime-legal.
fun without_covered(
	rules: Map<str, (str, str)>,
	media: str,
	condition: str,
	property: str,
): Map<str, (str, str)> {
	let longhands = family_longhands(property);
	if longhands == "" {
		ret rules;
	}
	mut out = rules;
	for key in rules.keys() {
		let parts = key.split(":");
		if parts[0] == media && parts[1] == condition && longhands.contains(";" + parts[2] + ";") {
			out.remove(key);
		}
	}
	out
}

/// Whether a condition slot carries the dark marker — `"dark"` alone, or
/// `"dark hover"` stacked over a pseudo-class.
fun is_dark(condition: str): bool {
	condition.split(" ")[0] == "dark"
}

/// The condition's pseudo-class, if any: `"hover"` from `"hover"` and from
/// `"dark hover"`, `""` from `""` and from `"dark"`.
fun condition_pseudo(condition: str): str {
	if !is_dark(condition) {
		ret condition;
	}
	let parts = condition.split(" ");
	if parts.len() > 1 {
		parts[1]
	} else {
		""
	}
}

/// One atomic rule as CSS text. The three condition axes nest the way CSS
/// nests them — media outermost, then the dark ancestor selector, then the
/// pseudo-class suffix — which is exactly the outside-in order the condition
/// combinators require at the call site.
///
/// The leading byte is load-bearing (B35): `assemble_assets` has no
/// "base < pseudo < media" comparator, it sorts lines lexically with a numeric
/// override for `@media` min-widths, and the band order falls out of ASCII
/// ('.' < ':' < '@'). A dark rule starts with ':' whether or not it also
/// carries a pseudo-class, so every dark rule lands in one band; composed
/// rules then win their cascade on SPECIFICITY (0,3,0 over the 0,2,0 of plain
/// `dark` and plain `:hover`), never on the sort.
///
/// A family SHORTHAND carries one more sort marker, on the same principle
/// (§0bis.4): its selector is `*.sX` rather than `.sX`. `*` is 0x2A and `.` is
/// 0x2E, so every shorthand rule sorts ahead of its family's longhands inside
/// its own band, and the band order simply grows a step to `*` < `.` < `:` <
/// `@`. The marker is free of side effects: `*.sX` is the same compound
/// selector as `.sX` matching the same elements at the same specificity (the
/// universal selector contributes nothing), so the condition axis — which is
/// also specificity — is exactly as it was.
fun render_rule(media: str, condition: str, property: str, class: str, declaration: str): str {
	mut selector = if family_longhands(property) == "" {
		"." + class
	} else {
		"*." + class
	};
	if is_dark(condition) {
		selector = ":root[data-theme=\"dark\"] " + selector;
	}
	let pseudo = condition_pseudo(condition);
	if pseudo != "" {
		selector = selector + ":" + pseudo;
	}
	mut rule = selector + "{" + declaration + "}";
	if media != "" {
		rule = "@media (min-width: " + media + "){" + rule + "}";
	}
	rule
}

impl Style {
	/// The one chokepoint: hash the slot, emit the atomic rule, insert
	/// last-wins — across the property's whole FAMILY, so a shorthand set here
	/// clears the longhands it covers under this condition (§0bis.4).
	fun rule(self, media: str, condition: str, property: str, declaration: str): Style {
		let key = media + ":" + condition + ":" + property;
		let class = class_hash(key + "|" + declaration);
		emit("css", render_rule(media, condition, property, class, declaration));
		mut rules = without_covered(self.rules, media, condition, property);
		rules.insert(key, (class, declaration));
		Style { rules = rules }
	}

	/// The escape hatch: any property, any value, atomic like the rest.
	fun raw(self, property: str, value: str): Style {
		self.rule("", "", property, property + ":" + value)
	}

	fun with_length(self, property: str, value: Length): Style {
		if value.root != "" {
			emit("css", value.root);
		}
		self.rule("", "", property, property + ":" + value.css)
	}

	fun with_color(self, property: str, value: Color): Style {
		if value.root != "" {
			emit("css", value.root);
		}
		self.rule("", "", property, property + ":" + value.css)
	}

	// --- layout ---

	fun display(self, value: Display): Style {
		self.raw("display", value.value())
	}

	fun position(self, value: Position): Style {
		self.raw("position", value.value())
	}

	fun flex_direction(self, value: FlexDirection): Style {
		self.raw("flex-direction", value.value())
	}

	fun align_items(self, value: AlignItems): Style {
		self.raw("align-items", value.value())
	}

	fun justify_content(self, value: JustifyContent): Style {
		self.raw("justify-content", value.value())
	}

	fun gap(self, value: Length): Style {
		self.with_length("gap", value)
	}

	/// The `flex` shorthand — grow, shrink and basis in one value
	/// (`"1 1 auto"`, `"1"`, `"0 0 12rem"`). A string because the three parts
	/// have three different value kinds; the alternative is three methods
	/// nobody writes separately.
	fun flex(self, value: str): Style {
		self.raw("flex", value)
	}

	fun flex_shrink(self, value: f64): Style {
		self.raw("flex-shrink", i"{value}")
	}

	/// The grid track list (`"repeat(3, 1fr)"`, `"12rem 1fr"`). `fr` is a grid
	/// unit rather than a length, so the track list stays a string.
	fun grid_template_columns(self, value: str): Style {
		self.raw("grid-template-columns", value)
	}

	// --- box ---

	fun padding(self, value: Length): Style {
		self.with_length("padding", value)
	}

	fun padding_x(self, value: Length): Style {
		self.with_length("padding-left", value).with_length("padding-right", value)
	}

	fun padding_y(self, value: Length): Style {
		self.with_length("padding-top", value).with_length("padding-bottom", value)
	}

	// One edge at a time. The four come in as a FAMILY (§0bis.3): the sweep
	// wanted `padding-left`, `padding-right` and `padding-top`, and splitting
	// one CSS concept by a count is the cut the inset family already refused.
	// `padding_x`/`padding_y` write these same slots, so mixing them with an
	// edge is an ordinary last-wins override; mixing an edge with the `padding`
	// SHORTHAND resolves by authoring order too, through the family rules in
	// `rule` and `render_rule` (§0bis.4).

	fun padding_top(self, value: Length): Style {
		self.with_length("padding-top", value)
	}

	fun padding_right(self, value: Length): Style {
		self.with_length("padding-right", value)
	}

	fun padding_bottom(self, value: Length): Style {
		self.with_length("padding-bottom", value)
	}

	fun padding_left(self, value: Length): Style {
		self.with_length("padding-left", value)
	}

	fun margin(self, value: Length): Style {
		self.with_length("margin", value)
	}

	fun margin_x(self, value: Length): Style {
		self.with_length("margin-left", value).with_length("margin-right", value)
	}

	fun margin_y(self, value: Length): Style {
		self.with_length("margin-top", value).with_length("margin-bottom", value)
	}

	fun margin_top(self, value: Length): Style {
		self.with_length("margin-top", value)
	}

	fun margin_right(self, value: Length): Style {
		self.with_length("margin-right", value)
	}

	fun margin_bottom(self, value: Length): Style {
		self.with_length("margin-bottom", value)
	}

	/// `margin_left(Length::auto())` is the flex-push idiom, and was five of
	/// the nine single-edge sites in the demand sweep on its own.
	fun margin_left(self, value: Length): Style {
		self.with_length("margin-left", value)
	}

	fun width(self, value: Length): Style {
		self.with_length("width", value)
	}

	fun height(self, value: Length): Style {
		self.with_length("height", value)
	}

	fun min_width(self, value: Length): Style {
		self.with_length("min-width", value)
	}

	fun max_width(self, value: Length): Style {
		self.with_length("max-width", value)
	}

	fun min_height(self, value: Length): Style {
		self.with_length("min-height", value)
	}

	fun max_height(self, value: Length): Style {
		self.with_length("max-height", value)
	}

	// --- placement ---
	// The offsets a `position` other than `static` resolves against.

	fun top(self, value: Length): Style {
		self.with_length("top", value)
	}

	fun right(self, value: Length): Style {
		self.with_length("right", value)
	}

	fun bottom(self, value: Length): Style {
		self.with_length("bottom", value)
	}

	fun left(self, value: Length): Style {
		self.with_length("left", value)
	}

	/// All four offsets at once — `inset(space(0))` is the fill-the-parent
	/// idiom under `position(Position::Absolute)`.
	fun inset(self, value: Length): Style {
		self.with_length("inset", value)
	}

	fun radius(self, value: Length): Style {
		self.with_length("border-radius", value)
	}

	/// The one border body: `<width> solid <color>` on whichever edge the
	/// property names. `solid` is baked in because the demand sweep found
	/// ZERO non-`solid` borders across every line of styling written in the
	/// language — a `BorderStyle` enum's other variants would be speculation
	/// (§0bis.3).
	fun with_border(self, property: str, width: Length, color: Color): Style {
		if width.root != "" {
			emit("css", width.root);
		}
		if color.root != "" {
			emit("css", color.root);
		}
		self.rule("", "", property, i"{property}:{width.css} solid {color.css}")
	}

	fun border(self, width: Length, color: Color): Style {
		self.with_border("border", width, color)
	}

	fun border_top(self, width: Length, color: Color): Style {
		self.with_border("border-top", width, color)
	}

	fun border_right(self, width: Length, color: Color): Style {
		self.with_border("border-right", width, color)
	}

	fun border_bottom(self, width: Length, color: Color): Style {
		self.with_border("border-bottom", width, color)
	}

	fun border_left(self, width: Length, color: Color): Style {
		self.with_border("border-left", width, color)
	}

	/// No border. Written as a method rather than a `BorderStyle::None` so it
	/// fills the SAME slot `border` does — removing a border a base style set
	/// is then the ordinary last-wins override, not a second rule racing the
	/// first through the cascade.
	fun border_none(self): Style {
		self.raw("border", "none")
	}

	/// Just the colour, its own slot — so a `hover`/`focus` variant can
	/// recolour a border without restating its width, which is what four of
	/// the five real `border-color` sites were doing by hand.
	fun border_color(self, value: Color): Style {
		self.with_color("border-color", value)
	}

	/// A shadow list (`"0 1px 2px rgba(0,0,0,0.08)"`, `"none"`). Comma-joined
	/// layers of four lengths and a colour: a string, like `transition`.
	fun box_shadow(self, value: str): Style {
		self.raw("box-shadow", value)
	}

	fun overflow(self, value: Overflow): Style {
		self.raw("overflow", value.value())
	}

	// --- color & text ---

	fun background(self, value: Color): Style {
		self.with_color("background-color", value)
	}

	/// A gradient, on the `background-image` slot — a DIFFERENT slot from
	/// `background`, because a gradient is an image in CSS and paints over
	/// the background colour rather than replacing it. Each stop's colour
	/// carries its `:root` line out here, so a gradient of ramp tokens themes
	/// like any other value.
	fun background_gradient(self, value: Gradient): Style {
		if value.stop_count < 2 {
			panic(i"a gradient needs at least two stops, got {value.stop_count} — add .stop(color, percent)");
		}
		for root in value.roots {
			emit("css", root);
		}
		self.rule("", "", "background-image", "background-image:" + value.render())
	}

	/// The SAME slot `background_gradient` writes, as CSS text — the escape for
	/// the image values a `Gradient` cannot hold: a `url()` or data URI, a
	/// multi-layer list, a positioned or `repeating-*` gradient. One slot and
	/// two methods is deliberate, the `border`/`border_none` shape: they
	/// override each other under the ordinary last-wins rule, where two
	/// different slots would race in the cascade. Reach for
	/// `background_gradient` when a `Gradient` holds the value.
	fun background_image(self, value: str): Style {
		check_not_blank("background_image", value);
		self.raw("background-image", value)
	}

	/// How the background image is sized (`"cover"`, `"120px 120px"`,
	/// `"calc(100% - 2rem) auto"`). A string because the value is up to two
	/// components per layer, which one `Length` cannot hold — the `flex` and
	/// `grid_template_columns` bargain. It ships WITH `background_image` rather
	/// than on its own count: a size is inert without an image (§0bis.5).
	fun background_size(self, value: str): Style {
		check_not_blank("background_size", value);
		self.raw("background-size", value)
	}

	fun color(self, value: Color): Style {
		self.with_color("color", value)
	}

	/// A font stack (`"system-ui, sans-serif"`). A string: the value is an
	/// ordered fallback list of names the compiler has nothing to check.
	fun font_family(self, value: str): Style {
		self.raw("font-family", value)
	}

	fun font_size(self, value: Length): Style {
		self.with_length("font-size", value)
	}

	fun font_weight(self, value: i32): Style {
		self.raw("font-weight", i"{value}")
	}

	/// Tracking. Usually `Length::em(..)`, so it scales with the font size.
	fun letter_spacing(self, value: Length): Style {
		self.with_length("letter-spacing", value)
	}

	/// The `text-decoration` shorthand (`"underline"`, `"line-through"`,
	/// `"none"`, or a full `"underline wavy #dc2626 1.5px"`).
	fun text_decoration(self, value: str): Style {
		self.raw("text-decoration", value)
	}

	fun white_space(self, value: WhiteSpace): Style {
		self.raw("white-space", value.value())
	}

	fun user_select(self, value: UserSelect): Style {
		self.raw("user-select", value.value())
	}

	/// The unitless form, and the one to prefer: a number inherits as a RATIO
	/// and re-computes against each descendant's own font size.
	fun line_height(self, value: f64): Style {
		self.raw("line-height", i"{value}")
	}

	/// A line height WITH a unit, on the same slot `line_height` writes — a
	/// sibling rather than a widened `line_height`, since the language has no
	/// overloading and the `f64` form keeps its name and its callers. A length
	/// inherits as a COMPUTED LENGTH, so it will not track a descendant that
	/// resizes its text; reach for it when the design specifies a leading in px.
	fun line_height_length(self, value: Length): Style {
		self.with_length("line-height", value)
	}

	fun text_align(self, value: TextAlign): Style {
		self.raw("text-align", value.value())
	}

	fun cursor(self, value: Cursor): Style {
		self.raw("cursor", value.value())
	}

	fun opacity(self, value: f64): Style {
		self.raw("opacity", i"{value}")
	}

	fun transition(self, value: str): Style {
		self.raw("transition", value)
	}

	/// A transform list (`"translateY(-2px)"`, `"rotate(45deg) scale(1.1)"`).
	/// A string: the functions take angles, ratios and lengths in one value.
	fun transform(self, value: str): Style {
		self.raw("transform", value)
	}

	// --- conditions ---
	// A condition takes a Style built by its own chain and re-emits each of
	// its properties under the condition's selector. (The inner chain's base
	// rules also emit — deduplicated, possibly unused: the recorded
	// over-approximation, shared with unused styles generally.)
	//
	// The three axes nest OUTSIDE-IN in the order the selector nests them:
	// media, then dark, then the pseudo-class — `md(dark(hover(..)))`. Every
	// other order is a build error naming the fix, so there is exactly one
	// spelling per combination and one slot key per combination with it.

	fun hover(self, inner: Style): Style {
		self.pseudo("hover", inner)
	}

	fun focus(self, inner: Style): Style {
		self.pseudo("focus", inner)
	}

	fun active(self, inner: Style): Style {
		self.pseudo("active", inner)
	}

	fun disabled(self, inner: Style): Style {
		self.pseudo("disabled", inner)
	}

	fun first(self, inner: Style): Style {
		self.pseudo("first-child", inner)
	}

	fun last(self, inner: Style): Style {
		self.pseudo("last-child", inner)
	}

	/// Dark mode: explicit `:root[data-theme="dark"]` control — SSR-friendly,
	/// since the server can set `data-theme` before a byte of JS runs.
	/// STACKS OVER A PSEUDO-CLASS, dark on the outside: `dark(hover(..))`
	/// nests the way the selector does (`:root[data-theme="dark"] .c:hover`),
	/// the same outside-in rule that makes `md(hover(..))` legal and
	/// `hover(md(..))` an error. The composed rule's specificity (0,3,0) beats
	/// both plain `dark` and plain `hover` (0,2,0), so it wins its cascade on
	/// specificity rather than on emission order.
	fun dark(self, inner: Style): Style {
		mut out = self;
		for key in inner.rules.keys() {
			match inner.rules.get(key) {
				Some(let entry) => {
					let (_class, declaration) = entry;
					let parts = key.split(":");
					if parts[0] != "" {
						panic("nest conditions as md(dark(..)) — dark cannot wrap a media-conditioned style");
					}
					if is_dark(parts[1]) {
						panic("dark cannot wrap an already dark-conditioned style");
					}
					let condition = if parts[1] == "" {
						"dark"
					} else {
						"dark " + parts[1]
					};
					out = out.rule("", condition, parts[2], declaration);
				}
				None => {}
			}
		}
		out
	}

	/// An arbitrary pseudo-class — `.pseudo("focus-visible", ..)`; the named
	/// methods above are the common set. A pseudo-class takes the INNERMOST
	/// position: `dark` and a breakpoint may wrap it, and it may wrap neither
	/// (nor another pseudo-class). `pseudo("dark", ..)` is `dark(..)`.
	fun pseudo(self, name: str, inner: Style): Style {
		if name == "dark" {
			ret self.dark(inner);
		}
		mut out = self;
		for key in inner.rules.keys() {
			match inner.rules.get(key) {
				Some(let entry) => {
					let (_class, declaration) = entry;
					let parts = key.split(":");
					if parts[0] != "" {
						panic(i"nest conditions as md(hover(..)) — {name} cannot wrap a media-conditioned style");
					}
					if is_dark(parts[1]) {
						panic(i"nest dark OUTSIDE the pseudo — dark({name}(..)), not {name}(dark(..))");
					}
					if parts[1] != "" {
						panic(i"{name} cannot wrap an already pseudo-conditioned style");
					}
					out = out.rule("", name, parts[2], declaration);
				}
				None => {}
			}
		}
		out
	}

	/// Breakpoints (Tailwind's): min-width media queries. Media is the
	/// OUTERMOST condition — it may wrap a pseudo-conditioned style
	/// (`md(hover(..))`), a dark one (`md(dark(..))`) or both
	/// (`md(dark(hover(..)))`), and never another media.
	fun sm(self, inner: Style): Style {
		self.media("640px", inner)
	}

	fun md(self, inner: Style): Style {
		self.media("768px", inner)
	}

	fun lg(self, inner: Style): Style {
		self.media("1024px", inner)
	}

	fun xl(self, inner: Style): Style {
		self.media("1280px", inner)
	}

	fun media(self, min_width: str, inner: Style): Style {
		mut out = self;
		for key in inner.rules.keys() {
			match inner.rules.get(key) {
				Some(let entry) => {
					let (_class, declaration) = entry;
					let parts = key.split(":");
					if parts[0] != "" {
						panic("a breakpoint cannot wrap another media-conditioned style");
					}
					out = out.rule(min_width, parts[1], parts[2], declaration);
				}
				None => {}
			}
		}
		out
	}

	/// The rendered class attribute: every slot's class, space-joined.
	/// Runtime-legal (no emission) — selection and merging stay ordinary code.
	fun class_list(self): str {
		mut out = "";
		for entry in self.rules.values() {
			let (class, _declaration) = entry;
			if out == "" {
				out = class;
			} else {
				out = out + " " + class;
			}
		}
		out
	}
}

// `+` combines NAMED styles: per-property, right side wins — and per FAMILY,
// so a `border` on the right clears a `border-color` on the left exactly as it
// would inside one chain. Still runtime-legal: the rules were already emitted
// when each side was constructed, and resolving a family here is a map removal
// (§0bis.4 — the `+` path is why the fix could not be a shorthand SPLIT, which
// would have had to emit rules that did not exist yet).
//
// `b`'s slots replay in b's own insertion order, which is its authoring order,
// so a right side that itself mixes a shorthand and a longhand lands the same
// way it resolved on its own.
impl Style with Add {
	fun add(self, b: Style): Style {
		mut rules = self.rules;
		for key in b.rules.keys() {
			match b.rules.get(key) {
				Some(let entry) => {
					let parts = key.split(":");
					rules = without_covered(rules, parts[0], parts[1], parts[2]);
					rules.insert(key, entry);
				}
				None => {}
			}
		}
		Style { rules = rules }
	}
}
