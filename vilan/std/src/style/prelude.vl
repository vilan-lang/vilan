// The css block's hole vocabulary (tracker A70): free-function aliases of the
// typed style tokens, so a hole reads as the CSS it stands for.
//
// A block's holes are where the type system lives (css-block.md §10), and the
// price of that was `{Length::rem(4.0)}` and `{Color::gray(500)}` inside a
// value that is otherwise plain CSS: the qualifying segment is noise at every
// hole, and under the web prelude — where `style` is an ambient MODULE — it is
// `{style::Length::rem(4.0)}`. These are the same values under the names CSS
// itself uses, and nothing else: every function here is one line, and the
// `Length`/`Color` constructors stay exactly where they are.
//
// The module is AMBIENT INSIDE A CSS HOLE (names.md §4.7's ambient-module
// rule, applied to one syntactic position): the lowering resolves a hole's
// bare names against the site's scope FIRST and against this module only if
// nothing there answers, so an explicit local binding always wins and no file
// can be broken by a name added here. Outside a block it is an ordinary
// module — `import std::style::prelude::{ rem, gray };` binds what it names.
//
// `s()` is `style()` under the one-letter name a chain written inside a
// `const { … }` wants; the builder itself is untouched.

import pkg::style::{
	Color,
	Condition,
	CssPiece,
	Length,
	Style,
	active as active_condition,
	attribute as attribute_condition,
	children as children_condition,
	disabled as disabled_condition,
	divide as divide_condition,
	element as element_condition,
	first as first_condition,
	focus as focus_condition,
	hover as hover_condition,
	last as last_condition,
	lg as lg_condition,
	md as md_condition,
	media as media_condition,
	piece as value_piece,
	pseudo as pseudo_condition,
	sm as sm_condition,
	space as scale_step,
	style as open_style,
	var as custom_property,
	within as within_condition,
	xl as xl_condition,
};

export *;

// --- lengths ------------------------------------------------------------------

fun rem(value: f64): Length {
	Length::rem(value)
}

fun px(value: f64): Length {
	Length::px(value)
}

fun em(value: f64): Length {
	Length::em(value)
}

fun pct(value: f64): Length {
	Length::pct(value)
}

fun vh(value: f64): Length {
	Length::vh(value)
}

fun vw(value: f64): Length {
	Length::vw(value)
}

fun auto(): Length {
	Length::auto()
}

/// The spacing scale, by step — `{space(4)}` is the token, not a copied
/// `1rem`, and it carries its own `:root` line onto the sheet.
fun space(step: i32): Length {
	scale_step(step)
}

// --- colors -------------------------------------------------------------------

fun black(): Color {
	Color::black()
}

fun white(): Color {
	Color::white()
}

fun transparent(): Color {
	Color::transparent()
}

fun hex(value: str): Color {
	Color::hex(value)
}

fun gray(step: i32): Color {
	Color::gray(step)
}

fun blue(step: i32): Color {
	Color::blue(step)
}

fun red(step: i32): Color {
	Color::red(step)
}

fun green(step: i32): Color {
	Color::green(step)
}

fun rgba(red: i32, green: i32, blue: i32, alpha: f64): Color {
	Color::rgba(red, green, blue, alpha)
}

fun oklch(lightness: f64, chroma: f64, hue: f64): Color {
	Color::oklch(lightness, chroma, hue)
}

/// A CUSTOM PROPERTY as a value — `color(var("--brand-ink"));` (A101 R12).
/// `--brand-ink` is not an expression, so CSS's `var(--x)` is spelled with the
/// name as a string; the dashes are checked, because a name without them is not
/// a reference at all.
fun var(name: str): str {
	custom_property(name)
}

/// One PIECE of a value assembled from text and expressions —
/// `padding(i"calc({piece(space(4))} + 2px)");`.
///
/// A declaration's arguments are whole values, joined by a space when there are
/// several (A101 R10); a value whose parts are GLUED (`calc(… + 2px)`,
/// `{150}ms`) is one argument built here instead, and each part goes through
/// this so a `Length` or a `Color` inside it puts its `:root` line on the sheet
/// rather than emitting a `var()` nothing declares.
fun piece<V: CssPiece>(value: V): str {
	value_piece(value)
}

// --- the builder --------------------------------------------------------------

/// `style()` under the name a chain written inline wants.
fun s(): Style {
	open_style()
}

// --- the conditions ------------------------------------------------------------

/// The condition VALUES (A95), under the names a `css` block head wants:
/// `.on(hover() + active().not()) { … }` needs no import, because this module
/// is ambient inside a block and a head is an ordinary expression list the
/// lowering passes through.
///
/// Each is one line over `std::style`'s own constructor, aliased on the way in
/// because the free name and the `Style` METHOD of the same name coexist
/// (`hover()` is the condition, `style().hover(inner)` is the sugar that puts a
/// style under it) and a file declaring `fun hover()` cannot also call the
/// import of that name.

fun hover(): Condition {
	hover_condition()
}

fun focus(): Condition {
	focus_condition()
}

fun active(): Condition {
	active_condition()
}

fun disabled(): Condition {
	disabled_condition()
}

fun first(): Condition {
	first_condition()
}

fun last(): Condition {
	last_condition()
}

/// Any pseudo-class by name — `pseudo("focus-visible")`. One value is ONE
/// pseudo-class: a `:` in the name is refused, because two are two values.
fun pseudo(name: str): Condition {
	pseudo_condition(name)
}

/// A pseudo-ELEMENT — `element("selection")` is `::selection`, and it comes
/// last in the compound with nothing after it.
fun element(name: str): Condition {
	element_condition(name)
}

/// An attribute on the element itself — PRESENCE (`[name]`); `.eq(value)`
/// narrows it to the exact form.
fun attribute(name: str): Condition {
	attribute_condition(name)
}

/// The ancestor GUARD: the element's own rule, conditioned on an ANCESTOR
/// matching `condition` — `within(attribute("data-theme").eq("dark"))`.
fun within(condition: Condition): Condition {
	within_condition(condition)
}

/// Every direct CHILD of the element — `.sX > *`.
fun children(): Condition {
	children_condition()
}

/// Every direct child BUT THE FIRST — `> :not(:first-child)`.
fun divide(): Condition {
	divide_condition()
}

/// An arbitrary min-width breakpoint; `sm`/`md`/`lg`/`xl` are the named ones.
fun media(min_width: str): Condition {
	media_condition(min_width)
}

fun sm(): Condition {
	sm_condition()
}

fun md(): Condition {
	md_condition()
}

fun lg(): Condition {
	lg_condition()
}

fun xl(): Condition {
	xl_condition()
}
