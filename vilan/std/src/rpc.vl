// The RPC runtime (`proposal/transport-rpc.md`): a codec (JSON, via the derives),
// transports (a request/response `Transport` and a full-duplex `DuplexTransport`), and two
// sibling **protocols** over them — `RpcProtocol` (request/response) and the reactive
// protocol (`ReactiveServer`/`ReactiveClient`, pub/sub, §8) — plus the §4.1 foundation
// (`call`, `Dispatcher`, `arg`, `reply`) that `[service(Client)]` generation targets.
//
// Inbound frames are handled in a reactive `batch` — the **wire turn**
// (proposal/reactive-batching.md): signal writes made while dispatching are deferred to the
// turn's flush, so a handler that mutates subscribed state produces ONE coalesced `Update`
// per source alongside its reply.
//
// A note on genericity: `expose` is generic over any `Source<T: Wire>`; the element is
// erased *inside* the runtime to a per-channel starter closure (the capability table holds
// heterogeneous sources, and vilan has no trait objects) that subs the typed source and
// single-passes each value into an `Update` envelope over the wiring-time codec — the wire
// never sees an intermediate encoding. The in-process transports (`LocalTransport`,
// `DuplexEnd`) make everything runnable with no network; real transports mount the same
// protocols.

import pkg::bytes::{ ByteBuffer, Bytes, bytes_of_buffer, new_text_decoder };
import pkg::compare::PartialEq;
import pkg::fetch::{ get, post, post_bytes };
import pkg::hash::{ Hash, Hashable };
import pkg::io::panic;
import pkg::json::JsonValue;
import pkg::map::Map;
import pkg::option::Option::{ self, None, Some };
import pkg::promise::Promise;
import pkg::reactive::{
	Disposable,
	FlushPolicy,
	SignalCell,
	Source,
	Subscription,
	at_settle,
	batch,
	defer_to_owner,
	fresh_id,
	get_owner,
	queue_microtask,
	turn,
};
import pkg::result::Result::{ self, Err, Ok };
import pkg::shared::Shared;
import pkg::task::Task;
import pkg::time::{ Duration, sleep_for };
import pkg::wire::{ Codec, Delta, Deserializer, Frame, Keyed, Serializer, Wire };

// === Transport: request/response ============================================

/// Send an encoded request frame, get the encoded reply. The explicit `Task` marks the
/// round-trip as a place the caller `await`s deliberately. Frames carry either
/// format (§6.2) — the codec is chosen at wiring time, not here. A transport
/// can FAIL (a dropped socket, an unreachable host) — `Err(reason)` is the
/// infrastructure path, mapped to `RpcError::Transport` by `call`
/// (proposal/transport-robustness.md §2.4: failure is representable, never a
/// dangling promise).
trait Transport {
	fun call(self, request: Frame): Task<Result<Frame, str>>;
}

/// The in-process request/response transport: runs a handler in the same process, wrapped
/// as a settled Task. `handler` is a protocol's frame handler (an `RpcProtocol`).
struct LocalTransport {
	/// The protocol's frame handler; calls through it await (J2's typed
	/// channel, directly on the field).
	handler: async |Frame| Frame,
}

impl LocalTransport with Transport {
	fun call(self, request: Frame): Task<Result<Frame, str>> {
		async {
			Ok((self.handler)(request))
		}
	}
}

// === Transport: HTTP ========================================================

/// The real request/response transport (§5): POSTs each request frame to the
/// endpoint and reads the reply frame from the response body. Works wherever the
/// host `fetch` does — browser, node, deno, bun — so it is the default
/// client↔server transport. The address is programmatic (Q5): construct it with
/// the endpoint URL (`HttpTransport { url = "http://localhost:4000/rpc" }`);
/// where the string comes from — hardcoded, env, config — is the app's choice.
/// The server side is a mounted `Service`'s `{mount}rpc` route
/// (`std::rpc_server`, installed with `ServerBuilder::with_service`).
struct HttpTransport {
	url: str,
}

impl HttpTransport with Transport {
	/// The reply is read in the request's format — both sides run one codec
	/// (deployment-wide, Q6), so the kinds always match. (An unreachable host
	/// still surfaces as the host fetch's rejection — HTTP-level robustness is
	/// recorded beyond-v1; the reconnecting transport is `SocketTransport`.)
	fun call(self, request: Frame): Task<Result<Frame, str>> {
		async {
			match request {
				Frame::Text(let body) => {
					let response = post(self.url, body).send();
					Ok(Frame::Text(response.text()))
				},
				Frame::Binary(let body) => {
					let response = post_bytes(self.url, body);
					Ok(Frame::Binary(response.bytes()))
				},
			}
		}
	}
}

// === Transport: full-duplex =================================================

/// A dumb, bidirectional frame pipe: either end may `send` at any time, so the server can
/// push unprompted (§5). This is the shape the reactive protocol needs. Frames carry either
/// format (§6.2) — a text-only transport (`SplitDuplex`) rejects binary loudly.
trait DuplexTransport {
	fun send(self, frame: Frame);
	fun on_frame(self, handler: |Frame| void);
}

/// The in-process duplex end: a settable inbound-handler slot (`me`) and the peer's slot
/// (`peer`) that our `send` fires into. Two cross-linked ends (`duplex_pair`) form one
/// connection. `Shared` makes each slot one cell shared by both ends.
struct DuplexEnd {
	peer: Shared<Option<|Frame| void>>,
	me: Shared<Option<|Frame| void>>,
}

impl DuplexEnd with DuplexTransport {
	fun send(self, frame: Frame) {
		match self.peer.read() {
			Some(let handler) => handler(frame),
			None => {},
		}
	}

	fun on_frame(self, handler: |Frame| void) {
		self.me.write() = Some(handler);
	}
}

impl DuplexEnd {
	/// Forget the inbound handler — `on_frame`'s missing teardown half
	/// (`proposal/lifetimes.md` §5, V5 / backlog A29).
	///
	/// `ReactiveClient::new`/`ReactiveServer::new` install a handler that
	/// captures the client/server it belongs to, and nothing ever cleared it:
	/// `dispose` emptied `sources`/`live` but left the transport holding the
	/// closure, so a closed session's whole component stayed reachable from the
	/// wire — a leak per disconnect under any counted backend, and a live
	/// retention under the JS collector for as long as the transport lives.
	/// After this the end is inert: frames sent at it are dropped, exactly as
	/// they are before `on_frame` is ever called.
	fun clear_on_frame(self) {
		self.me.write() = None;
	}
}

/// Create two connected duplex ends: whatever one sends arrives at the other's handler.
fun duplex_pair(): (DuplexEnd, DuplexEnd) {
	let slot_a: Shared<Option<|Frame| void>> = Shared::new(None);
	let slot_b: Shared<Option<|Frame| void>> = Shared::new(None);
	let a = DuplexEnd { peer = slot_b, me = slot_a };
	let b = DuplexEnd { peer = slot_a, me = slot_b };
	(a, b)
}

/// Bridge an in-process `DuplexEnd` to any real `DuplexTransport`: frames flow both
/// ways. The reactive runtime (`ReactiveServer`/`ReactiveClient`) holds a concrete
/// `DuplexEnd`, so this is how it rides a real wire (`SplitDuplex`, a future
/// WebSocket) unchanged: hand it `bridge(wire)`.
fun bridge<Tx: DuplexTransport>(wire: Tx): DuplexEnd {
	let (inner, outer) = duplex_pair();
	outer.on_frame(|frame| wire.send(frame));
	wire.on_frame(|frame| outer.send(frame));
	inner
}

// === Transport: SSE + POST (SplitDuplex) ====================================

/// The real duplex transport over plain HTTP (§5's fallback, no WebSocket needed):
/// server→client frames arrive on a long-lived SSE stream (`GET {base}/events`),
/// and client→server frames POST to `{base}/send?c=<connection>`. The server side
/// is a mounted `Service` (`std::rpc_server`); open one with `connect_split(base_url)`.
/// A true WebSocket transport becomes a drop-in sibling once it lands.
struct SplitDuplex {
	// The connection id the server announced — apps use it to correlate this
	// duplex connection with RPC calls (e.g. an `attach(connection)` method).
	connection: i32,
	send_url: str,
	inbound: Shared<Option<|Frame| void>>,
	// Frames that arrived before `on_frame` was set (e.g. pushed by the server
	// during the handshake) — queued, then flushed to the first handler.
	early: Shared<List<Frame>>,
}

impl SplitDuplex with DuplexTransport {
	/// Fire-and-forget POST. Ordering across rapid sends is not guaranteed
	/// (separate requests); the reactive protocol's client→server traffic
	/// (subscribe/unsubscribe) is insensitive to it.
	fun send(self, frame: Frame) {
		match frame {
			Frame::Text(let body) => {
				let _ = post(self.send_url, body).send();
			},
			// SSE (the server→client leg) is text-only forever, so this
			// transport is too: a binary codec over it is a wiring error, and
			// the first Subscribe trips it loudly right here.
			Frame::Binary(let _bytes) => {
				panic("SplitDuplex is text-only (SSE); use connect_socket for a binary codec");
			},
		}
	}

	fun on_frame(self, handler: |Frame| void) {
		self.inbound.write() = Some(handler);
		for frame in self.early.read() {
			handler(frame);
		}
		self.early.write() = [];
	}
}

/// Split complete SSE events off `buffer`, dispatching each `data:` payload, and
/// return the incomplete remainder (an event ends at a blank line).
fun drain_sse(buffer: str, dispatch: |str| void): str {
	let parts = buffer.split("\n\n");
	mut remainder = "";
	mut index = 0;
	for part in parts {
		if index == parts.len() - 1 {
			remainder = part;
		} else {
			for line in part.split("\n") {
				if line.starts_with("data: ") {
					dispatch(line.substring(6, line.len()));
				}
			}
		}
		index += 1;
	}
	remainder
}

/// Open a SplitDuplex connection to `base_url` (e.g. `http://localhost:4000`):
/// waits for the server's connection announcement (`__conn:<id>`, the stream's
/// first event), then keeps pumping inbound events to the transport's handler in
/// the background for the connection's lifetime.
fun connect_split(base_url: str): SplitDuplex {
	let response = get(i"{base_url}/events").send();
	let reader = response.body_stream().reader();
	let decoder = new_text_decoder();
	let inbound: Shared<Option<|Frame| void>> = Shared::new(None);
	let early: Shared<List<Frame>> = Shared::new([]);
	let connection: Shared<str> = Shared::new("");
	// Route one inbound frame (SSE delivers text, so it arrives as `Frame::Text`):
	// the handler if one is set, else the early queue (flushed to the first
	// handler by `on_frame`).
	let dispatch = |payload: str| {
		match inbound.read() {
			Some(let handler) => handler(Frame::Text(payload)),
			None => early.write().push(Frame::Text(payload)),
		}
	};
	mut buffer = "";
	for connection.read() == "" {
		let chunk = reader.read_chunk();
		if chunk.finished() {
			jump break;
		}
		buffer += decoder.decode(chunk.payload());
		buffer = drain_sse(buffer, |frame| {
			if frame.starts_with("__conn:") {
				connection.write() = frame.substring(7, frame.len());
			} else {
				dispatch(frame);
			}
		});
	}
	// Pump the rest of the stream for the connection's lifetime. Deliberately
	// unstructured (no nursery): the pump is owned by the CONNECTION, which
	// outlives this function — it ends when the stream closes. A teardown
	// error surfaces as an origin-stamped task report, not a crash.
	let leftover = buffer;
	let _ = async {
		mut rest = leftover;
		for {
			let chunk = reader.read_chunk();
			if chunk.finished() {
				jump break;
			}
			rest += decoder.decode(chunk.payload());
			rest = drain_sse(rest, dispatch);
		}
	};
	SplitDuplex {
		connection = parse_announced(connection.read()),
		send_url = i"{base_url}/send?c={connection.read()}",
		inbound,
		early,
	}
}

/// The `__conn:<id>` announcement's id, parsed once at connect time. A
/// non-numeric announcement is a broken server — refuse loudly.
fun parse_announced(text: str): i32 {
	match text.parse_i32() {
		Some(let id) => id,
		None => {
			panic("malformed connection announcement: " + text);
		},
	}
}

// === Transport: WebSocket (SocketDuplex) ====================================

/// The host `WebSocket` class — browser, node (22+), deno, and bun all provide
/// it globally, framing included; only the SERVER half needs `std::ws`.
external struct WebSocket;

[extern(new, "WebSocket")]
external fun new_web_socket(url: str, protocols: List<str>): WebSocket;

/// The subprotocol a vilan rpc server selects and echoes on the 101 (RFC 6455
/// §4.2.2). Named here because both halves need the same string: the client
/// offers it, the server picks it out of what was offered.
fun rpc_subprotocol(): str {
	"vilan-rpc"
}

/// The handshake offer that carries a credential (A40): the real protocol
/// name, then `"token.<credential>"` beside it. The browser `WebSocket` API
/// puts no headers on a handshake and the subprotocol list is the only field
/// it lets a page fill, so this is where a token goes — and the server reads
/// it back with `Handshake::token`.
///
/// A subprotocol is a token, not a header value: it may not contain a comma,
/// a space, or a separator, which every JWT already satisfies. A credential
/// that does not is the app's to encode (base64url) on both sides.
fun rpc_protocols(credential: str): List<str> {
	[rpc_subprotocol(), "token." + credential]
}

// The HMR hooks, declared here rather than imported from `std::dev` (`hmr.md`
// §5): `std::dev` is a browser-layer module and this base module serves every
// platform, so it may not depend on it. `hmr_active` binds the `__hmr_active`
// runtime helper (a `typeof` check, safe in any build); `hmr_register_teardown`
// is a shim global, only ever reached behind the `hmr_active()` guard — inert
// (and never referenced at runtime) without a dev shim.
[extern("__hmr_active")]
external fun hmr_active(): bool;

[extern("__hmr_register_teardown", retains)]
external fun hmr_register_teardown(cleanup: || void): void;

external struct SocketMessage;

impl SocketMessage {
	[extern(get, "data")]
	external fun data(self): str;

	/// The same `data` untyped — for the text/binary discrimination below.
	[extern(get, "data")]
	external fun data_value(self): JsonValue;

	/// The same `data` as the raw buffer — valid only when the message IS
	/// binary (`binaryType = "arraybuffer"` makes binary messages ArrayBuffers).
	[extern(get, "data")]
	external fun data_buffer(self): ByteBuffer;
}

/// The one host-level type oracle: `Object.prototype.toString.call(x)` names any
/// value's class — `"[object String]"` vs `"[object ArrayBuffer]"` is how an
/// inbound socket message picks its lane.
[extern("Object.prototype.toString.call")]
external fun host_kind(value: JsonValue): str;

impl WebSocket {
	[extern(method, "send")]
	external fun transmit(self, data: str);

	/// The same host `send` — WebSocket accepts bytes directly.
	[extern(method, "send")]
	external fun transmit_bytes(self, data: Bytes);

	/// Make binary messages arrive as ArrayBuffers (the default is Blob).
	[extern(set, "binaryType")]
	external fun set_binary_type(self, kind: str);

	[extern(set, "onmessage", retains)]
	external fun set_on_message(self, handler: |SocketMessage| void);

	/// Failure events — a dial that never opens, or a live connection dropping.
	[extern(set, "onclose", retains)]
	external fun set_on_close(self, handler: || void);

	[extern(set, "onerror", retains)]
	external fun set_on_error(self, handler: || void);

	[extern(method, "close")]
	external fun close(self);
}

/// One dial attempt's outcome channel: `finish(true)` when the `__conn`
/// announcement lands, `finish(false)` on close/error first. (A host Promise
/// resolves first-call-wins, so a close after the announcement is inert.)
[extern(new, "Promise")]
external fun dial_promise(executor: |(|bool| void)| void): Promise<bool>;

/// The connection lifecycle, as a signal a UI can bind ("reconnecting…") —
/// Railway's `isReady`, typed (proposal/transport-robustness.md §2.1).
/// `Closed` is terminal: the retry budget ran out (or the server's contract
/// drifted); the app decides what a fresh start looks like.
[derive(PartialEq, Debug)]
enum ConnectionState {
	Connected,
	Reconnecting,
	Closed,
}

/// A pending RPC call multiplexed on the socket: its correlation id and the
/// resolver its reply completes — with `Err` for a connection lost while the
/// call was in flight (proposal/transport-robustness.md §2.4: rejected, never
/// dangling).
struct PendingCall {
	request: i32,
	complete: |Result<Frame, str>| void,
}

/// The socket's binary channel tags (§5's multiplex, byte form): a binary WS
/// message is `0x64` ('d') + a duplex frame, or `0x72` ('r') + a 4-byte LE
/// request id + an RPC frame — the byte mirror of the `d:`/`r:<id>:` text
/// prefixes, shared verbatim with the service upgrade path (`std::rpc_server`).
fun tag_duplex_bytes(payload: Bytes): Bytes {
	let tag = Bytes::alloc(1);
	tag.set(0, 0x64);
	Bytes::concat(tag, payload)
}

fun tag_rpc_bytes(request: i32, payload: Bytes): Bytes {
	let header = Bytes::alloc(5);
	header.set(0, 0x72);
	header.set(1, request);
	header.set(2, request >> 8);
	header.set(3, request >> 16);
	header.set(4, request >> 24);
	Bytes::concat(header, payload)
}

/// The true duplex transport (§5): one WebSocket carrying BOTH protocols and
/// BOTH frame kinds — text messages use the `d:<frame>`/`r:<id>:<frame>`
/// prefixes, binary messages the tag bytes above. The server side is the
/// service upgrade handshake (`ServerBuilder::with_service`); open one with
/// `connect_socket(url)` — the
/// drop-in swap for `connect_split`, same `__conn:<id>` handshake, same
/// `.connection` for RPC correlation.
///
/// The duplex SURVIVES a dropped connection (proposal/transport-robustness.md
/// §2.2): everything downstream — `bridge`, `ReactiveClient`, `SocketTransport`,
/// a generated client — holds this same value across reconnects, and the
/// reconnect loop swaps the `Shared` cells inside it.
struct SocketDuplex {
	socket: Shared<WebSocket>,
	// The address to redial.
	url: str,
	// The subprotocols this connection was opened with — re-offered on every
	// redial, because a reconnect must re-present the same credential the
	// first handshake was authorized on (A40).
	protocols: List<str>,
	// The connection id the server announced — correlates this duplex with
	// RPC calls (e.g. an `attach(connection)` method), like `SplitDuplex`.
	// A cell: every reconnect lands a fresh id.
	connection: Shared<i32>,
	state: SignalCell<ConnectionState>,
	inbound: Shared<Option<|Frame| void>>,
	// Frames that arrived before `on_frame` was set — queued, then flushed.
	early: Shared<List<Frame>>,
	pending: Shared<List<PendingCall>>,
	next_request: Shared<i32>,
	// Run (and awaited, in order) after each successful re-dial — the
	// generated client re-attaches its mirrors here. Stored plain (an `async`
	// closure TYPE lives only at parameter/`let` seams, J2 v1); the runner
	// re-marks each entry at a `let` so the calls await.
	on_reconnect: Shared<List<|| void>>,
	// Run when the duplex reaches the terminal `Closed` — `on_reconnect`'s
	// mirror for the connection that never comes back (backlog A31). The
	// duplex is BUILT BEFORE the client that will hold its mirrors, which is
	// why the teardown is registered here rather than passed down: the paths
	// that discover a terminal failure are transport paths, and only one of
	// the three has a `ReactiveClient` anywhere in scope. Sync closures, run
	// in registration order; `dispose_on_close` is the one std registers.
	on_terminal: Shared<List<|| void>>,
}

impl SocketDuplex with DuplexTransport {
	/// While not connected, control frames DROP: a `Subscribe` is re-sent by
	/// the reconnect's rebind, and RPC frames never reach here (fail-fast in
	/// `SocketTransport.call`).
	fun send(self, frame: Frame) {
		if self.state.get() == ConnectionState::Connected {
			match frame {
				Frame::Text(let body) => self.socket.read().transmit("d:" + body),
				Frame::Binary(let bytes) => self.socket
					.read()
					.transmit_bytes(tag_duplex_bytes(bytes)),
			}
		}
	}

	fun on_frame(self, handler: |Frame| void) {
		self.inbound.write() = Some(handler);
		for frame in self.early.read() {
			handler(frame);
		}
		self.early.write() = [];
	}
}

impl SocketDuplex {
	/// The RPC half of the multiplex: a `Transport` over this same socket, so
	/// calls ride the open connection instead of HTTP requests beside it.
	fun transport(self): SocketTransport {
		SocketTransport { duplex = self }
	}

	/// Reject every in-flight call — a dropped connection can never deliver
	/// their replies (the reply may exist server-side; the CALLER decides
	/// whether a retry is safe — §2.4, never a blind re-send).
	fun reject_pending(self, reason: str) {
		for call in self.pending.read() {
			(call.complete)(Err(reason));
		}
		self.pending.write() = [];
	}
}

/// A correlated reply arrived: complete and forget its pending call.
fun settle_pending(pending: Shared<List<PendingCall>>, request: i32, reply: Frame) {
	mut kept: List<PendingCall> = [];
	for call in pending.read() {
		if call.request == request {
			(call.complete)(Ok(reply));
		} else {
			kept.push(call);
		}
	}
	pending.write() = kept;
}

/// Route one duplex frame to the handler, or the early queue before one is set.
fun deliver_inbound(
	inbound: Shared<Option<|Frame| void>>,
	early: Shared<List<Frame>>,
	payload: Frame,
) {
	match inbound.read() {
		Some(let handler) => handler(payload),
		None => early.write().push(payload),
	}
}

/// `reply_promise`'s resolver carries the reply frame — or the transport
/// failure that means it will never come.
[extern(new, "Promise")]
external fun reply_promise(executor: |(|Result<Frame, str>| void)| void): Promise<Result<Frame, str>>;

/// One socket, `impl Transport`: each call rides the multiplex in the request
/// frame's own kind — text as `r:<id>:<frame>`, binary as the tagged-byte form
/// — and resolves when the reply with the same id lands. Not connected =
/// fail fast (Railway's rule, typed): the caller gets
/// `Err(RpcError::Transport("not connected"))` immediately.
struct SocketTransport {
	duplex: SocketDuplex,
}

impl SocketTransport with Transport {
	fun call(self, request: Frame): Task<Result<Frame, str>> {
		async {
			if self.duplex.state.get() == ConnectionState::Connected {
				let id = self.duplex.next_request.read();
				self.duplex.next_request.write() = id + 1;
				await reply_promise(|complete: |Result<Frame, str>| void| {
					self.duplex.pending.write().push(PendingCall { request = id, complete });
					match request {
						Frame::Text(let body) => self.duplex.socket
							.read()
							.transmit(i"r:{id}:{body}"),
						Frame::Binary(let bytes) => self.duplex.socket
							.read()
							.transmit_bytes(tag_rpc_bytes(id, bytes)),
					}
				})
			} else {
				Err("not connected")
			}
		}
	}
}

impl SocketTransport {
	/// The duplex's lifecycle, for the UI — bind it ("reconnecting…") or gate
	/// optimistic writes on it.
	fun connection_state(self): SignalCell<ConnectionState> {
		self.duplex.state
	}

	/// Run `hook` after each successful re-dial. Hooks are awaited IN ORDER,
	/// and the generated client registers its own mirror re-attach when it
	/// connects — so a hook registered by app code runs after the mirrors
	/// have resynced, which is the only "reconnected AND resynced" moment in
	/// the system. `connection_state` deliberately flips a beat earlier
	/// (`proposal/transport-robustness.md` §2.5: the re-attach's own rpc call
	/// needs a usable transport), so it is the wrong signal for anything that
	/// wants current mirrors.
	///
	/// The first consumer is a local-first cell re-sending edits the outage
	/// swallowed (`proposal/draft-reconnect.md`):
	///
	///     client.transport.on_reconnect(|| title.repush());
	///
	/// Hooks run in the reconnect loop's OWN extent and are awaited before it
	/// finishes, so keep one short: it should start work (spawn a re-push,
	/// re-arm a subscription), not ride a long round-trip that holds the
	/// reconnect open behind it.
	fun on_reconnect(self, hook: async || void) {
		self.duplex.on_reconnect.write().push(hook);
	}
}

/// Route one inbound TEXT socket message by its channel prefix. `r:<id>:<frame>`
/// settles the pending call; `d:<frame>` goes to the duplex handler (or the
/// early queue); anything else is ignored (forward compatibility).
fun route_socket_frame(frame: str, pending_settle: |i32, Frame| void, dispatch: |Frame| void) {
	if frame.starts_with("r:") {
		let rest = frame.substring(2, frame.len());
		let parts = rest.split(":");
		let id_text = parts[0];
		// `r:<id>` with no second `:` is not this shape — it carries no reply
		// at all, so it is ignored like any other unrecognized frame. (An
		// EMPTY reply is still well-formed: `r:7:` splits to `["7", ""]`.)
		if id_text.len() < rest.len() {
			let reply = rest.substring(id_text.len() + 1, rest.len());
			match id_text.parse_i32() {
				Some(let request) => pending_settle(request, Frame::Text(reply)),
				None => {},
			}
		}
	} else if frame.starts_with("d:") {
		dispatch(Frame::Text(frame.substring(2, frame.len())));
	}
}

/// Route one inbound BINARY socket message by its tag byte — the byte mirror of
/// `route_socket_frame`. An unknown tag is ignored (forward compatibility).
fun route_socket_bytes(message: Bytes, pending_settle: |i32, Frame| void, dispatch: |Frame| void) {
	if message.len() == 0 {
		ret;
	}
	let tag = message.get(0);
	if tag == 0x72 && message.len() >= 5 {
		let request = message.get(1)
			| message.get(2) << 8
			| message.get(3) << 16
			| message.get(4) << 24;
		pending_settle(request, Frame::Binary(message.slice(5, message.len())));
	} else if tag == 0x64 {
		dispatch(Frame::Binary(message.slice(1, message.len())));
	}
}

/// The announcement a server sends a vilan client it has REFUSED (A47), the
/// `__conn:<id>` handshake's negative twin: `__reject:401` / `__reject:403`.
/// Named here and in `std::rpc_server` at the one shape.
fun reject_announcement_prefix(): str {
	"__reject:"
}

/// Why a dial did not open (A47). The distinction the host WebSocket API
/// cannot make and the retry loop needs.
///
/// Both host implementations collapse every handshake failure into one
/// indistinguishable event — measured on node 24, a 401, a 403, a 429, a
/// mid-handshake destroy, a refused connection and a server with no upgrade
/// handler all arrive as the same message and the same close code (1002), and
/// the browser's `WebSocket` exposes strictly less. So the discrimination
/// cannot be read off the failure; it has to be SENT, and the server sends it
/// as one frame on an upgraded socket it then closes.
[derive(PartialEq, Debug)]
enum DialFailure {
	/// The socket never opened, or opened and said nothing: an unreachable
	/// server, a network error, a non-101 the host will not describe.
	/// RETRYABLE — waiting is exactly what might fix it.
	Unreachable(str),
	/// The server upgraded this client and refused it, in the one frame it
	/// sent before closing. The payload is the HTTP status the refusal would
	/// have carried (`"401"`, `"403"`). TERMINAL: the credential is the
	/// problem, and no amount of backoff improves a credential.
	Refused(str),
}

impl DialFailure {
	/// The human sentence — what `connect_socket`'s `Err(str)` carries, so the
	/// untyped entry point keeps the shape it documented.
	fun message(self): str {
		match self {
			DialFailure::Unreachable(let reason) => reason,
			DialFailure::Refused(let status) => i"refused by the server ({status})",
		}
	}
}

/// One dial attempt: a fresh socket, fully wired for the steady state (the
/// routing closures come from the duplex's shared cells, so replies and duplex
/// frames land in the SAME places across reconnects). Resolves `Ok((socket,
/// connection))` when the `__conn:<id>` announcement arrives, `Err` when the
/// socket closes or errors first (an unreachable server) — or when the server
/// upgrades this client only to refuse it in one `__reject:<status>` frame
/// (A47), which is the one failure worth telling apart from the rest.
fun dial(
	url: str,
	protocols: List<str>,
	settle: |i32, Frame| void,
	dispatch: |Frame| void,
): Result<(WebSocket, i32), DialFailure> {
	let socket = new_web_socket(url, protocols);
	socket.set_binary_type("arraybuffer");
	let connection: Shared<str> = Shared::new("");
	let refused: Shared<str> = Shared::new("");
	let opened = await dial_promise(|finish: |bool| void| {
		socket.set_on_close(|| finish(false));
		socket.set_on_error(|| finish(false));
		socket.set_on_message(|message| {
			if host_kind(message.data_value()) == "[object ArrayBuffer]" {
				route_socket_bytes(bytes_of_buffer(message.data_buffer()), settle, dispatch);
				ret;
			}
			let frame = message.data();
			if connection.read() == "" && frame.starts_with("__conn:") {
				connection.write() = frame.substring(7, frame.len());
				finish(true);
			} else if connection.read() == "" && frame.starts_with(reject_announcement_prefix()) {
				// The server has answered the handshake and is closing. Record
				// the status BEFORE finishing, so the arm below reads it.
				refused.write() = frame.substring(reject_announcement_prefix().len(), frame.len());
				socket.close();
				finish(false);
			} else {
				route_socket_frame(frame, settle, dispatch);
			}
		});
	});
	if opened {
		Ok((socket, parse_announced(connection.read())))
	} else if refused.read() != "" {
		Err(DialFailure::Refused(refused.read()))
	} else {
		Err(DialFailure::Unreachable(i"could not reach {url}"))
	}
}

/// Dial until it opens, the server REFUSES, or the budget runs out
/// (proposal/transport-robustness.md §2.3): 10 attempts, doubling from 250ms
/// and capped at 4s — fast for the blip, capped pressure for the outage.
/// Railway's attempt budget, better curve. The first attempt is immediate.
///
/// A refusal ends the loop on the spot (A47). The budget exists to outlast a
/// server that is briefly away; a server that is present and has read this
/// client's credential is not away, and nine more attempts over ~24 seconds
/// buy nothing but nine more refusals — which is precisely what a refused
/// client used to pay before the refusal was a frame it could see.
fun dial_with_backoff(
	url: str,
	protocols: List<str>,
	settle: |i32, Frame| void,
	dispatch: |Frame| void,
): Result<(WebSocket, i32), DialFailure> {
	mut outcome: Result<(WebSocket, i32), DialFailure> = Err(DialFailure::Unreachable(i"could not reach {url}"));
	mut attempt = 0;
	mut delay = 250i53;
	for attempt < 10 {
		if attempt > 0 {
			sleep_for(Duration::millis(delay));
			delay = if delay * 2i53 > 4000i53 { 4000i53 } else { delay * 2i53 };
		}
		outcome = dial(url, protocols, settle, dispatch);
		if outcome is Ok(let _opened) {
			jump break;
		}
		if outcome is Err(DialFailure::Refused(let _status)) {
			jump break;
		}
		attempt += 1;
	}
	outcome
}

/// The terminal treatment, in ONE place: the duplex goes to `Closed`, the
/// socket is closed, and everything registered to die with the connection runs
/// — for a generated client, its own `dispose` (`dispose_on_close`).
///
/// `ConnectionState::Closed` is written here and nowhere else, which is the
/// whole shape: the three arms that can reach the terminal state — the spent
/// retry budget (`handle_drop`), and `reattach_mirrors`' two refusals — say it
/// by calling this, so an arm cannot report the state while forgetting the
/// release, and a fourth one cannot be added that does (backlog A31's uniform
/// law; A30 wired the two refusals and left the budget arm setting the state
/// alone).
///
/// The client is NOT a parameter, and that is the load-bearing half. It does
/// not exist when the duplex is built — `connect_socket` returns before
/// `ReactiveClient::new` is ever called — so of the three arms only the two
/// inside `reattach_mirrors` could name one, and threading it to the third
/// would mean carrying it through `watch_socket` and the socket's own event
/// handlers, which are armed at connect time. Registering the teardown on the
/// duplex instead moves the forgettable half off the call sites entirely:
/// they say "this connection is over", once, and what dying costs is settled
/// where the client was born.
///
/// ORDER is deliberate and the pins read it: the state signal fires first, so
/// an app observing `Closed` sees the state it is being told about rather than
/// a half-torn-down client; the teardowns follow. Reached at most once — the
/// state guard in `handle_drop` makes `Closed` a one-way door — and harmless
/// twice anyway, since `ReactiveClient::dispose` assigns empties.
fun close_for_good(socket: SocketDuplex) {
	socket.state.set(ConnectionState::Closed);
	socket.socket.read().close();
	for teardown in socket.on_terminal.read() {
		teardown();
	}
}

/// Arm the CURRENT socket's failure events: a close or error on the live
/// connection begins the reconnect loop. (Dial-time failures are the dial's
/// own `finish(false)` — this takes over only after a successful handshake.)
fun watch_socket(duplex: SocketDuplex) {
	let socket = duplex.socket.read();
	socket.set_on_close(|| handle_drop(duplex));
	socket.set_on_error(|| handle_drop(duplex));
}

/// The connection dropped: reject the in-flight calls, then redial with
/// backoff. On success the duplex's cells swap to the fresh socket/connection,
/// the state flips back to `Connected` (so the re-attach hooks can CALL), and
/// the hooks run — awaited, in order. A spent budget closes the duplex for
/// good, and so does a REFUSAL, which ends the redial at its first attempt
/// (A47: a credential that stopped being good mid-session does not get better
/// with backoff). Either way it is the SAME terminal treatment, disposal
/// included, that a refused re-attach takes: the reason a connection is over
/// does not change what being over costs (A31). `error` then `close` (or a stale event from a replaced
/// socket) finds the state already advanced and stops at the guard.
fun handle_drop(duplex: SocketDuplex) {
	if duplex.state.get() == ConnectionState::Connected {
		duplex.state.set(ConnectionState::Reconnecting);
		duplex.reject_pending("connection lost");
		let pending = duplex.pending;
		let inbound = duplex.inbound;
		let early = duplex.early;
		let settle = |request: i32, reply: Frame| settle_pending(pending, request, reply);
		let dispatch = |payload: Frame| deliver_inbound(inbound, early, payload);
		match dial_with_backoff(duplex.url, duplex.protocols, settle, dispatch) {
			Ok(let opened) => {
				let (socket, connection) = opened;
				duplex.socket.write() = socket;
				duplex.connection.write() = connection;
				watch_socket(duplex);
				duplex.state.set(ConnectionState::Connected);
				for entry in duplex.on_reconnect.read() {
					// Re-marked at the `let` so the call awaits (J2's typed
					// channel): re-attach completes before the next hook.
					let hook: async || void = entry;
					hook();
				}
			},
			Err(let _reason) => close_for_good(duplex),
		}
	}
}

/// Open a WebSocket connection to `url` (e.g. `ws://localhost:4000`): resolves
/// once the server's `__conn:<id>` announcement lands (which also proves the
/// socket is open — sends are safe after this returns). Dials with the same
/// backoff as a reconnect, so a briefly-unavailable server delays the start
/// instead of failing it; a server that stays away returns `Err`.
///
/// It offers `vilan-rpc` (tracker A52) — the same offer `dial_for_service`
/// makes, and for the same reason A47 gave it to the generated `connect`: the
/// server's typed refusal frame is only ever sent to a client that named this
/// protocol, so a bare connect that did NOT offer it could not tell a 401 from
/// an outage and paid ~24 s of backoff to learn nothing. This is the call a
/// first program writes — the one in `guide/services.md`'s WebSocket fence and
/// in every hand-built `Client { transport = socket.transport(), .. }` — so the
/// bare spelling being the blind one was the wrong default.
///
/// `connect_socket_with(url, protocols)` is untouched and remains the escape:
/// a list written by hand is offered exactly as written, `vilan-rpc` included
/// only if the caller writes it. A server that speaks something else selects
/// the client's first non-credential offer, which is what makes an explicit
/// list the right seam for a non-vilan peer.
fun connect_socket(url: str): Result<SocketDuplex, str> {
	connect_socket_with(url, [rpc_subprotocol()])
}

/// `connect_socket`, offering `protocols` on the handshake (A40) — the seam a
/// credential rides on, since a browser handshake carries no headers.
/// `std::rpc::rpc_protocols(token)` writes the documented offer. The same list
/// is re-presented on every reconnect.
fun connect_socket_with(url: str, protocols: List<str>): Result<SocketDuplex, str> {
	dial_socket(url, protocols).map_err(|failure: DialFailure| failure.message())
}

/// `connect_socket_with`, with the TYPED failure (A47) — the entry point the
/// generated `Client::connect` reaches through `dial_for_service`, because it
/// is the one that can tell a refusal from an unreachable server.
/// `connect_socket`/`connect_socket_with` keep their `Err(str)` and are this
/// with the failure flattened to its sentence.
fun dial_socket(url: str, protocols: List<str>): Result<SocketDuplex, DialFailure> {
	let inbound: Shared<Option<|Frame| void>> = Shared::new(None);
	let early: Shared<List<Frame>> = Shared::new([]);
	let pending: Shared<List<PendingCall>> = Shared::new([]);
	let settle = |request: i32, reply: Frame| settle_pending(pending, request, reply);
	let dispatch = |payload: Frame| deliver_inbound(inbound, early, payload);
	match dial_with_backoff(url, protocols, settle, dispatch) {
		Err(let reason) => Err(reason),
		Ok(let opened) => {
			let (socket, connection) = opened;
			let duplex = SocketDuplex {
				socket = Shared::new(socket),
				url,
				protocols,
				connection = Shared::new(connection),
				state = SignalCell::new(ConnectionState::Connected),
				inbound,
				early,
				pending,
				next_request = Shared::new(0),
				on_reconnect = Shared::new([]),
				on_terminal = Shared::new([]),
			};
			watch_socket(duplex);
			// HMR (`hmr.md` §3, step 2): close the live socket before the next
			// bundle re-dials — the fresh duplex resyncs from the server exactly as
			// a K6 reconnect does. Reads the cell at teardown time, so a socket
			// swapped in by a reconnect is the one closed. A no-op without a shim.
			if hmr_active() {
				hmr_register_teardown(|| duplex.socket.read().close());
			}
			Ok(duplex)
		},
	}
}

// === Wire envelope (RPC) ====================================================

/// The request handle a dispatcher hands to handlers: the method that routed it
/// plus the request's deserializer, positioned at the first argument. `arg`
/// pulls the NEXT argument — arguments are read in declaration order, exactly
/// once (the schema-ordered binary format requires it; generated handlers obey
/// by construction, hand-written ones by contract — proposal §4.1).
struct RpcRequest {
	method: str,
	deserializer: Deserializer,
	arity: i32,
	/// The connection this request arrived on, or `-1` where there is none:
	/// the connectionless `{mount}rpc` POST leg, `local_rpc`, a hand-built
	/// protocol. A route that EXPORTS a source needs it and nothing else does
	/// (`transport-rpc.md` §9.2): the capability table is per connection
	/// (`session_of`), so a channel id minted for one connection is
	/// meaningless on any other. It is stamped from the `Connection` the
	/// service built this protocol for — the honest source — and never read
	/// off the frame, which the caller writes.
	connection: i32,
}

impl RpcRequest {
	/// The same request, tagged with the connection it arrived on. What
	/// `RpcProtocol::respond` stamps before dispatching; `open_request` alone
	/// cannot know, because a frame carries no connection.
	fun on_connection(own self, connection: i32): RpcRequest {
		self.connection = connection;
		self
	}
}

/// What a handler returns: a result that describes itself into the reply
/// envelope (single-pass — no intermediate encoding), or a failure.
enum RpcOutcome {
	Success(|Serializer| void),
	Failure(RpcError),
}

/// An infrastructure-level failure — distinct from an application error, which is part of
/// a procedure's own return type (e.g. `Option<User>` for "might not exist").
///
/// `PartialEq` because the commonest thing an app does with one is COMPARE it
/// (tracker A52): `if error == RpcError::Unauthorized { sign_in() }` is the
/// whole point of a typed error, and without the derive a caller had to reach
/// for a `match` with an arm per variant or read `debug()` back as text. The
/// payload arms compare their sentences, which is what a `Transport(reason)`
/// against a literal means.
[derive(Wire, Debug, PartialEq)]
enum RpcError {
	Transport(str),
	Decode(str),
	Remote(str),
	// The connect-time contract check refused a drifted server (Q6): the two
	// sides were built against different service surfaces.
	Contract(str),
	Unauthorized,
	/// The server refused this connection with a 503 (tracker A52): a
	/// judgement about NEITHER the credential nor the rate — the infrastructure
	/// behind the service is not ready to serve this client. The client's
	/// answer is "not now", where `Unauthorized`'s is "not with this
	/// credential": retrying later is the right thing, retrying immediately is
	/// not, and re-authenticating is beside the point.
	Unavailable,
}

// --- Envelope encode/decode (shared by `call`, the protocol, and benchmarks) --

/// One request envelope, written in a single pass: the method, then each
/// argument described straight into the same serializer. On the JSON codec the
/// args are plain values (`{"method":"add","args":[1]}` — no escaping).
fun encode_request(codec: Codec, method: str, args: List<|Serializer| void>): Frame {
	let (serializer, finish) = (codec.writer)();
	(serializer.begin_struct)(2);
	(serializer.field)("method");
	(serializer.str_value)(method);
	(serializer.field)("args");
	(serializer.begin_list)(args.len());
	for describe in args {
		describe(serializer);
	}
	(serializer.end_list)();
	(serializer.end_struct)();
	finish()
}

/// Open a request frame into the handle handlers consume. A corrupt frame
/// leaves the deserializer poisoned; the protocol turns that into a `Decode`
/// failure before routing.
fun open_request(codec: Codec, frame: Frame): RpcRequest {
	let deserializer = (codec.reader)(frame);
	(deserializer.begin_struct)();
	(deserializer.field)("method");
	let method = (deserializer.str_value)();
	(deserializer.field)("args");
	let arity = (deserializer.begin_list)();
	RpcRequest { method, deserializer, arity, connection = 0 - 1 }
}

/// One reply envelope: an externally-tagged `Success` carrying the described
/// result, or `Failure` carrying the `RpcError`.
fun encode_reply(codec: Codec, outcome: RpcOutcome): Frame {
	let (serializer, finish) = (codec.writer)();
	match outcome {
		RpcOutcome::Success(let describe) => {
			(serializer.begin_variant)("Success", 1);
			describe(serializer);
			(serializer.end_variant)();
		},
		RpcOutcome::Failure(let error) => {
			(serializer.begin_variant)("Failure", 1);
			error.describe(serializer);
			(serializer.end_variant)();
		},
	}
	finish()
}

// === RpcProtocol ============================================================

/// The request/response protocol over one codec: open the request envelope,
/// route through the application `dispatch`, encode the outcome. It always
/// replies — an unknown method or a corrupt frame is a `Failure` envelope, not
/// silence. `[service(Client)]` generation emits the dispatch routing;
/// `Dispatcher` below is the hand-written form.
struct RpcProtocol {
	codec: Codec,
	/// The request handler; an async handler's reply frame is encoded from
	/// its settled outcome (calls through the field await — a sync one just
	/// resolves).
	dispatch: async |RpcRequest| RpcOutcome,
	/// The connection every request through this protocol arrived on, or `-1`
	/// for a protocol no connection built (`into_protocol`'s default, which is
	/// what `local_rpc` and the POST leg get). `Service` stamps it per
	/// connection at the upgrade, which is how a source-returning route
	/// reaches THIS client's capability table and no other's (§9.2).
	connection: i32,
}

impl RpcProtocol {
	/// The same protocol, answering for one connection — the copy
	/// `accept_socket` makes per upgraded socket. The dispatcher is shared
	/// (under `Service::new` one instance answers every client); only the
	/// connection stamp differs, and it is what a source-returning route
	/// exports through.
	fun for_connection(own self, connection: i32): RpcProtocol {
		self.connection = connection;
		self
	}

	fun respond(self, frame: Frame): Frame {
		let request = open_request(self.codec, frame).on_connection(self.connection);
		let outcome = match (request.deserializer.failed)() {
			Some(let reason) => RpcOutcome::Failure(RpcError::Decode(reason)),
			None => (self.dispatch)(request),
		};
		encode_reply(self.codec, outcome)
	}
}

/// A `LocalTransport` that routes every request through an `RpcProtocol` — the in-process
/// wiring of a client stub to its server dispatcher. The handler runs in a
/// a held `turn` — the **wire turn** (proposal/reactive-batching.md), held across
/// any awaits in the handler: signal writes made while dispatching are deferred
/// to the turn's flush, so a method that mutates subscribed state produces ONE
/// coalesced `Update` per source alongside its reply, not one per write — even
/// when the method suspends partway.
fun local_rpc(protocol: RpcProtocol): LocalTransport {
	LocalTransport { handler = |frame| turn(FlushPolicy::AtEnd, || protocol.respond(frame)) }
}

// === Foundation: the ergonomic client + server API (proposal §4.1) ==========
//
// `call<T>` collapses a client round-trip (envelope -> await -> decode) into one line;
// `Dispatcher` routes requests to typed handlers, `arg`/`reply` pulling and
// describing values through the wiring-time codec (§6.2) — single-pass, no
// intermediate encoding.
// This is the foundation `[service(Client)]` generation emits over — and the API to use
// directly when writing the plumbing by hand.

/// One over-the-wire call: encode the request in a single pass (each argument
/// describes itself into the envelope's serializer), await the round-trip, and
/// decode the reply as `T` (inferred from the call site). Infrastructure
/// failures — transport, decode, a remote error — surface as `Err(RpcError)`.
fun call<T: Wire, Tx: Transport>(
	transport: Tx,
	codec: Codec,
	method: str,
	args: List<|Serializer| void>,
): Result<T, RpcError> {
	let outcome = await transport.call(encode_request(codec, method, args));
	match outcome {
		// The transport itself failed — a dropped connection, an unreachable
		// host, a call issued while disconnected.
		Err(let reason) => Err(RpcError::Transport(reason)),
		Ok(let reply_frame) => {
			let deserializer = (codec.reader)(reply_frame);
			let tag = (deserializer.variant_tag)();
			match tag {
				"Success" => {
					(deserializer.begin_variant)("Success", 1);
					let value: T = T::rebuild(deserializer);
					match (deserializer.failed)() {
						None => Ok(value),
						Some(let reason) => Err(RpcError::Decode(reason)),
					}
				},
				"Failure" => {
					(deserializer.begin_variant)("Failure", 1);
					let error: RpcError = RpcError::rebuild(deserializer);
					(deserializer.end_variant)();
					Err(error)
				},
				_ => Err(RpcError::Decode("unrecognized reply envelope")),
			}
		},
	}
}

/// Pull the NEXT argument at the parameter's type (`index` documents the
/// position at the call site — reads are positional and once-each; see
/// `RpcRequest`). A missing/garbled argument poisons the request's
/// deserializer; check `decode_failed` before running the impl.
fun arg<T: Wire>(request: RpcRequest, index: i32): T {
	T::rebuild(request.deserializer)
}

/// Whether decoding this request has failed so far — the gate between the
/// `arg` pulls and the impl call, turning a garbled request into a clean
/// `RpcError::Decode` instead of an impl run on zero values.
fun decode_failed(request: RpcRequest): Option<str> {
	(request.deserializer.failed)()
}

/// Capture a procedure's result as a success outcome — described into the
/// reply envelope when the protocol encodes it.
fun reply<T: Wire>(value: T): RpcOutcome {
	RpcOutcome::Success(|serializer: Serializer| value.describe(serializer))
}

/// Reply with a HANDLE: export `source` on the connection this request arrived
/// on and put the channel id — a plain-Wire `i32` — on the wire in its place
/// (`transport-rpc.md` §9.2). What the `[service]` expansion emits for an
/// `[rpc]` method whose return type is a source, and the whole of the "reply
/// path": the value never crosses, its channel does.
///
/// The export is DYNAMIC (`expose_dynamic`), which is the one thing that
/// separates it from an `[expose]`d field's channel: the client's mirror
/// carries the call that minted it, so its `Unsubscribe` may withdraw the
/// capability outright rather than only its forward (R3). A `[expose]` field
/// channel has no origin and is re-attached positionally, so it stays
/// demand-only (A41).
///
/// It runs inside the route's turn, so the seeding `Update` a client's
/// `Subscribe` provokes settles with the reply's own wave.
///
/// With no connection — the connectionless `{mount}rpc` POST leg, or a
/// `local_rpc` transport — there is no capability table to mint into and the
/// call fails in as many words rather than answering a channel id that names
/// nothing.
/// The parameter is the CANONICAL CELL rather than a generic `S: Source<T>`,
/// and that is the mapping's own rule read back (`handle_element`): the
/// expansion recognises a handle return by its written spelling, so the reply
/// path takes exactly what it recognises. It is also what vilan's inference
/// allows — a type parameter is solved from the call's TYPES, not from a bound
/// (`expose_keyed` says the same about its key projection), so an `S` that is
/// itself a parameter leaves `T` unsolvable.
fun reply_source<T: Wire>(request: RpcRequest, source: SignalCell<T>): RpcOutcome {
	match session_of(request.connection) {
		Some(let session) => reply(session.expose_dynamic(source)),
		None => RpcOutcome::Failure(RpcError::Remote("a source-returning method needs this connection's reactive session, and this " + "request arrived on none (the connectionless POST leg has no channels)")),
	}
}

/// `reply_source` for the `Option` form: `Option<SignalCell<T>>` in, an
/// `Option<i32>` channel on the wire, `Option<RemoteSource<T>>` at the client.
/// A `None` mints nothing at all — the absence is the answer, and no
/// capability is retained for a row the server does not have.
fun reply_source_option<T: Wire>(request: RpcRequest, source: Option<SignalCell<T>>): RpcOutcome {
	match source {
		None => {
			let absent: Option<i32> = None;
			reply(absent)
		},
		Some(let present) => match session_of(request.connection) {
			Some(let session) => {
				let channel: Option<i32> = Some(session.expose_dynamic(present));
				reply(channel)
			},
			None => RpcOutcome::Failure(RpcError::Remote("a source-returning method needs this connection's reactive session, and this " + "request arrived on none (the connectionless POST leg has no channels)")),
		},
	}
}

/// One route: a method name and the handler that consumes the request handle
/// and produces an outcome.
struct Route {
	method: str,
	/// The method's handler; calls through the field await.
	handler: async |RpcRequest| RpcOutcome,
}

/// The server router: register handlers by method name, then route each request to its match
/// (or an `unknown method` failure). `into_protocol` wraps it as an `RpcProtocol` for a transport.
struct Dispatcher {
	routes: Shared<List<Route>>,
}

impl Dispatcher {
	fun new(): Dispatcher {
		Dispatcher { routes = Shared::new([]) }
	}

	/// Register a handler for a method name, returning `self` so registrations chain.
	fun on(self, method: str, handler: async |RpcRequest| RpcOutcome): Dispatcher {
		self.routes.write().push(Route { method, handler });
		self
	}

	/// Route a request to its handler, or fail with `unknown method`.
	fun handle(self, request: RpcRequest): RpcOutcome {
		match self.routes.read().filter(|route| route.method == request.method).first() {
			Some(let route) => (route.handler)(request),
			None => RpcOutcome::Failure(RpcError::Remote("unknown method: " + request.method)),
		}
	}

	/// Wrap as an `RpcProtocol` over `codec` — the wiring-time format choice
	/// (§6.2) — ready to mount on a transport (e.g. `local_rpc`).
	fun into_protocol(self, codec: Codec): RpcProtocol {
		// No connection until a service stamps one (`for_connection`): a
		// dispatcher on its own answers whoever calls it.
		RpcProtocol { codec, dispatch = |request| self.handle(request), connection = 0 - 1 }
	}
}

/// What `[service]` implements for the struct it decorates: THIS INSTANCE's
/// dispatcher. One instance, one dispatcher, one connection — the shape
/// `Service::factory` needs (`transport-rpc.md` Q9: the struct instance is the
/// connection's session, created on connect and owned by the dispatcher the
/// routes close over). `dispatcher()` stays as the inherent spelling for the
/// process-wide instance `Service::new` mounts; this trait is what lets std
/// build a dispatcher from an instance it only learns the type of at the
/// factory's call site.
trait RpcService {
	fun dispatcher_for(self): Dispatcher;
}

// === Reactive protocol ======================================================

// The protocol's frames — `Subscribe(channel, key?)` / `Unsubscribe(channel,
// key?)` up, `Update(channel, value)` and `Patch(channel, ops)` down — are
// written *single-pass* over the codec, like RPC's envelopes: an update's
// value, a patch's deltas and a subscription's key each describe themselves
// straight into the envelope's serializer, so the wire never sees an
// intermediate encoding (proposal §8, the codec upgrade).
//
// The OPTIONAL key on the control frames is A39: per-key demand is a property
// of the protocol, so a keyed channel can forward one message's changes to the
// client watching that message and nothing to the rest. `Patch` is its
// downward half — the delta vocabulary `Update` never had.

/// One control frame: the client→server half. `Subscribe`/`Unsubscribe` carry
/// the channel AND the optional key whose changes are wanted, so per-key demand
/// is a property of the PROTOCOL rather than of an application method handing
/// out a channel per row (A39). `None` is the whole collection — what every
/// non-keyed channel sends, and what a keyed one sends when a client wants all
/// of it.
fun encode_control(codec: Codec, kind: str, channel: i32): Frame {
	let (serializer, finish) = (codec.writer)();
	(serializer.begin_variant)(kind, 2);
	(serializer.i32_value)(channel);
	(serializer.null_value)();
	(serializer.end_variant)();
	finish()
}

/// `encode_control` naming ONE key. The key describes itself inline at its own
/// type, exactly like an update's payload, so the codec never sees a stringly
/// encoded id and a keyed channel's key type is as typed end to end as its
/// element type.
fun encode_control_keyed(
	codec: Codec,
	kind: str,
	channel: i32,
	describe_key: |Serializer| void,
): Frame {
	let (serializer, finish) = (codec.writer)();
	(serializer.begin_variant)(kind, 2);
	(serializer.i32_value)(channel);
	(serializer.some_value)();
	describe_key(serializer);
	(serializer.end_variant)();
	finish()
}

/// One update frame: the channel, then the value described inline.
fun encode_update(codec: Codec, channel: i32, describe: |Serializer| void): Frame {
	let (serializer, finish) = (codec.writer)();
	(serializer.begin_variant)("Update", 2);
	(serializer.i32_value)(channel);
	describe(serializer);
	(serializer.end_variant)();
	finish()
}

/// One patch frame: the channel, then the ops described inline — `Update`'s
/// keyed sibling (A39). An `Update` says "here is the whole value again"; a
/// `Patch` says only what moved, which is what stops an edit inside a
/// five-thousand-message channel from costing the channel.
fun encode_patch(codec: Codec, channel: i32, describe_ops: |Serializer| void): Frame {
	let (serializer, finish) = (codec.writer)();
	(serializer.begin_variant)("Patch", 2);
	(serializer.i32_value)(channel);
	describe_ops(serializer);
	(serializer.end_variant)();
	finish()
}

// --- The session registry (Client::connect's server half, §4.2) -------------

/// Per-connection reactive sessions, keyed by connection id — what the
/// generated `__attach` route answers from. `Service::new`'s default
/// lifecycle populates it on connect and disposes on disconnect; apps wanting
/// custom per-connection state keep the manual pattern
/// (`Service::on_connect`/`on_disconnect` + their own registry).
let reactive_sessions: Shared<List<(i32, ReactiveServer)>> = Shared::new([]);

/// Adopt a fresh connection: one reactive session on its wire, speaking the
/// protocol's codec (§6.2 — one codec deployment-wide, Q6).
fun register_session(connection: i32, wire: DuplexEnd, codec: Codec) {
	reactive_sessions.write().push((connection, ReactiveServer::new(wire, codec)));
}

/// The connection closed: dispose its session so signal changes stop fanning
/// out to (or retaining) the dead wire.
fun drop_session(connection: i32) {
	mut kept: List<(i32, ReactiveServer)> = [];
	for entry in reactive_sessions.read() {
		let (id, session) = entry;
		if id == connection {
			session.dispose();
		} else {
			kept.push((id, session));
		}
	}
	reactive_sessions.write() = kept;
}

/// The live session for a connection, if it is still connected.
fun session_of(connection: i32): Option<ReactiveServer> {
	for entry in reactive_sessions.read() {
		let (id, session) = entry;
		if id == connection {
			ret Some(session);
		}
	}
	None
}

/// Channel ids — module-level, one counter for the program (mirrors reactive's
/// `next_subscriber_id`).
let next_channel: Shared<i32> = Shared::new(0);

fun fresh_channel(): i32 {
	let id = next_channel.read();
	next_channel.write() = id + 1;
	id
}

// --- Server side: the capability table --------------------------------------

/// What one channel can start, and how. A PLAIN channel has only `start` — the
/// whole-value forward `expose` mints. A KEYED channel has `resolve` too: it
/// can read a subscribed key off an inbound frame *at its own key type* and
/// start a forward carrying only that key's changes (A39).
struct Capability {
	/// The whole-collection forward (`Subscribe(channel, None)`).
	start: || Subscription,
	/// Pull the subscribed key at this channel's key type and answer with its
	/// canonical `Hash` — the server-local identity the live table is keyed by,
	/// which never crosses the wire — paired with the starter for that key's
	/// forward. `None` on a plain channel: it has no key type to read one at,
	/// so a keyed `Subscribe` there is a protocol error the server cannot
	/// answer, and is dropped.
	resolve: Option<|Deserializer| KeySubscription>,
	/// Whether this channel was minted inside a REPLY (`expose_dynamic`,
	/// §9.2) rather than by an `[expose]`d field's `__attach`. The one bit
	/// that separates the two lifetimes (R3): a dynamic channel's client
	/// mirror carries the call that minted it, so it can ask for a fresh one,
	/// and its `Unsubscribe` therefore REVOKES — forwards stopped, capability
	/// dropped, source freed. A field channel has no origin and is re-attached
	/// positionally, so its `Unsubscribe` stays demand-only (A41).
	dynamic: bool,
}

/// A resolved per-key subscription: which key (canonically), and how to start
/// its forward. The starter is LAZY — the `Unsubscribe` path resolves a key the
/// same way and throws the starter away.
struct KeySubscription {
	key: Hash,
	start: || Subscription,
}

/// One running forward: its channel, the key it carries (`None` = the whole
/// collection) and the subscription that stops it. One entry per (channel,
/// key), which is what makes `Subscribe` idempotent per key rather than per
/// channel.
struct LiveForward {
	channel: i32,
	key: Option<Hash>,
	subscription: Subscription,
}

/// Two subscribed keys, or two absences, are the same demand.
fun same_demand(left: Option<Hash>, right: Option<Hash>): bool {
	match left {
		None => match right {
			None => true,
			Some(let _present) => false,
		},
		Some(let a) => match right {
			None => false,
			Some(let b) => a.eq(b),
		},
	}
}

/// The reactive protocol's server half: a per-connection **capability table**
/// mapping a channel id to a *starter* for the exposed source, plus the live
/// forwards started by client subscriptions. A `Signal`/`Source` never crosses
/// as a value — it is exported as an id, and its updates flow as `Update`
/// frames (proposal §8) or, on a keyed channel, as `Patch` frames (A39).
struct ReactiveServer {
	transport: DuplexEnd,
	codec: Codec,
	// Per channel, what a client's subscription starts. Nothing subscribes —
	// or is retained — until a client asks.
	sources: Shared<List<(i32, Capability)>>,
	live: Shared<List<LiveForward>>,
}

impl ReactiveServer {
	fun new(transport: DuplexEnd, codec: Codec): ReactiveServer {
		let server = ReactiveServer {
			transport,
			codec,
			sources = Shared::new([]),
			live = Shared::new([]),
		};
		(server.transport).on_frame(|frame| {
			// every inbound frame is handled in a turn (proposal/reactive-batching.md)
			batch(|| server.receive(frame));
		});
		server
	}

	/// Export a `Source<T>` under a fresh channel id; the id is what crosses the
	/// wire in place of the source. `T` is erased *here*, inside the runtime, to
	/// the starter closure (the capability table holds heterogeneous sources):
	/// on a client's Subscribe it subs the typed source and single-passes each
	/// value straight into an `Update` envelope over the wiring-time codec.
	fun expose<T: Wire, S: Source<T>>(self, source: S): i32 {
		let channel = fresh_channel();
		let transport = self.transport;
		let codec = self.codec;
		let starter = || source.sub(|value| {
			transport.send(encode_update(codec, channel, |serializer: Serializer| {
				value.describe(serializer);
			}));
		});
		self.sources
			.write()
			.push((channel, Capability { start = starter, resolve = None, dynamic = false }));
		channel
	}

	/// `expose` for a channel minted inside a REPLY — a source an `[rpc]`
	/// method returned (`transport-rpc.md` §9.2, `reply_source`). Identical to
	/// `expose` in everything the wire sees; the capability is marked DYNAMIC,
	/// which decides one thing and only one: this channel's `Unsubscribe`
	/// REVOKES it (R3), where a field channel's stops the forward and keeps
	/// the capability (A41).
	///
	/// That difference is the difference between the two lifetimes. A field
	/// channel is minted once per connection and a remount must find it again.
	/// A dynamic channel is minted per CALL, and its client mirror remembers
	/// the call — so demand returning is a fresh mint, and holding the old
	/// capability would retain the source (and the row it closes over) for the
	/// life of the connection: one per row a long session ever scrolled past,
	/// which is exactly the leak `revoke` describes.
	/// Takes the canonical cell rather than a generic `S: Source<T>`, which is
	/// the mapping's own rule (`handle_element` reads a handle return as
	/// `SignalCell<T>`) and also what inference allows: `T` is solved from the
	/// call's TYPES, not from a bound, so a caller that is ITSELF generic —
	/// `reply_source`, the only caller that matters — cannot pass an opaque
	/// `S`. `expose` keeps the open form for the field path, where every call
	/// site is a concrete field.
	fun expose_dynamic<T: Wire>(self, source: SignalCell<T>): i32 {
		let channel = fresh_channel();
		let transport = self.transport;
		let codec = self.codec;
		let starter = || source.sub(|value| {
			transport.send(encode_update(codec, channel, |serializer: Serializer| {
				value.describe(serializer);
			}));
		});
		self.sources
			.write()
			.push((channel, Capability { start = starter, resolve = None, dynamic = true }));
		channel
	}

	/// Export a KEYED `List<T>`: subscribers receive element-grained `Patch`
	/// frames instead of the whole list on every change, and may subscribe to
	/// ONE key (A39). `key_of` is what makes two snapshots comparable element by
	/// element — `|message| message.key()` for a `T: Keyed<K>`, which is what
	/// `[expose(keyed)]` generates. `T: PartialEq` is what says an element
	/// *changed*, so `[derive(Wire, PartialEq)]` is the whole obligation on an
	/// exposed element type.
	///
	/// The projection is a VALUE parameter rather than the `Keyed<K>` bound
	/// alone because `K` would otherwise appear nowhere in the signature, and
	/// vilan infers a type parameter from the call's types, not from its
	/// bounds. The client half has no such problem — `KeyedSource<K, T>` names
	/// `K` in the subject — so `Keyed` is a real bound there.
	fun expose_keyed<K: Wire + Hashable, T: Wire + PartialEq, S: Source<List<T>>>(
		self,
		source: S,
		key_of: sync |T| K,
	): i32 {
		self.expose_keyed_with(source, |value: List<T>| value, key_of)
	}

	/// The `Map` form. The map's VALUES are the collection, and `key_of` is the
	/// authority on each one's key because it is what a delta carries — a map
	/// whose key disagrees with its value's own would patch under the value's.
	fun expose_keyed_map<K: Wire + Hashable, V: Wire + PartialEq, S: Source<Map<K, V>>>(
		self,
		source: S,
		key_of: sync |V| K,
	): i32 {
		self.expose_keyed_with(source, |value: Map<K, V>| value.values(), key_of)
	}

	/// The general keyed exposure both forms bottom out in: any `Source<C>`
	/// plus the projection that reads the keyed collection out of `C`. The
	/// projections run inside the forward, not at exposure time, so a keyed
	/// channel retains exactly as little as a plain one until a client asks.
	fun expose_keyed_with<K: Wire + Hashable, T: Wire + PartialEq, C, S: Source<C>>(
		self,
		source: S,
		elements: sync |C| List<T>,
		key_of: sync |T| K,
	): i32 {
		let channel = fresh_channel();
		let transport = self.transport;
		let codec = self.codec;
		let start = || keyed_forward(transport, codec, channel, source, elements, key_of);
		let resolve = |deserializer: Deserializer| {
			let key: K = K::rebuild(deserializer);
			KeySubscription {
				key = key.hash(),
				start = || keyed_key_forward(transport, codec, channel, source, elements, key_of, key),
			}
		};
		self.sources
			.write()
			.push((channel, Capability { start, resolve = Some(resolve), dynamic = false }));
		channel
	}

	/// The capability registered for a channel, if it still holds one.
	fun capability_of(self, channel: i32): Option<Capability> {
		for entry in self.sources.read() {
			let (id, capability) = entry;
			if id == channel {
				ret Some(capability);
			}
		}
		None
	}

	/// Whether a forward for exactly this demand is already running.
	fun forwarding(self, channel: i32, key: Option<Hash>): bool {
		for forward in self.live.read() {
			if forward.channel == channel {
				if same_demand(forward.key, key) {
					ret true;
				}
			}
		}
		false
	}

	/// A client subscribed to the whole channel: start its forward. `sub` fires
	/// immediately with the current value, so a subscriber gets the present
	/// state before any change. IDEMPOTENT: a `Subscribe` for a demand whose
	/// forward is already live is a no-op — one demand, one forward, however
	/// many times a client asks (`proposal/remote-sources.md` §3; a counted
	/// client never asks twice, and the server does not rely on that for its
	/// own correctness).
	fun start(self, channel: i32) {
		if self.forwarding(channel, None) {
			ret;
		}
		match self.capability_of(channel) {
			Some(let capability) => {
				let subscription = (capability.start)();
				self.live.write().push(LiveForward { channel, key = None, subscription });
			},
			None => {},
		}
	}

	/// The keyed half of `start`: read the subscribed key off the frame at the
	/// channel's own key type, then open — or re-use — that key's forward. A
	/// keyed `Subscribe` on a channel that is not keyed has no key type to read
	/// at, so it is dropped: the server cannot answer it, and answering it with
	/// the whole collection would be a silent protocol lie.
	fun start_key(self, channel: i32, deserializer: Deserializer) {
		match self.resolve_key(channel, deserializer) {
			None => {},
			Some(let resolved) => {
				if !self.forwarding(channel, Some(resolved.key)) {
					let subscription = (resolved.start)();
					self.live
						.write()
						.push(LiveForward { channel, key = Some(resolved.key), subscription });
				}
			},
		}
	}

	/// Read a subscribed key at the channel's key type. `None` when the channel
	/// is unknown, is not keyed, or the key did not decode.
	fun resolve_key(self, channel: i32, deserializer: Deserializer): Option<KeySubscription> {
		match self.capability_of(channel) {
			None => None,
			Some(let capability) => match capability.resolve {
				None => None,
				Some(let resolve) => {
					let resolved = resolve(deserializer);
					match (deserializer.failed)() {
						Some(let _reason) => None,
						None => Some(resolved),
					}
				},
			},
		}
	}

	/// The `Unsubscribe` arm (R3): what a client's whole-channel demand
	/// reaching zero MEANS, which is not the same for the two kinds of channel.
	///
	/// A `[expose]`d FIELD channel keeps its capability — `stop` — because an
	/// `Unsubscribe` there is client-local demand hitting zero and a remount
	/// re-`Subscribe`s on the same id (A41). A DYNAMIC channel is REVOKED: the
	/// mirror that owns it carries the call that minted it and re-mints by
	/// re-issuing that call, so the id is finished with the moment demand
	/// leaves, and keeping the capability would retain the source for the life
	/// of the connection.
	///
	/// This is the whole of §9.2's `Release(channel)` frame, spent instead of
	/// added: demand decides, and the server already knows which kind of
	/// channel it minted.
	fun release_demand(self, channel: i32) {
		if self.dynamic_channel(channel) {
			self.revoke(channel);
		} else {
			self.stop(channel);
		}
	}

	/// Whether `channel` was minted inside a reply (`expose_dynamic`).
	fun dynamic_channel(self, channel: i32): bool {
		match self.capability_of(channel) {
			Some(let capability) => capability.dynamic,
			None => false,
		}
	}

	/// A client unsubscribed from the whole channel: dispose that forward.
	///
	/// The CAPABILITY stays. An `Unsubscribe` is client-local demand reaching
	/// zero — a view unmounting, a row scrolling out — and `RemoteSource`
	/// re-`Subscribe`s on the same channel id the moment demand returns
	/// (`acquire`, 0→1). Dropping the `sources` entry here would make every
	/// such remount silently dead, so revoking a channel is a separate,
	/// deliberate act: `revoke` (A41).
	fun stop(self, channel: i32) {
		self.stop_forward(channel, None);
	}

	/// The keyed half of `stop` — the per-key lease reaching zero. Releases one
	/// key's forward and leaves every other key on the channel running.
	fun stop_key(self, channel: i32, deserializer: Deserializer) {
		match self.resolve_key(channel, deserializer) {
			None => {},
			Some(let resolved) => self.stop_forward(channel, Some(resolved.key)),
		}
	}

	/// Dispose the forward for exactly one demand.
	fun stop_forward(self, channel: i32, key: Option<Hash>) {
		mut kept: List<LiveForward> = [];
		for forward in self.live.read() {
			if forward.channel == channel && same_demand(forward.key, key) {
				forward.subscription.dispose();
			} else {
				kept.push(forward);
			}
		}
		self.live.write() = kept;
	}

	/// Withdraw a channel: stop EVERY forward on it — the whole-collection one
	/// and each subscribed key — AND drop the capability, so a later
	/// `Subscribe` for that id finds nothing and the starter closure, with the
	/// source it captured, is released.
	///
	/// This is what a DYNAMIC exposure needs (A41). A channel minted by
	/// `expose` at runtime — an rpc method handing out a per-row or per-thread
	/// channel — is capped by nothing: `dispose` clears the table, but that is
	/// the end of the CONNECTION, so a client that scrolls a long list
	/// accumulates one retained starter per row it ever looked at. The static
	/// `[expose]` path mints one channel per field per connection and never
	/// needs this; the dynamic path must revoke what it minted when the app
	/// knows the id is finished with.
	fun revoke(self, channel: i32) {
		mut kept: List<LiveForward> = [];
		for forward in self.live.read() {
			if forward.channel == channel {
				forward.subscription.dispose();
			} else {
				kept.push(forward);
			}
		}
		self.live.write() = kept;
		mut remaining: List<(i32, Capability)> = [];
		for entry in self.sources.read() {
			let (id, capability) = entry;
			if id != channel {
				remaining.push((id, capability));
			}
		}
		self.sources.write() = remaining;
	}

	/// One inbound control frame: `Subscribe`/`Unsubscribe` route to
	/// `start`/`stop`, and their keyed forms to `start_key`/`stop_key`. The key
	/// half is read by PEEKING (`is_null`) rather than by a second tag, so one
	/// frame shape serves both demands. A malformed frame — or a stray `Update`
	/// or `Patch`, which only ever flow server → client — is dropped.
	fun receive(self, frame: Frame) {
		let deserializer = (self.codec.reader)(frame);
		let tag = (deserializer.variant_tag)();
		(deserializer.begin_variant)(tag, 2);
		let channel = (deserializer.i32_value)();
		match (deserializer.failed)() {
			Some(let _reason) => {},
			None => {
				if (deserializer.is_null)() {
					(deserializer.null_value)();
					match tag {
						"Subscribe" => self.start(channel),
						"Unsubscribe" => self.release_demand(channel),
						_ => {},
					}
				} else {
					match tag {
						"Subscribe" => self.start_key(channel, deserializer),
						"Unsubscribe" => self.stop_key(channel, deserializer),
						_ => {},
					}
				}
			},
		}
	}
}

/// Send one patch: the ops describe themselves straight into the envelope, so
/// a delta never sees an intermediate encoding either.
fun send_patch<K: Wire, T: Wire>(
	transport: DuplexEnd,
	codec: Codec,
	channel: i32,
	ops: List<Delta<K, T>>,
) {
	transport.send(encode_patch(codec, channel, |serializer: Serializer| {
		ops.describe(serializer);
	}));
}

/// The whole-collection forward: seed with `Reset`, then one `Patch` per change
/// carrying only what moved. The previous snapshot is per FORWARD, not per
/// channel — two connections watching the same signal each keep their own, so
/// a client that subscribes late still gets a seed rather than someone else's
/// delta.
fun keyed_forward<K: Wire + Hashable, T: Wire + PartialEq, C, S: Source<C>>(
	transport: DuplexEnd,
	codec: Codec,
	channel: i32,
	source: S,
	elements: sync |C| List<T>,
	key_of: sync |T| K,
): Subscription {
	let seeded: Shared<bool> = Shared::new(false);
	let previous: Shared<List<T>> = Shared::new([]);
	source.sub(|published| {
		let current = elements(published);
		mut ops: List<Delta<K, T>> = [];
		if seeded.read() {
			ops = keyed_diff(previous.read(), current, key_of);
		} else {
			seeded.write() = true;
			ops.push(Delta::Reset(current));
		}
		previous.write() = current;
		if ops.len() > 0 {
			send_patch(transport, codec, channel, ops);
		}
	})
}

/// The per-key forward: everything this subscriber is owed about ONE key, and
/// nothing about any other. The seed is an `Insert` (never a `Reset`), because
/// a mirror may hold several independently subscribed keys and a `Reset` would
/// throw the others away.
fun keyed_key_forward<K: Wire + Hashable, T: Wire + PartialEq, C, S: Source<C>>(
	transport: DuplexEnd,
	codec: Codec,
	channel: i32,
	source: S,
	elements: sync |C| List<T>,
	key_of: sync |T| K,
	key: K,
): Subscription {
	let wanted = key.hash();
	let seeded: Shared<bool> = Shared::new(false);
	let held: Shared<Option<T>> = Shared::new(None);
	source.sub(|published| {
		let current = elements(published);
		mut found: Option<T> = None;
		mut at = 0;
		mut index = 0;
		for element in current {
			if found is None && key_of(element).hash().eq(wanted) {
				found = Some(element);
				at = index;
			}
			index += 1;
		}
		mut ops: List<Delta<K, T>> = [];
		match found {
			Some(let element) => match held.read() {
				Some(let before) => {
					if !before.eq(element) {
						ops.push(Delta::Update(key, element));
					}
				},
				None => ops.push(Delta::Insert(key, element, at)),
			},
			None => match held.read() {
				Some(let _before) => ops.push(Delta::Remove(key)),
				None => {},
			},
		}
		held.write() = found;
		if seeded.read() {
			if ops.len() > 0 {
				send_patch(transport, codec, channel, ops);
			}
		} else {
			// The seed goes even when the key is absent and the op list is
			// empty: an empty `Patch` is what tells the mirror it is in sync
			// (`status` leaves `Waiting`) without inventing an element.
			seeded.write() = true;
			send_patch(transport, codec, channel, ops);
		}
	})
}

/// The keyed diff: what a subscriber must apply to turn `previous` into
/// `current`. Removals first, then insertions in ascending FINAL index, then
/// updates — the order the ops must be applied in for the indices to name the
/// positions they mean.
///
/// A REORDER has no op of its own, so it falls back to `Reset`: when the
/// elements retained across the change are not in the same relative order on
/// both sides, the whole collection goes again. Appending, editing and deleting
/// — what a message platform does — never reorder, so the fallback is the rare
/// case, and it is correct where a cleverer diff would be subtly wrong.
///
/// A duplicate key keeps the FIRST occurrence, matching `Keyed`'s contract; the
/// later ones are invisible to the diff and to the mirror.
fun keyed_diff<K: Wire + Hashable, T: Wire + PartialEq>(
	previous: List<T>,
	current: List<T>,
	key_of: sync |T| K,
): List<Delta<K, T>> {
	mut previous_at: Map<Hash, i32> = Map::new();
	mut index = 0;
	for element in previous {
		let key = key_of(element).hash();
		if !previous_at.contains_key(key) {
			previous_at.insert(key, index);
		}
		index += 1;
	}
	mut current_keys: Map<Hash, bool> = Map::new();
	for element in current {
		current_keys.insert(key_of(element).hash(), true);
	}
	mut ops: List<Delta<K, T>> = [];
	mut retained_before: List<Hash> = [];
	for element in previous {
		let key = key_of(element).hash();
		if current_keys.contains_key(key) {
			retained_before.push(key);
		} else {
			ops.push(Delta::Remove(key_of(element)));
		}
	}
	mut retained_after: List<Hash> = [];
	for element in current {
		let key = key_of(element).hash();
		if previous_at.contains_key(key) {
			retained_after.push(key);
		}
	}
	if !same_sequence(retained_before, retained_after) {
		mut reset: List<Delta<K, T>> = [];
		reset.push(Delta::Reset(current));
		ret reset;
	}
	index = 0;
	for element in current {
		if !previous_at.contains_key(key_of(element).hash()) {
			ops.push(Delta::Insert(key_of(element), element, index));
		}
		index += 1;
	}
	for element in current {
		match previous_at.get(key_of(element).hash()) {
			None => {},
			Some(let at) => match previous.get(at) {
				None => {},
				Some(let before) => {
					if !before.eq(element) {
						ops.push(Delta::Update(key_of(element), element));
					}
				},
			},
		}
	}
	ops
}

/// Whether two key sequences are identical, position by position — the
/// reorder check `keyed_diff` falls back on.
fun same_sequence(before: List<Hash>, after: List<Hash>): bool {
	let length = before.len();
	if length != after.len() {
		ret false;
	}
	mut index = 0;
	for index < length {
		if !before[index].eq(after[index]) {
			ret false;
		}
		index += 1;
	}
	true
}

impl ReactiveServer with Disposable {
	/// Tear the session down: stop every live forward, then let the transport
	/// forget us. Starters keep no subscription of their own, so clearing the
	/// tables releases everything this session held on the app's signals — and
	/// clearing the inbound handler (A29) releases what the WIRE held on this
	/// session, which the tables never could: `new` installed a closure
	/// capturing the whole server, so without this a closed connection's server
	/// stayed reachable from its transport forever. After this, changes no
	/// longer reach this wire and the wire no longer reaches this session.
	///
	/// `drop_session` is covered by the same line: it disposes the session it
	/// drops.
	fun dispose(self) {
		for forward in self.live.read() {
			forward.subscription.dispose();
		}
		self.live.write() = [];
		self.sources.write() = [];
		(self.transport).clear_on_frame();
	}
}

// --- Client side: the remote handle -----------------------------------------

/// The reactive protocol's client half: routes each inbound `Update` frame to
/// the typed mirror of its subscribed channel. `source<T>` hands out a
/// `RemoteSource<T>` — the type binds at the call site (an annotated `let`, or
/// the generated client's mirror wiring).
struct ReactiveClient {
	transport: DuplexEnd,
	codec: Codec,
	// Per subscribed channel: the deliverer that decodes an `Update`'s payload
	// at the channel's type (fixed by `source<T>`) and lands it in the mirror.
	// The id is a CELL shared with the channel's `RemoteSource` — a reconnect
	// rebind moves both in one write (proposal/transport-robustness.md §2.5).
	routes: Shared<List<(Shared<i32>, |Frame| void)>>,
	// The mirrors minted from a RUNTIME channel id (`source`), each paired
	// with the action that points it at nothing. A reconnect mints a fresh
	// server session, and these are exactly the mirrors no `__attach` reply
	// can rebind — see `invalidate_dynamic` (A41). Origin-LESS only: a mirror
	// a generated stub minted carries its call and is replayed instead
	// (`replays`), which is what retires this path for generated clients.
	dynamic: Shared<List<|| void>>,
	// The mirrors a REPLY minted (`minted_source`, §9.2), each paired with the
	// action that re-issues its `origin` and rebinds it onto the fresh
	// session's channel. Erased to closures because the list is
	// heterogeneous — one entry per element type the service hands out.
	replays: Shared<List<|| void>>,
}

impl ReactiveClient {
	fun new(transport: DuplexEnd, codec: Codec): ReactiveClient {
		let client = ReactiveClient {
			transport,
			codec,
			routes = Shared::new([]),
			dynamic = Shared::new([]),
			replays = Shared::new([]),
		};
		(client.transport).on_frame(|frame| {
			// every inbound frame is handled in a turn (proposal/reactive-batching.md)
			batch(|| client.receive(frame));
		});
		client
	}

	/// A remote handle for a channel id the APP learned at runtime — an rpc
	/// method that minted a channel with `ReactiveServer::expose` and returned
	/// its id.
	///
	/// Identical to `attached_source` but for one thing: the mirror is
	/// registered as DYNAMIC, so `invalidate_dynamic` (which
	/// `invalidate_on_reconnect` runs) can point it at nothing when the
	/// connection is replaced. A reconnect mints a fresh server session; the
	/// generated mirrors are rebound positionally from the fresh `__attach`
	/// reply, and this one cannot be, because the fresh session never minted
	/// it and no protocol form exists yet to ask for it again (A39). Register
	/// the invalidation with `invalidate_on_reconnect(socket, client)` — a
	/// hand-wired client's one line — or the mirror survives the reconnect
	/// holding a stale value on a channel id the fresh session may since have
	/// minted for something else.
	fun source<T: Wire>(self, channel: i32): RemoteSource<T> {
		let mirror: RemoteSource<T> = self.attached_source(channel);
		let cell = mirror.channel;
		let cache = mirror.cache;
		self.dynamic.write().push(|| {
			// A channel no session ever mints (`fresh_channel` counts from 0),
			// so the route stops matching instead of being re-matched by a
			// fresh session's reuse of the id.
			cell.write() = 0 - 1;
			cache.set(None);
		});
		mirror
	}

	/// A remote handle for a channel a REPLY named — what the generated stub
	/// of an `[rpc]` method returning a source mints (`transport-rpc.md`
	/// §9.2). `attached_source` plus the two things that make a dynamic handle
	/// a first-class one:
	///
	/// - the `origin`: the call that minted it, so demand returning after the
	///   server withdrew the channel (R3, point 3) and a reconnect
	///   (`reattach_mirrors`) can both ask for a fresh one;
	/// - the OWNER hook (R3, point 4): minted under an ambient owner, a mirror
	///   nothing ever leases still releases when that owner disposes. Read
	///   owner-optionally — with no owner the mirror lives with the
	///   connection, which is documented, not refused.
	///
	/// It is registered for REPLAY rather than for invalidation: a reconnect
	/// re-issues its call instead of pointing it at nothing, which is what
	/// retires `invalidate_dynamic` for every mirror a generated client holds.
	fun minted_source<T: Wire>(self, channel: i32, origin: Origin): RemoteSource<T> {
		let mirror: RemoteSource<T> = self.mirror_of(channel, Some(origin));
		// Only a WATCHED mirror is replayed: an unwatched one costs a call it
		// does not need, and its next lease re-mints anyway (`acquire`).
		self.replays.write().push(|| {
			if mirror.count.read() > 0 {
				mirror.remint();
			}
		});
		defer_to_owner(|| mirror.release_unleased());
		mirror
	}

	/// Re-issue every WATCHED minted mirror's origin call and rebind it — the
	/// reconnect half of §9.2, run by `reattach_mirrors` after the contract
	/// re-verify and the positional `__attach` rebind, so the fresh session
	/// exists before any of these calls reaches it.
	fun replay_dynamic(self) {
		for replay in self.replays.read() {
			replay();
		}
	}

	/// A remote handle for a channel this connection's `__attach` reply named:
	/// a typed local mirror (`SignalCell<Option<T>>`, `None` until the first
	/// update lands) kept in sync by inbound `Update` frames, wrapped as a
	/// `RemoteSource<T>` whose `sub` also opens the channel. What the generated
	/// `connect` mints, and what `reattach_mirrors` rebinds positionally after
	/// a reconnect.
	fun attached_source<T: Wire>(self, channel: i32): RemoteSource<T> {
		self.mirror_of(channel, None)
	}

	/// `attached_source`'s body, with the minting call as a parameter — the
	/// one construction site for a plain mirror, so a field mirror and a
	/// minted one can never drift in anything but the origin they carry.
	fun mirror_of<T: Wire>(self, channel: i32, origin: Option<Origin>): RemoteSource<T> {
		let cache: SignalCell<Option<T>> = SignalCell::new(None);
		let codec = self.codec;
		// Deliver one routed `Update`: re-open the frame (the envelope was only
		// routed, not consumed) and rebuild the payload at this channel's type.
		// A malformed update is dropped — the mirror keeps its last good value.
		let deliver = |frame: Frame| {
			let deserializer = (codec.reader)(frame);
			let tag = (deserializer.variant_tag)();
			(deserializer.begin_variant)(tag, 2);
			let _channel = (deserializer.i32_value)();
			let value: T = T::rebuild(deserializer);
			match (deserializer.failed)() {
				Some(let _reason) => {},
				None => cache.set(Some(value)),
			}
		};
		let channel_cell = Shared::new(channel);
		self.routes.write().push((channel_cell, deliver));
		RemoteSource {
			channel = channel_cell,
			subscribe = Shared::new(encode_control(self.codec, "Subscribe", channel)),
			count = Shared::new(0),
			closing = Shared::new(false),
			settle_id = fresh_id(),
			codec = self.codec,
			transport = self.transport,
			cache,
			origin,
			released = Shared::new(false),
			leased = Shared::new(false),
		}
	}

	/// A remote handle for a KEYED channel this connection's `__attach` reply
	/// named: one local list mirror per channel, patched element by element, and
	/// per-key demand on top of it. What `[expose(keyed)]`'s generated `connect`
	/// mints (A39).
	fun attached_keyed_source<K: Wire + Hashable, T: Wire + Keyed<K>>(
		self,
		channel: i32,
	): KeyedSource<K, T> {
		let channel_cell = Shared::new(channel);
		let cache: SignalCell<Option<List<T>>> = SignalCell::new(None);
		let fault: SignalCell<Option<str>> = SignalCell::new(None);
		let mirror: KeyedSource<K, T> = KeyedSource {
			channel = channel_cell,
			codec = self.codec,
			transport = self.transport,
			cache,
			fault,
			count = Shared::new(0),
			closing = Shared::new(false),
			settle_id = fresh_id(),
			leases = Shared::new([]),
		};
		let codec = self.codec;
		// Deliver one routed `Patch`: re-open the frame (the envelope was only
		// routed, not consumed) and rebuild the ops at this channel's key and
		// element types. A malformed patch is dropped whole — a half-applied
		// one would desync the mirror for good.
		let deliver = |frame: Frame| {
			let deserializer = (codec.reader)(frame);
			let tag = (deserializer.variant_tag)();
			(deserializer.begin_variant)(tag, 2);
			let _channel = (deserializer.i32_value)();
			let length = (deserializer.begin_list)();
			mut ops: List<Delta<K, T>> = [];
			mut index = 0;
			for index < length {
				ops.push(Delta<K, T>::rebuild(deserializer));
				index += 1;
			}
			(deserializer.end_list)();
			match (deserializer.failed)() {
				Some(let _reason) => {},
				None => mirror.apply(ops),
			}
		};
		self.routes.write().push((channel_cell, deliver));
		mirror
	}

	/// `attached_keyed_source` for a channel id the APP learned at runtime —
	/// registered as DYNAMIC exactly like `source`, so `invalidate_dynamic`
	/// points it at nothing when the connection is replaced.
	fun keyed_source<K: Wire + Hashable, T: Wire + Keyed<K>>(
		self,
		channel: i32,
	): KeyedSource<K, T> {
		let mirror: KeyedSource<K, T> = self.attached_keyed_source(channel);
		let cell = mirror.channel;
		let cache = mirror.cache;
		self.dynamic.write().push(|| {
			cell.write() = 0 - 1;
			cache.set(None);
		});
		mirror
	}

	/// Point every ORIGIN-LESS dynamic mirror at nothing: its cache goes back
	/// to `None` (so `status` reads `Waiting` again — the truth, since the
	/// fresh session holds no such channel) and its route stops matching any
	/// id a session can mint. Run on reconnect by `invalidate_on_reconnect`.
	///
	/// The app's recovery is to re-run whatever rpc minted the channel and
	/// mint a fresh mirror from the id it returns.
	///
	/// RETIRED for generated mirrors (§9.2): a mirror an `[rpc]` stub minted
	/// carries its `origin` — the call and its arguments — so `reattach_mirrors`
	/// re-issues it and rebinds, and none of those mirrors is registered here.
	/// What is left is the hand-wired shape, `ReactiveClient::source(channel)`,
	/// where std genuinely never saw the call that produced the id.
	fun invalidate_dynamic(self) {
		for invalidate in self.dynamic.read() {
			invalidate();
		}
		self.dynamic.write() = [];
	}

	/// One inbound frame: an `Update` or a `Patch` fans out to its channel's
	/// deliverers (each re-opens the frame at its own type); anything else is
	/// ignored.
	fun receive(self, frame: Frame) {
		let deserializer = (self.codec.reader)(frame);
		let tag = (deserializer.variant_tag)();
		(deserializer.begin_variant)(tag, 2);
		let channel = (deserializer.i32_value)();
		// `Update` feeds a plain mirror, `Patch` a keyed one; both are routed by
		// channel alone, and a channel is one or the other for its whole life.
		if tag == "Update" || tag == "Patch" {
			match (deserializer.failed)() {
				Some(let _reason) => {},
				None => {
					for route in self.routes.read() {
						let (id, deliver) = route;
						if id.read() == channel {
							deliver(frame);
						}
					}
				},
			}
		}
	}
}

impl ReactiveClient with Disposable {
	/// Tear the client half down — `ReactiveServer::dispose`'s mirror (A29).
	/// `new` installs an inbound handler capturing the whole client, so without
	/// this the transport holds the client, its routes and every mirror cache
	/// for as long as the transport lives; the measured cycle is client →
	/// transport → handler → client, and one line cuts it. Clearing `routes`
	/// releases the mirrors themselves.
	///
	/// std calls this on ONE path (`close_for_good`, backlog A30/A31): a
	/// connection that reaches the terminal `Closed` — for ANY of the three
	/// reasons — disposes the client holding its mirrors, which can never be
	/// rebound once the state is terminal. Everything else is the host's —
	/// a test, an HMR teardown, a reconnect that builds a fresh client — which is
	/// why it stays public. A browser app's `ReactiveClient` is otherwise one per
	/// connection and lives as long as the tab, which is why A29 measured the
	/// SERVER half (one session per connection, churned per disconnect) as the
	/// leak that costs.
	///
	/// IDEMPOTENT: both lines assign an empty, so disposing an
	/// already-disposed client — an app that tore its own down before the socket
	/// closed for good — is a no-op rather than a fault.
	fun dispose(self) {
		(self.transport).clear_on_frame();
		self.routes.write() = [];
		self.dynamic.write() = [];
	}
}

/// What is locally KNOWN about a mirror (`RemoteSource::status`): whether a
/// value has arrived. Derived from the cache alone — so an UNWATCHED mirror
/// reads `Waiting` forever, correctly: nothing opened its channel.
[derive(PartialEq, Debug)]
enum Status {
	/// Nothing has arrived yet. This is what an unwatched mirror reads, for
	/// as long as it stays unwatched — `status` reports, it does not ask.
	Waiting,
	/// The cache holds a value.
	Ready,
}

/// A remote read-only handle, typed end to end: the local mirror holds
/// `Option<T>` — `None` until the first update arrives, the typed replacement
/// for the old `""` sentinel — `sub` opens the channel (a pre-encoded
/// `Subscribe`) and delivers each decoded value, and `get` samples the mirror.
/// The write half stays on the server: this is the reactive split — client
/// code can't write a server signal. Over an in-process transport the server's
/// immediate current-value `Update` lands synchronously, so the observer fires
/// at once with the present state; over a real wire it fires when that update
/// arrives.
///
/// Subscription follows demand exactly (`proposal/remote-sources.md`): every
/// observing path takes a COUNTED lease, the 0→1 transition sends `Subscribe`,
/// the 1→0 transition sends `Unsubscribe` — so the channel is open while, and
/// only while, something is watching. `get` is passive: no lease, no frame.
/// The call that minted a mirror (`transport-rpc.md` §9.2) — the method name
/// and the argument describers, which is exactly the pair `call` takes, plus
/// the seam that re-issues it over the transport the mirror was minted from.
///
/// This is what makes a dynamic handle REBINDABLE, and it is why §9.2 needs no
/// `Release` frame and no arena of its own. A channel id belongs to one
/// connection and one demand; an origin belongs to the mirror, survives both,
/// and can ask for a fresh channel whenever one is needed — after a lease
/// returned (R3, point 3) or after a reconnect replaced the session
/// (`reattach_mirrors`).
///
/// A `[expose]` field mirror has none: it is minted positionally by `__attach`
/// and rebound the same way (A41), and re-issuing a call for it would be a
/// second mechanism for a thing that already has one.
struct Origin {
	/// The `[rpc]` method that minted the channel — the name `call` routes on,
	/// kept as data because a replay is a call and a caller must be able to
	/// see which one.
	method: str,
	/// The arguments, as the describers `call` takes. Held rather than
	/// re-derived: the values they close over are the ones the author passed,
	/// and re-running the method with anything else would be a different
	/// question.
	describers: List<|Serializer| void>,
	/// Issue that call again and answer the fresh channel id. Closed over the
	/// generated client's transport and codec at the mint, which is the only
	/// place both are in hand — `RemoteSource` holds the reactive duplex, not
	/// the rpc transport, and is generic over its element alone.
	reissue: async |str, List<|Serializer| void>| Result<i32, RpcError>,
}

struct RemoteSource<T> {
	// Cells, not plain fields: a reconnect rebind points the mirror at the
	// fresh connection's channel (the id cell is SHARED with the
	// `ReactiveClient` route, so routing moves in the same write).
	channel: Shared<i32>,
	// The channel's `Subscribe` frame — re-encoded on rebind.
	subscribe: Shared<Frame>,
	// Live demand: how many leases are outstanding. A cell, so every copy of
	// the handle counts into the same total; a rebind re-subscribes only a
	// mirror that is actually watched (`count > 0`).
	count: Shared<i32>,
	// A 1→0 that has not yet been flushed as an `Unsubscribe`. Cancelled by
	// a 0→1 in the same turn: the channel never actually closed.
	closing: Shared<bool>,
	// The id under which the deferred close rides the turn queue
	// (`at_settle` dedups by it), fixed for the mirror's lifetime.
	settle_id: i32,
	// The wiring-time codec — the `Unsubscribe` is encoded at flush time
	// against the channel the mirror holds THEN (a rebind may have moved it).
	codec: Codec,
	transport: DuplexEnd,
	cache: SignalCell<Option<T>>,
	// The call that minted this mirror, for one a REPLY handed out (§9.2).
	// `None` for a `[expose]` field mirror and for a hand-wired one
	// (`ReactiveClient::source`) — the two shapes that have no call to
	// re-issue. Everything R3 does differently for a dynamic mirror is
	// decided by this field being present.
	origin: Option<Origin>,
	// Whether the server has WITHDRAWN this mirror's channel: the
	// `Unsubscribe` this mirror last sent REVOKED it, because the channel was
	// dynamic (R3, point 2). The next 0→1 therefore cannot re-`Subscribe` on
	// the same id — there is nothing there — and re-mints instead.
	released: Shared<bool>,
	// Whether this mirror has ever held a lease. The owner hook (R3, point 4)
	// reads it: a mirror that never reached one has nothing to tell the
	// server at its last release, so its OWNER's disposal is the only event
	// that can free the capability it minted.
	leased: Shared<bool>,
}

/// A mirror IS a `Source` (tracker A52) — at `Option<T>`, which is what it
/// holds: `None` until the first frame lands, the value after. Until this impl
/// existed `RemoteSource` carried `get`/`map`/`or` as inherent members and
/// implemented nothing, so A49's `on_change` was not on it, `effect` was not on
/// it, and no generic `S: Source<..>` function — `selector`, an application's
/// own — could take one. Every observing path still goes through the same
/// counted lease; the impl adds no second mechanism, it names the one there is.
///
/// The trait argument is `Option<T>` and not `T` because the mirror's value is
/// the Option: `get` cannot invent a `T` before the first frame. So a
/// `RemoteSource<List<Note>>` is a `Source<Option<List<Note>>>` and does NOT
/// satisfy `bind_each`'s `Source<List<T>>` — the seam into a list binding is
/// still `or([])`, exactly as `guide/services.md` writes it. What the impl
/// buys is everything that reads a source WITHOUT flattening it: `on_change`,
/// `effect`, `effect_on_change`, and any generic consumer.
impl RemoteSource<type T> with Source<Option<T>> {
	/// The mirror's current value: `None` until the first update lands.
	/// Passive — no lease, no frame; an unwatched mirror reads `None`
	/// forever, which is correct: nothing asked.
	fun get(self): Option<T> {
		self.cache.get()
	}

	/// The trait's subscription primitive, counted like every other observing
	/// path: attach WITHOUT the immediate call, and hold the channel open until
	/// the subscription is disposed.
	///
	/// ORDER is the whole content of this body, and it is forced rather than
	/// chosen: attach FIRST, then take the lease. Taking the lease is what
	/// sends `Subscribe`, and over an in-process transport the server's seeding
	/// `Update` comes back INSIDE that call — so acquiring first would drop the
	/// first value on a `duplex_pair` and deliver it over a socket, which is a
	/// transport-dependent contract and not one at all. Attached first, the
	/// seed is a change from the `None` the mirror held when the observer was
	/// registered, on every transport. Nothing is swallowed: `on_change`'s
	/// contract is "never for the value the source ALREADY holds", and an
	/// unopened mirror already holds `None`.
	[must_use]
	fun on_change(self, observer: |Option<T>| void): Subscription {
		let subscription = self.cache.on_change(observer);
		subscription.release.write() = Some(|| self.release());
		self.acquire();
		subscription
	}

	/// The trait's `sub` default, OVERRIDDEN — because the default is
	/// `on_change` plus one call with `get()`, and on a mirror `on_change`
	/// itself delivers the seeding frame, so the default would make the
	/// immediate call TWICE. `lease` is the honest eager form: take the lease,
	/// then attach with `SignalCell::sub`, whose one immediate call is the
	/// contract's.
	[must_use]
	fun sub(self, observer: |Option<T>| void): Subscription {
		self.lease(observer)
	}

	/// `effect` for the same reason as `sub`, and by the same body plus the
	/// ambient owner: the trait's default is `effect_on_change` and one call,
	/// and `effect_on_change` is `on_change`, which already made it.
	fun effect(self, observer: |Option<T>| void) {
		get_owner().take(self.lease(observer));
	}

	/// Observe the mirror through `transform`, as a plain `SignalCell<U>` — the
	/// one seam into the ordinary reactive world (`bind_each`, `bind_text`,
	/// `{…}` embedding all take a `Signal`). COUNTED: this is a subscription —
	/// it opens the channel if nothing else has, and the lease is released when
	/// the enclosing owner is disposed, which for a view is unmount. So it
	/// requires an ambient owner, STATICALLY (`get_owner`, not the trait
	/// default's `register_with_owner`): calling it where no `owner_scope.run`
	/// encloses is a compile error, which makes "a network subscription must
	/// have an owner" a compile-time law (A25). The trait's default is
	/// deliberately owner-OPTIONAL, because `current_path().map(parse)` at
	/// module level is a documented idiom and a network subscription at module
	/// level is not one.
	///
	/// An OVERRIDE of the trait's `map`, which is what makes the strict law
	/// reach a generic `S: Source<Option<T>>` too and not merely a concrete
	/// `mirror.map(..)`. It was inherent until B258: overriding a default that
	/// the receiver's own field type inherits used to promote `status`'s own
	/// `self.cache.map(..)` — a call on a `SignalCell` field, which inherits
	/// the OWNER-OPTIONAL default — to this strict body's flavor, and
	/// `register_with_owner` ran with an undefined owner.
	///
	/// `transform` sees `None` until the first frame lands — the one place the
	/// `Option` is confronted, and where a fallback of a DIFFERENT type than
	/// `T` belongs (`"Loading…"` from a `RemoteSource<i32>`).
	fun map<U>(self, transform: sync |Option<T>| U): SignalCell<U> {
		let derived = SignalCell::new(transform(self.get()));
		get_owner().take(self.lease(|value| {
			derived.set(transform(value));
		}));
		derived
	}
}

impl RemoteSource<type T> {
	/// `map` for the same-type case: `initial` until the first frame, the
	/// mirrored value after. Counted and owner-released exactly like `map`,
	/// because it IS `map` — `client.notes.or([])` inside a view replaces the
	/// hand-built `SignalCell::new([])` + never-disposed `sub` pair, and the
	/// subscription now dies with the view instead of with the tab.
	fun or(self, initial: T): SignalCell<T> {
		self.map(|value| match value {
			Some(let present) => present,
			None => initial,
		})
	}

	/// What is locally KNOWN about this mirror, as a `SignalCell<Status>`.
	/// Passive: opens no channel, takes no lease, needs no owner — derived
	/// from the cache alone, so it is callable at the top of `main` where
	/// `map` is not. The honest sentence: a `status` observer ALONE never
	/// sees `Waiting → Ready`. `status` reports; it does not ask. If nothing
	/// else is subscribed, the mirror stays `Waiting` forever, and that is
	/// correct — the channel was never opened. Any path that renders the value
	/// when it arrives (`sub`, `map`, `or`) subscribes; the count is what
	/// makes that harmless.
	fun status(self): SignalCell<Status> {
		self.cache.map(|value| match value {
			Some(let _present) => Status::Ready,
			None => Status::Waiting,
		})
	}

	/// Observe each value as it lands, present values only (the `None` before
	/// the first frame is skipped). COUNTED: this lease opens the channel if
	/// nothing else holds one, and disposing the returned `Subscription`
	/// releases it — the last release closes the channel (an `Unsubscribe`,
	/// deferred to the ambient turn's settle so a same-turn re-subscribe
	/// cancels it; with no ambient turn, sent at once).
	///
	/// INHERENT, and it outranks the trait's `sub` on a concrete receiver — the
	/// two are told apart by the observer's own parameter type and cannot be
	/// confused for one another: this one takes `|T|`, `Source::sub` takes
	/// `|Option<T>|` and makes the immediate call with whatever the mirror
	/// holds. A generic `S: Source<Option<T>>` reaches that one; `mirror.sub`
	/// reaches this one, which is the shape every caller was written against
	/// and the one a view wants (a `None` is not a value to render).
	[must_use]
	fun sub(self, observer: |T| void): Subscription {
		self.lease(|value| {
			match value {
				Some(let present) => observer(present),
				None => {},
			}
		})
	}

	/// The one counted primitive under every observing path: subscribe
	/// `observer` to the cache (it fires at once with the current value, `None`
	/// included) and hold a lease on the channel until the subscription is
	/// disposed. One count, one place the frames are decided.
	fun lease(self, observer: |Option<T>| void): Subscription {
		self.acquire();
		let subscription = self.cache.sub(observer);
		subscription.release.write() = Some(|| self.release());
		subscription
	}

	/// Take a lease. 0→1 with no close pending sends `Subscribe` — eagerly,
	/// not at settle: the server's immediate current-value `Update` is how the
	/// mirror seeds, and deferring it would cost every first paint a turn. 0→1
	/// with a close pending sends nothing and cancels the close: the channel is
	/// still open server-side, so a dispose-and-rebuild inside one turn (a
	/// `bind_each` row refreshing) churns no frames at all.
	///
	/// The third case is R3's (point 3): a DYNAMIC mirror whose channel the
	/// server already withdrew. There is no id to re-`Subscribe` on, so the
	/// mirror asks its `origin` for a fresh one. `acquire` stays SYNC — every
	/// observing path calls it, and `Source::sub` is not async — so the
	/// re-issue is a free-floating spawn and the rebind settles when the reply
	/// lands. The cached last value stays as the seed meanwhile: it is what
	/// the mirror was last told, and painting it beats painting `Waiting` for
	/// a round trip.
	fun acquire(self) {
		let before = self.count.read();
		self.count.write() = before + 1;
		self.leased.write() = true;
		if before == 0 {
			if self.closing.read() {
				self.closing.write() = false;
			} else if self.released.read() {
				self.remint();
			} else {
				(self.transport).send(self.subscribe.read());
			}
		}
	}

	/// Re-issue the call that minted this mirror and rebind onto the channel
	/// the fresh reply names (R3, point 3; `reattach_mirrors` calls it for the
	/// reconnect half). A mirror with no origin cannot: it stays pointed at
	/// the withdrawn channel, which is the truth about it.
	fun remint(self) {
		match self.origin {
			None => {},
			Some(let origin) => {
				// Cleared BEFORE the round trip, so a second lease taken while
				// it is in flight does not issue a second call; the rebind
				// below re-subscribes for whatever demand exists by then.
				self.released.write() = false;
				let _reminting = async {
					let fresh: Result<i32, RpcError> = (origin.reissue)(origin.method, origin.describers);
					match fresh {
						// Unreachable: the socket is already dying and the
						// reconnect path re-issues this same origin. Marked
						// released again so a later lease tries once more.
						Err(let _unreachable) => {
							self.released.write() = true;
						},
						Ok(let channel) => self.rebind(channel, encode_control(self.codec, "Subscribe", channel)),
					}
				};
			},
		}
	}

	/// The owner hook (R3, point 4). A dynamic mirror that a call handed out
	/// and NOTHING ever leased still holds a server capability — the lease
	/// machinery never ran, so no `Unsubscribe` is owed and none would be
	/// sent. When such a mirror was minted inside an owner scope, that owner's
	/// disposal is the honest end of its life, and this is what it sends.
	///
	/// Owner-OPTIONAL by design (`defer_to_owner`, the `register_with_owner`
	/// shape): a mirror minted with no ambient owner lives with the
	/// connection, which frees every channel it ever minted in one act
	/// (`drop_session`). That is documented rather than refused — a handle
	/// fetched at the top of `main` is a real shape, and it is not a leak.
	fun release_unleased(self) {
		if !self.leased.read() && !self.released.read() {
			self.released.write() = true;
			(self.transport).send(encode_control(self.codec, "Unsubscribe", self.channel.read()));
		}
	}

	/// Release a lease. 1→0 marks the mirror closing and defers the
	/// `Unsubscribe` to the ambient turn's settle (`at_settle`); a 0→1 before
	/// then cancels it. The `Unsubscribe` is pure economy, so it can afford to
	/// wait — and waiting is what makes the common re-render free.
	fun release(self) {
		let after = self.count.read() - 1;
		self.count.write() = after;
		if after == 0 {
			self.closing.write() = true;
			at_settle(self.settle_id, || self.flush_close());
		}
	}

	/// The deferred half of `release`, and R3's point 1: the turn's settle is
	/// the FIRST look at whether the close is still owed, and one microtask hop
	/// is the SECOND. A dispose in one turn and a mount in another — two event
	/// handlers, a route change, a `bind_each` rebuilding rows across turns —
	/// is one MACROTASK, and the hop is what makes that whole macrotask free:
	/// the re-`acquire` clears `closing`, and the second look sends nothing.
	///
	/// The hop is the MIRROR's, not `at_settle`'s: deferring every settled
	/// action by a microtask would change the turn model for everyone, and the
	/// thing that can afford to wait is this one frame. `Unsubscribe` is pure
	/// economy — the channel stays correct while it is late — which is exactly
	/// what lets it wait, and it is why the same hop would be wrong for
	/// `Subscribe` (a first paint would pay for it).
	///
	/// And it is the DYNAMIC mirror's, not every mirror's — the one place this
	/// narrows R3 as written, and the reason is what the hop BUYS on each kind
	/// of channel. A dynamic channel is REVOKED by its `Unsubscribe` (R3,
	/// point 2), so a spurious one costs a whole re-mint round trip: a call, a
	/// fresh capability, a `Subscribe` and a seed. A `[expose]`d field
	/// channel's `Unsubscribe` only stops a forward that the same id restarts,
	/// so the hop buys it nothing — and it would cost it the promptness
	/// `proposal/remote-sources.md` §2 ratified and four A25 pins record: with
	/// no ambient turn the close goes NOW, so a write after the last dispose
	/// puts nothing on the wire at all. Under a hop that write costs one late
	/// `Update` the mirror will discard.
	fun flush_close(self) {
		if self.closing.read() {
			match self.origin {
				Some(let _minting) => queue_microtask(|| self.close_now()),
				None => self.close_now(),
			}
		}
	}

	/// The second look: still closing, so the close is real. A dynamic channel
	/// is REVOKED by this frame (R3, point 2), so the mirror records that its
	/// id is gone and the next lease re-mints (`acquire`).
	fun close_now(self) {
		if self.closing.read() {
			self.closing.write() = false;
			(self.transport).send(encode_control(self.codec, "Unsubscribe", self.channel.read()));
			match self.origin {
				Some(let _minting) => {
					self.released.write() = true;
				},
				None => {},
			}
		}
	}

	/// Point the mirror at a fresh channel after a reconnect
	/// (proposal/transport-robustness.md §2.5) and, when watched, re-subscribe
	/// — the server's immediate current-value `Update` resyncs the cache. The
	/// count is client-local demand, so it never moves; a pending close is
	/// dropped, because it names the OLD channel on a dead connection
	/// (flushed after the rebind it would be a no-op on a closed socket at
	/// best, and at worst name an id the fresh session has since minted for
	/// something else).
	fun rebind(self, channel: i32, subscribe: Frame) {
		self.channel.write() = channel;
		self.subscribe.write() = subscribe;
		self.closing.write() = false;
		// The fresh channel is live, whatever became of the old one — a
		// withdrawn dynamic id (R3) or a whole dead session.
		self.released.write() = false;
		if self.count.read() > 0 {
			(self.transport).send(subscribe);
		}
	}
}

// --- Client side: the keyed mirror (A39) ------------------------------------

/// One key's demand on a keyed mirror — `RemoteSource`'s count, closing cell
/// and settle id, once per key. The `describe` closure is the key itself, held
/// so the `Unsubscribe` (and a reconnect's re-`Subscribe`) can name it again at
/// its own type.
struct KeyLease {
	key: Hash,
	describe: |Serializer| void,
	count: Shared<i32>,
	closing: Shared<bool>,
	settle_id: i32,
	/// Whether this key is currently subscribed ON THE WIRE. Demand and wire
	/// state part company here, and only here: whole-collection demand
	/// SUBSUMES per-key demand (the channel is already forwarding every key),
	/// so a key held while the whole collection is held asks for nothing.
	on_wire: Shared<bool>,
}

/// The client half of a KEYED channel: a local list mirror patched by
/// element-grained deltas, with demand expressed per key.
///
/// ONE mirror per channel, holding exactly what this client asked for. A
/// whole-collection lease (`sub`, `map`, `or`) seeds it with a `Reset` and
/// tracks every change; a per-key lease (`sub_key`, `of`) adds one element to
/// it and tracks only that element. The two compose: a view showing a channel's
/// index plus the three messages on screen holds one whole-collection lease and
/// three key leases, and the server forwards each independently.
///
/// The counted-lease rule is `RemoteSource`'s, per demand rather than per
/// channel: 0→1 sends `Subscribe`, 1→0 defers an `Unsubscribe` to the turn's
/// settle so a re-render churns no frames.
struct KeyedSource<K, T> {
	// A cell, shared with the `ReactiveClient` route, so a reconnect rebind
	// moves routing and demand in one write.
	channel: Shared<i32>,
	codec: Codec,
	transport: DuplexEnd,
	/// The elements this client is subscribed to, in the server's order —
	/// `None` until the first patch lands (the typed `Waiting`).
	cache: SignalCell<Option<List<T>>>,
	/// The first protocol fault this mirror saw: an op naming a key it does not
	/// hold. STICKY — the first one is kept, because everything after it is a
	/// consequence rather than a second fact.
	fault: SignalCell<Option<str>>,
	/// Whole-collection demand.
	count: Shared<i32>,
	closing: Shared<bool>,
	settle_id: i32,
	/// Per-key demand — one entry per key ever leased on this mirror.
	leases: Shared<List<KeyLease>>,
}

impl KeyedSource<type K: Wire + Hashable, type T: Wire + Keyed<K>> {
	/// The mirror's current contents: `None` until the first patch lands.
	/// Passive — no lease, no frame.
	fun get(self): Option<List<T>> {
		self.cache.get()
	}

	/// What is locally KNOWN about this mirror, as a `SignalCell<Status>` —
	/// `RemoteSource::status`'s sentence, unchanged: it reports, it does not
	/// ask.
	fun status(self): SignalCell<Status> {
		self.cache.map(|value| match value {
			Some(let _present) => Status::Ready,
			None => Status::Waiting,
		})
	}

	/// The first protocol fault this mirror saw, if any: an `Update` or
	/// `Remove` naming a key it does not hold. That is a SERVER bug or a lost
	/// frame, never something an application can cause, so it is reported here
	/// rather than thrown — and the offending op is not applied, so the mirror
	/// keeps the last state it could account for.
	fun fault(self): Option<str> {
		self.fault.get()
	}

	/// Observe the whole collection as it changes. COUNTED: the lease opens the
	/// channel's whole-collection forward if nothing else holds it, and
	/// disposing the subscription releases it.
	[must_use]
	fun sub(self, observer: |List<T>| void): Subscription {
		self.lease(|value| match value {
			Some(let present) => observer(present),
			None => {},
		})
	}

	/// The counted primitive under every whole-collection path.
	fun lease(self, observer: |Option<List<T>>| void): Subscription {
		self.acquire();
		let subscription = self.cache.sub(observer);
		subscription.release.write() = Some(|| self.release());
		subscription
	}

	/// Observe through `transform`, as a plain `SignalCell<U>` — the seam into
	/// the ordinary reactive world. Counted and owner-released exactly like
	/// `RemoteSource::map`, and with the same static requirement: an enclosing
	/// `owner_scope.run`.
	fun map<U>(self, transform: sync |Option<List<T>>| U): SignalCell<U> {
		let derived = SignalCell::new(transform(self.get()));
		get_owner().take(self.lease(|value| {
			derived.set(transform(value));
		}));
		derived
	}

	/// `map` for the same-type case: `initial` until the first patch.
	fun or(self, initial: List<T>): SignalCell<List<T>> {
		self.map(|value| match value {
			Some(let present) => present,
			None => initial,
		})
	}

	/// Observe ONE key. COUNTED per key: the 0→1 sends `Subscribe(channel,
	/// Some(key))` and the server starts forwarding that key's changes and
	/// nothing else; the 1→0 releases the key alone, leaving every other lease
	/// on the channel running.
	///
	/// The observer sees `None` while the key is absent from the mirror — before
	/// the seed arrives, and after a `Remove`.
	[must_use]
	fun sub_key(self, key: K, observer: |Option<T>| void): Subscription {
		let lease = self.lease_for(key);
		self.acquire_key(lease);
		let wanted = key.hash();
		let subscription = self.cache.sub(|value| observer(self.pick(value, wanted)));
		subscription.release.write() = Some(|| self.release_key(lease));
		subscription
	}

	/// `sub_key` as a `SignalCell`, owner-released — the view seam, and the one
	/// line a row component writes: `messages.of(id)`.
	fun of(self, key: K): SignalCell<Option<T>> {
		let wanted = key.hash();
		let derived: SignalCell<Option<T>> = SignalCell::new(self.pick(self.get(), wanted));
		get_owner().take(self.sub_key(key, |value| derived.set(value)));
		derived
	}

	/// The lease record for a key, minted on first use and kept: a key leased,
	/// released and leased again counts into the same cells, exactly as two
	/// copies of a `RemoteSource` handle do.
	fun lease_for(self, key: K): KeyLease {
		let wanted = key.hash();
		for lease in self.leases.read() {
			if lease.key.eq(wanted) {
				ret lease;
			}
		}
		let fresh = KeyLease {
			key = wanted,
			describe = |serializer: Serializer| key.describe(serializer),
			count = Shared::new(0),
			closing = Shared::new(false),
			settle_id = fresh_id(),
			on_wire = Shared::new(false),
		};
		self.leases.write().push(fresh);
		fresh
	}

	/// Take the whole-collection lease. 0→1 with no close pending subscribes —
	/// and releases every per-key subscription, because the whole-collection
	/// forward already carries those keys and a second forward for one of them
	/// would deliver its ops twice (a duplicate `Remove` would even read as a
	/// protocol fault). The whole forward seeds with a `Reset`, so nothing is
	/// lost in the swap.
	fun acquire(self) {
		let before = self.count.read();
		self.count.write() = before + 1;
		if before == 0 {
			if self.closing.read() {
				self.closing.write() = false;
			} else {
				(self.transport).send(encode_control(self.codec, "Subscribe", self.channel.read()));
			}
			for lease in self.leases.read() {
				if lease.on_wire.read() {
					lease.on_wire.write() = false;
					(self.transport).send(encode_control_keyed(self.codec, "Unsubscribe", self.channel.read(), lease.describe));
				}
			}
		}
	}

	/// Release the whole-collection lease; the `Unsubscribe` rides the settle.
	fun release(self) {
		let after = self.count.read() - 1;
		self.count.write() = after;
		if after == 0 {
			self.closing.write() = true;
			at_settle(self.settle_id, || self.flush_close());
		}
	}

	/// The deferred half of `release`. Whatever per-key demand outlives the
	/// whole-collection lease takes the wire back: the mirror is emptied first
	/// (it holds a whole collection it is about to stop being told about) and
	/// each key's forward re-seeds it with an `Insert`.
	fun flush_close(self) {
		if self.closing.read() {
			self.closing.write() = false;
			(self.transport).send(encode_control(self.codec, "Unsubscribe", self.channel.read()));
			mut resumed = false;
			for lease in self.leases.read() {
				if lease.count.read() > 0 && !lease.on_wire.read() {
					resumed = true;
				}
			}
			if resumed {
				self.cache.set(Some([]));
			}
			for lease in self.leases.read() {
				if lease.count.read() > 0 && !lease.on_wire.read() {
					lease.on_wire.write() = true;
					(self.transport).send(encode_control_keyed(self.codec, "Subscribe", self.channel.read(), lease.describe));
				}
			}
		}
	}

	/// Take one key's lease — the same four-line rule, per key, with the
	/// subsumption above: while the whole collection is held, the key is
	/// already arriving and nothing goes on the wire.
	fun acquire_key(self, lease: KeyLease) {
		let before = lease.count.read();
		lease.count.write() = before + 1;
		if before == 0 {
			if lease.closing.read() {
				lease.closing.write() = false;
			} else {
				if self.count.read() == 0 {
					lease.on_wire.write() = true;
					(self.transport).send(encode_control_keyed(self.codec, "Subscribe", self.channel.read(), lease.describe));
				}
			}
		}
	}

	/// Release one key's lease. The deferral is what makes a `bind_each` row
	/// re-rendering inside one turn cost zero frames, per key.
	fun release_key(self, lease: KeyLease) {
		let after = lease.count.read() - 1;
		lease.count.write() = after;
		if after == 0 {
			lease.closing.write() = true;
			at_settle(lease.settle_id, || self.flush_key_close(lease));
		}
	}

	fun flush_key_close(self, lease: KeyLease) {
		if lease.closing.read() {
			lease.closing.write() = false;
			if lease.on_wire.read() {
				lease.on_wire.write() = false;
				(self.transport).send(encode_control_keyed(self.codec, "Unsubscribe", self.channel.read(), lease.describe));
			}
		}
	}

	/// The element under a key hash in the mirror's contents, if it holds one.
	fun pick(self, value: Option<List<T>>, key: Hash): Option<T> {
		match value {
			None => None,
			Some(let list) => {
				for element in list {
					if element.key().hash().eq(key) {
						ret Some(element);
					}
				}
				None
			},
		}
	}

	/// Where `key` sits in the mirror's list, if at all.
	fun index_of(self, list: List<T>, key: K): Option<i32> {
		let wanted = key.hash();
		mut index = 0;
		for element in list {
			if element.key().hash().eq(wanted) {
				ret Some(index);
			}
			index += 1;
		}
		None
	}

	/// Apply one patch's ops IN ORDER (`std::wire`'s `Delta` documents each
	/// arm's semantics). The whole patch lands as one write to the cache, so a
	/// multi-op change is one notification rather than one per op.
	fun apply(self, ops: List<Delta<K, T>>) {
		mut list: List<T> = [];
		match self.cache.get() {
			Some(let held) => list = held,
			None => {},
		}
		mut fault: Option<str> = None;
		for op in ops {
			match op {
				Delta::Reset(let items) => list = items,
				Delta::Insert(let key, let value, let index) => {
					match self.index_of(list, key) {
						// A key already held is REPLACED, not duplicated: that
						// is the re-seed a per-key subscription sends when
						// demand returns to it.
						Some(let at) => list[at] = value,
						None => {
							mut bounded = index;
							if bounded < 0 {
								bounded = 0;
							}
							if bounded > list.len() {
								bounded = list.len();
							}
							list.insert(bounded, value);
						},
					}
				},
				Delta::Update(let key, let value) => {
					match self.index_of(list, key) {
						Some(let at) => list[at] = value,
						None => fault = first_fault(fault, "an Update named a key the mirror does not hold"),
					}
				},
				Delta::Remove(let key) => {
					match self.index_of(list, key) {
						Some(let at) => {
							let _dropped = list.remove(at);
						},
						None => fault = first_fault(fault, "a Remove named a key the mirror does not hold"),
					}
				},
			}
		}
		self.cache.set(Some(list));
		match fault {
			None => {},
			Some(let reason) => match self.fault.get() {
				None => self.fault.set(Some(reason)),
				Some(let _kept) => {},
			},
		}
	}

	/// Point the mirror at a fresh channel after a reconnect and re-subscribe
	/// everything this client still holds: the whole-collection lease if it is
	/// counted, and every key whose lease is. Pending closes are dropped —
	/// they name the OLD channel on a dead connection.
	///
	/// The cache goes back to `None` first, which is where a keyed mirror
	/// differs from a plain one. `RemoteSource::rebind` may keep its last value
	/// because the fresh subscription resends the WHOLE value; a keyed forward
	/// reseeds only what it is asked for, so an element deleted while the
	/// connection was down would otherwise survive as a ghost no later op would
	/// ever name.
	fun rebind(self, channel: i32) {
		self.channel.write() = channel;
		self.cache.set(None);
		self.closing.write() = false;
		if self.count.read() > 0 {
			(self.transport).send(encode_control(self.codec, "Subscribe", channel));
		}
		for lease in self.leases.read() {
			lease.closing.write() = false;
			lease.on_wire.write() = false;
			// Only what the whole-collection lease does not already cover.
			if lease.count.read() > 0 && self.count.read() == 0 {
				lease.on_wire.write() = true;
				(self.transport).send(encode_control_keyed(self.codec, "Subscribe", channel, lease.describe));
			}
		}
	}
}

/// Keep the first fault a patch produced; later ones are its consequences.
fun first_fault(held: Option<str>, reason: str): Option<str> {
	match held {
		Some(let kept) => Some(kept),
		None => Some(reason),
	}
}

/// `connect_socket` with the transport failure mapped into `RpcError` — the
/// generated `connect` opens with `dial_for_service(url)!`. Hand-written here
/// (rather than inline in the expansion) so the conversion types in std's own
/// unit; see backlog B21 for the load-order sensitivity that pushed it out of
/// the template.
///
/// It offers `vilan-rpc` and nothing else (A47). A credential-less `connect`
/// against an authorized service is refused, and a server only sends the
/// typed refusal frame to a client that named this protocol — so without the
/// offer the commonest refusal of all (a client with no credential) would be
/// the one case still indistinguishable from an outage. The offer is exactly
/// what `rpc_protocols(credential)` already puts first, so `connect` and
/// `connect_with` now differ only in the credential.
fun dial_for_service(url: str): Result<SocketDuplex, RpcError> {
	dial_for_service_with(url, [rpc_subprotocol()])
}

/// `dial_for_service`, offering `protocols` on the handshake — what the
/// generated `Client::connect_with(url, codec, protocols)` opens with (A40).
fun dial_for_service_with(url: str, protocols: List<str>): Result<SocketDuplex, RpcError> {
	dial_socket(url, protocols).map_err(|failure: DialFailure| match failure {
		DialFailure::Unreachable(let reason) => RpcError::Transport(reason),
		// 401 and 403 are one arm here because `RpcError` has one (A40 minted
		// `Unauthorized` and nothing since has needed a second): the client's
		// answer to both is the same — this credential will not open this
		// connection — and the server's own status stays in the sentence for a
		// log to carry.
		DialFailure::Refused(let status) => if status == "401" || status == "403" {
			RpcError::Unauthorized
		} else if status == "503" {
			// A52's arm. Distinct from `Unauthorized` because the app's answer
			// differs — a sign-in prompt is the wrong response to a draining
			// node — and distinct from `Transport` because the server ANSWERED:
			// it is not unreachable, it declined.
			RpcError::Unavailable
		} else {
			RpcError::Transport(i"refused by the server ({status})")
		},
	})
}

/// Bind a client's fate to its connection's: when `socket` reaches the terminal
/// `Closed` — on ANY arm — the client holding that socket's mirrors disposes
/// itself, emptying its routes and clearing the inbound handler that captures
/// it (backlog A30's release, made uniform by A31). `Closed` is terminal, so
/// the mirrors on this socket can never be rebound and the graph behind them
/// can never update again; releasing it completes the honest report instead of
/// leaving a wedged client retaining it.
///
/// The generated `connect` registers this once, where the client is born —
/// beside nothing else it must remember, and with no window in which a
/// connection could close unbound. A `ReactiveClient` an app already disposed
/// is unharmed: `dispose` is idempotent (it assigns empties, it does not
/// consume).
fun dispose_on_close(socket: SocketDuplex, client: ReactiveClient) {
	socket.on_terminal.write().push(|| client.dispose());
}

/// Bind a hand-wired client's DYNAMIC mirrors to its connection's fate: when
/// `socket` reconnects, every mirror minted with `ReactiveClient::source` is
/// pointed at nothing (`invalidate_dynamic`).
///
/// A reconnect mints a fresh server session, so every channel id from the
/// previous connection is gone. `reattach_mirrors` rebinds the generated
/// mirrors positionally from the fresh `__attach` reply; a mirror minted from
/// a channel id an rpc returned cannot be rebound that way — the fresh session
/// never minted it, and no protocol form exists yet to ask for it again (A39).
/// Left alone it is silently dead at best, and at worst alive on an id the
/// fresh session has since minted for something else. Invalidating says so:
/// `status` returns to `Waiting`, and the app re-runs the rpc that minted the
/// channel.
///
/// The generated `connect` does not register this, because a generated client
/// has no dynamic mirrors — `ReactiveClient` is not reachable from it. This is
/// for the hand-wired shape (`ReactiveClient::new(bridge(socket), codec)`),
/// where it is one line beside the client's construction.
fun invalidate_on_reconnect(socket: SocketDuplex, client: ReactiveClient) {
	socket.on_reconnect.write().push(|| client.invalidate_dynamic());
}

/// Re-attach a generated client's mirrors after a reconnect (§2.5): re-verify
/// the contract (a REDEPLOYED server with a drifted surface must not feed
/// typed mirrors — the duplex closes for good instead), re-`__attach` under
/// the fresh connection id, and rebind each mirror positionally (the
/// `__attach` reply is ordered by the service's exposed-field order). The
/// generated `connect` pushes one `on_reconnect` hook calling this.
///
/// Either round-trip can fail, and the two failures are NOT the same. An
/// UNREACHABLE server is a delay: the socket is already dying, the next drop
/// cycle redials, and this run leaves the mirrors alone — nothing is disposed,
/// because those mirrors resync on the next successful re-attach. A server that
/// answers and REFUSES — a drifted contract, or an `__attach` it will not
/// honour — is a desync: the mirrors can never be rebound on this connection,
/// so the duplex goes to the terminal `Closed` (`close_for_good`) rather than
/// reporting Connected over the previous connection's dead channel ids.
///
/// Takes no client: the disposal that follows a terminal `Closed` rides the
/// duplex (`dispose_on_close`), so this function decides only WHETHER the
/// connection is over — never what being over costs, which is one treatment
/// for all three arms and none of this function's business (A31).
fun reattach_mirrors(
	socket: SocketDuplex,
	transport: SocketTransport,
	codec: Codec,
	expected_contract: str,
	rebinds: List<|i32, Frame| void>,
	replay: || void,
) {
	let remote: Result<str, RpcError> = call(transport, codec, "__contract", []);
	match remote {
		// Unreachable again already — the next drop cycle handles it, and the
		// mirrors it will resync must still be routed when it does.
		Err(let _unreachable) => {},
		Ok(let hash) => {
			if hash == expected_contract {
				let connection = socket.connection.read();
				let attached: Result<List<i32>, RpcError> = call(transport, codec, "__attach", [
					|serializer: Serializer| connection.describe(serializer),
				]);
				match attached {
					// No fresh channel ids, so there is nothing to rebind to:
					// every mirror would stay pointed at the dead connection's
					// channels while the socket claimed to be live. The same
					// typed desync the drift branch below refuses, only
					// quieter. Close for good; the app restarts on its own
					// terms.
					Err(let _failed) => close_for_good(socket),
					Ok(let channels) => {
						mut index = 0;
						for rebind in rebinds {
							let channel = channels[index];
							rebind(channel, encode_control(codec, "Subscribe", channel));
							index += 1;
						}
						// The DYNAMIC half (§9.2): a mirror a reply minted is
						// not in the positional `__attach` list — the fresh
						// session never minted it — so it is replayed by
						// re-issuing the call that did. Last, because those
						// calls must find the fresh session already attached.
						replay();
					},
				}
			} else {
				// The service surface changed under us: a typed desync in
				// waiting. Close for good; the app restarts on its own terms.
				close_for_good(socket)
			}
		},
	}
}

// The `[service]` generator (transport-rpc.md §4.2) as a prelude macro.
// This module is NOT always loaded — a `[service]` item in any file seeds
// it (the loader's `contains_service` scan), so the macro is registered
// before expansion wherever it's needed.

/// djb2 over the canonical contract surface (Q6 v2), rendered as 8 hex digits
/// — the same fingerprint on both generated sides.
macro fun service_hash(surface: str): str {
	mut hash = 5381u32;
	mut index = 0;
	let length = surface.len();
	for index < length {
		hash = (hash * 33u32) ^ surface.code_at(index);
		index = index + 1;
	}
	mut hex = "";
	mut nibble = 0;
	for nibble < 8 {
		let shift = 28u32 - (4u32 * u32_of_nibble(nibble));
		hex = hex + nibble_char((hash >> shift) & 15u32);
		nibble = nibble + 1;
	}
	hex
}

/// (i32 loop counter → u32 shift operand; a dedicated conversion keeps the
/// hash all-u32. Number() is the identity on an in-range integer.)
macro fun u32_of_nibble(value: i32): u32 {
	if value == 0 {
		ret 0u32;
	}
	if value == 1 {
		ret 1u32;
	}
	if value == 2 {
		ret 2u32;
	}
	if value == 3 {
		ret 3u32;
	}
	if value == 4 {
		ret 4u32;
	}
	if value == 5 {
		ret 5u32;
	}
	if value == 6 {
		ret 6u32;
	}
	7u32
}

macro fun nibble_char(digit: u32): str {
	if digit == 0u32 {
		ret "0";
	}
	if digit == 1u32 {
		ret "1";
	}
	if digit == 2u32 {
		ret "2";
	}
	if digit == 3u32 {
		ret "3";
	}
	if digit == 4u32 {
		ret "4";
	}
	if digit == 5u32 {
		ret "5";
	}
	if digit == 6u32 {
		ret "6";
	}
	if digit == 7u32 {
		ret "7";
	}
	if digit == 8u32 {
		ret "8";
	}
	if digit == 9u32 {
		ret "9";
	}
	if digit == 10u32 {
		ret "a";
	}
	if digit == 11u32 {
		ret "b";
	}
	if digit == 12u32 {
		ret "c";
	}
	if digit == 13u32 {
		ret "d";
	}
	if digit == 14u32 {
		ret "e";
	}
	"f"
}

/// `.on("name", |request| { ..statements.. })` — a dispatcher route whose
/// handler decodes arguments from `request` in a block closure.
macro fun route_block(name: str, statements: List<str>): str {
	import macro_std::build::{ quote, indent };

	// The route body runs inside a fresh per-dispatch TURN
	// (proposal/reactive-turns.md): the generated closure below is STORED at
	// registration (capture-at-creation would see nothing), but the `turn`
	// call happens at INVOCATION, and its literal contains the DIRECT call
	// into the user's handler method — so the turn threads compile-time into
	// real handler code, and one request's signal writes settle as one wave.
	let label = quote(name);
	mut closure = i".on({label}, |request| \{\n";
	closure = closure + indent("turn(FlushPolicy::AtEnd, || {", 1) + "\n";
	for statement in statements {
		closure = closure + indent(statement, 2) + "\n";
	}
	closure = closure + indent("})", 1) + "\n";
	closure + "})"
}

/// The ELEMENT of a return type the `[service]` expansion reads as a signal
/// HANDLE (`transport-rpc.md` §9.2), or `""` when the return is an ordinary
/// value.
///
/// The test is the WRITTEN spelling, and it has to be: this runs before any
/// type resolves, so there is no `Source` impl to reconcile against — the same
/// constraint `[expose]` lives under, where the element is read off the
/// annotation's sole type argument and the analyzer refuses afterwards what
/// the spelling could not carry (B202). `SignalCell<T>` is the canonical cell
/// and the one every derivation produces (`map`, `or`, `combine` all answer
/// `SignalCell<U>`), so it is the spelling a handle is written in. A method
/// returning some OTHER `Source` implementation is not read as a handle and
/// falls to the ordinary `[rpc]` Wire rule, which refuses it by name — loudly,
/// and in the return type's own vocabulary.
macro fun handle_element(type_: TypeExpr): str {
	import macro_std::option::Option::{ Some, None };

	if type_.name != "SignalCell" {
		ret "";
	}
	if type_.arguments.len() != 1 {
		ret "";
	}
	match type_.arguments.get(0) {
		Some(let element) => element.render(),
		None => "",
	}
}

macro fun service(item: Item): Source {
	import macro_std::option::Option::{ self, Some, None };
	import macro_std::build::{ impl_of, fun_of, match_of, struct_of, quote, join, indent };

	let target = match item.as_service() {
		Some(let found) => found,
		None => ServiceItem { name = "?", client_name = "?", fields = [], methods = [] },
	};
	// The [expose]d fields: each source's SOLE type argument is its element —
	// `SignalCell<Note>`, `StorageSignal<str>`. Whether the field is exposable is
	// the compiler's `std::Source` reconciliation, and a field whose element
	// cannot be read here generates NOTHING: no surface entry, no mirror, no
	// `session.expose` call (B202). It used to push the literal `_` and carry it
	// into all three, but `_` is not a type — so a field exposing something that
	// is no source at all was told so once by the compiler and then twice more
	// as `cannot find type '_'`, in code the author never wrote. The curated
	// refusal stands alone.
	//
	// A KEYED field (`[expose(keyed)]`, A39) reads TWO types off the annotation
	// rather than one — the mirror is a `KeyedSource<K, T>` — and vilan has no
	// associated types, so `K` can only come from what the author wrote.
	// `SignalCell<Map<K, V>>` names both in the collection itself; every other
	// keyed collection names only its element, and A51 gives it the attribute
	// ARGUMENT to name the key with: `[expose(keyed = str)] SignalCell<List<T>>`.
	// The refusal for anything else is the analyzer's, said in the vocabulary of
	// the field (`check_expose_fields`), for B202's reason: a field this loop
	// skips would otherwise be silently unexposed.
	mut exposed_names: List<str> = [];
	mut exposed_elements: List<str> = [];
	// The key type per exposed field, or `""` for the whole-value form — the
	// discriminator every later loop reads.
	mut exposed_keys: List<str> = [];
	// Whether the keyed collection is a `Map` (the values are the elements) or
	// a `List` (the collection IS the elements). Only the server-side exposure
	// call differs; the wire, the mirror and the contract entry do not, which
	// is why the two forms hash identically and patch identically.
	mut exposed_maps: List<bool> = [];
	for field in target.fields {
		if field.exposed {
			if field.type_.arguments.len() == 1 {
				match field.type_.arguments.get(0) {
					Some(let element) => {
						if field.keyed {
							if element.name == "Map" && element.arguments.len() == 2 {
								match element.arguments.get(0) {
									Some(let key) => match element.arguments.get(1) {
										Some(let value) => {
											exposed_names.push(field.name);
											exposed_elements.push(value.render());
											// A written argument wins: it is
											// what the author said the key is.
											exposed_keys.push(if field.key == "" {
												key.render()
											} else {
												field.key
											});
											exposed_maps.push(true);
										},
										None => {},
									},
									None => {},
								}
							} else if field.key != "" && element.name == "List" && element.arguments.len() == 1 {
								match element.arguments.get(0) {
									Some(let value) => {
										exposed_names.push(field.name);
										exposed_elements.push(value.render());
										exposed_keys.push(field.key);
										exposed_maps.push(false);
									},
									None => {},
								}
							}
						} else {
							exposed_names.push(field.name);
							exposed_elements.push(element.render());
							exposed_keys.push("");
							exposed_maps.push(false);
						}
					},
					None => {},
				}
			}
		}
	}
	// Which methods return a signal HANDLE, and what the client sees instead
	// (§9.2). Read once, here, because all three of the surface, the route and
	// the stub have to agree about it: `""` is an ordinary value, `"plain"` is
	// `SignalCell<T>` and `"option"` is `Option<SignalCell<T>>`.
	mut handle_kinds: List<str> = [];
	mut handle_elements: List<str> = [];
	mut handle_returns: List<str> = [];
	mut any_handle = false;
	for method in target.methods {
		mut kind = "";
		mut element = handle_element(method.return_type);
		if element != "" {
			kind = "plain";
		} else if method.return_type.name == "Option" && method.return_type.arguments.len() == 1 {
			match method.return_type.arguments.get(0) {
				Some(let inner) => {
					let inner_element = handle_element(inner);
					if inner_element != "" {
						kind = "option";
						element = inner_element;
					}
				},
				None => {},
			}
		}
		handle_kinds.push(kind);
		handle_elements.push(element);
		if kind != "" {
			any_handle = true;
		}
		// The MAPPED type — what the client's stub answers and what the
		// contract surface names. The hash covers this rather than the written
		// type because the hash exists to protect the CLIENT, and this is what
		// the client will decode: a server that turns a handle return into a
		// plain value moves the hash, and a stale client is refused before it
		// can read a `ChannelId` as a `MessageBody`.
		if kind == "plain" {
			handle_returns.push(i"RemoteSource<{element}>");
		} else if kind == "option" {
			handle_returns.push(i"Option<RemoteSource<{element}>>");
		} else {
			handle_returns.push(method.return_type.render());
		}
	}

	// The contract surface + its hash — shared verbatim by both sides.
	mut surface = "";
	mut surface_index = 0;
	for method in target.methods {
		surface = surface + method.name + "(";
		mut first = true;
		for parameter in method.parameters {
			if parameter.name == "self" {
				jump continue;
			}
			if first {
				first = false;
			} else {
				surface = surface + ",";
			}
			surface = surface + parameter.type_.render();
		}
		let rendered_return = match handle_returns.get(surface_index) {
			Some(let found) => found,
			None => method.return_type.render(),
		};
		surface = surface + ")->" + rendered_return + ";";
		surface_index = surface_index + 1;
	}
	mut expose_index = 0;
	for field_name in exposed_names {
		let element = match exposed_elements.get(expose_index) {
			Some(let found) => found,
			None => "_",
		};
		let key = match exposed_keys.get(expose_index) {
			Some(let found) => found,
			None => "",
		};
		// A keyed exposure is its OWN surface entry, so the contract hash moves
		// only for a service that uses the form — a plain `[expose]` service
		// hashes byte-identically to what it hashed before A39.
		if key == "" {
			surface = surface + "expose:" + field_name + ":" + element + ";";
		} else {
			surface = surface + "keyed:" + field_name + ":" + key + ":" + element + ";";
		}
		expose_index = expose_index + 1;
	}
	let hash = service_hash(surface);

	// --- The dispatcher: one route per [rpc] method, handlers capturing `self`.
	mut routes: List<str> = [];
	mut route_index = 0;
	for method in target.methods {
		// The REPLY PATH (§9.2). A handle-returning route exports what the
		// method answered through this connection's capability table and puts
		// the channel id — a plain-Wire `i32` — on the wire in its place; the
		// export rides the route's own turn, so the seeding `Update` a
		// client's `Subscribe` provokes settles with the reply.
		let kind = match handle_kinds.get(route_index) {
			Some(let found) => found,
			None => "",
		};
		let replier = if kind == "plain" {
			"reply_source(request, "
		} else if kind == "option" {
			"reply_source_option(request, "
		} else {
			"reply("
		};
		route_index = route_index + 1;
		mut statements: List<str> = [];
		mut arguments: List<str> = [];
		mut arity = 0;
		for parameter in method.parameters {
			if parameter.name == "self" {
				jump continue;
			}
			statements.push(i"let {parameter.name}: {parameter.type_.render()} = arg(request, {arity});");
			arguments.push(parameter.name);
			arity = arity + 1;
		}
		// Every method route goes through `route_block`, so every handler runs
		// inside the wire turn — a no-arg method's signal writes coalesce
		// exactly like an arg-taking one's (a bare `.on(...)` fast path here
		// once skipped the turn, leaking one update per write).
		if arity == 0 {
			statements.push(i"{replier}self.{method.name}())");
		} else {
			let argument_list = join(arguments, ", ");
			statements.push(match_of("decode_failed(request)")
				.arm("Option::Some(let reason)", "RpcOutcome::Failure(RpcError::Decode(reason))")
				.arm("Option::None", i"{replier}self.{method.name}({argument_list}))")
				.render());
		}
		routes.push(route_block(method.name, statements));
	}
	routes.push(".on(" + quote("__contract") + ", |_| reply(self.contract_hash()))");
	mut exposures: List<str> = [];
	mut exposure_index = 0;
	for field_name in exposed_names {
		let key = match exposed_keys.get(exposure_index) {
			Some(let found) => found,
			None => "",
		};
		if key == "" {
			exposures.push(i"session.expose(self.{field_name})");
		} else {
			let element = match exposed_elements.get(exposure_index) {
				Some(let found) => found,
				None => "_",
			};
			let is_map = match exposed_maps.get(exposure_index) {
				Some(let found) => found,
				None => true,
			};
			// The key projection is a value parameter (`std::rpc`'s
			// `expose_keyed_map` documents why); `Keyed` is what makes
			// `element.key()` resolve on the element type. The `List` form is
			// the same call one layer down — `expose_keyed` is
			// `expose_keyed_map` without the `values()` projection — which is
			// what makes the two forms one channel shape.
			let exposer = if is_map { "expose_keyed_map" } else { "expose_keyed" };
			exposures.push(i"session.{exposer}(self.{field_name}, |element: {element}| element.key())");
		}
		exposure_index = exposure_index + 1;
	}
	let exposure_list = join(exposures, ", ");
	let attach_reply = match_of("session_of(connection)")
		.arm_block("Option::Some(let session)", [
			i"let channels: List<i32> = [{exposure_list}];",
			"reply(channels)",
		])
		.arm("Option::None", "RpcOutcome::Failure(RpcError::Remote("
			+ quote("unknown connection")
			+ "))")
		.render();
	mut attach_statements: List<str> = [];
	attach_statements.push("let connection: i32 = arg(request, 0);");
	attach_statements.push(match_of("decode_failed(request)")
		.arm("Option::Some(let reason)", "RpcOutcome::Failure(RpcError::Decode(reason))")
		.arm("Option::None", attach_reply)
		.render());
	routes.push(route_block("__attach", attach_statements));
	mut chain = "Dispatcher::new()";
	for route in routes {
		chain = chain + "\n" + indent(route, 1);
	}
	let dispatcher = fun_of("dispatcher").parameter("self").returns("Dispatcher").expr(chain);
	let contract_hash = fun_of("contract_hash").parameter("self").returns("str").expr(quote(hash));
	let service_impl = impl_of(target.name).method(dispatcher).method(contract_hash).render();
	// The per-instance spelling, as a trait so `Service::factory` can build a
	// dispatcher from an instance whose type it learns at the call site (A38).
	// Every route in the chain captures the `self` it was built from, so a
	// dispatcher built here answers for THAT connection's instance and no
	// other — including its `[expose]`d fields, which are that instance's own
	// cells and channels.
	let service_trait_impl = impl_of(target.name)
		.implements("RpcService")
		.method(fun_of("dispatcher_for")
			.parameter("self")
			.returns("Dispatcher")
			.expr("self.dispatcher()"))
		.render();

	// --- The client sibling: a transport + a mirror per exposed field.
	mut client_struct = struct_of(target.client_name)
		.generics("<T: Transport>")
		.field("transport: T")
		.field("codec: Codec");
	// A service that hands out HANDLES keeps its reactive client (§9.2): a
	// mirror minted from a reply has to be routed, and the routing table is
	// this connection's `ReactiveClient`. A service with no handle return
	// never needs it after `connect` mints the field mirrors, so it does not
	// carry it — an existing client's shape does not move.
	if any_handle {
		client_struct = client_struct.field("reactive: ReactiveClient");
	}
	mut mirror_index = 0;
	for field_name in exposed_names {
		let element = match exposed_elements.get(mirror_index) {
			Some(let found) => found,
			None => "_",
		};
		let key = match exposed_keys.get(mirror_index) {
			Some(let found) => found,
			None => "",
		};
		if key == "" {
			client_struct = client_struct.field(i"{field_name}: RemoteSource<{element}>");
		} else {
			client_struct = client_struct.field(i"{field_name}: KeyedSource<{key}, {element}>");
		}
		mirror_index = mirror_index + 1;
	}
	mut client_impl = impl_of(target.client_name).generics("<type T>");
	mut stub_index = 0;
	for method in target.methods {
		mut stub = fun_of(method.name).parameter("self");
		mut describers: List<str> = [];
		for parameter in method.parameters {
			if parameter.name == "self" {
				jump continue;
			}
			stub = stub.parameter(i"{parameter.name}: {parameter.type_.render()}");
			describers.push(i"|serializer: Serializer| {parameter.name}.describe(serializer)");
		}
		let label = quote(method.name);
		let describer_list = join(describers, ", ");
		let kind = match handle_kinds.get(stub_index) {
			Some(let found) => found,
			None => "",
		};
		let element = match handle_elements.get(stub_index) {
			Some(let found) => found,
			None => "",
		};
		let mapped = match handle_returns.get(stub_index) {
			Some(let found) => found,
			None => method.return_type.render(),
		};
		stub_index = stub_index + 1;
		stub = stub.returns(i"Result<{mapped}, RpcError>");
		if kind == "" {
			stub = stub.expr(i"call(self.transport, self.codec, {label}, [{describer_list}])");
		} else {
			// The MINT (§9.2). The reply is a channel id and nothing else; the
			// mirror is built here, on the client, with the call that produced
			// it — which is what lets demand return after the server withdrew
			// the channel (R3) and what lets a reconnect ask for it again.
			// `reissue` closes over the transport and codec because
			// `RemoteSource` holds neither: it is generic over its element
			// alone and carries the reactive duplex, not the rpc transport.
			let origin = i"Origin \{\n"
				+ indent(i"method = {label},", 1)
				+ "\n"
				+ indent(i"describers = [{describer_list}],", 1)
				+ "\n"
				+ indent("reissue = |handle_method: str, handle_args: List<|Serializer| void>| {", 1)
				+ "\n"
				+ indent(if kind == "option" {
					"let handle_reply: Result<Option<i32>, RpcError> =\n"
						+ indent("call(self.transport, self.codec, handle_method, handle_args);", 1)
						+ "\n"
						+ match_of("handle_reply")
							.arm("Result::Err(let failure)", "Result::Err(failure)")
							.arm_block("Result::Ok(let answered)", [
								match_of("answered")
									.arm("Option::Some(let fresh)", "Result::Ok(fresh)")
									.arm("Option::None", "Result::Err(RpcError::Remote("
										+ quote("the source this handle names no longer exists")
										+ "))")
									.render(),
							])
							.render()
				} else {
					"let handle_reply: Result<i32, RpcError> =\n"
						+ indent("call(self.transport, self.codec, handle_method, handle_args);", 1)
						+ "\nhandle_reply"
				}, 2)
				+ "\n"
				+ indent("},", 1)
				+ "\n}";
			if kind == "option" {
				stub = stub
					.line(i"let handle_channel: Result<Option<i32>, RpcError> = call(self.transport, self.codec, {label}, [{describer_list}]);")
					.expr(match_of("handle_channel!")
						.arm_block("Option::None", [
							i"let handle_absent: Option<RemoteSource<{element}>> = Option::None;",
							"Result::Ok(handle_absent)",
						])
						.arm_block("Option::Some(let handle_id)", [
							i"let handle_mirror: RemoteSource<{element}> = self.reactive.minted_source(handle_id, {origin});",
							"Result::Ok(Option::Some(handle_mirror))",
						])
						.render());
			} else {
				stub = stub
					.line(i"let handle_channel: Result<i32, RpcError> = call(self.transport, self.codec, {label}, [{describer_list}]);")
					.line(i"let handle_mirror: RemoteSource<{element}> = self.reactive.minted_source(handle_channel!, {origin});")
					.expr("Result::Ok(handle_mirror)");
			}
		}
		client_impl = client_impl.method(stub);
	}
	let verify = fun_of("verify")
		.parameter("self")
		.returns("Result<bool, RpcError>")
		.line("let remote: Result<str, RpcError> = call(self.transport, self.codec, "
			+ quote("__contract")
			+ ", []);")
		.expr("Result::Ok(remote! == self.contract_hash())");
	client_impl = client_impl.method(verify).method(contract_hash);

	// --- Client::connect (§4.2): contract enforcement, __attach, mirrors —
	// --- and the reconnect hook that re-attaches them (K6).
	let complaint = quote("the server reports a different service surface");
	// Everything AFTER the dial is the same for both spellings of connect, so
	// it is built once and replayed into each (A40 added `connect_with`, whose
	// only difference is the handshake offer it dials with).
	mut body: List<str> = [];
	body.push("let transport = socket.transport();");
	body.push("let remote: Result<str, RpcError> = call(transport, codec, "
		+ quote("__contract")
		+ ", []);");
	body.push("if remote! != "
		+ quote(hash)
		+ " {\n"
		+ indent(i"ret Result::Err(RpcError::Contract({complaint}));", 1)
		+ "\n}");
	body.push("let connection = socket.connection.read();");
	body.push("let attached: Result<List<i32>, RpcError> = call(transport, codec, "
		+ quote("__attach")
		+ ", [|serializer: Serializer| connection.describe(serializer)]);");
	body.push("let channels = attached!;");
	body.push("let reactive = ReactiveClient::new(bridge(socket), codec);");
	// Registered where the client is born, so no terminal arm has to carry
	// it and no window exists in which the connection could close unbound
	// (backlog A31).
	body.push("dispose_on_close(socket, reactive);");
	mut ok_fields: List<str> = [];
	ok_fields.push("transport = transport");
	ok_fields.push("codec = codec");
	if any_handle {
		ok_fields.push("reactive = reactive");
	}
	mut rebind_lines: List<str> = [];
	mut channel_index = 0;
	for field_name in exposed_names {
		let element = match exposed_elements.get(channel_index) {
			Some(let found) => found,
			None => "_",
		};
		let key = match exposed_keys.get(channel_index) {
			Some(let found) => found,
			None => "",
		};
		if key == "" {
			body.push(i"let mirror_{field_name}: RemoteSource<{element}> = reactive.attached_source(channels[{channel_index}]);");
			rebind_lines.push(i"|channel: i32, subscribe: Frame| mirror_{field_name}.rebind(channel, subscribe)");
		} else {
			body.push(i"let mirror_{field_name}: KeyedSource<{key}, {element}> = reactive.attached_keyed_source(channels[{channel_index}]);");
			// A keyed mirror re-encodes its own `Subscribe` frames — one per
			// demand it still holds — so the positional frame the plain path
			// rebinds with is not its to use.
			rebind_lines.push(i"|channel: i32, _subscribe: Frame| mirror_{field_name}.rebind(channel)");
		}
		ok_fields.push(i"{field_name} = mirror_{field_name}");
		channel_index = channel_index + 1;
	}
	// The reconnect hook: re-verify the contract, re-attach under the fresh
	// connection id, rebind every mirror positionally (transport-robustness §2.5).
	let rebind_list = if rebind_lines.len() > 0 {
		"[\n" + indent(join(rebind_lines, ",\n"), 1) + ",\n]"
	} else {
		"[]"
	};
	body.push(i"let rebinds: List<|i32, Frame| void> = {rebind_list};");
	body.push("socket.on_reconnect.write().push(|| {\n"
		+ indent("reattach_mirrors(socket, transport, codec, " + quote(hash) + ", rebinds, || reactive.replay_dynamic());", 1)
		+ "\n});");
	let field_lines = join(ok_fields, ",\n");
	let client_value = i"Result::Ok({target.client_name} \{\n" + indent(field_lines, 1) + "\n})";
	let connect_type = i"Result<{target.client_name}<SocketTransport>, RpcError>";
	mut connect = fun_of("connect")
		.parameter("url: str")
		.parameter("codec: Codec")
		.returns(connect_type)
		.line("let socket = dial_for_service(url)!;");
	for line in body {
		connect = connect.line(line);
	}
	// The credential seam (A40): the same connect, offering `protocols` on the
	// handshake — `rpc_protocols(token)` writes the documented offer, and the
	// same list is re-presented on every reconnect.
	mut connect_with = fun_of("connect_with")
		.parameter("url: str")
		.parameter("codec: Codec")
		.parameter("protocols: List<str>")
		.returns(connect_type)
		.line("let socket = dial_for_service_with(url, protocols)!;");
	for line in body {
		connect_with = connect_with.line(line);
	}
	let connect_impl = impl_of(target.client_name)
		.generics("<SocketTransport>")
		.method(connect.expr(client_value))
		.method(connect_with.expr(client_value))
		.render();

	let imports = "import std::rpc::{ Transport, Dispatcher, RpcError, RpcOutcome, RemoteSource, KeyedSource, RpcService, Origin, call, arg, reply, reply_source, reply_source_option, decode_failed, session_of, dial_for_service, dial_for_service_with, SocketDuplex, SocketTransport, bridge, ReactiveClient, dispose_on_close, reattach_mirrors };\n"
		+ "import std::wire::{ Codec, Serializer, Frame, Keyed };\n"
		+ "import std::result::Result;\n"
		+ "import std::option::Option;\n"
		+ "import std::reactive::{ turn, FlushPolicy };\n";
	source(imports
		+ service_impl
		+ service_trait_impl
		+ client_struct.render()
		+ client_impl.render()
		+ connect_impl)
}
