// The change structure under `std::reactive` (proposal/incremental-collections.md,
// tracker A112, slice S1).
//
// A collection `C` gets a change type — its OP — and an apply; every operator
// `f: C -> D` gets a derivative `f': C -> Op<C> -> Op<D>`, and the law is
//
//     f(a (+) da) == f(a) (+) f'(a, da)
//
// read at the only place it is observable, the settle of a turn:
// `derived.get() == source.get().map(g)`. For `map g` the derivative of "three
// elements arrived at position 4" is "three MAPPED elements arrived at position 4":
// `g` runs three times and nothing else is looked at — not N cache checks, zero.
//
// This module is the LOG half of that: an op vocabulary per collection SHAPE
// (not per method), a bounded op log with per-consumer cursors, and the thin
// trait a cell offers so operators are written against the ops once and serve
// every cell kind. It is `KeyedCell`'s machinery (A54), lifted out of
// `std::rpc` and made generic in the OP rather than in the collection — which
// is what lets a `List<str>` have a delta source at all: `KeyedCell` demands
// keys because its consumer is a wire protocol that addresses elements by key,
// and a local derivation addresses them by position.
//
// **Why a file of its own, and why the names read as `std::reactive`'s.** The log
// belongs to the reactive layer — `std::reactive` imports nothing from `std::wire`,
// and that stays true: `SeqOp` is a reactive type, `Delta` a wire one, and the edge
// between them lives in `std::rpc`, where it lives today. `reactive.vl` re-exports
// everything below, so the designed spelling `std::reactive::DeltaCursor` resolves;
// this file is where the bodies sit.
//
// Coalescing is free and is already how the turn scheduler behaves: writes in one
// turn produce ONE notification and the consumer drains every op at the settle, so
// the log is as long as one turn's writes.
import pkg::compare::PartialEq;
import pkg::hash::Hashable;
import pkg::hash_map::HashMap;
import pkg::hash_set::HashSet;
import pkg::io::panic;
import pkg::native_map::NativeMap;
import pkg::option::Option::{ self, None, Some };
import pkg::reactive::{
	Flow,
	Instance,
	Owner,
	Pipe,
	RowStep,
	Signal,
	SignalCell,
	Source,
	Subscriber,
	Subscription,
	also_releasing,
	as_derivation,
	defer_to_owner,
	detach,
	fresh_id,
	observe_flow,
	owner_scope,
	reconcile,
	register_with_owner,
	run_element,
	subscriber_of,
	wake,
};
import pkg::shared::Shared;
import pkg::task::ambient_nursery;

/// How many ops a `DeltaLog` will hold for a consumer that has stopped
/// draining. Past it the history is dropped and every lagging cursor falls
/// back to its shape's `Reset` — bounded memory, at the cost of one
/// whole-collection payload to a consumer that could not keep up. In practice
/// nothing reaches it: a consumer drains at the settle of the turn that wrote,
/// so the log is as long as one turn's writes and no longer.
///
/// `keyed_log_limit` before the lift (A54), with its sentence unchanged.
export let delta_log_limit: usize = 1024;

/// One consumer's place in a log: the sequence number it has been told through.
/// Identified rather than compared, because two consumers may legitimately sit at
/// the same sequence.
///
/// `KeyedCursor` before the lift (A54) — the cursor is shape-neutral, so it is
/// spelled once here instead of once per collection.
export struct DeltaCursor {
	id: i32,
	at: Shared<i32>,
}

// === The op vocabulary, per SHAPE ============================================
//
// Every arm carries WHAT LEFT as well as what arrived, and that is a
// requirement rather than a convenience: the O(1) derivative of a fold over a
// group — `sum`, `count`, `mean` — is "add what arrived, subtract what left",
// and a count cannot say what left, so the operator would have to read the
// collection, which is the O(N) rerun this module exists to delete. The same
// payload is what makes an op invertible (undo), and it is what `std::rpc`'s
// translation to `Delta<K, T>` needs: `Delta::Remove(key)` wants the key of
// the element that WENT, and only the value carries it.

/// A sequence's change — the primitive shape. Positional: keyed addressing is a
/// position index on top of it, which is exactly what `KeyedCell` keeps.
export enum SeqOp<T> {
	/// `removed` left and `inserted` arrived, both at `at`.
	Splice(usize, List<T>, List<T>),
	/// The element at `at` was the first value and is now the second.
	///
	/// Deliberately NOT `Splice(at, [old], [new])`, though it means the same thing
	/// to the collection: for `each` and for a per-element derivation the two are
	/// different events — an element changed in place, versus one left and another
	/// arrived — and the difference is whether the per-element owner survives.
	SetAt(usize, T, T),
	/// The collection BECAME this list. The honest escape hatch: a wholesale write,
	/// a lagging cursor's fallback, and the compat path for a source that keeps no
	/// log at all.
	Reset(List<T>),
	/// `count` elements moved from `from` to `to`, unchanged.
	///
	/// In the vocabulary from S1 although nothing in std EMITS one yet: adding an
	/// arm to a public op enum later is a breaking change to every `match` in every
	/// consumer, and a reorder is exactly where the splice-pair encoding loses
	/// information a consumer needs — a `Splice` that removes an element and a
	/// `Splice` that re-inserts it are, to a per-element owner, a disposal and a
	/// rebuild, where a `Move` says "same element, new place". A consumer that does
	/// not care may treat it as the splice pair; `std::rpc`'s wire translation
	/// lowers it to `Delta::Reset`, which is what a reorder sends today.
	Move(usize, usize, usize),
}

/// A map's change. `Put`'s `Option<V>` is the difference between an insert and an
/// overwrite, which a group fold over the values needs.
///
/// Recorded, not slated: nothing asks for a reactive map cell yet. It is written
/// here so the log's shape is chosen against more than one collection.
///
/// `K: Hashable` is the `Reset` arm's bound, not the op's: `HashMap<K, V>` demands it,
/// and an op that carries the whole collection carries its bounds with it.
export enum MapOp<K: Hashable, V> {
	/// The key, what was there, and what is there now.
	Put(K, Option<V>, V),
	/// The key and the value that left.
	Delete(K, V),
	/// The collection BECAME this map.
	Reset(HashMap<K, V>),
}

/// A set's change. Recorded, not slated — `MapOp`'s sentence applies.
export enum SetOp<T: Hashable> {
	Add(T),
	Remove(T),
	Reset(HashSet<T>),
}

// === The log =================================================================

/// A bounded op log with per-consumer cursors — `KeyedCell`'s machinery,
/// lifted and made generic in the OP rather than in the collection.
///
/// Three cell kinds want it (a local sequence cell, the keyed cell, an optimistic
/// or remote cell) and copying it three times is the anti-DRY failure one layer up
/// from the one A112 complains about, so it is a value type a cell HOLDS rather
/// than a shape a cell repeats.
export struct DeltaLog<O> {
	/// The ops still worth keeping, oldest first: sequence numbers
	/// `base + 1 ..= version`.
	ops: Shared<List<O>>,
	/// The sequence number of the newest op the log has been told.
	version: Shared<i32>,
	/// The sequence number BEFORE the oldest op the log still holds. A cursor left
	/// behind it has lost history and is answered with `None`.
	base: Shared<i32>,
	/// One per live consumer. The log trims to the laggiest of them, so a log
	/// nobody is watching keeps no history at all.
	cursors: Shared<List<DeltaCursor>>,
	/// This log's ceiling, `delta_log_limit` unless a cell asked for another. A
	/// plain field rather than a cell: it is written once, at construction.
	limit: usize,
}

export impl DeltaLog<type O> {
	/// An empty log at `delta_log_limit`.
	fun new(): DeltaLog<O> {
		DeltaLog {
			ops = Shared::new([]),
			version = Shared::new(0),
			base = Shared::new(0),
			cursors = Shared::new([]),
			limit = delta_log_limit,
		}
	}

	/// An empty log at a ceiling of its caller's choosing — what a test that wants
	/// to reach the lag path without writing a thousand ops asks for.
	fun with_limit(limit: usize): DeltaLog<O> {
		DeltaLog {
			ops = Shared::new([]),
			version = Shared::new(0),
			base = Shared::new(0),
			cursors = Shared::new([]),
			limit,
		}
	}

	/// Append one op and bump the sequence. The trim comes FIRST, so a log whose
	/// consumers are all current holds one op and a log with no consumers holds
	/// exactly the op just recorded — ONE, not zero, because the trim happened
	/// before the push. Harmless, and stated here because it is easy to state
	/// wrongly.
	///
	/// Past `limit` the history is dropped instead of appended and `base`
	/// jumps to the new sequence: every cursor behind it now reads as lagging
	/// and is answered with `None` on its next drain, which the CELL turns
	/// into its shape's `Reset`. The op is not lost — it is IN the collection,
	/// which is what the `Reset` carries.
	fun record(self, op: O) {
		self.trim();
		let next = self.version.read() + 1;
		self.version.write() = next;
		if self.ops.read().len() >= self.limit {
			self.ops.write() = [];
			self.base.write() = next;
		} else {
			self.ops.write().push(op);
		}
	}

	/// Drop the ops every live cursor has already been told. With no cursors the
	/// whole log goes: nothing is watching, so nothing is owed.
	///
	/// The log is trimmed at the next WRITE, not at the drain: after a lone cursor
	/// has drained four ops the log still holds four, and they go on the next
	/// `record`. A cell written once and then read for ever holds one op's worth of
	/// history for ever. Also harmless, and also easy to state wrongly.
	fun trim(self) {
		mut lowest = self.version.read();
		for cursor in self.cursors.read() {
			let at = cursor.at.read();
			if at < lowest {
				lowest = at;
			}
		}
		let base = self.base.read();
		if lowest > base {
			let dropped = lowest - base;
			mut kept: List<O> = [];
			// A sequence number meets a position here: the ops held start at
			// `base`, so the count dropped is where the kept ones begin.
			mut index = dropped.as_usize();
			let held = self.ops.read();
			let length = held.len();
			for index < length {
				match held.get(index) {
					Some(let op) => kept.push(op),
					None => {},
				}
				index += 1;
			}
			self.ops.write() = kept;
			self.base.write() = lowest;
		}
	}

	/// Register a consumer's cursor, at the sequence the log is at NOW — the
	/// consumer is about to seed from the current collection, so it is owed nothing
	/// before this point.
	fun cursor(self): DeltaCursor {
		let minted = DeltaCursor { id = fresh_id(), at = Shared::new(self.version.read()) };
		self.cursors.write().push(minted);
		minted
	}

	/// Retire a cursor: its consumer is gone, so the log no longer has to hold
	/// anything for it. Called from the consumer's `Subscription::release`.
	fun drop_cursor(self, cursor: DeltaCursor) {
		mut kept: List<DeltaCursor> = [];
		for held in self.cursors.read() {
			if held.id != cursor.id {
				kept.push(held);
			}
		}
		self.cursors.write() = kept;
	}

	/// Everything `cursor` has not been told, and advance it. A cursor behind
	/// `base` has lost history and is answered with `None`.
	///
	/// `None` rather than a `Reset` because the LOG does not know what a `Reset` is
	/// for its op type and the CELL does — the one place the two layers have to
	/// know about each other, and three lines in each cell.
	fun since(self, cursor: DeltaCursor): Option<List<O>> {
		let at = cursor.at.read();
		let version = self.version.read();
		mut ops: List<O> = [];
		if at >= version {
			ret Some(ops);
		}
		cursor.at.write() = version;
		let base = self.base.read();
		if at < base {
			ret None;
		}
		mut index = (at - base).as_usize();
		let held = self.ops.read();
		let length = held.len();
		for index < length {
			match held.get(index) {
				Some(let op) => ops.push(op),
				None => {},
			}
			index += 1;
		}
		Some(ops)
	}

	/// How many ops the log is holding — what a pin on the trim reads.
	fun held(self): usize {
		self.ops.read().len()
	}

	/// The newest sequence the log has been told.
	fun at(self): i32 {
		self.version.read()
	}

	/// The sequence before the oldest op still held.
	fun oldest(self): i32 {
		self.base.read()
	}
}

/// A source whose WRITES are its deltas. `C` is the collection, `O` its op.
///
/// The bound is what makes an operator generic in the CELL rather than in one cell
/// type: a derivation takes an `S: DeltaSource<List<T>, SeqOp<T>>`, so it serves a
/// local sequence cell, `KeyedCell`, and anything an app writes.
///
/// vilan has no associated types, so both the collection and its op are parameters.
export trait DeltaSource<C, O> with Source<C> {
	/// A cursor into this source's log, at the sequence it is at now.
	fun cursor(self): DeltaCursor;

	/// Retire a cursor. A derivation calls it on disposal, so a dead consumer stops
	/// pinning history.
	fun drop_cursor(self, cursor: DeltaCursor);

	/// Everything `cursor` has not been told. Unlike the LOG's `since` this never
	/// fails: a cursor that lost history is answered with the shape's `Reset`,
	/// carrying the collection.
	fun since(self, cursor: DeltaCursor): List<O>;

	/// `since`, as a closure that holds only what READING the ops needs — the log,
	/// and the collection a lost cursor's `Reset` carries — and not the
	/// notification a consumer subscribes to (tracker A132).
	///
	/// A delta consumer drains ops from inside its own change handler, and a
	/// handler that captured the SOURCE to call `since` closed a loop: the source's
	/// subscriber list holds the handler, the handler holds the source. On the JS
	/// backend the collector reclaims it once nothing else reaches it; under
	/// counting it never goes (C14's leak gate read 14 cells live in `delta-law`
	/// and 92 in `list-cell`, all `map_each`'s). A consumer captures this reader
	/// instead.
	///
	/// The default is the loop-closing form — `self` captured whole — because a
	/// generic impl cannot name its own parts; std's cells override it with the two
	/// handles `since` actually reads, and an app's cell should too.
	fun reader(self): |DeltaCursor| List<O> {
		|cursor| self.since(cursor)
	}
}

/// What a CONSUMER asks a source for when it can use ops but does not require
/// them: a delta feed, or nothing (A112 S3).
///
/// `each` takes any `Source<List<T>>` and must go on doing so, so it cannot bound
/// on `DeltaSource` — and vilan has no overloading, so the choice cannot be two
/// functions of one name either. It is one trait with a BLANKET impl answering "no
/// feed", which every collection source satisfies, and a second blanket over
/// `DeltaSource` answering a real one; the specificity order picks the second
/// wherever both match, because a subject bound by a subtrait is the more specific
/// one (B378).
///
/// **A cell with a log needs nothing more.** Being a `DeltaSource` is the whole of
/// it — the second blanket forwards to its members. What the extra trait buys over
/// bounding on `DeltaSource` directly is that a consumer may be written ONCE for
/// both kinds of source.
///
/// It is declared `with Source<List<T>>` because a feed is only ever asked of a
/// collection source, so a consumer bounds on `DeltaFeed<T>` alone and reads the
/// list through it. The first blanket's own bound IS that supertrait: the subject's
/// bound supplies the supertrait's members (spec/types.md §5.5), and a type with no
/// `Source<List<T>>` of its own does not reach the blanket.
///
/// It is a separate trait rather than three defaults on `Source<T>` because
/// `Source`'s argument is the whole value and these are about a COLLECTION's
/// element type — a `Source<i32>` has no `SeqOp<i32>` feed to offer, and giving it
/// one would put a collection's vocabulary on every signal in the language.
export trait DeltaFeed<T> with Source<List<T>> {
	/// A cursor into this source's op log, or `None` when it keeps none.
	fun delta_cursor(self): Option<DeltaCursor>;

	/// Everything the cursor has not been told. A source that answered `None` above
	/// is never asked.
	fun delta_since(self, cursor: DeltaCursor): List<SeqOp<T>>;

	/// Retire the cursor, so a disposed consumer stops pinning history.
	fun drop_delta_cursor(self, cursor: DeltaCursor);
}

/// Every collection source, including every plain `SignalCell<List<T>>`: no log, so
/// no feed, so the consumer keeps its whole-value path. This is what "a
/// `SignalCell` is not a delta source" means in code.
export impl type S: Source<List<type T>> with DeltaFeed<T> {
	fun delta_cursor(self): Option<DeltaCursor> {
		None
	}

	fun delta_since(self, cursor: DeltaCursor): List<SeqOp<T>> {
		mut none: List<SeqOp<T>> = [];
		none
	}

	fun drop_delta_cursor(self, cursor: DeltaCursor) {}
}

/// Every source that KEEPS a positional log — `ListCell`, `std::rpc`'s `KeyedCell`,
/// and anything an application writes against `DeltaSource` — answers with a real
/// feed. This impl and the one above both match such a source, and this one is
/// chosen because `DeltaSource<List<T>, SeqOp<T>>` is declared
/// `with Source<List<T>>`: a subject bound by a subtrait is the more specific one
/// (B378). It forwards, one line each.
export impl type S: DeltaSource<List<type T>, SeqOp<T>> with DeltaFeed<T> {
	fun delta_cursor(self): Option<DeltaCursor> {
		Some(self.cursor())
	}

	fun delta_since(self, cursor: DeltaCursor): List<SeqOp<T>> {
		self.since(cursor)
	}

	fun drop_delta_cursor(self, cursor: DeltaCursor) {
		self.drop_cursor(cursor);
	}
}

// === The sequence cell, and the first operator (A112 S2) =====================
//
// S1 built the LOG half. This is the CELL half: a collection whose writes are its
// ops, a surface over it that is written ONCE per receiver kind, and the first
// derivative — `map g`, whose `Splice(at, removed, arrived)` becomes
// `Splice(at, removed, arrived.map(g))`, so `g` runs once per arriving element and
// nothing else is looked at. Not N cache checks: zero.
//
// **Why two traits and not one.** `List`'s mutators take `&mut self`; a cell
// handle's take `self` — a `ListCell<T>` is two `Shared`s, so a copy of the handle
// is the same cell and `my_list.push(x)` on a plain `let` is right. One trait
// cannot have both receivers, and it does not need to: `SequenceCell` is the
// everyday surface and `Sequence` is the one a BODY is written against
// (`fun fill<S: Sequence<str>>(target: &mut S)`), reached through `edit`. Both
// stand on the same single primitive — `splice` — so the twelve method names each
// of them offers are defaults, written twice and implemented never
// (incremental-collections.md §6, §13 Q2: two hand lists, no macro).
//
// Every position and count below is a `usize`, the index type: an index is a
// position, a length or a count, and a sequence surface speaks nothing else.

/// The everyday sequence surface: `self` receivers, one primitive.
///
/// An implementor writes exactly TWO members — `size` and `splice` — and
/// inherits the rest. `splice` is the primitive because every other mutation
/// IS one: `push` is a splice at the end, `remove_at` a splice of one, `clear`
/// a splice of everything. Recording one op per call is then automatic rather
/// than a rule each method has to remember.
export trait SequenceCell<T> {
	/// How many elements the sequence holds.
	fun size(self): usize;

	/// THE primitive: `removed` elements leave at `at` and `inserted` arrive there,
	/// as ONE op and ONE notification.
	fun splice(self, at: usize, removed: usize, inserted: List<T>);

	/// Nothing held.
	fun is_empty(self): bool {
		self.size() == 0
	}

	/// One element at the end.
	fun push(self, value: T) {
		self.splice(self.size(), 0, [value])
	}

	/// One element at the front.
	fun prepend(self, value: T) {
		self.splice(0, 0, [value])
	}

	/// One element at `at`, moving everything from there along.
	fun insert_at(self, at: usize, value: T) {
		self.splice(at, 0, [value])
	}

	/// Several elements at `at`, in order.
	fun insert_all(self, at: usize, values: List<T>) {
		self.splice(at, 0, values)
	}

	/// The element at `at` leaves.
	fun remove_at(self, at: usize) {
		self.splice(at, 1, [])
	}

	/// `count` elements leave, starting at `at`.
	fun remove_range(self, at: usize, count: usize) {
		self.splice(at, count, [])
	}

	/// The last element leaves; an empty sequence is left alone.
	fun pop(self) {
		let size = self.size();
		if size > 0 {
			self.splice(size - 1, 1, [])
		}
	}

	/// Several elements at the end, in order.
	fun extend(self, values: List<T>) {
		self.splice(self.size(), 0, values)
	}

	/// Everything leaves.
	fun clear(self) {
		self.splice(0, self.size(), [])
	}

	/// Everything leaves and `values` arrive — the wholesale write expressed as ONE
	/// `Splice` over the whole run.
	///
	/// It is NOT cheaper than `set`, and costs no more (A129): `each` and `each_by`
	/// match a splice's span by KEY exactly as they match a `Reset`, so a row whose
	/// key survives is kept either way, and a derivation runs once per element for
	/// both. The door that records only what changed is `reconcile_to`.
	fun set_all(self, values: List<T>) {
		self.splice(0, self.size(), values)
	}

	/// Keep the first `length` elements.
	fun truncate(self, length: usize) {
		let size = self.size();
		if size > length {
			self.splice(length, size - length, [])
		}
	}
}

/// The same sequence surface with `&mut self` receivers — the shape a BODY is
/// written against, and the one `ListCell::edit` hands out.
///
/// Its implementor is `Tracked<T>`, the recorder: a plain list plus the ops that
/// produced it. What this buys over `SequenceCell` is that an algorithm bounded on
/// it (`fun fill<S: Sequence<str>>(target: &mut S)`) is not tied to the reactive
/// graph at all — the same body fills a recorder inside an `edit` and, once B359's
/// fix admits `List<T>` among the implementors, a plain list outside one.
///
/// `size` takes `self` and the mutators take `&mut self`, deliberately: asking for
/// a writable view to answer a question would refuse a read on a shared value for
/// no reason.
export trait Sequence<T> {
	/// How many elements the sequence holds.
	fun size(self): usize;

	/// THE primitive, as in `SequenceCell` — `removed` leave at `at` and `inserted`
	/// arrive there.
	fun splice(&mut self, at: usize, removed: usize, inserted: List<T>);

	/// Nothing held.
	fun is_empty(self): bool {
		self.size() == 0
	}

	/// One element at the end.
	fun push(&mut self, value: T) {
		self.splice(self.size(), 0, [value])
	}

	/// One element at the front.
	fun prepend(&mut self, value: T) {
		self.splice(0, 0, [value])
	}

	/// One element at `at`, moving everything from there along.
	fun insert_at(&mut self, at: usize, value: T) {
		self.splice(at, 0, [value])
	}

	/// Several elements at `at`, in order.
	fun insert_all(&mut self, at: usize, values: List<T>) {
		self.splice(at, 0, values)
	}

	/// The element at `at` leaves.
	fun remove_at(&mut self, at: usize) {
		self.splice(at, 1, [])
	}

	/// `count` elements leave, starting at `at`.
	fun remove_range(&mut self, at: usize, count: usize) {
		self.splice(at, count, [])
	}

	/// The last element leaves; an empty sequence is left alone.
	fun pop(&mut self) {
		let size = self.size();
		if size > 0 {
			self.splice(size - 1, 1, [])
		}
	}

	/// Several elements at the end, in order.
	fun extend(&mut self, values: List<T>) {
		self.splice(self.size(), 0, values)
	}

	/// Everything leaves.
	fun clear(&mut self) {
		self.splice(0, self.size(), [])
	}

	/// Everything leaves and `values` arrive, as ONE op.
	fun set_all(&mut self, values: List<T>) {
		self.splice(0, self.size(), values)
	}

	/// Keep the first `length` elements.
	fun truncate(&mut self, length: usize) {
		let size = self.size();
		if size > length {
			self.splice(length, size - length, [])
		}
	}
}

// === The one splice ==========================================================
//
// Both surfaces run THIS — `Tracked` on its own list, `ListCell` inside its cell's
// `update` — so the two cannot disagree about what an out-of-range ask means or
// about what the op records.
//
// Out-of-range asks are CLAMPED, where `List::insert` and `List::remove` panic. The
// difference is deliberate: `List`'s index is a caller's claim about a list it
// holds, while a sequence surface is reached through a dozen defaults over ONE
// primitive, and `remove_range(at, 99)` asking for "the rest" or a `truncate` past
// the end should mean what it says rather than abort the turn. A clamped splice
// that takes nothing and inserts nothing is no op at all, and both callers check
// for it before they record or publish anything.

/// Where a splice at `at` starts in a sequence of `held` elements: `at`, pulled
/// into `0..=held`.
fun splice_start(held: usize, at: usize): usize {
	if at > held {
		held
	} else {
		at
	}
}

/// How many of the `removed` asked for a splice from `start` can take.
fun splice_count(held: usize, start: usize, removed: usize): usize {
	if start + removed > held {
		held - start
	} else {
		removed
	}
}

/// Apply an already-clamped splice to `list` and answer the op it made. The op
/// carries what LEFT as well as what arrived — §3.1's requirement, and what makes a
/// group fold's derivative O(1).
fun splice_in_place<T>(
	list: &mut List<T>,
	start: usize,
	taking: usize,
	inserted: List<T>,
): SeqOp<T> {
	mut left: List<T> = [];
	mut taken = 0;
	for taken < taking {
		left.push(list.remove(start));
		taken += 1;
	}
	mut offset = 0;
	let arriving = inserted.len();
	for offset < arriving {
		match inserted.get(offset) {
			Some(let value) => list.insert(start + offset, value),
			None => {},
		}
		offset += 1;
	}
	SeqOp::Splice(start, left, inserted)
}

/// A plain list plus the ops that produced it — what `ListCell::edit` hands a body,
/// and the only implementor of `Sequence<T>` std ships.
///
/// It is NOT reactive and holds no cell: the whole point is that a body may make a
/// dozen mutations on it at no notification cost, and the cell publishes the result
/// once when the body returns.
export struct Tracked<T> {
	/// The elements, mutated in place.
	elements: List<T>,
	/// One op per mutation, in the order they were made.
	ops: List<SeqOp<T>>,
}

export impl Tracked<type T> {
	/// A recorder over `elements`, with nothing recorded yet.
	fun new(elements: List<T>): Tracked<T> {
		Tracked { elements, ops = [] }
	}
}

export impl Tracked<type T> with Sequence<T> {
	fun size(self): usize {
		self.elements.len()
	}

	fun splice(&mut self, at: usize, removed: usize, inserted: List<T>) {
		let held = self.elements.len();
		let start = splice_start(held, at);
		let taking = splice_count(held, start, removed);
		if taking == 0 && inserted.len() == 0 {
			ret;
		}
		self.ops.push(splice_in_place(&mut self.elements, start, taking, inserted));
	}
}

/// A `List<T>` whose WRITES ARE ITS DELTAS: the list, the op log that says what
/// each write did, and the one notification both ride.
///
/// This is the cell A112 exists for. `list.push(x)` is one op, so a derivation
/// over it (`map_each`) runs its function once — for `x` — rather than once per
/// element, and `each` over it builds one row rather than reconciling the run.
/// Everything else about it is an ordinary `Source<List<T>>`: `each` takes it,
/// `map` takes it, an effect takes it, and a consumer that knows nothing about
/// ops pays nothing for them.
///
/// `set(whole_list)` records a `Reset` and costs what a `SignalCell` costs — the
/// honest compat path. `reconcile_to(whole_list)` is the door that turns a
/// wholesale write back into ops.
///
/// **Why the list is held HERE and not in a `SignalCell<List<T>>` (M86).** A
/// write has to know how long the list is, and the only read a `SignalCell`
/// offers is `get`, which hands back a VALUE — a deep copy of the run. Every
/// `splice` paid one, and `push` two (once to find the end, once inside
/// `splice`): 5.8 M of the 6.3 M Ir a push into 1,000 rows cost under `each`,
/// against ~30 K for everything `each` did with the op. Held in its own
/// `Shared`, the list is read in place — `items.read().len()` copies nothing —
/// and the signal carries only the notification, so there is still exactly ONE
/// notification per write and every observer, the op consumers and the
/// `Source<List<T>>` view alike, wakes on it.
export struct ListCell<T> {
	/// The elements. Mutated in place by every write, before `published` fires.
	items: Shared<List<T>>,
	/// The notification every observer rides, holding the log's sequence number as
	/// of the last write. One signal, so an observer that wakes always sees the
	/// list the ops it is about to drain produced (`KeyedCell`'s discipline).
	published: SignalCell<i32>,
	log: DeltaLog<SeqOp<T>>,
}

/// The one constructor body: every `ListCell` is a list, a notification and a log,
/// and the three public constructors differ only in the list and the log.
fun list_cell<T>(elements: List<T>, log: DeltaLog<SeqOp<T>>): ListCell<T> {
	ListCell { items = Shared::new(elements), published = SignalCell::new(0), log }
}

/// Fire a write's one notification, carrying the sequence the log is now at. Every
/// write calls it LAST — after the list is mutated and the op recorded — so an
/// observer that wakes reads a log that already explains the list it sees.
fun publish<T>(cell: ListCell<T>) {
	cell.published.set(cell.log.at());
}

export impl ListCell<type T> {
	/// An empty cell.
	fun new(): ListCell<T> {
		list_cell([], DeltaLog<SeqOp<T>>::new())
	}

	/// A cell holding `elements`. Nothing is recorded: a cursor minted after this
	/// reads the collection as its own starting point.
	fun of(elements: List<T>): ListCell<T> {
		list_cell(elements, DeltaLog<SeqOp<T>>::new())
	}

	/// A cell whose log has a ceiling other than `delta_log_limit` — what a test
	/// that wants to reach the lag path without writing a thousand ops asks for.
	fun with_limit(elements: List<T>, limit: usize): ListCell<T> {
		list_cell(elements, DeltaLog<SeqOp<T>>::with_limit(limit))
	}

	/// Read the list IN PLACE: `read` is lent the cell's own list for the length of
	/// the call and its answer is handed back — where `get` hands out a copy of the
	/// whole run (M86).
	///
	///     let total = rows.peek(|list| list.len());
	///     let third = rows.peek(|list| list.get(2));   // copies ONE element
	///
	/// `read` is for READING: it must not write this cell. The list it is lent is
	/// the list the cell holds, so a write made through the cell inside it is not a
	/// write to a copy.
	fun peek<U>(self, read: sync |&List<T>| U): U {
		// The cell's own list, lent as a second-class VIEW (`Weak::get`): a borrow,
		// where `self.items.read()` handed to a `&` parameter is a temporary read
		// the checker refuses (B400). The weak handle is taken from the handle
		// `self` holds, so the cell is alive for the whole call and the `None` arm
		// is unreachable.
		let weak = self.items.downgrade();
		match weak.get() {
			Some(let list) => read(list),
			None => panic("ListCell::peek: the cell's own list is gone while the cell holds it"),
		}
	}

	/// The element at `at` becomes `value` — an element changed IN PLACE.
	///
	/// Deliberately not a `splice` of one: to a per-element consumer the two are
	/// different events (`SeqOp::SetAt`'s comment), and the difference is whether
	/// the row's owner survives. Out of range is a no-op, like every other bounds
	/// question in this module.
	fun set_at(self, at: usize, value: T) {
		// `.get(at)` on the slot copies the one element, not the run.
		match self.items.read().get(at) {
			Some(let previous) => {
				self.items.write()[at] = value;
				self.log.record(SeqOp::SetAt(at, previous, value));
				publish(self);
			},
			None => {},
		}
	}

	/// `count` elements starting at `from` move to `to`, unchanged.
	///
	/// The one op nothing else in std emits (§3.1) — it is here so a consumer
	/// that wants to preserve a moved element's identity has a way to say so,
	/// and so `map_each` has something to forward.
	fun move_range(self, from: usize, count: usize, to: usize) {
		if count == 0 || from == to {
			ret;
		}
		mut lifted: List<T> = [];
		mut taken = 0;
		for taken < count {
			lifted.push(self.items.write().remove(from));
			taken += 1;
		}
		mut offset = 0;
		for offset < lifted.len() {
			match lifted.get(offset) {
				Some(let value) => self.items.write().insert(to + offset, value),
				None => {},
			}
			offset += 1;
		}
		self.log.record(SeqOp::Move(from, count, to));
		publish(self);
	}

	/// The BATCH door: hand `body` a recorder, then publish its whole run as ONE
	/// value write and one op per mutation it made.
	///
	/// Four mutations inside one `edit` are one notification and four ops — which
	/// is the point: a consumer wakes once and learns everything that happened,
	/// instead of waking four times.
	fun edit(self, body: sync |&mut Tracked<T>| void) {
		// The recorder works on a list of its OWN — the one copy a batch pays,
		// once for the whole batch.
		mut recorder = Tracked::new(self.items.read());
		body(&mut recorder);
		let produced = recorder.elements;
		let recorded = recorder.ops;
		self.items.write() = produced;
		for op in recorded {
			self.log.record(op);
		}
		publish(self);
	}

	/// How many ops the log is holding — what a pin on the trim reads.
	fun logged(self): usize {
		self.log.held()
	}
}

export impl ListCell<type T: PartialEq> {
	/// The COMPAT DOOR: take a whole list and record what CHANGED, instead of
	/// recording a `Reset` the way `set` does.
	///
	/// The diff is the cheap one — the common prefix, the common suffix, and
	/// ONE `Splice` over what is left between them — so an append, a prepend,
	/// an insertion, a removal and an in-place edit of a span each cost the
	/// elements they actually touch and nothing more. It is O(N) compares and
	/// zero derivations for every retained element, and it reads the held list
	/// in place rather than copying it (M86).
	///
	/// What it does NOT do is find a REORDER: a rotated list shares no prefix and
	/// no suffix, so it is one `Splice` over the whole run, which is honest (every
	/// element really did move) and is what `each`'s keyed pass is for. A source
	/// that knows it reordered says `move_range`.
	fun reconcile_to(self, items: List<T>) {
		let old_length = self.size();
		let new_length = items.len();
		mut prefix = 0;
		for prefix < old_length && prefix < new_length {
			if self.items.read()[prefix] != items[prefix] {
				jump break;
			}
			prefix += 1;
		}
		mut suffix = 0;
		for prefix + suffix < old_length && prefix + suffix < new_length {
			if self.items.read()[old_length - 1 - suffix] != items[new_length - 1 - suffix] {
				jump break;
			}
			suffix += 1;
		}
		let removed = old_length - prefix - suffix;
		mut arriving: List<T> = [];
		mut index = prefix;
		for index < new_length - suffix {
			match items.get(index) {
				Some(let value) => arriving.push(value),
				None => {},
			}
			index += 1;
		}
		// Identical lists: no op, no notification. `set` would publish anyway (it
		// never compares); this door exists precisely to compare.
		if removed == 0 && arriving.len() == 0 {
			ret;
		}
		self.splice(prefix, removed, arriving);
	}
}

export impl ListCell<type T> with Source<List<T>> {
	/// The whole list, as a value — a copy of the run. `peek` is the read that does
	/// not copy.
	fun get(self): List<T> {
		self.items.read()
	}

	/// The observer is handed the list as it stands when the notification is
	/// delivered, which is what a `SignalCell`'s observer is handed too.
	///
	/// The notification captures the ITEMS cell and not the cell handle (A132): the
	/// handle carries `published`, whose subscriber list is where this very closure
	/// is registered, so capturing it closed a loop under counting for every
	/// observer a `ListCell` ever had.
	[must_use]
	fun attach_observer(self, observer: |List<T>| void, immediately: bool): Subscription {
		let items = self.items;
		self.published.attach_observer(|_sequence| observer(items.read()), immediately)
	}

	/// The published cell's list is where a consumer's subscriber goes: it is
	/// notified exactly when the run changed, and the subscriber reads `get()`.
	[must_use]
	fun on_settle(self, subscriber: Subscriber): Subscription {
		self.published.on_settle(subscriber)
	}
}

export impl ListCell<type T> with Signal<List<T>> {
	/// The wholesale write: the collection BECAME this list, and the log says
	/// exactly that. Every delta consumer falls back to a rebuild, which is what
	/// `Reset` means and why `reconcile_to` exists beside it.
	fun set(self, value: List<T>) {
		self.items.write() = value;
		self.log.record(SeqOp::Reset(value));
		publish(self);
	}

	/// Publish the current value without changing it — and record NOTHING: a
	/// consumer draining the log after a bare notify is owed no ops, because
	/// nothing happened.
	fun notify(self) {
		self.published.notify();
	}
}

export impl ListCell<type T> with SequenceCell<T> {
	/// Read in place — the length, not a copy of the run (M86).
	fun size(self): usize {
		self.items.read().len()
	}

	/// The op is recorded BEFORE the write's single notification, so an observer
	/// that wakes reads a log that already explains the list it is about to see.
	/// (`KeyedCell`'s discipline, verbatim.) A splice that changes nothing —
	/// clamped to nothing taken and nothing arriving — records nothing and
	/// publishes nothing.
	fun splice(self, at: usize, removed: usize, inserted: List<T>) {
		let held = self.size();
		let start = splice_start(held, at);
		let taking = splice_count(held, start, removed);
		if taking == 0 && inserted.len() == 0 {
			ret;
		}
		self.log.record(splice_in_place(self.items.write(), start, taking, inserted));
		publish(self);
	}
}

export impl ListCell<type T> with DeltaSource<List<T>, SeqOp<T>> {
	fun cursor(self): DeltaCursor {
		self.log.cursor()
	}

	fun drop_cursor(self, cursor: DeltaCursor) {
		self.log.drop_cursor(cursor);
	}

	fun since(self, cursor: DeltaCursor): List<SeqOp<T>> {
		list_cell_since(self.log, self.items, cursor)
	}

	/// The log and the items, and not `published` (A132).
	fun reader(self): |DeltaCursor| List<SeqOp<T>> {
		let log = self.log;
		let items = self.items;
		|cursor| list_cell_since(log, items, cursor)
	}
}

/// `ListCell::since`'s body over the two parts it reads, so the cell and its
/// `reader` answer from one place.
fun list_cell_since<T>(
	log: DeltaLog<SeqOp<T>>,
	items: Shared<List<T>>,
	cursor: DeltaCursor,
): List<SeqOp<T>> {
	match log.since(cursor) {
		// A cursor that lost history is told the collection: the cell knows what a
		// `Reset` is for its shape and the log does not.
		None => {
			mut lost: List<SeqOp<T>> = [];
			lost.push(SeqOp::Reset(items.read()));
			lost
		},
		Some(let recorded) => recorded,
	}
}

/// THE FIRST DERIVATIVE: `map g`, element-wise and incrementally.
///
/// `map_each(source, g)` is `source.get().map(g)` kept up to date by running `g`
/// once per element that ARRIVES or CHANGES, and zero times for anything else.
/// Three pushes are three calls; a removal is none; a `Reset` — a wholesale `set`,
/// or a cursor that fell behind the log — is the honest N.
///
///     let raw: ListCell<str> = ListCell<str>::new();
///     let parsed = map_each(raw, |text| text.parse_f64().unwrap_or(0f));
///     raw.push("10.5");   // `g` runs ONCE
///
/// It takes any `S: DeltaSource<List<T>, SeqOp<T>>`, not a `ListCell`, so it serves
/// a local cell, `std::rpc`'s `KeyedCell` and anything an app writes.
///
/// **Ownership.** A DERIVATION (A110 door 2): it publishes rather than acts, so an
/// effect on the result reads it settled. The subscription is the ambient owner's
/// like every other combinator's (A28), and the cursor goes with it — a disposed
/// derivation stops pinning the source's history.
///
/// **Purity.** `g` runs once per element and its result is kept, so it must be pure
/// IN THE ELEMENT: a `g` that reads another signal will not re-run when that signal
/// changes. That is the same contract `map` has always had, made sharper by the
/// fact that nothing re-runs it.
export fun map_each<T, U, S: DeltaSource<List<T>, SeqOp<T>>>(
	source: S,
	g: sync |T| U,
): ListCell<U> {
	// The cursor is minted BEFORE the seed is read, so the seed is exactly the
	// state the cursor names and nothing can fall between them.
	let cursor = source.cursor();
	let out: ListCell<U> = ListCell<U>::of(source.get().map(g));
	as_derivation();
	// The READER, not the source (A132): the handler is registered on the source's
	// notification, so a handler holding the source was a loop no count could
	// collect.
	let read = source.reader();
	// `on_change`, through the blanket `Flow` over `Source` (F58 built that hop
	// natively). Not `attach_observer` directly: through this SUBTRAIT bound a
	// supertrait default's override is not dispatched (both backends), and
	// `Source`'s default captures the source, the loop A132 took out; the blanket's
	// own `Source` bound reaches the cell's override.
	let _owned = register_with_owner(source.on_change(|_published| {
		for op in read(cursor) {
			match op {
				// The derivative of `map g`: what arrived, mapped. Nothing else is
				// read, and `g` runs exactly `inserted.len()` times.
				SeqOp::Splice(let at, let removed, let inserted) => {
					out.splice(at, removed.len(), inserted.map(g));
				},
				SeqOp::SetAt(let at, let _was, let value) => out.set_at(at, g(value)),
				// The honest N: the collection became something else, so the
				// derived collection does too.
				SeqOp::Reset(let items) => out.set(items.map(g)),
				// A reorder maps to a reorder — no element changed, so `g` runs
				// zero times.
				SeqOp::Move(let from, let count, let to) => out.move_range(from, count, to),
			}
		}
	}));
	defer_to_owner(|| source.drop_cursor(cursor));
	out
}

// === Collection pipes (A142 S4, `proposal/reactive-layers.md` §6) ============
//
// §3's split, one level up. A collection OPERATOR (`map`, `filter`, `filter_map`,
// `any`/`all`/`count`, `flatten`) returns a move-only COLLECTION PIPE (R33), and a
// pipe is consumed once: sealed with `.memo()` into a `CollSource<T>`, handed to
// `each`/`each_by`, or read once with `.sample()`. What travels between stages is
// not a value but the change: a stage is started once for its one consumer, seeds
// from a snapshot, and from then on answers the ops since the last drain —
// `SeqOp`, the shape's one vocabulary (A112), so an operator is written once per
// shape and serves every cell kind.
//
// **Operators follow the reactive value their closure returns (R9).** A closure
// may answer a plain value or a `Flow`; the result trait (`IntoFlow`, R31) is
// resolved per closure when the code is generated, so `filter(|x| x > 3)` never
// subscribes, and `filter(|src| src.is_pending())` starts the pipe `is_pending`
// builds for each element and follows it. A flow-following element holds ONE
// subscription, and a change there re-reads one element and emits one op (§6.2).
//
// **Every run has an owner (§6.4), allocated lazily.** An operator's closure runs
// once per element that arrives and again per element that changes, under the
// stage's scratch owner; what a run registers is split off into an owner of the
// element's own, released when the element leaves or re-runs. A run that registers
// nothing and answers a plain value leaves no record at all — the element is a slot
// id and a value in the stage's lists.

/// A STARTED collection flow — `Instance`'s twin for a collection's one consumer.
///
/// The consumer reads `snapshot` once, at its start, as its seed; attaches its ONE
/// subscriber; and on every wake-up calls `drain`, which answers what changed since
/// the last drain (the first drain: since the snapshot) as ops. Disposing the
/// attach handle detaches every registration the instance made, and `release`
/// releases what its bodies built — the consumer chains it onto the handle.
export struct CollInstance<T> {
	snapshot: || List<T>,
	attach: |Subscriber| Subscription,
	drain: || List<SeqOp<T>>,
	release: || void,
}

/// Anything a collection pipeline starts from: every `CollSource` (through the
/// blanket below) and every collection pipe stage. It carries the operators; the
/// sealing operations are `CollPipe`'s.
///
/// `[resource]`, like `Flow` (R39): a stage is move-only, and its object is too. A
/// source is data — the blanket's `own self` on a `ListCell` is a copy of the
/// handle.
export [resource] trait CollFlow<T> {
	/// Start this collection flow for its one consumer — the node author's member.
	[must_use]
	fun open(own self): CollInstance<T>;
}

/// A granular collection source (R23): a `Source<List<T>>` whose writes are its
/// ops, so a collection pipeline can start from it without diffing. `ListCell` is
/// one, and so is what `.memo()` seals a collection pipe into (`ListMemo`).
///
/// A COARSE source — a `SignalCell<List<T>>`, a derivation of a list — is not: the
/// change description was thrown away upstream, and the only way back is a diff,
/// which is spelled at the boundary (`.coll_by(key)`, `.coll()`, R10 / §6.3).
export trait CollSource<T> with DeltaSource<List<T>, SeqOp<T>> {}

/// Every granular source starts as a collection flow: a cursor into its log,
/// minted before the seed is read (`map_each`'s order), drained through the
/// source's `reader` (A132), and retired at the release.
export impl type S: CollSource<type T> with CollFlow<T> {
	fun open(own self): CollInstance<T> {
		let cursor = self.cursor();
		let read = self.reader();
		CollInstance<T> {
			snapshot = || self.get(),
			attach = |subscriber: Subscriber| self.on_settle(subscriber),
			drain = || read(cursor),
			release = || self.drop_cursor(cursor),
		}
	}
}

export impl ListCell<type T> with CollSource<T> {}

/// A collection TRANSFORMATION (R33): a `CollFlow` with no `get`, consumed exactly
/// once — sealed here, or handed to `each`/`each_by`. The stage types are
/// `[resource]`s and implement this with no body.
///
/// **Sharing is sealing**, as for a scalar pipe (§3.3): two consumers of one
/// derived collection need a `CollSource` between them.
///
///     let loaded = ids.map(|id| fetch_row(id)).memo();   // one instance
///     let pending = loaded.any(|row| row.is_pending()).memo();
///     each(loaded, |row| row.id, render);                 // a source is data
export [resource] trait CollPipe<T> with CollFlow<T> {
	/// Seal into a READ-ONLY granular source (R23): the pipe's one consumer, its
	/// ops applied to one `ListCell` as they arrive, the collection cached for
	/// every reader. Owner-tied like `Pipe::memo` (A28); a module binding says
	/// `.memo_global()`.
	fun memo(own self): ListMemo<T> {
		ListMemo<T> { cell = seal_collection(self.open(), true) }
	}

	/// `.memo()` for a collection that lives as long as the PROGRAM (A130).
	fun memo_global(own self): ListMemo<T> {
		ListMemo<T> { cell = seal_collection(self.open(), false) }
	}

	/// A one-off read (R32): start the pipe, take the collection, release it —
	/// including anything its per-element runs built.
	fun sample(own self): List<T> {
		let instance = self.open();
		let value = (instance.snapshot)();
		(instance.release)();
		value
	}
}

/// The seal both `memo`s share: seed a `ListCell` from the snapshot and apply every
/// drain to it, op for op, so the cell's own log says what the pipe said — a
/// consumer of the sealed source is told the same changes, not a diff of them. A
/// DERIVATION (A110 door 2): it publishes, so an effect over it reads it settled.
fun seal_collection<T>(instance: CollInstance<T>, owned: bool): ListCell<T> {
	let sealed: ListCell<T> = ListCell<T>::of(fresh_list((instance.snapshot)()));
	let drain = instance.drain;
	if owned {
		let refreshed = (instance.attach)(subscriber_of(|| apply_ops(sealed, drain()), true));
		also_releasing(refreshed, instance.release);
		let _owned = register_with_owner(refreshed);
	} else {
		// NAMED for the no-cycle gate, as `Pipe::cell_global`'s refresh is: the
		// loop a program-lifetime seal holds is the design (`reactive-pipeline.md`
		// §2.4).
		let cell_global_refresh = || apply_ops(sealed, drain());
		let _for_the_program = (instance.attach)(subscriber_of(cell_global_refresh, true));
	}
	sealed
}

/// A copy of `list` built element by element — the seed of a cell a stage will
/// write IN PLACE. Handing a list read out of another cell to `Shared::new` does
/// not copy it today (collections-44's find: the argument is not an `own`
/// parameter, so the JS backend aliases the two cells and a write through one is
/// visible in the other), so every list a stage stores is built here.
fun fresh_list<T>(list: List<T>): List<T> {
	mut copy: List<T> = [];
	for item in list {
		copy.push(item);
	}
	copy
}

/// Write `ops` into `cell` as the same ops: a splice as a splice, an in-place
/// change as `set_at`, a reorder as `move_range`, a reset as `set`.
fun apply_ops<T>(cell: ListCell<T>, ops: List<SeqOp<T>>) {
	for op in ops {
		match op {
			SeqOp::Splice(let at, let removed, let inserted) => cell.splice(at, removed.len(), inserted),
			SeqOp::SetAt(let at, let _was, let value) => cell.set_at(at, value),
			SeqOp::Reset(let items) => cell.set(items),
			SeqOp::Move(let from, let count, let to) => cell.move_range(from, count, to),
		}
	}
}

/// What `.memo()` seals a collection pipe into: a read-only granular source over
/// one `ListCell` (R23, R28's read-only face). It is a `CollSource`, so a pipeline
/// starts from it again, `each` follows its ops, and it is data — pass it anywhere.
export [hint(CollSource<T>)]
struct ListMemo<T> {
	cell: ListCell<T>,
}

export impl ListMemo<type T> {
	/// Read the collection in place, as `ListCell::peek` does.
	fun peek<U>(self, read: sync |&List<T>| U): U {
		self.cell.peek(read)
	}

	/// How many elements it holds — read in place.
	fun size(self): usize {
		self.cell.size()
	}
}

export impl ListMemo<type T> with Source<List<T>> {
	fun get(self): List<T> {
		self.cell.get()
	}

	[must_use]
	fun attach_observer(self, observer: |List<T>| void, immediately: bool): Subscription {
		self.cell.attach_observer(observer, immediately)
	}

	[must_use]
	fun on_settle(self, subscriber: Subscriber): Subscription {
		self.cell.on_settle(subscriber)
	}
}

export impl ListMemo<type T> with DeltaSource<List<T>, SeqOp<T>> {
	fun cursor(self): DeltaCursor {
		self.cell.cursor()
	}

	fun drop_cursor(self, cursor: DeltaCursor) {
		self.cell.drop_cursor(cursor);
	}

	fun since(self, cursor: DeltaCursor): List<SeqOp<T>> {
		self.cell.since(cursor)
	}

	fun reader(self): |DeltaCursor| List<SeqOp<T>> {
		self.cell.reader()
	}
}

export impl ListMemo<type T> with CollSource<T> {}

// --- What a closure answers (R9, R31, R35) -----------------------------------

/// One element's closure result, started: a plain value, or the instance of the
/// flow it answered.
export enum ElementRun<T> {
	/// A plain value — no subscription, nothing to release.
	Constant(T),
	/// A started flow: the element's value is its `pull`, and it is followed.
	Live(Instance<T>),
}

/// The result trait of a FOLLOWING operator — `filter`, `filter_map`, `any`,
/// `all`, `count` (R22, renamed by R31). A closure answering a plain value is a
/// constant; one answering any `Flow` — a source or a pipe — has that flow started
/// for the element and followed. The implementation is chosen per closure when the
/// code is generated (B158's tiers, as `MaybeSignal`'s), so a plain predicate pays
/// for nothing.
export trait IntoFlow<T> {
	/// Start this answer for one element.
	fun start_element(own self): ElementRun<T>;
}

/// A plain value: a constant, no subscription.
export impl type T with IntoFlow<T> {
	fun start_element(own self): ElementRun<T> {
		ElementRun<T>::Constant(self)
	}
}

/// A flow — a source or a pipe: started per element and followed.
export impl type F: Flow<type T> with IntoFlow<T> {
	fun start_element(own self): ElementRun<T> {
		ElementRun<T>::Live(self.start())
	}
}

/// `map`'s result trait (R35). A returned PIPE is started per element and its value
/// carried — a pipe cannot be an element, so that is the only thing it can mean.
/// Anything else, a `Source` included, IS the element: `ids.map(open_mirror)` is a
/// collection OF sources, and `.flatten()` is the explicit follow.
export trait IntoElement<T> {
	/// Start this answer for one element.
	fun start_element_value(own self): ElementRun<T>;
}

/// A value — a source included — is the element itself.
export impl type T with IntoElement<T> {
	fun start_element_value(own self): ElementRun<T> {
		ElementRun<T>::Constant(self)
	}
}

/// A pipe is started per element, and the element is its value.
export impl type P: Pipe<type T> with IntoElement<T> {
	fun start_element_value(own self): ElementRun<T> {
		ElementRun<T>::Live(self.start())
	}
}

// --- The per-element core (§6.2, §6.4) ---------------------------------------

/// A followed element's live parts: its flow's instance and the handle on it, and
/// the owner its run's registrations were split into. A plain element that
/// registered nothing has no record; one that registered something and answered a
/// plain value has a record that follows nothing (`follows` false, a `pull` that
/// answers the value, a `release` that does nothing). Closures are held bare rather
/// than as `Option`s, which the native backend does not hold.
struct ElementHold<V> {
	follows: bool,
	pull: || V,
	handle: Option<Subscription>,
	release: || void,
	owner: Option<Owner>,
}

/// How many element records collection stages have made since the program started —
/// the instrument behind "a plain `filter` allocates nothing per element" (A142
/// §6.1). A pin's instrument; it decides nothing.
let element_holds_allocated_count: Shared<i32> = Shared::new(0);

export [internal("an instrument for the per-element allocation pin (A142 §6.1); it counts, it decides nothing")]
fun element_holds_allocated(): i32 {
	element_holds_allocated_count.read()
}

/// One element change the core resolved, in the core's positions: what the
/// operators translate into their own ops.
enum ElementEvent<T, V> {
	/// At `at`, the elements (and their values) that left, and those that arrived.
	Spliced(usize, List<(T, V)>, List<(T, V)>),
	/// The element at `at` changed: the old pair, then the new. `true` when its
	/// INPUT was replaced (an upstream `SetAt`, so the element re-ran); `false`
	/// when only the flow it answered moved (the input is the same).
	Changed(usize, (T, V), (T, V), bool),
	/// The collection became these, and these left.
	Reset(List<(T, V)>, List<(T, V)>),
	/// `count` elements moved from `from` to `to`, unchanged.
	Moved(usize, usize, usize),
}

/// The per-element state every following operator keeps, as PARALLEL lists, so an
/// element costs a slot id, its input and its value and nothing else unless its run
/// needed an owner or answered a flow (`holds`, keyed by slot id).
///
/// **Stable slot ids (§6.2).** An element's position moves under splices, so its
/// followed flow's subscriber names the SLOT, and the core looks the slot's current
/// position up when it resolves the change.
struct ElementCore<T, V> {
	ids: Shared<List<i32>>,
	items: Shared<List<T>>,
	values: Shared<List<V>>,
	holds: Shared<NativeMap<ElementHold<V>>>,
	/// Slots whose followed flow changed since the last resolve, in arrival order.
	dirty: Shared<List<i32>>,
	next_id: Shared<i32>,
	/// The stage's scratch owner: every run starts here, and is split off only when
	/// it registered something.
	stage: Owner,
	/// The consumer's subscriber, once attached: a followed flow wakes it.
	consumer: Shared<Option<Subscriber>>,
	/// One element's run: the operator's closure, under `stage`, its answer
	/// started.
	run: |T| (ElementRun<V>, Option<Owner>),
}

fun element_core<T, V>(stage: Owner, run: |T| (ElementRun<V>, Option<Owner>)): ElementCore<T, V> {
	// Every empty container is annotated: a struct-literal field does not direct a
	// generic call's element type (`HashSet::new`'s note), and the native backend
	// spells every type it holds.
	let ids: List<i32> = [];
	let items: List<T> = [];
	let values: List<V> = [];
	let holds: NativeMap<ElementHold<V>> = NativeMap::new();
	let dirty: List<i32> = [];
	let consumer: Option<Subscriber> = None;
	ElementCore<T, V> {
		ids = Shared::new(ids),
		items = Shared::new(items),
		values = Shared::new(values),
		holds = Shared::new(holds),
		dirty = Shared::new(dirty),
		next_id = Shared::new(0),
		stage,
		consumer = Shared::new(consumer),
		run,
	}
}

/// Run the closure for `item` and admit the answer: a slot id, and the value now. A
/// flow is attached here, with a relay that marks the slot and wakes the consumer.
fun admit<T, V>(core: ElementCore<T, V>, item: T): (i32, V) {
	let id = core.next_id.read();
	core.next_id.write() = id + 1;
	let (answer, owner) = (core.run)(item);
	match answer {
		ElementRun::Constant(let value) => {
			match owner {
				Some(let held) => keep_hold(core, id, ElementHold<V> {
					follows = false,
					pull = || value,
					handle = None,
					release = || {},
					owner = Some(held),
				}),
				None => {},
			}
			(id, value)
		},
		ElementRun::Live(let instance) => {
			let pull = instance.pull;
			let dirty = core.dirty;
			let consumer = core.consumer;
			let handle = (instance.attach)(subscriber_of(|| {
				dirty.write().push(id);
				match consumer.read() {
					Some(let downstream) => wake(downstream),
					None => {},
				}
			}, true));
			keep_hold(core, id, ElementHold<V> {
				follows = true,
				pull,
				handle = Some(handle),
				release = instance.release,
				owner,
			});
			(id, pull())
		},
	}
}

fun keep_hold<T, V>(core: ElementCore<T, V>, id: i32, hold: ElementHold<V>) {
	element_holds_allocated_count.write() = element_holds_allocated_count.read() + 1;
	core.holds.write().insert(id.hash(), hold);
}

/// Release what slot `id`'s run built: its subscription, its flow's instance, its
/// owner. A plain element has nothing to release.
fun retire<T, V>(core: ElementCore<T, V>, id: i32) {
	match core.holds.read().get(id.hash()) {
		Some(let hold) => {
			core.holds.write().remove(id.hash());
			match hold.handle {
				Some(let handle) => detach(handle),
				None => {},
			}
			(hold.release)();
			match hold.owner {
				Some(let owner) => owner.dispose(),
				None => {},
			}
		},
		None => {},
	}
}

/// Seed the core from `items`, in order.
fun seed<T, V>(core: ElementCore<T, V>, items: List<T>) {
	for item in items {
		let (id, value) = admit(core, item);
		core.ids.write().push(id);
		core.items.write().push(item);
		core.values.write().push(value);
	}
}

/// The pairs the core holds at `at .. at + count`.
fun held_pairs<T, V>(core: ElementCore<T, V>, at: usize, count: usize): List<(T, V)> {
	mut pairs: List<(T, V)> = [];
	mut index = at;
	for index < at + count {
		pairs.push((core.items.read()[index], core.values.read()[index]));
		index += 1;
	}
	pairs
}

/// Everything the core holds, as pairs.
fun all_pairs<T, V>(core: ElementCore<T, V>): List<(T, V)> {
	held_pairs(core, 0, core.ids.read().len())
}

/// Apply the upstream's ops, then the followed flows that changed, and answer the
/// element events they made — in order, positions as of each event.
fun resolve<T, V>(core: ElementCore<T, V>, ops: List<SeqOp<T>>): List<ElementEvent<T, V>> {
	mut events: List<ElementEvent<T, V>> = [];
	for op in ops {
		match op {
			SeqOp::Splice(let at, let removed, let inserted) => {
				let held = core.ids.read().len();
				let start = splice_start(held, at);
				let taking = splice_count(held, start, removed.len());
				let left = held_pairs(core, start, taking);
				mut taken = 0;
				for taken < taking {
					let id = core.ids.write().remove(start);
					retire(core, id);
					let _item = core.items.write().remove(start);
					let _value = core.values.write().remove(start);
					taken += 1;
				}
				mut arrived: List<(T, V)> = [];
				mut offset = 0;
				for item in inserted {
					let (id, value) = admit(core, item);
					core.ids.write().insert(start + offset, id);
					core.items.write().insert(start + offset, item);
					core.values.write().insert(start + offset, value);
					arrived.push((item, value));
					offset += 1;
				}
				events.push(ElementEvent::Spliced(start, left, arrived));
			},
			SeqOp::SetAt(let at, let _was, let item) => {
				match core.ids.read().get(at) {
					Some(let old_id) => {
						let before = (core.items.read()[at], core.values.read()[at]);
						// The element RE-RUNS: its last run is released first, and
						// the new run is a slot of its own (a wake the old run
						// queued is skipped, its slot gone).
						retire(core, old_id);
						let (id, value) = admit(core, item);
						core.ids.write()[at] = id;
						core.items.write()[at] = item;
						core.values.write()[at] = value;
						events.push(ElementEvent::Changed(at, before, (item, value), true));
					},
					None => {},
				}
			},
			SeqOp::Reset(let items) => {
				let left = all_pairs(core);
				for id in core.ids.read() {
					retire(core, id);
				}
				core.ids.write() = [];
				core.items.write() = [];
				core.values.write() = [];
				seed(core, items);
				events.push(ElementEvent::Reset(left, all_pairs(core)));
			},
			SeqOp::Move(let from, let count, let to) => {
				mut lifted_ids: List<i32> = [];
				mut lifted_items: List<T> = [];
				mut lifted_values: List<V> = [];
				mut taken = 0;
				for taken < count {
					lifted_ids.push(core.ids.write().remove(from));
					lifted_items.push(core.items.write().remove(from));
					lifted_values.push(core.values.write().remove(from));
					taken += 1;
				}
				mut offset = 0;
				for offset < count {
					core.ids.write().insert(to + offset, lifted_ids[offset]);
					core.items.write().insert(to + offset, lifted_items[offset]);
					core.values.write().insert(to + offset, lifted_values[offset]);
					offset += 1;
				}
				events.push(ElementEvent::Moved(from, count, to));
			},
		}
	}
	// The followed flows that moved. Each slot is re-read once however many times
	// it woke, and a slot the ops above retired is skipped: its element left.
	let woke = core.dirty.read();
	if woke.len() > 0 {
		core.dirty.write() = [];
		mut positions: NativeMap<usize> = NativeMap::new();
		mut index = 0;
		for id in core.ids.read() {
			positions.insert(id.hash(), index);
			index += 1;
		}
		mut seen: NativeMap<bool> = NativeMap::new();
		for id in woke {
			if seen.contains_key(id.hash()) {
				jump continue;
			}
			seen.insert(id.hash(), true);
			match positions.get(id.hash()) {
				Some(let at) => match core.holds.read().get(id.hash()) {
					Some(let hold) => {
						if hold.follows {
							let item = core.items.read()[at];
							let before = core.values.read()[at];
							let now = (hold.pull)();
							core.values.write()[at] = now;
							events.push(ElementEvent::Changed(at, (item, before), (item, now), false));
						}
					},
					None => {},
				},
				None => {},
			}
		}
	}
	events
}

/// Release every element's run, then the stage's own owner (whatever registered
/// into it late, and the tasks its runs started).
fun release_core<T, V>(core: ElementCore<T, V>) {
	for id in core.ids.read() {
		retire(core, id);
	}
	core.stage.dispose();
}

/// A core-backed stage's instance: the upstream's attach forwarded (the consumer's
/// one subscriber) with the subscriber remembered for the followed flows to wake,
/// and a release that takes the elements' runs down with the upstream.
fun core_attach<T, V>(
	core: ElementCore<T, V>,
	upstream: CollInstance<T>,
): |Subscriber| Subscription {
	let consumer = core.consumer;
	let attach = upstream.attach;
	|subscriber: Subscriber| {
		consumer.write() = Some(subscriber);
		attach(subscriber)
	}
}

fun core_release<T, V>(core: ElementCore<T, V>, upstream: CollInstance<T>): || void {
	let release = upstream.release;
	|| {
		release_core(core);
		release();
	}
}

// --- The Fenwick index (§6.2) --------------------------------------------------

/// Output positions for `filter`/`filter_map`: an element's position in the output
/// is the count of KEPT elements before it. A Fenwick tree over kept/dropped gives
/// it in O(log n) and moves it in O(log n) when one element flips; the input's
/// splices rebuild it, O(n), which is what the splice already cost.
///
/// One-based internally: `tree[i]` covers the `lowbit(i)` flags ending at `i`.
struct KeptIndex {
	tree: Shared<List<i32>>,
}

fun kept_index(flags: List<bool>): KeptIndex {
	let index = KeptIndex { tree = Shared::new([]) };
	rebuild_kept(index, flags);
	index
}

/// Rebuild from `flags` in O(n): each node adds itself into its parent.
fun rebuild_kept(index: KeptIndex, flags: List<bool>) {
	mut tree: List<i32> = [0];
	for flag in flags {
		tree.push(if flag { 1 } else { 0 });
	}
	let size = flags.len().as_i32();
	mut at = 1;
	for at <= size {
		let parent = at + (at & (0 - at));
		if parent <= size {
			tree[parent.as_usize()] = tree[parent.as_usize()] + tree[at.as_usize()];
		}
		at += 1;
	}
	index.tree.write() = tree;
}

/// How many flags before `position` are set.
fun kept_before(index: KeptIndex, position: usize): usize {
	mut total = 0;
	mut at = position.as_i32();
	for at > 0 {
		total += index.tree.read()[at.as_usize()];
		at = at - (at & (0 - at));
	}
	total.as_usize()
}

/// Flag `position` flipped by `delta` (+1 kept, -1 dropped).
fun kept_add(index: KeptIndex, position: usize, delta: i32) {
	let size = index.tree.read().len().as_i32() - 1;
	mut at = position.as_i32() + 1;
	for at <= size {
		index.tree.write()[at.as_usize()] = index.tree.read()[at.as_usize()] + delta;
		at = at + (at & (0 - at));
	}
}

// --- The operators (§6.1) ----------------------------------------------------

/// The operators every collection flow has — a BLANKET over `CollFlow`, as `Flow`'s
/// combinators are, so a granular source and a collection pipe both have them. A
/// coarse `Source<List<T>>` does not: it converts at the boundary (`.coll()`,
/// `.coll_by(key)`).
///
/// Every closure is a BODY (`derive`'s shape, R14): it runs once per element that
/// arrives and again per element that changes, under an owner of the run's own that
/// is released when the element leaves or re-runs (§6.4) — allocated only when the
/// run registers something.
export impl type F: CollFlow<type T> {
	/// Each element through `transform` (R35). A returned PIPE is started per
	/// element and its value carried (`ids.map(|id| total_of(id))` follows each
	/// total); a returned `Source` is the element itself — `ids.map(open_mirror)` is
	/// a collection OF mirrors, and `.flatten()` follows them. A changed element is
	/// `SetAt(i, old, new)` (§6.2).
	fun map<R>(
		own self,
		transform: (sync |T| R) context (owner_scope, ambient_nursery),
	): CollMap<F, T, R> {
		CollMap<F, T, R> { up = self, transform }
	}

	/// The elements `keep` answers `true` for, following a flow it answers (R9): an
	/// element that flips in or out is a `Splice` at its OUTPUT position, the count
	/// of kept elements before it (the Fenwick index, §6.2). `filter(|x| x > 3)`
	/// subscribes to nothing and keeps no per-element record.
	fun filter<R>(
		own self,
		keep: (sync |T| R) context (owner_scope, ambient_nursery),
	): CollFilter<F, T, R> {
		CollFilter<F, T, R> { up = self, keep }
	}

	/// `map` and `filter` at once: the elements `select` answers `Some` for, as
	/// their payloads, following a flow it answers. `filter_map(|x| x)` over a
	/// collection of `Option`-valued flows is the join §6.3 ends with; a closure
	/// answering `Option<Source<X>>` keeps the sources (it binds `U = Source<X>`
	/// and does not flatten).
	fun filter_map<R>(
		own self,
		select: (sync |T| R) context (owner_scope, ambient_nursery),
	): CollFilterMap<F, T, R> {
		CollFilterMap<F, T, R> { up = self, select }
	}

	/// Whether `test` answers `true` for ANY element — a pipe of `bool`, sealed
	/// with `.memo()` (R21). A counter: an element that arrives, leaves or flips
	/// moves it by one, O(1) per change, so a thousand pending mirrors cost nothing
	/// to watch.
	fun any<R>(
		own self,
		test: (sync |T| R) context (owner_scope, ambient_nursery),
	): CollTally<F, T, R, bool> {
		CollTally<F, T, R, bool> { up = self, test, finish = |kept: usize, total: usize| kept > 0 }
	}

	/// Whether `test` answers `true` for EVERY element (and so for none of none).
	fun all<R>(
		own self,
		test: (sync |T| R) context (owner_scope, ambient_nursery),
	): CollTally<F, T, R, bool> {
		CollTally<F, T, R, bool> {
			up = self,
			test,
			finish = |kept: usize, total: usize| kept == total,
		}
	}

	/// How many elements `test` answers `true` for.
	fun count<R>(
		own self,
		test: (sync |T| R) context (owner_scope, ambient_nursery),
	): CollTally<F, T, R, usize> {
		CollTally<F, T, R, usize> { up = self, test, finish = |kept: usize, total: usize| kept }
	}
}

/// A collection of SOURCES, followed (§3.1's explicit flatten): the value of each
/// element's source, and a `SetAt` when one of them changes. `map` never does this
/// for a returned source — a source is data and may BE the element.
export impl type F: CollFlow<type S: Source<type U>> {
	fun flatten(own self): CollFlatten<F, S, U> {
		CollFlatten<F, S, U> { up = self }
	}
}

/// `map` as a stage.
export [resource] struct CollMap<F, T, R> {
	up: F,
	transform: (|T| R) context (owner_scope, ambient_nursery),
}

export impl CollMap<type F: CollFlow<type T>, T, type R: IntoElement<type U>> with CollFlow<U> {
	fun open(own self): CollInstance<U> {
		let transform = self.transform;
		let upstream = self.up.open();
		let stage = Owner::new();
		let core: ElementCore<T, U> = element_core(stage, |item: T| {
			let (answer, owner) = run_element(stage, || transform(item));
			(answer.start_element_value(), owner)
		});
		seed(core, (upstream.snapshot)());
		let drain = upstream.drain;
		CollInstance<U> {
			snapshot = || fresh_list(core.values.read()),
			attach = core_attach(core, upstream),
			drain = || mapped_ops(resolve(core, drain())),
			release = core_release(core, upstream),
		}
	}
}

export impl CollMap<type F: CollFlow<type T>, T, type R: IntoElement<type U>> with CollPipe<U> {}

/// `map`'s derivative: every event, its values.
fun mapped_ops<T, U>(events: List<ElementEvent<T, U>>): List<SeqOp<U>> {
	mut ops: List<SeqOp<U>> = [];
	for event in events {
		match event {
			ElementEvent::Spliced(let at, let left, let arrived) => {
				ops.push(SeqOp::Splice(at, left.map(|pair| pair.1), arrived.map(|pair| pair.1)));
			},
			ElementEvent::Changed(let at, let before, let after, let _rerun) => {
				ops.push(SeqOp::SetAt(at, before.1, after.1));
			},
			ElementEvent::Reset(let _left, let now) => ops.push(SeqOp::Reset(now.map(|pair| pair.1))),
			ElementEvent::Moved(let from, let count, let to) => ops.push(SeqOp::Move(from, count, to)),
		}
	}
	ops
}

/// `flatten` as a stage: `map` over the identity, every element followed.
export [hint(CollPipe<U>)]
[resource] struct CollFlatten<F, S, U> {
	up: F,
}

export impl CollFlatten<type F: CollFlow<type S>, type S: Source<type U>, U> with CollFlow<U> {
	fun open(own self): CollInstance<U> {
		let upstream = self.up.open();
		// Each source is started as the `Source` blanket starts one, written out:
		// read with `get`, attached with `on_settle`, nothing to release.
		let core: ElementCore<S, U> = element_core(Owner::new(), |source: S| {
			(ElementRun<U>::Live(Instance<U> { pull = || source.get(), attach = |subscriber: Subscriber| source.on_settle(subscriber), release = || {} }), None)
		});
		seed(core, (upstream.snapshot)());
		let drain = upstream.drain;
		CollInstance<U> {
			snapshot = || fresh_list(core.values.read()),
			attach = core_attach(core, upstream),
			drain = || mapped_ops(resolve(core, drain())),
			release = core_release(core, upstream),
		}
	}
}

export impl CollFlatten<type F: CollFlow<type S>, type S: Source<type U>, U> with CollPipe<U> {}

/// `filter` as a stage: the core's `bool` per element, a mirror of it the events
/// are replayed on (their positions are each event's own), and the Fenwick index
/// over the mirror.
export [hint(CollPipe<T>)]
[resource] struct CollFilter<F, T, R> {
	up: F,
	keep: (|T| R) context (owner_scope, ambient_nursery),
}

export impl CollFilter<type F: CollFlow<type T>, T, type R: IntoFlow<bool>> with CollFlow<T> {
	fun open(own self): CollInstance<T> {
		let keep = self.keep;
		let upstream = self.up.open();
		let stage = Owner::new();
		let core: ElementCore<T, bool> = element_core(stage, |item: T| {
			let (answer, owner) = run_element(stage, || keep(item));
			(answer.start_element(), owner)
		});
		seed(core, (upstream.snapshot)());
		let kept: Shared<List<bool>> = Shared::new(fresh_list(core.values.read()));
		let index = kept_index(kept.read());
		let drain = upstream.drain;
		CollInstance<T> {
			snapshot = || {
				mut out: List<T> = [];
				mut at = 0;
				for item in core.items.read() {
					if core.values.read()[at] {
						out.push(item);
					}
					at += 1;
				}
				out
			},
			attach = core_attach(core, upstream),
			drain = || kept_ops(kept, index, resolve(core, drain()), |pair: (T, bool)| {
				if pair.1 {
					Some(pair.0)
				} else {
					None
				}
			}, false),
			release = core_release(core, upstream),
		}
	}
}

export impl CollFilter<type F: CollFlow<type T>, T, type R: IntoFlow<bool>> with CollPipe<T> {}

/// `filter_map` as a stage: `filter`'s index over `is_some`, the payloads out.
export [resource] struct CollFilterMap<F, T, R> {
	up: F,
	select: (|T| R) context (owner_scope, ambient_nursery),
}

export impl CollFilterMap<type F: CollFlow<type T>, T, type R: IntoFlow<Option<type U>>> with CollFlow<
	U,
> {
	fun open(own self): CollInstance<U> {
		let select = self.select;
		let upstream = self.up.open();
		let stage = Owner::new();
		let core: ElementCore<T, Option<U>> = element_core(stage, |item: T| {
			let (answer, owner) = run_element(stage, || select(item));
			(answer.start_element(), owner)
		});
		seed(core, (upstream.snapshot)());
		mut flags: List<bool> = [];
		for value in core.values.read() {
			flags.push(value.is_some());
		}
		let index = kept_index(flags);
		let kept: Shared<List<bool>> = Shared::new(flags);
		let drain = upstream.drain;
		CollInstance<U> {
			snapshot = || {
				mut out: List<U> = [];
				for value in core.values.read() {
					match value {
						Some(let payload) => out.push(payload),
						None => {},
					}
				}
				out
			},
			attach = core_attach(core, upstream),
			drain = || kept_ops(kept, index, resolve(core, drain()), |pair: (T, Option<U>)| pair.1, true),
			release = core_release(core, upstream),
		}
	}
}

export impl CollFilterMap<type F: CollFlow<type T>, T, type R: IntoFlow<Option<type U>>> with CollPipe<
	U,
> {}

/// `filter`'s and `filter_map`'s derivative, over the kept mirror and its index:
/// `out` answers an element's output (`None` when it is dropped). An element that
/// flips is a one-element `Splice` at its output position; one that stays kept and
/// changed is a `SetAt` there; a splice upstream is ONE splice out, of the kept
/// elements that left and arrived.
fun kept_ops<T, V, U>(
	kept: Shared<List<bool>>,
	index: KeptIndex,
	events: List<ElementEvent<T, V>>,
	out: |(T, V)| Option<U>,
	payload_follows: bool,
): List<SeqOp<U>> {
	mut ops: List<SeqOp<U>> = [];
	for event in events {
		match event {
			ElementEvent::Spliced(let at, let left, let arrived) => {
				let position = kept_before(index, at);
				mut removed: List<U> = [];
				for pair in left {
					match out(pair) {
						Some(let value) => removed.push(value),
						None => {},
					}
				}
				mut inserted: List<U> = [];
				mut flags: List<bool> = [];
				for pair in arrived {
					match out(pair) {
						Some(let value) => {
							inserted.push(value);
							flags.push(true);
						},
						None => flags.push(false),
					}
				}
				mut taken = 0;
				for taken < left.len() {
					let _flag = kept.write().remove(at);
					taken += 1;
				}
				mut offset = 0;
				for flag in flags {
					kept.write().insert(at + offset, flag);
					offset += 1;
				}
				rebuild_kept(index, kept.read());
				if removed.len() > 0 || inserted.len() > 0 {
					ops.push(SeqOp::Splice(position, removed, inserted));
				}
			},
			ElementEvent::Changed(let at, let before, let after, let rerun) => {
				let position = kept_before(index, at);
				match (out(before), out(after)) {
					(Some(let was), Some(let now)) => {
						// Kept both sides. The output changed when the input was
						// replaced, or — for `filter_map` — when the followed
						// payload moved; `filter`'s output is the INPUT, so a
						// predicate flow re-notifying `true` moved nothing.
						if rerun || payload_follows {
							ops.push(SeqOp::SetAt(position, was, now));
						}
					},
					(Some(let was), None) => {
						kept.write()[at] = false;
						kept_add(index, at, -1);
						ops.push(SeqOp::Splice(position, [was], []));
					},
					(None, Some(let now)) => {
						kept.write()[at] = true;
						kept_add(index, at, 1);
						ops.push(SeqOp::Splice(position, [], [now]));
					},
					(None, None) => {},
				}
			},
			ElementEvent::Reset(let _left, let now) => {
				mut flags: List<bool> = [];
				mut values: List<U> = [];
				for pair in now {
					match out(pair) {
						Some(let value) => {
							values.push(value);
							flags.push(true);
						},
						None => flags.push(false),
					}
				}
				kept.write() = flags;
				rebuild_kept(index, kept.read());
				ops.push(SeqOp::Reset(values));
			},
			ElementEvent::Moved(let from, let count, let to) => {
				let out_from = kept_before(index, from);
				let moved = kept_before(index, from + count) - out_from;
				mut lifted: List<bool> = [];
				mut taken = 0;
				for taken < count {
					lifted.push(kept.write().remove(from));
					taken += 1;
				}
				mut offset = 0;
				for flag in lifted {
					kept.write().insert(to + offset, flag);
					offset += 1;
				}
				rebuild_kept(index, kept.read());
				let out_to = kept_before(index, to);
				if moved > 0 && out_from != out_to {
					ops.push(SeqOp::Move(out_from, moved, out_to));
				}
			},
		}
	}
	ops
}

/// `any`/`all`/`count` as a stage: a SCALAR pipe over a counter (§6.2) — what
/// arrived is added, what left subtracted, a flip moves it by one — finished into
/// the answer on every pull.
export [hint(Pipe<U>)]
[resource] struct CollTally<F, T, R, U> {
	up: F,
	test: (|T| R) context (owner_scope, ambient_nursery),
	finish: |usize, usize| U,
}

export impl CollTally<type F: CollFlow<type T>, T, type R: IntoFlow<bool>, type U> with Flow<U> {
	[must_use]
	fun on_change(own self, observer: |U| void): Subscription {
		observe_flow(self, observer, false)
	}

	[must_use]
	fun sub(own self, observer: |U| void): Subscription {
		observe_flow(self, observer, true)
	}

	fun start(own self): Instance<U> {
		let test = self.test;
		let finish = self.finish;
		let upstream = self.up.open();
		let stage = Owner::new();
		let core: ElementCore<T, bool> = element_core(stage, |item: T| {
			let (answer, owner) = run_element(stage, || test(item));
			(answer.start_element(), owner)
		});
		seed(core, (upstream.snapshot)());
		mut seeded: usize = 0;
		for flag in core.values.read() {
			if flag {
				seeded += 1;
			}
		}
		let kept: Shared<usize> = Shared::new(seeded);
		let drain = upstream.drain;
		Instance<U> {
			pull = || {
				for event in resolve(core, drain()) {
					match event {
						ElementEvent::Spliced(let _at, let left, let arrived) => {
							mut count = kept.read();
							for pair in left {
								if pair.1 {
									count -= 1;
								}
							}
							for pair in arrived {
								if pair.1 {
									count += 1;
								}
							}
							kept.write() = count;
						},
						ElementEvent::Changed(let _at, let before, let after, let _rerun) => {
							if before.1 && !after.1 {
								kept.write() = kept.read() - 1;
							} else if !before.1 && after.1 {
								kept.write() = kept.read() + 1;
							}
						},
						ElementEvent::Reset(let _left, let now) => {
							mut count: usize = 0;
							for pair in now {
								if pair.1 {
									count += 1;
								}
							}
							kept.write() = count;
						},
						ElementEvent::Moved(let _from, let _count, let _to) => {},
					}
				}
				finish(kept.read(), core.ids.read().len())
			},
			attach = core_attach(core, upstream),
			release = core_release(core, upstream),
		}
	}
}

export impl CollTally<type F: CollFlow<type T>, T, type R: IntoFlow<bool>, type U> with Pipe<U> {}

// --- Boundary conversions (A142 S5, §6.3) ------------------------------------

/// Whether two elements a keyed reconcile matched by key are the SAME element, so
/// nothing is emitted for it: equality where the element has one, and "the same key
/// is the same element" where it has none — a collection of sources keyed by id
/// (§6.3's own case) keeps each source, where a `SetAt` would restart whatever
/// follows it.
export trait SameElement {
	fun same_element(self, other: Self): bool;
}

/// No equality: the key decides.
export impl type T with SameElement {
	fun same_element(self, other: T): bool {
		true
	}
}

/// Equality: a matched element whose value changed is a `SetAt`.
export impl type T: PartialEq with SameElement {
	fun same_element(self, other: T): bool {
		self == other
	}
}

/// The coarse-to-granular doors (R10): a flow of whole lists, turned into a
/// collection pipe by DIFFING each new list against the last. Only ever a diff —
/// the coarse source threw the change away upstream (§1); the real fix is a
/// granular source of truth, and these are for the boundaries (a fetch result, a
/// wire snapshot).
export impl type F: Flow<List<type T>> {
	/// The KEYED diff: `each_by`'s `ReconcilePlan` per change, O(n) with hashing.
	/// It can emit `Move` — a reordered element keeps its identity, and so does
	/// what follows it downstream. A matched element whose value changed is a
	/// `SetAt` when the element has `==`; without one, the same key is the same
	/// element.
	fun coll_by<K: PartialEq + Hashable>(own self, key: sync |T| K): CollBy<F, T, K> {
		CollBy<F, T, K> { up = self, key }
	}
}

export impl type F: Flow<List<type T: PartialEq>> {
	/// The POSITIONAL diff: trim the common prefix and suffix and splice what is
	/// between them. O(n) compares, and minimal for the common edits — an append,
	/// an insertion, a removal is one op of one element.
	fun coll(own self): Coll<F, T> {
		Coll<F, T> { up = self }
	}
}

/// `.coll()` as a stage.
export [hint(CollPipe<T>)]
[resource] struct Coll<F, T> {
	up: F,
}

export impl Coll<type F: Flow<List<type T: PartialEq>>, T> with CollFlow<T> {
	fun open(own self): CollInstance<T> {
		let upstream = self.up.start();
		let pull = upstream.pull;
		let held: Shared<List<T>> = Shared::new(fresh_list(pull()));
		CollInstance<T> {
			snapshot = || fresh_list(held.read()),
			attach = upstream.attach,
			drain = || {
				let next = pull();
				let ops = positional_ops(held.read(), next);
				held.write() = fresh_list(next);
				ops
			},
			release = upstream.release,
		}
	}
}

export impl Coll<type F: Flow<List<type T: PartialEq>>, T> with CollPipe<T> {}

/// The prefix/suffix trim: nothing, or one `Splice` over what lies between.
fun positional_ops<T: PartialEq>(before: List<T>, after: List<T>): List<SeqOp<T>> {
	let old_length = before.len();
	let new_length = after.len();
	mut prefix = 0;
	for prefix < old_length && prefix < new_length && before[prefix] == after[prefix] {
		prefix += 1;
	}
	mut suffix = 0;
	for prefix + suffix < old_length
		&& prefix + suffix < new_length
		&& before[old_length - 1 - suffix] == after[new_length - 1 - suffix] {
		suffix += 1;
	}
	mut ops: List<SeqOp<T>> = [];
	let removed = span_of(before, prefix, old_length - suffix);
	let inserted = span_of(after, prefix, new_length - suffix);
	if removed.len() > 0 || inserted.len() > 0 {
		ops.push(SeqOp::Splice(prefix, removed, inserted));
	}
	ops
}

/// The elements of `list` at `from .. to`.
fun span_of<T>(list: List<T>, from: usize, to: usize): List<T> {
	mut span: List<T> = [];
	mut index = from;
	for index < to {
		span.push(list[index]);
		index += 1;
	}
	span
}

/// `.coll_by(key)` as a stage.
export [hint(CollPipe<T>)]
[resource] struct CollBy<F, T, K> {
	up: F,
	key: |T| K,
}

export impl CollBy<type F: Flow<List<type T: SameElement>>, T, type K: PartialEq + Hashable> with CollFlow<
	T,
> {
	fun open(own self): CollInstance<T> {
		let key = self.key;
		let upstream = self.up.start();
		let pull = upstream.pull;
		let held: Shared<List<T>> = Shared::new(fresh_list(pull()));
		CollInstance<T> {
			snapshot = || fresh_list(held.read()),
			attach = upstream.attach,
			drain = || {
				let next = pull();
				let ops = keyed_ops(held.read(), next, key);
				held.write() = fresh_list(next);
				ops
			},
			release = upstream.release,
		}
	}
}

export impl CollBy<type F: Flow<List<type T: SameElement>>, T, type K: PartialEq + Hashable> with CollPipe<
	T,
> {}

/// A `ReconcilePlan` as ops (§6.3). The elements that left go first, as one splice
/// per contiguous run (from the end, so the positions still hold); then the new
/// order is built front to back: an arriving run is one splice, a matched element
/// standing elsewhere is a `Move` to where it belongs, and a matched element whose
/// value changed is a `SetAt` there. A list that did not reorder finds every
/// matched element already in place, so the pass is linear.
fun keyed_ops<T: SameElement, K: PartialEq + Hashable>(
	before: List<T>,
	after: List<T>,
	key: |T| K,
): List<SeqOp<T>> {
	mut old_keys: List<K> = [];
	for item in before {
		old_keys.push(key(item));
	}
	let plan = reconcile(old_keys, before, after, |item: T| key(item), |was: T, now: T| was.same_element(now));
	mut ops: List<SeqOp<T>> = [];
	// What stands now, as old indices (`None` for an arrival), with its values.
	mut standing: List<Option<usize>> = [];
	mut values: List<T> = fresh_list(before);
	mut index = 0;
	for index < before.len() {
		standing.push(Some(index));
		index += 1;
	}
	// The departures, from the end: each contiguous run of removed indices is one
	// splice, and removing from the end keeps every earlier position valid.
	mut run_end = plan.removed.len();
	for run_end > 0 {
		mut run_start = run_end - 1;
		for run_start > 0 && plan.removed[run_start - 1] + 1 == plan.removed[run_start] {
			run_start -= 1;
		}
		let at = plan.removed[run_start];
		let count = run_end - run_start;
		let left = span_of(values, at, at + count);
		mut taken = 0;
		for taken < count {
			let _gone = standing.remove(at);
			let _value = values.remove(at);
			taken += 1;
		}
		ops.push(SeqOp::Splice(at, left, []));
		run_end = run_start;
	}
	// The new order, front to back. Everything before `position` is final.
	mut position = 0;
	let steps = plan.steps;
	for position < steps.len() {
		match steps[position] {
			RowStep::Fresh => {
				mut end = position + 1;
				for end < steps.len() && steps[end] is RowStep::Fresh {
					end += 1;
				}
				let arriving = span_of(after, position, end);
				mut offset = 0;
				for item in arriving {
					standing.insert(position + offset, None);
					values.insert(position + offset, item);
					offset += 1;
				}
				ops.push(SeqOp::Splice(position, [], arriving));
				position = end;
			},
			RowStep::Keep(let old) => {
				place_matched(&mut standing, &mut values, &mut ops, old, position);
				position += 1;
			},
			RowStep::Refresh(let old) => {
				place_matched(&mut standing, &mut values, &mut ops, old, position);
				ops.push(SeqOp::SetAt(position, values[position], after[position]));
				values[position] = after[position];
				position += 1;
			},
		}
	}
	ops
}

/// Bring old element `old` to `position`, with a `Move` when it stands later.
fun place_matched<T>(
	standing: &mut List<Option<usize>>,
	values: &mut List<T>,
	ops: &mut List<SeqOp<T>>,
	old: usize,
	position: usize,
) {
	mut at = position;
	for at < standing.len() && standing[at] != Some(old) {
		at += 1;
	}
	if at != position && at < standing.len() {
		let moved = standing.remove(at);
		standing.insert(position, moved);
		let value = values.remove(at);
		values.insert(position, value);
		ops.push(SeqOp::Move(at, 1, position));
	}
}

// --- What `each`/`each_by` read their rows from ------------------------------

/// A run's input (A142 §6): any collection SOURCE — granular or coarse, as `each`
/// has always taken — or a collection PIPE, which the run consumes. Opened once: a
/// source with a positional log is followed by its ops, one without by a `Reset`
/// per change (the whole-list pass it has always had), and a pipe by the ops its
/// stages produce.
export [resource] trait RowFeed<T> {
	/// Start this input for its one run.
	[must_use]
	fun open_rows(own self): CollInstance<T>;
}

/// Every collection source: its log when it keeps one (`DeltaFeed`'s choice, B378),
/// the whole list per change when it does not.
export impl type S: DeltaFeed<type T> with RowFeed<T> {
	fun open_rows(own self): CollInstance<T> {
		match self.delta_cursor() {
			Some(let cursor) => CollInstance<T> {
				snapshot = || self.get(),
				attach = |subscriber: Subscriber| self.on_settle(subscriber),
				drain = || self.delta_since(cursor),
				release = || self.drop_delta_cursor(cursor),
			},
			None => CollInstance<T> {
				snapshot = || self.get(),
				attach = |subscriber: Subscriber| self.on_settle(subscriber),
				drain = || [SeqOp::Reset(self.get())],
				release = || {},
			},
		}
	}
}

/// Every collection pipe: consumed by the run.
export impl type P: CollPipe<type T> with RowFeed<T> {
	fun open_rows(own self): CollInstance<T> {
		self.open()
	}
}
