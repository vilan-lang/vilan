// The change structure under `std::reactive` (proposal/incremental-collections.md,
// tracker A112, slice S1).
//
// A collection `C` gets a change type — its OP — and an apply; every operator
// `f: C -> D` gets a derivative `f': C -> Op<C> -> Op<D>`, and the law is
//
//     f(a (+) da) == f(a) (+) f'(a, da)
//
// read at the only place it is observable, the settle of a turn:
// `derived.get() == source.get().map(g)`. For `map g` the derivative of "three
// elements arrived at position 4" is "three MAPPED elements arrived at position 4":
// `g` runs three times and nothing else is looked at — not N cache checks, zero.
//
// This module is the LOG half of that: an op vocabulary per collection SHAPE
// (not per method), a bounded op log with per-consumer cursors, and the thin
// trait a cell offers so operators are written against the ops once and serve
// every cell kind. It is `KeyedCell`'s machinery (A54), lifted out of
// `std::rpc` and made generic in the OP rather than in the collection — which
// is what lets a `List<str>` have a delta source at all: `KeyedCell` demands
// keys because its consumer is a wire protocol that addresses elements by key,
// and a local derivation addresses them by position.
//
// **Why a file of its own, and why the names read as `std::reactive`'s.** The log
// belongs to the reactive layer — `std::reactive` imports nothing from `std::wire`,
// and that stays true: `SeqOp` is a reactive type, `Delta` a wire one, and the edge
// between them lives in `std::rpc`, where it lives today. `reactive.vl` re-exports
// everything below, so the designed spelling `std::reactive::DeltaCursor` resolves;
// this file is where the bodies sit.
//
// Coalescing is free and is already how the turn scheduler behaves: writes in one
// turn produce ONE notification and the consumer drains every op at the settle, so
// the log is as long as one turn's writes.
import pkg::compare::PartialEq;
import pkg::hash::Hashable;
import pkg::map::Map;
import pkg::option::Option::{ self, None, Some };
import pkg::reactive::{
	Signal,
	SignalCell,
	Source,
	Subscription,
	as_derivation,
	defer_to_owner,
	fresh_id,
	register_with_owner,
};
import pkg::set::Set;
import pkg::shared::Shared;

/// How many ops a `DeltaLog` will hold for a consumer that has stopped
/// draining. Past it the history is dropped and every lagging cursor falls
/// back to its shape's `Reset` — bounded memory, at the cost of one
/// whole-collection payload to a consumer that could not keep up. In practice
/// nothing reaches it: a consumer drains at the settle of the turn that wrote,
/// so the log is as long as one turn's writes and no longer.
///
/// `keyed_log_limit` before the lift (A54), with its sentence unchanged.
export let delta_log_limit: i32 = 1024;

/// One consumer's place in a log: the sequence number it has been told through.
/// Identified rather than compared, because two consumers may legitimately sit at
/// the same sequence.
///
/// `KeyedCursor` before the lift (A54) — the cursor is shape-neutral, so it is
/// spelled once here instead of once per collection.
export struct DeltaCursor {
	id: i32,
	at: Shared<i32>,
}

// === The op vocabulary, per SHAPE ============================================
//
// Every arm carries WHAT LEFT as well as what arrived, and that is a
// requirement rather than a convenience: the O(1) derivative of a fold over a
// group — `sum`, `count`, `mean` — is "add what arrived, subtract what left",
// and a count cannot say what left, so the operator would have to read the
// collection, which is the O(N) rerun this module exists to delete. The same
// payload is what makes an op invertible (undo), and it is what `std::rpc`'s
// translation to `Delta<K, T>` needs: `Delta::Remove(key)` wants the key of
// the element that WENT, and only the value carries it.

/// A sequence's change — the primitive shape. Positional: keyed addressing is a
/// position index on top of it, which is exactly what `KeyedCell` keeps.
export enum SeqOp<T> {
	/// `removed` left and `inserted` arrived, both at `at`.
	Splice(i32, List<T>, List<T>),
	/// The element at `at` was the first value and is now the second.
	///
	/// Deliberately NOT `Splice(at, [old], [new])`, though it means the same thing
	/// to the collection: for `each` and for a per-element derivation the two are
	/// different events — an element changed in place, versus one left and another
	/// arrived — and the difference is whether the per-element owner survives.
	SetAt(i32, T, T),
	/// The collection BECAME this list. The honest escape hatch: a wholesale write,
	/// a lagging cursor's fallback, and the compat path for a source that keeps no
	/// log at all.
	Reset(List<T>),
	/// `count` elements moved from `from` to `to`, unchanged.
	///
	/// In the vocabulary from S1 although nothing in std EMITS one yet: adding an
	/// arm to a public op enum later is a breaking change to every `match` in every
	/// consumer, and a reorder is exactly where the splice-pair encoding loses
	/// information a consumer needs — a `Splice` that removes an element and a
	/// `Splice` that re-inserts it are, to a per-element owner, a disposal and a
	/// rebuild, where a `Move` says "same element, new place". A consumer that does
	/// not care may treat it as the splice pair; `std::rpc`'s wire translation
	/// lowers it to `Delta::Reset`, which is what a reorder sends today.
	Move(i32, i32, i32),
}

/// A map's change. `Put`'s `Option<V>` is the difference between an insert and an
/// overwrite, which a group fold over the values needs.
///
/// Recorded, not slated: nothing asks for a reactive `Map` cell yet. It is written
/// here so the log's shape is chosen against more than one collection.
///
/// `K: Hashable` is the `Reset` arm's bound, not the op's: `Map<K, V>` demands it,
/// and an op that carries the whole collection carries its bounds with it.
export enum MapOp<K: Hashable, V> {
	/// The key, what was there, and what is there now.
	Put(K, Option<V>, V),
	/// The key and the value that left.
	Delete(K, V),
	/// The collection BECAME this map.
	Reset(Map<K, V>),
}

/// A set's change. Recorded, not slated — `MapOp`'s sentence applies.
export enum SetOp<T: Hashable> {
	Add(T),
	Remove(T),
	Reset(Set<T>),
}

// === The log =================================================================

/// A bounded op log with per-consumer cursors — `KeyedCell`'s machinery,
/// lifted and made generic in the OP rather than in the collection.
///
/// Three cell kinds want it (a local sequence cell, the keyed cell, an optimistic
/// or remote cell) and copying it three times is the anti-DRY failure one layer up
/// from the one A112 complains about, so it is a value type a cell HOLDS rather
/// than a shape a cell repeats.
export struct DeltaLog<O> {
	/// The ops still worth keeping, oldest first: sequence numbers
	/// `base + 1 ..= version`.
	ops: Shared<List<O>>,
	/// The sequence number of the newest op the log has been told.
	version: Shared<i32>,
	/// The sequence number BEFORE the oldest op the log still holds. A cursor left
	/// behind it has lost history and is answered with `None`.
	base: Shared<i32>,
	/// One per live consumer. The log trims to the laggiest of them, so a log
	/// nobody is watching keeps no history at all.
	cursors: Shared<List<DeltaCursor>>,
	/// This log's ceiling, `delta_log_limit` unless a cell asked for another. A
	/// plain field rather than a cell: it is written once, at construction.
	limit: i32,
}

export impl DeltaLog<type O> {
	/// An empty log at `delta_log_limit`.
	fun new(): DeltaLog<O> {
		DeltaLog {
			ops = Shared::new([]),
			version = Shared::new(0),
			base = Shared::new(0),
			cursors = Shared::new([]),
			limit = delta_log_limit,
		}
	}

	/// An empty log at a ceiling of its caller's choosing — what a test that wants
	/// to reach the lag path without writing a thousand ops asks for.
	fun with_limit(limit: i32): DeltaLog<O> {
		DeltaLog {
			ops = Shared::new([]),
			version = Shared::new(0),
			base = Shared::new(0),
			cursors = Shared::new([]),
			limit,
		}
	}

	/// Append one op and bump the sequence. The trim comes FIRST, so a log whose
	/// consumers are all current holds one op and a log with no consumers holds
	/// exactly the op just recorded — ONE, not zero, because the trim happened
	/// before the push. Harmless, and stated here because it is easy to state
	/// wrongly.
	///
	/// Past `limit` the history is dropped instead of appended and `base`
	/// jumps to the new sequence: every cursor behind it now reads as lagging
	/// and is answered with `None` on its next drain, which the CELL turns
	/// into its shape's `Reset`. The op is not lost — it is IN the collection,
	/// which is what the `Reset` carries.
	fun record(self, op: O) {
		self.trim();
		let next = self.version.read() + 1;
		self.version.write() = next;
		if self.ops.read().len() >= self.limit {
			self.ops.write() = [];
			self.base.write() = next;
		} else {
			self.ops.write().push(op);
		}
	}

	/// Drop the ops every live cursor has already been told. With no cursors the
	/// whole log goes: nothing is watching, so nothing is owed.
	///
	/// The log is trimmed at the next WRITE, not at the drain: after a lone cursor
	/// has drained four ops the log still holds four, and they go on the next
	/// `record`. A cell written once and then read for ever holds one op's worth of
	/// history for ever. Also harmless, and also easy to state wrongly.
	fun trim(self) {
		mut lowest = self.version.read();
		for cursor in self.cursors.read() {
			let at = cursor.at.read();
			if at < lowest {
				lowest = at;
			}
		}
		let base = self.base.read();
		if lowest > base {
			let dropped = lowest - base;
			mut kept: List<O> = [];
			mut index = dropped;
			let held = self.ops.read();
			let length = held.len();
			for index < length {
				match held.get(index) {
					Some(let op) => kept.push(op),
					None => {},
				}
				index += 1;
			}
			self.ops.write() = kept;
			self.base.write() = lowest;
		}
	}

	/// Register a consumer's cursor, at the sequence the log is at NOW — the
	/// consumer is about to seed from the current collection, so it is owed nothing
	/// before this point.
	fun cursor(self): DeltaCursor {
		let minted = DeltaCursor { id = fresh_id(), at = Shared::new(self.version.read()) };
		self.cursors.write().push(minted);
		minted
	}

	/// Retire a cursor: its consumer is gone, so the log no longer has to hold
	/// anything for it. Called from the consumer's `Subscription::release`.
	fun drop_cursor(self, cursor: DeltaCursor) {
		mut kept: List<DeltaCursor> = [];
		for held in self.cursors.read() {
			if held.id != cursor.id {
				kept.push(held);
			}
		}
		self.cursors.write() = kept;
	}

	/// Everything `cursor` has not been told, and advance it. A cursor behind
	/// `base` has lost history and is answered with `None`.
	///
	/// `None` rather than a `Reset` because the LOG does not know what a `Reset` is
	/// for its op type and the CELL does — the one place the two layers have to
	/// know about each other, and three lines in each cell.
	fun since(self, cursor: DeltaCursor): Option<List<O>> {
		let at = cursor.at.read();
		let version = self.version.read();
		mut ops: List<O> = [];
		if at >= version {
			ret Some(ops);
		}
		cursor.at.write() = version;
		let base = self.base.read();
		if at < base {
			ret None;
		}
		mut index = at - base;
		let held = self.ops.read();
		let length = held.len();
		for index < length {
			match held.get(index) {
				Some(let op) => ops.push(op),
				None => {},
			}
			index += 1;
		}
		Some(ops)
	}

	/// How many ops the log is holding — what a pin on the trim reads.
	fun held(self): i32 {
		self.ops.read().len()
	}

	/// The newest sequence the log has been told.
	fun at(self): i32 {
		self.version.read()
	}

	/// The sequence before the oldest op still held.
	fun oldest(self): i32 {
		self.base.read()
	}
}

/// A source whose WRITES are its deltas. `C` is the collection, `O` its op.
///
/// The bound is what makes an operator generic in the CELL rather than in one cell
/// type: a derivation takes an `S: DeltaSource<List<T>, SeqOp<T>>`, so it serves a
/// local sequence cell, `KeyedCell`, and anything an app writes.
///
/// vilan has no associated types, so both the collection and its op are parameters.
export trait DeltaSource<C, O> with Source<C> {
	/// A cursor into this source's log, at the sequence it is at now.
	fun cursor(self): DeltaCursor;

	/// Retire a cursor. A derivation calls it on disposal, so a dead consumer stops
	/// pinning history.
	fun drop_cursor(self, cursor: DeltaCursor);

	/// Everything `cursor` has not been told. Unlike the LOG's `since` this never
	/// fails: a cursor that lost history is answered with the shape's `Reset`,
	/// carrying the collection.
	fun since(self, cursor: DeltaCursor): List<O>;
}

/// What a CONSUMER asks a source for when it can use ops but does not require
/// them: a delta feed, or nothing (A112 S3).
///
/// `each` takes any `Source<List<T>>` and must go on doing so, so it cannot bound
/// on `DeltaSource` — and vilan has no overloading, so the choice cannot be two
/// functions of one name either. It is one trait with a BLANKET impl answering "no
/// feed", which every collection source satisfies, and a second blanket over
/// `DeltaSource` answering a real one; the specificity order picks the second
/// wherever both match, because a subject bound by a subtrait is the more specific
/// one (B378).
///
/// **A cell with a log needs nothing more.** Being a `DeltaSource` is the whole of
/// it — the second blanket forwards to its members. What the extra trait buys over
/// bounding on `DeltaSource` directly is that a consumer may be written ONCE for
/// both kinds of source.
///
/// It is declared `with Source<List<T>>` because a feed is only ever asked of a
/// collection source, so a consumer bounds on `DeltaFeed<T>` alone and reads the
/// list through it. The first blanket's own bound IS that supertrait: the subject's
/// bound supplies the supertrait's members (spec/types.md §5.5), and a type with no
/// `Source<List<T>>` of its own does not reach the blanket.
///
/// It is a separate trait rather than three defaults on `Source<T>` because
/// `Source`'s argument is the whole value and these are about a COLLECTION's
/// element type — a `Source<i32>` has no `SeqOp<i32>` feed to offer, and giving it
/// one would put a collection's vocabulary on every signal in the language.
export trait DeltaFeed<T> with Source<List<T>> {
	/// A cursor into this source's op log, or `None` when it keeps none.
	fun delta_cursor(self): Option<DeltaCursor>;

	/// Everything the cursor has not been told. A source that answered `None` above
	/// is never asked.
	fun delta_since(self, cursor: DeltaCursor): List<SeqOp<T>>;

	/// Retire the cursor, so a disposed consumer stops pinning history.
	fun drop_delta_cursor(self, cursor: DeltaCursor);
}

/// Every collection source, including every plain `SignalCell<List<T>>`: no log, so
/// no feed, so the consumer keeps its whole-value path. This is what "a
/// `SignalCell` is not a delta source" means in code.
export impl type S: Source<List<type T>> with DeltaFeed<T> {
	fun delta_cursor(self): Option<DeltaCursor> {
		None
	}

	fun delta_since(self, cursor: DeltaCursor): List<SeqOp<T>> {
		mut none: List<SeqOp<T>> = [];
		none
	}

	fun drop_delta_cursor(self, cursor: DeltaCursor) {}
}

/// Every source that KEEPS a positional log — `ListCell`, `std::rpc`'s `KeyedCell`,
/// and anything an application writes against `DeltaSource` — answers with a real
/// feed. This impl and the one above both match such a source, and this one is
/// chosen because `DeltaSource<List<T>, SeqOp<T>>` is declared
/// `with Source<List<T>>`: a subject bound by a subtrait is the more specific one
/// (B378). It forwards, one line each.
export impl type S: DeltaSource<List<type T>, SeqOp<T>> with DeltaFeed<T> {
	fun delta_cursor(self): Option<DeltaCursor> {
		Some(self.cursor())
	}

	fun delta_since(self, cursor: DeltaCursor): List<SeqOp<T>> {
		self.since(cursor)
	}

	fun drop_delta_cursor(self, cursor: DeltaCursor) {
		self.drop_cursor(cursor);
	}
}

// === The sequence cell, and the first operator (A112 S2) =====================
//
// S1 built the LOG half. This is the CELL half: a collection whose writes are its
// ops, a surface over it that is written ONCE per receiver kind, and the first
// derivative — `map g`, whose `Splice(at, removed, arrived)` becomes
// `Splice(at, removed, arrived.map(g))`, so `g` runs once per arriving element and
// nothing else is looked at. Not N cache checks: zero.
//
// **Why two traits and not one.** `List`'s mutators take `&mut self`; a cell
// handle's take `self` — a `ListCell<T>` is two `Shared`s, so a copy of the handle
// is the same cell and `my_list.push(x)` on a plain `let` is right. One trait
// cannot have both receivers, and it does not need to: `SequenceCell` is the
// everyday surface and `Sequence` is the one a BODY is written against
// (`fun fill<S: Sequence<str>>(target: &mut S)`), reached through `edit`. Both
// stand on the same single primitive — `splice` — so the twelve method names each
// of them offers are defaults, written twice and implemented never
// (incremental-collections.md §6, §13 Q2: two hand lists, no macro).
//
// **I5.** Every position and count below is `i32` and is marked `// I5`: the
// index-type paper's S1 moves the family to `usize` as one breaking train, and
// these are its census.

/// The everyday sequence surface: `self` receivers, one primitive.
///
/// An implementor writes exactly TWO members — `size` and `splice` — and
/// inherits the rest. `splice` is the primitive because every other mutation
/// IS one: `push` is a splice at the end, `remove_at` a splice of one, `clear`
/// a splice of everything. Recording one op per call is then automatic rather
/// than a rule each method has to remember.
export trait SequenceCell<T> {
	/// How many elements the sequence holds.
	fun size(self): i32; // I5

	/// THE primitive: `removed` elements leave at `at` and `inserted` arrive there,
	/// as ONE op and ONE notification.
	fun splice(self, at: i32, removed: i32, inserted: List<T>); // I5 (at, removed)

	/// Nothing held.
	fun is_empty(self): bool {
		self.size() == 0
	}

	/// One element at the end.
	fun push(self, value: T) {
		self.splice(self.size(), 0, [value]) // I5
	}

	/// One element at the front.
	fun prepend(self, value: T) {
		self.splice(0, 0, [value]) // I5
	}

	/// One element at `at`, moving everything from there along.
	// I5: a POSITION parameter
	fun insert_at(self, at: i32, value: T) {
		self.splice(at, 0, [value]) // I5
	}

	/// Several elements at `at`, in order.
	// I5: a POSITION parameter
	fun insert_all(self, at: i32, values: List<T>) {
		self.splice(at, 0, values) // I5
	}

	/// The element at `at` leaves.
	// I5: a POSITION parameter
	fun remove_at(self, at: i32) {
		self.splice(at, 1, []) // I5
	}

	/// `count` elements leave, starting at `at`.
	// I5: a POSITION parameter
	fun remove_range(self, at: i32, count: i32) {
		self.splice(at, count, []) // I5
	}

	/// The last element leaves; an empty sequence is left alone.
	fun pop(self) {
		let size = self.size();
		if size > 0 {
			self.splice(size - 1, 1, []) // I5
		}
	}

	/// Several elements at the end, in order.
	fun extend(self, values: List<T>) {
		self.splice(self.size(), 0, values) // I5
	}

	/// Everything leaves.
	fun clear(self) {
		self.splice(0, self.size(), []) // I5
	}

	/// Everything leaves and `values` arrive — the wholesale write expressed as ONE
	/// `Splice` over the whole run.
	///
	/// It is NOT cheaper than `set`, and costs no more (A129): `each` and `each_by`
	/// match a splice's span by KEY exactly as they match a `Reset`, so a row whose
	/// key survives is kept either way, and a derivation runs once per element for
	/// both. The door that records only what changed is `reconcile_to`.
	fun set_all(self, values: List<T>) {
		self.splice(0, self.size(), values) // I5
	}

	/// Keep the first `length` elements.
	// I5: a POSITION parameter
	fun truncate(self, length: i32) {
		let size = self.size();
		if size > length {
			self.splice(length, size - length, []) // I5
		}
	}
}

/// The same sequence surface with `&mut self` receivers — the shape a BODY is
/// written against, and the one `ListCell::edit` hands out.
///
/// Its implementor is `Tracked<T>`, the recorder: a plain list plus the ops that
/// produced it. What this buys over `SequenceCell` is that an algorithm bounded on
/// it (`fun fill<S: Sequence<str>>(target: &mut S)`) is not tied to the reactive
/// graph at all — the same body fills a recorder inside an `edit` and, once B359's
/// fix admits `List<T>` among the implementors, a plain list outside one.
///
/// `size` takes `self` and the mutators take `&mut self`, deliberately: asking for
/// a writable view to answer a question would refuse a read on a shared value for
/// no reason.
export trait Sequence<T> {
	/// How many elements the sequence holds.
	fun size(self): i32; // I5

	/// THE primitive, as in `SequenceCell` — `removed` leave at `at` and `inserted`
	/// arrive there.
	fun splice(&mut self, at: i32, removed: i32, inserted: List<T>); // I5

	/// Nothing held.
	fun is_empty(self): bool {
		self.size() == 0
	}

	/// One element at the end.
	fun push(&mut self, value: T) {
		self.splice(self.size(), 0, [value]) // I5
	}

	/// One element at the front.
	fun prepend(&mut self, value: T) {
		self.splice(0, 0, [value]) // I5
	}

	/// One element at `at`, moving everything from there along.
	// I5: a POSITION parameter
	fun insert_at(&mut self, at: i32, value: T) {
		self.splice(at, 0, [value]) // I5
	}

	/// Several elements at `at`, in order.
	// I5: a POSITION parameter
	fun insert_all(&mut self, at: i32, values: List<T>) {
		self.splice(at, 0, values) // I5
	}

	/// The element at `at` leaves.
	// I5: a POSITION parameter
	fun remove_at(&mut self, at: i32) {
		self.splice(at, 1, []) // I5
	}

	/// `count` elements leave, starting at `at`.
	// I5: a POSITION parameter
	fun remove_range(&mut self, at: i32, count: i32) {
		self.splice(at, count, []) // I5
	}

	/// The last element leaves; an empty sequence is left alone.
	fun pop(&mut self) {
		let size = self.size();
		if size > 0 {
			self.splice(size - 1, 1, []) // I5
		}
	}

	/// Several elements at the end, in order.
	fun extend(&mut self, values: List<T>) {
		self.splice(self.size(), 0, values) // I5
	}

	/// Everything leaves.
	fun clear(&mut self) {
		self.splice(0, self.size(), []) // I5
	}

	/// Everything leaves and `values` arrive, as ONE op.
	fun set_all(&mut self, values: List<T>) {
		self.splice(0, self.size(), values) // I5
	}

	/// Keep the first `length` elements.
	// I5: a POSITION parameter
	fun truncate(&mut self, length: i32) {
		let size = self.size();
		if size > length {
			self.splice(length, size - length, []) // I5
		}
	}
}

// === The one splice ==========================================================
//
// Both surfaces run THIS — `Tracked` on its own list, `ListCell` inside its cell's
// `update` — so the two cannot disagree about what an out-of-range ask means or
// about what the op records.
//
// Out-of-range asks are CLAMPED, where `List::insert` and `List::remove` panic. The
// difference is deliberate: `List`'s index is a caller's claim about a list it
// holds, while a sequence surface is reached through a dozen defaults over ONE
// primitive, and `remove_range(at, 99)` asking for "the rest" or a `truncate` past
// the end should mean what it says rather than abort the turn. A clamped splice
// that takes nothing and inserts nothing is no op at all, and both callers check
// for it before they record or publish anything.

/// Where a splice at `at` starts in a sequence of `held` elements: `at`, pulled
/// into `0..=held`.
fun splice_start(held: i32, at: i32): i32 {
	// I5
	if at < 0 {
		0
	} else if at > held {
		held
	} else {
		at
	}
}

/// How many of the `removed` asked for a splice from `start` can take.
fun splice_count(held: i32, start: i32, removed: i32): i32 {
	// I5
	if removed < 0 {
		0
	} else if start + removed > held {
		held - start
	} else {
		removed
	}
}

/// Apply an already-clamped splice to `list` and answer the op it made. The op
/// carries what LEFT as well as what arrived — §3.1's requirement, and what
/// makes a group fold's derivative O(1).
// I5: a POSITION parameter
fun splice_in_place<T>(list: &mut List<T>, start: i32, taking: i32, inserted: List<T>): SeqOp<T> {
	mut left: List<T> = [];
	mut taken = 0; // I5
	for taken < taking {
		left.push(list.remove(start));
		taken += 1;
	}
	mut offset = 0; // I5
	let arriving = inserted.len(); // I5
	for offset < arriving {
		match inserted.get(offset) {
			Some(let value) => list.insert(start + offset, value),
			None => {},
		}
		offset += 1;
	}
	SeqOp::Splice(start, left, inserted)
}

/// A plain list plus the ops that produced it — what `ListCell::edit` hands a body,
/// and the only implementor of `Sequence<T>` std ships.
///
/// It is NOT reactive and holds no cell: the whole point is that a body may make a
/// dozen mutations on it at no notification cost, and the cell publishes the result
/// once when the body returns.
export struct Tracked<T> {
	/// The elements, mutated in place.
	elements: List<T>,
	/// One op per mutation, in the order they were made.
	ops: List<SeqOp<T>>,
}

export impl Tracked<type T> {
	/// A recorder over `elements`, with nothing recorded yet.
	fun new(elements: List<T>): Tracked<T> {
		Tracked { elements, ops = [] }
	}
}

export impl Tracked<type T> with Sequence<T> {
	fun size(self): i32 {
		// I5
		self.elements.len()
	}

	// I5: a POSITION parameter
	fun splice(&mut self, at: i32, removed: i32, inserted: List<T>) {
		let held = self.elements.len(); // I5
		let start = splice_start(held, at); // I5
		let taking = splice_count(held, start, removed); // I5
		if taking == 0 && inserted.len() == 0 {
			ret;
		}
		self.ops.push(splice_in_place(&mut self.elements, start, taking, inserted));
	}
}

/// A `List<T>` whose WRITES ARE ITS DELTAS: the list, the op log that says what
/// each write did, and the one notification both ride.
///
/// This is the cell A112 exists for. `list.push(x)` is one op, so a derivation
/// over it (`map_each`) runs its function once — for `x` — rather than once per
/// element, and `each` over it builds one row rather than reconciling the run.
/// Everything else about it is an ordinary `Source<List<T>>`: `each` takes it,
/// `map` takes it, an effect takes it, and a consumer that knows nothing about
/// ops pays nothing for them.
///
/// `set(whole_list)` records a `Reset` and costs what a `SignalCell` costs — the
/// honest compat path. `reconcile_to(whole_list)` is the door that turns a
/// wholesale write back into ops.
///
/// **Why the list is held HERE and not in a `SignalCell<List<T>>` (M86).** A
/// write has to know how long the list is, and the only read a `SignalCell`
/// offers is `get`, which hands back a VALUE — a deep copy of the run. Every
/// `splice` paid one, and `push` two (once to find the end, once inside
/// `splice`): 5.8 M of the 6.3 M Ir a push into 1,000 rows cost under `each`,
/// against ~30 K for everything `each` did with the op. Held in its own
/// `Shared`, the list is read in place — `items.read().len()` copies nothing —
/// and the signal carries only the notification, so there is still exactly ONE
/// notification per write and every observer, the op consumers and the
/// `Source<List<T>>` view alike, wakes on it.
export struct ListCell<T> {
	/// The elements. Mutated in place by every write, before `published` fires.
	items: Shared<List<T>>,
	/// The notification every observer rides, holding the log's sequence number as
	/// of the last write. One signal, so an observer that wakes always sees the
	/// list the ops it is about to drain produced (`KeyedCell`'s discipline).
	published: SignalCell<i32>,
	log: DeltaLog<SeqOp<T>>,
}

/// The one constructor body: every `ListCell` is a list, a notification and a log,
/// and the three public constructors differ only in the list and the log.
fun list_cell<T>(elements: List<T>, log: DeltaLog<SeqOp<T>>): ListCell<T> {
	ListCell { items = Shared::new(elements), published = SignalCell::new(0), log }
}

/// Fire a write's one notification, carrying the sequence the log is now at. Every
/// write calls it LAST — after the list is mutated and the op recorded — so an
/// observer that wakes reads a log that already explains the list it sees.
fun publish<T>(cell: ListCell<T>) {
	cell.published.set(cell.log.at());
}

export impl ListCell<type T> {
	/// An empty cell.
	fun new(): ListCell<T> {
		list_cell([], DeltaLog<SeqOp<T>>::new())
	}

	/// A cell holding `elements`. Nothing is recorded: a cursor minted after this
	/// reads the collection as its own starting point.
	fun of(elements: List<T>): ListCell<T> {
		list_cell(elements, DeltaLog<SeqOp<T>>::new())
	}

	/// A cell whose log has a ceiling other than `delta_log_limit` — what a test
	/// that wants to reach the lag path without writing a thousand ops asks for.
	fun with_limit(elements: List<T>, limit: i32): ListCell<T> {
		// I5
		list_cell(elements, DeltaLog<SeqOp<T>>::with_limit(limit))
	}

	/// Read the list IN PLACE: `read` is lent the cell's own list for the length of
	/// the call and its answer is handed back — where `get` hands out a copy of the
	/// whole run (M86).
	///
	///     let total = rows.peek(|list| list.len());
	///     let third = rows.peek(|list| list.get(2));   // copies ONE element
	///
	/// `read` is for READING: it must not write this cell. The list it is lent is
	/// the list the cell holds, so a write made through the cell inside it is not a
	/// write to a copy.
	fun peek<U>(self, read: sync |&List<T>| U): U {
		read(self.items.read())
	}

	/// The element at `at` becomes `value` — an element changed IN PLACE.
	///
	/// Deliberately not a `splice` of one: to a per-element consumer the two
	/// are different events (`SeqOp::SetAt`'s comment), and the difference is
	/// whether the row's owner survives. Out of range is a no-op, like every
	/// other bounds question in this module.
	// I5: a POSITION parameter
	fun set_at(self, at: i32, value: T) {
		// `.get(at)` on the slot copies the one element, not the run.
		match self.items.read().get(at) {
			Some(let previous) => {
				self.items.write()[at] = value;
				self.log.record(SeqOp::SetAt(at, previous, value));
				publish(self);
			},
			None => {},
		}
	}

	/// `count` elements starting at `from` move to `to`, unchanged.
	///
	/// The one op nothing else in std emits (§3.1) — it is here so a consumer
	/// that wants to preserve a moved element's identity has a way to say so,
	/// and so `map_each` has something to forward.
	// I5: a POSITION parameter
	fun move_range(self, from: i32, count: i32, to: i32) {
		if count <= 0 || from == to {
			ret;
		}
		mut lifted: List<T> = [];
		mut taken = 0; // I5
		for taken < count {
			lifted.push(self.items.write().remove(from));
			taken += 1;
		}
		mut offset = 0; // I5
		for offset < lifted.len() {
			match lifted.get(offset) {
				Some(let value) => self.items.write().insert(to + offset, value),
				None => {},
			}
			offset += 1;
		}
		self.log.record(SeqOp::Move(from, count, to));
		publish(self);
	}

	/// The BATCH door: hand `body` a recorder, then publish its whole run as ONE
	/// value write and one op per mutation it made.
	///
	/// Four mutations inside one `edit` are one notification and four ops — which
	/// is the point: a consumer wakes once and learns everything that happened,
	/// instead of waking four times.
	fun edit(self, body: sync |&mut Tracked<T>| void) {
		// The recorder works on a list of its OWN — the one copy a batch pays,
		// once for the whole batch.
		mut recorder = Tracked::new(self.items.read());
		body(&mut recorder);
		let produced = recorder.elements;
		let recorded = recorder.ops;
		self.items.write() = produced;
		for op in recorded {
			self.log.record(op);
		}
		publish(self);
	}

	/// How many ops the log is holding — what a pin on the trim reads.
	fun logged(self): i32 {
		// I5
		self.log.held()
	}
}

export impl ListCell<type T: PartialEq> {
	/// The COMPAT DOOR: take a whole list and record what CHANGED, instead of
	/// recording a `Reset` the way `set` does.
	///
	/// The diff is the cheap one — the common prefix, the common suffix, and
	/// ONE `Splice` over what is left between them — so an append, a prepend,
	/// an insertion, a removal and an in-place edit of a span each cost the
	/// elements they actually touch and nothing more. It is O(N) compares and
	/// zero derivations for every retained element, and it reads the held list
	/// in place rather than copying it (M86).
	///
	/// What it does NOT do is find a REORDER: a rotated list shares no prefix and
	/// no suffix, so it is one `Splice` over the whole run, which is honest (every
	/// element really did move) and is what `each`'s keyed pass is for. A source
	/// that knows it reordered says `move_range`.
	fun reconcile_to(self, items: List<T>) {
		let old_length = self.size(); // I5
		let new_length = items.len(); // I5
		mut prefix = 0; // I5
		for prefix < old_length && prefix < new_length {
			if self.items.read()[prefix] != items[prefix] {
				jump break;
			}
			prefix += 1;
		}
		mut suffix = 0; // I5
		for prefix + suffix < old_length && prefix + suffix < new_length {
			if self.items.read()[old_length - 1 - suffix] != items[new_length - 1 - suffix] {
				jump break;
			}
			suffix += 1;
		}
		let removed = old_length - prefix - suffix; // I5
		mut arriving: List<T> = [];
		mut index = prefix; // I5
		for index < new_length - suffix {
			match items.get(index) {
				Some(let value) => arriving.push(value),
				None => {},
			}
			index += 1;
		}
		// Identical lists: no op, no notification. `set` would publish anyway (it
		// never compares); this door exists precisely to compare.
		if removed == 0 && arriving.len() == 0 {
			ret;
		}
		self.splice(prefix, removed, arriving);
	}
}

export impl ListCell<type T> with Source<List<T>> {
	/// The whole list, as a value — a copy of the run. `peek` is the read that does
	/// not copy.
	fun get(self): List<T> {
		self.items.read()
	}

	/// The observer is handed the list as it stands when the notification is
	/// delivered, which is what a `SignalCell`'s observer is handed too.
	[must_use]
	fun on_change(self, observer: |List<T>| void): Subscription {
		self.published.on_change(|_sequence| observer(self.items.read()))
	}
}

export impl ListCell<type T> with Signal<List<T>> {
	/// The wholesale write: the collection BECAME this list, and the log says
	/// exactly that. Every delta consumer falls back to a rebuild, which is what
	/// `Reset` means and why `reconcile_to` exists beside it.
	fun set(self, value: List<T>) {
		self.items.write() = value;
		self.log.record(SeqOp::Reset(value));
		publish(self);
	}

	/// Publish the current value without changing it — and record NOTHING: a
	/// consumer draining the log after a bare notify is owed no ops, because
	/// nothing happened.
	fun notify(self) {
		self.published.notify();
	}
}

export impl ListCell<type T> with SequenceCell<T> {
	/// Read in place — the length, not a copy of the run (M86).
	fun size(self): i32 {
		// I5
		self.items.read().len()
	}

	/// The op is recorded BEFORE the write's single notification, so an observer
	/// that wakes reads a log that already explains the list it is about to see.
	/// (`KeyedCell`'s discipline, verbatim.) A splice that changes nothing —
	/// clamped to nothing taken and nothing arriving — records nothing and
	/// publishes nothing.
	// I5: a POSITION parameter
	fun splice(self, at: i32, removed: i32, inserted: List<T>) {
		let held = self.size(); // I5
		let start = splice_start(held, at); // I5
		let taking = splice_count(held, start, removed); // I5
		if taking == 0 && inserted.len() == 0 {
			ret;
		}
		self.log.record(splice_in_place(self.items.write(), start, taking, inserted));
		publish(self);
	}
}

export impl ListCell<type T> with DeltaSource<List<T>, SeqOp<T>> {
	fun cursor(self): DeltaCursor {
		self.log.cursor()
	}

	fun drop_cursor(self, cursor: DeltaCursor) {
		self.log.drop_cursor(cursor);
	}

	fun since(self, cursor: DeltaCursor): List<SeqOp<T>> {
		match self.log.since(cursor) {
			// A cursor that lost history is told the collection: the cell knows
			// what a `Reset` is for its shape and the log does not.
			None => {
				mut lost: List<SeqOp<T>> = [];
				lost.push(SeqOp::Reset(self.items.read()));
				lost
			},
			Some(let recorded) => recorded,
		}
	}
}

/// THE FIRST DERIVATIVE: `map g`, element-wise and incrementally.
///
/// `map_each(source, g)` is `source.get().map(g)` kept up to date by running `g`
/// once per element that ARRIVES or CHANGES, and zero times for anything else.
/// Three pushes are three calls; a removal is none; a `Reset` — a wholesale `set`,
/// or a cursor that fell behind the log — is the honest N.
///
///     let raw: ListCell<str> = ListCell<str>::new();
///     let parsed = map_each(raw, |text| text.parse_f64().unwrap_or(0f));
///     raw.push("10.5");   // `g` runs ONCE
///
/// It takes any `S: DeltaSource<List<T>, SeqOp<T>>`, not a `ListCell`, so it serves
/// a local cell, `std::rpc`'s `KeyedCell` and anything an app writes.
///
/// **Ownership.** A DERIVATION (A110 door 2): it publishes rather than acts, so an
/// effect on the result reads it settled. The subscription is the ambient owner's
/// like every other combinator's (A28), and the cursor goes with it — a disposed
/// derivation stops pinning the source's history.
///
/// **Purity.** `g` runs once per element and its result is kept, so it must be pure
/// IN THE ELEMENT: a `g` that reads another signal will not re-run when that signal
/// changes. That is the same contract `map` has always had, made sharper by the
/// fact that nothing re-runs it.
export fun map_each<T, U, S: DeltaSource<List<T>, SeqOp<T>>>(
	source: S,
	g: sync |T| U,
): ListCell<U> {
	// The cursor is minted BEFORE the seed is read, so the seed is exactly the
	// state the cursor names and nothing can fall between them.
	let cursor = source.cursor();
	let out: ListCell<U> = ListCell<U>::of(source.get().map(g));
	as_derivation();
	let _owned = register_with_owner(source.on_change(|_published| {
		for op in source.since(cursor) {
			match op {
				// The derivative of `map g`: what arrived, mapped. Nothing else is
				// read, and `g` runs exactly `inserted.len()` times.
				SeqOp::Splice(let at, let removed, let inserted) => {
					out.splice(at, removed.len(), inserted.map(g)); // I5
				},
				SeqOp::SetAt(let at, let _was, let value) => out.set_at(at, g(value)),
				// The honest N: the collection became something else, so the
				// derived collection does too.
				SeqOp::Reset(let items) => out.set(items.map(g)),
				// A reorder maps to a reorder — no element changed, so `g` runs
				// zero times.
				SeqOp::Move(let from, let count, let to) => out.move_range(from, count, to),
			}
		}
	}));
	defer_to_owner(|| source.drop_cursor(cursor));
	out
}
