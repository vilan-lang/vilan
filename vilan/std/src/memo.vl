// `std::memo` — `Memo<K, V>`, a per-key cache of values MADE ON FIRST ASK.
//
// One line of it: `memo.get_or_insert(key, || make(key))` answers the value this
// memo already holds for `key`, or makes it, keeps it and answers that. Everything
// else about the type follows from what it is FOR.
//
// It is the app's composition tool for IDENTITY: every call site asking for the
// same key gets the same value, made once. A remote handle no longer needs one to
// be single per id — a generated handle stub dedups its mirrors per origin (the
// method and its arguments, A134), so two views calling `client.get_message(id)`
// already share one mirror, one call and one lease — but anything an app BUILDS
// over a handle, or over any source, and wants built once per key is what a memo is
// for.
//
// **What the maker builds outlives the caller.** The memo is program-lifetime and
// evicts nothing by itself, so a value it keeps outlives the call that made it —
// and every owner that call ran under. A derivation in a maker is therefore sealed
// with `.memo_global()` (`.cell_global()` for the writable face), the spellings
// whose lifetime is the program's: a `.memo()` there is tied to the FIRST caller's
// owner, dies with it (the page that asked first), and every later ask is answered
// with the dead memo — stale on return, never updating again (A136). A LEASE never
// goes in a maker: take it at the call site, on what the memo answers, under the
// caller's owner, where it is released with the caller. The compiler warns at a
// `.memo()`, a `.cell()` or an `effect` written directly inside a maker.
//
// **The maker runs at the CALL SITE**, not inside this module, and that is the
// whole reason `get_or_insert` takes a closure rather than a value: a maker's
// CONTEXT reads — the rpc client, a theme — are the caller's, which a module-level
// memo could never supply. Its CONTEXT is the caller's; its LIFETIME is the memo's.
// Nothing can run a maker "under no owner" from inside a scope (a closure captures
// its context at creation), and `.memo_global()` is std's name for building without
// one.
//
// **Nothing is evicted by itself.** `forget` is the caller's, for a value that
// turned out wrong.
//
// Where it lives: its own module, like every other collection in std (`Map`,
// `Set`, `Arena`, `NativeMap` — one type, one file named for it). std has no
// `collections` module and inventing one for this would be a second organizing
// principle for the same shelf.
import pkg::hash::Hashable;
import pkg::map::Map;
import pkg::option::Option::{ self, None, Some };
import pkg::shared::Shared;

export *;

/// A per-key cache of values made on first ask.
///
/// `Shared` rather than a field the caller must hold mutably: a memo is shared by
/// every call site that reads it — a module-level `let`, a field on a store — and
/// `get_or_insert` is a read from the caller's point of view even when it writes.
struct Memo<K: Hashable, V> {
	entries: Shared<Map<K, V>>,
}

impl Memo<type K: Hashable, type V> {
	/// An empty memo.
	fun new(): Memo<K, V> {
		let entries: Map<K, V> = Map::new();
		Memo { entries = Shared::new(entries) }
	}

	/// The value for `key` — made by `make` on the first ask, INSERTED, and
	/// answered on every later one (tracker I7: the name says the write, as Rust's
	/// `get_or_insert_with` and `entry(..).or_insert_with` do).
	///
	/// `make` runs AT THE CALL SITE and only when there is nothing held, so a maker
	/// that reads a context reads the caller's, and a maker that costs something (a
	/// handle mint, a parse) is paid for once. What it builds is kept for the life
	/// of the memo, past the caller's owner: a derivation in a maker is
	/// `.memo_global()`, and a lease belongs at the call site (the module's head).
	fun get_or_insert(self, key: K, make: || V): V {
		match self.entries.read().get(key) {
			Some(let held) => held,
			None => {
				let made = make();
				self.entries.write().insert(key, made);
				made
			},
		}
	}

	/// `get_or_insert`'s name before tracker I7, kept one release: it read as
	/// `Option::unwrap_or`'s family — a fallback that stores nothing — for an
	/// operation whose point is that it stores.
	[deprecated("use get_or_insert(key, make)")]
	fun get_or(self, key: K, make: || V): V {
		self.get_or_insert(key, make)
	}

	/// What this memo holds for `key`, if anything — the passive read, which makes
	/// nothing.
	fun get(self, key: K): Option<V> {
		self.entries.read().get(key)
	}

	/// Drop the value held for `key`; the next ask makes it again.
	fun forget(self, key: K) {
		self.entries.write().remove(key);
	}

	/// Drop everything.
	fun clear(self) {
		let entries: Map<K, V> = Map::new();
		self.entries.write() = entries;
	}

	/// How many keys this memo holds.
	fun len(self): usize {
		self.entries.read().len()
	}
}
