// `std::path` — path arithmetic over plain `str`, in pure vilan (kolt.local
// 017). Three forks were open when this module was filed; each is settled
// here, with the argument, because the answers shape every signature below.
//
// **Free functions over `str`, not a `Path` type.** `proposal/filesystem.md`
// §9 states the seam this module lands against: `std::fs` "produces and
// consumes plain `str` paths and takes no position on a `Path` type", and
// every one of its ~30 signatures takes `path: str`. A `Path` type today
// would therefore have to either convert at every one of those call sites or
// change all of them — and changing them collides with the same paper's
// handle tier (`File`, §3.2), which is not ruled yet. The type is supposed to
// earn its keep at `normalize` and `relative`; both are below as free
// functions in a dozen lines each, so it does not. Nothing here forecloses
// one: a later `Path` wrapping a `str` can delegate to exactly these
// functions, and until it exists there is one representation of a path in the
// language rather than two.
//
// **POSIX shape everywhere, `/` only, on every platform.** The alternative is
// separator-awareness, and it fails on the invariant `windows-support.md` §1
// exists to hold: "a program that compiles on Windows compiles identically on
// Linux". A `join` that emitted `\` on Windows would make every path a
// program derives — a cache key, an asset URL, a golden — platform-dependent
// output, which is exactly the class that paper spent its length removing
// from the compiler. `/` is not a compromise on Windows either: Win32 accepts
// it as a separator in every ordinary API, so a path this module builds is a
// path node can open there. What is genuinely NOT modelled is stated rather
// than half-supported: drive-absolute (`C:/…`) and UNC (`\\server\share`)
// paths are not roots to `is_absolute`, and a `\` is an ordinary character
// (it is a legal filename byte on POSIX, so reading it as a separator would
// be wrong on the platform that has the most files). Two consequences worth
// knowing: `read_dir_all` returns HOST-separator paths, so its Windows output
// is not in this module's shape; and nothing here folds case, ever —
// `windows-support.md` §5's case-exact module resolution would be undermined
// by a `normalize` or a `relative` that decided `Foo` and `foo` were the same
// path, so they compare byte-for-byte and `normalize` preserves the case it
// was given.
//
// **URL paths are out, and the seam is the query string.** They share the
// `/`-separated core and nothing else: `extname("/app.js?v=2")` is `.js?v=2`
// under a file rule and `.js` under a URL rule, `%2F` is not a separator, and
// a URL's root is an origin rather than a filesystem root. So the split is
// that a URL parser owns scheme/authority/query/fragment and hands its PATH
// COMPONENT to the functions here — which is precisely what
// `std::document`'s `file_name_of` does today, and why it can be two lines.
//
// **Color: none.** This module is in std's base `root` layer, not
// `src/process`, so it is seeded no platform (`std/vilan.toml`); every
// function is a `str` -> `str` computation with no host call in it. That is
// deliberate rather than incidental — a browser build routes URL paths, an
// SSR build routes the same ones, and a `@process`-colored `path` would have
// made the shared half unreachable from half the program. It is pure vilan,
// so it is also available under `const`.

import pkg::option::Option::{ None, Some, self };

// --- the shape of a path ------------------------------------------------------

/// Whether `path` starts at the root — the only structural distinction this
/// module draws, and the one every other function branches on. A drive letter
/// is NOT a root here (see the module header): `is_absolute("C:/x")` is
/// `false`.
fun is_absolute(path: str): bool {
	path.starts_with("/")
}

/// A normalized path's components, with `.` and empty segments removed and
/// every `..` resolved as far as it can be: the shared core of `normalize`,
/// `relative` and `starts_with`, kept in one place so those three cannot
/// disagree about what a path IS.
///
/// A leading `..` survives on a RELATIVE path (`../a` names something real
/// and nothing here knows what) and is dropped on an ABSOLUTE one (the root's
/// parent is the root — POSIX, and `/../a` is `/a`).
fun components(path: str): List<str> {
	let rooted = is_absolute(path);
	mut parts: List<str> = [];
	for piece in path.split("/") {
		if piece == "" || piece == "." {
			jump continue;
		}
		if piece != ".." {
			parts.push(piece);
			jump continue;
		}
		let length = parts.len();
		if length > 0 && parts[length - 1] != ".." {
			parts.pop();
		} else if !rooted {
			parts.push("..");
		}
	}
	parts
}

/// The components concatenated with `/` between them — no leading or trailing
/// separator. (`std::display`'s `List::join` would do this; taking it would
/// put this module on the `display` chain for one loop, so it does not.)
fun joined(parts: List<str>): str {
	mut result = "";
	mut first = true;
	for part in parts {
		if !first {
			result = result + "/";
		}
		first = false;
		result = result + part;
	}
	result
}

// --- the functions ------------------------------------------------------------

/// The canonical spelling of `path`: repeated separators collapsed, every `.`
/// removed, every `..` resolved against the component before it, and **any
/// trailing separator dropped**. Purely lexical — nothing is read from disk,
/// so a `..` is cancelled against the name before it even when that name is a
/// symlink pointing elsewhere.
///
/// `""` normalizes to `"."`, and `"/"` to `"/"`. A `..` that would climb above
/// an absolute root is dropped, because the root's parent is the root; a
/// leading `..` on a relative path is kept, because it means something.
///
/// **Trailing separators go, and node's `path.normalize` keeps them.** That is
/// the one deliberate divergence in this module and it is the point of the
/// function: `normalize` exists so that two spellings of one path compare
/// equal, and node's answers `"a/b"` and `"a/b/"` do not — which is how a
/// cache or an asset map ends up with two entries for one file. Every
/// function below that needs a canonical form goes through here, so the
/// property holds across the module rather than at one call site.
fun normalize(path: str): str {
	let body = joined(components(path));
	if is_absolute(path) {
		"/" + body
	} else if body == "" {
		"."
	} else {
		body
	}
}

/// `base` and `part` joined with a separator and normalized. An empty side
/// contributes nothing, so `join("", "a")` is `"a"` — it does NOT become
/// absolute.
///
/// **An absolute `part` does not reset the result** — `join("/a", "/b")` is
/// `"/a/b"`. That is node's split between `join` and `resolve` and it is the
/// right one: `join` is textual, the caller who wants "…unless the second one
/// is already absolute" is asking a question about REFERENCES and wants
/// `resolve`, and a `join` that silently discarded its first argument would
/// be a directory-traversal primitive wearing a concatenation's name.
fun join(base: str, part: str): str {
	if base.is_empty() {
		normalize(part)
	} else if part.is_empty() {
		normalize(base)
	} else {
		normalize(base + "/" + part)
	}
}

/// Every element of `parts` joined left to right — `join`'s n-ary form, since
/// vilan has no variadics. An empty list joins to `"."`, matching
/// `normalize("")`.
fun join_all(parts: List<str>): str {
	mut result = "";
	for part in parts {
		result = join(result, part);
	}
	if result.is_empty() {
		"."
	} else {
		result
	}
}

/// The path `path` names when read as a reference relative to `base`: `base`
/// joined with it, unless `path` is already absolute, in which case `base` is
/// not consulted at all.
///
/// **`base` is explicit and there is no default**, which is where this parts
/// company with node's `path.resolve`: that one falls back to
/// `process.cwd()`, and a working directory is a host fact — taking it would
/// have colored this whole module `@process` for one function's convenience.
/// The result is absolute exactly when `base` is (or `path` is). A caller who
/// means "against the working directory" reaches for the cwd itself and
/// passes it.
fun resolve(base: str, path: str): str {
	if is_absolute(path) {
		normalize(path)
	} else {
		join(base, path)
	}
}

/// The last component of `path`, with any trailing separators ignored:
/// `basename("/a/b.txt")` is `"b.txt"` and `basename("/a/b/")` is `"b"`.
/// Lexical, like the rest of the module — `basename("a/..")` is `".."`, not
/// `"a"`'s parent. The root and the empty path have no last component, so
/// both give `""`.
fun basename(path: str): str {
	mut end = path.len();
	for end > 0 && path.substring(end - 1, end) == "/" {
		end -= 1;
	}
	mut start = end;
	for start > 0 && path.substring(start - 1, start) != "/" {
		start -= 1;
	}
	path.substring(start, end)
}

/// Everything before `path`'s last component: `dirname("/a/b.txt")` is
/// `"/a"`, `dirname("/a")` and `dirname("/")` are both `"/"`, and a path with
/// no separator at all has parent `"."` (`dirname("a")`, `dirname("")`).
/// Trailing separators are ignored first, so `dirname("a/b/")` is `"a"`.
/// Lexical: `dirname("/../a")` is `"/.."`, the text before the last
/// component, not the directory that path would resolve to.
fun dirname(path: str): str {
	mut end = path.len();
	for end > 0 && path.substring(end - 1, end) == "/" {
		end -= 1;
	}
	if end == 0 {
		// Empty, or nothing but separators — the two cases with no last
		// component to remove, and they answer differently.
		ret if path.is_empty() {
			"."
		} else {
			"/"
		};
	}
	mut cut = end;
	for cut > 0 && path.substring(cut - 1, cut) != "/" {
		cut -= 1;
	}
	if cut == 0 {
		ret ".";
	}
	// Drop the separator run that precedes the last component; if that leaves
	// nothing, the parent is the root itself.
	mut stop = cut - 1;
	for stop > 0 && path.substring(stop - 1, stop) == "/" {
		stop -= 1;
	}
	if stop == 0 {
		"/"
	} else {
		path.substring(0, stop)
	}
}

/// The extension of `path`'s last component, **including the leading dot** —
/// `extname("index.html")` is `".html"` — or `""` when it has none.
///
/// **A dotfile has no extension.** `extname(".gitignore")` is `""`, not
/// `".gitignore"`: the leading dot marks the file as hidden, it does not name
/// a type, and the wrong answer here is the single most common bug in
/// hand-rolled path code. `"."` and `".."` likewise have none. Only the LAST
/// dot counts (`extname("a.b.c")` is `".c"`), a trailing dot is an empty
/// extension spelled `"."` (`extname("file.")`), and a dot in a DIRECTORY
/// name is invisible from here (`extname("a.b/c")` is `""`) because the
/// question is about the file. These are node's `path.extname` answers, case
/// by case; the divergences in this module are elsewhere and deliberate, and
/// this is not a place to be original.
fun extname(path: str): str {
	let name = basename(path);
	if name == "." || name == ".." {
		ret "";
	}
	mut index = name.len();
	for index > 1 {
		if name.substring(index - 1, index) == "." {
			ret name.substring(index - 1, name.len());
		}
		index -= 1;
	}
	""
}

/// `basename` without `extname` — the file's name with its type suffix
/// removed. `stem("/a/b.txt")` is `"b"`, and `stem(".gitignore")` is
/// `".gitignore"` because that file has no extension to remove.
///
/// `stem(p) + extname(p) == basename(p)` holds for every `p`, by
/// construction: the two functions cut one string at one index.
fun stem(path: str): str {
	let name = basename(path);
	let extension = extname(path);
	name.substring(0, name.len() - extension.len())
}

/// Whether `path` is `prefix` or lies under it, compared **component by
/// component** on the normalized forms.
///
/// This is the path-aware sibling of `str::starts_with`, and it exists
/// because the `str` one is wrong for paths in a way that is easy to ship:
/// `"/a/bc".starts_with("/a/b")` is `true` on the text and false about the
/// filesystem — `/a/bc` is not inside `/a/b`. Deriving a key or an asset URL
/// by cutting a textual prefix is the same mistake in the other direction.
/// Comparison is exact, never case-folded (module header).
fun starts_with(path: str, prefix: str): bool {
	if is_absolute(path) != is_absolute(prefix) {
		ret false;
	}
	let parts = components(path);
	let head = components(prefix);
	if head.len() > parts.len() {
		ret false;
	}
	mut index = 0;
	for index < head.len() {
		if parts[index] != head[index] {
			ret false;
		}
		index += 1;
	}
	true
}

/// The part of `path` that lies under `prefix`, or `None` when it does not
/// lie under it at all — `starts_with` tests, this one cuts, exactly as
/// `str::starts_with` and `str::strip_prefix` divide the same work on text.
/// A path stripped of the whole of itself is `Some(".")`, the same answer
/// `relative` gives for a path to itself.
///
/// This is the verb that derives a key or a URL from a file and a root, and
/// it is a distinct function from `relative` on purpose: `relative` always
/// has an answer for two paths under one root and will happily climb with
/// `..` to reach it, which is the wrong shape for "is this mine, and if so
/// what do I call it". `str::strip_prefix` is the wrong tool for either —
/// `"/a/bc".strip_prefix("/a/b")` is `Some("c")` and `/a/bc` is not inside
/// `/a/b`.
///
/// There is deliberately no path `strip_suffix`: the only trailing affix a
/// path commonly carries is a file extension, and removing that is `stem`.
fun strip_prefix(path: str, prefix: str): Option<str> {
	if !starts_with(path, prefix) {
		ret None;
	}
	let parts = components(path);
	let head = components(prefix);
	mut rest: List<str> = [];
	mut index = head.len();
	for index < parts.len() {
		rest.push(parts[index]);
		index += 1;
	}
	if rest.len() == 0 {
		Some(".")
	} else {
		Some(joined(rest))
	}
}

/// The relative path that reaches `to` when read from the directory `from` —
/// the inverse of `resolve`, so `resolve(from, relative(from, to))` is
/// `normalize(to)`. A path to itself is `"."`.
///
/// `None` when the question has no lexical answer, which is two cases and
/// both are real: `from` and `to` disagree about being absolute (nothing here
/// knows a working directory to bridge them with), or `from` still begins
/// with `..` after the common prefix is removed (climbing out of an unknown
/// place, so what is above it is unknown too). An `Option` rather than a
/// best-effort string for `str::strip_prefix`'s reason — "there is no answer"
/// and "the answer is `.`" are different, and a bare `str` cannot say both.
fun relative(from: str, to: str): Option<str> {
	if is_absolute(from) != is_absolute(to) {
		ret None;
	}
	let source = components(from);
	let target = components(to);
	mut common = 0;
	for common < source.len() && common < target.len() && source[common] == target[common] {
		common += 1;
	}
	mut steps: List<str> = [];
	mut up = common;
	for up < source.len() {
		if source[up] == ".." {
			ret None;
		}
		steps.push("..");
		up += 1;
	}
	mut down = common;
	for down < target.len() {
		steps.push(target[down]);
		down += 1;
	}
	if steps.len() == 0 {
		Some(".")
	} else {
		Some(joined(steps))
	}
}
