// Random number generation. `range(low, high)` gives a uniformly random value in
// the HALF-OPEN range `[low, high)` — `low` is reachable, `high` is not — for any
// numeric type. Half-open because that is the range every draw composes with:
// `range(0, list.len())` is an index, and the integer and float arms then say the
// same thing about their bounds rather than two things (A118; `Math.random()`
// itself is `[0, 1)`).
//
// A degenerate range answers `low`: `range(4, 4)` is 4, because `[4, 4)` holds
// nothing and there is no other value to answer. `low` above `high` is not a range
// and nothing here promises anything about it.

/// Per-type runtime primitives, lowered to a `Math.random` helper. The `Random`
/// impls below forward to these; prefer `range` over calling them directly.
external fun range_i32(low: i32, high: i32): i32;
external fun range_u32(low: u32, high: u32): u32;
external fun range_f64(low: f64, high: f64): f64;

/// A type that can produce a uniformly random value within a half-open range.
export trait Random {
	fun range(low: Self, high: Self): Self;
}

export impl i32 with Random {
	fun range(low: i32, high: i32): i32 {
		range_i32(low, high)
	}
}

export impl u32 with Random {
	fun range(low: u32, high: u32): u32 {
		range_u32(low, high)
	}
}

export impl f64 with Random {
	fun range(low: f64, high: f64): f64 {
		range_f64(low, high)
	}
}

/// A uniformly random value in the half-open range `[low, high)`.
export fun range<T: Random>(low: T, high: T): T {
	T::range(low, high)
}
