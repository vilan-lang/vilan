// `std::markdown` — a strict markdown parser scoped to the docs book's census,
// producing a plain-data AST with mdBook-compatible heading ids.
//
// PACKAGE CONTRACT (proposal/markdown.md §6, RULED 2026-08-24 — the tree's
// first package-shaped std module, the convention every official package
// inherits; versioned with the toolchain until a registry exists):
//
// - **Scope is the census, and the census is a contract** (§1): ATX headings,
//   backtick fences with verbatim info strings and bodies, paragraphs, flat
//   ordered/unordered lists (items may carry multi-block bodies), recursive
//   blockquotes, pipe tables without alignment (`\|` cell escapes honored),
//   inline code / strong / emphasis / links / `<http(s)…>` autolinks, and one
//   HTML passthrough shape: `<a id="…"></a>`. Everything else — images,
//   footnotes, strikethrough, reference links, setext headings, indented code,
//   thematic breaks, nested lists, hard breaks, general backslash escapes,
//   other raw HTML — is a **loud `ParseError`**, never a silent wrong render.
// - **The public surface is plain data**: `str`, `i32`, `bool`, `List`, and
//   the enums/structs below. No `Shared`, no `View`, no closure anywhere in or
//   under a parse result — the const-eligibility invariant (§2).
// - **Leaf imports only** (Tier-1 core), **no compiler-known names**, and the
//   renderer is NOT here: walking `Doc` into views, HTML, or link checks is
//   the consumer's code.
// - **Heading ids are a compatibility surface** (§3): bit-exact mdBook v0.5.4
//   parity — `id_from_content` + per-page `-1`/`-2` dedupe — pinned by a unit
//   corpus and a book-wide golden (crates/vilan-core/tests/markdown_golden.rs).
//   ASCII is exact; non-ASCII follows mdBook's rule (alphanumerics kept and
//   Unicode-lowercased, Unicode whitespace hyphenated, punctuation dropped)
//   via the curated ranges in `heading_id`'s helpers.
//   Known gaps, deliberate until a real Unicode story: non-BMP characters
//   (surrogate pairs — emoji, ancient scripts) are dropped where mdBook would
//   keep the alphanumeric ones, and exotic symbol classes outside the curated
//   ranges are kept where mdBook would drop them. The book exercises neither;
//   the corpus pins the exercised classes so a divergence is loud.

import pkg::display::Display;
import pkg::option::Option::{ None, Some, self };
import pkg::result::Result::{ Err, Ok, self };

// --- the AST: plain data by construction (proposal/markdown.md §2) -----------

/// Inline (span-level) content. `Code` carries the span's content with the
/// CommonMark one-space trim applied; `Link` is `(destination, label)`;
/// `Html` is one raw tag, verbatim (`<a id="…">` or `</a>` — the census's only
/// passthrough shape).
enum Inline {
	Text(str),
	Code(str),
	Strong(List<Inline>),
	Emph(List<Inline>),
	Link(str, List<Inline>),
	Html(str),
}

/// Block-level content. `Heading` is `(level 1–6, content, id)` — the id is
/// the mdBook-compatible slug, deduped per document (§3). `CodeFence` is
/// `(info string, body)`, both verbatim; the body carries one trailing newline
/// per line, the docs gate's extraction shape. `Items` is
/// `(ordered?, items)` where each item is a list of blocks — the book's own
/// bullets carry multi-paragraph bodies and indented fences, so an
/// inline-only item type cannot represent them (a recorded deviation from
/// §2's sketch; proposal/markdown.md §10). `Table` is `(header, rows)`.
enum Block {
	Heading(i32, List<Inline>, str),
	Paragraph(List<Inline>),
	CodeFence(str, str),
	Quote(List<Block>),
	Items(bool, List<List<Block>>),
	Table(List<List<Inline>>, List<List<List<Inline>>>),
}

/// A parsed document: the block sequence, in source order.
struct Doc {
	blocks: List<Block>,
}

/// A strict-parse refusal: the 1-based source line and a message naming the
/// out-of-grammar construct. For a block-level construct the line is exact;
/// for an inline construct it is the line its enclosing block opens on.
struct ParseError {
	line: i32,
	message: str,
}

impl ParseError with Display {
	fun to_string(self): str {
		"line " + self.line.to_string() + ": " + self.message
	}
}

use Inline::{ Code, Emph, Html, Link, Strong, Text };

// --- small helpers -----------------------------------------------------------

/// The index of `needle` in `text` at or after `from`, or `None`.
fun index_of(text: str, needle: str, from: i32): Option<i32> {
	let limit = text.len() - needle.len();
	mut index = from;
	for index <= limit {
		if text.substring(index, index + needle.len()) == needle {
			ret Some(index);
		}
		index += 1;
	}
	None
}

/// The count of leading ASCII spaces — the fence-indent measure the docs gate
/// uses. Tabs deliberately do not count (the book indents with spaces).
fun leading_spaces(line: str): i32 {
	let n = line.len();
	mut count = 0;
	for count < n && line.code_at(count) == 32 {
		count += 1;
	}
	count
}

/// Strip up to `columns` leading spaces — CommonMark's fenced-code dedent: a
/// line indented less loses only what it has.
fun dedent(line: str, columns: i32): str {
	mut have = leading_spaces(line);
	if have > columns {
		have = columns;
	}
	line.substring(have, line.len())
}

fun is_blank(line: str): bool {
	line.trim().is_empty()
}

fun is_ascii_digit(c: u32): bool {
	c >= 48 && c <= 57
}

/// ASCII punctuation, CommonMark's escapable set.
fun is_ascii_punctuation(c: u32): bool {
	(c >= 33 && c <= 47) || (c >= 58 && c <= 64) || (c >= 91 && c <= 96) || (c >= 123 && c <= 126)
}

/// `source` as lines: split on `\n`, a trailing `\r` per line stripped.
fun split_lines(source: str): List<str> {
	mut lines: List<str> = [];
	for line in source.split("\n") {
		if line.ends_with("\r") {
			lines.push(line.substring(0, line.len() - 1));
		} else {
			lines.push(line);
		}
	}
	lines
}

/// Whether `trimmed` is a run of the single character `code` — optionally
/// space-separated (the thematic-break spelling) — at least `minimum` long.
fun same_char_line(trimmed: str, code: u32, minimum: i32, allow_spaces: bool): bool {
	let n = trimmed.len();
	mut count = 0;
	mut i = 0;
	for i < n {
		let c = trimmed.code_at(i);
		if c == code {
			count += 1;
		} else if !(allow_spaces && c == 32) {
			ret false;
		}
		i += 1;
	}
	count >= minimum
}

/// A line that would be a setext underline or a thematic break — both outside
/// the census grammar, both refused loudly by the block parser.
fun is_rule_like(trimmed: str): bool {
	same_char_line(trimmed, 45, 2, false) || same_char_line(trimmed, 45, 3, true) || same_char_line(trimmed, 61, 1, false) || same_char_line(trimmed, 42, 3, true) || same_char_line(trimmed, 95, 3, true)
}

// --- ATX headings ------------------------------------------------------------

/// The heading level of a (left-trimmed) line: one to six `#` followed by a
/// space, a tab, or the end of the line; anything else is 0 (not a heading).
fun heading_level(trimmed: str): i32 {
	let n = trimmed.len();
	mut level = 0;
	for level < n && level < 7 && trimmed.code_at(level) == 35 {
		level += 1;
	}
	if level >= 1 && level <= 6 {
		if level == n {
			ret level;
		}
		let next = trimmed.code_at(level);
		if next == 32 || next == 9 {
			ret level;
		}
	}
	0
}

/// The heading's text: the content after the opening `#`s, an optional
/// closing `#` run (preceded by a space/tab, or alone) dropped — mdBook's
/// (CommonMark's) rule, so `## Title ##` slugs as `Title`.
fun heading_content(trimmed: str, level: i32): str {
	let text = trimmed.substring(level, trimmed.len()).trim();
	mut end = text.len();
	for end > 0 && text.code_at(end - 1) == 35 {
		end -= 1;
	}
	if end < text.len() {
		if end == 0 {
			ret "";
		}
		let before = text.code_at(end - 1);
		if before == 32 || before == 9 {
			ret text.substring(0, end).trim();
		}
	}
	text
}

// --- lists -------------------------------------------------------------------

/// The content offset of a list-item marker in a (left-trimmed) line:
/// `- ` / `* ` / `+ ` or `1. ` / `1) `. 0 means "not an item" (item content
/// never starts at offset 0).
fun list_item_content_offset(trimmed: str): i32 {
	let n = trimmed.len();
	if n >= 2 {
		let c = trimmed.code_at(0);
		if (c == 45 || c == 42 || c == 43) && trimmed.code_at(1) == 32 {
			ret 2;
		}
	}
	mut i = 0;
	for i < n && is_ascii_digit(trimmed.code_at(i)) {
		i += 1;
	}
	if i > 0 && i + 1 < n && (trimmed.code_at(i) == 46 || trimmed.code_at(i) == 41) && trimmed.code_at(i + 1) == 32 {
		ret i + 2;
	}
	0
}

fun is_ordered_item(trimmed: str): bool {
	trimmed.len() > 0 && is_ascii_digit(trimmed.code_at(0))
}

// --- block boundaries --------------------------------------------------------

/// Whether `line` opens a new block structure — what ends a paragraph.
fun starts_structure(line: str): bool {
	let trimmed = line.trim();
	trimmed.is_empty() || trimmed.starts_with("```") || trimmed.starts_with("~~~") || heading_level(trimmed) > 0 || is_rule_like(trimmed) || trimmed.starts_with(">") || list_item_content_offset(trimmed) > 0 || trimmed.starts_with("|")
}

/// Whether `line` closes a fence opened at `indent`: the docs gate's rule —
/// the same indentation, and nothing but ``` (trailing spaces allowed).
fun is_fence_close(line: str, indent: i32): bool {
	leading_spaces(line) == indent && line.substring(indent, line.len()).trim() == "```"
}

// --- the inline parser -------------------------------------------------------

/// Parse span-level content. `line` is the enclosing block's opening line,
/// carried for error positions. Out-of-grammar inline constructs (images,
/// footnotes, reference links, strikethrough, raw HTML beyond `<a id>`,
/// backslash escapes) are loud errors.
fun parse_inline(text: str, line: i32): Result<List<Inline>, ParseError> {
	mut out: List<Inline> = [];
	let n = text.len();
	mut plain_from = 0;
	mut i = 0;
	for i < n {
		let c = text.code_at(i);
		if c == 96 {
			// A backtick run opens a code span closed by a run of the SAME
			// length (the proven book_sync rule); an unclosed run is literal.
			mut run = 1;
			for i + run < n && text.code_at(i + run) == 96 {
				run += 1;
			}
			mut close: Option<i32> = None;
			mut cursor = i + run;
			for close is None && cursor < n {
				if text.code_at(cursor) == 96 {
					mut closing = 1;
					for cursor + closing < n && text.code_at(cursor + closing) == 96 {
						closing += 1;
					}
					if closing == run {
						close = Some(cursor);
					} else {
						cursor += closing;
					}
				} else {
					cursor += 1;
				}
			}
			match close {
				Some(let at) => {
					if plain_from < i {
						out.push(Text(text.substring(plain_from, i)));
					}
					mut content = text.substring(i + run, at);
					// CommonMark strips one space when both ends carry one.
					if content.len() >= 2 && content.starts_with(" ") && content.ends_with(" ") {
						content = content.substring(1, content.len() - 1);
					}
					out.push(Code(content));
					i = at + run;
					plain_from = i;
				}
				None => {
					i += run;
				}
			}
		} else if c == 42 {
			// `**strong**` / `*emphasis*`; an unmatched opener is literal.
			let double = i + 1 < n && text.code_at(i + 1) == 42;
			if double {
				match index_of(text, "**", i + 2) {
					Some(let at) => {
						if plain_from < i {
							out.push(Text(text.substring(plain_from, i)));
						}
						out.push(Strong(parse_inline(text.substring(i + 2, at), line)!));
						i = at + 2;
						plain_from = i;
					}
					None => {
						i += 2;
					}
				}
			} else {
				mut close: Option<i32> = None;
				if i + 1 < n && text.code_at(i + 1) != 32 {
					close = index_of(text, "*", i + 1);
				}
				match close {
					Some(let at) => {
						if plain_from < i {
							out.push(Text(text.substring(plain_from, i)));
						}
						out.push(Emph(parse_inline(text.substring(i + 1, at), line)!));
						i = at + 1;
						plain_from = i;
					}
					None => {
						i += 1;
					}
				}
			}
		} else if c == 95 {
			// `_emphasis_`, only at a word boundary (never inside snake_case).
			let open_ok = (i == 0 || !is_word_code(text.code_at(i - 1))) && i + 1 < n && text.code_at(i + 1) != 32 && text.code_at(i + 1) != 9;
			mut close: Option<i32> = None;
			if open_ok {
				mut probe = index_of(text, "_", i + 1);
				mut searching = true;
				for searching {
					match probe {
						Some(let at) => {
							if at + 1 < n && is_word_code(text.code_at(at + 1)) {
								probe = index_of(text, "_", at + 1);
							} else {
								close = Some(at);
								searching = false;
							}
						}
						None => {
							searching = false;
						}
					}
				}
			}
			match close {
				Some(let at) => {
					if plain_from < i {
						out.push(Text(text.substring(plain_from, i)));
					}
					out.push(Emph(parse_inline(text.substring(i + 1, at), line)!));
					i = at + 1;
					plain_from = i;
				}
				None => {
					i += 1;
				}
			}
		} else if c == 33 {
			if i + 1 < n && text.code_at(i + 1) == 91 {
				ret Err(ParseError {
					line = line,
					message = "an image (![alt](destination)) — images are outside the census grammar",
				});
			}
			i += 1;
		} else if c == 91 {
			if i + 1 < n && text.code_at(i + 1) == 94 {
				ret Err(ParseError {
					line = line,
					message = "a footnote ([^label]) — footnotes are outside the census grammar",
				});
			}
			match index_of(text, "]", i + 1) {
				Some(let close_bracket) => {
					let after = close_bracket + 1;
					if after < n && text.code_at(after) == 40 {
						match index_of(text, ")", after + 1) {
							Some(let close_paren) => {
								if plain_from < i {
									out.push(Text(text.substring(plain_from, i)));
								}
								let label = text.substring(i + 1, close_bracket);
								let destination = text.substring(after + 1, close_paren);
								out.push(Link(destination, parse_inline(label, line)!));
								i = close_paren + 1;
								plain_from = i;
							}
							None => {
								i += 1;
							}
						}
					} else if after < n && text.code_at(after) == 91 {
						ret Err(ParseError {
							line = line,
							message = "a reference-style link ([text][label]) — only inline [text](destination) links are in the census grammar",
						});
					} else {
						i += 1;
					}
				}
				None => {
					i += 1;
				}
			}
		} else if c == 126 {
			if i + 1 < n && text.code_at(i + 1) == 126 {
				ret Err(ParseError {
					line = line,
					message = "strikethrough (~~text~~) — outside the census grammar",
				});
			}
			i += 1;
		} else if c == 92 {
			if i + 1 < n && is_ascii_punctuation(text.code_at(i + 1)) {
				let escaped = text.substring(i + 1, i + 2);
				ret Err(ParseError {
					line = line,
					message = "a backslash escape (\\" + escaped + ") — the census grammar's only escape is \\| inside a table cell",
				});
			}
			i += 1;
		} else if c == 60 {
			// `<https://autolink>`, the `<a id="…">` passthrough, or a refused
			// raw tag. A `<` that opens no tag shape is literal text.
			match index_of(text, ">", i + 1) {
				Some(let close) => {
					let inner = text.substring(i + 1, close);
					if inner.starts_with("http://") || inner.starts_with("https://") {
						if plain_from < i {
							out.push(Text(text.substring(plain_from, i)));
						}
						mut label: List<Inline> = [];
						label.push(Text(inner));
						out.push(Link(inner, label));
						i = close + 1;
						plain_from = i;
					} else if inner.starts_with("a id=\"") || inner == "/a" {
						if plain_from < i {
							out.push(Text(text.substring(plain_from, i)));
						}
						out.push(Html(text.substring(i, close + 1)));
						i = close + 1;
						plain_from = i;
					} else if is_tag_shape(inner) {
						ret Err(ParseError {
							line = line,
							message = "a raw HTML tag (<" + inner + ">) — the census grammar's only HTML passthrough is <a id=\"…\"></a>; wrap literal <…> text (a generic like List<T>) in backticks",
						});
					} else {
						i += 1;
					}
				}
				None => {
					i += 1;
				}
			}
		} else {
			i += 1;
		}
	}
	if plain_from < n {
		out.push(Text(text.substring(plain_from, n)));
	}
	Ok(out)
}

fun is_word_code(c: u32): bool {
	(c >= 97 && c <= 122) || (c >= 65 && c <= 90) || is_ascii_digit(c)
}

/// Whether `inner` (the text between `<` and `>`) is tag-shaped: an ASCII
/// letter, or `/` then a letter. Everything tag-shaped that is not the
/// `<a id>` passthrough or an autolink is refused.
fun is_tag_shape(inner: str): bool {
	let n = inner.len();
	if n == 0 {
		ret false;
	}
	let first = inner.code_at(0);
	if (first >= 97 && first <= 122) || (first >= 65 && first <= 90) {
		ret true;
	}
	first == 47 && n >= 2 && ((inner.code_at(1) >= 97 && inner.code_at(1) <= 122) || (inner.code_at(1) >= 65 && inner.code_at(1) <= 90))
}

// --- the heading-id algorithm (mdBook v0.5.4, pinned — §3) -------------------

/// The heading's content as the reader sees it: code spans contribute their
/// characters, emphasis contributes its text, a link contributes its label,
/// raw HTML contributes nothing.
fun inline_text(content: List<Inline>): str {
	mut out = "";
	for inline in content {
		match inline {
			Text(let t) => {
				out = out + t;
			}
			Code(let t) => {
				out = out + t;
			}
			Strong(let children) => {
				out = out + inline_text(children);
			}
			Emph(let children) => {
				out = out + inline_text(children);
			}
			Link(let destination, let children) => {
				out = out + inline_text(children);
			}
			Html(let raw) => {}
		}
	}
	out
}

/// The length of the HTML entity at `i` (`&amp;` `&lt;` `&gt;` `&quot;`
/// `&#39;`), or 0. mdBook slugs the HTML-escaped text, dropping the decoded
/// character — so the whole entity contributes nothing to an id.
fun entity_length(text: str, i: i32): i32 {
	let n = text.len();
	for entity in ["&amp;", "&lt;", "&gt;", "&quot;", "&#39;"] {
		let k = entity.len();
		if i + k <= n && text.substring(i, i + k) == entity {
			ret k;
		}
	}
	0
}

/// The whitespace set mdBook hyphenates (Rust `char::is_whitespace`, the
/// forms a single line can carry).
fun is_slug_whitespace(c: u32): bool {
	c == 32 || c == 9 || c == 133 || c == 160 || c == 5760 || (c >= 8192 && c <= 8202) || c == 8232 || c == 8233 || c == 8239 || c == 8287 || c == 12288
}

/// The curated non-ASCII drop set: the punctuation and symbol planes prose
/// actually writes (mdBook drops them — they are not alphanumeric). A
/// non-ASCII unit outside every range here is KEPT, folded through the host's
/// Unicode lowercase — mdBook's treatment of non-ASCII alphanumerics.
/// Surrogates (non-BMP) are dropped — the documented approximation in the
/// header.
fun is_dropped_symbol(c: u32): bool {
	// C1 controls; Latin-1 punctuation (¡ § « ­ ° · » ¿ …) minus its
	// alphanumerics (ª ² ³ µ ¹ º ¼ ½ ¾); × ÷.
	if c >= 128 && c <= 191 {
		ret !(c == 170 || c == 178 || c == 179 || c == 181 || c == 185 || c == 186 || c == 188 || c == 189 || c == 190);
	}
	c == 215 || c == 247 || (c >= 8203 && c <= 8231) || (c >= 8240 && c <= 8286) || (c >= 8288 && c <= 8303) || (c >= 8352 && c <= 8399) || c == 8482 || (c >= 8592 && c <= 11263) || (c >= 11776 && c <= 11903) || (c >= 12289 && c <= 12351) || (c >= 55296 && c <= 57343) || (c >= 65040 && c <= 65135) || (c >= 65281 && c <= 65295) || (c >= 65306 && c <= 65312) || (c >= 65339 && c <= 65344) || (c >= 65371 && c <= 65381)
	// General punctuation (– — ‘ ’ “ ” † ‡ • … ′ ″) and format controls;
	// the whitespace part is handled by `is_slug_whitespace` first.

	// Currency, ™, arrows, math, technical, box drawing, geometry,
	// symbols, dingbats.

	// Supplemental punctuation; CJK punctuation.

	// Surrogates: non-BMP dropped (see the header contract).

	// Vertical/compat forms, small forms; fullwidth punctuation.
}

/// The mdBook v0.5.4 id of a heading's content, dedupe-free — the §3 base
/// algorithm: the content's text (HTML tags dropped) trimmed, then letters
/// lowercased and kept (the host's Unicode lowercase, mdBook's own fold —
/// `école-été`, verified against a local v0.5.4 build), digits and `-`/`_`
/// kept, each whitespace character its own `-`, HTML entities and everything
/// else dropped (non-ASCII per the curated rules above). Per-document
/// `-1`/`-2` dedupe is `parse`'s job, not this function's.
fun heading_id(content: List<Inline>): str {
	let text = inline_text(content).trim();
	let n = text.len();
	mut out = "";
	mut i = 0;
	for i < n {
		let c = text.code_at(i);
		let entity = entity_length(text, i);
		if entity > 0 {
			i += entity;
		} else if (c >= 97 && c <= 122) || is_ascii_digit(c) || c == 45 || c == 95 {
			out = out + text.substring(i, i + 1);
			i += 1;
		} else if c >= 65 && c <= 90 {
			out = out + text.substring(i, i + 1).to_lowercase_ascii();
			i += 1;
		} else if is_slug_whitespace(c) {
			out = out + "-";
			i += 1;
		} else if c < 128 || is_dropped_symbol(c) {
			i += 1;
		} else {
			// A kept non-ASCII unit: lowercased with the host's Unicode
			// fold (`to_lowercase_ascii` lowers to the host `toLowerCase`),
			// mdBook's own case rule.
			out = out + text.substring(i, i + 1).to_lowercase_ascii();
			i += 1;
		}
	}
	out
}

// --- per-document id assignment ----------------------------------------------

/// The id walk's threaded state: the rebuilt blocks and the base ids seen so
/// far (internal — `parse` drives it).
struct IdWalk {
	blocks: List<Block>,
	used: List<str>,
}

/// Assign each heading its deduped id, in document order, descending into
/// quotes and list items exactly as a renderer would meet them: the second
/// occurrence of a base id `b` becomes `b-1`, the third `b-2` (mdBook's
/// occurrence count per base — a literal `b-1` heading elsewhere does not
/// perturb it).
fun assign_ids(blocks: List<Block>, used_before: List<str>): IdWalk {
	mut used = used_before;
	mut out: List<Block> = [];
	for block in blocks {
		match block {
			Block::Heading(let level, let content, let ignored) => {
				let base = heading_id(content);
				mut seen = 0;
				for prior in used {
					if prior == base {
						seen += 1;
					}
				}
				used.push(base);
				mut id = base;
				if seen > 0 {
					id = base + "-" + seen.to_string();
				}
				out.push(Block::Heading(level, content, id));
			}
			Block::Quote(let inner) => {
				let walked = assign_ids(inner, used);
				used = walked.used;
				out.push(Block::Quote(walked.blocks));
			}
			Block::Items(let ordered, let items) => {
				mut rebuilt: List<List<Block>> = [];
				for item in items {
					let walked = assign_ids(item, used);
					used = walked.used;
					rebuilt.push(walked.blocks);
				}
				out.push(Block::Items(ordered, rebuilt));
			}
			Block::Paragraph(let content) => {
				out.push(Block::Paragraph(content));
			}
			Block::CodeFence(let info, let body) => {
				out.push(Block::CodeFence(info, body));
			}
			Block::Table(let header, let rows) => {
				out.push(Block::Table(header, rows));
			}
		}
	}
	IdWalk { blocks = out, used = used }
}

// --- tables ------------------------------------------------------------------

/// Whether a (trimmed) line is a table delimiter row: `|`-led, dashes, pipes,
/// colons and spaces only, at least two dashes. Colons are accepted HERE so
/// the table branch can refuse them loudly (alignment is out of grammar)
/// rather than silently reading the table as a paragraph.
fun is_delimiter_row(line: str): bool {
	let trimmed = line.trim();
	if !trimmed.starts_with("|") {
		ret false;
	}
	let n = trimmed.len();
	mut dashes = 0;
	mut i = 0;
	for i < n {
		let c = trimmed.code_at(i);
		if c == 45 {
			dashes += 1;
		} else if c != 124 && c != 58 && c != 32 {
			ret false;
		}
		i += 1;
	}
	dashes >= 2
}

/// Split a table row into cells on unescaped `|`, unescaping `\|` — the
/// census's one escape (vilan's closure syntax in cells) — then parse each
/// cell's inline content.
fun parse_row(line: str, line_number: i32): Result<List<List<Inline>>, ParseError> {
	let trimmed = line.trim();
	let n = trimmed.len();
	mut cells: List<List<Inline>> = [];
	mut cell = "";
	mut i = 0;
	if trimmed.starts_with("|") {
		i = 1;
	}
	mut ended_on_pipe = false;
	for i < n {
		let c = trimmed.code_at(i);
		if c == 92 && i + 1 < n && trimmed.code_at(i + 1) == 124 {
			cell = cell + "|";
			i += 2;
			ended_on_pipe = false;
		} else if c == 124 {
			cells.push(parse_inline(cell.trim(), line_number)!);
			cell = "";
			i += 1;
			ended_on_pipe = true;
		} else {
			cell = cell + trimmed.substring(i, i + 1);
			i += 1;
			ended_on_pipe = false;
		}
	}
	if !(ended_on_pipe && cell.is_empty()) {
		cells.push(parse_inline(cell.trim(), line_number)!);
	}
	Ok(cells)
}

// --- the block parser --------------------------------------------------------

/// Parse `lines` (a contiguous source region whose first line is the 1-based
/// `first_line`) into blocks. Heading ids are NOT assigned here — `parse`
/// runs the document-order id walk after the tree exists, so headings nested
/// in quotes or items dedupe exactly as a renderer meets them.
fun parse_blocks(lines: List<str>, first_line: i32): Result<List<Block>, ParseError> {
	let count = lines.len();
	mut blocks: List<Block> = [];
	mut i = 0;
	for i < count {
		let line = lines[i];
		let trimmed = line.trim();
		let indent = leading_spaces(line);
		let line_number = first_line + i;
		if trimmed.is_empty() {
			i += 1;
		} else if indent >= 4 {
			ret Err(ParseError {
				line = line_number,
				message = "an indented code block (four or more leading spaces) — the census grammar's only code blocks are backtick fences",
			});
		} else if trimmed.starts_with("~~~") {
			ret Err(ParseError {
				line = line_number,
				message = "a tilde fence (~~~) — the census grammar's fences use backticks",
			});
		} else if trimmed.starts_with("```") {
			let info = trimmed.substring(3, trimmed.len()).trim();
			mut body = "";
			mut closed = false;
			i += 1;
			for !closed && i < count {
				if is_fence_close(lines[i], indent) {
					closed = true;
				} else {
					body = body + dedent(lines[i], indent) + "\n";
				}
				i += 1;
			}
			if !closed {
				ret Err(ParseError {
					line = line_number,
					message = "an unclosed code fence — no closing ``` at the opening fence's indent",
				});
			}
			blocks.push(Block::CodeFence(info, body));
		} else if heading_level(trimmed) > 0 {
			let level = heading_level(trimmed);
			let content = heading_content(trimmed, level);
			if content.ends_with("}") && content.contains("{#") {
				ret Err(ParseError {
					line = line_number,
					message = "a custom heading id ({#…}) — census-grammar heading ids are computed, mdBook's algorithm",
				});
			}
			blocks.push(Block::Heading(level, parse_inline(content, line_number)!, ""));
			i += 1;
		} else if is_rule_like(trimmed) {
			ret Err(ParseError {
				line = line_number,
				message = "a setext heading underline or thematic break (---, ===, ***) — both outside the census grammar; headings are ATX (# Title)",
			});
		} else if trimmed.starts_with(">") {
			mut inner: List<str> = [];
			let quote_first = line_number;
			for i < count && lines[i].trim().starts_with(">") {
				let quote_line = lines[i].trim();
				mut stripped = quote_line.substring(1, quote_line.len());
				if stripped.starts_with(" ") {
					stripped = stripped.substring(1, stripped.len());
				}
				inner.push(stripped);
				i += 1;
			}
			if i < count && !is_blank(lines[i]) && !starts_structure(lines[i]) {
				ret Err(ParseError {
					line = first_line + i,
					message = "a lazy blockquote continuation — prefix the line with > or separate it from the quote with a blank line",
				});
			}
			blocks.push(Block::Quote(parse_blocks(inner, quote_first)!));
		} else if list_item_content_offset(trimmed) > 0 {
			if indent >= 2 {
				ret Err(ParseError {
					line = line_number,
					message = "an indented list item — the census grammar's lists are flat, at the left margin",
				});
			}
			let ordered = is_ordered_item(trimmed);
			mut items: List<List<Block>> = [];
			mut more = true;
			for more {
				let marker_line = lines[i].trim();
				let offset = list_item_content_offset(marker_line);
				mut body: List<str> = [];
				body.push(marker_line.substring(offset, marker_line.len()));
				let item_first = first_line + i;
				i += 1;
				mut pending_blanks = 0;
				mut in_item = true;
				for in_item && i < count {
					let next = lines[i];
					if is_blank(next) {
						pending_blanks += 1;
						i += 1;
					} else {
						let next_indent = leading_spaces(next);
						if list_item_content_offset(next.trim()) > 0 {
							if next_indent >= 2 {
								ret Err(ParseError {
									line = first_line + i,
									message = "a nested list item — the census grammar's lists are flat",
								});
							}
							in_item = false;
						} else if next_indent >= 2 {
							mut filled = 0;
							for filled < pending_blanks {
								body.push("");
								filled += 1;
							}
							pending_blanks = 0;
							let content = dedent(next, 2);
							body.push(content);
							i += 1;
							if content.trim().starts_with("```") && !content.trim().starts_with("````") {
								// Consume the fence to its close verbatim, so
								// blank body lines stay inside the item.
								let fence_indent = leading_spaces(content);
								mut fence_open = true;
								for fence_open && i < count {
									let fence_line = dedent(lines[i], 2);
									body.push(fence_line);
									if is_fence_close(fence_line, fence_indent) {
										fence_open = false;
									}
									i += 1;
								}
							}
						} else if pending_blanks == 0 && !starts_structure(next) {
							ret Err(ParseError {
								line = first_line + i,
								message = "a lazy list continuation — indent the line under its item (two spaces) or separate it from the list with a blank line",
							});
						} else {
							in_item = false;
						}
					}
				}
				items.push(parse_blocks(body, item_first)!);
				more = i < count && !is_blank(lines[i]) && list_item_content_offset(lines[i].trim()) > 0 && leading_spaces(lines[i]) <= 1 && is_ordered_item(lines[i].trim()) == ordered;
			}
			blocks.push(Block::Items(ordered, items));
		} else if trimmed.starts_with("|") && i + 1 < count && is_delimiter_row(lines[i + 1]) {
			if lines[i + 1].contains(":") {
				ret Err(ParseError {
					line = first_line + i + 1,
					message = "a table alignment colon (:---) — the census grammar's tables carry no alignment",
				});
			}
			let header = parse_row(lines[i], line_number)!;
			i += 2;
			mut rows: List<List<List<Inline>>> = [];
			for i < count && lines[i].trim().starts_with("|") {
				rows.push(parse_row(lines[i], first_line + i)!);
				i += 1;
			}
			blocks.push(Block::Table(header, rows));
		} else if is_reference_definition(trimmed) {
			ret Err(ParseError {
				line = line_number,
				message = "a reference link definition ([label]: destination) — only inline [text](destination) links are in the census grammar",
			});
		} else {
			// A paragraph: this line plus its continuations, joined with
			// single spaces. A continuation after two trailing spaces (or a
			// trailing backslash) would be a hard line break — out of grammar.
			mut text = trimmed;
			mut previous = line;
			i += 1;
			for i < count && !starts_structure(lines[i]) {
				if previous.ends_with("  ") {
					ret Err(ParseError {
						line = first_line + i - 1,
						message = "a hard line break (two trailing spaces) — outside the census grammar",
					});
				}
				if previous.ends_with("\\") {
					ret Err(ParseError {
						line = first_line + i - 1,
						message = "a backslash line break — outside the census grammar",
					});
				}
				text = text + " " + lines[i].trim();
				previous = lines[i];
				i += 1;
			}
			blocks.push(Block::Paragraph(parse_inline(text, line_number)!));
		}
	}
	Ok(blocks)
}

/// Whether a (trimmed) block-start line is a reference link definition:
/// `[label]:` — refused loudly, never read as prose.
fun is_reference_definition(trimmed: str): bool {
	if !trimmed.starts_with("[") {
		ret false;
	}
	match index_of(trimmed, "]", 1) {
		Some(let close) => close + 1 < trimmed.len() && trimmed.code_at(close + 1) == 58,
		None => false,
	}
}

// --- the entry point ---------------------------------------------------------

/// Parse a census-scoped markdown document. STRICT: a construct outside the
/// grammar (proposal/markdown.md §1.2) is an `Err` naming the construct and
/// its line — the ruled failure mode, so the first page to write a footnote
/// fails loudly instead of rendering wrong. On `Ok`, every heading carries
/// its mdBook-compatible id, deduped per document.
fun parse(source: str): Result<Doc, ParseError> {
	let blocks = parse_blocks(split_lines(source), 1)!;
	mut none: List<str> = [];
	let walked = assign_ids(blocks, none);
	Ok(Doc { blocks = walked.blocks })
}
