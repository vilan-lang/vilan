import pkg::option::Option::{ None, Some, self };
import pkg::random::range;

// `std::arena` — a generational arena: stable, deletion-safe identities for
// values of any type `T`, with no per-type bookkeeping.
//
// A `Handle<T>` is two integers, so — unlike a view — it is storable in struct
// fields and collections. That is the entire point: it lets a `Node` hold its
// edges as `List<Handle<Node>>`, expressing graphs/cycles that value semantics
// and second-class views otherwise forbid. You traverse by re-`get`, so the
// container stays mutable while you walk it; a removed-then-reused slot bumps
// its generation, so an old handle to it surfaces as `None` rather than aliasing
// the new occupant.

/// A first-class key into an `Arena<T>`: the slot index plus the generation it
/// was issued at. Copied freely; storable anywhere a plain value is — and, being
/// two plain integers, sendable: `[derive(Wire)]` makes a handle a **name that
/// crosses the wire** (`claims-and-epochs.md` §6), so a server-side arena's
/// handles are the stable entity references clients quote back. `T` is phantom
/// here — it types the arena the handle belongs to, and never appears in the
/// payload, which is exactly `{ index, generation }`.
[derive(Wire)]
struct Handle<T> {
	index: i32,
	generation: i32,
}

/// One arena slot: a generation counter (bumped on removal so stale handles go
/// `None`, and started at the arena's `brand`) and the stored value. Occupancy
/// is tracked by the generation alone — a live handle's generation only ever
/// matches an occupied slot, since removal bumps it — so a freed slot simply
/// keeps its last value until the slot is reused and overwritten.
struct Slot<T> {
	generation: i32,
	value: T,
}

/// A generational arena over `T`. `free` holds emptied indices, reused on the
/// next insert. `brand` is where this arena's generation counters START: `0` for
/// a plain arena, a random value for a `branded()` one (see `branded`).
struct Arena<T> {
	slots: List<Slot<T>>,
	free: List<i32>,
	brand: i32,
}

impl Arena<type T> {
	fun new(): Arena<T> {
		Arena { slots = List::new(), free = List::new(), brand = 0 }
	}

	/// An arena whose handles are **branded**: its generation counters start at
	/// a random value instead of `0`, so a handle issued by one branded arena
	/// resolves to `None` in every other arena rather than silently naming that
	/// arena's slot of the same index.
	///
	/// Reach for it when handles cross a trust boundary — the cross-tenant case
	/// of `claims-and-epochs.md` §6. The blessed default is still a **per-session
	/// arena**: scope the arena to the session and a handle names nothing outside
	/// it by construction. Branding is the belt to those suspenders, for when one
	/// arena is shared and its handles must not be interchangeable.
	///
	/// It is a confusion guard, not an authorization check: the brand travels
	/// inside the handles it issues, so a client holding one valid handle can
	/// derive it. Authorize the session first; then look the handle up in that
	/// session's arena.
	fun branded(): Arena<T> {
		Arena { slots = List::new(), free = List::new(), brand = range(1, 1073741823) }
	}

	/// Store `value`, returning a handle to it. Reuses a freed slot when one is
	/// available, otherwise appends a new one.
	fun insert(&mut self, value: T): Handle<T> {
		match self.free.pop() {
			Some(let index) => {
				self.slots[index].value = value;
				Handle { index = index, generation = self.slots[index].generation }
			},
			None => {
				let index = self.slots.len();
				self.slots.push(Slot { generation = self.brand, value = value });
				Handle { index = index, generation = self.brand }
			},
		}
	}

	/// Whether `handle` still refers to a live value: in range and the slot's
	/// generation matches. (Removal bumps the generation, so a matching
	/// generation is exactly an occupied slot.) This one comparison carries the
	/// brand too: a `branded()` arena's counters start from its brand, so a
	/// foreign handle's generation cannot match — a mismatch is `None`/`false`,
	/// never a panic.
	fun contains(self, handle: Handle<T>): bool {
		handle.index < self.slots.len() && self.slots[handle.index].generation == handle.generation
	}

	/// A view of the value `handle` refers to, or `None` if the handle is stale
	/// (its slot was removed, or reused under a newer generation). The view is
	/// second-class: it may not outlive an invalidating mutation of the arena,
	/// and cannot be stored — traverse by re-`get`, and write through `set`.
	fun get(&self, handle: Handle<T>): Option<&T> borrows self {
		if self.contains(handle) {
			Some(&self.slots[handle.index].value)
		} else {
			None
		}
	}

	/// Overwrite the value a live handle refers to, in place. Returns whether the
	/// handle was valid (a stale handle changes nothing).
	fun set(&mut self, handle: Handle<T>, value: T): bool {
		if self.contains(handle) {
			self.slots[handle.index].value = value;
			true
		} else {
			false
		}
	}

	/// Remove and return the value `handle` refers to, freeing its slot and
	/// bumping the slot's generation so every existing handle to it goes stale.
	fun remove(&mut self, handle: Handle<T>): Option<T> {
		if self.contains(handle) {
			let removed = self.slots[handle.index].value;
			self.slots[handle.index].generation = self.slots[handle.index].generation + 1;
			self.free.push(handle.index);
			Some(removed)
		} else {
			None
		}
	}

	/// The number of live values (occupied slots).
	fun len(self): i32 {
		self.slots.len() - self.free.len()
	}

	fun is_empty(self): bool {
		self.len() == 0
	}
}
