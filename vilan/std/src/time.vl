// `std::time` (K5, proposal/kolt-migration.md §2.5) — instants, durations,
// and sleeping, over the host clock. Deliberately minimal (not a luxon):
// epoch-milli `Instant`s, signed `Duration` arithmetic, ISO rendering, and a
// coarse `describe()`. Grows from real call sites.
//
// `now()` reads the host clock — an impure capability, so it is NOT
// const-evaluable (a `const now()` is a compile error, correctly). Both
// types are wire-able: a timestamp is plain data (one i53), so it can ride
// rpc payloads and mirrors.

import pkg::compare::{ Ordering, PartialEq, PartialOrd };
import pkg::operators::{ Add, Sub };
import pkg::option::Option::{ self, None, Some };
import pkg::shared::Shared;
import pkg::task::{ CancelSignal, ambient_signal };

// --- The clock ---------------------------------------------------------------

/// Milliseconds since the Unix epoch, read from the host clock (`Date.now`) —
/// the raw sample, for hot paths that just want float math (benchmarks).
[extern("Date.now")]
external fun now_millis(): f64;

/// The current moment, typed.
fun now(): Instant {
	Instant { millis = now_millis().as_i53() }
}

// --- Instants and durations ---------------------------------------------------

/// A moment in time: milliseconds since the Unix epoch. Plain data — compare
/// it, ship it over the wire, subtract two for a `Duration`.
[derive(Wire, PartialEq)]
struct Instant {
	millis: i53,
}

/// A signed span of time in milliseconds (`later.since(earlier)` is negative
/// when `later` is actually earlier).
[derive(Wire, PartialEq)]
struct Duration {
	millis: i53,
}

impl Instant {
	/// The span from `earlier` to `self`.
	fun since(self, earlier: Instant): Duration {
		Duration { millis = self.millis - earlier.millis }
	}

	/// ISO-8601 in UTC (`1970-01-01T00:00:00.000Z`), via the host `Date`.
	fun to_iso(self): str {
		host_date(self.millis).to_iso_string()
	}
}

// `instant + duration` / `instant - duration` shift a moment.
impl Instant with Add<Duration> {
	fun add(self, b: Duration): Instant {
		Instant { millis = self.millis + b.millis }
	}
}

impl Instant with Sub<Duration> {
	fun sub(self, b: Duration): Instant {
		Instant { millis = self.millis - b.millis }
	}
}

impl Instant with PartialOrd {
	fun partial_compare(self, b: Instant): Option<Ordering> {
		self.millis.partial_compare(b.millis)
	}
}

impl Duration {
	fun millis(count: i53): Duration {
		Duration { millis = count }
	}

	fun seconds(count: i53): Duration {
		Duration { millis = count * 1000i53 }
	}

	fun minutes(count: i53): Duration {
		Duration { millis = count * 60000i53 }
	}

	fun hours(count: i53): Duration {
		Duration { millis = count * 3600000i53 }
	}

	fun days(count: i53): Duration {
		Duration { millis = count * 86400000i53 }
	}

	/// Whole units, truncated toward zero (i53 division).
	fun as_seconds(self): i53 {
		self.millis / 1000i53
	}

	fun as_minutes(self): i53 {
		self.millis / 60000i53
	}

	fun as_hours(self): i53 {
		self.millis / 3600000i53
	}

	fun as_days(self): i53 {
		self.millis / 86400000i53
	}

	/// A coarse human rendering: the two largest non-zero units — "2h 3m",
	/// "5m 30s", "980ms", "0ms" — with a leading "-" for a negative span.
	fun describe(self): str {
		let sign = if self.millis < 0i53 { "-" } else { "" };
		let magnitude = if self.millis < 0i53 { 0i53 - self.millis } else { self.millis };
		let parts = split_units(magnitude);
		sign + parts
	}
}

fun split_units(millis: i53): str {
	let days = millis / 86400000i53;
	let hours = (millis / 3600000i53) % 24i53;
	let minutes = (millis / 60000i53) % 60i53;
	let seconds = (millis / 1000i53) % 60i53;
	if days > 0i53 {
		join_units(i"{days}d", hours, "h")
	} else if hours > 0i53 {
		join_units(i"{hours}h", minutes, "m")
	} else if minutes > 0i53 {
		join_units(i"{minutes}m", seconds, "s")
	} else if seconds > 0i53 {
		i"{seconds}s"
	} else {
		i"{millis}ms"
	}
}

fun join_units(head: str, count: i53, unit: str): str {
	if count > 0i53 {
		i"{head} {count}{unit}"
	} else {
		head
	}
}

impl Duration with Add {
	fun add(self, b: Duration): Duration {
		Duration { millis = self.millis + b.millis }
	}
}

impl Duration with Sub {
	fun sub(self, b: Duration): Duration {
		Duration { millis = self.millis - b.millis }
	}
}

impl Duration with PartialOrd {
	fun partial_compare(self, b: Duration): Option<Ordering> {
		self.millis.partial_compare(b.millis)
	}
}

// --- The host `Date` (rendering only) ------------------------------------------

external struct HostDate;

[extern(new, "Date")]
external fun host_date(millis: i53): HostDate;

impl HostDate {
	[extern(method, "toISOString")]
	external fun to_iso_string(self): str;
}

// --- Sleeping ------------------------------------------------------------------

/// The abortable host timer: resolves after `ms`, or rejects with the abort
/// reason if the signal fires first (the runtime helper clears the timer).
[extern("__sleep")]
async external fun __sleep(ms: i32, signal: Option<CancelSignal>): void;

/// Pause the current async flow for `ms` milliseconds (`setTimeout` as a
/// promise). Async — a caller awaits it implicitly. Inside a nursery's
/// dynamic extent the sleep carries the ambient cancel signal (the
/// structural bridge), so cancellation cuts it short instead of waiting the
/// timer out.
fun sleep(ms: i32) {
	__sleep(ms, ambient_signal());
}

/// `sleep`, taking a `Duration` (the K6 backoff shape). Spans beyond i32
/// milliseconds (~24 days) are not supported by the host timer.
fun sleep_for(duration: Duration) {
	sleep(duration.millis.as_i32());
}

// --- Cancelable timers ---------------------------------------------------------

/// The host timer handle behind `Timer` — a `setTimeout` id plus the verdict
/// it settles on (the `__timer` runtime helper). Not part of the surface;
/// hold a `Timer`.
external struct TimerHandle;

[extern("__timer")]
external fun __timer(ms: i32): TimerHandle;

impl TimerHandle {
	[extern(method, "wait")]
	async external fun wait(self, signal: Option<CancelSignal>): bool;

	[extern(method, "cancel")]
	external fun cancel(self);
}

/// A running timer you can wait on or call off — `setTimeout` and
/// `clearTimeout` as one value. Where `sleep` is a suspension nobody can
/// reach into, a `Timer` is a thing you hold: start it now, hand it around,
/// and later either learn that it fired or take it back.
///
/// It starts on construction, and it settles exactly once, on a verdict:
/// `true` if it fired, `false` if `cancel()` got there first. That verdict is
/// remembered, so every waiter — one parked before it settled, one arriving
/// long after — gets the same answer, and asking a settled timer is
/// immediate.
///
/// A `Timer` is an ordinary value wrapping that host handle, so copying it
/// (assigning it, passing it, storing it in a field) shares the ONE timer,
/// the way a `Signal` shares its cell: cancelling through any copy settles
/// them all.
///
/// A pending timer keeps the host alive — on node the process will not exit
/// while one is outstanding, exactly as an outstanding `sleep` holds it open.
/// Cancel the timer if you want the program to be free to end.
struct Timer {
	handle: TimerHandle,
}

impl Timer {
	/// Start a timer that fires in `ms` milliseconds. The clock starts here,
	/// not at the first `wait` — nothing has to be awaiting it for it to run
	/// out.
	fun after(ms: i32): Timer {
		Timer { handle = __timer(ms) }
	}

	/// `after`, taking a `Duration` (the `sleep_for` shape). Spans beyond i32
	/// milliseconds (~24 days) are not supported by the host timer.
	fun after_for(duration: Duration): Timer {
		Timer::after(duration.millis.as_i32())
	}

	/// Wait for the verdict: `true` when the timer fired, `false` when it was
	/// cancelled. Async — a caller awaits it implicitly. Inside a nursery's
	/// dynamic extent the wait carries the ambient cancel signal, exactly as
	/// `sleep` does: cancelling the nursery tears down THIS wait (the task
	/// awaiting it unwinds) but does not touch the timer — no verdict, no
	/// `clearTimeout` — because the timer belongs to whoever holds the value.
	/// Its other holders can still wait on it, or cancel it.
	fun wait(self): bool {
		self.handle.wait(ambient_signal())
	}

	/// Call the timer off: clear the host timer and settle the verdict
	/// `false`, so anything waiting resolves `false` at once. A timer that has
	/// already settled — fired, or cancelled before — is untouched, so this is
	/// idempotent and a late cancel never rewrites a `true` into a `false`.
	fun cancel(self) {
		self.handle.cancel();
	}
}

// --- Debounce ------------------------------------------------------------------

/// Collapses a burst of calls into ONE, `delay` after the last of them —
/// trailing edge.
///
/// Each `run` pushes the deadline out and REPLACES the callback, so a burst
/// fires once, late, with the LAST callback: exactly what a search field wants
/// (one query, for the text the user stopped typing) and what a resize handler
/// wants (one layout pass, at the size the window settled at). There is at most
/// one timer in flight however many times `run` is called.
///
/// It is trailing edge and not leading: the first call of a burst does not fire.
/// A leading-edge `Throttle` is deliberately NOT shipped here — it is a
/// different mechanism rather than a flag on this one (it fires immediately and
/// then SUPPRESSES, so it needs no pending callback at all and its timer gates
/// rather than schedules), and nothing has asked for it. It lands when something
/// does, beside this rather than inside it.
///
///     let search = Debounce::new(Duration::millis(300));
///     input.on_event("input", |event| {
///         let text = event.target_value();
///         search.run(|| query.set(text));
///     });
///
/// Like `Timer`, a `Debounce` is a value wrapping shared cells, so copying it
/// (binding it, passing it, keeping it in a field) shares the ONE debounce:
/// `run` through any copy pushes the same deadline.
///
/// It takes no owner and registers no cleanup. `std::time` is the base clock
/// module and sits below `std::reactive`, so a `Debounce` is a plain value in
/// the shape `Timer` already established — `cancel()` is the teardown, and an
/// app that wants one tied to a scope wraps it itself. A pending debounce keeps
/// the host alive until it fires (the outstanding timer does), so cancel one you
/// are done with if you want the program to be free to end.
struct Debounce {
	delay: Duration,
	/// The deadline and the callback that will run at it — replaced whole by
	/// every `run`, cleared when it fires or is cancelled.
	///
	/// The `Shared` cell IS required, and both directions of the rule are
	/// load-bearing (`docs/spec/memory.md` §6). `run` takes `self` by loan and
	/// the `async` block OUTLIVES that loan: it reads this field on every timer
	/// tick, long after `run` returned. Rule 1 (§6.1) is why a plain field
	/// cannot serve — values are copied, so the block would capture a COPY of
	/// the deadline made at spawn time and never see a later `run`'s push, and
	/// the copy it wrote would be discarded. `Shared` is the cell that makes
	/// that escape legal, and rule 3 (§6.3) is what lets the block WRITE
	/// through what is only a loan: `write()` is a second-class view projected
	/// from the cell, not from `self`'s stack slot. (This is kolt's own
	/// `// TODO: Investigate whether the `Shared` cell is needed.`, answered:
	/// yes, and it cannot be a plain field.)
	pending: Shared<Option<(Instant, || void)>>,
	/// Whether a driving `async` loop is live. Set SYNCHRONOUSLY by `run`
	/// before it spawns one, so that two `run`s in the same tick cannot both
	/// spawn — a guard the spawned block cannot provide for itself, whatever
	/// the host's scheduling does with it.
	///
	/// It also survives `cancel`: the loop is still parked when `cancel`
	/// returns, so a `run` immediately after a `cancel` must NOT start a second
	/// loop. It hands the still-live one a fresh deadline instead, which the
	/// loop picks up when its cancelled wait resolves.
	running: Shared<bool>,
	/// The in-flight timer, so `cancel` can call it off rather than let it run
	/// out. Without it a cancelled debounce fires nothing (the loop re-reads
	/// `pending` and finds `None`) but still holds the host open for the rest of
	/// the delay.
	timer: Shared<Option<Timer>>,
}

impl Debounce {
	/// A debounce that fires `delay` after the last `run`.
	fun new(delay: Duration): Debounce {
		Debounce {
			delay,
			pending = Shared::new(None),
			running = Shared::new(false),
			timer = Shared::new(None),
		}
	}

	/// Schedule `fn` to run `delay` from now, REPLACING whatever was pending.
	///
	/// Calls inside the window collapse: the deadline moves out to `delay` from
	/// THIS call and the callback becomes this one, so the burst costs one run
	/// of the last closure. A call after the previous one has fired starts a
	/// fresh window.
	fun run(self, fn: || void) {
		self.pending.write() = Some((now() + self.delay, fn));
		// A loop already driving this cell — parked on a timer, or between one
		// and the next — re-reads the deadline after every wait, so the push
		// above is all this call has to do. Only the first call of a window
		// starts one.
		if !self.running.read() {
			self.running.write() = true;
			async {
				for self.pending.read() is Some(let (deadline, _)) {
					let timer = Timer::after_for(deadline.since(now()));
					self.timer.write() = Some(timer);
					if timer.wait() {
						self.timer.write() = None;
						// Re-read: a `run` that arrived DURING the wait pushed the
						// deadline out, so the timer that just fired is early and
						// the loop takes another turn. This is what makes a burst
						// one run rather than one run per call.
						if self.pending.read() is Some(let (moment, latest)) {
							if now() >= moment {
								self.pending.write() = None;
								latest();
							}
						}
					} else {
						// `cancel` called the timer off. `pending` decides what
						// happens next: `None` ends the loop at the head, `Some`
						// (a `run` that came after the cancel) starts a new wait.
						self.timer.write() = None;
					}
				}
				self.running.write() = false;
			};
		}
	}

	/// Drop the pending callback and call the in-flight timer off: nothing
	/// fires, and the host is released now rather than at the deadline.
	///
	/// Idempotent, and safe with nothing pending. A `run` after a `cancel`
	/// starts a fresh window in the ordinary way.
	fun cancel(self) {
		self.pending.write() = None;
		if self.timer.read() is Some(let timer) {
			self.timer.write() = None;
			timer.cancel();
		}
	}
}
