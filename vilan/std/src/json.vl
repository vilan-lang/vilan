// `std::json` — JSON serialization (`to_json`) and parsing (`from_json`), plus
// the JSON pair of the wire visitor (`JsonWriter`/`JsonReader`, §6.1).
//
// `[derive(Json)]` on a struct synthesizes BOTH directions from its fields: a
// faithful JSON object with real field names (which a bare host-`JSON.stringify`
// of a vilan struct can't produce, since structs lower to field-less arrays) and
// a `from_json` that rebuilds the struct from that object. The scalar impls bind
// to the host `JSON.stringify`/`JSON.parse` and the host coercions.

import pkg::bytes::decode_utf8;
import pkg::option::Option::{ self, None, Some };
import pkg::result::Result::{ self, Err, Ok };
import pkg::wire::{ Codec, Deserialize, Deserializer, Frame, Serialize, Serializer, Wire };

// --- Serialization (`to_json`) ------------------------------------------------

export trait Json {
	fun to_json(self): str;
}

// An absent `Option` is JSON `null`; a present one serializes its value.
export impl Option<type T: Json> with Json {
	fun to_json(self): str {
		match self {
			Option::Some(let value) => value.to_json(),
			Option::None => "null",
		}
	}
}

// A `List` is a JSON array — each element serialized via its own `to_json`.
export impl List<type T: Json> with Json {
	fun to_json(self): str {
		mut result = "[";
		mut first = true;
		for element in self {
			if !first {
				result = result + ",";
			}
			result = result + element.to_json();
			first = false;
		}
		result + "]"
	}
}

export impl str with Json {
	[extern("JSON.stringify")]
	external fun to_json(self): str;
}

export impl i32 with Json {
	[extern("JSON.stringify")]
	external fun to_json(self): str;
}

export impl u32 with Json {
	[extern("JSON.stringify")]
	external fun to_json(self): str;
}

export impl f64 with Json {
	[extern("JSON.stringify")]
	external fun to_json(self): str;
}

export impl bool with Json {
	[extern("JSON.stringify")]
	external fun to_json(self): str;
}

// --- Parsing (`from_json`) ----------------------------------------------------

/// An opaque handle to a host value produced by `JSON.parse` — a number, string,
/// bool, or object. `from_json` parses a document into one of these once, then
/// `from_json_value` walks it, reading named fields and coercing the leaves back
/// to vilan scalars.
export external struct JsonValue;

/// `JSON.parse(text)` — parse a document into a `JsonValue`. TRUSTING: malformed
/// text is a host exception. The validating decode paths (`decode_json`, the
/// codec's reader) go through `try_parse_json` instead.
export [extern("JSON.parse")]
external fun parse_json_value(text: str): JsonValue;

// `JSON.parse`, guarded (an intrinsic): `None` for malformed text instead of a
// host exception — a wire frame is attacker-supplied input, so the codec must
// refuse it as a decode error, never a crash.
export impl str {
	external fun try_parse_json(self): Option<JsonValue>;
}

/// The normalized JSON type of a value — the six shapes a JSON document can
/// hold. A backed enum, so a `JsonKind` IS the string the intrinsic answers
/// with: `value.kind() == JsonKind::Number` is one `===` against `"number"`,
/// exactly what the hand-written `is_number()` predicate compiled to before it.
///
/// The set is closed over JSON, not over every `JsonValue`. A `JsonValue` is
/// whatever the host handed over, so `value.field("absent")` — a key the object
/// does not have — has a kind outside this set. `==` answers `false` for it, as
/// it always did; an exhaustive `match` over `JsonKind` traps and names it.
/// `has_field` is the check that keeps you out of that case.
export enum JsonKind {
	Null = "null",
	Bool = "boolean",
	Number = "number",
	String = "string",
	Array = "array",
	Object = "object",
}

export impl JsonValue {
	/// `self[name]` — the value at a named object field (an intrinsic: there is no
	/// host function for dynamic property access).
	external fun field(self, name: str): JsonValue;

	/// The externally-tagged discriminator of an enum value: the string itself
	/// when this is a bare `"Variant"`, else the single key of a `{"Variant":..}`
	/// object (an intrinsic — `typeof`/`Object.keys` have no plain extern shape).
	external fun tag(self): str;

	/// The elements of a parsed JSON array, each a `JsonValue`.
	external fun elements(self): List<JsonValue>;

	/// Whether this value is JSON `null` (the `Option::None` discriminator).
	external fun is_null(self): bool;

	/// The normalized JSON type (an intrinsic: `typeof` mis-buckets arrays and
	/// null). The decode type checks below read it so a leaf refuses a
	/// wrong-shaped value instead of coercing it to garbage.
	external fun kind(self): JsonKind;

	/// Whether an object has a named field — the missing-field check the derived
	/// struct decoder reads (a method so it resolves through the value's type in
	/// generated code, like `field`/`tag`).
	fun has_field(self, name: str): bool {
		has_json_field(self, name)
	}
}

/// Decoding is fallible and NEVER crashes: a missing field, a wrong shape, or
/// text that is not JSON at all is a decode error, not `undefined` garbage and
/// not a thrown `JSON.parse` (the same rule the wire codec follows — I3). Both
/// methods return `Result`; `from_json` parses the text (non-crashing) and hands
/// off to `from_json_value`, which validates the value's shape. Callers thread
/// failures with `!` or handle the `Result`.
export trait FromJson {
	/// Parse a JSON document into a value of this type.
	fun from_json(text: str): Result<Self, str>;
	/// Rebuild this type from an already-parsed value (used when nesting).
	fun from_json_value(value: JsonValue): Result<Self, str>;
}

/// The scalar leaves check the JSON type before coercing (`Number`/`String`/
/// `Boolean` would otherwise turn `undefined`/a wrong type into `NaN`/`"undefined"`
/// /`true`). The raw coercion stays a host extern, now reached only past the check.
export [extern("String")]
external fun coerce_str(value: JsonValue): str;
export [extern("Boolean")]
external fun coerce_bool(value: JsonValue): bool;
[extern("Number")]
external fun coerce_i8(value: JsonValue): i8;
[extern("Number")]
external fun coerce_u8(value: JsonValue): u8;
[extern("Number")]
external fun coerce_i16(value: JsonValue): i16;
[extern("Number")]
external fun coerce_u16(value: JsonValue): u16;
[extern("Number")]
external fun coerce_i32(value: JsonValue): i32;
[extern("Number")]
external fun coerce_u32(value: JsonValue): u32;
[extern("Number")]
external fun coerce_i53(value: JsonValue): i53;
[extern("Number")]
external fun coerce_u53(value: JsonValue): u53;
[extern("Number")]
external fun coerce_f32(value: JsonValue): f32;
[extern("Number")]
external fun coerce_f64(value: JsonValue): f64;

export impl str with FromJson {
	fun from_json(text: str): Result<str, str> {
		match text.try_parse_json() {
			Some(let value) => str::from_json_value(value),
			None => Err("not valid JSON"),
		}
	}
	fun from_json_value(value: JsonValue): Result<str, str> {
		if value.kind() == JsonKind::String {
			Ok(coerce_str(value))
		} else {
			Err("expected a string")
		}
	}
}

export impl i32 with FromJson {
	fun from_json(text: str): Result<i32, str> {
		match text.try_parse_json() {
			Some(let value) => i32::from_json_value(value),
			None => Err("not valid JSON"),
		}
	}
	fun from_json_value(value: JsonValue): Result<i32, str> {
		if value.kind() == JsonKind::Number {
			Ok(coerce_i32(value))
		} else {
			Err("expected a number")
		}
	}
}

export impl u32 with FromJson {
	fun from_json(text: str): Result<u32, str> {
		match text.try_parse_json() {
			Some(let value) => u32::from_json_value(value),
			None => Err("not valid JSON"),
		}
	}
	fun from_json_value(value: JsonValue): Result<u32, str> {
		if value.kind() == JsonKind::Number {
			Ok(coerce_u32(value))
		} else {
			Err("expected a number")
		}
	}
}

export impl f64 with FromJson {
	fun from_json(text: str): Result<f64, str> {
		match text.try_parse_json() {
			Some(let value) => f64::from_json_value(value),
			None => Err("not valid JSON"),
		}
	}
	fun from_json_value(value: JsonValue): Result<f64, str> {
		if value.kind() == JsonKind::Number {
			Ok(coerce_f64(value))
		} else {
			Err("expected a number")
		}
	}
}

export impl bool with FromJson {
	fun from_json(text: str): Result<bool, str> {
		match text.try_parse_json() {
			Some(let value) => bool::from_json_value(value),
			None => Err("not valid JSON"),
		}
	}
	fun from_json_value(value: JsonValue): Result<bool, str> {
		if value.kind() == JsonKind::Bool {
			Ok(coerce_bool(value))
		} else {
			Err("expected a boolean")
		}
	}
}

// A JSON `null` is `None`; anything else is `Some` of the parsed value.
export impl Option<type T: FromJson> with FromJson {
	fun from_json(text: str): Result<Option<T>, str> {
		match text.try_parse_json() {
			Some(let value) => Option::from_json_value(value),
			None => Err("not valid JSON"),
		}
	}
	fun from_json_value(value: JsonValue): Result<Option<T>, str> {
		if value.is_null() {
			Ok(Option::None)
		} else {
			Ok(Option::Some(T::from_json_value(value)!))
		}
	}
}

// A JSON array rebuilds into a `List`, each element parsed via its own type; the
// first bad element short-circuits the decode.
export impl List<type T: FromJson> with FromJson {
	fun from_json(text: str): Result<List<T>, str> {
		match text.try_parse_json() {
			Some(let value) => List::from_json_value(value),
			None => Err("not valid JSON"),
		}
	}
	fun from_json_value(value: JsonValue): Result<List<T>, str> {
		if value.kind() != JsonKind::Array {
			ret Err("expected an array")
		}
		mut result: List<T> = [];
		for element in value.elements() {
			result.push(T::from_json_value(element)!);
		}
		Ok(result)
	}
}

// --- The wire visitor's JSON pair (transport-rpc.md §6.1) -----------------------

/// Whether a parsed object has a named field (`Object.hasOwn`) — the missing-
/// field check behind the reader's sticky decode errors.
export [extern("Object.hasOwn")]
external fun has_json_field(value: JsonValue, name: str): bool;

/// The write side: builds the JSON text as a `Wire` value describes itself.
/// Separator discipline is one flag plus a stack: `pending_comma` says whether
/// the next value at the current level needs a `,` first; opening an aggregate
/// saves the parent's flag and starts fresh, closing restores it. A `field`
/// writes its own separator and glues its value (no comma between `"name":` and
/// the value). Variant arities are tracked so `end_variant` knows what to close.
///
/// PLAIN FIELDS behind `&mut self` (A108). Until the visitor's receivers moved,
/// every one of these four was a `Shared` cell — not because the state is
/// shared with anything, but because `Serialize` declared `begin_struct(self)`
/// and a by-value receiver cannot write a field. The cells were the language
/// telling the code what shape it may have
/// (`signal-cell-representation.md` §2.4's frame-scoped class); the receiver
/// was the thing to fix.
struct JsonWriter {
	out: str,
	pending_comma: bool,
	saved_commas: List<bool>,
	variant_arities: List<i32>,
}

impl JsonWriter {
	fun new(): JsonWriter {
		JsonWriter { out = "", pending_comma = false, saved_commas = [], variant_arities = [] }
	}

	/// Appends `text` as one value at the current level: separator first, and
	/// the NEXT value here will need one too.
	fun value(&mut self, text: str) {
		if self.pending_comma {
			self.out = self.out + ",";
		}
		self.out = self.out + text;
		self.pending_comma = true;
	}

	/// Opens an aggregate: the opener is a value at the parent level; inside,
	/// the first item needs no separator.
	fun open(&mut self, opener: str) {
		self.value(opener);
		self.saved_commas.push(true);
		self.pending_comma = false;
	}

	/// Closes an aggregate and restores the parent level's separator state.
	fun close(&mut self, closer: str) {
		self.out = self.out + closer;
		self.pending_comma = match self.saved_commas.pop() {
			Some(let saved) => saved,
			None => false,
		};
	}

	/// The finished document.
	fun result(&self): str {
		self.out
	}
}

// The visitor's write half, natively — `describe` monomorphizes straight onto
// these methods on the direct path.
// EXPORTED deliberately, and B354 is the reason: a `[derive(Wire)]` visitor is
// generated code, and its admitting file is the file the ATTRIBUTE was written
// in - a USER's file, which cannot reach a private std block and cannot be asked
// to write `#(impl JsonWriter)` for one. The Order 36 sweep exported these under
// the sentinel rule; they stay exported under the right one. The plain blocks
// above/below need no export: a derived body only ever calls the VISITOR methods.
export impl JsonWriter with Serialize {
	fun begin_struct(&mut self, fields: i32) {
		self.open("{");
	}

	fun field(&mut self, name: str) {
		if self.pending_comma {
			self.out = self.out + ",";
		}
		self.out = self.out + name.to_json() + ":";
		self.pending_comma = false;
	}

	fun end_struct(&mut self) {
		self.close("}");
	}

	fun begin_list(&mut self, length: i32) {
		self.open("[");
	}

	fun end_list(&mut self) {
		self.close("]");
	}

	fun begin_variant(&mut self, name: str, arity: i32) {
		self.variant_arities.push(arity);
		if arity == 0 {
			// A payload-less variant is its bare name: `"Ready"`.
			self.value(name.to_json());
		} else {
			self.open("{");
			self.out = self.out + name.to_json() + ":";
			self.pending_comma = false;
			if arity > 1 {
				// Several payloads ride in an array: `{"Pair":[1,2]}`.
				self.out = self.out + "[";
			}
		}
	}

	fun end_variant(&mut self) {
		let arity = match self.variant_arities.pop() {
			Some(let opened) => opened,
			None => 0,
		};
		if arity > 1 {
			self.out = self.out + "]";
		}
		if arity > 0 {
			self.close("}");
		}
	}

	fun null_value(&mut self) {
		self.value("null");
	}

	/// JSON has no Some marker — a present Option is its bare value (which
	/// keeps the format's Some(None) ≡ None collapse).
	fun some_value(&mut self) {}

	fun str_value(&mut self, value: str) {
		self.value(value.to_json());
	}

	fun i32_value(&mut self, value: i32) {
		self.value(i"{value}");
	}

	fun u32_value(&mut self, value: u32) {
		self.value(i"{value}");
	}

	/// A JSON number; exact for the runtime's whole i53 range (integers to
	/// 2^53 — the f64 representation).
	fun i53_value(&mut self, value: i53) {
		self.value(i"{value}");
	}

	fun f64_value(&mut self, value: f64) {
		self.value(i"{value}");
	}

	fun bool_value(&mut self, value: bool) {
		self.value(i"{value}");
	}
}

/// The read side: walks a parsed `JsonValue` with a value stack. `field(name)`
/// pushes the named member (or fails and pushes a null sentinel); scalar reads
/// pop; `begin_list`/arity>0 variants replace their aggregate with its elements
/// (reversed, so pops come off in order). Errors are sticky: after `fail`, every
/// operation is a no-op returning a zero value, and `decode_json` reports the
/// first reason.
/// Plain fields behind `&mut self`, for the reason `JsonWriter`'s headnote
/// gives (A108).
struct JsonReader {
	stack: List<JsonValue>,
	error: Option<str>,
	/// The stack depth each open list must be back down to when it is closed
	/// (FIND papers-39). `begin_list` records one; `end_list` checks it, so a
	/// document whose list is LONGER than what the caller read is a decode
	/// failure rather than an element left lying on the stack for whatever
	/// reads next to take.
	list_marks: List<i32>,
}

impl JsonReader {
	fun new(root: JsonValue): JsonReader {
		mut stack: List<JsonValue> = [];
		stack.push(root);
		JsonReader { stack, error = None, list_marks = [] }
	}

	fun ok(&self): bool {
		match self.error {
			Some(let _reason) => false,
			None => true,
		}
	}

	fun report(&mut self, reason: str) {
		match self.error {
			Some(let _first) => {},
			None => {
				self.error = Some(reason);
			},
		}
	}

	/// The current value without consuming it (a null sentinel when poisoned
	/// or unbalanced — reads stay crash-free either way).
	fun top(&self): JsonValue {
		if !self.ok() || self.stack.is_empty() {
			parse_json_value("null")
		} else {
			self.stack[self.stack.len() - 1]
		}
	}

	fun take(&mut self): JsonValue {
		if !self.ok() {
			ret parse_json_value("null");
		}
		match self.stack.pop() {
			Some(let value) => value,
			None => {
				// A balanced rebuild never underflows — reading past the
				// document is a structural mismatch, not a zero value.
				self.report("unexpected end of document");
				parse_json_value("null")
			},
		}
	}

	/// THE TYPE GATE (FIND papers-39): the value a read just took has to be of
	/// the kind that read asked for, or the read is a decode FAILURE rather
	/// than a host coercion. `false` means "poisoned — hand back the zero
	/// value", which is the shape the sticky-error model already had for a
	/// structural mismatch.
	///
	/// Without it every typed read was `Number(x)` / `String(x)` / `Boolean(x)`
	/// over whatever happened to be on the stack, and the answers were the
	/// coercions': a JSON string read as an `i32` answered `NaN`, `null`
	/// answered `0`, `true` answered `1`, and a list SHORTER than what the
	/// caller read answered the ENCLOSING OBJECT as a number. Every one of them
	/// silently, with `failed()` still answering `None` — so the gates written
	/// on it (the `[rpc]` route's `decode_failed`, which does consult it) all
	/// passed and a malformed frame routed as a well-formed call.
	fun expect(&mut self, value: JsonValue, wanted: JsonKind, name: str): bool {
		if !self.ok() {
			ret false;
		}
		if value.kind() == wanted {
			ret true;
		}
		self.report(i"expected {name}, found {found_kind(value)}");
		false
	}

	/// The integer lanes want a WHOLE number, and the unsigned ones a
	/// non-negative one: `1.5` read as an `i32` used to answer `1.5` TYPED
	/// `i32`, and `-1` read as a `u32` answered `-1` typed `u32` — values
	/// outside their own types, which is the same defect as the wrong kind
	/// wearing the right one.
	///
	/// The MAGNITUDE is deliberately not checked here: `i32`/`u32` are the JS
	/// numeric lanes rather than hardware widths, and refusing a large value
	/// would be a behaviour change to documents that already cross. That is its
	/// own question, with its own estate sweep.
	fun expect_integer(&mut self, value: JsonValue, signed: bool): bool {
		if !self.expect(value, JsonKind::Number, "a number") {
			ret false;
		}
		let number = coerce_f64(value);
		if number != number.floor() {
			self.report(i"expected a whole number, found {number}");
			ret false;
		}
		if !signed && number < 0.0 {
			self.report(i"expected a non-negative number, found {number}");
			ret false;
		}
		true
	}
}

/// How a decode failure NAMES the kind it found, with its article, so the two
/// halves of "expected a number, found a string" read as one sentence.
fun found_kind(value: JsonValue): str {
	match value.kind() {
		JsonKind::Null => "null",
		JsonKind::Bool => "a boolean",
		JsonKind::Number => "a number",
		JsonKind::String => "a string",
		JsonKind::Array => "an array",
		// `__json_kind` answers exactly these six, so the last one is the
		// FALLBACK rather than a sixth named arm: an exhaustive match over a
		// BACKED enum emits the `__enum_trap` helper, and that would put a
		// guard against a host value outside the set into every bundle that
		// decodes JSON, for a value this intrinsic cannot produce.
		_ => "an object",
	}
}

// The visitor's read half, natively.
// EXPORTED deliberately, and B354 is the reason: a `[derive(Wire)]` visitor is
// generated code, and its admitting file is the file the ATTRIBUTE was written
// in - a USER's file, which cannot reach a private std block and cannot be asked
// to write `#(impl JsonReader)` for one. The Order 36 sweep exported these under
// the sentinel rule; they stay exported under the right one. The plain blocks
// above/below need no export: a derived body only ever calls the VISITOR methods.
export impl JsonReader with Deserialize {
	fun begin_struct(&mut self) {}

	fun field(&mut self, name: str) {
		let subject = self.top();
		// The kind check comes FIRST and is not only a type gate: `has_json_field`
		// is `Object.hasOwn`, which THROWS on `null` — so a `null` document
		// reaching a struct decode took the process rather than reporting.
		if self.expect(subject, JsonKind::Object, "an object") {
			if has_json_field(subject, name) {
				self.stack.push(subject.field(name));
			} else {
				self.report(i"missing field '{name}'");
			}
		}
	}

	fun end_struct(&mut self) {
		let _ = self.take();
	}

	fun begin_list(&mut self): i32 {
		let subject = self.take();
		if self.expect(subject, JsonKind::Array, "an array") {
			let elements = subject.elements();
			// Where the stack stands once every element has been read: what
			// `end_list` holds the caller to.
			self.list_marks.push(self.stack.len());
			mut index = elements.len() - 1;
			for index >= 0 {
				self.stack.push(elements[index]);
				index -= 1;
			}
			elements.len()
		} else {
			0
		}
	}

	/// The arity check (FIND papers-39). A list LONGER than what the caller
	/// read used to leave its tail on the stack, where the next read took an
	/// element of it instead of the value it asked for; a shorter one is caught
	/// by the type gate above, since the read runs into the enclosing value.
	/// Either way the answer is a decode failure and not a number.
	///
	/// A reader whose caller never closes its list — `std::rpc`'s
	/// `open_request` opens the argument list and leaves it open for the route
	/// to pull from — simply never reaches this, and its mark is never read.
	fun end_list(&mut self) {
		match self.list_marks.pop() {
			Some(let mark) => {
				if self.ok() && self.stack.len() > mark {
					let unread = self.stack.len() - mark;
					self.report(i"a list had {unread} element(s) left unread");
				}
			},
			None => {},
		}
	}

	fun variant_tag(&mut self): str {
		if self.ok() {
			self.top().tag()
		} else {
			""
		}
	}

	fun begin_variant(&mut self, name: str, arity: i32) {
		let subject = self.take();
		if arity > 0 && self.expect(subject, JsonKind::Object, "an object") {
			if has_json_field(subject, name) {
				let payload = subject.field(name);
				if arity == 1 {
					self.stack.push(payload);
				} else {
					let elements = payload.elements();
					mut index = elements.len() - 1;
					for index >= 0 {
						self.stack.push(elements[index]);
						index -= 1;
					}
				}
			} else {
				self.report(i"missing payload for variant '{name}'");
			}
		}
	}

	fun end_variant(&mut self) {}

	fun is_null(&mut self): bool {
		self.ok() && self.top().is_null()
	}

	fun null_value(&mut self) {
		let _ = self.take();
	}

	/// The reader has its own sticky-error model (`ok()`/`fail()`), so it reads a
	/// scalar through the raw coercion rather than the validating `from_json_value`
	/// (which now returns a `Result`) — the leaf is already inside the reader's
	/// error discipline.
	fun str_value(&mut self): str {
		let value = self.take();
		if self.expect(value, JsonKind::String, "a string") {
			coerce_str(value)
		} else {
			""
		}
	}

	fun i32_value(&mut self): i32 {
		let value = self.take();
		if self.expect_integer(value, true) {
			coerce_i32(value)
		} else {
			0
		}
	}

	fun u32_value(&mut self): u32 {
		let value = self.take();
		if self.expect_integer(value, false) {
			coerce_u32(value)
		} else {
			0
		}
	}

	fun i53_value(&mut self): i53 {
		let value = self.take();
		if self.expect_integer(value, true) {
			coerce_i53(value)
		} else {
			0
		}
	}

	fun f64_value(&mut self): f64 {
		let value = self.take();
		if self.expect(value, JsonKind::Number, "a number") {
			coerce_f64(value)
		} else {
			0.0
		}
	}

	fun bool_value(&mut self): bool {
		let value = self.take();
		if self.expect(value, JsonKind::Bool, "a boolean") {
			coerce_bool(value)
		} else {
			false
		}
	}

	fun fail(&mut self, reason: str) {
		self.report(reason);
	}

	fun failed(&mut self): Option<str> {
		self.error
	}
}

/// Encode a `Wire` value as JSON text — the direct path: `describe`
/// monomorphizes straight onto `JsonWriter`, no record in between.
export fun encode_json<T: Wire>(value: T): str {
	mut writer = JsonWriter::new();
	value.describe(&mut writer);
	writer.result()
}

/// Decode JSON text as a `Wire` value: `Err(reason)` names the first structural
/// failure (missing field, missing variant payload) instead of half-decoding.
/// (Malformed JSON *syntax* still throws at `parse_json_value` — the guarded
/// parse is Q10/`?` territory.)
export fun decode_json<T: Wire>(text: str): Result<T, str> {
	mut reader = opened_reader(text);
	let value: T = T::rebuild(&mut reader);
	match reader.error {
		None => Ok(value),
		Some(let reason) => Err(reason),
	}
}

/// A reader over `text` — pre-poisoned when the text is not JSON at all: the
/// codec contract is a sticky decode error, NEVER a crash (a wire frame is
/// untrusted input; a throwing parse here would let one malformed request kill
/// a server).
fun opened_reader(text: str): JsonReader {
	match text.try_parse_json() {
		Some(let root) => JsonReader::new(root),
		None => {
			mut reader = JsonReader::new(parse_json_value("null"));
			reader.report("malformed JSON");
			reader
		},
	}
}

/// The JSON codec (§6.2): text frames over the writer/reader pair. A binary
/// frame poisons the reader — a sticky decode error, never a crash.
///
/// The closure records are built HERE rather than by a `serializer()` method on
/// the writer, and A108 is why: the visitor's state lives in plain fields now,
/// so a record whose closures captured a by-value copy of the writer would
/// narrate into a copy and finish an empty document, and a record whose
/// closures captured a `&mut self` view is refused outright (a view may not
/// escape its scope). What both closures may capture is the `mut` LOCAL of the
/// frame that mints them — a closure captures the BINDING (spec §6.9) — so the
/// writer and the finisher share one writer, which is exactly the relation the
/// `Shared` cells used to buy.
export fun json_codec(): Codec {
	Codec {
		writer = || {
			mut writer = JsonWriter::new();
			let record = Serializer {
				begin_struct = |fields| writer.begin_struct(fields),
				field = |name| writer.field(name),
				end_struct = || writer.end_struct(),
				begin_list = |length| writer.begin_list(length),
				end_list = || writer.end_list(),
				begin_variant = |name, arity| writer.begin_variant(name, arity),
				end_variant = || writer.end_variant(),
				null_value = || writer.null_value(),
				some_value = || writer.some_value(),
				str_value = |value| writer.str_value(value),
				i32_value = |value| writer.i32_value(value),
				u32_value = |value| writer.u32_value(value),
				i53_value = |value| writer.i53_value(value),
				f64_value = |value| writer.f64_value(value),
				bool_value = |value| writer.bool_value(value),
			};
			(record, || Frame::Text(writer.result()))
		},
		reader = |frame| {
			// Liberal in what it accepts: a binary frame is read as UTF-8 JSON
			// (server mounts read request bodies as bytes without sniffing).
			mut reader = match frame {
				Frame::Text(let text) => opened_reader(text),
				Frame::Binary(let bytes) => opened_reader(decode_utf8(bytes)),
			};
			Deserializer {
				begin_struct = || reader.begin_struct(),
				field = |name| reader.field(name),
				end_struct = || reader.end_struct(),
				begin_list = || reader.begin_list(),
				end_list = || reader.end_list(),
				variant_tag = || reader.variant_tag(),
				begin_variant = |name, arity| reader.begin_variant(name, arity),
				end_variant = || reader.end_variant(),
				is_null = || reader.is_null(),
				null_value = || reader.null_value(),
				str_value = || reader.str_value(),
				i32_value = || reader.i32_value(),
				u32_value = || reader.u32_value(),
				i53_value = || reader.i53_value(),
				f64_value = || reader.f64_value(),
				bool_value = || reader.bool_value(),
				fail = |reason| reader.fail(reason),
				failed = || reader.failed(),
			}
		},
	}
}

// The `Json` and `Wire` derives (macro-engine.md §10): prelude macros —
// this module is always loaded. `Wire` lives here rather than in `wire.vl`
// because the two share the JSON text builders below, and macro-fun
// helpers are file-scoped (each file compiles as its own hermetic world);
// the `Wire` TRAIT stays in `wire.vl`. Outputs carry their own imports.

export macro fun struct_json_impls(target: StructItem): str {
	import macro_std::build::{ impl_of, fun_of, init_of, quote, join };

	// `"{" + "\"a\":" + self.a.to_json() + "," + … + "}"`.
	mut parts: List<str> = [];
	parts.push(quote("{"));
	mut first = true;
	for field in target.fields {
		if first {
			first = false;
		} else {
			parts.push(quote(","));
		}
		parts.push(quote(i"\"{field.name}\":"));
		parts.push(i"self.{field.name}.to_json()");
	}
	parts.push(quote("}"));
	let to_json = fun_of("to_json").parameter("self").returns("str").expr(join(parts, " + "));
	// Decoding is fallible (I3): `from_json` parses the text without crashing,
	// `from_json_value` checks each field is present (naming a missing one) and
	// threads a leaf failure with `!`.
	//
	// The subject is spelled as an APPLICATION of its own parameters
	// (`Handle<T>`) in every type role, and the impl binds them with the
	// derived trait (B194's rule). A path head (`Handle::from_json_value(..)`)
	// and a struct literal head name a namespace, not an application, so they
	// keep the bare name.
	let subject = target.subject();
	let result_type = i"Result<{subject}, str>";
	let from_json = fun_of("from_json")
		.parameter("text: str")
		.returns(result_type)
		.expr(i"{target.name}::from_json_value(text.try_parse_json().ok_or(\"not valid JSON\")!)");
	mut from_json_value = fun_of("from_json_value")
		.parameter("value: JsonValue")
		.returns(result_type);
	// The output uses fully-qualified `Result::Ok`/`Result::Err` so it does not
	// depend on the deriving file importing the variants (`Result` the type is
	// reachable wherever the derive is; its variants may not be in scope).
	for field in target.fields {
		let label = quote(field.name);
		from_json_value = from_json_value.line(i"if !value.has_field({label}) \{ ret Result::Err(\"missing field {field.name}\") \}");
	}
	mut literal = init_of(target.name);
	for field in target.fields {
		let label = quote(field.name);
		literal = literal.field(field.name, i"{field.type_.render()}::from_json_value(value.field({label}))!");
	}
	from_json_value = from_json_value.expr(i"Result::Ok({literal.render()})");
	impl_of(target.name)
		.generics(target.binders("Json"))
		.implements("Json")
		.method(to_json)
		.render()
		+ impl_of(target.name)
			.generics(target.binders("FromJson"))
			.implements("FromJson")
			.method(from_json)
			.method(from_json_value)
			.render()
}

export macro fun struct_wire_impls(target: StructItem): str {
	import macro_std::build::{ impl_of, fun_of, init_of, quote };

	mut describe = fun_of("describe")
		.generics("<S: Serialize>")
		.parameter("self")
		.parameter("serializer: &mut S")
		.line(i"serializer.begin_struct({target.fields.len()});");
	for field in target.fields {
		let label = quote(field.name);
		describe = describe.line(i"serializer.field({label});");
		describe = describe.line(i"self.{field.name}.describe(serializer);");
	}
	describe = describe.line("serializer.end_struct();");
	mut rebuild = fun_of("rebuild")
		.generics("<D: Deserialize>")
		.parameter("deserializer: &mut D")
		.returns(target.subject())
		.line("deserializer.begin_struct();");
	mut literal = init_of(target.name);
	for field in target.fields {
		let label = quote(field.name);
		rebuild = rebuild.line(i"deserializer.field({label});");
		rebuild = rebuild.line(i"let {field.name} = {field.type_.render()}::rebuild(deserializer);");
		literal = literal.field(field.name, field.name);
	}
	rebuild = rebuild.line("deserializer.end_struct();").expr(literal.render());
	impl_of(target.name)
		.generics(target.binders("Wire"))
		.implements("Wire")
		.method(describe)
		.method(rebuild)
		.render()
}

export macro fun enum_json_impls(target: EnumItem): str {
	import macro_std::option::Option::{ self, Some, None };
	import macro_std::build::{ impl_of, fun_of, match_of, quote, join };

	// The subject spelled as an APPLICATION of its own parameters
	// (`Either<L, R>`) in every type role, with the impl binding them under the
	// derived trait (B194's rule). Variant paths (`Either::Left`) and the
	// static `from_json_value` head name a namespace, not an application, and
	// keep the bare name.
	let subject = target.subject();
	// A BACKED enum encodes AS ITS BACKING VALUE (proposal/backed-enums.md
	// §3.9): `Align::Start` is `"start"` on the wire, not `"Start"`, and it
	// round-trips through the synthesized `parse`. Both directions delegate —
	// `value()` folds to the identity and the backing type's own `to_json`
	// already escapes correctly — so neither re-implements JSON quoting.
	if target.backing_type != "" {
		mut coerce = "coerce_i32";
		if target.backing_type == "str" {
			coerce = "coerce_str";
		} else if target.backing_type == "i53" {
			coerce = "coerce_i53";
		}
		let backed_result = i"Result<{subject}, str>";
		let backed_to_json = fun_of("to_json")
			.parameter("self")
			.returns("str")
			.expr("self.value().to_json()");
		let backed_from_json = fun_of("from_json")
			.parameter("text: str")
			.returns(backed_result)
			.expr(i"{target.name}::from_json_value(text.try_parse_json().ok_or(\"not valid JSON\")!)");
		let backed_from_json_value = fun_of("from_json_value")
			.parameter("value: JsonValue")
			.returns(backed_result)
			.expr(i"{target.name}::parse({coerce}(value)).ok_or(\"unknown value in JSON for enum {target.name}\")");
		ret impl_of(target.name)
			.generics(target.binders("Json"))
			.implements("Json")
			.method(backed_to_json)
			.render()
			+ impl_of(target.name)
				.generics(target.binders("FromJson"))
				.implements("FromJson")
				.method(backed_from_json)
				.method(backed_from_json_value)
				.render();
	}
	// Externally tagged: no payload -> `"V"`; one -> `{"V":<p>}`;
	// many -> `{"V":[<p0>,<p1>]}`.
	mut to_arms = match_of("self");
	for variant in target.variants {
		let arity = variant.payload.len();
		if arity == 0 {
			to_arms = to_arms.arm(i"{target.name}::{variant.name}", quote(i"\"{variant.name}\""));
		} else if arity == 1 {
			let opener = quote(i"\{\"{variant.name}\":");
			to_arms = to_arms.arm(i"{target.name}::{variant.name}(let p0)", opener
				+ " + p0.to_json() + "
				+ quote("}"));
		} else {
			mut binds: List<str> = [];
			mut parts: List<str> = [];
			mut index = 0;
			for index < arity {
				binds.push(i"let p{index}");
				parts.push(i"p{index}.to_json()");
				index = index + 1;
			}
			let bind_pattern = join(binds, ", ");
			let separator = " + " + quote(",") + " + ";
			let opener = quote(i"\{\"{variant.name}\":[");
			to_arms = to_arms.arm(i"{target.name}::{variant.name}({bind_pattern})", opener
				+ " + "
				+ join(parts, separator)
				+ " + "
				+ quote("]}"));
		}
	}
	// Decoding validates the tag (an unknown one is a decode error, not a panic)
	// and threads each payload leaf's failure with `!` (I3).
	mut from_arms = match_of("value.tag()");
	for variant in target.variants {
		let arity = variant.payload.len();
		let tag = quote(variant.name);
		if arity == 0 {
			from_arms = from_arms.arm(tag, i"Result::Ok({target.name}::{variant.name})");
		} else if arity == 1 {
			let payload_type = match variant.payload.get(0) {
				Some(let type_) => type_.render(),
				None => "_",
			};
			from_arms = from_arms.arm(tag, i"Result::Ok({target.name}::{variant.name}({payload_type}::from_json_value(value.field({tag}))!))");
		} else {
			mut elements: List<str> = [];
			mut index = 0;
			for type_ in variant.payload {
				let position = quote(i"{index}");
				elements.push(i"{type_.render()}::from_json_value(value.field({tag}).field({position}))!");
				index = index + 1;
			}
			let element_list = join(elements, ", ");
			from_arms = from_arms.arm(tag, i"Result::Ok({target.name}::{variant.name}({element_list}))");
		}
	}
	from_arms = from_arms.arm("_", i"Result::Err(\"unknown variant in JSON for enum {target.name}\")");
	let result_type = i"Result<{subject}, str>";
	let to_json = fun_of("to_json").parameter("self").returns("str").expr(to_arms.render());
	let from_json = fun_of("from_json")
		.parameter("text: str")
		.returns(result_type)
		.expr(i"{target.name}::from_json_value(text.try_parse_json().ok_or(\"not valid JSON\")!)");
	let from_json_value = fun_of("from_json_value")
		.parameter("value: JsonValue")
		.returns(result_type)
		.expr(from_arms.render());
	impl_of(target.name)
		.generics(target.binders("Json"))
		.implements("Json")
		.method(to_json)
		.render()
		+ impl_of(target.name)
			.generics(target.binders("FromJson"))
			.implements("FromJson")
			.method(from_json)
			.method(from_json_value)
			.render()
}

export macro fun enum_wire_impls(target: EnumItem): str {
	import macro_std::option::Option::{ self, Some, None };
	import macro_std::build::{ impl_of, fun_of, match_of, quote, join };

	// An empty enum gets no impls (nothing to construct).
	if target.variants.len() == 0 {
		ret "";
	}
	// The subject as an application of its own parameters (B194), the impl
	// binding them under `Wire`.
	let subject = target.subject();
	// §3.9's backed form: the backing value is what crosses, so both directions
	// delegate to the backing type's own `Wire` impl and to `parse`. The
	// unknown-value path is the tagged form's, kept: a host sending a value
	// outside the set decodes to a reported failure plus a poisoned
	// zero-construction of the first variant, never to garbage.
	if target.backing_type != "" {
		mut first_variant = "";
		for variant in target.variants {
			if first_variant == "" {
				first_variant = variant.name;
			}
		}
		mut rebuild_body: List<str> = [];
		rebuild_body.push(i"let raw = {target.backing_type}::rebuild(deserializer);");
		rebuild_body.push(i"match {target.name}::parse(raw) \{");
		rebuild_body.push(i"\tOption::Some(let variant) => variant,");
		rebuild_body.push("\tOption::None => {");
		rebuild_body.push(i"\t\tdeserializer.fail(\"unknown value for enum {target.name}\");");
		rebuild_body.push(i"\t\t{target.name}::{first_variant}");
		rebuild_body.push("\t},");
		rebuild_body.push("}");
		let backed_describe = fun_of("describe")
			.generics("<S: Serialize>")
			.parameter("self")
			.parameter("serializer: &mut S")
			.expr("self.value().describe(serializer)");
		mut backed_rebuild = fun_of("rebuild")
			.generics("<D: Deserialize>")
			.parameter("deserializer: &mut D")
			.returns(subject);
		for line in rebuild_body {
			backed_rebuild = backed_rebuild.line(line);
		}
		ret impl_of(target.name)
			.generics(target.binders("Wire"))
			.implements("Wire")
			.method(backed_describe)
			.method(backed_rebuild)
			.render();
	}
	mut describe_arms = match_of("self");
	for variant in target.variants {
		let arity = variant.payload.len();
		let tag = quote(variant.name);
		mut statements: List<str> = [];
		statements.push(i"serializer.begin_variant({tag}, {arity});");
		mut binds: List<str> = [];
		mut index = 0;
		for index < arity {
			binds.push(i"let p{index}");
			statements.push(i"p{index}.describe(serializer);");
			index = index + 1;
		}
		statements.push("serializer.end_variant();");
		if arity == 0 {
			describe_arms = describe_arms.arm_block(i"{target.name}::{variant.name}", statements);
		} else {
			let bind_pattern = join(binds, ", ");
			describe_arms = describe_arms.arm_block(i"{target.name}::{variant.name}({bind_pattern})", statements);
		}
	}
	mut rebuild_arms = match_of("tag");
	for variant in target.variants {
		let arity = variant.payload.len();
		let tag = quote(variant.name);
		mut statements: List<str> = [];
		statements.push(i"deserializer.begin_variant({tag}, {arity});");
		mut arguments: List<str> = [];
		mut index = 0;
		for type_ in variant.payload {
			statements.push(i"let p{index} = {type_.render()}::rebuild(deserializer);");
			arguments.push(i"p{index}");
			index = index + 1;
		}
		statements.push("deserializer.end_variant();");
		mut construct = i"{target.name}::{variant.name}";
		if arity > 0 {
			let argument_list = join(arguments, ", ");
			construct = construct + i"({argument_list})";
		}
		statements.push(construct);
		rebuild_arms = rebuild_arms.arm_block(tag, statements);
	}
	// The unknown-tag arm reports a sticky decode failure and zero-constructs
	// the FIRST variant through the (now poisoned) deserializer.
	mut fallback: List<str> = [];
	fallback.push(i"deserializer.fail(i\"unknown variant '\{tag\}'\");");
	mut first = true;
	for variant in target.variants {
		if first {
			first = false;
			let arity = variant.payload.len();
			mut arguments: List<str> = [];
			mut index = 0;
			for type_ in variant.payload {
				fallback.push(i"let f{index} = {type_.render()}::rebuild(deserializer);");
				arguments.push(i"f{index}");
				index = index + 1;
			}
			if arity == 0 {
				fallback.push(i"{target.name}::{variant.name}");
			} else {
				let argument_list = join(arguments, ", ");
				fallback.push(i"{target.name}::{variant.name}({argument_list})");
			}
		}
	}
	rebuild_arms = rebuild_arms.arm_block("_", fallback);
	let describe = fun_of("describe")
		.generics("<S: Serialize>")
		.parameter("self")
		.parameter("serializer: &mut S")
		.expr(describe_arms.render());
	let rebuild = fun_of("rebuild")
		.generics("<D: Deserialize>")
		.parameter("deserializer: &mut D")
		.returns(subject)
		.line("let tag = deserializer.variant_tag();")
		.expr(rebuild_arms.render());
	impl_of(target.name)
		.generics(target.binders("Wire"))
		.implements("Wire")
		.method(describe)
		.method(rebuild)
		.render()
}

export macro fun Json(item: Item): Source {
	import macro_std::option::Option::{ self, Some, None };

	if item.as_struct() is Some(let target) {
		ret source("import std::json::{ Json, FromJson, JsonValue };\n"
			+ "import std::result::Result;\n"
			+ struct_json_impls(target));
	}
	if item.as_enum() is Some(let target) {
		ret source("import std::json::{ Json, FromJson, JsonValue, coerce_i32, coerce_i53, coerce_str };\n"
			+ "import std::result::Result;\n"
			+ "import std::option::Option;\n"
			+ enum_json_impls(target));
	}
	source("")
}

// `[derive(Wire)]` emits the §6.1 VISITOR impls and nothing else (B301).
//
// It used to emit the JSON pair beside them — "additive until the codec
// re-plumb consumes it" — and the residue was not additive at all: it made
// every field of a Wire type have to be JSON as well, at a time when `Map` had
// been Wire since A39 and `Result` since A82 and neither is Json. `[derive(Wire)]
// struct Row { tags: Map<str, i32> }` failed with "`Map<str, i32>` has no method
// 'to_json'" and "cannot find 'from_json_value' in Map<str, i32>" — two
// diagnostics about a codec the author did not ask for, naming a trait the
// attribute does not mention. A hand-written `impl .. with Wire` type and a
// `Result` field met the identical wall.
//
// A type that wants both codecs asks for both: `[derive(Json, Wire)]`.
export macro fun Wire(item: Item): Source {
	import macro_std::option::Option::{ self, Some, None };

	if item.as_struct() is Some(let target) {
		ret source("import std::wire::{ Wire, Serialize, Deserialize, Serializer, Deserializer };\n" + struct_wire_impls(target));
	}
	if item.as_enum() is Some(let target) {
		ret source("import std::option::Option;\n"
			+ "import std::wire::{ Wire, Serialize, Deserialize, Serializer, Deserializer };\n"
			+ enum_wire_impls(target));
	}
	source("")
}

// --- [service] (transport-rpc.md §4.2) ---

// --- The sized numeric family (proposal/numeric-types.md §5) ---
// Scalar Json/FromJson over the host JSON functions, exactly the i32 shape:
// every sized value is a plain JS number, so it serializes as one.

export impl i8 with Json {
	[extern("JSON.stringify")]
	external fun to_json(self): str;
}

export impl i8 with FromJson {
	fun from_json(text: str): Result<i8, str> {
		match text.try_parse_json() {
			Some(let value) => i8::from_json_value(value),
			None => Err("not valid JSON"),
		}
	}
	fun from_json_value(value: JsonValue): Result<i8, str> {
		if value.kind() == JsonKind::Number {
			Ok(coerce_i8(value))
		} else {
			Err("expected a number")
		}
	}
}

