import pkg::compare::PartialEq;
import pkg::default::Default;
import pkg::io::panic;
import pkg::operators::{ Lift, Try, Verdict };
import pkg::result::Result::{ Err, Ok, self };

enum Option<T> {
	Some(T),
	None,
}

use Option::{ None, Some };

// `!` on an `Option`: `Some` is good; `None` is bad, its residual `void` (the
// unit — the absence carries no information), rebuilt as `None` at the
// enclosing function's element type (proposal/try-and-lift.md).
impl Option<type T> with Try<T, void> {
	fun verdict(self): Verdict<T, void> {
		match self {
			Some(let value) => Verdict::Good(value),
			None => Verdict::Bad(void),
		}
	}

	fun from_bad(bad: void): Option<T> {
		None
	}
}

// `?.` on an `Option` maps `Some` (or flattens an `Option`-yielding chain);
// `None` short-circuits.
impl Option<type T> with Lift {}

impl Option<type T> {
	/// Take the value out, leaving `None` behind: `Some(v)` becomes `None` and
	/// yields `Some(v)`; `None` yields `None` (and stays `None`). This is the one
	/// sanctioned partial move for a resource field — `self.slot.take()` moves a
	/// resource out of a live aggregate (destruction.md §5/§6) — and the core of
	/// the conditional-teardown idiom `match opt.take() { Some(let c) => drop(c),
	/// None => {} }`. Useful for data too.
	external fun take(&mut self): Option<T>;

	/// Put `value` in and return the old contents: the slot becomes `Some(value)`
	/// and yields whatever was there before (`Some(old)` or `None`). The caller
	/// then owns the old value.
	external fun replace(&mut self, value: T): Option<T>;

	fun is_some(self): bool {
		self is Some(_)
	}

	fun is_some_and(own self, fn: |T| bool): bool {
		match self {
			Some(let x) => fn(x),
			_ => false,
		}
	}

	fun is_none(self): bool {
		self is None
	}

	fun is_none_or(own self, fn: |T| bool): bool {
		match self {
			Some(let x) => fn(x),
			_ => true,
		}
	}

	fun unwrap(own self): T {
		match self {
			Some(let x) => x,
			_ => panic("expected Some but got None"),
		}
	}

	/// `fallback` is a LOAN (R3), so at a resource instantiation this rejects:
	/// `Some(v).unwrap_or(f)` has to destroy `f`, and a generic body cannot
	/// destroy a `T`. `unwrap_or_else` is the resource-clean spelling — it
	/// PRODUCES the fallback on the `None` path instead of discarding it.
	fun unwrap_or(own self, fallback: T): T {
		match self {
			Some(let x) => x,
			_ => fallback,
		}
	}

	fun unwrap_or_else(own self, fn: || T): T {
		match self {
			Some(let x) => x,
			_ => fn(),
		}
	}

	fun map<U>(own self, fn: |T| U): Option<U> {
		match self {
			Some(let x) => Some(fn(x)),
			None => None,
		}
	}

	fun map_or<U>(own self, fn: |T| U, fallback: U): U {
		match self {
			Some(let x) => fn(x),
			_ => fallback,
		}
	}

	fun map_or_else<U>(own self, fn: |T| U, fallback: || U): U {
		match self {
			Some(let x) => fn(x),
			_ => fallback(),
		}
	}

	fun map_or_default<U: Default>(own self, fn: |T| U): U {
		match self {
			Some(let x) => fn(x),
			_ => U::default(),
		}
	}

	/// Tested with `is`, not matched: `is` LOANS the subject, so `self` is read
	/// once here and handed straight back. A by-value `match` would consume it
	/// (R6) and the trailing `self` would be a second read of a consumed value,
	/// which is why this is the shape that works at a resource.
	fun inspect(own self, fn: |T| void): Self {
		if self is Some(let x) {
			fn(x)
		}
		self
	}

	fun ok_or<E>(own self, err: E): Result<T, E> {
		match self {
			Some(let x) => Ok(x),
			_ => Err(err),
		}
	}

	fun ok_or_else<E>(own self, err: || E): Result<T, E> {
		match self {
			Some(let x) => Ok(x),
			_ => Err(err()),
		}
	}

	fun and<U>(own self, own b: Option<U>): Option<U> {
		match self {
			Some(_) => b,
			_ => None,
		}
	}

	fun and_then<U>(own self, fn: |T| Option<U>): Option<U> {
		match self {
			Some(let x) => fn(x),
			_ => None,
		}
	}

	fun filter(own self, predicate: |T| bool): Option<T> {
		self.and_then(|x| predicate(x).then_some(x))
	}

	/// `b` is a LOAN (R3), so at a resource instantiation this rejects:
	/// `Some(a).or(Some(b))` has to destroy `b`, and a generic body cannot
	/// destroy a `T`. Declaring `own b` would NOT fix it — it would leak the
	/// discarded value silently (`affine-moves.md` §6).
	fun or(own self, b: Option<T>): Option<T> {
		if self is Some(_) {
			self
		} else {
			b
		}
	}

	/// Resource-clean, unlike `or`: the fallback is PRODUCED on the `None`
	/// path, never discarded, and a `self` that reaches that path is `None` —
	/// it carries no payload to destroy.
	fun or_else(own self, fn: || Option<T>): Option<T> {
		if self is Some(_) {
			self
		} else {
			fn()
		}
	}

	/// Rejects at a resource instantiation, correctly: `Some(a).xor(Some(b))`
	/// is `None`, which destroys BOTH payloads, and a generic body cannot
	/// destroy a `T`.
	fun xor(own self, own b: Option<T>): Option<T> {
		if self is Some(_) {
			if b is Some(_) {
				None
			} else {
				self
			}
		} else {
			b
		}
	}

	fun zip<U>(own self, own peer: Option<U>): Option<(T, U)> {
		match (self, peer) {
			(Some(let x), Some(let y)) => Some((x, y)),
			_ => None,
		}
	}
}

impl Option<type T: Default> {
	fun unwrap_or_default(own self): T {
		match self {
			Some(let x) => x,
			_ => T::default(),
		}
	}
}

impl Option<(type T, type U)> {
	fun unzip(own self): (Option<T>, Option<U>) {
		match self {
			Some((let x, let y)) => (Some(x), Some(y)),
			_ => (None, None),
		}
	}
}

impl Option<Result<type T, type E>> {
	fun transpose(own self): Result<Option<T>, E> {
		match self {
			Some(Ok(let x)) => Ok(Some(x)),
			Some(Err(let x)) => Err(x),
			_ => Ok(None),
		}
	}
}

impl Option<Option<type T>> {
	fun flatten(own self): Option<T> {
		match self {
			Some(let x) => x,
			_ => None,
		}
	}
}

impl Option<type T> with Default {
	fun default(): Option<T> {
		None
	}
}

impl Option<type T: PartialEq> with PartialEq {
	/// Both sides stay LOANS and each is read once per path — `is` tests and
	/// captures loan, where the old `match (self, b)` built a tuple of the two,
	/// a store that copies (R1 forbids it for a resource). Comparing two
	/// `Option<resource>`s is therefore accepted, and consumes neither.
	fun eq(self, b: Option<T>): bool {
		if self is Some(let x) {
			if b is Some(let y) {
				x == y
			} else {
				false
			}
		} else {
			b is None
		}
	}
}

// `then_some` lives here rather than in `boolean.vl` so that the always-loaded
// core `bool` module stays dependency-free (it would otherwise have to import
// `Option`). An `impl` block does not need to share a module with the type it
// extends.
impl bool {
	fun then_some<T>(self, own value: T): Option<T> {
		if self {
			Some(value)
		} else {
			None
		}
	}
}

// `parse_i32` lives here (not in the always-loaded `string.vl`) because its
// result is an `Option`, which the core `str` module must not depend on. An
// `impl` block does not need to share a module with the type it extends.
impl str {
	/// STRICT: the whole (whitespace-trimmed) text must be a decimal integer in
	/// i32 range — `"1.5"`, `"12x"`, `""`, and out-of-range values are `None`,
	/// never a truncation.
	external fun parse_i32(self): Option<i32>;

	/// STRICT on shape (`"3.14x"` is `None`, unlike a liberal parseFloat), but
	/// any full numeric text the host accepts — including `"1e3"` and
	/// `"Infinity"` — parses.
	external fun parse_f64(self): Option<f64>;
}

// `List`'s `Option`-returning methods live here (not `list.vl`) so the
// always-loaded core stays off the `option`/`result` chain — same reason as
// `then_some`/`parse_i32` above. `get` returns a copy of the element.
impl List<type T> {
	external fun get(self, index: i32): Option<T>;

	fun first(self): Option<T> {
		self.get(0)
	}

	/// `get(len - 1)`: for an empty list `len - 1` is `-1`, which `get` reports as
	/// `None`.
	fun last(self): Option<T> {
		self.get(self.len() - 1)
	}

	/// The first element for which `predicate` holds — `None` when none does.
	/// SHORT-CIRCUITS: the predicate is not called past the match.
	fun find(self, predicate: |T| bool): Option<T> {
		for item in self {
			if predicate(item) {
				ret Some(item);
			}
		}
		None
	}
}
