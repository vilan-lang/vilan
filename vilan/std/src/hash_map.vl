// `std::hash_map` — `HashMap<K, V>`, the built-in hash map (tracker I9: the name
// says how it keys — by `Hashable` value — and leaves room for a sorted map
// beside it). It iterates in INSERTION order, on both backends: `keys()`,
// `values()` and `entries()` walk the keys in the order they first arrived, an
// overwrite keeps its key's place, and a key removed and inserted again goes to
// the end. Keys are compared **by value** — a
// scalar or a backed enum keys directly (the enum IS its backing value), and a
// struct or unbacked/payload enum keys once it derives `Hashable` (I1). Each key
// is turned into a canonical `Hash` via `key.hash()`, which keys the two
// underlying native maps: `keys` holds the original key, so `keys()` returns
// real `K`s and mutating the original afterward can't desync the map (value
// semantics snapshot it on insert), and `values` holds the value, so a value is
// a slot of its own that `peek` and `modify` reach IN PLACE (B689,
// proposal/hash-map-lend.md §2). Every write touches both tables inside one
// method, which is what keeps them in step.
import pkg::compare::{ Eq, PartialEq };
import pkg::debug::Debug;
import pkg::default::Default;
import pkg::hash::{ Hash, Hashable };
import pkg::js::native_map::NativeMap;
import pkg::option::Option::{ self, None, Some };

export *;

struct HashMap<K: Hashable, V> {
	keys: NativeMap<K>,
	values: NativeMap<V>,
}

impl HashMap<type K: Hashable, type V> {
	fun new(): HashMap<K, V> {
		let keys: NativeMap<K> = NativeMap::new();
		let values: NativeMap<V> = NativeMap::new();
		HashMap { keys, values }
	}

	fun insert(&mut self, key: K, value: V) {
		let hash = key.hash();
		self.keys.insert(hash, key);
		self.values.insert(hash, value);
	}

	/// A copy of the value stored under `key`, or `None` if absent — ONE copy, of
	/// the value alone (the table's own `get`; B689).
	fun get(self, key: K): Option<V> {
		self.values.get(key.hash())
	}

	/// Read the slot under `key` in place: `&Some(value)` while the key is held,
	/// `&None` otherwise. Copies nothing; what `read` copies out is its own.
	fun peek<U>(self, key: K, read: |&Option<V>| U): U {
		self.values.lend(key.hash(), read)
	}

	/// Write the slot under `key` in place. Leave it `None` and the key is gone;
	/// make it `Some` under an absent key and the key is inserted (last); a
	/// present key keeps its place whatever is written.
	fun modify<U>(&mut self, key: K, write: |&mut Option<V>| U): U {
		let hash = key.hash();
		let answer = self.values.lend_mut(hash, write);
		if self.values.contains_key(hash) {
			if !self.keys.contains_key(hash) {
				self.keys.insert(hash, key);
			}
		} else {
			self.keys.remove(hash);
		}
		answer
	}

	/// Change the value under `key` where it is — the one `missing` makes,
	/// inserted first, when there is none (M182's grouping idiom:
	/// `groups.update(key, [], |list| list.push(row))`, O(1) per push). `missing`
	/// is evaluated only on a miss; `change` runs on the freshly made value too.
	fun update(&mut self, key: K, lazy missing: V, change: |&mut V| void) {
		self.modify(key, |slot: &mut Option<V>| {
			match &mut slot {
				Some(let value) => change(value),
				None => {
					mut made = missing;
					change(&mut made);
					slot = Some(made);
				},
			}
		});
	}

	/// The value stored under `key` — or, when there is none, the one `make`
	/// builds, INSERTED and then answered (tracker I8: the map's entry idiom, as
	/// Rust's `entry(key).or_insert_with(make)`; the name says the write, as
	/// `Shared<Option<T>>::get_or_insert` and `Memo::get_or_insert` do).
	///
	/// `make` runs only on a miss, and exactly once there, so a maker that costs
	/// something is paid for once per key. It runs at the call site, so a maker
	/// that reads a context reads the caller's. The key is hashed once.
	fun get_or_insert(&mut self, key: K, make: || V): V {
		let hash = key.hash();
		match self.values.get(hash) {
			Some(let held) => held,
			None => {
				let made = make();
				self.keys.insert(hash, key);
				self.values.insert(hash, made);
				made
			},
		}
	}

	fun contains_key(self, key: K): bool {
		self.values.contains_key(key.hash())
	}

	fun remove(&mut self, key: K) {
		let hash = key.hash();
		self.keys.remove(hash);
		self.values.remove(hash);
	}

	fun len(self): usize {
		self.values.len()
	}

	fun is_empty(self): bool {
		self.len() == 0
	}

	/// `List` snapshots of the keys / values, in insertion order — iterate with
	/// `for key in map.keys()`.
	fun keys(self): List<K> {
		self.keys.values()
	}

	fun values(self): List<V> {
		self.values.values()
	}

	/// A `List` snapshot of `(key, value)` pairs, in insertion order — the paired
	/// counterpart to `keys()`/`values()`, for walking both together without
	/// zipping two separate snapshots by hand:
	/// `for entry in map.entries() { entry.0; entry.1 }`. The two tables share one
	/// insertion order, so a walk of the hashes reads each pair off both.
	fun entries(self): List<(K, V)> {
		mut result: List<(K, V)> = [];
		for hash in self.values.keys() {
			match self.keys.get(hash) {
				Some(let key) => match self.values.get(hash) {
					Some(let value) => result.push((key, value)),
					None => {},
				},
				None => {},
			}
		}
		result
	}
}

/// Split into its own bound impl block for the reason `compare.vl`'s `List`
/// methods are (std-surface.md §1.1): `contains_value` needs `V: PartialEq`,
/// a bound the unbounded `HashMap<type K: Hashable, type V>` block above cannot
/// carry.
impl HashMap<type K: Hashable, type V: PartialEq> {
	/// Whether any stored value equals `value`. For a KEY, use `contains_key`.
	fun contains_value(self, value: V): bool {
		for held in self.values.values() {
			if held.eq(value) {
				ret true;
			}
		}
		false
	}
}

/// Two maps are equal when they hold the same keys with equal values under each
/// (the owner's Q8 ruling, reactive-maps-sets.md): ORDER-INSENSITIVE. Insertion
/// order is what iteration presents, not part of the value, so a map built in
/// another order is the same map. It is what lets a struct holding a map derive
/// `PartialEq`, and a map of maps be compared at all.
///
/// Equal lengths, then every key of `self` found in `other` with an equal value:
/// that is both inclusions, since two key sets of one size with one inside the
/// other are the same set. Keys compare by their canonical `Hash` — the identity
/// the map itself keys by — so no key is hashed again.
impl HashMap<type K: Hashable, type V: PartialEq> with PartialEq {
	fun eq(self, other: HashMap<K, V>): bool {
		if self.values.len() != other.values.len() {
			ret false;
		}
		for hash in self.values.keys() {
			match self.values.get(hash) {
				Some(let mine) => match other.values.get(hash) {
					Some(let theirs) => {
						if !mine.eq(theirs) {
							ret false;
						}
					},
					None => ret false,
				},
				None => ret false,
			}
		}
		true
	}
}

/// A map of `Eq` keys and values is `Eq` (B621): its `eq` is the `PartialEq`
/// impl above, keys by their canonical `Hash`.
impl HashMap<type K: Hashable + Eq, type V: Eq> with Eq {}

/// The map half of the explicit termination family: a list of `(key, value)`
/// pairs becomes a `HashMap`, so an iterator chain ends
/// `xs.iter().map(|w| (w, w.len())).to_list().to_map()`. A repeated key keeps
/// the LAST pair, matching `insert`.
///
/// The impl subject binds the element structurally — `List<(K, V)>` — which is how
/// the two bounds a `HashMap` needs (`K: Hashable`, and the element being a pair at
/// all) are stated. It lives here rather than on `Iterator` for the same reason
/// `to_set` lives on `List`: a trait default may not require a bound its trait does
/// not declare.
impl List<(type K: Hashable, type V)> {
	fun to_map(self): HashMap<K, V> {
		mut result: HashMap<K, V> = HashMap::new();
		for entry in self {
			result.insert(entry.0, entry.1);
		}
		result
	}
}

/// The empty map is a `HashMap`'s default (I4) — `Default`'s only implementors were the
/// numeric family, so a `T: Default` bound could not be met by a container and kolt
/// wrote this impl itself (`prefs.vl:100`, under a
/// `// FIXME: Implement with std.`). The binder carries `Hashable` because the TYPE
/// does: a `HashMap` whose key is not hashable does not exist to have a default.
impl HashMap<type K: Hashable, type V> with Default {
	fun default(): HashMap<K, V> {
		HashMap::new()
	}
}

/// `HashMap { "ada" => 36, "alan" => 41 }` in insertion order, `HashMap {}`
/// empty: what `dbg` prints, on one line, so a struct holding a map derives
/// `Debug` (E283).
impl HashMap<type K: Hashable + Debug, type V: Debug> with Debug {
	fun debug(self): str {
		if self.is_empty() {
			ret "HashMap {}";
		}
		mut out = "HashMap { ";
		mut first = true;
		for entry in self.entries() {
			if !first {
				out = out + ", ";
			}
			first = false;
			out = out + entry.0.debug() + " => " + entry.1.debug();
		}
		out + " }"
	}
}
